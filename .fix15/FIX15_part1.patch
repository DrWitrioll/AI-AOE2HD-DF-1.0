-; Mandatory safe Feudal bootstrap.  One build-wall command is enough to mark
-; the wall as started; later rules decide how far the ring should be extended.
+; FIX15 WALL RELIABILITY LAYER
+; The attached FIX14 replay reached Feudal/Castle with three Fortress AIs but
+; recorded no WALL action at all.  can-build-wall therefore cannot be the only
+; gateway to the first wall command.  Retry build-wall directly every 25 seconds
+; until completed wall segments prove that the planner actually started.
+(defrule
+    (goal df15-wall-retry 1)
+    (timer-triggered df15-wall-timer)
+=>
+    (set-goal df15-wall-retry 0)
+    (disable-timer df15-wall-timer)
+)
+
+; A real completed segment, not an issued command or a default 100% planner
+; value, confirms that the fortress wall bootstrap exists.
+(defrule
+    (goal df13-wall-bootstrap 0)
+    (building-type-count-total palisade-wall >= 1)
+=>
+    (set-goal df13-wall-bootstrap 1)
+)
+(defrule
+    (goal df13-wall-bootstrap 0)
+    (building-type-count-total stone-wall-line >= 1)
+=>
+    (set-goal df13-wall-bootstrap 1)
+)
+
+; Give the first palisade enough radius to sit outside the compact economic
+; core.  This also avoids the FIX14 6..12 ring being trapped inside buildings.
+(defrule
+    (current-age == feudal-age)
+    (goal df13-wall-bootstrap 0)
+=>
+    (set-strategic-number sn-minimum-town-size 8)
+    (set-strategic-number sn-maximum-town-size 18)
+    (set-strategic-number sn-safe-town-size 14)
+)
+
+; Direct Feudal palisade attempt.  No can-build-wall predicate here: FIX14's
+; replay demonstrated that predicate can remain false forever before the first
+; planner action.  The action itself is parser-safe and already used in FIX10.
+(defrule
+    (current-age == feudal-age)
+    (current-age-time >= 35)
+    (goal df13-wall-bootstrap 0)
+    (goal df15-wall-retry 0)
+    (wood-amount > 70)
+    (up-pending-objects c: palisade-wall < 1)
+=>
+    (enable-wall-placement 1)
+    (build-wall 1 palisade-wall)
+    (set-goal df15-wall-retry 1)
+    (enable-timer df15-wall-timer 25)
+)
+
+; Larger-perimeter fallback for coast/island/blocked inner geometry.
+(defrule
+    (current-age == feudal-age)
+    (current-age-time >= 110)
+    (goal df13-wall-bootstrap 0)
+    (goal df15-wall-retry 0)
+    (wood-amount > 70)
+    (up-pending-objects c: palisade-wall < 1)
+=>
+    (set-strategic-number sn-minimum-town-size 9)
+    (set-strategic-number sn-maximum-town-size 22)
+    (enable-wall-placement 2)
+    (build-wall 2 palisade-wall)
+    (set-goal df15-wall-retry 1)
+    (enable-timer df15-wall-timer 25)
+)
+
+; Castle fallback also retries directly.  It never claims success until a real
+; stone/palisade segment is counted by one of the confirmation rules above.
+(defrule
+    (current-age >= castle-age)
+    (goal df13-wall-bootstrap 0)
+    (goal df15-wall-retry 0)
+    (stone-amount > 100)
+    (up-pending-objects c: stone-wall-line < 1)
+=>
+    (enable-wall-placement 1)
+    (build-wall 1 stone-wall-line)
+    (set-goal df15-wall-retry 1)
+    (enable-timer df15-wall-timer 25)
+)
+
