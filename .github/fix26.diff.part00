--- Dr_Fortress_AI_V13_FIX25.per
+++ Dr_Fortress_AI_V13_FIX26.per
@@ -1,5 +1,13 @@
 ; ============================================================================
-; DR FORTRESS AI V13 FIX25
+; DR FORTRESS AI V13 FIX26
+; FIX26 transactional tier / civilian stability / relative-strength repair:
+; - exact-tier dispatcher is transactional: a family request/cycle is consumed only when the requested exact model passes can-train; failed custom-DAT train attempts no longer masquerade as success.
+; - Castle+ emergency production floor now prefers the best researched trainable spear/archer/skirmisher/infantry/knight/siege tier instead of flooding legacy base units.
+; - Hardest civilian floor keeps Town Centers producing a minimum viable economy for 125/150/200+ population profiles; danger states contract camp/drop radii using parser-proven SNs.
+; - relative-strength pressure uses conservative military bands, a timed window and a mandatory cooldown; Rescue remains the final override and Single Attack Owner remains the only attack-now/SN owner.
+; - FIX25 one-second empty production rotor is slowed to a bounded four-second retry; no hot one-second algorithm loop remains.
+; - the old random civilian-failure chat line is gated by an actual low own civilian population signal, so it no longer pretends to diagnose a condition it never measured.
+; - no resource creation, no post-battle counterattack, no elite-ratio rewrite and no complex counter-composition layer.
 ; FIX25 Production Uptime / Spending Governor / Castle timing:
 ; - mandatory Feudal production foundation now builds Barracks first, then Archery Range; FIX24 could request units before legal production infrastructure existed.
 ; - a parser-proven direct cheap-unit floor attempts one affordable soldier every few seconds while field military is critically low.
@@ -269,6 +277,8 @@
 (defconst df25-spend-cycle 275) ;0 spear, 1 archer, 2 skirmisher, 3 militia, 4 knight family request
 (defconst df25-castle-save 276) ;0 normal Feudal economy, 1 locally-safe Castle-age saving window
 (defconst df25-production-floor 277) ;0 normal dispatcher, 1 direct cheap safety floor active
+(defconst df26-relative-state 278) ;0 off, 1 conservative favorable-strength pressure window
+(defconst df26-relative-cooldown 279) ;0 ready, 1 mandatory cooldown prevents immediate re-entry
 
 ; FIX09 exact-tier family production requests.
 (defconst df13-militia-request 185)
@@ -325,6 +335,8 @@
 (defconst df24-gate-timer 58) ;FIX24 long gate-attempt cooldown
 (defconst df25-production-timer 59) ;FIX25 cheap-unit uptime cadence
 (defconst df25-spend-timer 60) ;FIX25 Spending Governor family-request cadence
+(defconst df26-relative-timer 61) ;FIX26 relative-strength pressure hold window
+(defconst df26-relative-cooldown-timer 62) ;FIX26 pause before another relative pressure window
 
 ; UserPatch/HD class and group values used without direct object-search DUC.
 (defconst df11-villager-class 904)
@@ -25059,6 +25071,7 @@
 	(military-population <= 40)
 	(players-military-population any-enemy > 50)
 	(players-civilian-population any-enemy > 90)
+	(civilian-population < 65)
 =>
 	(chat-to-all "[FORTRESS] [CMD-20] I failed to establish a meaningful strategic advantage.")
 	(chat-to-all "[FORTRESS] Civilian production and task allocation fell below acceptable levels.")
