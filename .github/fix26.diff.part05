+    (current-age == feudal-age)
+    (goal df25-production-cycle 3)
+    (up-timer-status df25-production-timer == timer-disabled)
+=>
+    (set-goal df25-production-cycle 0)
+    (enable-timer df25-production-timer 4)
+)
+
+
+; --- FIX26 Castle+ exact-tier emergency floor -------------------------------
+; FIX25 correctly guaranteed production, but its Castle+ emergency path always
+; trained legacy Spear/Skirm/Archer/Militia.  During prolonged low-army states
+; this path could dominate the normal exact-tier dispatcher and visually recreate
+; the tier bug.  Castle+ now rotates through six families and always attempts the
+; strongest researched model that is actually trainable.  No request/cycle is
+; consumed on a phantom exact-tier train; each slot retries on the next rotor pass.
+
+; Slot 0 - spear family.
+(defrule
+    (current-age >= castle-age)
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 0)
+    (up-timer-status df25-production-timer == timer-disabled)
+    (research-completed ri-halberdier)
+    (can-train halberdier)
+=>
+    (train halberdier)
+    (set-goal df25-production-cycle 1)
+    (enable-timer df25-production-timer 4)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 0)
+    (up-timer-status df25-production-timer == timer-disabled)
+    (not (research-completed ri-halberdier))
+    (research-completed ri-pikeman)
+    (can-train pikeman)
+=>
+    (train pikeman)
+    (set-goal df25-production-cycle 1)
+    (enable-timer df25-production-timer 4)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 0)
+    (up-timer-status df25-production-timer == timer-disabled)
+    (not (research-completed ri-halberdier))
+    (not (research-completed ri-pikeman))
+    (can-train spearman)
+=>
+    (train spearman)
+    (set-goal df25-production-cycle 1)
+    (enable-timer df25-production-timer 4)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 0)
+    (up-timer-status df25-production-timer == timer-disabled)
+=>
+    (set-goal df25-production-cycle 1)
+    (enable-timer df25-production-timer 4)
+)
+
+; Slot 1 - archer family.
+(defrule
+    (current-age >= castle-age)
     (goal df25-production-floor 1)
     (goal df25-production-cycle 1)
     (up-timer-status df25-production-timer == timer-disabled)
-    (can-train skirmisher)
-=>
-    (train skirmisher)
+    (research-completed ri-arbalest)
+    (can-train arbalest)
+=>
+    (train arbalest)
     (set-goal df25-production-cycle 2)
     (enable-timer df25-production-timer 4)
 )
 (defrule
+    (current-age >= castle-age)
     (goal df25-production-floor 1)
     (goal df25-production-cycle 1)
     (up-timer-status df25-production-timer == timer-disabled)
-=>
+    (not (research-completed ri-arbalest))
+    (research-completed ri-crossbow)
+    (can-train crossbowman)
+=>
+    (train crossbowman)
     (set-goal df25-production-cycle 2)
-    (enable-timer df25-production-timer 1)
-)
-(defrule
+    (enable-timer df25-production-timer 4)
