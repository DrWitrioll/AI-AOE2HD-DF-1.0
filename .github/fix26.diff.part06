+; ============================================================================
+; FIX26 CIVILIAN STABILITY / RELATIVE-STRENGTH FINAL LAYER
+; ============================================================================
+
+; --- Hardest minimum viable civilian economy --------------------------------
+; These are floors, not final villager targets. Inherited Resonance rules may grow
+; higher. The rules only prevent a no-cheat Fortress from sitting with an idle TC
+; while its civilian base is below a population-profile-safe minimum.
+(defrule
+    (difficulty == hardest)
+    (current-age == feudal-age)
+    (unit-type-count-total villager < 30)
+    (population-headroom > 1)
+    (can-train villager)
+=>
+    (train villager)
+)
+(defrule
+    (difficulty == hardest)
+    (current-age >= castle-age)
+    (goal df13-pop-profile 1)
+    (unit-type-count-total villager < 60)
+    (population-headroom > 1)
+    (can-train villager)
+=>
+    (train villager)
+)
+(defrule
+    (difficulty == hardest)
+    (current-age >= castle-age)
+    (goal df13-pop-profile 2)
+    (unit-type-count-total villager < 75)
+    (population-headroom > 1)
+    (can-train villager)
+=>
+    (train villager)
+)
+(defrule
+    (difficulty == hardest)
+    (current-age >= castle-age)
+    (goal df13-pop-profile 3)
+    (unit-type-count-total villager < 90)
+    (population-headroom > 1)
+    (can-train villager)
+=>
+    (train villager)
+)
+
+; Final parser-safe economic travel bounds. Legacy Resonance has late-game rules
+; that can raise camp/wood distances as high as 80-120 tiles. For Fortress this can
+; send workers through contested territory. Growth stays local; a healthy Castle+
+; economy may expand farther, but not across half the map merely to reach wood.
+(defrule
+    (current-age == feudal-age)
+    (goal df21-economy-state 1)
+=>
+    (set-strategic-number sn-camp-max-distance 25)
+    (set-strategic-number sn-maximum-food-drop-distance 12)
+    (set-strategic-number sn-maximum-wood-drop-distance 18)
+    (set-strategic-number sn-maximum-gold-drop-distance 12)
+    (set-strategic-number sn-maximum-stone-drop-distance 12)
+)
+(defrule
+    (current-age >= castle-age)
+    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
+=>
+    (set-strategic-number sn-camp-max-distance 40)
+    (set-strategic-number sn-maximum-food-drop-distance 15)
+    (set-strategic-number sn-maximum-wood-drop-distance 30)
+    (set-strategic-number sn-maximum-gold-drop-distance 16)
+    (set-strategic-number sn-maximum-stone-drop-distance 16)
+)
+
+; Parser-safe civilian safety: the unsupported FIX11 direct danger sampler remains
+; disabled, but known defense/recovery state can still stop new economic expansion
+; from selecting absurdly distant camps/drop routes while the base is collapsing.
+(defrule
+    (current-age >= feudal-age)
+    (or (goal df13-defense-state 1) (or (goal df13-recovery 1) (goal df13-military-rebuild 1)))
+=>
+    (set-strategic-number sn-camp-max-distance 18)
+    (set-strategic-number sn-maximum-food-drop-distance 10)
+    (set-strategic-number sn-maximum-wood-drop-distance 14)
+    (set-strategic-number sn-maximum-gold-drop-distance 12)
+    (set-strategic-number sn-maximum-stone-drop-distance 12)
+)
+
+; --- Conservative relative-strength pressure -------------------------------
+; HD has no safe arithmetic comparison between our military population and an
+; enemy player's value, so relative strength is approximated with conservative
+; bands. every-enemy is deliberate: one weak enemy must not trick a 3v3 Fortress
+; into attacking while another enemy owns a much larger field army.
+(defrule
+    (goal df26-relative-cooldown 1)
+    (timer-triggered df26-relative-cooldown-timer)
+=>
+    (set-goal df26-relative-cooldown 0)
+    (disable-timer df26-relative-cooldown-timer)
+)
+(defrule
+    (goal df26-relative-state 1)
+    (timer-triggered df26-relative-timer)
+=>
+    (set-goal df26-relative-state 0)
+    (set-goal df26-relative-cooldown 1)
+    (disable-timer df26-relative-timer)
+    (enable-timer df26-relative-cooldown-timer 60)
+)
+(defrule
+    (goal df26-relative-state 1)
+    (or (goal df22-rescue-state 1) (or (goal df13-defense-state 1) (or (goal df13-recovery 1) (goal df13-military-rebuild 1))))
+=>
+    (set-goal df26-relative-state 0)
+    (set-goal df26-relative-cooldown 1)
+    (disable-timer df26-relative-timer)
+    (enable-timer df26-relative-cooldown-timer 45)
+)
+(defrule
+    (goal df26-relative-state 1)
+    (military-population < 8)
+=>
+    (set-goal df26-relative-state 0)
+    (set-goal df26-relative-cooldown 1)
+    (disable-timer df26-relative-timer)
+    (enable-timer df26-relative-cooldown-timer 45)
+)
+
+; 12 vs <8, 18 vs <14, 26 vs <20, 36 vs <28. Each opens only one 45-second
+; pressure window and reuses the existing Attack Owner pressure pulse.
+(defrule
+    (current-age >= castle-age)
+    (goal df21-economy-state 2)
+    (goal df26-relative-state 0)
+    (goal df26-relative-cooldown 0)
+    (goal df22-rescue-state 0)
+    (not (town-under-attack))
+    (military-population >= 12)
+    (players-military-population every-enemy < 8)
+=>
+    (set-goal df26-relative-state 1)
+    (set-goal df22-pressure-pulse 1)
+    (enable-timer df26-relative-timer 45)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df21-economy-state 2)
+    (goal df26-relative-state 0)
+    (goal df26-relative-cooldown 0)
+    (goal df22-rescue-state 0)
+    (not (town-under-attack))
+    (military-population >= 18)
+    (players-military-population every-enemy < 14)
+=>
+    (set-goal df26-relative-state 1)
+    (set-goal df22-pressure-pulse 1)
+    (enable-timer df26-relative-timer 45)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df21-economy-state 2)
+    (goal df26-relative-state 0)
+    (goal df26-relative-cooldown 0)
+    (goal df22-rescue-state 0)
+    (not (town-under-attack))
+    (military-population >= 26)
+    (players-military-population every-enemy < 20)
+=>
+    (set-goal df26-relative-state 1)
+    (set-goal df22-pressure-pulse 1)
+    (enable-timer df26-relative-timer 45)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df21-economy-state 2)
+    (goal df26-relative-state 0)
+    (goal df26-relative-cooldown 0)
+    (goal df22-rescue-state 0)
+    (not (town-under-attack))
+    (military-population >= 36)
+    (players-military-population every-enemy < 28)
+=>
+    (set-goal df26-relative-state 1)
+    (set-goal df22-pressure-pulse 1)
+    (enable-timer df26-relative-timer 45)
+)
+
+; Final Attack Owner selector extension. It writes only the attack-mode state;
+; createarmy, group SNs and attack-now remain owned by the existing FIX22 block.
+; Rescue is repeated after this rule as the final override because its target is
+; concrete and must beat opportunistic pressure on the same rule pass.
+(defrule
+    (goal df21-economy-state 2)
+    (goal df26-relative-state 1)
+    (goal df22-rescue-state 0)
+=>
+    (set-goal df22-attack-mode 4)
+)
+(defrule
+    (goal df22-rescue-state 1)
+=>
+    (set-goal df22-attack-mode 3)
+)
+
