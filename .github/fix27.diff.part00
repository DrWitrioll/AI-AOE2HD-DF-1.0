 (defconst df26-relative-cooldown-timer 62) ;FIX26 pause before another relative pressure window
+(defconst df27-combat-timer 63) ;FIX27 low-army family-request cadence
+(defconst df27-tc-lock-timer 64) ;FIX27 TC command-storm cooldown
+(defconst df27-castle-lock-timer 65) ;FIX27 Castle command-storm cooldown
 
