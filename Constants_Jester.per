#end-if

#load-if-defined YIN-YANG-MAP
(defrule
	(goal WATER-MAP maybe)
=>
	(set-goal WATER-MAP connected)
	(disable-self))
#end-if

;REAL WORLD (only doing one. too many rules at this point for now)
#load-if-defined REAL-WORLD-EARTH-MAP ;wow i had this wrong for so long D:
(defrule
	(goal WATER-MAP maybe)
=>
	(set-goal WATER-MAP separated)
	(disable-self))
#end-if

;MORE LOGIC

	;FOCUS PLAYER

(defconst GL-FOCUS-PLAYER 136)
;0 is my-player-number
;1 is closest-enemy
;2 is attacking-enemy
;3 is a specific enemy (by taunt)
;4 is closest ally

;pocket player
#load-if-defined UP-POCKET-POSITION
(defrule
(game-time > 5) ;allow 1 pass for nomad to turn yes
(goal NOMAD no)
(up-compare-goal position-goal != pocket)
=>
;(chat-to-allies "I'm a pocket player.") ;debug
(set-goal position-goal pocket))
#else
(defrule
(up-compare-goal position-goal != flank)
=>
;(chat-to-allies "I'm a flank player.") ;debug
(set-goal position-goal flank))
#end-if

;CANCEL POCKET POSITION IF PLAYING NOMAD GAMES
(defrule
	(goal NOMAD yes)
	(up-compare-goal position-goal != flank)
=>
	(set-goal position-goal flank)
	(set-goal counter-units yes) ;re-enable
)

