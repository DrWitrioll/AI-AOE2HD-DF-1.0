;game defined logic
;WATER-MAP no

;(defrule
;	(goal WATER-MAP no)
;	(game-time > 10)
;=>
;	(chat-local-to-self "Land-map detected.")
;	(disable-self))

;WATER-MAP (connected by land)
;(defrule
;	(goal WATER-MAP connected)
;	(game-time > 10)
;=>
;	(chat-local-to-self "Water-map with connected land detected.")
;	(disable-self))

;WATER-MAP (separate by water)
;(defrule
;	(goal WATER-MAP separated)
;	(game-time > 10)
;=>
;	(chat-local-to-self "Island-type water map detected.")
;	(disable-self))

;UNKNOWN MAP-TYPE
(defrule
	(goal WATER-MAP maybe);default (Cause im too lazy to make it better)
	(game-time > 15)
=>
;	(chat-to-player my-player-number "Unknown map detected, assuming land-style map.")
	(set-goal WATER-MAP no)
	(disable-self)
)

;ALL MAP TYPES (one by one)

;STANDARD MAPS

#load-if-defined ACCLIVITY-MAP
(defrule
	(goal WATER-MAP maybe)
=>
	(set-goal WATER-MAP no)
	(disable-self))
#end-if

