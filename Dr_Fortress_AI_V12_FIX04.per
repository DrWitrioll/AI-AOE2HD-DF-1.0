; ============================================================================
; V12 FIX02 FIRST-CASTLE RESERVE
; The first Castle remains a 1250-stone strategic commitment, but FIX01 required
; the expensive outer stone ring before the Castle could even enter escrow.
; FIX02 starts the reserve after a useful inner perimeter exists and builds the
; outer ring only after the Castle foundation is committed.
; ============================================================================
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (wall-completed-percentage 1 >= 45)
    (goal g-castle-reserve 0)
=>
    (set-escrow-percentage stone 55)
    (set-goal g-castle-reserve 1)
)

(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal g-castle-reserve 1)
    (civilian-population >= 32)
    (wall-completed-percentage 1 >= 55)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle < 1)
    (not (town-under-attack))
    (can-build-with-escrow castle)
=>
    (release-escrow stone)
    (set-escrow-percentage stone 0)
    (up-assign-builders c: castle c: 6)
    (build castle)
    (set-goal g-fortress-phase 1)
)

(defrule
    (not(difficulty == hardest))
    (current-age >= castle-age)
    (goal g-castle-reserve 1)
    (civilian-population >= 38)
    (wall-completed-percentage 1 >= 60)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle < 1)
    (can-build-with-escrow castle)
=>
    (release-escrow stone)
    (set-escrow-percentage stone 0)
    (build castle)
    (set-goal g-fortress-phase 1)
)

(defrule
    (goal g-castle-reserve 1)
    (building-type-count-total castle >= 1)
=>
    (release-escrow stone)
    (set-escrow-percentage stone 0)
    (set-goal g-castle-reserve 0)
    (set-goal g-fortress-phase 1)
)

; -----------------------------
; FORTIFICATIONS - V12 FIX02
; -----------------------------
; Ring 1 is a wide economic perimeter.  The open-map town radius is widened below,
; so nearby wood, berries, gold and stone dropsites sit inside the planned ring.
; Feudal builds a useful palisade perimeter without spending the whole Castle bank.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (building-type-count-total market >= 1)
    (building-type-count-total blacksmith >= 1)
    (building-type-count-total mill >= 1)
    (building-type-count-total lumber-camp >= 1)
    (building-type-count-total mining-camp >= 1)
    (not(wall-completed-percentage 1 >= 55))
    (wood-amount > 170)
    (not (town-under-attack))
    (can-build-wall 1 palisade-wall)
=>
    (up-assign-builders c: palisade-wall c: 3)
    (build-wall 1 palisade-wall)
)

; Other difficulties retain a cheaper/less aggressive inner ring.
(defrule
    (not(difficulty == hardest))
    (current-age >= feudal-age)
    (not(wall-completed-percentage 1 >= 65))
    (wood-amount > 180)
    (not (town-under-attack))
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

; One controlled access gate.  Extra gates made the perimeter porous and caused
; pathing to open several passages during a base attack.
(defrule
    (current-age >= feudal-age)
    (wall-completed-percentage 1 >= 20)
    (building-type-count-total gate < 1)
    (not (town-under-attack))
    (can-build-gate 1)
=>
    (build-gate 1)
)

; Once Castle Age is reached, finish the inner perimeter.  Palisade remains the
; default while the 1250-stone Castle is uncommitted.
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (not(wall-completed-percentage 1 >= 100))
    (wood-amount > 220)
    (not (town-under-attack))
    (can-build-wall 1 palisade-wall)
=>
    (up-assign-builders c: palisade-wall c: 4)
    (build-wall 1 palisade-wall)
)

; If stone is genuinely surplus before the first Castle, stone may replace/finish
; Ring 1 without touching the 1250-stone commitment.
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (stone-amount > 1650)
    (not(wall-completed-percentage 1 >= 100))
    (not (town-under-attack))
    (can-build-wall 1 stone-wall-line)
=>
    (up-assign-builders c: stone-wall-line c: 4)
    (build-wall 1 stone-wall-line)
)

; After the Castle foundation exists, stone becomes the preferred material for
; any unfinished inner perimeter and for the real outer fortress ring.
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (not(wall-completed-percentage 1 >= 100))
    (stone-amount > 180)
    (not (town-under-attack))
    (can-build-wall 1 stone-wall-line)
=>
    (up-assign-builders c: stone-wall-line c: 4)
    (build-wall 1 stone-wall-line)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 1 >= 55)
    (not(wall-completed-percentage 2 >= 100))
    (stone-amount > 260)
    (not (town-under-attack))
    (can-build-wall 2 stone-wall-line)
=>
    (up-assign-builders c: stone-wall-line c: 5)
    (build-wall 2 stone-wall-line)
)

; A second, limited gate is allowed only in the outer ring when it is mature.
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 2 >= 55)
    (building-type-count-total gate < 2)
    (not (town-under-attack))
    (can-build-gate 2)
=>
    (build-gate 2)
)

; FIXED7 long-range observation network. Outposts are cheap vision infrastructure,
; not combat towers. Very Hard deliberately maintains a dense screen around a large base.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (building-type-count-total fortress-outpost < 2)
    (wood-amount > 130)
    (up-pending-objects c: fortress-outpost < 1)
    (can-build fortress-outpost)
=>
    (build fortress-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (building-type-count-total fortress-outpost >= 2)
    (building-type-count-total fortress-outpost < 4)
    (wood-amount > 170)
    (up-pending-objects c: fortress-outpost < 1)
    (can-build fortress-outpost)
=>
    (build-forward fortress-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (building-type-count-total town-center >= 2)
    (building-type-count-total fortress-outpost < 8)
    (wood-amount > 240)
    (up-pending-objects c: fortress-outpost < 1)
    (not (town-under-attack))
    (can-build fortress-outpost)
=>
    (build-forward fortress-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == imperial-age)
    (building-type-count-total fortress-outpost < 15)
    (wood-amount > 350)
    (up-pending-objects c: fortress-outpost < 1)
    (not (town-under-attack))
    (can-build fortress-outpost)
=>
    (build-forward fortress-outpost)
)
(defrule
    (difficulty == hard)
    (current-age >= feudal-age)
    (building-type-count-total fortress-outpost < 3)
    (wood-amount > 180)
    (up-pending-objects c: fortress-outpost < 1)
    (not (town-under-attack))
    (can-build fortress-outpost)
=>
    (build-forward fortress-outpost)
)
(defrule
    (difficulty == hard)
    (current-age >= castle-age)
    (building-type-count-total fortress-outpost < 7)
    (wood-amount > 300)
    (up-pending-objects c: fortress-outpost < 1)
    (not (town-under-attack))
    (can-build fortress-outpost)
=>
    (build-forward fortress-outpost)
)
(defrule
    (not(difficulty < moderate))
    (current-age >= feudal-age)
    (building-type-count-total fortress-outpost < 2)
    (wood-amount > 260)
    (up-pending-objects c: fortress-outpost < 1)
    (not (town-under-attack))
    (can-build fortress-outpost)
=>
    (build-forward fortress-outpost)
)

; Towers scale with age, but do not consume every stone reserve.
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (building-type-count-total watch-tower-line < 2)
    (stone-amount > 300)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

(defrule
    (current-age == castle-age)
    (building-type-count-total castle >= 1)
    (goal g-castle-reserve 0)
    (building-type-count-total watch-tower-line < 4)
    (stone-amount > 500)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

(defrule
    (current-age == imperial-age)
    (building-type-count-total watch-tower-line < 6)
    (stone-amount > 700)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)


; FIXED5 wall fire-support: generic towers still protect the town center, while
; these forward towers deliberately cover the outer approach/perimeter.
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 2 >= 60)
    (goal g-castle-reserve 0)
    (building-type-count-total watch-tower-line < 5)
    (stone-amount > 900)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build-forward watch-tower-line)
)
(defrule
    (current-age == imperial-age)
    (wall-completed-percentage 2 >= 80)
    (building-type-count-total watch-tower-line < 8)
    (stone-amount > 1400)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build-forward watch-tower-line)
)

; Castles are extremely expensive in the modified DAT - save deliberately.
; V7 preserves the population-scaled first Castle threshold with the configured population cap.
; The old fixed >50-villager condition made a Castle impossible in many
; 50/75-pop games during Castle Age.
(defrule
    (current-age >= castle-age)
    (goal g-maxpop-le50 1)
    (civilian-population >= 28)
    (or (not(difficulty == hardest)) (wall-completed-percentage 2 >= 70))
    (building-type-count-total castle < 1)
    (stone-amount > 1450)
    (can-build castle)
=>
    (build castle)
    (set-goal g-fortress-phase 1)
)

(defrule
    (current-age >= castle-age)
    (goal g-maxpop-ge51 1)
    (goal g-maxpop-le75 1)
    (civilian-population >= 34)
    (or (not(difficulty == hardest)) (wall-completed-percentage 2 >= 70))
    (building-type-count-total castle < 1)
    (stone-amount > 1450)
    (can-build castle)
=>
    (build castle)
    (set-goal g-fortress-phase 1)
)

(defrule
    (current-age >= castle-age)
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (civilian-population >= 42)
    (or (not(difficulty == hardest)) (wall-completed-percentage 2 >= 70))
    (building-type-count-total castle < 1)
    (stone-amount > 1450)
    (can-build castle)
=>
    (build castle)
    (set-goal g-fortress-phase 1)
)

(defrule
    (current-age >= castle-age)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (civilian-population >= 42)
    (or (not(difficulty == hardest)) (wall-completed-percentage 2 >= 70))
    (building-type-count-total castle < 1)
    (stone-amount > 1450)
    (can-build castle)
=>
    (build castle)
    (set-goal g-fortress-phase 1)
)

(defrule
    (current-age >= castle-age)
    (goal g-maxpop-ge126 1)
    (civilian-population >= 44)
    (or (not(difficulty == hardest)) (wall-completed-percentage 2 >= 70))
    (building-type-count-total castle < 1)
    (stone-amount > 1450)
    (can-build castle)
=>
    (build castle)
    (set-goal g-fortress-phase 1)
)

(defrule
    (current-age == imperial-age)
    (military-population > 20)
    (building-type-count-total castle < 2)
    (stone-amount > 1650)
    (can-build castle)
=>
    (build castle)
)

(defrule
    (current-age == imperial-age)
    (military-population > 35)
    (building-type-count-total castle < 3)
    (stone-amount > 1850)
    (can-build castle)
=>
    (build castle)
)

(defrule
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (military-population > 60)
    (building-type-count-total castle < 4)
    (stone-amount > 2300)
    (can-build castle)
=>
    (build castle)
)

; Extra artillery towers only when resources are truly abundant.
(defrule
    (current-age == imperial-age)
    (building-type-count-total bombard-tower < 2)
    (stone-amount > 1000)
    (gold-amount > 700)
    (can-build bombard-tower)
=>
    (build bombard-tower)
)

(defrule
    (current-age == imperial-age)
    (building-type-count wonder > 0)
    (building-type-count-total bombard-tower < 4)
    (stone-amount > 900)
    (gold-amount > 600)
    (can-build bombard-tower)
=>
    (build bombard-tower)
)

; V9 closed-map and high-pop fortress depth.
(defrule
    (goal g-closed-map 1)
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (building-type-count-total watch-tower-line < 3)
    (stone-amount > 450)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)
(defrule
    (goal g-closed-map 1)
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-castle-reserve 0)
    (building-type-count-total watch-tower-line < 5)
    (stone-amount > 800)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)
(defrule
    (current-age == imperial-age)
    (goal g-maxpop-ge126 1)
    (building-type-count-total castle >= 2)
    (building-type-count-total watch-tower-line < 8)
    (stone-amount > 1200)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)
(defrule
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (building-type-count-total castle >= 3)
    (building-type-count-total bombard-tower < 6)
    (stone-amount > 2600)
    (gold-amount > 1800)
    (can-build bombard-tower)
=>
    (build bombard-tower)
)

; ==========================================================================
; V9 FORTRESS MASTER - CLOSED-MAP CHOKE ALERT
; ==========================================================================
(defrule
    (goal g-closed-map 1)
    (enemy-buildings-in-town)
    (goal g-choke-alert 0)
=>
    (set-goal g-choke-alert 1)
    (set-strategic-number sn-number-defend-groups 3)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
)
(defrule
    (goal g-choke-alert 1)
    (not (enemy-buildings-in-town))
    (not (town-under-attack))
=>
    (set-goal g-choke-alert 0)
)
(defrule
    (goal g-choke-alert 1)
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (building-type-count-total watch-tower-line < 7)
    (stone-amount > 1200)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

; ==========================================================================
; V9 FORTRESS MASTER - FORTRESS RECONSTRUCTION
; Once a mature fortress has existed, losing its strategic Castles is treated
; as damage to be repaired, not as a reason to permanently downgrade the base.
; ==========================================================================
(defrule
    (or (goal g-own-fortress-depth 1) (or (goal g-own-fortress-depth 2) (goal g-own-fortress-depth 3)))
    (building-type-count-total castle < 1)
=>
    (set-goal g-fortress-rebuild 1)
    (set-goal g-war-state state-fortify)
    (set-goal g-assault-window 0)
    (up-retreat-now)
)
(defrule
    (or (goal g-own-fortress-depth 2) (goal g-own-fortress-depth 3))
    (building-type-count-total castle == 1)
    (or (goal g-fortress-rebuild 0) (goal g-fortress-rebuild 1))
=>
    (set-goal g-fortress-rebuild 2)
)
(defrule
    (goal g-own-fortress-depth 3)
    (building-type-count-total castle == 2)
    (or (goal g-fortress-rebuild 0) (or (goal g-fortress-rebuild 1) (goal g-fortress-rebuild 2)))
=>
    (set-goal g-fortress-rebuild 3)
)
(defrule
    (goal g-fortress-rebuild 1)
    (up-pending-objects c: castle < 1)
    (can-build castle)
=>
    (build castle)
)
(defrule
    (goal g-fortress-rebuild 2)
    (building-type-count-total castle < 2)
    (up-pending-objects c: castle < 1)
    (can-build castle)
=>
    (build castle)
)
(defrule
    (goal g-fortress-rebuild 3)
    (building-type-count-total castle < 3)
    (up-pending-objects c: castle < 1)
    (can-build castle)
=>
    (build castle)
)
(defrule
    (or (goal g-fortress-rebuild 1) (or (goal g-fortress-rebuild 2) (goal g-fortress-rebuild 3)))
    (stone-amount < 1250)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 22)
    (set-strategic-number sn-gold-gatherer-percentage 14)
    (set-strategic-number sn-stone-gatherer-percentage 30)
)
(defrule
    (goal g-fortress-rebuild 1)
    (building-type-count-total castle >= 1)
=>
    (set-goal g-fortress-rebuild 0)
)
(defrule
    (goal g-fortress-rebuild 2)
    (building-type-count-total castle >= 2)
=>
    (set-goal g-fortress-rebuild 0)
)
(defrule
    (goal g-fortress-rebuild 3)
    (building-type-count-total castle >= 3)
=>
    (set-goal g-fortress-rebuild 0)
)

; -----------------------------
; Defensive technologies
; -----------------------------
(defrule
    (stone-amount > 350)
    (goal g-castle-reserve 0)
    (can-research ri-masonry)
=>
    (research ri-masonry)
)

(defrule
    (stone-amount > 450)
    (goal g-castle-reserve 0)
    (can-research ri-guard-tower)
=>
    (research ri-guard-tower)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-castle-reserve 0)
    (can-research ri-fortified-wall)
=>
    (research ri-fortified-wall)
)

(defrule
    (stone-amount > 650)
    (goal g-castle-reserve 0)
    (can-research ri-architecture)
=>
    (research ri-architecture)
)

(defrule
    (stone-amount > 700)
    (goal g-castle-reserve 0)
    (can-research ri-keep)
=>
    (research ri-keep)
)

(defrule
    (stone-amount > 700)
    (goal g-castle-reserve 0)
    (can-research ri-murder-holes)
=>
    (research ri-murder-holes)
)

(defrule
    (stone-amount > 900)
    (goal g-castle-reserve 0)
    (can-research ri-hoardings)
=>
    (research ri-hoardings)
)

(defrule
    (gold-amount > 700)
    (can-research ri-chemistry)
=>
    (research ri-chemistry)
)

(defrule
    (stone-amount > 900)
    (goal g-castle-reserve 0)
    (can-research ri-bombard-tower)
=>
    (research ri-bombard-tower)
)

(defrule
    (wood-amount > 900)
    (can-research ri-siege-engineers)
=>
    (research ri-siege-engineers)
)

; -----------------------------
; V9 DOCTRINE-AWARE BLACKSMITH TECHNOLOGIES
; Do not spend Fortress Age's large banks on upgrades for lines we do not use.
; -----------------------------
; Melee attack.
(defrule
    (or
        (or (goal g-doctrine-primary doc-infantry) (goal g-doctrine-secondary doc-infantry))
        (or (goal g-doctrine-primary doc-cavalry) (goal g-doctrine-secondary doc-cavalry))
    )
    (food-amount > 400)
    (can-research ri-forging)
=>
    (research ri-forging)
)
(defrule
    (or
        (unit-type-count militiaman-line >= 8)
        (or (unit-type-count knight-line >= 8) (unit-type-count camel-line >= 8))
    )
    (food-amount > 700)
    (can-research ri-iron-casting)
=>
    (research ri-iron-casting)
)
(defrule
    (current-age == imperial-age)
    (or
        (unit-type-count militiaman-line >= 12)
        (or (unit-type-count knight-line >= 12) (unit-type-count camel-line >= 12))
    )
    (food-amount > 1200)
    (can-research ri-blast-furnace)
=>
    (research ri-blast-furnace)
)

; Archer attack / range upgrades only for a real ranged corps.
(defrule
    (or (goal g-doctrine-primary doc-archer) (goal g-doctrine-secondary doc-archer))
    (wood-amount > 350)
    (food-amount > 300)
    (can-research ri-fletching)
=>
    (research ri-fletching)
)
(defrule
    (or (unit-type-count archer-line >= 8) (unit-type-count cavalry-archer-line >= 6))
    (wood-amount > 650)
    (food-amount > 600)
    (can-research ri-bodkin-arrow)
=>
    (research ri-bodkin-arrow)
)
(defrule
    (current-age == imperial-age)
    (or (unit-type-count archer-line >= 12) (unit-type-count cavalry-archer-line >= 10))
    (wood-amount > 1100)
    (food-amount > 1000)
    (can-research ri-bracer)
=>
    (research ri-bracer)
)

; Infantry armor.
(defrule
    (or
        (or (goal g-doctrine-primary doc-infantry) (goal g-doctrine-secondary doc-infantry))
        (unit-type-count spearman-line >= 8)
    )
    (food-amount > 450)
    (can-research ri-scale-mail)
=>
    (research ri-scale-mail)
)
(defrule
    (or (unit-type-count militiaman-line >= 8) (unit-type-count spearman-line >= 10))
    (food-amount > 750)
    (can-research ri-chain-mail)
=>
    (research ri-chain-mail)
)
(defrule
    (current-age == imperial-age)
    (or (unit-type-count militiaman-line >= 14) (unit-type-count spearman-line >= 14))
    (food-amount > 1250)
    (can-research ri-plate-mail)
=>
    (research ri-plate-mail)
)

; Archer armor also benefits skirmisher-heavy defense.
(defrule
    (or
        (or (goal g-doctrine-primary doc-archer) (goal g-doctrine-secondary doc-archer))
        (unit-type-count skirmisher-line >= 8)
    )
    (food-amount > 450)
    (can-research ri-padded-archer-armor)
=>
    (research ri-padded-archer-armor)
)
(defrule
    (or (unit-type-count archer-line >= 8) (unit-type-count skirmisher-line >= 10))
    (food-amount > 750)
    (can-research ri-leather-archer-armor)
=>
    (research ri-leather-archer-armor)
)
(defrule
    (current-age == imperial-age)
    (or (unit-type-count archer-line >= 14) (unit-type-count skirmisher-line >= 14))
    (food-amount > 1250)
    (can-research ri-ring-archer-armor)
=>
    (research ri-ring-archer-armor)
)

; Cavalry armor.
(defrule
    (or
        (or (goal g-doctrine-primary doc-cavalry) (goal g-doctrine-secondary doc-cavalry))
        (or (goal g-doctrine-primary doc-camel) (goal g-doctrine-secondary doc-camel))
    )
    (food-amount > 500)
    (can-research ri-scale-barding)
=>
    (research ri-scale-barding)
)
(defrule
    (or (unit-type-count knight-line >= 8) (unit-type-count camel-line >= 8))
    (food-amount > 800)
    (can-research ri-chain-barding)
=>
    (research ri-chain-barding)
)
(defrule
    (current-age == imperial-age)
    (or (unit-type-count knight-line >= 14) (unit-type-count camel-line >= 14))
    (food-amount > 1350)
    (can-research ri-plate-barding)
=>
    (research ri-plate-barding)
)


; FIXED5 resource-surplus blacksmith completion. If the AI is sitting on the
; multi-thousand-resource banks observed in the replay, leaving pure stat
; upgrades available is no longer rational.
(defrule (current-age >= castle-age) (food-amount > 2500) (wood-amount > 2000) (gold-amount > 1400) (can-research ri-forging) => (research ri-forging))
(defrule (current-age >= castle-age) (food-amount > 2500) (wood-amount > 2000) (gold-amount > 1400) (can-research ri-iron-casting) => (research ri-iron-casting))
(defrule (current-age == imperial-age) (food-amount > 3000) (wood-amount > 2400) (gold-amount > 1800) (can-research ri-blast-furnace) => (research ri-blast-furnace))
(defrule (current-age >= castle-age) (food-amount > 2200) (wood-amount > 2200) (gold-amount > 1200) (can-research ri-fletching) => (research ri-fletching))
(defrule (current-age >= castle-age) (food-amount > 2500) (wood-amount > 2400) (gold-amount > 1400) (can-research ri-bodkin-arrow) => (research ri-bodkin-arrow))
(defrule (current-age == imperial-age) (food-amount > 3000) (wood-amount > 2800) (gold-amount > 1800) (can-research ri-bracer) => (research ri-bracer))
(defrule (current-age >= castle-age) (food-amount > 2500) (wood-amount > 1800) (can-research ri-scale-mail) => (research ri-scale-mail))
(defrule (current-age >= castle-age) (food-amount > 2800) (wood-amount > 2000) (can-research ri-chain-mail) => (research ri-chain-mail))
(defrule (current-age == imperial-age) (food-amount > 3200) (wood-amount > 2400) (can-research ri-plate-mail) => (research ri-plate-mail))
(defrule (current-age >= castle-age) (food-amount > 2500) (wood-amount > 1800) (can-research ri-padded-archer-armor) => (research ri-padded-archer-armor))
(defrule (current-age >= castle-age) (food-amount > 2800) (wood-amount > 2000) (can-research ri-leather-archer-armor) => (research ri-leather-archer-armor))
(defrule (current-age == imperial-age) (food-amount > 3200) (wood-amount > 2400) (can-research ri-ring-archer-armor) => (research ri-ring-archer-armor))
(defrule (current-age >= castle-age) (food-amount > 2500) (wood-amount > 1800) (can-research ri-scale-barding) => (research ri-scale-barding))
(defrule (current-age >= castle-age) (food-amount > 2800) (wood-amount > 2000) (can-research ri-chain-barding) => (research ri-chain-barding))
(defrule (current-age == imperial-age) (food-amount > 3200) (wood-amount > 2400) (can-research ri-plate-barding) => (research ri-plate-barding))

; ============================================================================
; SELECTIVE UNIT-LINE UPGRADES
; The modified DAT intentionally makes some upgrades trade-offs.
; This AI therefore does NOT blindly click every upgrade.
; ============================================================================

; Swordsmen: only deepen the line when it is already a meaningful part of army.
(defrule
    (or (unit-type-count militiaman-line >= 3) (goal g-doctrine-primary doc-infantry))
    (food-amount > 400)
    (can-research ri-man-at-arms)
=>
    (research ri-man-at-arms)
)

(defrule
    (or (unit-type-count militiaman-line >= 4) (goal g-doctrine-primary doc-infantry))
    (food-amount > 600)
    (can-research ri-long-swordsman)
=>
    (research ri-long-swordsman)
)

(defrule
    (unit-type-count militiaman-line >= 10)
    (food-amount > 950)
    (can-research ri-two-handed-swordsman)
=>
    (research ri-two-handed-swordsman)
)

(defrule
    (unit-type-count militiaman-line >= 14)
    (food-amount > 1350)
    (gold-amount > 450)
    (can-research ri-champion)
=>
    (research ri-champion)
)

; Spear line: upgrade further mainly when enemy cavalry justifies it.
(defrule
    (or (unit-type-count spearman-line >= 3) (goal g-threat-cavalry 1))
    (can-research ri-pikeman)
=>
    (research ri-pikeman)
)

(defrule
    (unit-type-count spearman-line >= 8)
    (players-unit-type-count any-enemy knight-line >= 5)
    (food-amount > 700)
    (can-research ri-halberdier)
=>
    (research ri-halberdier)
)

(defrule
    (unit-type-count spearman-line >= 8)
    (players-unit-type-count any-enemy camel-line >= 5)
    (food-amount > 700)
    (can-research ri-halberdier)
=>
    (research ri-halberdier)
)

; Archer line.
(defrule
    (or (unit-type-count archer-line >= 3) (goal g-doctrine-primary doc-archer))
    (wood-amount > 400)
    (gold-amount > 350)
    (can-research ri-crossbow)
=>
    (research ri-crossbow)
)

; Arbalest in this DAT has a serious range trade-off.
; Research it only for a large archer corps and a close-combat-heavy enemy.
(defrule
    (current-age == imperial-age)
    (unit-type-count archer-line >= 12)
    (players-unit-type-count any-enemy knight-line >= 6)
    (wood-amount > 900)
    (gold-amount > 900)
    (can-research ri-arbalest)
=>
    (research ri-arbalest)
)

(defrule
    (current-age == imperial-age)
    (unit-type-count archer-line >= 12)
    (players-unit-type-count any-enemy militiaman-line >= 10)
    (wood-amount > 900)
    (gold-amount > 900)
    (can-research ri-arbalest)
=>
    (research ri-arbalest)
)

(defrule
    (or (unit-type-count skirmisher-line >= 3) (goal g-threat-archer 1))
    (food-amount > 450)
    (wood-amount > 500)
    (can-research ri-elite-skirmisher)
=>
    (research ri-elite-skirmisher)
)

; Cavalry archers: expensive heavy version only after a real investment in the line.
(defrule
    (unit-type-count cavalry-archer-line >= 10)
    (wood-amount > 900)
    (gold-amount > 900)
    (can-research ri-heavy-cavalry-archer)
=>
    (research ri-heavy-cavalry-archer)
)

; Scout line: preserve high-LOS Scout Cavalry for a long scouting phase.
; If the dedicated scout dies before a replacement exists, temporarily allow
; exactly one villager to explore. The official HD AI uses the same explorer
; SNs to avoid leaving the economy blind without permanently wasting villagers.
(defrule
    (goal g-scout-phase 1)
    (difficulty == hardest)
    (unit-type-count scout-cavalry-line <= 0)
    (unit-type-count eagle-warrior-line <= 0)
    (military-population >= 4)
    (not (town-under-attack))
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-minimum-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-total-number-explorers 4)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-minimum-explore-group-size 4)
    (set-strategic-number sn-maximum-explore-group-size 4)
)

(defrule
    (goal g-scout-phase 1)
    (or
        (unit-type-count scout-cavalry-line >= 1)
        (unit-type-count eagle-warrior-line >= 1)
    )
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-minimum-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-minimum-explore-group-size 1)
    (set-strategic-number sn-maximum-explore-group-size 1)
)

(defrule
    (game-time > 1500)
    (goal g-scout-phase 1)
=>
    (set-goal g-scout-phase 0)
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-minimum-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    (disable-self)
)

(defrule
    (goal g-scout-phase 0)
    (current-age >= castle-age)
    (unit-type-count scout-cavalry-line >= 1)
    (food-amount > 500)
    (can-research ri-light-cavalry)
=>
    (research ri-light-cavalry)
)

(defrule
    (unit-type-count scout-cavalry-line >= 10)
    (food-amount > 1200)
    (can-research ri-hussar)
=>
    (research ri-hussar)
)

; Knight line: Paladin is powerful but much more expensive in this DAT.
(defrule
    (or (unit-type-count knight-line >= 4) (goal g-doctrine-primary doc-cavalry))
    (food-amount > 750)
    (gold-amount > 700)
    (can-research ri-cavalier)
=>
    (research ri-cavalier)
)

(defrule
    (unit-type-count knight-line >= 12)
    (food-amount > 1600)
    (gold-amount > 1200)
    (can-research ri-paladin)
=>
    (research ri-paladin)
)

; Heavy Camel: research primarily as a response to substantial enemy cavalry.
(defrule
    (unit-type-count camel-line >= 7)
    (players-unit-type-count any-enemy knight-line >= 5)
    (food-amount > 1100)
    (gold-amount > 800)
    (can-research ri-heavy-camel)
=>
    (research ri-heavy-camel)
)

; Eagle line: keep the high-vision basic Eagle through the scouting phase.
(defrule
    (goal g-scout-phase 0)
    (unit-type-count eagle-warrior-line >= 12)
    (gold-amount > 650)
    (can-research ri-elite-eagle-warrior)
=>
    (research ri-elite-eagle-warrior)
)

; Unique unit upgrade: late and only after committing to the unit line.
(defrule
    (current-age == imperial-age)
    (unit-type-count my-unique-unit-line >= 12)
    (food-amount > 1200)
    (gold-amount > 1200)
    (can-research my-unique-unit-upgrade)
=>
    (research my-unique-unit-upgrade)
)


; FIXED5 monastery development. These are not forced in a poor economy, but a
; monk-support army or a massive gold bank should not leave the Monastery idle.
(defrule
    (current-age >= castle-age)
    (or (unit-type-count monk >= 2) (gold-amount > 2600))
    (can-research ri-sanctity)
=>
    (research ri-sanctity)
)
(defrule
    (current-age >= castle-age)
    (or (unit-type-count monk >= 2) (gold-amount > 2800))
    (can-research ri-fervor)
=>
    (research ri-fervor)
)
(defrule
    (current-age >= castle-age)
    (or (goal g-threat-siege 1) (gold-amount > 3400))
    (can-research ri-redemption)
=>
    (research ri-redemption)
)
(defrule
    (current-age == imperial-age)
    (or (unit-type-count monk >= 2) (gold-amount > 3200))
    (can-research ri-block-printing)
=>
    (research ri-block-printing)
)
(defrule
    (current-age == imperial-age)
    (or (unit-type-count monk >= 3) (gold-amount > 3800))
    (can-research ri-illumination)
=>
    (research ri-illumination)
)
(defrule
    (current-age == imperial-age)
    (or (unit-type-count monk >= 4) (gold-amount > 4200))
    (can-research ri-theocracy)
=>
    (research ri-theocracy)
)

; -----------------------------
; Siege upgrades
; -----------------------------
(defrule
    (unit-type-count battering-ram-line >= 4)
    (players-building-count any-enemy > 8)
    (wood-amount > 800)
    (can-research ri-capped-ram)
=>
    (research ri-capped-ram)
)

(defrule
    (unit-type-count battering-ram-line >= 6)
    (players-building-count any-enemy > 12)
    (wood-amount > 1300)
    (gold-amount > 700)
    (can-research ri-siege-ram)
=>
    (research ri-siege-ram)
)

; FIXED6 fortress-priority ram upgrades. can-research keeps civ/age legality safe.
(defrule
    (goal g-fortress-threat 1)
    (unit-type-count battering-ram-line >= 2)
    (wood-amount > 650)
    (can-research ri-capped-ram)
=>
    (research ri-capped-ram)
)
(defrule
    (goal g-fortress-threat 1)
    (current-age == imperial-age)
    (unit-type-count battering-ram-line >= 3)
    (wood-amount > 1000)
    (gold-amount > 600)
    (can-research ri-siege-ram)
=>
    (research ri-siege-ram)
)

; Visibility-independent fallback upgrades. These prevent poor scouting from
; leaving the prepared siege core permanently at the lowest ram tier.
(defrule
    (current-age == imperial-age)
    (game-time > 2400)
    (unit-type-count battering-ram-line >= 4)
    (wood-amount > 1200)
    (gold-amount > 650)
    (can-research ri-capped-ram)
=>
    (research ri-capped-ram)
)

(defrule
    (current-age == imperial-age)
    (game-time > 3000)
    (unit-type-count battering-ram-line >= 6)
    (wood-amount > 1600)
    (gold-amount > 900)
    (can-research ri-siege-ram)
=>
    (research ri-siege-ram)
)

(defrule
    (unit-type-count mangonel-line >= 4)
    (wood-amount > 900)
    (gold-amount > 600)
    (can-research ri-onager)
=>
    (research ri-onager)
)

(defrule
    (unit-type-count mangonel-line >= 6)
    (wood-amount > 1500)
    (gold-amount > 1000)
    (can-research ri-siege-onager)
=>
    (research ri-siege-onager)
)

(defrule
    (unit-type-count scorpion-line >= 5)
    (wood-amount > 1000)
    (gold-amount > 700)
    (can-research ri-heavy-scorpion)
=>
    (research ri-heavy-scorpion)
)

; ==========================================================================
; V9 FORTRESS DEPTH INTELLIGENCE
; Persistent maximum severity: once a major fortification is discovered, the AI
; remembers how serious that opponent can be even after scouting vision is lost.
; ==========================================================================
(defrule
    (goal g-fortress-depth 0)
    (goal g-fortress-threat 1)
=>
    (set-goal g-fortress-depth 1)
)
(defrule
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (or
        (players-building-type-count any-enemy castle >= 2)
        (or
            (players-building-type-count any-enemy stone-wall-line >= 20)
            (players-building-type-count any-enemy watch-tower-line >= 6)
        )
    )
=>
    (set-goal g-fortress-depth 2)
    (set-goal g-fortress-threat 1)
)
(defrule
    (or (goal g-fortress-depth 0) (or (goal g-fortress-depth 1) (goal g-fortress-depth 2)))
    (or
        (players-building-type-count any-enemy castle >= 3)
        (or
            (players-building-type-count any-enemy stone-wall-line >= 35)
            (players-building-type-count any-enemy bombard-tower >= 2)
        )
    )
=>
    (set-goal g-fortress-depth 3)
    (set-goal g-fortress-threat 1)
)

; Our own fortress maturity is used for construction pacing and closed-map exits.
(defrule
    (goal g-own-fortress-depth 0)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 2 >= 55)
=>
    (set-goal g-own-fortress-depth 1)
)
(defrule
    (or (goal g-own-fortress-depth 0) (goal g-own-fortress-depth 1))
    (building-type-count-total castle >= 2)
    (wall-completed-percentage 2 >= 90)
    (building-type-count-total watch-tower-line >= 4)
=>
    (set-goal g-own-fortress-depth 2)
)
(defrule
    (or (goal g-own-fortress-depth 0) (or (goal g-own-fortress-depth 1) (goal g-own-fortress-depth 2)))
    (building-type-count-total castle >= 3)
    (building-type-count-total watch-tower-line >= 6)
=>
    (set-goal g-own-fortress-depth 3)
)

; ============================================================================
; ARMY PRODUCTION
; ============================================================================


; ============================================================================
; V9 ENEMY INTELLIGENCE / THREAT MEMORY
; All enemy unit facts below are normal visible-information facts, not CC facts.
; Hysteresis avoids switching the whole army composition because one unit died.
; ============================================================================
(defrule
    (goal g-enemy-known 0)
    (or
        (players-building-count any-enemy > 0)
        (players-military-population any-enemy > 0)
    )
=>
    (set-goal g-enemy-known 1)
)

; Cavalry threat.
(defrule
    (goal g-threat-cavalry 0)
    (or
        (players-unit-type-count any-enemy knight-line >= 6)
        (or
            (players-unit-type-count any-enemy scout-cavalry-line >= 10)
            (or
                (players-unit-type-count any-enemy camel-line >= 8)
                (players-unit-type-count any-enemy war-elephant-line >= 4)
            )
        )
    )
=>
    (set-goal g-threat-cavalry 1)
)
(defrule
    (goal g-threat-cavalry 1)
    (players-unit-type-count any-enemy knight-line < 3)
    (players-unit-type-count any-enemy scout-cavalry-line < 5)
    (players-unit-type-count any-enemy camel-line < 4)
    (players-unit-type-count any-enemy war-elephant-line < 2)
=>
    (set-goal g-threat-cavalry 0)
)

; Ranged threat.
(defrule
    (goal g-threat-archer 0)
    (or
        (players-unit-type-count any-enemy archer-line >= 8)
        (or
            (players-unit-type-count any-enemy cavalry-archer-line >= 6)
            (players-unit-type-count any-enemy skirmisher-line >= 12)
        )
    )
=>
    (set-goal g-threat-archer 1)
)
(defrule
    (goal g-threat-archer 1)
    (players-unit-type-count any-enemy archer-line < 4)
    (players-unit-type-count any-enemy cavalry-archer-line < 3)
    (players-unit-type-count any-enemy skirmisher-line < 6)
=>
    (set-goal g-threat-archer 0)
)

; Infantry threat.
(defrule
    (goal g-threat-infantry 0)
    (or
        (players-unit-type-count any-enemy militiaman-line >= 12)
        (or
            (players-unit-type-count any-enemy spearman-line >= 12)
            (players-unit-type-count any-enemy eagle-warrior-line >= 10)
        )
    )
=>
    (set-goal g-threat-infantry 1)
)
(defrule
    (goal g-threat-infantry 1)
    (players-unit-type-count any-enemy militiaman-line < 6)
    (players-unit-type-count any-enemy spearman-line < 6)
    (players-unit-type-count any-enemy eagle-warrior-line < 5)
=>
    (set-goal g-threat-infantry 0)
)

; Siege threat.
(defrule
    (goal g-threat-siege 0)
    (or
        (players-unit-type-count any-enemy battering-ram-line >= 2)
        (or
            (players-unit-type-count any-enemy mangonel-line >= 2)
            (or
                (players-unit-type-count any-enemy scorpion-line >= 4)
                (players-unit-type-count any-enemy bombard-cannon >= 1)
            )
        )
    )
=>
    (set-goal g-threat-siege 1)
)
(defrule
    (goal g-threat-siege 1)
    (players-unit-type-count any-enemy battering-ram-line < 1)
    (players-unit-type-count any-enemy mangonel-line < 1)
    (players-unit-type-count any-enemy scorpion-line < 2)
    (players-unit-type-count any-enemy bombard-cannon < 1)
=>
    (set-goal g-threat-siege 0)
)

; Monk threat.
(defrule
    (goal g-threat-monk 0)
    (players-unit-type-count any-enemy monk >= 4)
=>
    (set-goal g-threat-monk 1)
)
(defrule
    (goal g-threat-monk 1)
    (players-unit-type-count any-enemy monk < 2)
=>
    (set-goal g-threat-monk 0)
)

; Rough military inferiority memory, tuned to the primary 125/150/200 profiles.
(defrule
    (goal g-inferior 0)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (military-population < 42)
    (players-military-population any-enemy > 55)
=>
    (set-goal g-inferior 1)
)
(defrule
    (goal g-inferior 0)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (military-population < 52)
    (players-military-population any-enemy > 70)
=>
    (set-goal g-inferior 1)
)
(defrule
    (goal g-inferior 0)
    (goal g-maxpop-ge151 1)
    (military-population < 68)
    (players-military-population any-enemy > 90)
=>
    (set-goal g-inferior 1)
)
(defrule
    (goal g-inferior 1)
    (goal g-maxpop-le125 1)
    (military-population >= 50)
=>
    (set-goal g-inferior 0)
)
(defrule
    (goal g-inferior 1)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (military-population >= 62)
=>
    (set-goal g-inferior 0)
)
(defrule
    (goal g-inferior 1)
    (goal g-maxpop-ge151 1)
    (military-population >= 80)
=>
    (set-goal g-inferior 0)
)

; Standard-victory emergency: once an enemy Wonder is actually seen, treat it
; as a strategic target and stop waiting for the ordinary assault timer.
(defrule
    (goal g-victory-threat 0)
    (players-building-type-count any-enemy wonder > 0)
=>
    (set-goal g-victory-threat 1)
    (set-strategic-number sn-special-attack-type2 wonder)
)
(defrule
    (goal g-victory-threat 1)
    (players-building-type-count any-enemy wonder == 0)
=>
    (set-goal g-victory-threat 0)
    (set-strategic-number sn-special-attack-type2 -1)
)

; ==========================================================================
; V9 FORTRESS MASTER - MULTI-LEVEL MILITARY BALANCE
; This supplements g-inferior. It creates five stable postures and lets
; fortress warfare distinguish "slightly behind" from "army destroyed".
; ==========================================================================
; 125-pop profile.
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (military-population < 25)
    (players-military-population any-enemy >= 50)
=>
    (set-goal g-battle-balance balance-critical)
)
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (not(goal g-battle-balance balance-critical))
    (military-population < 40)
    (players-military-population any-enemy >= 52)
=>
    (set-goal g-battle-balance balance-inferior)
)
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (military-population >= 60)
    (players-military-population any-enemy < 28)
=>
    (set-goal g-battle-balance balance-dominant)
)
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (not(goal g-battle-balance balance-dominant))
    (military-population >= 52)
    (players-military-population any-enemy < 44)
=>
    (set-goal g-battle-balance balance-superior)
)
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (goal g-battle-balance balance-critical)
    (military-population >= 34)
=>
    (set-goal g-battle-balance balance-inferior)
)
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (goal g-battle-balance balance-inferior)
    (military-population >= 42)
    (players-military-population any-enemy < 48)
=>
    (set-goal g-battle-balance balance-even)
)
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (goal g-battle-balance balance-superior)
    (or (military-population < 47) (players-military-population any-enemy >= 55))
=>
    (set-goal g-battle-balance balance-even)
)
(defrule
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (goal g-battle-balance balance-dominant)
    (or (military-population < 56) (players-military-population any-enemy >= 38))
=>
    (set-goal g-battle-balance balance-superior)
)

; 150-pop profile.
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (military-population < 32)
    (players-military-population any-enemy >= 62)
=>
    (set-goal g-battle-balance balance-critical)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (not(goal g-battle-balance balance-critical))
    (military-population < 50)
    (players-military-population any-enemy >= 65)
=>
    (set-goal g-battle-balance balance-inferior)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (military-population >= 72)
    (players-military-population any-enemy < 38)
=>
    (set-goal g-battle-balance balance-dominant)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (not(goal g-battle-balance balance-dominant))
    (military-population >= 62)
    (players-military-population any-enemy < 54)
=>
    (set-goal g-battle-balance balance-superior)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (goal g-battle-balance balance-critical)
    (military-population >= 48)
=>
    (set-goal g-battle-balance balance-inferior)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (goal g-battle-balance balance-inferior)
    (military-population >= 58)
    (players-military-population any-enemy < 58)
=>
    (set-goal g-battle-balance balance-even)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (goal g-battle-balance balance-superior)
    (or (military-population < 56) (players-military-population any-enemy >= 64))
=>
    (set-goal g-battle-balance balance-even)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (goal g-battle-balance balance-dominant)
    (or (military-population < 68) (players-military-population any-enemy >= 48))
=>
    (set-goal g-battle-balance balance-superior)
)

; 200-pop profile.
(defrule
    (goal g-maxpop-ge151 1)
    (military-population < 45)
    (players-military-population any-enemy >= 82)
=>
    (set-goal g-battle-balance balance-critical)
)
(defrule
    (goal g-maxpop-ge151 1)
    (not(goal g-battle-balance balance-critical))
    (military-population < 66)
    (players-military-population any-enemy >= 88)
=>
    (set-goal g-battle-balance balance-inferior)
)
(defrule
    (goal g-maxpop-ge151 1)
    (military-population >= 100)
    (players-military-population any-enemy < 55)
=>
    (set-goal g-battle-balance balance-dominant)
)
(defrule
    (goal g-maxpop-ge151 1)
    (not(goal g-battle-balance balance-dominant))
    (military-population >= 88)
    (players-military-population any-enemy < 72)
=>
    (set-goal g-battle-balance balance-superior)
)
(defrule
    (goal g-maxpop-ge151 1)
    (goal g-battle-balance balance-critical)
    (military-population >= 58)
=>
    (set-goal g-battle-balance balance-inferior)
)
(defrule
    (goal g-maxpop-ge151 1)
    (goal g-battle-balance balance-inferior)
    (military-population >= 78)
    (players-military-population any-enemy < 78)
=>
    (set-goal g-battle-balance balance-even)
)
(defrule
    (goal g-maxpop-ge151 1)
    (goal g-battle-balance balance-superior)
    (or (military-population < 78) (players-military-population any-enemy >= 86))
=>
    (set-goal g-battle-balance balance-even)
)
(defrule
    (goal g-maxpop-ge151 1)
    (goal g-battle-balance balance-dominant)
    (or (military-population < 94) (players-military-population any-enemy >= 66))
=>
    (set-goal g-battle-balance balance-superior)
)

; Reserve posture derived from battle balance.
(defrule
    (or (goal g-battle-balance balance-critical) (goal g-battle-balance balance-inferior))
=>
    (set-goal g-reserve-posture reserve-turtle)
)
(defrule
    (goal g-battle-balance balance-even)
=>
    (set-goal g-reserve-posture reserve-balanced)
)
(defrule
    (or (goal g-battle-balance balance-superior) (goal g-battle-balance balance-dominant))
=>
    (set-goal g-reserve-posture reserve-offensive)
)

; Truly critical balance aborts an exposed assault even before the normal
; population-loss Recovery threshold is reached.
(defrule
    (goal g-battle-balance balance-critical)
    (goal g-war-state state-assault)
    (goal g-victory-threat 0)
=>
    (set-goal g-assault-attrition 1)
    (set-goal g-war-state state-recovery)
    (set-goal g-recovery 1)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)

; ==========================================================================
; V9 MAJOR THREAT LEVELS
; Binary V8 flags trigger counters; these stronger flags enlarge the response.
; ==========================================================================
(defrule
    (goal g-major-cavalry 0)
    (or
        (players-unit-type-count any-enemy knight-line >= 18)
        (or (players-unit-type-count any-enemy scout-cavalry-line >= 24) (players-unit-type-count any-enemy camel-line >= 20))
    )
=>
    (set-goal g-major-cavalry 1)
)
(defrule
    (goal g-major-cavalry 1)
    (players-unit-type-count any-enemy knight-line < 9)
    (players-unit-type-count any-enemy scout-cavalry-line < 12)
    (players-unit-type-count any-enemy camel-line < 10)
=>
    (set-goal g-major-cavalry 0)
)
(defrule
    (goal g-major-archer 0)
    (or (players-unit-type-count any-enemy archer-line >= 22) (players-unit-type-count any-enemy cavalry-archer-line >= 16))
=>
    (set-goal g-major-archer 1)
)
(defrule
    (goal g-major-archer 1)
    (players-unit-type-count any-enemy archer-line < 11)
    (players-unit-type-count any-enemy cavalry-archer-line < 8)
=>
    (set-goal g-major-archer 0)
)
(defrule
    (goal g-major-infantry 0)
    (or (players-unit-type-count any-enemy militiaman-line >= 28) (players-unit-type-count any-enemy eagle-warrior-line >= 20))
=>
    (set-goal g-major-infantry 1)
)
(defrule
    (goal g-major-infantry 1)
    (players-unit-type-count any-enemy militiaman-line < 14)
    (players-unit-type-count any-enemy eagle-warrior-line < 10)
=>
    (set-goal g-major-infantry 0)
)
(defrule
    (goal g-major-siege 0)
    (or
        (players-unit-type-count any-enemy battering-ram-line >= 6)
        (or (players-unit-type-count any-enemy mangonel-line >= 5) (players-unit-type-count any-enemy bombard-cannon >= 3))
    )
=>
    (set-goal g-major-siege 1)
)
(defrule
    (goal g-major-siege 1)
    (players-unit-type-count any-enemy battering-ram-line < 3)
    (players-unit-type-count any-enemy mangonel-line < 3)
    (players-unit-type-count any-enemy bombard-cannon < 2)
=>
    (set-goal g-major-siege 0)
)
(defrule
    (goal g-major-monk 0)
    (players-unit-type-count any-enemy monk >= 8)
=>
    (set-goal g-major-monk 1)
)
(defrule
    (goal g-major-monk 1)
    (players-unit-type-count any-enemy monk < 4)
=>
    (set-goal g-major-monk 0)
)

; Fortress targeting: Castle is the strategic target unless an enemy Wonder is active.
(defrule
    (goal g-victory-threat 0)
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
=>
    (set-strategic-number sn-special-attack-type2 castle)
    (set-strategic-number sn-special-attack-influence2 5000)
)
(defrule
    (goal g-victory-threat 0)
    (goal g-fortress-depth 0)
=>
    (set-strategic-number sn-special-attack-type2 -1)
    (set-strategic-number sn-special-attack-influence2 0)
)
(defrule
    (goal g-victory-threat 1)
=>
    (set-strategic-number sn-special-attack-type2 wonder)
    (set-strategic-number sn-special-attack-influence2 10000)
)

; ============================================================================
; V9 POPULATION-SCALED COUNTER PACKAGES
; Counters augment the normal army instead of replacing it.
; ============================================================================
; Cavalry -> spears, camels where available, and a small monk support arm.
(defrule
    (goal g-threat-cavalry 1)
    (or (not(difficulty == hardest)) (current-age >= castle-age))
    (goal g-maxpop-le125 1)
    (military-population < 58)
    (unit-type-count-total spearman-line < 16)
    (food-amount > 400)
    (can-train spearman-line)
=>
    (train spearman-line)
)
