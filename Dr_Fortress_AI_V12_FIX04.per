; -----------------------------
; Population-scaled army recovery
; -----------------------------
; Fixed unit-line caps are useful for composition, but after a disastrous battle
; the AI also needs a generic mechanism that rebuilds military mass. These rules
; fill missing army population with cheap backbone units without replacing the
; premium/counter rules below.

; Castle Age: low population games.
(defrule
    (current-age == castle-age)
    (goal g-maxpop-le50 1)
    (military-population < 16)
    (unit-type-count-total spearman-line < 10)
    (food-amount > 300)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (current-age == castle-age)
    (goal g-maxpop-le50 1)
    (military-population < 16)
    (unit-type-count-total skirmisher-line < 10)
    (food-amount > 250)
    (wood-amount > 300)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)

; Castle Age: normal / large population games.
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge51 1)
    (goal g-maxpop-le75 1)
    (military-population < 24)
    (unit-type-count-total spearman-line < 12)
    (food-amount > 320)
    (can-train spearman-line)
=>
    (train spearman-line)
)
