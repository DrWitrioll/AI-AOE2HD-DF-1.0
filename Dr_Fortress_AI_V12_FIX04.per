    (food-amount > 600)
    (can-train scout-cavalry-line)
=>
    (train scout-cavalry-line)
)

; Unique unit as a premium force, not the entire army. In an Imperial
; fortress fight the Castle queue first establishes two trebuchets so unique
; unit production cannot starve the essential long-range siege package.
(defrule
    (current-age == castle-age)
    (building-type-count castle > 0)
    (unit-type-count-total my-unique-unit-line < 12)
    (food-amount > 700)
    (gold-amount > 700)
    (can-train my-unique-unit-line)
=>
    (train my-unique-unit-line)
)
(defrule
    (current-age == imperial-age)
    (goal g-fortress-threat 0)
    (building-type-count castle > 0)
    (unit-type-count-total my-unique-unit-line < 12)
    (food-amount > 700)
    (gold-amount > 700)
    (can-train my-unique-unit-line)
=>
    (train my-unique-unit-line)
)
(defrule
    (current-age == imperial-age)
    (goal g-fortress-threat 1)
    (building-type-count castle > 0)
    (unit-type-count-total trebuchet >= 2)
    (unit-type-count-total my-unique-unit-line < 12)
    (food-amount > 700)
    (gold-amount > 700)
    (can-train my-unique-unit-line)
=>
    (train my-unique-unit-line)
)

; Monks provide support rather than mass conversion spam.
(defrule
    (building-type-count monastery > 0)
    (unit-type-count-total monk < 4)
    (gold-amount > 400)
    (can-train monk)
=>
    (train monk)
)

