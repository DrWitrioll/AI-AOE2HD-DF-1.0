; ============================================================================
; TEAM TRADE - FIXED6 DIFFICULTY CAPS
; ============================================================================
; Castle Age establishes only a minimal route. Imperial cap is 2/4/6/8/10
; from Easiest to Hardest so renewable gold cannot eat the military population.
(defrule
    (current-age >= castle-age)
    (player-in-game any-ally)
    (building-type-count market > 0)
    (players-building-type-count any-ally market > 0)
    (unit-type-count-total trade-cart < 2)
    (up-pending-objects c: trade-cart < 1)
    (wood-amount > 650)
    (gold-amount > 300)
    (can-train trade-cart)
=>
    (train trade-cart)
)
(defrule
    (current-age == imperial-age)
    (difficulty == easy)
    (player-in-game any-ally)
    (building-type-count market > 0)
    (players-building-type-count any-ally market > 0)
    (unit-type-count-total trade-cart < 4)
    (can-train trade-cart)
=>
    (train trade-cart)
)
(defrule
    (current-age == imperial-age)
    (difficulty == moderate)
    (player-in-game any-ally)
    (building-type-count market > 0)
    (players-building-type-count any-ally market > 0)
    (unit-type-count-total trade-cart < 6)
    (can-train trade-cart)
=>
    (train trade-cart)
)
(defrule
    (current-age == imperial-age)
    (difficulty == hard)
    (player-in-game any-ally)
    (building-type-count market > 0)
    (players-building-type-count any-ally market > 0)
    (unit-type-count-total trade-cart < 8)
    (can-train trade-cart)
=>
    (train trade-cart)
)
(defrule
    (current-age == imperial-age)
    (difficulty == hardest)
    (player-in-game any-ally)
    (building-type-count market > 0)
    (players-building-type-count any-ally market > 0)
    (unit-type-count-total trade-cart < 10)
    (up-pending-objects c: trade-cart < 2)
    (wood-amount > 900)
    (can-train trade-cart)
=>
    (train trade-cart)
)
; Water trade remains deliberately smaller than the combat fleet.
(defrule
    (goal g-water 1)
    (current-age == imperial-age)
    (player-in-game any-ally)
    (building-type-count dock > 0)
    (players-building-type-count any-ally dock > 0)
    (unit-type-count-total trade-cog < 4)
    (up-pending-objects c: trade-cog < 1)
    (wood-amount > 1200)
    (can-train trade-cog)
=>
    (train trade-cog)
)

; ==========================================================================
; V9 FORTRESS MASTER - SHORT-TERM ECONOMIC STABILITY
; Percentages handle the long-term economy. These rules add a small official-HD
; retask pulse only when food has collapsed so production can restart quickly.
; ==========================================================================
(defrule
    (current-age >= castle-age)
    (food-amount < 120)
    (civilian-population >= 35)
    (goal g-econ-stability 1)
=>
    (up-retask-gatherers food c: 1)
    (set-goal g-econ-stability 0)
)
(defrule
    (goal g-econ-stability 0)
    (food-amount > 450)
=>
    (set-goal g-econ-stability 1)
)

; FIXED6 economic redistribution pulses. These use the HD-proven gatherer retask
; action and only fire on extreme imbalances, preventing giant single-resource blobs.
(defrule
    (current-age >= castle-age)
    (food-amount > 3500)
    (wood-amount < 700)
=>
    (up-retask-gatherers wood c: 3)
)
(defrule
    (current-age >= castle-age)
    (wood-amount > 3500)
    (food-amount < 700)
=>
    (up-retask-gatherers food c: 3)
)
(defrule
    (current-age >= castle-age)
    (food-amount > 3500)
    (gold-amount < 500)
=>
    (up-retask-gatherers gold c: 2)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (wood-amount > 2500)
    (stone-amount < 700)
=>
    (up-retask-gatherers stone c: 3)
)

; ==========================================================================
; V9 MARKET / RESOURCE CRISIS ARBITRATION
; ==========================================================================
; Crisis memory with hysteresis.
(defrule
    (current-age >= castle-age)
    (goal g-food-crisis 0)
    (food-amount < 250)
    (military-population > 25)
=>
    (set-goal g-food-crisis 1)
)
(defrule
    (goal g-food-crisis 1)
    (food-amount > 750)
=>
    (set-goal g-food-crisis 0)
)
(defrule
    (current-age >= castle-age)
    (goal g-wood-crisis 0)
    (wood-amount < 300)
    (or (goal g-war-state state-fortify) (goal g-war-state state-siege))
=>
    (set-goal g-wood-crisis 1)
)
(defrule
    (goal g-wood-crisis 1)
    (wood-amount > 850)
=>
    (set-goal g-wood-crisis 0)
)
(defrule
    (current-age >= castle-age)
    (goal g-stone-crisis 0)
    (building-type-count-total castle < 1)
    (stone-amount < 900)
=>
    (set-goal g-stone-crisis 1)
)
(defrule
    (goal g-stone-crisis 1)
    (or (building-type-count-total castle >= 1) (stone-amount > 1450))
=>
    (set-goal g-stone-crisis 0)
)

; Priority: do not spend gold at market during a gold crisis.
(defrule
    (goal g-gold-crisis 1)
=>
    (set-goal g-market-mode market-none)
)
(defrule
    (goal g-gold-crisis 0)
    (goal g-stone-crisis 1)
=>
    (set-goal g-market-mode market-stone)
)
(defrule
    (goal g-gold-crisis 0)
    (goal g-stone-crisis 0)
    (goal g-wood-crisis 1)
=>
    (set-goal g-market-mode market-wood)
)
(defrule
    (goal g-gold-crisis 0)
    (goal g-stone-crisis 0)
    (goal g-wood-crisis 0)
    (goal g-food-crisis 1)
=>
    (set-goal g-market-mode market-food)
)
(defrule
    (goal g-gold-crisis 0)
    (goal g-food-crisis 0)
    (goal g-wood-crisis 0)
    (goal g-stone-crisis 0)
=>
    (set-goal g-market-mode market-none)
)
(defrule
    (goal g-gold-crisis 0)
    (goal g-food-crisis 0)
    (goal g-wood-crisis 0)
    (goal g-stone-crisis 0)
    (current-age == imperial-age)
    (building-type-count castle >= 3)
    (stone-amount > 2300)
    (gold-amount < 700)
=>
    (set-goal g-market-mode market-sell-stone)
)

(defrule
    (goal g-market-mode market-food)
    (gold-amount > 1200)
    (commodity-buying-price food < 180)
    (can-buy-commodity food)
=>
    (buy-commodity food)
)
(defrule
    (goal g-market-mode market-wood)
    (gold-amount > 1200)
    (commodity-buying-price wood < 180)
    (can-buy-commodity wood)
=>
    (buy-commodity wood)
)
(defrule
    (goal g-market-mode market-stone)
    (gold-amount > 1900)
    (commodity-buying-price stone < 220)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)
(defrule
    (goal g-market-mode market-sell-stone)
    (commodity-selling-price stone > 45)
    (can-sell-commodity stone)
=>
    (sell-commodity stone)
)

; General premium-army gold recovery if food or wood is extremely abundant.
(defrule
    (gold-amount < 450)
    (food-amount > 2200)
    (commodity-selling-price food > 45)
    (can-sell-commodity food)
=>
    (sell-commodity food)
)
(defrule
    (gold-amount < 450)
    (wood-amount > 2400)
    (commodity-selling-price wood > 45)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
)

; ============================================================================
; WONDER LOGIC
; Wonder is deliberately vulnerable in the DAT, so build only behind a real fortress.
; ============================================================================
(defrule
    (current-age == imperial-age)
    (victory-condition standard)
    (building-type-count-total wonder < 1)
    (building-type-count castle >= 2)
    (military-population >= 35)
    (wood-amount > 2300)
    (gold-amount > 2300)
    (stone-amount > 2300)
    (can-build wonder)
=>
    (build wonder)
    (set-goal g-late-phase 1)
)

; ==========================================================================
; V9 FORTRESS MASTER - FORWARD SIEGE LOGISTICS
; Deep fortresses justify a closer workshop, but only after a large escort
; exists. build-forward is used by the supplied official HD AI.
; ==========================================================================
(defrule
    (goal g-water 0)
    (goal g-war-state state-siege)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-forward-siege 0)
    (goal g-maxpop-le125 1)
    (soldier-count >= 48)
    (wood-amount > 1500)
    (can-build siege-workshop)
=>
    (set-strategic-number sn-number-forward-builders 3)
    (build-forward siege-workshop)
    (set-goal g-forward-siege 1)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-siege)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-forward-siege 0)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 58)
    (wood-amount > 1700)
    (can-build siege-workshop)
=>
    (set-strategic-number sn-number-forward-builders 3)
    (build-forward siege-workshop)
    (set-goal g-forward-siege 1)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-siege)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-forward-siege 0)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 78)
    (wood-amount > 1900)
    (can-build siege-workshop)
=>
    (set-strategic-number sn-number-forward-builders 4)
    (build-forward siege-workshop)
    (set-goal g-forward-siege 1)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-siege)
    (goal g-fortress-depth 3)
    (goal g-forward-siege 1)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 90)
    (wood-amount > 2400)
    (building-type-count-total siege-workshop < 6)
    (can-build siege-workshop)
=>
    (set-strategic-number sn-number-forward-builders 4)
    (build-forward siege-workshop)
    (set-goal g-forward-siege 2)
)

; ==========================================================================
; V9 ANTI-FORWARD / PROXY RESPONSE
; An enemy building inside town is treated as an emergency before it starts
; inflicting enough damage for town-under-attack to become true.
; ==========================================================================
(defrule
    (enemy-buildings-in-town)
    (goal g-forward-fortify 0)
=>
    (set-goal g-forward-fortify 1)
    (set-goal g-war-state state-emergency)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-gather-defense-units 1)
)
(defrule
    (goal g-forward-fortify 1)
    (not (enemy-buildings-in-town))
    (not (town-under-attack))
    (current-age < castle-age)
    (goal g-recovery 0)
=>
    (set-goal g-forward-fortify 0)
    (set-goal g-war-state state-develop)
)
(defrule
    (goal g-forward-fortify 1)
    (not (enemy-buildings-in-town))
    (not (town-under-attack))
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (goal g-recovery 0)
=>
    (set-goal g-forward-fortify 0)
    (set-goal g-war-state state-fortify)
)
(defrule
    (goal g-forward-fortify 1)
    (not (enemy-buildings-in-town))
    (not (town-under-attack))
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-recovery 0)
=>
    (set-goal g-forward-fortify 0)
    (set-goal g-war-state state-mobilize)
)

; Forward-builder reset outside active land siege logistics.
(defrule
    (goal g-water 0)
    (goal g-transport-map 0)
    (not(goal g-war-state state-siege))
    (not(goal g-war-state state-assault))
=>
    (set-strategic-number sn-number-forward-builders 1)
)

; ============================================================================
; V9 WAR STATE MACHINE
; DEVELOP -> FORTIFY -> MOBILIZE -> SIEGE -> ASSAULT -> MOBILIZE
;                                    |          |
;                                    +-> RECOVERY <- losses
; Any active state can be interrupted by EMERGENCY when the town is attacked.
; ============================================================================

; Recurring land assault windows: difficulty changes cadence, not resources.
(defrule
    (timer-triggered t-land-assault)
    (difficulty == hardest)
    (goal g-war-state state-mobilize)
    (goal g-inferior 0)
=>
    (disable-timer t-land-assault)
    (enable-timer t-land-assault 300)
    (set-goal g-assault-window 1)
)
(defrule
    (timer-triggered t-land-assault)
    (difficulty == hard)
    (goal g-war-state state-mobilize)
    (goal g-inferior 0)
=>
    (disable-timer t-land-assault)
    (enable-timer t-land-assault 360)
    (set-goal g-assault-window 1)
)
(defrule
    (timer-triggered t-land-assault)
    (difficulty == moderate)
    (goal g-war-state state-mobilize)
    (goal g-inferior 0)
=>
    (disable-timer t-land-assault)
    (enable-timer t-land-assault 420)
    (set-goal g-assault-window 1)
)
(defrule
    (timer-triggered t-land-assault)
    (difficulty == easy)
    (goal g-war-state state-mobilize)
    (goal g-inferior 0)
=>
    (disable-timer t-land-assault)
    (enable-timer t-land-assault 480)
    (set-goal g-assault-window 1)
)
(defrule
    (timer-triggered t-land-assault)
    (difficulty == easiest)
    (goal g-war-state state-mobilize)
    (goal g-inferior 0)
=>
    (disable-timer t-land-assault)
    (enable-timer t-land-assault 540)
    (set-goal g-assault-window 1)
)

; If the timer fires during fortification, recovery, siege preparation or
; inferiority, discard that window and require a fresh cycle.
(defrule
    (timer-triggered t-land-assault)
    (or
        (not(goal g-war-state state-mobilize))
        (goal g-inferior 1)
    )
=>
    (disable-timer t-land-assault)
    (enable-timer t-land-assault 420)
    (set-goal g-assault-window 0)
)

; Naval pressure uses a slightly slower recurring cycle.
(defrule
    (timer-triggered t-naval-assault)
    (difficulty <= hard)
    (goal g-water 1)
    (not (town-under-attack))
=>
    (disable-timer t-naval-assault)
    (enable-timer t-naval-assault 420)
    (set-goal g-naval-assault-window 1)
)
(defrule
    (timer-triggered t-naval-assault)
    (difficulty == hardest)
    (goal g-water 1)
    (not (town-under-attack))
=>
    (disable-timer t-naval-assault)
    (enable-timer t-naval-assault 540)
    (set-goal g-naval-assault-window 1)
)

; Do not let a naval window sit permanently triggered on land or during a
; base emergency.
(defrule
    (timer-triggered t-naval-assault)
    (goal g-water 0)
=>
    (disable-timer t-naval-assault)
    (set-goal g-naval-assault-window 0)
)
(defrule
    (timer-triggered t-naval-assault)
    (goal g-water 1)
    (town-under-attack)
=>
    (disable-timer t-naval-assault)
    (enable-timer t-naval-assault 540)
    (set-goal g-naval-assault-window 0)
)

; Development ends when Castle Age starts. A missing Castle always returns the
; land doctrine to FORTIFY, even if an earlier fortress was destroyed.
(defrule
    (goal g-war-state state-develop)
    (current-age >= castle-age)
=>
    (set-goal g-war-state state-fortify)
    (set-strategic-number sn-number-attack-groups 0)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (goal g-emergency-defense 0)
    (not(goal g-war-state state-fortify))
=>
    (set-goal g-recovery 0)
    (set-goal g-war-state state-fortify)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)
; FIXED6 Hardest does not wait for a perfect 85% second ring before field pressure.
; The persistent wall rules keep construction going while the army mobilizes.
(defrule
    (difficulty == hardest)
    (goal g-war-state state-fortify)
    (goal g-closed-map 0)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 2 >= 50)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
=>
    (set-goal g-war-state state-mobilize)
)
(defrule
    (difficulty == hardest)
    (goal g-war-state state-fortify)
    (goal g-closed-map 1)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 2 >= 60)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
=>
    (set-goal g-war-state state-mobilize)
)

(defrule
    (goal g-war-state state-fortify)
    (goal g-closed-map 0)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 2 >= 85)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
=>
    (set-goal g-war-state state-mobilize)
)
(defrule
    (goal g-war-state state-fortify)
    (goal g-closed-map 1)
    (building-type-count-total castle >= 1)
    (wall-completed-percentage 2 >= 75)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
=>
    (set-goal g-war-state state-mobilize)
)
(defrule
    (goal g-war-state state-fortify)
    (goal g-closed-map 1)
    (building-type-count-total castle >= 1)
    (current-age-time > 900)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
=>
    (set-goal g-war-state state-mobilize)
)

; Enemy Wonder overrides the normal waiting cycle once it has actually been seen.
(defrule
    (goal g-victory-threat 1)
    (current-age >= castle-age)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
    (not(goal g-war-state state-assault))
=>
    (set-goal g-assault-window 1)
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
)

; Army-established thresholds. Primary tuning is 125/150/200; lower profiles
; remain safe fallbacks rather than the design center.
(defrule
    (goal g-army-established 0)
    (goal g-maxpop-le75 1)
    (soldier-count >= 22)
=>
    (set-goal g-army-established 1)
)
(defrule
    (goal g-army-established 0)
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (soldier-count >= 30)
=>
    (set-goal g-army-established 1)
)
(defrule
    (goal g-army-established 0)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (soldier-count >= 42)
=>
    (set-goal g-army-established 1)
)
(defrule
    (goal g-army-established 0)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 55)
=>
    (set-goal g-army-established 1)
)
(defrule
    (goal g-army-established 0)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 75)
=>
    (set-goal g-army-established 1)
)

; Major losses enter real RECOVERY and immediately call the HD retreat action.
(defrule
    (goal g-army-established 1)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-maxpop-le75 1)
    (soldier-count < 14)
=>
    (set-goal g-recovery 1)
    (set-goal g-war-state state-recovery)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)
(defrule
    (goal g-army-established 1)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (soldier-count < 20)
=>
    (set-goal g-recovery 1)
    (set-goal g-war-state state-recovery)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)
(defrule
    (goal g-army-established 1)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (soldier-count < 26)
=>
    (set-goal g-recovery 1)
    (set-goal g-war-state state-recovery)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)
(defrule
    (goal g-army-established 1)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count < 34)
=>
    (set-goal g-recovery 1)
    (set-goal g-war-state state-recovery)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)
(defrule
    (goal g-army-established 1)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (goal g-maxpop-ge151 1)
    (soldier-count < 48)
=>
    (set-goal g-recovery 1)
    (set-goal g-war-state state-recovery)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)

; --------------------------------------------------------------------------
; V10 TEAM STATUS: genuine heavy-loss recovery only.
; The thresholds mirror the actual Recovery-entry thresholds, avoiding a false
; "heavily depleted" report after a base emergency that left the army healthy.
; --------------------------------------------------------------------------
(defrule
    (goal g-recovery 1)
    (goal g-chat-recovery 0)
    (player-in-game any-human-ally)
    (or
        (and (goal g-maxpop-le75 1) (soldier-count < 14))
        (or
            (and (goal g-maxpop-ge76 1) (and (goal g-maxpop-le100 1) (soldier-count < 20)))
            (or
                (and (goal g-maxpop-ge101 1) (and (goal g-maxpop-le125 1) (soldier-count < 26)))
                (or
                    (and (goal g-maxpop-ge126 1) (and (goal g-maxpop-le150 1) (soldier-count < 34)))
                    (and (goal g-maxpop-ge151 1) (soldier-count < 48))
                )
            )
        )
    )
=>
    (chat-to-allies "Army heavily depleted. Rebuilding.")
    (set-goal g-chat-recovery 1)
)

; Recovery ends only after a meaningful army has been rebuilt.
(defrule
    (goal g-recovery 1)
    (not (town-under-attack))
    (goal g-maxpop-le75 1)
    (soldier-count >= 22)
=>
    (set-goal g-recovery 0)
    (set-goal g-war-state state-mobilize)
)
(defrule
    (goal g-recovery 1)
    (not (town-under-attack))
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (soldier-count >= 32)
=>
    (set-goal g-recovery 0)
    (set-goal g-war-state state-mobilize)
)
(defrule
    (goal g-recovery 1)
    (not (town-under-attack))
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (soldier-count >= 42)
=>
    (set-goal g-recovery 0)
    (set-goal g-war-state state-mobilize)
)
(defrule
    (goal g-recovery 1)
    (not (town-under-attack))
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 55)
=>
    (set-goal g-recovery 0)
    (set-goal g-war-state state-mobilize)
)
(defrule
    (goal g-recovery 1)
    (not (town-under-attack))
    (goal g-maxpop-ge151 1)
    (soldier-count >= 75)
=>
    (set-goal g-recovery 0)
    (set-goal g-war-state state-mobilize)
)

; Re-arm the recovery message only after Recovery has actually ended.
(defrule
    (goal g-recovery 0)
    (goal g-chat-recovery 1)
=>
    (set-goal g-chat-recovery 0)
)

; V12 FIX02 base emergency: the army forms a defend group and fights inside the
; fortress.  Global retreat is reserved for a lost field battle, never for the
; event that should trigger base defense.
(defrule
    (town-under-attack)
    (goal g-emergency-defense 0)
=>
    (set-goal g-emergency-defense 1)
    (set-goal g-war-state state-emergency)
    (set-goal g-assault-window 0)
    (set-goal g-naval-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 28)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 60)
    (disable-timer t-safety-release)
    (enable-timer t-safety-release 45)
)
; Early-game emergencies return to development. Recovery thresholds are designed
; for established Castle/Imperial armies and must never trap Dark/Feudal play.
(defrule
    (not (town-under-attack))
    (goal g-emergency-defense 1)
    (timer-triggered t-safety-release)
    (current-age < castle-age)
=>
    (set-goal g-emergency-defense 0)
    (set-goal g-recovery 0)
    (set-goal g-war-state state-develop)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 14)
    (set-strategic-number sn-percent-enemy-sighted-response 90)
    (set-strategic-number sn-enemy-sighted-response-distance 35)
)

; Castle/Imperial emergencies enter Recovery only if a mature army had already
; existed. This prevents an early Castle-Age raid from trapping a developing AI
; behind a late-game recovery threshold it has never reached.
(defrule
    (not (town-under-attack))
    (goal g-emergency-defense 1)
    (timer-triggered t-safety-release)
    (current-age >= castle-age)
    (goal g-army-established 1)
=>
    (set-goal g-emergency-defense 0)
    (set-goal g-recovery 1)
    (set-goal g-war-state state-recovery)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 14)
    (set-strategic-number sn-percent-enemy-sighted-response 90)
    (set-strategic-number sn-enemy-sighted-response-distance 35)
)

; If the army was not established yet, resume the strategic build-up instead.
(defrule
    (not (town-under-attack))
    (goal g-emergency-defense 1)
    (timer-triggered t-safety-release)
    (current-age >= castle-age)
    (goal g-army-established 0)
    (building-type-count-total castle < 1)
=>
    (set-goal g-emergency-defense 0)
    (set-goal g-recovery 0)
    (set-goal g-war-state state-fortify)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 14)
    (set-strategic-number sn-percent-enemy-sighted-response 90)
    (set-strategic-number sn-enemy-sighted-response-distance 35)
)
(defrule
    (not (town-under-attack))
    (goal g-emergency-defense 1)
    (timer-triggered t-safety-release)
    (current-age >= castle-age)
    (goal g-army-established 0)
    (building-type-count-total castle >= 1)
=>
    (set-goal g-emergency-defense 0)
    (set-goal g-recovery 0)
    (set-goal g-war-state state-mobilize)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 14)
    (set-strategic-number sn-percent-enemy-sighted-response 90)
    (set-strategic-number sn-enemy-sighted-response-distance 35)
)

; V9 defense depth. Fortress play keeps a real reserve instead of sending every unit.
(defrule
    (goal g-war-state state-fortify)
    (goal g-maxpop-le125 1)
=>
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 5)
    (set-strategic-number sn-maximum-defend-group-size 14)
)
(defrule
    (goal g-war-state state-fortify)
    (goal g-maxpop-ge126 1)
=>
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 18)
)
(defrule
    (goal g-war-state state-emergency)
    (goal g-maxpop-ge151 1)
=>
    (set-strategic-number sn-number-defend-groups 3)
    (set-strategic-number sn-minimum-defend-group-size 8)
    (set-strategic-number sn-maximum-defend-group-size 24)
)
(defrule
    (goal g-war-state state-assault)
=>
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 5)
    (set-strategic-number sn-maximum-defend-group-size 16)
)

; ==========================================================================
; V9 FORTRESS MASTER - ANTI-STALEMATE ESCALATION
; Fortress Age is meant to be slow, not permanently frozen. Escalation only
; starts after one hour and increases siege depth in long Imperial wars.
; ==========================================================================
(defrule
    (current-age == imperial-age)
    (game-time > 3600)
    (goal g-escalation 0)
=>
    (set-goal g-escalation 1)
)
(defrule
    (current-age == imperial-age)
    (game-time > 5400)
    (or (goal g-escalation 0) (goal g-escalation 1))
=>
    (set-goal g-escalation 2)
)
(defrule
    (current-age == imperial-age)
    (game-time > 7200)
    (or (goal g-escalation 0) (or (goal g-escalation 1) (goal g-escalation 2)))
=>
    (set-goal g-escalation 3)
)
(defrule
    (or (goal g-escalation 1) (or (goal g-escalation 2) (goal g-escalation 3)))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (unit-type-count-total battering-ram-line < 8)
    (wood-amount > 1800)
    (gold-amount > 1000)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (or (goal g-escalation 1) (or (goal g-escalation 2) (goal g-escalation 3)))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (unit-type-count-total trebuchet < 4)
    (wood-amount > 1800)
    (gold-amount > 1500)
    (can-train trebuchet)
=>
    (train trebuchet)
)
(defrule
    (or (goal g-escalation 2) (goal g-escalation 3))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-le125 1)
    (unit-type-count-total battering-ram-line < 9)
    (wood-amount > 2100)
    (gold-amount > 1200)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (or (goal g-escalation 2) (goal g-escalation 3))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (unit-type-count-total battering-ram-line < 10)
    (wood-amount > 2300)
    (gold-amount > 1300)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (or (goal g-escalation 2) (goal g-escalation 3))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-ge151 1)
    (unit-type-count-total battering-ram-line < 12)
    (wood-amount > 2500)
    (gold-amount > 1400)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (or (goal g-escalation 2) (goal g-escalation 3))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-le150 1)
    (unit-type-count-total trebuchet < 5)
    (wood-amount > 2200)
    (gold-amount > 1800)
    (can-train trebuchet)
=>
    (train trebuchet)
)
(defrule
    (or (goal g-escalation 2) (goal g-escalation 3))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-ge151 1)
    (unit-type-count-total trebuchet < 6)
    (wood-amount > 2500)
    (gold-amount > 2100)
    (can-train trebuchet)
=>
    (train trebuchet)
)
(defrule
    (or (goal g-escalation 2) (goal g-escalation 3))
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (unit-type-count-total bombard-cannon < 3)
    (wood-amount > 2400)
    (gold-amount > 2400)
    (can-train bombard-cannon)
=>
    (train bombard-cannon)
)
(defrule
    (goal g-escalation 3)
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-ge151 1)
    (unit-type-count-total battering-ram-line < 14)
    (wood-amount > 3000)
    (gold-amount > 1700)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (goal g-escalation 3)
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-ge151 1)
    (unit-type-count-total trebuchet < 7)
    (wood-amount > 3000)
    (gold-amount > 2400)
    (can-train trebuchet)
=>
    (train trebuchet)
)
(defrule
    (goal g-escalation 3)
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (goal g-maxpop-ge151 1)
    (unit-type-count-total bombard-cannon < 5)
    (wood-amount > 3000)
    (gold-amount > 3000)
    (can-train bombard-cannon)
=>
    (train bombard-cannon)
)

; V9 Fortress Master reserve posture.
(defrule
    (goal g-reserve-posture reserve-turtle)
    (not(goal g-war-state state-assault))
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-number-defend-groups 3)
    (set-strategic-number sn-percent-attack-soldiers 45)
)
(defrule
    (goal g-reserve-posture reserve-balanced)
    (goal g-war-state state-mobilize)
=>
    (set-strategic-number sn-number-defend-groups 2)
)
(defrule
    (goal g-reserve-posture reserve-offensive)
    (goal g-war-state state-mobilize)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
=>
    (set-strategic-number sn-number-defend-groups 1)
)

; Last-resort civilian defense is deliberately narrow. It is disabled again
; as soon as the base survives, so villagers do not become normal combatants.
(defrule
    (town-under-attack)
    (military-population < 10)
    (civilian-population >= 18)
    (goal g-civilian-laststand 0)
=>
    (set-strategic-number sn-allow-civilian-defense 0)
    (set-goal g-civilian-laststand 1)
)
(defrule
    (goal g-civilian-laststand 1)
    (not (town-under-attack))
=>
    (set-strategic-number sn-allow-civilian-defense 0)
    (set-goal g-civilian-laststand 0)
)
(defrule
    (goal g-civilian-laststand 1)
    (military-population >= 18)
=>
    (set-strategic-number sn-allow-civilian-defense 0)
    (set-goal g-civilian-laststand 0)
)

; Assault attrition: a deep-fortress army that loses nearly all of its siege
; does not stand under Castle/Bombard-Tower fire until the fixed reassess timer.
(defrule
    (goal g-war-state state-assault)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-maxpop-le125 1)
    (unit-type-count-total battering-ram-line < 3)
    (unit-type-count-total trebuchet < 1)
=>
    (set-goal g-assault-attrition 1)
    (set-goal g-war-state state-mobilize)
    (set-goal g-assault-window 0)
    (up-retreat-now)
)
(defrule
    (goal g-war-state state-assault)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (unit-type-count-total battering-ram-line < 3)
    (unit-type-count-total trebuchet < 1)
=>
    (set-goal g-assault-attrition 1)
    (set-goal g-war-state state-mobilize)
    (set-goal g-assault-window 0)
    (up-retreat-now)
)
(defrule
    (goal g-war-state state-assault)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-maxpop-ge151 1)
    (unit-type-count-total battering-ram-line < 4)
    (unit-type-count-total trebuchet < 2)
=>
    (set-goal g-assault-attrition 1)
    (set-goal g-war-state state-mobilize)
    (set-goal g-assault-window 0)
    (up-retreat-now)
)
(defrule
    (goal g-assault-attrition 1)
    (goal g-war-state state-siege)
=>
    (set-goal g-assault-attrition 0)
)

; Do not launch a deliberate fortress assault while clearly outnumbered.
(defrule
    (goal g-inferior 1)
    (goal g-victory-threat 0)
    (goal g-war-state state-siege)
=>
    (set-goal g-war-state state-mobilize)
    (set-goal g-assault-window 0)
)
(defrule
    (goal g-inferior 1)
    (goal g-victory-threat 0)
    (goal g-war-state state-assault)
=>
    (set-goal g-war-state state-mobilize)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)

; FIXED6 Hardest field pressure. If no enemy fortress has been identified,
; Castle-Age armies attack as a coherent field group instead of waiting for a huge
; 76-unit siege threshold. Fortress targets still go through SIEGE below.
(defrule
    (difficulty == hardest)
    (goal g-war-state state-mobilize)
    (goal g-assault-window 1)
    (goal g-inferior 0)
    (goal g-fortress-threat 0)
    (current-age >= castle-age)
    (military-population >= 24)
=>
    (set-goal g-war-state state-assault)
)

; MOBILIZE -> SIEGE once a periodic assault window is open and enough military
; exists to justify spending heavily on artillery.
(defrule
    (goal g-war-state state-mobilize)
    (goal g-assault-window 1)
    (goal g-inferior 0)
    (goal g-maxpop-le75 1)
    (soldier-count >= 24)
=>
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
)
(defrule
    (goal g-war-state state-mobilize)
    (goal g-assault-window 1)
    (goal g-inferior 0)
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (soldier-count >= 34)
=>
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
)
(defrule
    (goal g-war-state state-mobilize)
    (goal g-assault-window 1)
    (goal g-inferior 0)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (soldier-count >= 32)
=>
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
)
(defrule
    (goal g-war-state state-mobilize)
    (goal g-assault-window 1)
    (goal g-inferior 0)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 38)
=>
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
)
(defrule
    (goal g-war-state state-mobilize)
    (goal g-assault-window 1)
    (goal g-inferior 0)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 44)
=>
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
)

; --------------------------------------------------------------------------
; V10 TEAM STATUS: siege staging edge.
; This section sits between MOBILIZE->SIEGE and SIEGE->ASSAULT so even a force
; that is already nearly ready reports the new preparation phase exactly once.
; --------------------------------------------------------------------------
(defrule
    (goal g-war-state state-siege)
    (goal g-chat-siege-prep 0)
    (player-in-game any-human-ally)
=>
    (chat-to-allies "Preparing siege.")
    (set-goal g-chat-siege-prep 1)
)

; Re-arm only after leaving SIEGE, allowing one report per future siege cycle.
(defrule
    (not(goal g-war-state state-siege))
    (goal g-chat-siege-prep 1)
=>
    (set-goal g-chat-siege-prep 0)
)

; The timeout itself is a one-shot event because the next rule disables the timer
; and returns to MOBILIZE.  No extra chat flag is required.
(defrule
    (timer-triggered t-siege-prep)
    (goal g-war-state state-siege)
    (player-in-game any-human-ally)
=>
    (chat-to-allies "I cannot attack yet. Siege force incomplete.")
)

; Siege preparation has a hard timeout. If the exact package cannot be formed
; in eight minutes, abandon the stale staging state, regroup, and try again later.
(defrule
    (timer-triggered t-siege-prep)
    (goal g-war-state state-siege)
=>
    (disable-timer t-siege-prep)
    (set-goal g-war-state state-mobilize)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
)
(defrule
    (timer-triggered t-siege-prep)
    (not(goal g-war-state state-siege))
=>
    (disable-timer t-siege-prep)
)

; SIEGE -> ASSAULT, Castle Age. Known fortresses require a substantially deeper
; ram package than ordinary pressure.
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 0)
    (current-age == castle-age)
    (goal g-maxpop-le75 1)
    (soldier-count >= 24)
    (unit-type-count-total battering-ram-line >= 2)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 1)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (current-age == castle-age)
    (goal g-maxpop-le75 1)
    (soldier-count >= 26)
    (unit-type-count-total battering-ram-line >= 3)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 0)
    (current-age == castle-age)
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (soldier-count >= 30)
    (unit-type-count-total battering-ram-line >= 2)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 1)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (current-age == castle-age)
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (soldier-count >= 34)
    (unit-type-count-total battering-ram-line >= 4)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 0)
    (current-age == castle-age)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (soldier-count >= 44)
    (unit-type-count-total battering-ram-line >= 3)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 1)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (current-age == castle-age)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (soldier-count >= 32)
    (unit-type-count-total battering-ram-line >= 3)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 0)
    (current-age == castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 56)
    (unit-type-count-total battering-ram-line >= 4)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 1)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (current-age == castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 38)
    (unit-type-count-total battering-ram-line >= 3)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 0)
    (current-age == castle-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 76)
    (unit-type-count-total battering-ram-line >= 5)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 1)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (current-age == castle-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 44)
    (unit-type-count-total battering-ram-line >= 4)
=>
    (set-goal g-war-state state-assault)
)

; SIEGE -> ASSAULT, Imperial Age. Trebuchets are required only for a serious
; fortress commitment, so civilizations never deadlock because BBC is absent.
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 0)
