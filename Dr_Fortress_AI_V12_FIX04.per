; ============================================================================
; V11 FINAL COMMAND / SAFETY OVERLAYS
; ============================================================================
(defrule
    (goal g-command-hold 1)
    (not(goal g-war-state state-emergency))
    (not(goal g-war-state state-recovery))
=>
    (set-goal g-war-state state-fortify)
    (set-goal g-assault-window 0)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
)
(defrule
    (goal g-command-force 1)
    (goal g-war-state state-assault)
=>
    (set-goal g-command-force 0)
)
(defrule
    (goal g-command-siege 1)
    (goal g-war-state state-assault)
=>
    (set-goal g-command-siege 0)
)



; ============================================================================
; FIXED9 ARABIA / VERY-HARD REPLAY REPAIR OVERLAY
; Source replay: Arabia, Medium (4-player size), 1v1, Standard resources, Pop 150,
; Very Hard, fixed positions.  The replay ended at 39:48 with FIXED8 resigning.
; ============================================================================

; Opening economy: the first house is enough construction for the three starting
; villagers.  Reinforce food tasking once the first extra villager exists.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 35)
    (game-time < 150)
    (civilian-population >= 4)
=>
    (set-strategic-number sn-food-gatherer-percentage 70)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

; Return to the intended Dark-Age stone commitment once the economy is large enough.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population >= 16)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (set-strategic-number sn-stone-gatherer-percentage 20)
)

; The dedicated scout owns early exploration.  Home exploration time remains 360s,
; so it searches the base ring first and only then pushes farther out.  Livestock
; found by the explorer is routed toward the Town Center by the native HD SN.
(defrule
    (goal g-scout-phase 1)
    (or (unit-type-count scout-cavalry-line >= 1) (unit-type-count eagle-warrior-line >= 1))
    (not (town-under-attack))
=>
    (set-strategic-number sn-livestock-to-town-center 1)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-minimum-explore-group-size 1)
    (set-strategic-number sn-maximum-explore-group-size 1)
    (set-strategic-number sn-percent-enemy-sighted-response 10)
    (set-strategic-number sn-enemy-sighted-response-distance 14)
)

; If the scout is gone, military reconnaissance replaces it.  No villagers are
; sacrificed as explorers.  Group size scales 2/3/4 from Moderate to Very Hard.
(defrule
    (goal g-scout-phase 1)
    (difficulty == hard)
    (unit-type-count scout-cavalry-line <= 0)
    (unit-type-count eagle-warrior-line <= 0)
    (military-population >= 3)
    (not (town-under-attack))
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-total-number-explorers 3)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-minimum-explore-group-size 3)
    (set-strategic-number sn-maximum-explore-group-size 3)
)
(defrule
    (goal g-scout-phase 1)
    (difficulty == moderate)
    (unit-type-count scout-cavalry-line <= 0)
    (unit-type-count eagle-warrior-line <= 0)
    (military-population >= 2)
    (not (town-under-attack))
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-total-number-explorers 2)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-minimum-explore-group-size 2)
    (set-strategic-number sn-maximum-explore-group-size 2)
)
(defrule
    (goal g-scout-phase 1)
    (unit-type-count scout-cavalry-line <= 0)
    (unit-type-count eagle-warrior-line <= 0)
    (town-under-attack)
=>
    (set-strategic-number sn-number-explore-groups 0)
)

; Dark-Age observation posts stay on the base perimeter.  Forward vision begins only
; after the local screen exists, avoiding isolated builders and remote posts.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 300)
    (civilian-population >= 12)
    (building-type-count-total fortress-outpost < 1)
    (wood-amount > 100)
    (up-pending-objects c: fortress-outpost < 1)
    (can-build fortress-outpost)
=>
    (build fortress-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 480)
    (civilian-population >= 16)
    (building-type-count-total fortress-outpost < 2)
    (wood-amount > 130)
    (up-pending-objects c: fortress-outpost < 1)
    (can-build fortress-outpost)
=>
    (build fortress-outpost)
)

; Compact open-map core: houses and support buildings are encouraged to sit close
; together inside the wall line rather than being sprayed over a 21-tile town.
(defrule
    (difficulty == hardest)
    (goal g-map-profile map-open)
    (current-age < castle-age)
=>
    (set-strategic-number sn-minimum-town-size 8)
    (set-strategic-number sn-maximum-town-size 16)
    (set-strategic-number sn-safe-town-size 14)
)
(defrule
    (difficulty == hardest)
    (goal g-map-profile map-open)
    (current-age == castle-age)
    (wall-completed-percentage 1 < 85)
=>
    (set-strategic-number sn-minimum-town-size 9)
    (set-strategic-number sn-maximum-town-size 19)
    (set-strategic-number sn-safe-town-size 16)
)
(defrule
    (difficulty == hardest)
    (goal g-map-profile map-open)
    (current-age == castle-age)
    (wall-completed-percentage 1 >= 85)
=>
    (set-strategic-number sn-minimum-town-size 9)
    (set-strategic-number sn-maximum-town-size 24)
    (set-strategic-number sn-safe-town-size 18)
)

; Feudal walls are a real project again, but the smaller town geometry and a
; three-builder crew keep their modified 10-wood-per-segment cost under control.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (wall-completed-percentage 1 < 55)
=>
    (set-strategic-number sn-percent-civilian-builders 16)
    (set-strategic-number sn-percent-civilian-gatherers 84)
    (set-strategic-number sn-cap-civilian-builders 5)
    (up-assign-builders c: palisade-wall c: 3)
)

; Hardest forestry must fan out.  A second camp is mandatory in Feudal and the
; Castle economy grows toward four separate wood dropsites rather than one blob.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (civilian-population >= 16)
    (building-type-count-total lumber-camp < 2)
    (wood-amount > 120)
    (up-pending-objects c: lumber-camp < 1)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (civilian-population >= 32)
    (building-type-count-total lumber-camp < 3)
    (wood-amount > 150)
    (up-pending-objects c: lumber-camp < 1)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (civilian-population >= 45)
    (building-type-count-total lumber-camp < 4)
    (wood-amount > 200)
    (up-pending-objects c: lumber-camp < 1)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
=>
    (set-strategic-number sn-maximum-wood-drop-distance 7)
    (set-strategic-number sn-wood-dropsite-distance 5)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
=>
    (set-strategic-number sn-maximum-wood-drop-distance 8)
    (set-strategic-number sn-wood-dropsite-distance 5)
)

; Early archer detection must happen before eight visible archers have already
; entered the base.  The Feudal emergency package is skirmisher-led, not spear-led.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (or (town-under-attack) (players-unit-type-count any-enemy archer-line >= 2))
    (building-type-count-total archery-range < 1)
    (wood-amount > 130)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (up-assign-builders c: archery-range c: 2)
    (build archery-range)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (or (goal g-threat-archer 1) (players-unit-type-count any-enemy archer-line >= 2))
    (unit-type-count-total skirmisher-line < 10)
    (military-population < 16)
    (food-amount > 100)
    (wood-amount > 120)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (or (goal g-threat-cavalry 1) (players-unit-type-count any-enemy scout-cavalry-line >= 3))
    (unit-type-count-total spearman-line < 6)
    (food-amount > 120)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (or (players-unit-type-count any-enemy militiaman-line >= 3)
        (or (players-unit-type-count any-enemy spearman-line >= 4)
            (players-unit-type-count any-enemy eagle-warrior-line >= 3)))
    (unit-type-count-total archer-line < 8)
    (military-population < 16)
    (wood-amount > 120)
    (gold-amount > 100)
    (can-train archer-line)
=>
    (train archer-line)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (town-under-attack)
    (players-unit-type-count any-enemy archer-line < 2)
    (players-unit-type-count any-enemy scout-cavalry-line < 3)
    (players-unit-type-count any-enemy militiaman-line < 3)
    (military-population < 4)
    (food-amount > 160)
    (gold-amount > 80)
    (can-train militiaman-line)
=>
    (train militiaman-line)
)

; One emergency combat tower is allowed to anchor a breached Feudal approach.
; Normal forward-tower expansion remains gated by the age reserve.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (town-under-attack)
    (building-type-count-total watch-tower-line < 1)
    (stone-amount > 250)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build-forward watch-tower-line)
)

; Grouped defense overlay: disabling percent-enemy-sighted-response stops every
; freshly trained soldier from individually charging the raider before the defend
; group has formed.
(defrule
    (goal g-war-state state-emergency)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 28)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 24)
    (set-strategic-number sn-group-form-distance 70)
)

; Keep the emergency posture alive for at least one safety window.  If fighting
; is still happening when the timer expires, start a new window instead of releasing
; the economy immediately.  This also prevents rapid garrison/return-to-work churn.
(defrule
    (goal g-emergency-defense 1)
    (town-under-attack)
    (timer-triggered t-safety-release)
=>
    (disable-timer t-safety-release)
    (enable-timer t-safety-release 45)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
)

; After emergency recovery, restore normal scouting response only when the dedicated
; scout phase is no longer protecting the scout.
(defrule
    (goal g-emergency-defense 0)
    (goal g-scout-phase 0)
    (not (town-under-attack))
=>
    (set-strategic-number sn-percent-enemy-sighted-response 90)
    (set-strategic-number sn-enemy-sighted-response-distance 35)
)

; Castle-age production depth.  A pressured one-TC position may build the first
; reinforcement set; a stable two-TC economy then scales to the Pop-150 target.
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (or (building-type-count-total town-center >= 2) (town-under-attack))
    (building-type-count-total barracks < 2)
    (wood-amount > 220)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (or (building-type-count-total town-center >= 2) (town-under-attack))
    (building-type-count-total archery-range < 2)
    (wood-amount > 240)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (or (building-type-count-total town-center >= 2) (town-under-attack))
    (building-type-count-total stable < 2)
    (wood-amount > 260)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (or (building-type-count-total town-center >= 2) (town-under-attack))
    (building-type-count-total siege-workshop < 1)
    (wood-amount > 300)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)

; Pop-150 Very Hard specifically receives the production depth missing in the replay.
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (civilian-population >= 44)
    (building-type-count-total town-center >= 2)
    (building-type-count-total barracks < 3)
    (wood-amount > 400)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (civilian-population >= 44)
    (building-type-count-total town-center >= 2)
    (building-type-count-total archery-range < 3)
    (wood-amount > 420)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (civilian-population >= 44)
    (building-type-count-total town-center >= 2)
    (building-type-count-total stable < 3)
    (wood-amount > 440)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (civilian-population >= 44)
    (building-type-count-total town-center >= 2)
    (building-type-count-total siege-workshop < 2)
    (wood-amount > 500)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)

; ============================================================================
; CLEAN RESIGN
; ============================================================================
(defrule
    (game-time > 600)
    (unit-type-count villager == 0)
    (building-type-count town-center == 0)
    (soldier-count < 1)
    (warboat-count <= 0)
=>
    (resign)
    (disable-self)
)

; ============================================================================
; V12 FIX02 - REPLAY-DRIVEN ECONOMY / FORTRESS / DEFENSE CORE
; Arabia 150-pop SR replay 2026-08-16: FIX01 clicked Feudal 10:11, Castle 24:09,
; made only one extra TC at 31:26, had no Horse Collar/Wheelbarrow, no cavalry,
; and issued 27 palisade wall commands but only 60 unique requested wall tiles.
; This overlay borrows the best safe HD patterns from ResonanceBot, official HD AI
; and Rehoboam while keeping Fortress identity and no resource cheats.
; ============================================================================
(defconst g-v12f2-init 103)
(defconst g-v12f2-boar 104)
(defconst g-v12f2-tc 105)
(defconst g-v12f2-defense 106)
(defconst g-v12f2-enclave 107)
(defconst sn-disable-villager-garrison 291)
(defconst research-pending 2)

(defrule
    (goal g-v12f2-init 0)
=>
    (set-goal g-v12f2-init 1)
    (set-goal g-v12f2-boar 0)
    (set-goal g-v12f2-tc 0)
    (set-goal g-v12f2-defense 0)
    (set-goal g-v12f2-enclave 0)
    (set-strategic-number sn-disable-villager-garrison 0)
)

; --- Resonance-inspired staged Dark economy, adapted for Fortress stone needs. ---
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population < 8)
=>
    (set-strategic-number sn-food-gatherer-percentage 90)
    (set-strategic-number sn-wood-gatherer-percentage 10)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population >= 8)
    (civilian-population < 14)
=>
    (set-strategic-number sn-food-gatherer-percentage 88)
    (set-strategic-number sn-wood-gatherer-percentage 12)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population >= 14)
    (civilian-population < 18)
=>
    (set-strategic-number sn-food-gatherer-percentage 75)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population >= 18)
=>
    (set-strategic-number sn-food-gatherer-percentage 55)
    (set-strategic-number sn-wood-gatherer-percentage 20)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (set-strategic-number sn-stone-gatherer-percentage 20)
)
(defrule
    (difficulty == moderate)
    (current-age == dark-age)
    (civilian-population >= 18)
=>
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

; Single authoritative official-HD-style boar kick-start.
; Sheep get the opening food window; one lure villager starts only after 7:00.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (goal g-v12f2-boar 0)
    (game-time > 420)
    (civilian-population >= 12)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 32)
=>
    (set-strategic-number sn-enable-boar-hunting 2)
    (set-strategic-number sn-minimum-boar-hunt-group-size 1)
    (set-strategic-number sn-minimum-number-hunters 1)
    (set-strategic-number sn-maximum-hunt-drop-distance 32)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 1)
    (set-goal g-v12f2-boar 1)
)
(defrule
    (current-age == dark-age)
    (goal g-v12f2-boar 1)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 16)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 2)
    (set-strategic-number sn-minimum-number-hunters 2)
    (up-request-hunters c: 1)
    (set-goal g-v12f2-boar 2)
)
(defrule
    (current-age == dark-age)
    (goal g-v12f2-boar 2)
    (dropsite-min-distance live-boar >= 0)
    (dropsite-min-distance live-boar <= 10)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 7)
    (set-strategic-number sn-minimum-number-hunters 7)
    (up-retask-gatherers food c: 1)
    (up-request-hunters c: 6)
    (set-goal g-v12f2-boar 3)
)
(defrule
    (current-age == dark-age)
    (goal g-v12f2-boar 3)
    (dropsite-min-distance boar-hunting <= 10)
    (dropsite-min-distance live-boar >= 11)
=>
    (set-strategic-number sn-minimum-boar-hunt-group-size 2)
    (set-strategic-number sn-minimum-number-hunters 2)
    (set-goal g-v12f2-boar 4)
)

; Feudal Fast-Castle bank: stronger food/gold protection, but eco upgrades may use escrow.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 1)
    (not (town-under-attack))
=>
    (set-escrow-percentage food 50)
    (set-escrow-percentage gold 70)
    (set-strategic-number sn-food-gatherer-percentage 48)
    (set-strategic-number sn-wood-gatherer-percentage 31)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 3)
)

; TC economy technology package. ResonanceBot's replay had Wheelbarrow, Horse Collar
; and Double-Bit Axe at 10:24; FIX01 had only Double-Bit Axe at 14:57.
(defrule
    (current-age == feudal-age)
    (can-research-with-escrow ri-horse-collar)
=>
    (release-escrow food)
    (release-escrow wood)
    (research ri-horse-collar)
)
(defrule
    (current-age == feudal-age)
    (research-completed ri-horse-collar)
    (can-research-with-escrow ri-double-bit-axe)
=>
    (release-escrow food)
    (release-escrow wood)
    (research ri-double-bit-axe)
)
(defrule
    (current-age == feudal-age)
    (civilian-population >= 23)
    (can-research-with-escrow ri-wheel-barrow)
=>
    (release-escrow food)
    (release-escrow wood)
    (research ri-wheel-barrow)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total town-center >= 2)
    (civilian-population >= 38)
    (can-research-with-escrow ri-hand-cart)
=>
    (release-escrow food)
    (release-escrow wood)
    (research ri-hand-cart)
)
(defrule
    (current-age >= castle-age)
    (research-completed ri-double-bit-axe)
    (wood-amount > 250)
    (can-research ri-bow-saw)
=>
    (research ri-bow-saw)
)
(defrule
    (current-age >= castle-age)
    (research-completed ri-horse-collar)
    (food-amount > 280)
    (can-research ri-heavy-plow)
=>
    (research ri-heavy-plow)
)

; Second TC is the first Castle-age economic commitment. Modified DAT cost is high,
; so temporarily bias wood until the foundation exists, then return stone to fortress duty.
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (building-type-count-total town-center < 2)
=>
    (set-goal g-v12f2-tc 1)
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 44)
    (set-strategic-number sn-gold-gatherer-percentage 12)
    (set-strategic-number sn-stone-gatherer-percentage 10)
    (set-escrow-percentage wood 65)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (goal g-v12f2-tc 1)
    (building-type-count-total town-center < 2)
    (up-pending-objects c: town-center < 1)
    (not(goal g-emergency-defense 1))
    (can-build-with-escrow town-center)
=>
    (release-escrow wood)
    (up-assign-builders c: town-center c: 5)
    (build town-center)
)
(defrule
    (goal g-v12f2-tc 1)
    (building-type-count-total town-center >= 2)
=>
    (release-escrow wood)
    (set-escrow-percentage wood 0)
    (set-goal g-v12f2-tc 2)
    (set-goal g-v12f2-enclave 1)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (building-type-count-total town-center >= 2)
    (building-type-count-total castle < 1)
    (goal g-castle-reserve 1)
=>
    (set-strategic-number sn-food-gatherer-percentage 32)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 30)
)

; Pop-150 boom: after TC2 is operating and the inner perimeter is useful, TC3 is allowed.
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (building-type-count-total town-center >= 2)
    (building-type-count-total town-center < 3)
    (civilian-population >= 46)
    (wood-amount > 780)
    (up-pending-objects c: town-center < 1)
    (not(goal g-emergency-defense 1))
    (can-build town-center)
=>
    (up-assign-builders c: town-center c: 5)
    (build town-center)
)

; A new TC/Castle creates a wider defended enclave; the outer stone ring uses this
; expanded town geometry rather than hugging the original TC.
(defrule
    (goal g-v12f2-enclave 1)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-minimum-town-size 9)
    (set-strategic-number sn-maximum-town-size 24)
    (set-strategic-number sn-safe-town-size 18)
)

; Cavalry doctrine. Franks and other cavalry civs get the Stable while Castle is
; researching, 1-3 Scouts as a reserve, then Light Cavalry and real Knights.
(defrule
    (difficulty == hardest)
    (goal g-doctrine-primary doc-cavalry)
    (current-age == feudal-age)
    (up-research-status c: castle-age >= research-pending)
    (building-type-count-total stable < 1)
    (wood-amount > 180)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age == feudal-age)
    (up-research-status c: castle-age >= research-pending)
    (unit-type-count-total scout-cavalry-line < 3)
    (food-amount > 140)
    (can-train scout-cavalry-line)
=>
    (train scout-cavalry-line)
)
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age >= castle-age)
    (unit-type-count-total scout-cavalry-line >= 1)
    (food-amount > 180)
    (can-research ri-light-cavalry)
=>
    (research ri-light-cavalry)
)
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age >= castle-age)
    (building-type-count-total stable < 1)
    (wood-amount > 180)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age >= castle-age)
    (building-type-count-total stable >= 1)
    (unit-type-count-total knight-line < 12)
    (military-population < 55)
    (food-amount > 300)
    (gold-amount > 220)
    (can-train knight-line)
=>
    (train knight-line)
)
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age >= castle-age)
    (building-type-count-total town-center >= 2)
    (building-type-count-total stable < 2)
    (wood-amount > 260)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age >= castle-age)
    (building-type-count-total town-center >= 2)
    (building-type-count-total stable < 3)
    (wood-amount > 480)
    (civilian-population >= 45)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)

; Cavalry blacksmith upgrades are doctrine priorities, not luxury purchases.
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age >= feudal-age)
    (food-amount > 180)
    (can-research ri-forging)
=>
    (research ri-forging)
)
(defrule
    (goal g-doctrine-primary doc-cavalry)
    (current-age >= feudal-age)
    (food-amount > 180)
    (can-research ri-scale-barding)
=>
    (research ri-scale-barding)
)

; Barracks line should be kept technologically current when it is being used.
(defrule
    (current-age >= feudal-age)
    (unit-type-count-total militiaman-line >= 1)
    (food-amount > 220)
    (gold-amount > 80)
    (can-research ri-man-at-arms)
=>
    (research ri-man-at-arms)
)
(defrule
    (current-age >= castle-age)
    (unit-type-count-total militiaman-line >= 1)
    (food-amount > 320)
    (gold-amount > 120)
    (can-research ri-long-swordsman)
=>
    (research ri-long-swordsman)
)
(defrule
    (current-age >= castle-age)
    (unit-type-count-total spearman-line >= 3)
    (food-amount > 260)
    (gold-amount > 100)
    (can-research ri-pikeman)
=>
    (research ri-pikeman)
)

; Resonance-like coherent grouping. Its replay used no explicit FORMATION action;
; the visual line came from grouping/patrol behavior, especially a much larger
; group-form distance and zero gather spacing.
(defrule
    (difficulty == hardest)
    (not (town-under-attack))
=>
    (set-strategic-number sn-group-form-distance 70)
    (set-strategic-number sn-attack-group-gather-spacing 0)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-group-leader-defense-distance 2)
    (set-strategic-number sn-defend-overlap-distance 5)
)

; Inside the base, units DEFEND instead of global-retreating.  Attack groups are
; disabled so they do not repeatedly cross/open gates while an enemy is nearby.
(defrule
    (difficulty == hardest)
    (town-under-attack)
=>
    (set-goal g-v12f2-defense 1)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 28)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 24)
    (set-strategic-number sn-defense-distance 20)
    (set-strategic-number sn-group-form-distance 70)
    (set-strategic-number sn-disable-villager-garrison 0)
)

; Do not release the civilian safety posture on a one-pass lull. The existing
; emergency timer now has a 45-second clean-safety window before normal work resumes.
(defrule
    (goal g-emergency-defense 1)
=>
    (set-strategic-number sn-allow-civilian-defense 0)
    (set-strategic-number sn-number-civilian-militia 0)
    (set-strategic-number sn-disable-villager-garrison 0)
)

; Once safe, clear only the FIX02 latch. Existing war-state/recovery rules decide
; whether the army resumes mobilization or recovery.
(defrule
    (goal g-v12f2-defense 1)
    (goal g-emergency-defense 0)
    (not (town-under-attack))
=>
    (set-goal g-v12f2-defense 0)
)

