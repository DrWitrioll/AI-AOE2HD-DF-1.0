; ============================================================================
; V11 HUMAN-ALLY COMMAND INTERFACE
; Standard/proven taunt detection; no command is accepted from enemies.
; 31 attack, 36 hold, 45 retreat, 43 status.
; Custom: 200 prepare siege, 201 fortify, 202 resume autonomous strategy.
; ============================================================================
(defrule
    (taunt-detected any-ally 36)
=>
    (acknowledge-taunt this-any-ally 36)
    (set-goal g-command-hold 1)
    (set-goal g-command-force 0)
    (set-goal g-command-siege 0)
    (set-goal g-war-state state-fortify)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (up-retreat-now)
    (chat-to-allies "Holding position. Offensive operations suspended.")
)
(defrule
    (goal g-command-hold 1)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
)
(defrule
    (taunt-detected any-ally 202)
=>
    (acknowledge-taunt this-any-ally 202)
    (set-goal g-command-hold 0)
    (set-goal g-command-force 0)
    (set-goal g-command-siege 0)
    (chat-to-allies "Autonomous Fortress doctrine resumed.")
)
(defrule
    (taunt-detected any-ally 201)
    (current-age < castle-age)
=>
    (acknowledge-taunt this-any-ally 201)
    (chat-to-allies "Full fortress doctrine becomes available in Castle Age.")
)
(defrule
    (taunt-detected any-ally 201)
    (current-age >= castle-age)
=>
    (acknowledge-taunt this-any-ally 201)
    (set-goal g-command-hold 1)
    (set-goal g-war-state state-fortify)
    (set-strategic-number sn-number-attack-groups 0)
    (up-retreat-now)
    (chat-to-allies "Fortification order received.")
)
(defrule
    (taunt-detected any-ally 200)
    (current-age >= castle-age)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
=>
    (acknowledge-taunt this-any-ally 200)
    (set-goal g-command-hold 0)
    (set-goal g-command-siege 1)
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
    (chat-to-allies "Siege preparation ordered.")
)
(defrule
    (taunt-detected any-ally 200)
    (current-age < castle-age)
=>
    (acknowledge-taunt this-any-ally 200)
    (chat-to-allies "Cannot prepare siege before Castle Age.")
)
(defrule
    (taunt-detected any-ally 45)
    (current-age < castle-age)
=>
    (acknowledge-taunt this-any-ally 45)
    (up-retreat-now)
    (chat-to-allies "Retreating early forces toward the base.")
)
(defrule
    (taunt-detected any-ally 45)
    (current-age >= castle-age)
=>
    (acknowledge-taunt this-any-ally 45)
    (set-goal g-command-hold 0)
    (set-goal g-command-retreat 1)
    (set-goal g-recovery 1)
    (set-goal g-war-state state-recovery)
    (up-retreat-now)
    (chat-to-allies "Retreating. Rebuilding combat strength.")
)
(defrule
    (goal g-command-retreat 1)
    (not(goal g-war-state state-recovery))
=>
    (set-goal g-command-retreat 0)
)


(defrule
    (taunt-detected any-ally 31)
    (or (goal g-recovery 1) (goal g-emergency-defense 1))
=>
    (acknowledge-taunt this-any-ally 31)
    (chat-to-allies "Cannot attack yet. Army or base is still recovering.")
)
(defrule
    (taunt-detected any-ally 31)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (goal g-fortress-threat 1)
    (current-age >= castle-age)
    (military-population < 18)
=>
    (acknowledge-taunt this-any-ally 31)
    (set-goal g-command-hold 0)
    (set-goal g-command-force 1)
    (set-goal g-war-state state-mobilize)
    (chat-to-allies "Attack order received. Army too small; mobilizing first.")
)
(defrule
    (taunt-detected any-ally 31)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (goal g-fortress-threat 1)
    (current-age >= castle-age)
    (military-population >= 18)
=>
    (acknowledge-taunt this-any-ally 31)
    (set-goal g-command-hold 0)
    (set-goal g-command-force 1)
    (set-goal g-war-state state-siege)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 480)
    (chat-to-allies "Attack order received. Preparing the siege force.")
)
(defrule
    (taunt-detected any-ally 31)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (goal g-fortress-threat 0)
    (current-age >= castle-age)
    (military-population >= 18)
=>
    (acknowledge-taunt this-any-ally 31)
    (set-goal g-command-hold 0)
    (set-goal g-command-force 1)
    (set-goal g-war-state state-assault)
    (set-goal g-assault-window 1)
    (chat-to-allies "Attack order received. Moving to assault.")
)
(defrule
    (taunt-detected any-ally 31)
    (goal g-recovery 0)
    (goal g-emergency-defense 0)
    (goal g-fortress-threat 0)
    (current-age >= castle-age)
    (military-population < 18)
=>
    (acknowledge-taunt this-any-ally 31)
    (set-goal g-command-hold 0)
    (set-goal g-command-force 1)
    (set-goal g-war-state state-mobilize)
    (chat-to-allies "Attack order received. Army too small; mobilizing first.")
)

(defrule
    (taunt-detected any-ally 43)
    (goal g-war-state state-develop)
=>
    (acknowledge-taunt this-any-ally 43)
    (chat-to-allies "Status: developing economy and scouting.")
)


(defrule
    (taunt-detected any-ally 43)
    (goal g-war-state state-fortify)
=>
    (acknowledge-taunt this-any-ally 43)
    (chat-to-allies "Status: fortifying the base.")
)


(defrule
    (taunt-detected any-ally 43)
    (goal g-war-state state-mobilize)
=>
    (acknowledge-taunt this-any-ally 43)
    (chat-to-allies "Status: mobilizing the field army.")
)


(defrule
    (taunt-detected any-ally 43)
    (goal g-war-state state-siege)
=>
    (acknowledge-taunt this-any-ally 43)
    (chat-to-allies "Status: preparing siege.")
)


(defrule
    (taunt-detected any-ally 43)
    (goal g-war-state state-assault)
=>
    (acknowledge-taunt this-any-ally 43)
    (chat-to-allies "Status: assault in progress.")
)


(defrule
    (taunt-detected any-ally 43)
    (goal g-war-state state-recovery)
=>
    (acknowledge-taunt this-any-ally 43)
    (chat-to-allies "Status: army depleted; rebuilding.")
)


(defrule
    (taunt-detected any-ally 43)
    (goal g-war-state state-emergency)
=>
    (acknowledge-taunt this-any-ally 43)
    (chat-to-allies "Status: emergency base defense.")
)


(defrule
    (taunt-detected any-ally 3)
    (current-age >= castle-age)
    (food-amount > 1800)
=>
    (acknowledge-taunt this-any-ally 3)
    (tribute-to-player this-any-ally food 300)
    (chat-to-allies "Sending food.")
)


(defrule
    (taunt-detected any-ally 3)
    (current-age >= castle-age)
    (food-amount <= 1800)
=>
    (acknowledge-taunt this-any-ally 3)
