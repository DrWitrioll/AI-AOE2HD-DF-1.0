    (goal g-war-state state-siege)
    (goal g-fortress-threat 1)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (current-age == imperial-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 64)
    (unit-type-count-total battering-ram-line >= 6)
    (unit-type-count-total trebuchet >= 2)
=>
    (set-goal g-war-state state-assault)
