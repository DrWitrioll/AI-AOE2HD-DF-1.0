; ============================================================================
; V11 IMPORTANT TEAM STATUS MESSAGES
; ============================================================================
(defrule
    (goal g-team-human 1)
    (town-under-attack)
    (goal g-battle-balance balance-critical)
    (goal g-chat-distress 0)
=>
    (chat-to-allies "My fortress is under heavy attack. Assistance requested.")
    (set-goal g-chat-distress 1)
)
(defrule
    (not (town-under-attack))
    (goal g-chat-distress 1)
=>
    (set-goal g-chat-distress 0)
)
(defrule
    (goal g-team-human 1)
    (goal g-gold-exhausted 1)
    (goal g-chat-gold-crisis 0)
=>
    (chat-to-allies "Gold deposits exhausted. Switching to trade and reserve forces.")
    (set-goal g-chat-gold-crisis 1)
)
(defrule
    (goal g-gold-exhausted 0)
    (goal g-chat-gold-crisis 1)
=>
    (set-goal g-chat-gold-crisis 0)
)


; Early resource requests are acknowledged but protected until Castle Age.
(defrule
    (current-age < castle-age)
    (taunt-detected any-ally 3)
=>
    (acknowledge-taunt this-any-ally 3)
    (chat-to-allies "Cannot spare food before Castle Age.")
)
(defrule
    (current-age < castle-age)
    (taunt-detected any-ally 4)
=>
    (acknowledge-taunt this-any-ally 4)
    (chat-to-allies "Cannot spare wood before Castle Age.")
)
