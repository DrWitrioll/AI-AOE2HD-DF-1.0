    (goal g-threat-cavalry 1)
    (or (not(difficulty == hardest)) (current-age >= castle-age))
    (goal g-maxpop-ge151 1)
    (military-population < 100)
    (unit-type-count-total spearman-line < 26)
    (food-amount > 500)
    (can-train spearman-line)
=>
    (train spearman-line)
