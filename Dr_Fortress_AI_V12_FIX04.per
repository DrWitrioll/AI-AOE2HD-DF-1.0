(defrule
    (taunt-detected any-ally 5)
    (current-age >= castle-age)
    (gold-amount <= 1600)
=>
    (acknowledge-taunt this-any-ally 5)
    (chat-to-allies "Cannot spare gold right now.")
)


(defrule
    (taunt-detected any-ally 6)
    (current-age >= castle-age)
    (goal g-castle-reserve 0)
    (stone-amount > 2000)
=>
    (acknowledge-taunt this-any-ally 6)
    (tribute-to-player this-any-ally stone 200)
    (chat-to-allies "Sending stone.")
)
(defrule
    (taunt-detected any-ally 6)
    (current-age >= castle-age)
    (or (goal g-castle-reserve 1) (stone-amount < 2001))
=>
    (acknowledge-taunt this-any-ally 6)
    (chat-to-allies "Cannot spare stone; fortress reserve is protected.")
)


(defrule
    (taunt-detected any-ally 12)
    (military-population >= 20)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
=>
    (acknowledge-taunt this-any-ally 12)
    (set-goal g-team-support 1)
    (set-strategic-number sn-target-evaluation-ally-proximity 300)
    (set-strategic-number sn-coop-share-attacking 1)
    (disable-timer t-team-support)
    (enable-timer t-team-support 180)
    (chat-to-allies "Support order received. I will pressure enemies near allied forces.")
)
(defrule
    (taunt-detected any-ally 12)
    (or (military-population < 20) (or (goal g-emergency-defense 1) (goal g-recovery 1)))
=>
    (acknowledge-taunt this-any-ally 12)
    (chat-to-allies "Unable to support now. My army is committed to defense or recovery.")
)
(defrule
    (timer-triggered t-team-support)
=>
    (disable-timer t-team-support)
    (set-goal g-team-support 0)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)


(defrule
    (taunt-detected any-ally 61)
    (player-in-game 1)
