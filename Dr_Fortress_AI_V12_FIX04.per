; V12 FIX04 Resonance-style civilian role initialization.
; Do this before the normal exploration/economy setup so no stale house-builder
; assignment can survive from the new-building system.
(defrule
    (true)
=>
    (up-assign-builders c: house c: 2)
    (set-strategic-number sn-percent-civilian-builders 40)
    (set-strategic-number sn-cap-civilian-builders 4)
    (set-strategic-number sn-percent-civilian-gatherers 60)
    (set-strategic-number sn-cap-civilian-gatherers 100)
    (disable-self)
)

; After the opening house, one builder is enough for ordinary housing.
(defrule
    (game-time > 30)
=>
    (up-assign-builders c: house c: 1)
    (disable-self)
