; ============================================================================
; V11 MAP DOCTRINES
; ============================================================================
(defrule
    (or (map-type black-forest) (or (map-type arena) (map-type fortress)))
=>
    (set-goal g-map-profile map-closed)
)
(defrule
    (or (map-type islands) (or (map-type team-islands) (map-type archipelago)))
=>
    (set-goal g-map-profile map-islands)
)
(defrule
    (or (map-type coastal) (or (map-type baltic) (or (map-type mediterranean) (or (map-type rivers) (map-type continental)))))
=>
    (set-goal g-map-profile map-mixed)
)
(defrule
    (goal g-map-profile map-closed)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-minimum-town-size 3)
    (set-strategic-number sn-maximum-town-size 9)
    (set-strategic-number sn-safe-town-size 9)
    (set-strategic-number sn-defense-distance 12)
    (set-strategic-number sn-group-form-distance 18)
)
(defrule
    (goal g-map-profile map-open)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-minimum-town-size 6)
    (set-strategic-number sn-maximum-town-size 24)
    (set-strategic-number sn-safe-town-size 16)
    (set-strategic-number sn-defense-distance 18)
)
(defrule
    (goal g-map-profile map-islands)
=>
    (set-strategic-number sn-garrison-rams 0)
    (set-strategic-number sn-group-form-distance 30)
    (set-strategic-number sn-number-boat-explore-groups 1)
)
(defrule
    (goal g-map-profile map-mixed)
    (current-age >= feudal-age)
=>
    (set-strategic-number sn-number-boat-explore-groups 1)
    (set-strategic-number sn-dock-defend-priority 1)
)


; ============================================================================
; V11 RESOURCE EXHAUSTION / TRADE EMERGENCY
; ============================================================================
(defrule
    (current-age == imperial-age)
    (or (dropsite-min-distance gold == -1) (dropsite-min-distance gold == 480))
    (goal g-gold-exhausted 0)
=>
    (set-goal g-gold-exhausted 1)
    (set-goal g-trade-emergency 1)
)
(defrule
    (dropsite-min-distance gold >= 0)
    (dropsite-min-distance gold < 480)
    (goal g-gold-exhausted 1)
=>
    (set-goal g-gold-exhausted 0)
)
(defrule
    (current-age == imperial-age)
    (or (dropsite-min-distance stone == -1) (dropsite-min-distance stone == 480))
    (goal g-stone-exhausted 0)
=>
    (set-goal g-stone-exhausted 1)
)
(defrule
    (dropsite-min-distance stone >= 0)
    (dropsite-min-distance stone < 480)
    (goal g-stone-exhausted 1)
=>
    (set-goal g-stone-exhausted 0)
)
(defrule
    (goal g-gold-exhausted 1)
    (goal g-stone-exhausted 0)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 25)
)
(defrule
    (goal g-gold-exhausted 1)
    (goal g-stone-exhausted 1)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 50)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (goal g-gold-exhausted 0)
    (goal g-stone-exhausted 1)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 25)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
    (goal g-gold-exhausted 1)
    (food-amount > 3500)
    (gold-amount < 700)
    (can-sell-commodity food)
=>
    (sell-commodity food)
)
(defrule
    (goal g-gold-exhausted 1)
    (wood-amount > 3500)
    (gold-amount < 700)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
)
(defrule
    (goal g-stone-exhausted 1)
    (or (goal g-fortress-rebuild 1) (or (goal g-fortress-rebuild 2) (goal g-fortress-rebuild 3)))
    (gold-amount > 2200)
    (stone-amount < 1250)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)


(defrule
    (current-age == imperial-age)
    (goal g-trade-emergency 1)
