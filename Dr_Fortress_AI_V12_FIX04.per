)

; ==========================================================================
; V9 FORTRESS MASTER - DOCTRINE-SCALED PRODUCTION INFRASTRUCTURE
; ==========================================================================
(defrule
    (current-age >= castle-age)
    (goal g-maxpop-le125 1)
        (goal g-doctrine-primary doc-archer)
    (building-type-count-total archery-range < 3)
    (wood-amount > 900)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= castle-age)
    (goal g-maxpop-le125 1)
        (goal g-doctrine-primary doc-cavalry)
    (building-type-count-total stable < 3)
