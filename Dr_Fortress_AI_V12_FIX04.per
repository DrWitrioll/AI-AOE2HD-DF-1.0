; FIXED7 Hardest fast-development infrastructure. `can-build` remains the DAT-safe
; legality/affordability guard; these rules only stop unnecessary wood hoarding.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population >= 14)
    (building-type-count-total barracks < 1)
    (wood-amount > 120)
    (up-pending-objects c: barracks < 1)
    (not (town-under-attack))
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (building-type-count-total market < 1)
    (wood-amount > 160)
    (up-pending-objects c: market < 1)
    (not (town-under-attack))
    (can-build market)
=>
