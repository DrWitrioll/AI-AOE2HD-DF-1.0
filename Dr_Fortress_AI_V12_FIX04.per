    (wood-amount > 1100)
    (gold-amount > 1000)
    (can-train cavalry-archer-line)
=>
    (train cavalry-archer-line)
)
(defrule
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (military-population >= 60)
    (unit-type-count-total knight-line < 24)
    (food-amount > 1500)
    (gold-amount > 1300)
    (can-train knight-line)
=>
    (train knight-line)
)
(defrule
    (current-age == imperial-age)
