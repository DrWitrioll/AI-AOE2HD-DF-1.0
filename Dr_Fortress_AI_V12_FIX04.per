; Fortress-threat memory. Non-cheating player facts only remember structures
; that have actually been seen. Once a serious fortress has been identified,
; keep a deeper siege package for the rest of the match.
(defrule
    (goal g-fortress-threat 0)
    (players-building-type-count any-enemy castle > 0)
=>
    (set-goal g-fortress-threat 1)
)

; Walls and tower lines are visible-information facts rather than CC facts.
; Recognizing them early lets the AI prepare siege before the army physically
; reaches a fortified perimeter.
(defrule
    (goal g-fortress-threat 0)
    (current-age >= castle-age)
    (players-building-type-count any-enemy stone-wall-line >= 8)
=>
    (set-goal g-fortress-threat 1)
)

(defrule
    (goal g-fortress-threat 0)
    (current-age >= castle-age)
    (players-building-type-count any-enemy watch-tower-line >= 3)
=>
    (set-goal g-fortress-threat 1)
)

(defrule
    (goal g-fortress-threat 0)
    (current-age == imperial-age)
    (players-building-count any-enemy > 45)
=>
    (set-goal g-fortress-threat 1)
)

; --------------------------------------------------------------------------
; V10 TEAM STATUS: explicit fortress detection.
; Only human allies receive messages.  This intentionally ignores the generic
; >20-building heuristic so the chat line is not a false-positive "fortress".
; player-in-game + chat-to-allies are used by the official HD AI.
; --------------------------------------------------------------------------
(defrule
    (goal g-chat-fortress 0)
    (player-in-game any-human-ally)
    (or
        (players-building-type-count any-enemy castle > 0)
        (or
            (players-building-type-count any-enemy stone-wall-line >= 8)
            (players-building-type-count any-enemy watch-tower-line >= 3)
        )
    )
=>
    (chat-to-allies "Enemy fortress detected.")
    (set-goal g-chat-fortress 1)
)

; A known fortress is attacked as one concentrated army. This is deliberately
; different from ordinary pressure. A compact group-leader defense distance
; keeps escorts from wandering too far away from the siege core.
(defrule
    (goal g-fortress-threat 1)
    (goal g-recovery 0)
=>
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-group-form-distance 24)
    (set-strategic-number sn-attack-group-gather-spacing 2)
    (set-strategic-number sn-group-leader-defense-distance 3)
)

; ResonanceBot demonstrates commander method 2 on HD: select the longest-range
; group member. During a known Imperial fortress assault this tends to keep the
; army centered on trebuchets / long-range artillery instead of allowing a
; fast melee commander to drag the formation away from its siege core.
(defrule
    (goal g-fortress-threat 1)
    (goal g-recovery 0)
    (current-age == imperial-age)
=>
    (set-strategic-number sn-group-commander-selection-method 2)
)

(defrule
    (goal g-fortress-threat 0)
=>
    (set-strategic-number sn-group-commander-selection-method 0)
)


