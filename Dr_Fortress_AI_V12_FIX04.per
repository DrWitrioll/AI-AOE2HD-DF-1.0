    (set-strategic-number sn-wood-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 20)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)

(defrule
    (goal g-water 0)
    (goal g-war-state state-emergency)
=>
    (set-strategic-number sn-food-gatherer-percentage 45)
    (set-strategic-number sn-wood-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)

; Gold crisis uses hysteresis so the economy does not flicker every rule pass.
(defrule
    (goal g-gold-crisis 0)
    (current-age == imperial-age)
    (goal g-army-established 1)
    (gold-amount < 300)
=>
    (set-goal g-gold-crisis 1)
)
(defrule
    (goal g-gold-crisis 1)
    (gold-amount > 900)
=>
    (set-goal g-gold-crisis 0)
)
(defrule
    (goal g-water 0)
    (goal g-gold-crisis 1)
=>
    (set-strategic-number sn-food-gatherer-percentage 31)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 34)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)
(defrule
    (goal g-water 1)
    (goal g-gold-crisis 1)
=>
    (set-strategic-number sn-food-gatherer-percentage 26)
    (set-strategic-number sn-wood-gatherer-percentage 34)
    (set-strategic-number sn-gold-gatherer-percentage 32)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)


; ==========================================================================
; V9 PRODUCTION TIER / BUILDER CONTROL
; ==========================================================================
(defrule
    (goal g-maxpop-le125 1)
=>
    (set-goal g-production-tier 2)
)
(defrule
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
=>
    (set-goal g-production-tier 3)
)
(defrule
    (goal g-maxpop-ge151 1)
=>
    (set-goal g-production-tier 4)
)

(defrule
    (goal g-war-state state-develop)
    (current-age >= feudal-age)
=>
    (set-strategic-number sn-percent-civilian-builders 18)
    (set-strategic-number sn-percent-civilian-gatherers 82)
    (set-strategic-number sn-cap-civilian-builders 7)
)
(defrule
    (goal g-war-state state-fortify)
    (current-age >= feudal-age)
=>
    (set-strategic-number sn-percent-civilian-builders 32)
    (set-strategic-number sn-percent-civilian-gatherers 68)
    (set-strategic-number sn-cap-civilian-builders 16)
    (up-assign-builders c: palisade-wall c: 4)
    (up-assign-builders c: stone-wall-line c: 5)
    (up-assign-builders c: castle c: 6)
    (up-assign-builders c: town-center c: 5)
)
(defrule
    (goal g-war-state state-mobilize)
    (current-age >= feudal-age)
=>
    (set-strategic-number sn-percent-civilian-builders 18)
    (set-strategic-number sn-percent-civilian-gatherers 82)
    (set-strategic-number sn-cap-civilian-builders 10)
)
(defrule
    (goal g-war-state state-siege)
    (current-age >= feudal-age)
=>
    (set-strategic-number sn-percent-civilian-builders 14)
    (set-strategic-number sn-percent-civilian-gatherers 86)
    (set-strategic-number sn-cap-civilian-builders 8)
)
(defrule
    (goal g-war-state state-recovery)
    (current-age >= feudal-age)
=>
    (set-strategic-number sn-percent-civilian-builders 16)
    (set-strategic-number sn-percent-civilian-gatherers 84)
    (set-strategic-number sn-cap-civilian-builders 10)
)
(defrule
    (goal g-war-state state-emergency)
=>
    (set-strategic-number sn-percent-civilian-builders 8)
    (set-strategic-number sn-percent-civilian-gatherers 92)
    (set-strategic-number sn-cap-civilian-builders 2)
)

; FIXED6 early wall crews. Feudal palisades are a real project, not a one-villager side job.
(defrule
    (not(difficulty == hardest))
    (current-age == feudal-age)
    (not(wall-completed-percentage 1 >= 90))
=>
    (set-strategic-number sn-percent-civilian-builders 24)
    (set-strategic-number sn-percent-civilian-gatherers 76)
    (set-strategic-number sn-cap-civilian-builders 8)
    (up-assign-builders c: palisade-wall c: 4)
)
(defrule
    (not(difficulty == hardest))
    (current-age == dark-age)
    (game-time > 300)
    (not(wall-completed-percentage 1 >= 80))
=>
    (set-strategic-number sn-percent-civilian-builders 20)
    (set-strategic-number sn-percent-civilian-gatherers 80)
    (set-strategic-number sn-cap-civilian-builders 6)
    (up-assign-builders c: palisade-wall c: 3)
)

; V12 FIX04: keep a valid builder/gatherer partition in Dark Age.
; A house plan must never coexist with a zero builder cap. ResonanceBot's stable
; opening proves that a small builder pool plus normal gatherers avoids the task loop.
(defrule
    (difficulty == hardest)
    (goal g-war-state state-develop)
    (current-age == dark-age)
=>
    (set-strategic-number sn-percent-civilian-builders 40)
    (set-strategic-number sn-percent-civilian-gatherers 60)
    (set-strategic-number sn-cap-civilian-builders 4)
)
(defrule
    (difficulty == hardest)
    (goal g-war-state state-develop)
    (current-age == feudal-age)
    (wall-completed-percentage 1 >= 90)
=>
    (set-strategic-number sn-percent-civilian-builders 18)
    (set-strategic-number sn-percent-civilian-gatherers 82)
    (set-strategic-number sn-cap-civilian-builders 7)
)

; Compact but deeper towns at high population.
(defrule
    (current-age == castle-age)
    (goal g-maxpop-le125 1)
=>
    (set-strategic-number sn-maximum-town-size 22)
    (set-strategic-number sn-safe-town-size 14)
)
(defrule
    (current-age == imperial-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
=>
    (set-strategic-number sn-maximum-town-size 24)
    (set-strategic-number sn-safe-town-size 16)
)
(defrule
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
=>
    (set-strategic-number sn-maximum-town-size 26)
    (set-strategic-number sn-safe-town-size 17)
)


