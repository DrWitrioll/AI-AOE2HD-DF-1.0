    (set-strategic-number sn-gold-gatherer-percentage 23)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-mobilize)
    (goal g-gold-crisis 0)
    (goal g-doctrine-primary doc-siege)
=>
    (set-strategic-number sn-food-gatherer-percentage 31)
    (set-strategic-number sn-wood-gatherer-percentage 37)
    (set-strategic-number sn-gold-gatherer-percentage 27)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-mobilize)
    (goal g-gold-crisis 0)
    (goal g-doctrine-primary doc-defensive)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 19)
    (set-strategic-number sn-stone-gatherer-percentage 22)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-mobilize)
    (goal g-gold-crisis 0)
    (goal g-doctrine-primary doc-gunpowder)
=>
    (set-strategic-number sn-food-gatherer-percentage 36)
    (set-strategic-number sn-wood-gatherer-percentage 24)
    (set-strategic-number sn-gold-gatherer-percentage 35)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-mobilize)
    (goal g-gold-crisis 0)
    (goal g-doctrine-primary doc-monk)
=>
    (set-strategic-number sn-food-gatherer-percentage 37)
    (set-strategic-number sn-wood-gatherer-percentage 22)
    (set-strategic-number sn-gold-gatherer-percentage 36)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)
(defrule
    (goal g-water 0)
    (goal g-war-state state-mobilize)
    (goal g-gold-crisis 0)
    (goal g-doctrine-primary doc-camel)
=>
    (set-strategic-number sn-food-gatherer-percentage 44)
    (set-strategic-number sn-wood-gatherer-percentage 20)
    (set-strategic-number sn-gold-gatherer-percentage 31)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)

; Siege doctrine pushes even harder into wood/gold while the artillery package is assembling.
(defrule
    (goal g-water 0)
    (goal g-war-state state-siege)
    (goal g-gold-crisis 0)
    (or (goal g-doctrine-primary doc-siege) (goal g-doctrine-secondary doc-siege))
=>
    (set-strategic-number sn-food-gatherer-percentage 27)
    (set-strategic-number sn-wood-gatherer-percentage 42)
    (set-strategic-number sn-gold-gatherer-percentage 27)
    (set-strategic-number sn-stone-gatherer-percentage 4)
)

; -----------------------------
; Housing
; IMPORTANT: housing-headroom = free slots in currently built housing.
; population-headroom = remaining room before the game's population limit.
; -----------------------------
(defrule
    (population <= 70)
    (housing-headroom < 5)
    (population-headroom > 0)
    (up-pending-objects c: house < 1)
    (can-build house)
=>
    (build house)
)

; At higher population, start houses earlier so military production does not stall.
(defrule
    (population > 70)
    (housing-headroom < 10)
    (population-headroom > 0)
    (up-pending-objects c: house < 2)
    (can-build house)
=>
    (build house)
)

; V9 high-pop queue buffer. Large 150/200-pop economies can train from many
; buildings simultaneously, so begin extra houses before the 10-slot reserve is gone.
(defrule
    (population > 120)
    (housing-headroom < 15)
    (population-headroom > 0)
    (up-pending-objects c: house < 3)
    (can-build house)
=>
    (build house)
)

(defrule
    (population > 165)
    (housing-headroom < 20)
    (population-headroom > 0)
    (up-pending-objects c: house < 4)
    (can-build house)
=>
    (build house)
)

; -----------------------------
; Basic dropsites and economy buildings
; -----------------------------
; Emergency recovery: losing the only Town Center before Castle Age must not
; permanently kill the economy. The modified Town Center costs 650 wood.
(defrule
    (building-type-count-total town-center < 1)
    (wood-amount > 750)
    (can-build town-center)
=>
    (build town-center)
)

(defrule
    (current-age == dark-age)
    (game-time > 60)
    (civilian-population >= 5)
    (building-type-count-total lumber-camp < 1)
    (can-build lumber-camp)
=>
    (up-assign-builders c: lumber-camp c: 2)
    (build lumber-camp)
)
(defrule
    (current-age >= feudal-age)
    (building-type-count-total lumber-camp < 1)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

(defrule
    (current-age == dark-age)
    (game-time > 240)
    (civilian-population >= 10)
    (building-type-count-total mill < 1)
    (wood-amount > 95)
    (can-build mill)
=>
    (up-assign-builders c: mill c: 2)
    (build mill)
)
(defrule
    (current-age >= feudal-age)
    (building-type-count-total mill < 1)
    (can-build mill)
=>
    (build mill)
)

; FIXED7: Fortress economy starts stone in Dark Age. The wall planner can then
; place the palisade outside the real stone economy instead of cutting the miners off.
(defrule
    (current-age == dark-age)
    (civilian-population >= 12)
    (resource-found stone)
    (building-type-count-total mining-camp < 1)
    (wood-amount > 110)
    (up-pending-objects c: mining-camp < 1)
    (can-build mining-camp)
=>
    (up-assign-builders c: mining-camp c: 2)
    (build mining-camp)
)

(defrule
    (current-age == feudal-age)
    (building-type-count-total mining-camp < 1)
    (can-build mining-camp)
=>
    (build mining-camp)
)

(defrule
    (current-age == castle-age)
    (building-type-count-total mining-camp < 2)
    (wood-amount > 250)
    (can-build mining-camp)
=>
    (build mining-camp)
)

(defrule
    (current-age == imperial-age)
    (building-type-count-total mining-camp < 3)
    (wood-amount > 500)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; Renew dropsites when walking distances become inefficient. This uses the
; original engine fact specifically intended for deciding when to add a new
; resource dropsite.
(defrule
    (current-age == feudal-age)
    (dropsite-min-distance wood > 5)
    (building-type-count-total lumber-camp < 2)
    (wood-amount > 300)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (current-age == castle-age)
    (dropsite-min-distance wood > 5)
    (building-type-count-total lumber-camp < 3)
    (wood-amount > 450)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (current-age == imperial-age)
    (dropsite-min-distance wood > 5)
    (building-type-count-total lumber-camp < 4)
    (wood-amount > 650)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (current-age == castle-age)
    (dropsite-min-distance gold > 6)
    (building-type-count-total mining-camp < 4)
    (wood-amount > 450)
    (can-build mining-camp)
=>
    (build mining-camp)
)
(defrule
    (current-age == castle-age)
    (dropsite-min-distance stone > 6)
    (building-type-count-total mining-camp < 4)
    (wood-amount > 450)
    (can-build mining-camp)
=>
    (build mining-camp)
)
(defrule
    (current-age == imperial-age)
    (dropsite-min-distance gold > 6)
    (building-type-count-total mining-camp < 6)
    (wood-amount > 650)
    (can-build mining-camp)
=>
    (build mining-camp)
)
(defrule
    (current-age == imperial-age)
    (dropsite-min-distance stone > 6)
    (building-type-count-total mining-camp < 6)
    (wood-amount > 650)
    (can-build mining-camp)
=>
    (build mining-camp)
)


; FIXED5 replay repair: gold and stone should not share a distant camp just
; because one generic Mining Camp already exists.
(defrule
    (current-age >= feudal-age)
    (dropsite-min-distance gold > 6)
    (building-type-count-total mining-camp < 3)
    (or (goal g-fastcastle-reserve 0) (building-type-count-total mining-camp < 2))
    (wood-amount > 220)
    (up-pending-objects c: mining-camp < 1)
    (can-build mining-camp)
=>
    (build mining-camp)
)
(defrule
    (current-age >= feudal-age)
    (dropsite-min-distance stone > 6)
    (building-type-count-total mining-camp < 3)
    (or (goal g-fastcastle-reserve 0) (building-type-count-total mining-camp < 2))
    (wood-amount > 220)
    (up-pending-objects c: mining-camp < 1)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; FIXED7 one-shot early wood task refresh. HD can occasionally leave the first
; lumber worker in an obsolete task after the initial camp is completed.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 90)
    (building-type-count-total lumber-camp >= 1)
=>
    (up-retask-gatherers wood c: 1)
    (disable-self)
)

; FIXED7 tighter early dropsites. Adjacent dropsites are legal in HD, so a gold
; camp should not force stone miners to walk across half the base (or vice versa).
(defrule
    (current-age == feudal-age)
    (dropsite-min-distance stone > 4)
    (building-type-count-total mining-camp < 4)
    (or (goal g-fastcastle-reserve 0) (building-type-count-total mining-camp < 2))
    (wood-amount > 160)
    (up-pending-objects c: mining-camp < 1)
    (not (town-under-attack))
    (can-build mining-camp)
=>
    (build mining-camp)
)
(defrule
    (current-age == feudal-age)
    (dropsite-min-distance gold > 4)
    (building-type-count-total mining-camp < 4)
    (or (goal g-fastcastle-reserve 0) (building-type-count-total mining-camp < 2))
    (wood-amount > 160)
    (up-pending-objects c: mining-camp < 1)
    (not (town-under-attack))
    (can-build mining-camp)
=>
    (build mining-camp)
)
(defrule
    (difficulty == hardest)
    (current-age >= feudal-age)
    (dropsite-min-distance wood > 4)
    (building-type-count-total lumber-camp < 4)
    (or (goal g-fastcastle-reserve 0) (building-type-count-total lumber-camp < 2))
    (wood-amount > 180)
    (up-pending-objects c: lumber-camp < 1)
    (not (town-under-attack))
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

; -----------------------------
; Farms - deliberately gradual
; -----------------------------
; FIXED9: no normal Dark-Age farming. Keep only a late starvation failsafe.
(defrule
    (current-age == dark-age)
    (game-time > 630)
    (food-amount < 80)
    (building-type-count-total farm < 2)
    (idle-farm-count < 1)
    (wood-amount > 140)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age == feudal-age)
    (research-completed ri-horse-collar)
    (building-type-count-total farm < 8)
    (idle-farm-count < 2)
    (wood-amount > 120)
    (can-build farm)
=>
    (build farm)
)

; A long Fortress Age Feudal phase needs more than eight farms once the
; economy grows beyond thirty villagers.
(defrule
    (current-age == feudal-age)
    (research-completed ri-horse-collar)
    (civilian-population > 30)
    (building-type-count-total farm < 14)
    (idle-farm-count < 3)
    (wood-amount > 250)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age == castle-age)
    (research-completed ri-horse-collar)
    (not(goal g-fastcastle-reserve 3))
    (building-type-count-total farm < 18)
    (idle-farm-count < 3)
    (wood-amount > 180)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age == imperial-age)
    (research-completed ri-horse-collar)
    (building-type-count-total farm < 30)
    (idle-farm-count < 4)
    (wood-amount > 250)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age == imperial-age)
    (research-completed ri-horse-collar)
    (civilian-population > 60)
    (building-type-count-total farm < 40)
    (idle-farm-count < 4)
    (wood-amount > 500)
    (can-build farm)
=>
    (build farm)
)

; High-pop food bases for Fortress Age's expensive cavalry and gunpowder.
(defrule
    (current-age == imperial-age)
    (research-completed ri-horse-collar)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (civilian-population > 68)
    (building-type-count-total farm < 44)
    (idle-farm-count < 5)
    (wood-amount > 700)
    (can-build farm)
=>
    (build farm)
)

(defrule
    (current-age == imperial-age)
    (research-completed ri-horse-collar)
    (goal g-maxpop-ge151 1)
    (civilian-population > 82)
    (building-type-count-total farm < 52)
    (idle-farm-count < 6)
    (wood-amount > 850)
    (can-build farm)
=>
    (build farm)
)

; ============================================================================
; FIXED8 HARDest LAND FAST-CASTLE RESERVE
; Replay vs ResonanceBot showed the Feudal bank being consumed by 11 Spearmen,
; 6 Militia, optional technologies and ~65 requested palisade tiles before the
; Castle click.  State 1 protects food/gold (50/70 escrow); state 2 keeps discretionary Feudal
; spending blocked after the click while the Town Center is researching Castle.
; Emergency military rules may still fire through explicit town-under-attack paths.
; ============================================================================
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 1)
    (civilian-population >= 28)
    (up-pending-objects c: villager <= 0)
    (can-research-with-escrow castle-age)
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (research castle-age)
    (set-goal g-fastcastle-reserve 2)
)

; Casualty/timing fallback preserves FIXED7's 15-minute floor without bypassing
; resources or prerequisites.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 1)
    (game-time > 900)
    (civilian-population >= 26)
    (up-pending-objects c: villager <= 0)
    (can-research-with-escrow castle-age)
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (research castle-age)
    (set-goal g-fastcastle-reserve 2)
)

; FIXED9: pressure may borrow from the bank, but it must never cancel the age plan.
(defrule
    (goal g-fastcastle-reserve 1)
    (town-under-attack)
=>
    (set-escrow-percentage food 20)
    (set-escrow-percentage gold 45)
)
(defrule
    (goal g-fastcastle-reserve 1)
    (not (town-under-attack))
=>
    (set-escrow-percentage food 35)
    (set-escrow-percentage gold 60)
)

; Water detection may settle after Feudal on unusual starts. Do not trap dock play
; behind a land-only reserve.
(defrule
    (goal g-fastcastle-reserve 1)
    (goal g-water 1)
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (set-goal g-fastcastle-reserve 0)
)

; Hardest land follow-through: after Castle completes, protect wood for the
; expensive modified-DAT second Town Center before normal spending resumes.
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal g-water 0)
    (goal g-fastcastle-reserve 2)
    (building-type-count-total town-center < 2)
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (set-escrow-percentage wood 50)
    (set-goal g-siege-escrow 0)
    (set-goal g-fastcastle-reserve 3)
)

; Non-land / already-boomed transitions return to normal. Pressure no longer cancels TC follow-through.
(defrule
    (current-age >= castle-age)
    (goal g-fastcastle-reserve 2)
    (or (goal g-water 1) (building-type-count-total town-center >= 2))
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (set-goal g-fastcastle-reserve 0)
)

; A committed second-TC foundation ends the wood bank.
(defrule
    (goal g-fastcastle-reserve 3)
    (building-type-count-total town-center >= 2)
=>
    (release-escrow wood)
    (set-escrow-percentage wood 0)
    (set-goal g-fastcastle-reserve 0)
)

; FIXED9: pressure lowers the TC bank but does not erase it. A long placement deadlock still releases it.
(defrule
    (goal g-fastcastle-reserve 3)
    (town-under-attack)
=>
    (set-escrow-percentage wood 25)
)
(defrule
    (goal g-fastcastle-reserve 3)
    (not (town-under-attack))
=>
    (set-escrow-percentage wood 50)
)
(defrule
    (goal g-fastcastle-reserve 3)
    (game-time > 2400)
=>
    (release-escrow wood)
    (set-escrow-percentage wood 0)
    (set-goal g-fastcastle-reserve 0)
)

; -----------------------------
; AGE ADVANCEMENT - FIXED4
; V11 FIXED3 accidentally lost the Feudal and Castle research rules.
; Use can-research as the engine-side affordability/prerequisite guard.
; Primary thresholds preserve the slower Fortress Age pacing.
; Time-based fallbacks prevent permanent age-lock after casualties or odd starts.
; -----------------------------

; FIXED6 Hardest pacing: Fortress Age stays slower than competitive vanilla AI,
; but Very Hard must not spend half the match waiting in Feudal. can-research
; remains the authoritative prerequisite/affordability guard.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population >= 20)
    (up-pending-objects c: villager <= 0)
    (can-research feudal-age)
=>
    (research feudal-age)
)
(defrule
    (difficulty == hard)
    (current-age == dark-age)
    (civilian-population >= 22)
    (up-pending-objects c: villager <= 0)
    (can-research feudal-age)
=>
    (research feudal-age)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (civilian-population >= 26)
    (up-pending-objects c: villager <= 0)
    (can-research castle-age)
=>
    (research castle-age)
)
(defrule
    (difficulty == hard)
    (current-age == feudal-age)
    (civilian-population >= 32)
    (up-pending-objects c: villager <= 0)
    (can-research castle-age)
=>
    (research castle-age)
)

; FIXED7 Hardest timing floor. These do not bypass prerequisites/resources:
; can-research remains authoritative, but casualties may not trap Very Hard behind a villager count.
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 540)
    (civilian-population >= 18)
    (up-pending-objects c: villager <= 0)
    (can-research feudal-age)
=>
    (research feudal-age)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (game-time > 900)
    (civilian-population >= 24)
    (up-pending-objects c: villager <= 0)
    (can-research castle-age)
=>
    (research castle-age)
)

; Dark -> Feudal. Villager production naturally stops at 25, leaving the TC free.
(defrule
    (current-age == dark-age)
    (civilian-population >= 24)
    (up-pending-objects c: villager <= 0)
    (can-research feudal-age)
=>
    (research feudal-age)
)

; Dark Age failsafe: after 20 minutes, advance whenever the engine says it is legal.
(defrule
    (current-age == dark-age)
    (game-time > 1200)
    (civilian-population >= 18)
    (civilian-population < 24)
    (up-pending-objects c: villager <= 0)
    (can-research feudal-age)
=>
    (research feudal-age)
)

; Feudal -> Castle. Fortress Age intentionally develops a larger Feudal economy.
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (civilian-population >= 38)
    (up-pending-objects c: villager <= 0)
    (can-research castle-age)
=>
    (research castle-age)
)

; Feudal Age failsafe: do not remain trapped forever after losses or unusual maps.
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (game-time > 2700)
    (civilian-population >= 28)
    (civilian-population < 38)
    (up-pending-objects c: villager <= 0)
    (can-research castle-age)
=>
    (research castle-age)
)

; -----------------------------
; Villager production
; -----------------------------
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (civilian-population < 20)
    (can-train villager)
=>
    (train villager)
)
(defrule
    (difficulty == hard)
    (current-age == dark-age)
    (civilian-population < 22)
    (can-train villager)
=>
    (train villager)
)
(defrule
    (difficulty == moderate)
    (current-age == dark-age)
    (civilian-population < 25)
    (can-train villager)
=>
    (train villager)
)

(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (civilian-population < 30)
    (can-train villager)
=>
    (train villager)
)
(defrule
    (difficulty == hard)
    (current-age == feudal-age)
    (civilian-population < 32)
    (can-train villager)
=>
    (train villager)
)
(defrule
    (difficulty == moderate)
    (current-age == feudal-age)
    (civilian-population < 40)
    (can-train villager)
=>
    (train villager)
)

; Castle Age targets by population cap.
(defrule
    (current-age == castle-age)
    (goal g-maxpop-le50 1)
    (civilian-population < 30)
    (can-train villager)
=>
    (train villager)
)

(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge51 1)
    (goal g-maxpop-le75 1)
    (civilian-population < 38)
    (can-train villager)
=>
    (train villager)
)

(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge76 1)
    (goal g-maxpop-le100 1)
    (civilian-population < 52)
    (can-train villager)
=>
    (train villager)
)

(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (civilian-population >= 54)
    (goal g-imperial-reserve 0)
    (not (town-under-attack))
=>
    (set-escrow-percentage food 25)
    (set-escrow-percentage gold 25)
    (set-goal g-imperial-reserve 1)
)
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (civilian-population >= 60)
    (goal g-imperial-reserve 0)
    (not (town-under-attack))
=>
    (set-escrow-percentage food 25)
    (set-escrow-percentage gold 25)
    (set-goal g-imperial-reserve 1)
)
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge151 1)
    (civilian-population >= 70)
    (goal g-imperial-reserve 0)
    (not (town-under-attack))
=>
    (set-escrow-percentage food 25)
    (set-escrow-percentage gold 25)
    (set-goal g-imperial-reserve 1)
)

(defrule
    (current-age == castle-age)
    (goal g-imperial-reserve 1)
    (can-research-with-escrow imperial-age)
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (research imperial-age)
    (set-goal g-imperial-reserve 0)
)


; FIXED5 replay repair: when Imperial is legally available, click it. Fortress
; preparation may influence WHEN prerequisites are built, but a Castle itself is
; no longer a hard prerequisite and a huge resource bank may not sit unused.
(defrule
    (current-age == castle-age)
    (goal g-maxpop-le125 1)
    (goal g-maxpop-ge101 1)
    (civilian-population >= 54)
    (can-research imperial-age)
=>
    (research imperial-age)
)
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (civilian-population >= 60)
    (can-research imperial-age)
=>
    (research imperial-age)
)
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge151 1)
    (civilian-population >= 70)
    (can-research imperial-age)
=>
    (research imperial-age)
)
; FIXED8: once a Hardest fortress has survived into mid-Castle, start protecting
; the Imperial bank at a realistic civilian count.  Replay FIXED7 never reached its
; 70-villager 200-pop trigger before the 52:46 recording ended.
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (game-time > 1800)
    (civilian-population >= 42)
    (goal g-imperial-reserve 0)
    (not (town-under-attack))
=>
    (set-escrow-percentage food 25)
    (set-escrow-percentage gold 25)
    (set-goal g-imperial-reserve 1)
)

; If prerequisites/resources are already legal, do not wait for the profile's
; ideal late-game villager target.
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (game-time > 2040)
    (civilian-population >= 42)
    (can-research imperial-age)
=>
    (research imperial-age)
)

; Time/resource-independent population fallback: after 45 minutes, a legal
; Imperial upgrade is more valuable than waiting for the ideal civilian target.
(defrule
    (current-age == castle-age)
    (game-time > 2700)
    (civilian-population >= 38)
    (can-research imperial-age)
=>
    (research imperial-age)
)

; Abort age savings if the base is under serious pressure. Survival comes first.
(defrule
    (goal g-imperial-reserve 1)
    (or (town-under-attack) (goal g-recovery 1))
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (set-goal g-imperial-reserve 0)
)
(defrule
    (current-age >= imperial-age)
    (goal g-imperial-reserve 1)
=>
    (release-escrow food)
    (release-escrow gold)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (set-goal g-imperial-reserve 0)
)

; -----------------------------
; Economy technologies
; -----------------------------
; FIXED8: throttle Loom attempts. The FIXED7 replay emitted 17 rejected Loom
; commands in the opening 26 seconds while the Town Center was occupied.
(defrule
    (timer-triggered t-loom)
    (food-amount > 120)
    (can-research ri-loom)
=>
    (research ri-loom)
    (enable-timer t-loom 20)
)

; FIXED9: Horse Collar is the first Feudal farm prerequisite.  If food is in
; the Castle escrow, borrow only for this technology and immediately restore the bank.
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 1)
    (not (town-under-attack))
    (food-amount > 140)
    (wood-amount > 90)
    (can-research-with-escrow ri-horse-collar)
=>
    (release-escrow food)
    (research ri-horse-collar)
    (set-escrow-percentage food 35)
)
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 1)
    (town-under-attack)
    (food-amount > 180)
    (wood-amount > 90)
    (can-research-with-escrow ri-horse-collar)
=>
    (release-escrow food)
    (research ri-horse-collar)
    (set-escrow-percentage food 20)
)
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (food-amount > 100)
    (wood-amount > 90)
    (can-research ri-horse-collar)
=>
    (research ri-horse-collar)
)

; Double-Bit Axe follows Horse Collar instead of racing it for the same food bank.
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 1)
    (research-completed ri-horse-collar)
    (not (town-under-attack))
    (food-amount > 220)
    (wood-amount > 80)
    (can-research-with-escrow ri-double-bit-axe)
=>
    (release-escrow food)
    (research ri-double-bit-axe)
    (set-escrow-percentage food 35)
)
(defrule
    (current-age == feudal-age)
    (goal g-fastcastle-reserve 0)
    (research-completed ri-horse-collar)
    (food-amount > 120)
    (wood-amount > 80)
    (can-research ri-double-bit-axe)
=>
    (research ri-double-bit-axe)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (gold-amount > 250)
    (can-research ri-gold-mining)
=>
    (research ri-gold-mining)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (stone-amount > 200)
    (can-research ri-stone-mining)
=>
    (research ri-stone-mining)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (food-amount > 450)
    (can-research ri-wheel-barrow)
=>
    (research ri-wheel-barrow)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (wood-amount > 500)
    (can-research ri-bow-saw)
=>
    (research ri-bow-saw)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (food-amount > 600)
    (can-research ri-heavy-plow)
=>
    (research ri-heavy-plow)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (gold-amount > 650)
    (can-research ri-gold-shaft-mining)
=>
    (research ri-gold-shaft-mining)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (stone-amount > 550)
    (can-research ri-stone-shaft-mining)
=>
    (research ri-stone-shaft-mining)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (food-amount > 800)
    (can-research ri-hand-cart)
=>
    (research ri-hand-cart)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (wood-amount > 900)
    (can-research ri-two-man-saw)
=>
    (research ri-two-man-saw)
)

(defrule
    (goal g-fastcastle-reserve 0)
    (food-amount > 1000)
    (can-research ri-crop-rotation)
=>
