; ==========================================================================
; V9 SIEGE ESCROW
; While staging an assault, protect part of wood/gold from ordinary unit queues.
; The pattern mirrors the supplied official HD AI: can-train-with-escrow,
; release the reserve, train one priority unit, then rebuild the reserve.
; ==========================================================================
(defrule
    (goal g-war-state state-siege)
    (goal g-siege-escrow 0)
    (goal g-fastcastle-reserve 0)
=>
    (set-escrow-percentage wood 25)
    (set-escrow-percentage gold 25)
    (set-goal g-siege-escrow 1)
)

; Trebuchets first against known fortresses.
(defrule
    (goal g-war-state state-siege)
    (goal g-siege-escrow 1)
    (or (goal g-fortress-depth 1) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
    (unit-type-count-total trebuchet < 3)
    (can-train-with-escrow trebuchet)
=>
    (release-escrow wood)
    (release-escrow gold)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (train trebuchet)
    (set-goal g-siege-escrow 0)
)

; Then guarantee a ram core.
(defrule
    (goal g-war-state state-siege)
    (goal g-siege-escrow 1)
    (unit-type-count-total battering-ram-line < 6)
    (can-train-with-escrow battering-ram-line)
=>
    (release-escrow wood)
    (release-escrow gold)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (train battering-ram-line)
    (set-goal g-siege-escrow 0)
)

; Deep fortress, high population: expand long-range artillery.
(defrule
    (goal g-war-state state-siege)
    (goal g-siege-escrow 1)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-maxpop-ge151 1)
    (unit-type-count-total trebuchet < 5)
    (can-train-with-escrow trebuchet)
=>
    (release-escrow wood)
    (release-escrow gold)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (train trebuchet)
    (set-goal g-siege-escrow 0)
)

(defrule
    (not(goal g-war-state state-siege))
    (goal g-siege-escrow 1)
=>
    (release-escrow wood)
    (release-escrow gold)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (set-goal g-siege-escrow 0)
)

; -----------------------------
; Siege production for the high-HP fortification environment
; -----------------------------

 ; Low-population games need lower siege readiness thresholds; otherwise
; the configured civilian target can leave too little military room to ever
; reach the generic readiness numbers.
(defrule
    (goal g-maxpop-le50 1)
    (current-age == castle-age)
    (military-population >= 12)
    (unit-type-count-total battering-ram-line < 2)
    (wood-amount > 750)
    (gold-amount > 350)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (goal g-maxpop-le50 1)
    (current-age == imperial-age)
    (military-population >= 14)
    (unit-type-count-total battering-ram-line < 3)
    (wood-amount > 950)
    (gold-amount > 450)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (goal g-maxpop-ge51 1)
    (goal g-maxpop-le75 1)
    (current-age == imperial-age)
    (military-population >= 22)
    (unit-type-count-total battering-ram-line < 4)
    (wood-amount > 1050)
    (gold-amount > 500)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (goal g-maxpop-le50 1)
    (current-age == imperial-age)
    (military-population >= 16)
    (building-type-count castle > 0)
    (unit-type-count-total trebuchet < 1)
    (wood-amount > 950)
    (gold-amount > 950)
    (can-train trebuchet)
=>
    (train trebuchet)
)
(defrule
    (goal g-maxpop-ge51 1)
    (goal g-maxpop-le75 1)
    (current-age == imperial-age)
    (military-population >= 24)
    (building-type-count castle > 0)
    (unit-type-count-total trebuchet < 2)
    (wood-amount > 1050)
    (gold-amount > 1050)
    (can-train trebuchet)
=>
    (train trebuchet)
)

; Extra low-pop fortress reserve. Without this, the 50-pop assault gate could
; correctly require 3/4 rams while no production rule was able to reach them.
(defrule
    (goal g-maxpop-le50 1)
    (goal g-fortress-threat 1)
    (current-age == castle-age)
    (military-population >= 14)
    (unit-type-count-total battering-ram-line < 3)
    (wood-amount > 900)
    (gold-amount > 400)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (goal g-maxpop-le50 1)
    (goal g-fortress-threat 1)
    (current-age == imperial-age)
    (military-population >= 16)
    (unit-type-count-total battering-ram-line < 4)
    (wood-amount > 1100)
    (gold-amount > 500)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)

; Preventive siege package. Fortress Age defenses are too strong to wait until
; the AI has already discovered a large number of enemy buildings. Keep a small
; core of rams ready once the Castle Age army is established.
(defrule
    (current-age == castle-age)
    (military-population >= 18)
    (unit-type-count-total battering-ram-line < 2)
    (wood-amount > 850)
    (gold-amount > 400)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)

; High-pop preventive Castle-Age siege. These make the 150/200-pop normal
; assault gates reachable even before a specific enemy fortress is identified.
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (military-population >= 30)
    (unit-type-count-total battering-ram-line < 3)
    (wood-amount > 1100)
    (gold-amount > 500)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge151 1)
    (military-population >= 38)
    (unit-type-count-total battering-ram-line < 4)
    (wood-amount > 1350)
    (gold-amount > 650)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)

(defrule
    (current-age == imperial-age)
    (military-population >= 28)
    (unit-type-count-total battering-ram-line < 4)
    (wood-amount > 1100)
    (gold-amount > 550)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)

; Larger assault armies maintain a deeper ram reserve for Fortress Age walls.
(defrule
    (current-age == imperial-age)
    (military-population >= 45)
    (unit-type-count-total battering-ram-line < 6)
    (wood-amount > 1500)
    (gold-amount > 750)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)

; Keep at least a small long-range siege group in Imperial Age even when
