    (current-age < castle-age)
    (taunt-detected any-ally 6)
=>
    (acknowledge-taunt this-any-ally 6)
    (chat-to-allies "Cannot spare stone before Castle Age.")
)

; ============================================================================
; V11 FORTRESS DEFENSE POSTURE
; ============================================================================
(defrule
    (or (goal g-own-fortress-depth 2) (goal g-own-fortress-depth 3))
    (not(goal g-war-state state-assault))
    (goal g-maxpop-le125 1)
=>
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 5)
    (set-strategic-number sn-maximum-defend-group-size 18)
)
(defrule
    (or (goal g-own-fortress-depth 2) (goal g-own-fortress-depth 3))
    (not(goal g-war-state state-assault))
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
=>
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 24)
)
(defrule
    (or (goal g-own-fortress-depth 2) (goal g-own-fortress-depth 3))
    (not(goal g-war-state state-assault))
    (goal g-maxpop-ge151 1)
=>
    (set-strategic-number sn-number-defend-groups 3)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 30)
)
(defrule
    (goal g-war-state state-emergency)
=>
    (set-strategic-number sn-number-defend-groups 3)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 55)
    (set-strategic-number sn-gather-defense-units 1)
)
(defrule
    (goal g-war-state state-recovery)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 2)
)



; FIXED5 replay repair: do not scatter lone soldiers and do not ask villagers
; to fight. Emergency defense forms two meaningful groups around the town.
(defrule
    (goal g-war-state state-emergency)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 8)
    (set-strategic-number sn-maximum-defend-group-size 28)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 45)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-allow-civilian-defense 0)
    (set-strategic-number sn-number-civilian-militia 0)
)
(defrule
    (town-under-attack)
=>
    (set-strategic-number sn-allow-civilian-defense 0)
    (set-strategic-number sn-number-civilian-militia 0)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
)

