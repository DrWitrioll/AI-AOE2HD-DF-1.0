    (set-strategic-number sn-minimum-town-size 5)
    (set-strategic-number sn-maximum-town-size 21)
    (set-strategic-number sn-safe-town-size 14)
    (set-strategic-number sn-random-placement-factor 0)
    (set-strategic-number sn-zero-priority-distance 450)
    (set-strategic-number sn-percent-civilian-builders 40)
    (set-strategic-number sn-cap-civilian-builders 4)
    (set-strategic-number sn-percent-civilian-gatherers 60)
    (set-strategic-number sn-cap-civilian-gatherers 100)
    (disable-self)
)

(defrule
    (true)
=>
    (set-strategic-number sn-relic-defend-priority 1)
    (set-strategic-number sn-livestock-defend-priority 2)
    (set-strategic-number sn-attack-winning-player 0)
    (set-strategic-number sn-attack-winning-player-factor 30)
    (set-strategic-number sn-maximum-food-drop-distance 12)
    (set-strategic-number sn-maximum-wood-drop-distance 10)
    (set-strategic-number sn-maximum-gold-drop-distance 10)
    (set-strategic-number sn-maximum-stone-drop-distance 10)
    (set-strategic-number sn-mill-max-distance 10)
    (disable-self)
)

; V9 Fortress Master deeper-state initialization.
(defrule
    (true)
=>
    (set-goal g-battle-balance balance-even)
    (set-goal g-reserve-posture reserve-balanced)
    (set-goal g-fortress-rebuild 0)
    (set-goal g-forward-siege 0)
    (set-goal g-civilian-laststand 0)
    (set-goal g-assault-attrition 0)
    (set-goal g-econ-stability 1)
    (set-goal g-choke-alert 0)
    (set-goal g-escalation 0)
    (disable-self)
)

; V10 team-status flags start clear.
(defrule
    (true)
=>
    (set-goal g-chat-siege-prep 0)
    (set-goal g-chat-assault-ready 0)
    (set-goal g-chat-recovery 0)
    (set-goal g-chat-fortress 0)
    (disable-self)
)

; -----------------------------
; Difficulty tuning - never cheats
; Difficulty changes pacing and tactical pressure, never resource income.
; -----------------------------
(defrule
    (difficulty == hardest)
=>
    (set-difficulty-parameter ability-to-dodge-missiles 0)
    (set-difficulty-parameter ability-to-maintain-distance 0)
    (set-strategic-number sn-consecutive-idle-unit-limit 1)
    (set-strategic-number sn-percent-attack-soldiers 82)
    (set-strategic-number sn-percent-attack-boats 85)
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 42)
    (set-strategic-number sn-initial-attack-delay 600)
    (set-strategic-number sn-defense-distance 20)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 45)
    (disable-timer t-land-assault)
    (enable-timer t-land-assault 600)
    (disable-self)
)

(defrule
    (difficulty == hard)
=>
    (set-difficulty-parameter ability-to-dodge-missiles 25)
    (set-difficulty-parameter ability-to-maintain-distance 25)
    (set-strategic-number sn-consecutive-idle-unit-limit 1)
    (set-strategic-number sn-percent-attack-soldiers 70)
    (set-strategic-number sn-percent-attack-boats 75)
    (set-strategic-number sn-minimum-attack-group-size 13)
    (set-strategic-number sn-maximum-attack-group-size 38)
    (set-strategic-number sn-initial-attack-delay 840)
    (disable-self)
)

(defrule
    (difficulty == moderate)
=>
    (set-difficulty-parameter ability-to-dodge-missiles 50)
    (set-difficulty-parameter ability-to-maintain-distance 50)
    (set-strategic-number sn-consecutive-idle-unit-limit 3)
    (set-strategic-number sn-percent-attack-soldiers 65)
    (set-strategic-number sn-percent-attack-boats 70)
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 36)
    (set-strategic-number sn-initial-attack-delay 900)
    (disable-self)
)

(defrule
    (difficulty == easy)
=>
    (set-difficulty-parameter ability-to-dodge-missiles 75)
    (set-difficulty-parameter ability-to-maintain-distance 75)
    (set-strategic-number sn-consecutive-idle-unit-limit 12)
    (set-strategic-number sn-percent-attack-soldiers 55)
    (set-strategic-number sn-percent-attack-boats 60)
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 28)
    (set-strategic-number sn-initial-attack-delay 1050)
    (disable-self)
)

(defrule
    (difficulty == easiest)
=>
    (set-difficulty-parameter ability-to-dodge-missiles 100)
    (set-difficulty-parameter ability-to-maintain-distance 100)
    (set-strategic-number sn-consecutive-idle-unit-limit 20)
    (set-strategic-number sn-percent-attack-soldiers 45)
    (set-strategic-number sn-percent-attack-boats 50)
    (set-strategic-number sn-minimum-attack-group-size 8)
    (set-strategic-number sn-maximum-attack-group-size 22)
    (set-strategic-number sn-initial-attack-delay 1200)
    (disable-self)
)

; -----------------------------
; Water map detection
; -----------------------------
(defrule
    (map-type archipelago)
=>
    (set-goal g-water 1)
    (set-goal g-transport-map 1)
    (disable-self)
)

(defrule
    (map-type baltic)
=>
    (set-goal g-water 1)
    (disable-self)
)

(defrule
    (map-type coastal)
=>
    (set-goal g-water 1)
    (disable-self)
)

(defrule
    (map-type continental)
=>
    (set-goal g-water 1)
    (disable-self)
)

(defrule
    (map-type islands)
=>
    (set-goal g-water 1)
    (set-goal g-transport-map 1)
    (disable-self)
)

(defrule
    (map-type mediterranean)
=>
    (set-goal g-water 1)
    (disable-self)
)

(defrule
    (map-type migration)
=>
    (set-goal g-water 1)
    (set-goal g-transport-map 1)
    (disable-self)
)

(defrule
    (map-type rivers)
=>
    (set-goal g-water 1)
    (disable-self)
)

(defrule
    (map-type team-islands)
=>
    (set-goal g-water 1)
    (set-goal g-transport-map 1)
    (disable-self)
)

(defrule
    (goal g-transport-map 1)
=>
    ; Native legacy SN: allows a small number of forward builders to board
    ; transports when construction across water is required.
    (set-strategic-number sn-number-forward-builders 2)
    ; The official HD AI disables ram garrisoning when transports are needed:
    ; otherwise infantry loaded into rams can interfere with amphibious tasking.
    (set-strategic-number sn-garrison-rams 0)
    (disable-self)
)


; FIXED8 early state lock: this rule is intentionally above ordinary Feudal
; economy/military spending so the first Feudal AI pass cannot leak resources.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (goal g-water 0)
    (goal g-fastcastle-reserve 0)
=>
    (set-escrow-percentage food 35)
    (set-escrow-percentage gold 60)
    (set-goal g-fastcastle-reserve 1)
)

; ==========================================================================
; V9 MAP PROFILE
; Closed maps deserve a real fortress phase instead of an open-map timetable.
; ==========================================================================
(defrule
    (map-type black-forest)
=>
    (set-goal g-closed-map 1)
    (set-strategic-number sn-initial-attack-delay 1500)
    (set-strategic-number sn-maximum-town-size 12)
    (disable-self)
)
(defrule
    (map-type arena)
=>
    (set-goal g-closed-map 1)
    (set-strategic-number sn-initial-attack-delay 1500)
    (set-strategic-number sn-maximum-town-size 12)
    (disable-self)
)
(defrule
    (map-type fortress)
=>
    (set-goal g-closed-map 1)
    (set-strategic-number sn-initial-attack-delay 1350)
    (set-strategic-number sn-maximum-town-size 12)
    (disable-self)
)

(defrule
    (player-in-game any-ally)
    (goal g-team-game 0)
=>
    (set-goal g-team-game 1)
    (disable-self)
)

; Late team games should pressure the strongest opponent instead of farming a
; dying flank forever. Solo games are unaffected.
(defrule
    (goal g-team-game 1)
    (game-time > 2400)
=>
    (set-strategic-number sn-attack-winning-player 1)
    (set-strategic-number sn-attack-winning-player-factor 40)
)

; -----------------------------
; Water tactical grouping
; Uses the same legacy boat-group controls as the official HD AI. This gives
; the fleet dedicated attack, defense and exploration groups rather than
; relying only on a global attack-now pulse.
; -----------------------------
(defrule
    (goal g-water 1)
    (goal g-water-tuned 0)
=>
    (set-strategic-number sn-number-boat-attack-groups 2)
    (set-strategic-number sn-minimum-boat-attack-group-size 4)
    (set-strategic-number sn-maximum-boat-attack-group-size 14)
    (set-strategic-number sn-number-boat-defend-groups 1)
    (set-strategic-number sn-minimum-boat-defend-group-size 2)
    (set-strategic-number sn-maximum-boat-defend-group-size 8)
    (set-strategic-number sn-number-boat-explore-groups 1)
    (set-strategic-number sn-minimum-boat-explore-group-size 1)
    (set-strategic-number sn-maximum-boat-explore-group-size 2)
    (set-goal g-water-tuned 1)
)

