; -----------------------------
; Expensive Town Centers in the modified DAT
; Build them only from a strong wood bank.
; -----------------------------
; FIXED8 protected second-TC commitment. This consumes the wood escrow before
; any normal post-Castle spending is re-enabled.
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (goal g-fastcastle-reserve 3)
    (civilian-population >= 26)
    (building-type-count-total town-center < 2)
    (up-pending-objects c: town-center < 1)
    (not(goal g-emergency-defense 1))
    (can-build-with-escrow town-center)
=>
    (release-escrow wood)
    (up-assign-builders c: town-center c: 5)
    (build town-center)
)

