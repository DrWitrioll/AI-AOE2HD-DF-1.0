(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 0)
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 82)
    (unit-type-count-total battering-ram-line >= 6)
    (unit-type-count-total trebuchet >= 1)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-threat 1)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 58)
    (unit-type-count-total battering-ram-line >= 5)
    (unit-type-count-total trebuchet >= 2)
=>
    (set-goal g-war-state state-assault)
)

; V9 depth-2 fortress readiness.
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 2)
    (current-age == castle-age)
    (goal g-maxpop-le125 1)
    (soldier-count >= 52)
    (unit-type-count-total battering-ram-line >= 6)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 2)
    (current-age == castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 62)
    (unit-type-count-total battering-ram-line >= 7)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 2)
    (current-age == castle-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 82)
    (unit-type-count-total battering-ram-line >= 8)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 2)
    (current-age == imperial-age)
    (goal g-maxpop-le125 1)
    (soldier-count >= 54)
    (unit-type-count-total battering-ram-line >= 7)
    (unit-type-count-total trebuchet >= 3)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 2)
    (current-age == imperial-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 66)
    (unit-type-count-total battering-ram-line >= 8)
    (unit-type-count-total trebuchet >= 3)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 2)
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 92)
    (unit-type-count-total battering-ram-line >= 10)
    (unit-type-count-total trebuchet >= 4)
=>
    (set-goal g-war-state state-assault)
)

; V9 depth-3 fortress readiness: this is a deliberate heavy siege commitment.
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 3)
    (current-age == castle-age)
    (goal g-maxpop-le125 1)
    (soldier-count >= 54)
    (unit-type-count-total battering-ram-line >= 8)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 3)
    (current-age == castle-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 66)
    (unit-type-count-total battering-ram-line >= 9)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 3)
    (current-age == castle-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 86)
    (unit-type-count-total battering-ram-line >= 10)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 3)
    (current-age == imperial-age)
    (goal g-maxpop-le125 1)
    (soldier-count >= 56)
    (unit-type-count-total battering-ram-line >= 8)
    (unit-type-count-total trebuchet >= 3)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 3)
    (current-age == imperial-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 68)
    (unit-type-count-total battering-ram-line >= 9)
    (unit-type-count-total trebuchet >= 4)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-fortress-depth 3)
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 94)
    (unit-type-count-total battering-ram-line >= 12)
    (unit-type-count-total trebuchet >= 5)
=>
    (set-goal g-war-state state-assault)
)

; Wonder emergency can commit with a slightly imperfect package rather than lose
; while waiting for one more siege unit.
(defrule
    (goal g-war-state state-siege)
    (goal g-victory-threat 1)
    (current-age == imperial-age)
    (goal g-maxpop-le125 1)
    (soldier-count >= 42)
    (unit-type-count-total battering-ram-line >= 4)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-victory-threat 1)
    (current-age == imperial-age)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 54)
    (unit-type-count-total battering-ram-line >= 5)
=>
    (set-goal g-war-state state-assault)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-victory-threat 1)
    (current-age == imperial-age)
    (goal g-maxpop-ge151 1)
    (soldier-count >= 74)
    (unit-type-count-total battering-ram-line >= 6)
=>
    (set-goal g-war-state state-assault)
)

; --------------------------------------------------------------------------
; V10 TEAM STATUS: fortress assault readiness edge.
; Only fortress assaults are announced; ordinary pressure stays quiet.
; --------------------------------------------------------------------------
(defrule
    (goal g-war-state state-assault)
    (goal g-fortress-threat 1)
    (goal g-command-hold 0)
    (goal g-chat-assault-ready 0)
    (player-in-game any-human-ally)
=>
    (chat-to-allies "Fortress assault ready.")
    (set-goal g-chat-assault-ready 1)
)

; Re-arm when that assault ends so a later, separate offensive can report again.
(defrule
    (not(goal g-war-state state-assault))
    (goal g-chat-assault-ready 1)
=>
    (set-goal g-chat-assault-ready 0)
)

; No trickle attacks in non-assault states. Defense groups remain separate.
(defrule
    (or
        (goal g-war-state state-develop)
        (or
            (goal g-war-state state-fortify)
            (or
                (goal g-war-state state-mobilize)
                (or
                    (goal g-war-state state-siege)
                    (or
                        (goal g-war-state state-recovery)
                        (goal g-war-state state-emergency)
                    )
                )
            )
        )
    )
=>
    (set-strategic-number sn-number-attack-groups 0)
)

; Assault configuration: ordinary pressure can split, fortress assaults stay one
; concentrated column around the longest-range commander / siege core.
(defrule
    (goal g-war-state state-assault)
    (goal g-fortress-threat 1)
=>
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-group-commander-selection-method 2)
    (set-strategic-number sn-group-form-distance 20)
    (set-strategic-number sn-attack-group-gather-spacing 2)
    (set-strategic-number sn-group-leader-defense-distance 2)
)
(defrule
    (goal g-war-state state-assault)
    (goal g-fortress-threat 0)
    (goal g-maxpop-le125 1)
=>
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 30)
    (set-strategic-number sn-group-commander-selection-method 0)
    (set-strategic-number sn-group-form-distance 24)
)
(defrule
    (goal g-war-state state-assault)
    (goal g-fortress-threat 0)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
=>
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 36)
    (set-strategic-number sn-group-commander-selection-method 0)
    (set-strategic-number sn-group-form-distance 24)
)
(defrule
    (goal g-war-state state-assault)
    (goal g-fortress-threat 0)
    (goal g-maxpop-ge151 1)
=>
    (set-strategic-number sn-number-attack-groups 3)
    (set-strategic-number sn-minimum-attack-group-size 16)
    (set-strategic-number sn-maximum-attack-group-size 38)
    (set-strategic-number sn-group-commander-selection-method 0)
    (set-strategic-number sn-group-form-distance 24)
)

; V9 exploit mode: only a shallow fortress can transition to wider pressure,
; and only after the first concentrated breach cycle has already been sustained.
(defrule
    (goal g-war-state state-assault)
    (or (goal g-fortress-depth 0) (goal g-fortress-depth 1))
    (goal g-assault-cycle 2)
    (goal g-exploit 0)
=>
    (set-goal g-exploit 1)
)
(defrule
    (goal g-exploit 1)
    (or (not(goal g-war-state state-assault)) (or (goal g-fortress-depth 2) (goal g-fortress-depth 3)))
=>
    (set-goal g-exploit 0)
)
(defrule
    (goal g-war-state state-assault)
    (goal g-exploit 1)
    (goal g-maxpop-le150 1)
=>
    (set-strategic-number sn-number-attack-groups 3)
    (set-strategic-number sn-group-commander-selection-method 0)
    (set-strategic-number sn-group-form-distance 28)
)
(defrule
    (goal g-war-state state-assault)
    (goal g-exploit 1)
    (goal g-maxpop-ge151 1)
=>
    (set-strategic-number sn-number-attack-groups 4)
    (set-strategic-number sn-group-commander-selection-method 0)
    (set-strategic-number sn-group-form-distance 30)
)

; Difficulty affects how much of the ready army actually commits.
(defrule
    (goal g-war-state state-assault)
    (difficulty == hardest)
=>
    (set-strategic-number sn-percent-attack-soldiers 85)
)
(defrule
    (goal g-war-state state-assault)
    (difficulty == hard)
=>
    (set-strategic-number sn-percent-attack-soldiers 80)
)
(defrule
    (goal g-war-state state-assault)
    (difficulty == moderate)
=>
    (set-strategic-number sn-percent-attack-soldiers 72)
)
(defrule
    (goal g-war-state state-assault)
    (difficulty == easy)
=>
    (set-strategic-number sn-percent-attack-soldiers 62)
)
(defrule
    (goal g-war-state state-assault)
    (difficulty == easiest)
=>
    (set-strategic-number sn-percent-attack-soldiers 52)
)

; Team assaults prefer targets near allied pressure, but solo games stay neutral.
(defrule
    (goal g-war-state state-assault)
    (player-in-game any-ally)
=>
    (set-strategic-number sn-target-evaluation-ally-proximity 100)
    (set-strategic-number sn-coop-share-attacking 1)
)
(defrule
    (not(goal g-war-state state-assault))
=>
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)

; FIXED6 immediate fortress-contact discipline. If a Castle is discovered during
; a normal field assault, stop feeding cavalry/spears into Castle fire and regroup for siege.
(defrule
    (goal g-war-state state-assault)
    (players-building-type-count any-enemy castle > 0)
    (unit-type-count-total battering-ram-line < 2)
=>
    (set-goal g-fortress-threat 1)
    (set-goal g-war-state state-siege)
    (set-goal g-assault-window 0)
    (disable-timer t-siege-prep)
    (enable-timer t-siege-prep 360)
    (up-retreat-now)
)

; Launch once, then reassess. A healthy army fighting a deep fortress receives
; one extended breach cycle before regrouping, rather than retreating at a fixed 3 minutes.
(defrule
    (goal g-war-state state-assault)
    (goal g-assault-window 1)
    (goal g-command-hold 0)
    (not (town-under-attack))
=>
    (attack-now)
    (set-goal g-assault-window 0)
    (set-goal g-assault-cycle 1)
    (disable-timer t-reassess)
    (enable-timer t-reassess 180)
)
(defrule
    (timer-triggered t-reassess)
=>
    (disable-timer t-reassess)
    (set-goal g-reassess 1)
)

; Continue one extra cycle if the fortress is deep and the attack force is still healthy.
(defrule
    (goal g-reassess 1)
    (goal g-war-state state-assault)
    (goal g-assault-cycle 1)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-maxpop-le125 1)
    (soldier-count >= 42)
=>
    (set-goal g-reassess 0)
    (set-goal g-assault-cycle 2)
    (enable-timer t-reassess 150)
)
(defrule
    (goal g-reassess 1)
    (goal g-war-state state-assault)
    (goal g-assault-cycle 1)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (soldier-count >= 54)
=>
    (set-goal g-reassess 0)
    (set-goal g-assault-cycle 2)
    (enable-timer t-reassess 150)
)
(defrule
    (goal g-reassess 1)
    (goal g-war-state state-assault)
    (goal g-assault-cycle 1)
    (or (goal g-fortress-depth 2) (goal g-fortress-depth 3))
    (goal g-maxpop-ge151 1)
    (soldier-count >= 76)
=>
    (set-goal g-reassess 0)
    (set-goal g-assault-cycle 2)
    (enable-timer t-reassess 150)
)

; Otherwise regroup and rebuild the next siege wave.
(defrule
    (goal g-reassess 1)
    (goal g-war-state state-assault)
    (goal g-emergency-defense 0)
    (goal g-recovery 0)
=>
    (set-goal g-war-state state-mobilize)
    (set-goal g-reassess 0)
    (set-goal g-assault-cycle 0)
    (set-goal g-exploit 0)
)
(defrule
    (goal g-reassess 1)
    (not(goal g-war-state state-assault))
=>
    (set-goal g-reassess 0)
    (set-goal g-assault-cycle 0)
)

; Late scouting: if no enemy fortress has been identified, deliberately
; re-explore stale map sectors instead of assuming the first scouting pass is enough.
(defrule
    (current-age == imperial-age)
    (game-time > 2400)
    (goal g-water 0)
    (goal g-fortress-threat 0)
    (goal g-late-scouting 0)
=>
    (set-goal g-late-scouting 1)
    (set-strategic-number sn-blot-exploration-map 1)
    (set-strategic-number sn-total-number-explorers 2)
    (set-strategic-number sn-number-explore-groups 2)
)
(defrule
    (goal g-late-scouting 1)
    (goal g-fortress-threat 1)
=>
    (set-goal g-late-scouting 0)
    (set-strategic-number sn-blot-exploration-map 0)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
)

; Naval warfare is handled by dedicated boat attack groups. Do NOT use a global
; attack-now pulse here: in HD it can also commit land forces at a bad moment.
; The naval timer is retained only as a periodic readiness window for future
; amphibious extensions and is consumed once a viable fleet exists.
(defrule
    (goal g-water 1)
    (goal g-naval-assault-window 1)
    (goal g-maxpop-le125 1)
    (warboat-count >= 12)
=>
    (set-goal g-naval-assault-window 0)
)
(defrule
    (goal g-water 1)
    (goal g-naval-assault-window 1)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (warboat-count >= 16)
=>
    (set-goal g-naval-assault-window 0)
)
(defrule
    (goal g-water 1)
    (goal g-naval-assault-window 1)
    (goal g-maxpop-ge151 1)
    (warboat-count >= 22)
=>
    (set-goal g-naval-assault-window 0)
)

; ============================================================================
; LATE-GAME REINFORCEMENT / RESOURCE-PRESERVING RULES
; ============================================================================

; If gold is scarce, lean into non-gold counters.
(defrule
    (current-age == imperial-age)
    (gold-amount < 250)
    (unit-type-count-total spearman-line < 18)
    (can-train spearman-line)
=>
    (train spearman-line)
)

(defrule
    (current-age == imperial-age)
    (gold-amount < 250)
    (unit-type-count-total skirmisher-line < 18)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)

(defrule
    (current-age == imperial-age)
    (gold-amount < 200)
    (goal g-scout-phase 0)
    (unit-type-count-total scout-cavalry-line < 12)
    (can-train scout-cavalry-line)
=>
    (train scout-cavalry-line)
)



; ============================================================================
; V11 CORE INITIALIZATION / HD-SAFE OPERATING DEFAULTS
; ============================================================================
(defrule
    (true)
=>
    (set-goal g-command-hold 0)
    (set-goal g-command-force 0)
    (set-goal g-command-siege 0)
    (set-goal g-command-retreat 0)
    (set-goal g-team-support 0)
    (set-goal g-forced-target 0)
    (set-goal g-chat-distress 0)
    (set-goal g-chat-gold-crisis 0)
    (set-goal g-gold-exhausted 0)
    (set-goal g-stone-exhausted 0)
    (set-goal g-map-profile map-open)
    (set-goal g-v11-ready 0)
    (disable-self)
)
(defrule
    (true)
=>
    (set-goal g-civ-fortress-style fortress-balanced)
    (set-goal g-civ-aggression-style aggression-balanced)
    (set-goal g-civ-siege-style siege-normal)
    (set-goal g-civ-eco-style eco-balanced)
    (set-goal g-team-human 0)
    (set-goal g-command-status 0)
    (set-goal g-fortress-integrity 0)
    (set-goal g-trade-emergency 0)
    (set-goal g-chat-hold 0)
    (set-goal g-chat-target 0)
    (set-strategic-number sn-camp-max-distance 18)
    (set-strategic-number sn-wood-dropsite-distance 6)
    (set-strategic-number sn-gold-dropsite-distance 6)
    (disable-self)
)
(defrule
    (true)
=>
    (set-strategic-number sn-stone-dropsite-distance 6)
    (set-strategic-number sn-maximum-hunt-drop-distance 25)
    (set-goal g-v11-ready 1)
    (disable-self)
)

; Human teammate detection is used only for useful English team communication.
(defrule
    (player-in-game any-human-ally)
    (goal g-team-human 0)
=>
    (set-goal g-team-human 1)
)
(defrule
    (not (player-in-game any-human-ally))
    (goal g-team-human 1)
=>
    (set-goal g-team-human 0)
)


; ============================================================================
; V11 CRITICAL ECONOMY REPAIR: COMPLETE VILLAGER TARGETS
; The previous branch stopped explicit villager production above the 100-pop
; Castle target. These rules make the 125 / 150 / 200 profiles reachable.
; ============================================================================
(defrule
    (current-age == castle-age)
    (goal g-maxpop-ge101 1)
    (goal g-maxpop-le125 1)
    (civilian-population < 58)
