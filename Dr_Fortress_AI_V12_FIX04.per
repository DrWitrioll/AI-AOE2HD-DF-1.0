; Low-gold / durable backbone.
(defrule
    (or (not(difficulty == hardest)) (and (goal g-fastcastle-reserve 0) (building-type-count-total town-center >= 2)))
    (military-population < 12)
    (can-train spearman-line)
=>
    (train spearman-line)
)

; Generic militia mass starts in Feudal Age, so the Dark-Age age-up bank is
; not accidentally consumed by a large militia queue.
(defrule
    (current-age >= feudal-age)
    (or (not(difficulty == hardest)) (and (goal g-fastcastle-reserve 0) (building-type-count-total town-center >= 2)))
    (military-population < 18)
    (food-amount > 250)
    (gold-amount > 120)
    (can-train militiaman-line)
=>
    (train militiaman-line)
)
; Small emergency militia response remains available if Dark-Age town is hit.
(defrule
    (current-age == dark-age)
    (town-under-attack)
    (unit-type-count-total militiaman-line < 4)
    (food-amount > 150)
    (gold-amount > 50)
    (can-train militiaman-line)
=>
    (train militiaman-line)
)

(defrule
    (or (not(difficulty == hardest)) (and (goal g-fastcastle-reserve 0) (building-type-count-total town-center >= 2)))
    (military-population < 18)
    (food-amount > 250)
    (wood-amount > 250)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)

; General midgame composition.
(defrule
    (current-age >= castle-age)
    (or (not(difficulty == hardest)) (or (town-under-attack) (building-type-count-total town-center >= 2)))
    (unit-type-count-total archer-line < 12)
    (wood-amount > 450)
    (gold-amount > 450)
    (can-train archer-line)
=>
    (train archer-line)
)

(defrule
    (current-age >= castle-age)
    (or (not(difficulty == hardest)) (or (town-under-attack) (building-type-count-total town-center >= 2)))
    (unit-type-count-total knight-line < 10)
    (food-amount > 550)
    (gold-amount > 550)
    (can-train knight-line)
=>
    (train knight-line)
)

(defrule
    (current-age >= castle-age)
    (or (not(difficulty == hardest)) (or (town-under-attack) (building-type-count-total town-center >= 2)))
    (unit-type-count-total cavalry-archer-line < 8)
    (wood-amount > 650)
    (gold-amount > 650)
    (can-train cavalry-archer-line)
=>
    (train cavalry-archer-line)
)

; Imperial premium-line expansion.
; V4 capped Knights at 10 and Cavalry Archers at 8, while Paladin and Heavy
; Cavalry Archer research required 12 and 10 units respectively. Those upgrade
; conditions could therefore be unreachable in ordinary play.
(defrule
    (current-age == imperial-age)
    (military-population >= 28)
    (unit-type-count-total knight-line < 14)
    (food-amount > 900)
    (gold-amount > 850)
    (can-train knight-line)
=>
    (train knight-line)
)

(defrule
    (current-age == imperial-age)
    (military-population >= 28)
    (unit-type-count-total cavalry-archer-line < 12)
    (wood-amount > 900)
    (gold-amount > 850)
    (can-train cavalry-archer-line)
=>
    (train cavalry-archer-line)
)

(defrule
    (current-age == imperial-age)
    (military-population >= 30)
    (unit-type-count-total archer-line < 16)
    (wood-amount > 800)
    (gold-amount > 750)
    (can-train archer-line)
=>
    (train archer-line)
)

; Larger population settings can sustain deeper premium cores. These rules do
; not force unavailable lines: can-train keeps civilization tech trees intact.
(defrule
    (current-age == imperial-age)
    (goal g-maxpop-ge126 1)
    (military-population >= 40)
    (unit-type-count-total knight-line < 18)
    (food-amount > 1100)
    (gold-amount > 1000)
    (can-train knight-line)
=>
    (train knight-line)
)
