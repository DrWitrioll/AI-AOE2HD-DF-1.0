; A siege army always has a cheap anti-cavalry escort, even before an enemy
; cavalry mass is fully identified.
(defrule
    (goal g-war-state state-siege)
    (goal g-maxpop-le125 1)
    (unit-type-count-total spearman-line < 10)
    (food-amount > 400)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (goal g-war-state state-siege)
    (goal g-maxpop-ge126 1)
    (goal g-maxpop-le150 1)
    (unit-type-count-total spearman-line < 14)
    (food-amount > 450)
    (can-train spearman-line)
=>
    (train spearman-line)
)
