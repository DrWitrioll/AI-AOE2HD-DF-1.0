(defrule
	(resource-found wood)
	(building-type-count-total mill >= 1)
	(unit-type-count villager > 10)
	(building-type-count-total lumber-camp < 1)
	(can-build-with-escrow lumber-camp)
=>
	(set-escrow-percentage wood 0)
	(release-escrow wood)
	(build lumber-camp)
) 

