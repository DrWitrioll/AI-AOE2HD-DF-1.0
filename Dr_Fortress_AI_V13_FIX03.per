(up-timer-status 30 == timer-disabled)
(up-timer-status 31 == timer-disabled)
=> 
(chat-to-all "9: My empire has been reduced to rubble. Your skill is unparalleled.")
(chat-to-all "You have proven your superiority in battle. I admit defeat. GG.")
(tribute-to-player every-ally food 200)
(tribute-to-player every-ally wood 200)
(tribute-to-player every-ally gold 200)
(tribute-to-player every-ally stone 200)
(resign))

