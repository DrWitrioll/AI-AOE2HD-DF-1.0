	(resource-found wood)
	(starting-age >= feudal-age)
	(building-type-count-total lumber-camp < 1)
	(can-build-with-escrow lumber-camp)
=>
	(set-escrow-percentage wood 0)
	(release-escrow wood)
	(build lumber-camp)
) 

