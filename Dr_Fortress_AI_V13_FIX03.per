	(set-goal uniqueflood 0) 
	(set-goal createarmy 1)
	(disable-timer 21)
	(disable-self)
) 

(defrule
	(or(goal uniqueflood 1) 
	(goal masspaladin 1))
	(goal createarmy 0)
	(or(military-population <= 20)
	(population-cap <= 150))
=>
	(set-goal uniqueflood 0) 
	(set-goal masspaladin 0) 
	(set-goal createarmy 1)
	(disable-timer 21)
	(disable-self)
) 

(defrule
(taunt-detected any-human 160) ;for debugging
=>
(set-goal uniqueflood 0) 
(set-goal masspaladin 0) 
(set-goal createarmy 1)
(set-goal createnavy 1)
(set-goal imperialarmy 0)
(disable-timer 21)
(acknowledge-taunt this-any-human 160)
) 

(defrule
	(goal imperialarmy 0) 
	(game-time < 3600)
	(goal uniqueflood 1)
	(goal createarmy 0)
	(current-age == imperial-age)
	(not(civ-selected turkish))
	(not(civ-selected hun))
	(or(players-unit-type-count any-enemy archer-line >= 40)
	(or(players-unit-type-count any-enemy skirmisher-line >= 40)
	(or(players-unit-type-count any-enemy mangonel-line >= 5)
	(players-unit-type-count any-enemy scorpion-line >= 10))))
	(unit-type-count mangonel-line < 5)
	(can-train mangonel-line)
=>
	(train mangonel-line)
) 

(defrule
	(goal imperialarmy 0) 
	(game-time < 3600)
	(wood-amount > 100)
	(goal uniqueflood 1)
	(goal createarmy 0)
	(civ-selected gothic)
	(or(players-unit-type-count any-enemy militiaman-line >= 30)
	(or(players-unit-type-count any-enemy samurai-line >= 40)
	(or(players-unit-type-count any-enemy teutonic-knight-line >= 30)
	(or(players-unit-type-count any-enemy jaguar-man-line >= 30)
	(players-unit-type-count any-enemy spearman-line >= 30)))))
	(unit-type-count hand-cannoneer < 50)
	(can-train hand-cannoneer)
=>
	(train hand-cannoneer)
) 

(defrule
	(goal imperialarmy 0) 
	(game-time < 3600)
	(wood-amount > 100)
	(goal uniqueflood 1)
	(goal createarmy 0)
	(not(civ-selected saracen))
	(or(gold-amount < 50)
	(or(players-unit-type-count any-enemy knight-line >= 30)
	(or(players-unit-type-count any-enemy scout-cavalry-line >= 40)
	(or(players-unit-type-count any-enemy war-elephant-line >= 20)
	(goal enemydlccavalry 1))))) ;rise of the rajas, new
	(unit-type-count spearman-line < 60)
	(can-train spearman-line)
=>
	(train spearman-line)
) 

(defrule
	(goal imperialarmy 0) 
	(game-time < 3600)
	(wood-amount > 100)
	(goal uniqueflood 1)
	(goal createarmy 0)
	(civ-selected saracen)
	(or(gold-amount < 50)
	(or(players-unit-type-count any-enemy archer-line >= 30)
	(or(players-unit-type-count any-enemy skirmisher-line >= 40)
	(or(players-unit-type-count any-enemy hand-cannoneer >= 30)
	(players-unit-type-count any-enemy spearman-line >= 30)))))
	(unit-type-count skirmisher-line < 60)
	(can-train skirmisher-line)
=>
	(train skirmisher-line)
) 

(defrule
	(goal imperialarmy 0) 
	(game-time < 3600) 
	(goal uniqueflood 1)
	(goal createarmy 0)
	(current-age == imperial-age)
	(research-completed my-unique-unit-upgrade)
	(can-train my-unique-unit-line)
=>
	(train my-unique-unit-line)
) 

;=======Advancing to the Next Age==========

(defrule
	(timer-triggered 10)
	(goal escrowtoadvance 1)
	(not(current-age == imperial-age))
=>
	(disable-timer 10)
	(enable-timer 10 120)
	(set-escrow-percentage food 90)
	(set-escrow-percentage gold 90)
) 

(defrule
	(timer-triggered 10)
	(or(up-research-status c: feudal-age >= research-pending)
	(or(up-research-status c: castle-age >= research-pending)
	(up-research-status c: imperial-age >= research-pending)))
=>
	(disable-timer 10)
	(enable-timer 10 120)
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
) 

(defrule
	(game-time > 720)
	(up-research-status c: feudal-age < research-pending)
	(current-age == dark-age)
=>
	(set-goal escrowtoadvance 1) 
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(game-time < 1200)
	(current-age == feudal-age)
	(goal escrowtoadvance 1)
=>
	(set-goal escrowtoadvance 0) 
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(game-time > 1380)
	(up-research-status c: castle-age < research-pending)
	(current-age == feudal-age)
=>
	(set-goal escrowtoadvance 1) 
	(disable-timer 10)
	(enable-timer 10 60)
	(disable-self)
) 

(defrule
	(game-time < 1800)
	(current-age == castle-age)
	(goal escrowtoadvance 1)
=>
	(set-goal escrowtoadvance 0) 
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(game-time > 1980)
	(up-research-status c: imperial-age < research-pending)
	(current-age == castle-age)
=>
	(set-goal escrowtoadvance 1) 
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(current-age == imperial-age)
	(goal escrowtoadvance 1)
=>
	(set-goal escrowtoadvance 0) 
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(disable-timer 10)
	(disable-self)
) 

;=======Economic Boom Goal===============

(defrule
	(goal boom 1)
=>
;	(chat-local-to-self "I have decided to Boom this game. I will make a strong economy.")
	(disable-self)
) 

(defrule
	(game-time > 600)
	(game-time < 1200)
	(town-under-attack)
	(or(players-military-population any-enemy >= 3)
	(or(enemy-buildings-in-town)
	(cc-players-building-type-count any-enemy watch-tower-line >= 1)))
=>
;	(chat-local-to-self "I am being rushed! I can't boom this game.")
	(set-goal boom 0) 
	(disable-self)
) 

