(disable-self)
)

;========Resign Rules=========
;Timer 30-31 is for requesting a Resign

;(defrule
;(up-timer-status 30 == timer-disabled)
;(up-timer-status 31 == timer-disabled)
;(taunt-detected any-human 8)
;(goal earlyresign 1)
;=>     
;(chat-to-all "I acknowledge that you have defeated me. Will you let me Resign?")
;(chat-to-all "You can respond with Taunts 1 or 2, or you can choose not to answer.")
;(enable-timer 30 20)
;(acknowledge-taunt this-any-human 8)
;)

(defrule
(up-timer-status 30 == timer-disabled)
(taunt-detected any-human 1)
=>     
(acknowledge-taunt this-any-human 1)
)

(defrule
(up-timer-status 30 == timer-disabled)
(taunt-detected any-human 2)
=>     
(acknowledge-taunt this-any-human 2)
)

(defrule
(timer-triggered 30)
(taunt-detected any-human 1)
=>     
(chat-to-all "You are an honorable opponent. I shall now resign gracefully.")
(chat-to-all "Perhaps someday I will get a chance to face you in combat again.")
(set-goal earlyresign 1)
(enable-timer 31 20)
(acknowledge-taunt this-any-human 1)
(disable-timer 30)
)

(defrule
(timer-triggered 30)
(taunt-detected any-human 2)
=>     
(chat-to-all "I understand that you have not accepted my formal surrender.")
(chat-to-all "Then I shall continue playing until I am unable to rebuild.")
(set-goal earlyresign 0)
(acknowledge-taunt this-any-human 2)
(disable-timer 30)
)

(defrule
(timer-triggered 30)
(not(taunt-detected any-human 1))
(not(taunt-detected any-human 2))
=>     
(chat-to-all "I understand that you have not responded to my surrender request.")
(chat-to-all "Then I shall continue playing for a little while longer.")
(chat-to-all "Make sure to use the Chat Menu (Trumpet Icon) to chat with AI.")
(set-goal earlyresign 1)
(disable-timer 30)
)

(defrule
(timer-triggered 31)
=>     
;(disable-timer 31)
(chat-to-all "7: It was an honor to battle with such a tenacious and wise opponent.")
(chat-to-all "You have proven your superiority in battle. I admit defeat. GG.")
(tribute-to-player every-ally food 200)
(tribute-to-player every-ally wood 200)
(tribute-to-player every-ally gold 200)
(tribute-to-player every-ally stone 200)
(resign))

(defrule 
(game-time > 600)
(unit-type-count-total villager < 15)
(building-type-count town-center == 0)
(up-timer-status 30 == timer-disabled)
(up-timer-status 31 == timer-disabled)
=> 
(chat-to-all "9: I no longer have the necessary Town Centers or Villagers to rebuild.")
(chat-to-all "You have proven your superiority in battle. I admit defeat. GG.")
(tribute-to-player every-ally food 200)
(tribute-to-player every-ally wood 200)
(tribute-to-player every-ally gold 200)
(tribute-to-player every-ally stone 200)
(resign))

