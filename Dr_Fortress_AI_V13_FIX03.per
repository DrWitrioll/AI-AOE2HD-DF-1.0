(defrule
(game-time > 30)
(not(civ-selected persian))
(not(civ-selected hun))
(not(civ-selected mayan))
=>
(set-goal stopinfantry 0)
(disable-self)
)

(defrule
(game-time > 30)
(current-age >= castle-age)
(research-completed ri-man-at-arms)
(or(players-unit-type-count any-enemy eagle-warrior-line >= 5)
(or(players-unit-type-count any-enemy huskarl-line >= 5)
(or(players-unit-type-count any-enemy spearman-line >= 10)
(or(players-unit-type-count any-enemy skirmisher-line >= 12)
(or(players-unit-type-count any-enemy camel-line >= 10)
(players-unit-type-count any-enemy battering-ram-line >= 2))))))
=>
(set-goal infantrycounter 1)
)

(defrule
(game-time > 30)
(current-age >= castle-age)
(research-completed ri-man-at-arms)
(players-unit-type-count any-enemy eagle-warrior-line < 5)
(players-unit-type-count any-enemy huskarl-line < 5)
(players-unit-type-count any-enemy spearman-line < 10)
(players-unit-type-count any-enemy skirmisher-line < 12)
(players-unit-type-count any-enemy camel-line < 10)
(players-unit-type-count any-enemy battering-ram-line < 2)
=>
(set-goal infantrycounter 0)
)

;=======Military Naval and Economy Advantage============

;=======Allow Chats and Chat Introduction============================
;Timers 32,33 are for Chat Priority, ensure that not all AIs talk at the same time. 
;allowchats
;chatpriority1
;chatpriortiy2
;chatpriority3
;chatpriority4
;chatintroduction

(defrule
	(game-time > 5)
	(game-time < 10)
=>
	(set-goal chatintroduction 1) 
	(set-goal allowchats 1)
	(disable-self)
) 

(defrule
	(goal aiteammate 0)
	(game-time > 180)
=>
	(set-goal allowchats 1)
) 

(defrule
	(game-time < 40)
	(game-time > 10)
	(goal allowchats 0)
	(taunt-detected any-computer 39)
=>     
	(set-goal chatintroduction 0) 
	(acknowledge-taunt this-any-computer 39)
)

(defrule
	(game-time > 20)
	(game-time < 30)
	(cc-players-unit-type-count any-computer-ally villager >= 3)
=>
	(generate-random-number 4) 
	(set-goal allowchats 0)
	(set-goal chatpriority1 0) 
	(set-goal chatpriority2 0) 
	(set-goal chatpriority3 0) 
	(set-goal chatpriority4 0) 
	(disable-self)
) 

(defrule
	(game-time > 30)
	(game-time < 60)
	(random-number == 1)
=>
	(set-goal chatpriority1 1) 
	(set-goal allowchats 1)
	(disable-self)
) 

(defrule
	(game-time > 35)
	(game-time < 60)
	(random-number == 2)
=>
	(set-goal chatpriority2 1) 
	(set-goal allowchats 1)
	(disable-self)
) 

(defrule
	(game-time > 40)
	(game-time < 60)
	(random-number == 3)
=>
	(set-goal chatpriority3 1) 
	(set-goal allowchats 1)
	(disable-self)
) 

(defrule
	(game-time > 45)
	(game-time < 60)
	(random-number == 4)
=>
	(set-goal chatpriority4 1) 
	(set-goal allowchats 1)
	(disable-self)
) 

(defrule
	(goal allowchats 0)
	(goal chatpriority1 1)
	(up-timer-status 32 == timer-disabled)
=>
	(enable-timer 32 120) 
) 

(defrule
	(goal allowchats 0)
	(goal chatpriority2 1)
	(up-timer-status 32 == timer-disabled)
=>
	(enable-timer 32 240) 
) 

(defrule
	(goal allowchats 0)
	(goal chatpriority3 1)
	(up-timer-status 32 == timer-disabled)
=>
	(enable-timer 32 300) 
) 

(defrule
	(goal allowchats 0)
	(goal chatpriority4 1)
	(up-timer-status 32 == timer-disabled)
=>
	(enable-timer 32 360) 
) 

(defrule
	(timer-triggered 32)
	(goal allowchats 0)
=>
	(disable-timer 32)
	(set-goal allowchats 1) 
) 

;=======Userpatch Team Positioning Check=======

#load-if-defined UP-POCKET-POSITION

(defrule
	(game-time > 420)
=>
	(set-goal fastcastle 1) 
;	(chat-local-to-self "I am in the Pocket position, so I will Fast Castle.")
	(disable-self)
) 

(defrule
	(game-time > 420) 
	(random-number >= 7) ;previously == 8
	(current-age == castle-age) 
	(goal boom 0) ;added
	(goal boomarmy 0) ;added
	(players-military-population every-enemy <= 2) 
	(game-time < 1500) 
	(or(goal nightmaredifficulty 1) ;added
	(or(difficulty <= hardest)
	(difficulty == hard)))
=>
	(set-goal fastcastle 1) 
	(set-goal boom 1)
	(set-goal boomarmy 1) ;added
;	(chat-local-to-self "I am in the Pocket position, so I will Boom.")
	(disable-self)
) 

