	(or(difficulty <= hardest)
	(or(difficulty == hard)
	(difficulty == moderate)))
	(goal buildwonder 0)
	(stone-amount > 1200)
	(current-age == imperial-age)
	(game-time > 3000)
 	(building-type-count-total castle < 6)
	(can-build castle)
=>
	(set-goal pausetsa 1)
 	(build castle)
)

