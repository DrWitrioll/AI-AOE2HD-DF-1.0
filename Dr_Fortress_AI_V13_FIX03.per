(defrule
	(game-time > 600) ;on lower difficulties give them more time before the timer starts
	(not(hold-koh-ruin))
	(or(difficulty <= hardest)
	(or(difficulty == hard)
	(difficulty == moderate)))
=>
	(up-send-scout group-type-land-explore scout-center) ;let's take the hill if we haven't already
	(disable-self)
)

(defrule
	(game-time > 1200) 
	(not(hold-koh-ruin))
	(not(players-building-type-count any-ally monument > 0)) 
	(not(players-building-type-count any-enemy monument > 0)) ;so the scout doesn't die
	;(or(difficulty == easy)
	;(difficulty == easiest))
=>
	(up-send-scout group-type-land-explore scout-center) ;let's take the hill if we haven't already
	(disable-self)
)

(defrule
	(game-time > 2400) ;added
	(or(hold-koh-ruin)
	(or(building-type-count-total monument > 0)
	(players-building-type-count any-ally monument > 0)))
=>
	(set-strategic-number sn-gather-idle-soldiers-at-center 1)
	(set-goal enabletsa 0) ;new
	(set-goal enableattacknow 0) ;new
)

