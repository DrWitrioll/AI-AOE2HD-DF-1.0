;============Taunts and Chats===============

(defrule
(game-time >= 30)
(game-time < 50)
(goal allowchats 1)
=>
(chat-to-all "39: Hello! ResonanceBot 5.1c (v2.2c) loaded. Audio Taunts must be on.")
(chat-to-all "I play Random Map with 200+ Pop, Standard Resources/Starting Age.")
;(chat-to-all "Resonance22 created me to be a flexible, challenging, and helpful AI.")
(disable-self)
)

(defrule
(game-time >= 90) ;previously 70
;(game-time < 300)
(taunt-detected any-human 205)
;(goal chatadvice 1)
(goal chatintroduction 1)
=>
(chat-to-all "Check the Steam Workshop & Resonance22 YouTube, Twitter, for updates.")
(chat-to-all "Read the FAQ file on the Steam Workshop for a full list of ResBot commands.")
(chat-to-all "'40' increases difficulty a half-step during a game, useful in 5v3 & more.")
(chat-to-all "'42' can change my build. 201 gives helpful advice. Check the FAQ file.")
(disable-timer 41)
(enable-timer 41 30)
(acknowledge-taunt this-any-human 205)
;(disable-self)
)

(defrule
(game-time >= 110) ;previously 90
;(game-time < 300)
;(goal chatadvice 1)
(goal chatintroduction 1)
(timer-triggered 41)
(or(difficulty == easiest)
(or(difficulty == easy)
(difficulty == moderate)))
=>
(chat-to-enemies "On Easiest/Standard, I will give you time to build before I attack.")
(chat-to-enemies "However, on Moderate I have fewer restrictions and I might rush.")
(chat-to-enemies "With practice and lots of villagers you will be able to beat me.")
(chat-to-enemies "You can find more information in the FAQ file on the download page.")
(enable-timer 42 30)
(disable-timer 41)
;(disable-self)
)

(defrule
(game-time >= 110) ;previously 90
;(game-time < 300)
;(goal chatadvice 1)
(timer-triggered 41)
(goal chatintroduction 1)
(or(difficulty <= hardest)
(difficulty == hard))
=>
(chat-to-enemies "On Hard/Hardest I will get small free resources every 5-10 minutes.")
(chat-to-enemies "The free resources compensate for limitations with the AI engine.")
(chat-to-enemies "It is balanced so that you can still beat me with Standard Strategy.")
(chat-to-enemies "You can find more information in the FAQ file on the download page.")
(enable-timer 42 30)
(disable-timer 41)
;(disable-self)
)

(defrule
(game-time > 15)
(game-time < 120)
(taunt-detected any-computer-enemy 39)
=>
(chat-local-to-self "ResonanceBot opponent detected.") ;new v2.2c
(set-goal resonancebot 1)
(acknowledge-taunt this-any-computer-enemy 39)
(disable-self)
)

(defrule
(game-time >= 70) ;previouisly 110
(game-time < 300)
