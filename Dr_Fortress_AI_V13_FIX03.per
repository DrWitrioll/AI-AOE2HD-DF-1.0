)

;================Unit Threat/Counters/Counter Goals===========================================
;This only applies if we have a weak economy. If we are rich then we ignore this.
;Check if enemy has counters to either our Archers, Infantry, or Cavalry units.
;Also check if we already have the appropriate counters to the enemy units.
;Then we decide whether or not to continue making Archers, Infantry, or Cavalry units. 

;new unit counter system for DLC expansions
(defrule
(or(players-unit-type-count any-enemy steppe-lancer-line >= 10) ;last khans, new DE
(or(players-unit-type-count any-enemy keshik-line >= 10) ;last khans, new DE
(or(players-unit-type-count any-enemy leitis-line >= 10) ;last khans, new DE
(or(players-unit-type-count any-enemy konnik-line >= 10) ;last khans, new DE
(or(players-unit-type-count any-enemy arambai-line >= 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy ballista-elephant-line >= 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy battle-elephant-line >= 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy elephant-archer-line >= 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy magyar-huszar-line >= 10)
(or(players-unit-type-count any-enemy boyar-line >= 10)
(or(players-unit-type-count any-enemy genitour-line >= 10) 
(players-unit-type-count any-enemy camel-archer-line >= 10))))))))))))
=>
(set-goal enemydlccavalry 1)
)

(defrule
(or(players-unit-type-count any-enemy steppe-lancer-line < 10) ;last khans, new DE
(or(players-unit-type-count any-enemy keshik-line < 10) ;last khans, new DE
(or(players-unit-type-count any-enemy leitis-line < 10) ;last khans, new DE
(or(players-unit-type-count any-enemy konnik-line < 10) ;last khans, new DE
(or(players-unit-type-count any-enemy arambai-line < 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy ballista-elephant-line < 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy battle-elephant-line < 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy elephant-archer-line < 10) ;rise of the rajas, new
(or(players-unit-type-count any-enemy magyar-huszar-line < 10)
(or(players-unit-type-count any-enemy boyar-line < 10)
(or(players-unit-type-count any-enemy genitour-line < 10) 
(players-unit-type-count any-enemy camel-archer-line < 10))))))))))))
=>
(set-goal enemydlccavalry 0)
)

(defrule
(current-age >= castle-age) 
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate)))
(unit-type-count-total villager >= 65)
(food-amount > 200)
(wood-amount > 200)
=>
(set-goal strongeconomy 1)
)

(defrule
(current-age >= castle-age) 
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate)))
(or(unit-type-count-total villager < 65)
(or(food-amount < 200)
(wood-amount < 200)))
=>
(set-goal strongeconomy 0)
)

