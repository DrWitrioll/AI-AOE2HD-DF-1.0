;=======Check If Computer Teammates=======
;If there is a computer ally, we will attack in waves.
;We will also receive increased tributes.  

(defrule
(game-time > 65)
(game-time < 70)
(cc-players-building-count any-computer-ally >= 1)
=>
;(chat-local-to-self "I have detected computer teammates. Adjusting to group tactics.")
(set-goal aiteammate 1)
)

(defrule
(game-time > 78)
(game-time < 85)
(not(cc-players-building-count any-computer-ally >= 1))
=>
;(chat-local-to-self "I do not have computer teammates. Adjusting to solo tactics.")
(set-goal aiteammate 0)
)

(defrule
(game-time > 1200)
(player-resigned any-computer-ally)
=>
(set-goal aiteammate 0)
(disable-self)
)

;=======Check If Human Teammates=======
;If there is a human ally, we prioritize saving resources and booming.
;If we have surplus resources we will either make troops or tribute it! 

(defrule
(game-time > 120)
(game-time < 130)
(not(map-type gold-rush))
(cc-players-building-count any-human-ally >= 1)
=>
;(chat-local-to-self "I have detected human teammates. Adjusting to supportive tactics.")
(set-strategic-number sn-home-exploration-time 600)
(set-goal teamplay 1)
(disable-self)
)

(defrule
(game-time > 120)
(game-time < 130)
(not(cc-players-building-count any-human-ally >= 1))
=>
;(chat-local-to-self "I do not have human teammates. Adjusting to standard tactics.")
(set-goal teamplay 0)
(disable-self)
)

(defrule
(game-time > 1200)
(player-resigned any-human-ally)
=>
(set-goal teamplay 0)
(disable-self)
)

(defrule
(game-time > 1260)
(not(cc-players-building-count any-human-ally >= 1))
=>
(set-goal teamplay 0)
(disable-self)
)

(defrule
(game-time > 1860)
(not(cc-players-building-count any-human-ally >= 1))
=>
(set-goal teamplay 0)
(disable-self)
)

;=======Check If Human Enemies=======

;If there is a human enemy, we will pick from a wide variety of strategies.
;If there are only AI players, will pick the safest strategies! 

(defrule
(game-time > 60)
(game-time < 75) ;changed from 70 v2.2c
(cc-players-building-count any-human-enemy >= 1)
=>
;(chat-local-to-self "I have detected human opponents. Adjusting to randomized tactics.")
(set-goal aibattle 0)
(disable-self)
)

(defrule
(game-time > 30)
(game-time < 45) ;changed from 40 v2.2c
(not(cc-players-building-count any-human-enemy >= 1))
=>
;(chat-local-to-self "I do not have human opponents. Adjusting to standard tactics.")
(set-goal aibattle 1)
;(set-goal fastcastle 0)
;(set-goal buildcastle 0)
;(set-goal balancedarmy 1)
(disable-self)
)

