(goal water-map 0)
(or(current-age == imperial-age)
(game-time >= 1800))
(or(players-building-type-count any-enemy bombard-tower >= 4)
(or(players-building-type-count any-enemy stone-wall-line >= 4)
(or(players-building-type-count any-enemy gate >= 2)
(players-building-type-count any-enemy castle >= 1))))
(or(unit-type-count-total battering-ram-line <= 3)
(or(unit-type-count-total bombard-cannon <= 2)
(or(unit-type-count-total mangonel-line <= 5)
(unit-type-count-total trebuchet-set <= 2))))
=>
(set-goal makesiege 1)
(disable-self)
)

(defrule
(goal water-map 0)
(or(military-population >= 40)
(game-time >= 2100))
(or(players-building-type-count any-enemy bombard-tower >= 4)
(or(players-building-type-count any-enemy stone-wall-line >= 4)
(or(players-building-type-count any-enemy gate >= 2)
(players-building-type-count any-enemy castle >= 1))))
(or(unit-type-count-total battering-ram-line <= 3)
(or(unit-type-count-total bombard-cannon <= 2)
(or(unit-type-count-total mangonel-line <= 5)
(unit-type-count-total trebuchet-set <= 2))))
=>
(set-goal makesiege 1)
(disable-self)
)

