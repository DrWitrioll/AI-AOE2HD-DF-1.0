 	(build bombard-tower)
)

(defrule
	(game-time > 900) ;used to only check for game-time and mill count
	(or(building-type-count-total market >= 1)
	(game-time > 1020))
	(or(building-type-count-total blacksmith >= 1)
	(game-time > 1020))
	(building-type-count-total mill < 2)
	(can-build mill)
=>
	(build mill)
)

