	(resource-found wood)
	(building-type-count-total mill == 1) 
	;(unit-type-count villager > 13)
	(game-time > 420) ;did we not make a Lumber Camp failsafe
	(game-time < 660)
	(building-type-count-total lumber-camp < 1) ;new v2.2b v2.2c
	(can-build lumber-camp)
=>
	(set-escrow-percentage wood 0)
	(release-escrow wood)
	(build lumber-camp)
	(disable-self)
) 

