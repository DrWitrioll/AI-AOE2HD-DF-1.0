(defrule
(game-time > 450)
;(wood-amount > 275) ;previously 300
(population-cap >= 200)
(or(game-time > 5340) ;added
(or(population-cap >= 300)
(unit-type-count-total villager <= 100)))
(building-type-count-total feitoria < 1)
(building-type-count feitoria < 1)
(can-build feitoria)
=>
(set-goal pausetsa 1)
(build feitoria)
;(disable-self) ; placeholder, can't count feitoria atm? 
)

(defrule
(game-time > 5400)
;(wood-amount >= 300)
(population-cap >= 200)
(or(population-cap >= 300)
(unit-type-count-total villager <= 102))
(building-type-count-total feitoria < 2)
(building-type-count feitoria < 2)
(can-build feitoria)
=>
(set-goal pausetsa 1)
(build feitoria)
;(disable-self) ; placeholder, can't count feitoria atm? 
)

(defrule
	(game-time > 5400)
	(population-cap == 200)
	(food-amount > 500)
	(wood-amount > 500)
	(building-type-count-total feitoria >= 1)
	(military-population >= 40)
	(unit-type-count-total villager > 100)
=>
	(delete-unit villager)
	(delete-unit fishing-ship)
)

