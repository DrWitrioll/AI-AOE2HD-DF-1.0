;========Build a Town Center=========

;The only resource cheat for lower Difficulties. 

(defrule
(game-time > 20)
(game-time < 180)
(building-type-count-total town-center == 0)
(wood-amount < 350)
(current-age == dark-age)
=>
(cc-add-resource wood 300)
(disable-self)
)

(defrule
(game-time > 600)
(game-time < 780)
(goal nomadstart 1) ;failsafe
(building-type-count-total lumber-camp == 0)
(wood-amount < 150)
(current-age == dark-age)
=>
(cc-add-resource wood 200)
(disable-self)
)

(defrule
(game-time > 40)
(game-time < 180)
(building-type-count-total town-center == 0)
(stone-amount < 100)
(current-age == dark-age)
=>
(cc-add-resource stone 100)
(disable-self)
)

(defrule 
(game-time > 3600)
(building-type-count town-center >= 1)
(building-type-count farm <= 10)
(can-build farm)
=> 
(build farm)
)

(defrule
(game-time > 1500)
(building-type-count town-center >= 1)
(building-type-count farm <= 10)
(can-build-with-escrow farm)
 =>
(build farm)
(release-escrow wood)
)

(defrule 
(game-time < 1200)
(building-type-count town-center == 0)
(can-build town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
)

(defrule 
(or(current-age >= castle-age)
(game-time > 1200))
(building-type-count town-center < 2)
(can-build-with-escrow town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
(release-escrow wood)
(release-escrow stone)
)

(defrule 
(goal boom 1)
(or(current-age >= castle-age)
(game-time > 1020))
(building-type-count town-center < 3)
(can-build-with-escrow town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
(release-escrow wood)
(release-escrow stone)
)

(defrule 
(goal boom 1)
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate)))
(wood-amount >= 400)
(unit-type-count villager <= 100)
(or(current-age >= castle-age)
(game-time > 1200))
(building-type-count town-center < 4)
(can-build-with-escrow town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
(release-escrow wood)
(release-escrow stone)
)

(defrule 
(goal boom 1)
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate)))
(wood-amount >= 400)
(unit-type-count villager <= 100)
(or(current-age >= castle-age)
(game-time > 1200))
(building-type-count town-center < 4)
(can-build town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
)

(defrule 
(or(difficulty == easy)
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate))))
(unit-type-count villager <= 100)
(or(current-age >= castle-age)
(game-time > 1200))
(building-type-count town-center < 2)
(can-build town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
)

(defrule 
(or(game-time > 1140)
(unit-type-count-total villager >= 50))
(or(building-type-count-total monastery >= 1) ;added
(or(building-type-count siege-workshop >= 1)
(goal boom 1)))
(building-type-count town-center < 3)
(can-build-with-escrow town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
(release-escrow wood)
(release-escrow stone)
)

(defrule 
(unit-type-count-total villager <= 100)
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate)))
(or(game-time > 1380) ;previously 1440
(unit-type-count-total villager >= 55))
(or(building-type-count-total siege-workshop >= 1)
(building-type-count university >= 1))
(building-type-count town-center < 4)
(can-build-with-escrow town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
(release-escrow wood)
(release-escrow stone)
)

(defrule 
(unit-type-count-total villager <= 60) 
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate)))
(game-time > 1320)
(game-time < 1800)
(military-population >= 25)
(building-type-count town-center < 4)
(can-build-with-escrow town-center)
=> 
(set-goal pausetsa 1)
(build town-center)
(release-escrow wood)
(release-escrow stone)
)

(defrule 
(unit-type-count-total villager <= 60) 
(goal createarmy 1)
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate)))
(game-time > 1320)
(game-time < 1800)
(military-population >= 30)
(building-type-count town-center < 4)
=> 
(enable-timer 21 120)
(set-goal createarmy 0)
