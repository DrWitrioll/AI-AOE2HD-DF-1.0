;=======Build A Wonder Or Kill A Wonder===========================

#load-if-not-defined REGICIDE
#load-if-not-defined KING-OF-THE-HILL
#load-if-defined VICTORY-STANDARD

;Timer 28

(defrule
	(game-time > 2)
=>
	(set-goal buildwonder 0) 
	(set-goal wonderrush 0)
	(disable-self)
) 

(defrule
	(timer-triggered 28)
	(game-time < 3600)
	(goal buildwonder 1)
	(building-type-count wonder < 1)
=>
	(disable-timer 28)
	(enable-timer 28 90)
	(set-goal createarmy 0)
	(set-escrow-percentage wood 60)
	(set-escrow-percentage gold 90)
	(set-escrow-percentage stone 100)
) 

(defrule
	(goal buildwonder 1)
	(building-type-count wonder < 1)
	(or(difficulty <= hardest)
	(difficulty == hard))
	(gold-amount > 800)
	(stone-amount > 800)
	(wood-amount > 800)
=>
	(cc-add-resource wood 500)
	(cc-add-resource gold 500)
	(cc-add-resource stone 500)
	(disable-self)
) 

(defrule
	(timer-triggered 28)
	(or(building-type-count wonder == 1)
	(goal buildwonder 0))
=>
	(disable-timer 28)
	(set-goal buildwonder 0)
	(set-goal wonderrush 0)
	(set-goal createarmy 1)
	(set-escrow-percentage wood 0)
	(set-escrow-percentage gold 30)
	(set-escrow-percentage stone 0)
) 

(defrule
(current-age == imperial-age)
(game-time > 1800)
(game-time < 3600)
(goal wonderrush 1)
(or(unit-type-count-total villager >= 30)
(goal water-map 1))
(building-type-count wonder < 1)
=>
(chat-to-allies "26: I am going to start saving resources for a Wonder.")
(chat-to-allies "Feel free to tribute me to help me build it sooner.")
(set-strategic-number sn-food-gatherer-percentage 15)
(set-strategic-number sn-wood-gatherer-percentage 45)
(set-strategic-number sn-gold-gatherer-percentage 25)
(set-strategic-number sn-stone-gatherer-percentage 15)
(set-escrow-percentage wood 60)
(set-escrow-percentage gold 80)
(set-escrow-percentage stone 100)
(set-goal buildwonder 1)
(disable-timer 28)
(enable-timer 28 120)
(disable-self)
)

