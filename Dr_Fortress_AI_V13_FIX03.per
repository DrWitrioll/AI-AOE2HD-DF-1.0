#load-if-defined DIFFICULTY-MODERATE

(defrule
(game-time > 1200)
(game-time < 1260)
(cc-players-building-count any-human >= 1)
(goal dynamicdifficulty 1)
(goal moderatecheats 0)
(difficulty == moderate)
(players-military-population every-enemy <= 10) ;new v2.2b v2.2c added
(unit-type-count-total villager >= 27) ;new v2.2b v2.2c previously 27
(cc-players-unit-type-count any-human villager < 31) ;new v2.2b v2.2c previously 28
=>
(set-goal scalevillagers 1)
;(chat-local-to-self "Scaling villager count to match human players...")
(disable-self)
)

(defrule
(game-time > 1500)
(game-time < 1560)
(cc-players-building-count any-human >= 1)
(goal dynamicdifficulty 1)
(goal moderatecheats 0)
(difficulty == moderate)
(players-military-population every-enemy <= 12) ;new v2.2b v2.2c added
(unit-type-count-total villager >= 32) ;new v2.2b v2.2c previously and currently still 32
(cc-players-unit-type-count any-human villager < 36) ;new v2.2b v2.2c previously 33
=>
(set-goal scalevillagers 1)
;(chat-local-to-self "Scaling villager count to match human players...")
(disable-self)
)

(defrule
(or(game-time > 1800)
(cc-players-unit-type-count any-human villager > 40))
(difficulty == moderate)
=>
(set-goal scalevillagers 0)
;(chat-local-to-self "Halting scaling villager count to match human players...")
(disable-self)
)

(defrule
(game-time > 1560) 
(or(goal dynamicdifficulty 0)
(cc-players-unit-type-count any-human villager > 40))
(difficulty == moderate)
=>
(set-goal scalevillagers 0)
;(chat-local-to-self "Halting scaling villager count to match human players...")
(disable-self)
)

