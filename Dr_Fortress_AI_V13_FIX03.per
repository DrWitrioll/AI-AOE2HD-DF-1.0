;===================Advice for Weaker Opponents================
;We only give advice if the enemy is falling behind for some reason. 
;Advice is currently enabled

(defrule
(goal chatadvice 1)
(goal chatintroduction 1)
(goal aibattle 0)
(goal nomadstart 0)
(or(goal aiteammate 0)
(random-number >= 5))
(game-time > 420)
(game-time < 900)
(unit-type-count-total villager >= 12)
(cc-players-unit-type-count any-human villager <= 14)
=>
(chat-to-all "Try to minimize the amount of time that your Town Center is idle.")
(chat-to-all "Your Town Center should always be creating villagers or researching.")
(chat-to-all "Having around 100 villagers will help you create a large army faster.")
(chat-to-all "While are still learning, 50 is a good goal. Work your way up over time.")
(set-goal allowchats 0)
(disable-self)
)

(defrule
(goal chatadvice 1)
(goal chatintroduction 1)
(goal aibattle 0)
(or(goal aiteammate 0)
(random-number <= 4))
(game-time > 900)
(game-time < 1500)
(goal nomadstart 0)
(or(unit-type-count-total villager >= 25)
(difficulty == easiest))
(cc-players-unit-type-count any-human villager <= 25)
=>
(chat-to-all "Remember to keep making villagers unless you are advancing Ages.")
(chat-to-all "You should have at least 25 villagers at this point in the game.")
(chat-to-all "Having around 100 villagers will help you create a large army faster.")
(chat-to-all "While are still learning, 50 is a good goal. Work your way up over time.")
(set-goal allowchats 0)
(disable-self)
)

