;===============Strategic Numbers=======================


(defrule
(goal water-map 0)
=>
(set-strategic-number sn-minimum-town-size 1)
)

(defrule
	(true)								
=>
	(set-strategic-number sn-maximum-town-size 10)
	(set-strategic-number sn-attack-winning-player 1) 			
	(set-strategic-number sn-attack-winning-player-factor 30)
	(set-strategic-number sn-attack-intelligence 1) 			
	(set-strategic-number sn-group-form-distance 70)			
	(set-strategic-number sn-attack-group-gather-spacing 0) 		
	(set-strategic-number sn-task-ungrouped-soldiers 0) 	
	(disable-self)
)


(defrule
	(game-time > 720)
	(game-time < 1260)	
	(goal swaptargeting 1)
	(random-number >= 5)
=>
	(set-strategic-number sn-attack-winning-player 1) 		
	(disable-self)
)

(defrule
	(game-time > 720)
	(game-time < 1260)	
	(goal swaptargeting 1)
	(random-number <= 4)
=>
	(set-strategic-number sn-attack-winning-player 0) 			
	(disable-self)
)

(defrule
	(game-time > 1260)
	(game-time < 1500)	
	(goal swaptargeting 1)
	(random-number <= 4)
=>
	(set-strategic-number sn-attack-winning-player 1) 	
	(disable-self)
)

(defrule
	(game-time > 1260)
	(game-time < 1500)	
	(goal swaptargeting 1)
	(random-number >= 5)
=>
	(set-strategic-number sn-attack-winning-player 0) 		
	(disable-self)
)

(defrule
	(goal chatpriority1 1)
	(goal swaptargeting 1)
	(game-time > 1265)
	(game-time < 1500)	
=>
	(set-strategic-number sn-attack-winning-player 0) 		
	(disable-self)
)

(defrule
	(goal chatpriority1 1)
	(goal swaptargeting 1)
	(game-time > 1505)
	(game-time < 1800)	
=>
	(set-strategic-number sn-attack-winning-player 1) 		
	(disable-self)
)

(defrule
	(game-time > 1500)
	(game-time < 1800)	
	(goal swaptargeting 1)
	(random-number >= 5)
=>
	(set-strategic-number sn-attack-winning-player 1) 		
	(disable-self)
)

(defrule
	(game-time > 1500)
	(game-time < 1800)	
	(goal swaptargeting 1)
	(random-number <= 4)
=>
	(set-strategic-number sn-attack-winning-player 0) 		
	(disable-self)
)

(defrule
	(game-time > 1805)
	(game-time < 2100)	
	(goal swaptargeting 1)
	(random-number <= 7)
	(random-number >= 2)
	(or(civilian-population <= 70)
	(difficulty == easy))
=>
	(set-strategic-number sn-attack-winning-player 0) 		
	(disable-self)
)

(defrule
	(game-time > 2105)
	(game-time < 2400)	
	(goal swaptargeting 1)
	(random-number <= 6)
	(random-number >= 3)
	(or(civilian-population <= 70)
	(difficulty == easy))
=>
	(set-strategic-number sn-attack-winning-player 1) 		
	(disable-self)
)

(defrule
	(game-time > 1800)
	(game-time < 2100)
	(goal swaptargeting 1)
	(not(difficulty == easiest))
