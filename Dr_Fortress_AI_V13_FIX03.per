;============Error Notifications=========================

(defrule
(game-time >= 240)
(game-time <= 600)
(goal nomadstart 1)
(building-type-count-total town-center < 1)
=>
(chat-to-all "39: ERROR: ResonanceBot 5.1c cannot build a Town Center.")
(chat-to-all "Sometimes all AIs can fail on regular Nomad if the map is odd.")
(chat-to-all "You can try again with a fresh map or play Land Nomad instead.")
(resign)
)

(defrule
(game-time >= 360)
(game-time <= 900)
(goal nomadstart 0)
(unit-type-count-total villager <= 7)
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate))) ;new v2.2b v2.2c, changed error text
=>
(chat-to-all "39: ERROR: ResonanceBot 5.1c has not loaded correctly.")
(chat-to-all "To get the best experience, make sure to use the newest version.")
(chat-to-all "Please try again with a fresh map. An AI Engine bug occurred!")
(disable-self)
)

(defrule
(game-time >= 660)
(game-time <= 900)
(goal nomadstart 0)
(wood-amount <= 20)
(building-type-count mill > 1)
(building-type-count lumber-camp < 1) ;new v2.2b v2.2c
=>
(chat-to-all "39: ERROR: ResonanceBot 5.1c has not loaded correctly.")
(chat-to-all "To get the best experience, make sure to use the newest version.")
(chat-to-all "Please try again with a fresh map. An AI Engine bug occurred!")
(disable-self)
)

(defrule
(game-time >= 150)
(game-time <= 210)
(or(death-match-game)
(or(current-age >= feudal-age) ;changed from starting-age
(gold-amount >= 200)))
=>
(chat-to-all "39: ERROR: I can only play on Dark Age start with Standard resources!")
(chat-to-all "The only game types I can play are Random Map and Regicide.")
(chat-to-all "To get the best experience, make sure to use the newest version.")
(disable-self)
)

(defrule
(game-time >= 160)
(population-cap <= 125)
;(or(difficulty <= hardest)
;(or(difficulty == hard)
;(difficulty == moderate)))
=>
(chat-to-all "39: ERROR: The population setting is too low for me to play optimally.")
(chat-to-all "I play best on at least 200 population and with standard settings.")
(disable-self)
)

(defrule
(game-time >= 175)
(population-cap <= 50)
;(or(difficulty <= hardest)
;(or(difficulty == hard)
;(difficulty == moderate)))
=>
(chat-to-all "39: ERROR: I cannot play with the Population set to 50 or below!")
(chat-to-all "I play best on at least 200 population and with standard settings.")
(resign)
)

;============AI Options and Features, Toggle On and Off============
;Chat taunts to Enable or Disable various Features of the AI
;Uses Timers 11 up to Timers 27
;Actually only uses Timers 22,23,24 now. 
;chattaunts - toggleoptions1 
;chatadvice - toggleoptions2 
;earlyresign - toggleoptions3 
;dynamicdifficulty - toggleoptions4 
;fastcastle - togglefastcastle
;boom -toggleboom

(defrule
(game-time > 1)
=>     
(set-goal toggleoptions1 0)
(set-goal toggleoptions2 0)
(set-goal toggleoptions3 0)
(set-goal toggleoptions4 0)
(set-goal begintoggleoptions 0)
(set-goal chattaunts 1)
(set-goal chatadvice 0) ;previously 1
(set-goal earlyresign 1)
(set-goal dynamicdifficulty 1)
(set-goal specialcommands 0)
(set-goal disablecommands 1)
(disable-self)
)

(defrule
(taunt-detected any-human 125)
(game-time > 5)
=>     
(chat-to-all "I will now ignore all custom commands from all players.")
(set-goal specialcommands 0)
(set-goal disablecommands 1)
(acknowledge-taunt this-any-human 125)
)

(defrule
(taunt-detected any-human 42)
(game-time > 120)
(goal specialcommands 0)
(goal disablecommands 0)
=>     
(chat-to-all "Send me Taunts 32, 33, 34, 35, or 37 via the Chat Menu button.")
(chat-to-all "Taunt 42 allows you to change my strategy regardless of teams.")
(chat-to-all "See the FAQ file on the download page for more information.")
(set-goal specialcommands 1)
(acknowledge-taunt this-any-human 42)
)

(defrule
(taunt-detected any-human 42)
(game-time > 120)
(goal specialcommands 1)
(goal disablecommands 0)
=>     
(chat-to-all "My strategy will not be changed through sending additional Taunts.")
(chat-to-all "I will ignore these taunts unless you chat me 42 again later.")
(set-goal specialcommands 0)
(acknowledge-taunt this-any-human 42)
)

(defrule
(timer-triggered 22)
;(goal specialcommands 1)
=>     
(chat-to-all "I have now changed my strategy based on the Taunt that you sent me.")
(disable-timer 22)
)

(defrule
(timer-triggered 23)
;(goal specialcommands 1)
=>     
(chat-to-all "I cannot change my strategy based on the Taunt that you sent me.")
(disable-timer 23)
)

