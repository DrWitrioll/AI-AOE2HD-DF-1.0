; ============================================================================
; DR FORTRESS V13 - DEFENSIVE / MILITARY / SIEGE DOCTRINE
; ============================================================================

(defconst df13-core 162)
(defconst df13-pop-profile 163)        ;1=125, 2=150, 3=200+
(defconst df13-defense-state 164)      ;0=safe, 1=confirmed pressure
(defconst df13-counterattack 165)      ;0=off, 1=reform/counter window
(defconst df13-threat-archer 166)
(defconst df13-threat-cavalry 167)
(defconst df13-threat-infantry 168)
(defconst df13-threat-siege 169)
(defconst df13-enemy-fortified 170)
(defconst df13-recovery 171)
(defconst df13-siege-ready 172)
(defconst df13-fortress-stage 173)
(defconst df13-observation-tier 174)
(defconst df13-castle-opportunity 175)
(defconst df13-assault-ready 176)
(defconst df13-aftershock 177)
(defconst df13-outpost 598)

; ---------------------------------------------------------------------------
; Initialization.  Deliberately does NOT touch civilian worker assignment,
; resource percentages, hunting or age-up priorities.
; ---------------------------------------------------------------------------
(defrule
    (goal df13-core 0)
=>
    (set-goal df13-core 1)
    (set-goal df13-pop-profile 2)
    (set-goal df13-defense-state 0)
    (set-goal df13-counterattack 0)
    (set-goal df13-threat-archer 0)
    (set-goal df13-threat-cavalry 0)
    (set-goal df13-threat-infantry 0)
    (set-goal df13-threat-siege 0)
    (set-goal df13-enemy-fortified 0)
    (set-goal df13-recovery 0)
    (set-goal df13-siege-ready 0)
    (set-goal df13-fortress-stage 0)
    (set-goal df13-observation-tier 0)
    (set-goal df13-castle-opportunity 0)
    (set-goal df13-assault-ready 0)
)

; Population profiles.
(defrule
    (population-cap <= 125)
=>
    (set-goal df13-pop-profile 1)
)
(defrule
    (population-cap > 125)
    (population-cap <= 150)
=>
    (set-goal df13-pop-profile 2)
)
(defrule
    (population-cap > 150)
=>
    (set-goal df13-pop-profile 3)
)

; ---------------------------------------------------------------------------
; Preserve Resonance formation behaviour globally.  These are the same family
; of strategic numbers that make Resonance move soldiers as coherent groups.
; ---------------------------------------------------------------------------
(defrule
    (true)
=>
    (set-strategic-number sn-group-form-distance 70)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-group-leader-defense-distance 2)
)

; ---------------------------------------------------------------------------
; Threat memory - inspired by Jester's confirmed town-under-attack state and
; Fortress threat layers.  Timer 44/45 are unused by ResonanceBot 5-1c.
; ---------------------------------------------------------------------------
(defrule
    (goal df13-defense-state 0)
    (town-under-attack)
    (players-military-population any-enemy > 1)
=>
    (set-goal df13-defense-state 1)
    (set-goal df13-counterattack 0)
    (disable-timer 44)
    (enable-timer 44 35)
)

(defrule
    (goal df13-defense-state 1)
    (timer-triggered 44)
    (town-under-attack)
=>
    (disable-timer 44)
    (enable-timer 44 35)
)

(defrule
    (goal df13-defense-state 1)
    (timer-triggered 44)
    (not (town-under-attack))
=>
    (disable-timer 44)
    (set-goal df13-defense-state 0)
    (set-goal df13-counterattack 1)
    (set-goal df13-aftershock 1)
    (disable-timer 45)
    (enable-timer 45 75)
)

(defrule
    (goal df13-counterattack 1)
    (timer-triggered 45)
=>
    (disable-timer 45)
    (set-goal df13-counterattack 0)
    (set-goal df13-aftershock 0)
)

; Threat typing.
(defrule
    (or (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3))
=>
    (set-goal df13-threat-archer 1)
)
(defrule
    (or (players-unit-type-count any-enemy scout-cavalry-line >= 3)
        (players-unit-type-count any-enemy knight-line >= 3))
=>
    (set-goal df13-threat-cavalry 1)
)
(defrule
    (or (players-unit-type-count any-enemy militiaman-line >= 5)
        (players-unit-type-count any-enemy spearman-line >= 5))
=>
    (set-goal df13-threat-infantry 1)
)
(defrule
    (or (players-unit-type-count any-enemy battering-ram-line >= 1)
        (or (players-unit-type-count any-enemy mangonel-line >= 1)
            (players-unit-type-count any-enemy scorpion-line >= 2)))
=>
    (set-goal df13-threat-siege 1)
)

; Clear remembered composition after confirmed pressure is gone and the
; relevant enemy mass has disappeared.
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy archer-line < 2)
    (players-unit-type-count any-enemy cavalry-archer-line < 2)
=>
    (set-goal df13-threat-archer 0)
)
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy scout-cavalry-line < 2)
    (players-unit-type-count any-enemy knight-line < 2)
=>
    (set-goal df13-threat-cavalry 0)
)
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy militiaman-line < 3)
    (players-unit-type-count any-enemy spearman-line < 3)
=>
    (set-goal df13-threat-infantry 0)
)
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy battering-ram-line < 1)
    (players-unit-type-count any-enemy mangonel-line < 1)
    (players-unit-type-count any-enemy scorpion-line < 1)
=>
    (set-goal df13-threat-siege 0)
)

; Fortification memory. Once the enemy shows a serious fixed defence, keep the
; memory - siege remains strategically relevant for the rest of the game.
(defrule
    (or (players-building-type-count any-enemy castle >= 1)
        (or (players-building-type-count any-enemy stone-wall-line >= 5)
            (players-building-type-count any-enemy watch-tower-line >= 2)))
=>
    (set-goal df13-enemy-fortified 1)
)

; ---------------------------------------------------------------------------
; Defensive formation state.  No global retreat on town-under-attack.
; Villager garrison remains enabled and civilian militia is disabled.
; ---------------------------------------------------------------------------
(defrule
    (goal df13-defense-state 1)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 5)
    (set-strategic-number sn-maximum-defend-group-size 24)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 45)
    (set-strategic-number sn-number-civilian-militia 0)
    (set-strategic-number sn-disable-villager-garrison 0)
)

; Concentrated counterattack after a defended assault.  Two coherent groups,
; not one-unit trickles.
(defrule
    (goal df13-counterattack 1)
    (goal df13-recovery 0)
    (military-population >= 12)
=>
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-percent-attack-soldiers 70)
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 28)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 16)
    (set-strategic-number sn-percent-enemy-sighted-response 65)
    (set-strategic-number sn-enemy-sighted-response-distance 30)
)

; ---------------------------------------------------------------------------
; Recovery mode.  Economy still remains Resonance-owned; this layer only stops
; suicidal attacks and reconstructs indispensable infrastructure when possible.
; ---------------------------------------------------------------------------
(defrule
    (game-time > 900)
    (current-age >= castle-age)
    (or (building-type-count-total town-center < 1)
        (unit-type-count-total villager < 24))
=>
    (set-goal df13-recovery 1)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total town-center >= 1)
    (unit-type-count-total villager >= 32)
=>
    (set-goal df13-recovery 0)
)
(defrule
    (goal df13-recovery 1)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 20)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total town-center < 1)
    (up-pending-objects c: town-center < 1)
    (can-build town-center)
=>
    (build town-center)
)
(defrule
    (goal df13-recovery 1)
    (housing-headroom < 4)
    (up-pending-objects c: house < 1)
    (can-build house)
=>
    (build house)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total lumber-camp < 1)
    (up-pending-objects c: lumber-camp < 1)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total mill < 1)
    (up-pending-objects c: mill < 1)
    (can-build mill)
=>
    (build mill)
)

; ---------------------------------------------------------------------------
; Fortress footprint.  Larger than Resonance default so nearby resources are
; more likely to end up inside the defensive perimeter.
; ---------------------------------------------------------------------------
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
=>
    (set-strategic-number sn-minimum-town-size 8)
    (set-strategic-number sn-maximum-town-size 17)
    (set-strategic-number sn-safe-town-size 14)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (building-type-count-total town-center < 2)
=>
    (set-strategic-number sn-minimum-town-size 9)
    (set-strategic-number sn-maximum-town-size 21)
    (set-strategic-number sn-safe-town-size 17)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (building-type-count-total town-center >= 2)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 27)
    (set-strategic-number sn-safe-town-size 21)
)
(defrule
    (difficulty == hardest)
    (current-age == imperial-age)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 31)
    (set-strategic-number sn-safe-town-size 24)
)

; Inner ring - Feudal palisade after the normal Resonance transition buildings
; exist.  This avoids stealing the opening wood that makes Resonance stable.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (building-type-count-total market >= 1)
    (building-type-count-total blacksmith >= 1)
    (wall-completed-percentage 1 < 70)
    (wood-amount > 210)
    (up-pending-objects c: palisade-wall < 1)
    (not (town-under-attack))
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

; Castle Age may finish/replace the inner ring with stone whenever the ordinary
; economy already has spare stone.  No Castle or wall stone escrow exists.
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 100)
    (stone-amount > 280)
    (not (town-under-attack))
    (can-build-wall 1 stone-wall-line)
=>
    (build-wall 1 stone-wall-line)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 100)
    (wood-amount > 300)
    (stone-amount <= 280)
    (not (town-under-attack))
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

; Outer stone ring is opportunistic and resource-safe.
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (wall-completed-percentage 1 >= 70)
    (wall-completed-percentage 2 < 90)
    (stone-amount > 360)
    (not (town-under-attack))
    (can-build-wall 2 stone-wall-line)
=>
    (build-wall 2 stone-wall-line)
)

; Controlled gates.
(defrule
    (current-age >= feudal-age)
    (wall-completed-percentage 1 >= 25)
    (building-type-count-total gate < 1)
    (not (town-under-attack))
    (can-build-gate 1)
=>
    (build-gate 1)
)
(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 2 >= 55)
    (building-type-count-total gate < 2)
    (not (town-under-attack))
    (can-build-gate 2)
=>
    (build-gate 2)
)

; ---------------------------------------------------------------------------
; Observation network.  Local eyes first, forward eyes only after the economy
; is developed.  Targets: 2 Dark, 4 Feudal, 8 Castle, 15 Imperial on Hardest.
; ---------------------------------------------------------------------------
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 330)
    (building-type-count-total df13-outpost < 1)
    (wood-amount > 120)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 480)
    (building-type-count-total df13-outpost < 2)
    (wood-amount > 150)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (building-type-count-total df13-outpost < 4)
    (wood-amount > 170)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build-forward df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (building-type-count-total df13-outpost < 8)
    (wood-amount > 210)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build-forward df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == imperial-age)
    (building-type-count-total df13-outpost < 15)
    (wood-amount > 260)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build-forward df13-outpost)
)

; Combat towers face confirmed danger but never consume the opening economy.
(defrule
    (difficulty == hardest)
    (current-age >= feudal-age)
    (goal df13-defense-state 1)
    (building-type-count-total watch-tower-line < 2)
    (stone-amount > 220)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build-forward watch-tower-line)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal df13-enemy-fortified 1)
    (building-type-count-total watch-tower-line < 5)
    (stone-amount > 320)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build-forward watch-tower-line)
)

; ---------------------------------------------------------------------------
; Opportunistic Castles.  No dedicated saving / stone escrow.  'can-build'
; itself is the affordability test.
; ---------------------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (goal df13-recovery 0)
    (not (town-under-attack))
    (goal df13-aftershock 1)
    (can-build castle)
=>
    (set-goal df13-castle-opportunity 1)
    (build-forward castle)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (building-type-count-total town-center >= 2)
    (wall-completed-percentage 1 >= 50)
    (goal df13-recovery 0)
    (not (town-under-attack))
    (can-build castle)
=>
    (set-goal df13-castle-opportunity 1)
    (build castle)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (building-type-count-total castle < 2)
    (building-type-count-total town-center >= 2)
    (goal df13-enemy-fortified 1)
    (goal df13-recovery 0)
    (not (town-under-attack))
    (can-build castle)
=>
    (build-forward castle)
)

; ---------------------------------------------------------------------------
; Civilization-aware production infrastructure.  ResonanceBot already selects
; makecavalry/makearchers/makeinfantry/makesiege by civ and strategy, so V13
; uses those proven goals instead of duplicating a second civ classifier.
; ---------------------------------------------------------------------------
(defrule
    (current-age == feudal-age)
    (goal makecavalry 1)
    (building-type-count-total stable < 1)
    (wood-amount > 150)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (current-age == feudal-age)
    (goal makearchers 1)
    (building-type-count-total archery-range < 1)
    (wood-amount > 150)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= feudal-age)
    (goal makeinfantry 1)
    (building-type-count-total barracks < 2)
    (wood-amount > 170)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

; Scale production for the three main population profiles.
(defrule
    (current-age >= castle-age)
    (goal makecavalry 1)
    (goal df13-pop-profile 1)
    (building-type-count-total stable < 2)
    (wood-amount > 260)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (current-age >= castle-age)
    (goal makecavalry 1)
    (goal df13-pop-profile 2)
    (building-type-count-total stable < 3)
    (wood-amount > 320)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (current-age >= castle-age)
    (goal makecavalry 1)
    (goal df13-pop-profile 3)
    (building-type-count-total stable < 4)
    (wood-amount > 380)
    (up-pending-objects c: stable < 1)
    (can-build stable)
=>
    (build stable)
)
(defrule
    (current-age >= castle-age)
    (goal makearchers 1)
    (goal df13-pop-profile 1)
    (building-type-count-total archery-range < 2)
    (wood-amount > 260)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= castle-age)
    (goal makearchers 1)
    (goal df13-pop-profile 2)
    (building-type-count-total archery-range < 3)
    (wood-amount > 320)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= castle-age)
    (goal makearchers 1)
    (goal df13-pop-profile 3)
    (building-type-count-total archery-range < 4)
    (wood-amount > 380)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
=>
    (build archery-range)
)
(defrule
    (current-age >= castle-age)
    (goal makeinfantry 1)
    (goal df13-pop-profile 1)
    (building-type-count-total barracks < 2)
    (wood-amount > 240)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (current-age >= castle-age)
    (goal makeinfantry 1)
    (goal df13-pop-profile 2)
    (building-type-count-total barracks < 3)
    (wood-amount > 300)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)
(defrule
    (current-age >= castle-age)
    (goal makeinfantry 1)
    (goal df13-pop-profile 3)
    (building-type-count-total barracks < 4)
    (wood-amount > 360)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

; ---------------------------------------------------------------------------
; Threat counters and cavalry reserve.
; ---------------------------------------------------------------------------
(defrule
    (current-age == feudal-age)
    (goal makecavalry 1)
    (unit-type-count-total scout-cavalry-line < 3)
    (food-amount > 120)
    (can-train scout-cavalry-line)
=>
    (train scout-cavalry-line)
)
(defrule
    (current-age >= castle-age)
    (goal makecavalry 1)
    (unit-type-count-total knight-line < 8)
    (food-amount > 220)
    (gold-amount > 160)
    (can-train knight-line)
=>
    (train knight-line)
)
(defrule
    (current-age >= feudal-age)
    (goal df13-threat-cavalry 1)
    (unit-type-count-total spearman-line < 8)
    (food-amount > 100)
    (can-train spearman-line)
=>
    (train spearman-line)
)
(defrule
    (current-age >= feudal-age)
    (goal df13-threat-archer 1)
    (unit-type-count-total skirmisher-line < 10)
    (food-amount > 100)
    (wood-amount > 100)
    (can-train skirmisher-line)
=>
    (train skirmisher-line)
)
(defrule
    (current-age >= feudal-age)
    (goal df13-threat-infantry 1)
    (unit-type-count-total archer-line < 10)
    (wood-amount > 120)
    (gold-amount > 80)
    (can-train archer-line)
=>
    (train archer-line)
)

; ---------------------------------------------------------------------------
; Siege doctrine and packages.
; ---------------------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (or (goal makesiege 1)
        (or (goal df13-enemy-fortified 1) (goal df13-threat-siege 1)))
    (building-type-count-total siege-workshop < 1)
    (wood-amount > 260)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)
(defrule
    (current-age >= castle-age)
    (goal df13-pop-profile 2)
    (goal df13-enemy-fortified 1)
    (building-type-count-total siege-workshop < 2)
    (wood-amount > 420)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)
(defrule
    (current-age >= castle-age)
    (goal df13-pop-profile 3)
    (goal df13-enemy-fortified 1)
    (building-type-count-total siege-workshop < 3)
    (wood-amount > 500)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)

; Rams for fixed defences.
(defrule
    (current-age >= castle-age)
    (goal df13-enemy-fortified 1)
    (unit-type-count-total battering-ram-line < 3)
    (wood-amount > 220)
    (gold-amount > 120)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)
; Mangonels against ranged masses.
(defrule
    (current-age >= castle-age)
    (goal df13-threat-archer 1)
    (unit-type-count-total mangonel-line < 3)
    (wood-amount > 220)
    (gold-amount > 150)
    (can-train mangonel-line)
=>
    (train mangonel-line)
)
; Scorpions against massed infantry.
(defrule
    (current-age >= castle-age)
    (goal df13-threat-infantry 1)
    (unit-type-count-total scorpion-line < 4)
    (wood-amount > 220)
    (gold-amount > 120)
    (can-train scorpion-line)
=>
    (train scorpion-line)
)

; Siege package readiness.
(defrule
    (current-age >= castle-age)
    (or (unit-type-count-total battering-ram-line >= 2)
        (or (unit-type-count-total mangonel-line >= 2)
            (unit-type-count-total scorpion-line >= 3)))
=>
    (set-goal df13-siege-ready 1)
)
(defrule
    (current-age >= castle-age)
    (unit-type-count-total battering-ram-line < 2)
    (unit-type-count-total mangonel-line < 2)
    (unit-type-count-total scorpion-line < 3)
=>
    (set-goal df13-siege-ready 0)
)

; Do not throw ordinary troops alone into a fortified enemy.  When a siege
; package exists, form a heavier assault group.
(defrule
    (goal df13-enemy-fortified 1)
    (goal df13-siege-ready 0)
    (goal df13-defense-state 0)
=>
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
)
(defrule
    (goal df13-enemy-fortified 1)
    (goal df13-siege-ready 1)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (military-population >= 18)
=>
    (set-goal df13-assault-ready 1)
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 32)
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-percent-attack-soldiers 75)
)
(defrule
    (goal df13-enemy-fortified 0)
=>
    (set-goal df13-assault-ready 0)
)

; ---------------------------------------------------------------------------
; End V13 Fortress doctrine.
; ---------------------------------------------------------------------------
