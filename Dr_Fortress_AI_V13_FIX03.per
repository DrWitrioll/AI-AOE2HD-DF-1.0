) 

(defconst enabletsa 91) ;for land maps
(defconst enableattacknow 92) ;for water maps
(defconst pausetsa 93) ;for when building, reset town size to default for 3 sec
(defconst bigtownsize 94) ;30
(defconst medtownsize 95) ;22
(defconst smalltownsize 95) ;15

(defrule
 	(housing-headroom <= 5)
	(or(building-type-count-total town-center >= 1)
	(game-time > 30))
	(population-headroom > 0)
 	(can-build house)
 =>
	(set-goal pausetsa 1)
	(build house)
)

(defrule
 	(housing-headroom <= 5)
	(or(building-type-count-total town-center >= 1)
	(game-time > 30))
	(population-headroom > 0)
 	(can-build-with-escrow house)
 =>
	(set-goal pausetsa 1)
	(build house)
	(release-escrow wood)
)

(defrule
	(wood-amount >= 600)
	(game-time > 900)
	(population-headroom > 0)
	(building-type-count house <= 15)
	(can-build house)
=>
	(set-goal pausetsa 1)
	(build house)
)

(defrule
	(wood-amount >= 600)
	(game-time > 1200)
	(population-headroom > 0)
	(building-type-count house <= 20)
	(can-build house)
=>
	(set-goal pausetsa 1)
	(build house)
)

(defrule
 	(unit-type-count-total villager < 15)
	(game-time < 5) ;new v2.2c
	(cc-players-building-type-count every-enemy town-center >= 1) ;new Patch 5.8 v2.1g
 	(can-train villager)
=>
 	(train villager)
	(disable-self) ;only occurs once
)

