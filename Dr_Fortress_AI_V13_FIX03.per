;(true)
;=>
;(set-goal wall BUILD-WALL)
;(disable-self)
;)

(defrule
(goal water-map 0)
(not(map-type black-forest))
(not(map-type fortress))
(not(map-size small))
(not(map-size tiny))
(not(map-size medium))
=>
(enable-wall-placement 2)
;(disable-self)
)

(defrule
(not(map-size small))
(not(map-size tiny))
(goal wall BUILD-WALL)
(game-time > 300)
(can-afford-complete-wall 2 stone-wall-line) ;build wall build stone
=>
(build-wall 2 stone-wall-line)
)

(defrule
(not(map-size small))
(not(map-size tiny))
(game-time > 300)
(goal wall BUILD-WALL)
(building-type-count-total gate < 20)
(can-build-gate 2)
=>
(build-gate 2)
)

(defrule
(not(map-size small))
(not(map-size tiny))
(goal wall BUILD-WALL)
(wall-completed-percentage 2 == 100)
=>
(set-goal wall DONT-BUILD-WALL)
)

;small
(defrule
(or(map-size small)
(map-size tiny))
(goal wall BUILD-WALL)
(wall-completed-percentage 1 == 100)
(starting-age == imperial-age)
=>
(set-goal wall DONT-BUILD-WALL)
)

;==========Resource Cheating=========================
;Only on Hard and Hardest. Moderate must be toggled on with human permission.
;For those difficulties, tribute is received every 5 minutes until 40 minutes.
;Then, tributes are received every 10 minutes.
;All tributes before 50 minutes are increased or decreased based on the enemy's skill.
;The tributes slightly increase in size over time before dropping. 
;The tributes stop increasing at 50 minutes for 1v1s, and 60 minutes for team games. 
;The tributes are small enough that the AI still depends on its economy.  

#load-if-defined DIFFICULTY-HARD

(defrule
(difficulty == hard)
(goal monkrush 1)
;(goal fastcastle 1)
(goal boom 0)
(current-age == castle-age)
(game-time >= 930)
(game-time <= 1290) ;v2.2c
=>
(cc-add-resource gold 450) ;previously 500, new ;v2.2c
(cc-add-resource wood 200) ;previously 200, new ;v2.2c beta
(disable-self)
)

#end-if

