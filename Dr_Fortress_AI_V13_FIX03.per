=>
(set-goal water-map 0)
(disable-self)
)

(defrule
;(game-time s:> sn-home-exploration-time) ;usually 360 or 600
(game-time > 300) ;previously 390
=>
(up-send-scout group-type-land-explore scout-center)
(disable-self) 
)

(defrule
(game-time > 330) ;previously 420
=>
(up-send-scout group-type-land-explore scout-center)
(disable-self) 
)

(defrule
(game-time > 900)
(or(building-type-count-total mining-camp >= 1)
(building-type-count-total lumber-camp >= 2))
=>
(set-strategic-number sn-camp-max-distance 60) ;previously 50
;(set-strategic-number sn-maximum-gold-drop-distance 50)
(set-strategic-number sn-minimum-dropsite-buffer 50)
(up-assign-builders c: mining-camp c: 4)
(disable-self) 
)

(defrule
(game-time > 720) ;v2.2c new
(players-unit-type-count 0 gold-mine >= 30) ;did we find a lot of gold? if so...
(or(up-pending-objects c: mining-camp >= 1)
(building-type-count mining-camp <= 2))
(or(unit-type-count-total 213 > 2)
(unit-type-count-total 225 > 2))
=>
(up-assign-builders c: mining-camp c: 1)
(set-strategic-number sn-percent-building-cancellation 100)
;(chat-to-all "Debug: I can't seem to build a Mining Camp.")
(disable-self) 
)

(defrule
(game-time > 1800) ;v2.2c new
(cc-players-unit-type-count 0 gold-mine >= 30) ;did we find a lot of gold? if so...
(or(building-type-count-total mining-camp >= 3)
(building-type-count-total lumber-camp >= 3))
=>
(set-strategic-number sn-camp-max-distance 70) ;previously 60
(set-strategic-number sn-minimum-dropsite-buffer 45)
(set-strategic-number sn-percent-building-cancellation 50)
(set-strategic-number sn-gold-dropsite-distance 8)
(set-strategic-number sn-maximum-gold-drop-distance 15) ;added, new previously 14
(set-strategic-number sn-maximum-stone-drop-distance 15) ;added, new previously 14
(up-assign-builders c: mining-camp c: 2)
(disable-self) 
)

(defrule
(game-time > 960)
(game-time < 3000) ;v2.2c new
(cc-players-unit-type-count 0 gold-mine >= 30) ;did we find a lot of gold? if so...
(military-population >= 5)
;(wood-amount > 300)
(resource-found gold)
(building-type-count-total mining-camp < 4)
(can-build mining-camp)
=>
(set-strategic-number sn-camp-max-distance 60)
(set-strategic-number sn-minimum-dropsite-buffer 45)
(build mining-camp)
(disable-self)
) 

(defrule
(game-time > 1210) ;v2.2c new
(cc-players-unit-type-count 0 gold-mine >= 30) ;did we find a lot of gold? if so...
(or(military-population >= 25) ;previously 30
(players-military-population every-enemy <= 10))
(gold-amount < 300)
(resource-found gold)
(building-type-count-total mining-camp < 5) ;previously 4
(can-build mining-camp)
=>
(set-strategic-number sn-minimum-dropsite-buffer 45)
(build mining-camp)
(set-strategic-number sn-maximum-gold-drop-distance 15) ;added, new previously 14
(set-strategic-number sn-maximum-stone-drop-distance 15) ;added, new previously 14
(disable-self)
) 

#end-if

