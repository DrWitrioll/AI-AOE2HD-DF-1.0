	(or(difficulty <= hardest)
	(or(difficulty == hard)
	(difficulty == moderate)))
	(or(stone-amount > 1500)
	(or(current-age == imperial-age)
	(game-time > 2100)))
 	(building-type-count-total castle < 5)
	(can-build castle)
=>
	(set-goal pausetsa 1)
 	(build castle)
)

