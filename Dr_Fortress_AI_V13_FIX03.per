;========User Patch/HD Edition Additions=========
;Retreat out of Town Center and Castle Fire. 
;Timer 9 is to reset attack.
;Timer 8 is to make sure we retreat. 

(defconst retreat 1)
(defconst action-patrol 2)
(defconst reset 83)
(defconst actionid-retreat 608)
(defconst actionid-patrol 611)
(defconst orderid-retreat 708)
(defconst orderid-patrol 711)
(defconst tc-arrow 54)
(defconst watch-tower-arrow 786)
(defconst castle-arrow 746)
(defconst castle-arrow-chemistry 747)


(defrule
	(game-time > 240)
	(unit-type-count villager >= 12)
	(research-completed ri-loom)
=>
	(set-strategic-number sn-percent-building-cancellation 50)
	(set-strategic-number sn-enable-patrol-attack 1)
	(set-strategic-number sn-enable-boar-hunting 2)
	(set-strategic-number sn-minimum-boar-hunt-group-size 2)
	(set-strategic-number sn-minimum-number-hunters 2)
	(set-goal resetretreat 1)
	(set-goal resetattack 1)
	(disable-self)
)

;Credit to Promiskuitiv and Archon for most of the following boar hunting section. 

(defrule
	(dropsite-min-distance live-boar <= 16)
	(strategic-number sn-enable-boar-hunting >= 1)
	(unit-type-count 216 < 2)
	(unit-type-count 122 < 2)
	(or(unit-type-count 216 >= 1)
	(unit-type-count 122 >= 1))
=>
	(set-strategic-number sn-minimum-number-hunters 2)
	(up-request-hunters c: 1)
)

(defrule
	(dropsite-min-distance live-boar <= 10) 
	(dropsite-min-distance live-boar >= 0)
	(unit-type-count 216 <= 2); male hunter
	(unit-type-count 122 <= 2); female hunter
	(strategic-number sn-enable-boar-hunting >= 1)
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 7)
	(set-strategic-number sn-minimum-number-hunters 7)
	(up-retask-gatherers food c: 1)
	(up-request-hunters c: 6)
)

(defrule
	(or(dropsite-min-distance live-boar s:> sn-maximum-hunt-drop-distance)
	(and(dropsite-min-distance live-boar >= 11)
	(dropsite-min-distance boar-hunting <= 10)))
	(strategic-number sn-minimum-number-hunters > 2)
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 1)
	(set-strategic-number sn-minimum-number-hunters 2)
)

;----------

(defrule
	(game-time > 1140) ;once 1200
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 6)
	(set-strategic-number sn-enable-boar-hunting 0)
	(set-strategic-number sn-minimum-number-hunters 0)
	(disable-self)
)

(defrule
	(game-time > 660) 
	(goal fastcastle 1)
=>
	(set-strategic-number sn-minimum-boar-hunt-group-size 6)
	(set-strategic-number sn-enable-boar-hunting 0)
	(set-strategic-number sn-minimum-number-hunters 4) ;previously 3
	(disable-self)
)

;(strategic-number sn-number-attack-groups > 0)
;(up-reset-unit c: -1)
;(cc-players-unit-type-count any-enemy tc-arrow > 0)
;(cc-players-unit-type-count target-player watch-tower-arrow > 0)

(defrule
(goal resetretreat 0)
(goal resetattack 0)
(timer-triggered 9)
(cc-players-unit-type-count any-enemy tc-arrow == 0)
(cc-players-unit-type-count any-enemy castle-arrow == 0)
(cc-players-unit-type-count any-enemy castle-arrow-chemistry == 0)
=>
(set-strategic-number sn-number-attack-groups  0)
(set-strategic-number sn-percent-enemy-sighted-response 20) 	
(set-strategic-number sn-enemy-sighted-response-distance 20)
(up-reset-unit c: -1) 
(disable-timer 9)
)

(defrule
(goal resetretreat 0)
(timer-triggered 8)
=>
(disable-timer 8)
(set-goal resetattack 1)
(set-goal resetretreat 1)
)

(defrule
(goal resetattack 1)
(timer-triggered 6)
(difficulty == easiest)
(military-population > 25)
=>
(set-strategic-number sn-minimum-attack-group-size 5) 
(set-strategic-number sn-maximum-attack-group-size 15) 
;(set-strategic-number sn-number-attack-groups  10)
(set-strategic-number sn-percent-enemy-sighted-response 100) 	
(set-strategic-number sn-enemy-sighted-response-distance 40)
(set-goal resetattack 0)
(enable-timer 40 1)
(disable-timer 6)
)

(defrule
(goal resetattack 1)
(timer-triggered 6)
(not(difficulty == easiest))
(military-population > 35)
=>
(set-strategic-number sn-minimum-attack-group-size 8) 
(set-strategic-number sn-maximum-attack-group-size 20) 
;(set-strategic-number sn-number-attack-groups  10)
(set-strategic-number sn-percent-enemy-sighted-response 100) 	
(set-strategic-number sn-enemy-sighted-response-distance 40)
(set-goal resetattack 0)
(enable-timer 40 1)
(disable-timer 6)
)

