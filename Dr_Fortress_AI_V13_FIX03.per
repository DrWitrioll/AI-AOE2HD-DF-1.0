=>
	(train villager)
)

(defrule
	(game-time > 2400)
	(population-cap == 200)
	(food-amount > 1000)
	(wood-amount > 1000)
	(or(difficulty <= hardest)
	(or(difficulty == hard)
	(difficulty == moderate)))
	(military-population >= 40)
	(unit-type-count-total villager >= 125)
=>
	(delete-unit villager)
	(delete-unit fishing-ship)
)

