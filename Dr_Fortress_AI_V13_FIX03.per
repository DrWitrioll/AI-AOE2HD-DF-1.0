(defrule
(or(goal aiteammate 1)
(current-age == imperial-age)) ;make sure it happens eventually
(game-time > 600)
(current-age == castle-age)
(or(building-type-count town-center >= 2) ;new v2.2c
(game-time > 1500))
=>
(set-goal builddock 1)
(disable-self) 
)

(defrule
;(game-time > 600)
(or(building-type-count town-center >= 2)
(or(players-building-type-count any-enemy dock >= 1) ;new v2.2c
(game-time > 1500)))
=>
(set-goal builddock 1)
(disable-self) 
)

(defrule
(game-time < 2100)
(or(cc-players-unit-type-count 0 sea-fish >= 4) ;new v2.2c
(cc-players-unit-type-count 0 shore-fish >= 2))
(wood-amount > 100)
(unit-type-count-total fishing-ship < 2)
(can-train fishing-ship)
=>
(train fishing-ship)  
)

(defrule
(or(wood-amount >= 180)
(building-type-count-total town-center >= 2)) ;new v2.2c
(town-under-attack)
(players-military-population every-enemy >= 5)
(players-military-population every-enemy <= 40)
(or(players-unit-type-count any-enemy fire-ship-line >= 2) 
(or(players-unit-type-count every-enemy galley-line <= 10)
(unit-type-count-total galley-line >= 5)))
(warboat-count <= 8)
(unit-type-count-total demolition-ship-line < 1)
(can-train demolition-ship-line)
=>
(train demolition-ship-line)
)

(defrule
(or(current-age == feudal-age) ;to defend ourselves with
(current-age == castle-age))
(or(wood-amount >= 180)
(building-type-count-total town-center >= 2))
(not(difficulty == easiest))
(players-military-population every-enemy >= 3)
(players-military-population every-enemy <= 18) ;v2.2c
(or(players-unit-type-count any-enemy fire-ship-line >= 2) 
(or(players-unit-type-count every-enemy galley-line <= 10)
(unit-type-count-total galley-line >= 5)))
(warboat-count <= 8)
(unit-type-count-total demolition-ship-line < 1)
(can-train demolition-ship-line)
=>
(train demolition-ship-line)
(disable-self)
)

(defrule
(or(wood-amount >= 180)
(building-type-count-total town-center >= 3)) ;new v2.2c v2.2d
(town-under-attack)
(players-military-population every-enemy <= 50)
(players-unit-type-count every-enemy fire-ship-line >= 8) 
(players-unit-type-count every-enemy galley-line <= 10)
(cc-players-building-type-count every-enemy dock >= 3)
(military-population < 30)
(warboat-count <= 3)
(or(goal aibattle 1) ;not sure if will keep this
(current-age == castle-age))
(unit-type-count-total demolition-ship-line < 2)
(can-train demolition-ship-line)
=>
(train demolition-ship-line)
)

(defrule
(current-age == imperial-age)
(or(wood-amount >= 180)
(building-type-count-total town-center >= 3))
(not(difficulty == easiest))
(not(difficulty == easy))
(players-military-population every-enemy <= 60) ;v2.2c
(or(players-unit-type-count any-enemy fire-ship-line >= 2) 
(or(players-unit-type-count every-enemy galley-line <= 10)
(unit-type-count-total galley-line >= 5)))
(warboat-count <= 10)
(unit-type-count-total demolition-ship-line < 1)
(can-train demolition-ship-line)
=>
(train demolition-ship-line)
(disable-self)
)

(defrule
(or(wood-amount >= 300)
(building-type-count-total town-center >= 2))
(not(difficulty == easiest))
(not(town-under-attack))
(military-population >= 40)
(players-military-population every-enemy <= 60) ;v2.2c
(or(players-unit-type-count any-enemy fire-ship-line <= 5) 
(or(players-unit-type-count every-enemy galley-line <= 10)
(unit-type-count-total galley-line >= 4)))
(warboat-count >= 5)
(unit-type-count-total cannon-galleon-line < 1)
(can-train cannon-galleon-line)
=>
(train cannon-galleon-line)
(disable-self)
)

(defrule
(or(wood-amount >= 300)
(building-type-count-total town-center >= 3))
(not(difficulty == easiest))
(not(town-under-attack))
(military-population >= 60)
(players-military-population every-enemy <= 60) ;v2.2c v2.2d
(or(players-unit-type-count any-enemy fire-ship-line <= 5) 
(or(players-unit-type-count every-enemy galley-line <= 10)
(unit-type-count-total galley-line >= 4)))
(warboat-count >= 10)
(unit-type-count-total cannon-galleon-line < 2)
(can-train cannon-galleon-line)
=>
(train cannon-galleon-line)
(train cannon-galleon-line)
(disable-self)
)

