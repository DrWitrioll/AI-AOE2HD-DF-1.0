+; ============================================================================
+; FIX22 FINAL ATTACK OWNER / ALLY RESCUE / PEACE PRESSURE / ELITE GUARANTEE
+; ============================================================================
+; Everything above may still calculate economy, threats, counters and formations,
+; but only this final layer writes createarmy, sn-number-attack-groups,
+; sn-percent-attack-soldiers or attack-now.
+;
+; Attack modes: 0 HOLD, 2 ASSAULT, 3 ALLY RESCUE, 4 PEACE PRESSURE.
+; Rescue has highest priority.  It deliberately commits only about 40 percent of
+; the existing army so a Fortress under DEFENSE/RECOVERY still keeps a local core.
+
+; --- Rescue triggers ---------------------------------------------------------
+; Human/AI ally explicit reinforcement and attack requests.
+(defrule
+    (player-valid any-ally)
+    (goal df22-rescue-state 0)
+    (military-population >= 8)
+    (taunt-detected any-ally 12)
+=>
+    (set-goal df22-rescue-state 1)
+    (set-goal df22-rescue-pulse 1)
+    (enable-timer df22-rescue-timer 180)
+    (acknowledge-taunt this-any-ally 12)
+)
+(defrule
+    (player-valid any-ally)
+    (goal df22-rescue-state 0)
+    (military-population >= 10)
+    (taunt-detected any-ally 31)
+=>
+    (set-goal df22-rescue-state 1)
+    (set-goal df22-rescue-pulse 1)
+    (enable-timer df22-rescue-timer 180)
+    (acknowledge-taunt this-any-ally 31)
+)
+(defrule
+    (player-valid any-ally)
+    (goal df22-rescue-state 0)
+    (military-population >= 6)
+    (taunt-detected any-ally 222)
+=>
+    (set-goal df22-rescue-state 1)
+    (set-goal df22-rescue-pulse 1)
+    (enable-timer df22-rescue-timer 210)
+    (acknowledge-taunt this-any-ally 222)
+)
+
+; Automatic rescue: an ally has effectively lost its TC anchor.
+(defrule
+    (player-valid any-ally)
+    (game-time > 900)
+    (goal df22-rescue-state 0)
+    (military-population >= 10)
+    (players-building-type-count any-ally town-center < 1)
+=>
+    (set-goal df22-rescue-state 1)
+    (set-goal df22-rescue-pulse 1)
+    (enable-timer df22-rescue-timer 180)
+    (chat-to-allies "[FORTRESS/ALLY] Rescue force committed to the threatened allied sector.")
+)
+
+; Automatic rescue: severe civilian collapse.  Separate human/computer tests keep
+; the selector parser-proven and avoid treating a missing ally class as a casualty.
+(defrule
+    (cc-players-building-count any-computer-ally >= 1)
+    (game-time > 900)
+    (goal df22-rescue-state 0)
+    (military-population >= 10)
+    (cc-players-unit-type-count any-computer-ally villager < 10)
+    (players-military-population any-enemy >= 15)
+=>
+    (set-goal df22-rescue-state 1)
+    (set-goal df22-rescue-pulse 1)
+    (enable-timer df22-rescue-timer 180)
+)
+(defrule
+    (cc-players-building-count any-human-ally >= 1)
+    (game-time > 900)
+    (goal df22-rescue-state 0)
+    (military-population >= 10)
+    (cc-players-unit-type-count any-human-ally villager < 10)
+    (players-military-population any-enemy >= 15)
+=>
+    (set-goal df22-rescue-state 1)
+    (set-goal df22-rescue-pulse 1)
+    (enable-timer df22-rescue-timer 180)
+)
+
+; Automatic rescue: ally has both a small army and a damaged economy while the
+; enemy still has a meaningful field force.  This is the safe HD approximation
+; for allied "under strong pressure" because town-under-attack is self-only.
+(defrule
+    (player-valid any-ally)
+    (game-time > 1200)
+    (goal df22-rescue-state 0)
+    (military-population >= 12)
+    (players-military-population any-ally < 8)
+    (cc-players-unit-type-count any-ally villager < 25)
+    (players-military-population any-enemy >= 24)
+=>
+    (set-goal df22-rescue-state 1)
+    (set-goal df22-rescue-pulse 1)
+    (enable-timer df22-rescue-timer 180)
+)
+
+(defrule
+    (goal df22-rescue-state 1)
+    (timer-triggered df22-rescue-timer)
+=>
+    (set-goal df22-rescue-state 0)
+    (disable-timer df22-rescue-timer)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+
+; --- Peace -> pressure -------------------------------------------------------
+; Four calm minutes in STABLE/ASSAULT arm a 90-second active pressure window.
+(defrule
+    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
+    (goal df22-rescue-state 0)
+    (goal df22-pressure-state 0)
+    (not (town-under-attack))
+    (up-timer-status df22-peace-timer == timer-disabled)
+=>
+    (enable-timer df22-peace-timer 240)
+)
+(defrule
+    (or (goal df21-economy-state 3) (goal df21-economy-state 4))
+=>
+    (set-goal df22-pressure-state 0)
+    (disable-timer df22-peace-timer)
+    (disable-timer df22-pressure-timer)
+)
+(defrule
+    (goal df22-rescue-state 1)
+=>
+    (set-goal df22-pressure-state 0)
+    (disable-timer df22-peace-timer)
+    (disable-timer df22-pressure-timer)
+)
+(defrule
+    (timer-triggered df22-peace-timer)
+    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
+    (goal df22-rescue-state 0)
+    (military-population >= 16)
+=>
+    (set-goal df22-pressure-state 1)
+    (set-goal df22-pressure-pulse 1)
+    (disable-timer df22-peace-timer)
+    (enable-timer df22-pressure-timer 90)
+)
+(defrule
+    (timer-triggered df22-peace-timer)
+    (military-population < 16)
+=>
+    (disable-timer df22-peace-timer)
+    (enable-timer df22-peace-timer 120)
+)
+(defrule
+    (goal df22-pressure-state 1)
+    (timer-triggered df22-pressure-timer)
+=>
+    (set-goal df22-pressure-state 0)
+    (disable-timer df22-pressure-timer)
+)
+
+; --- Attack mode selection --------------------------------------------------
+; Economy Governor owns the peaceful baseline; rescue overrides everything.
+(defrule
+    (or (goal df21-economy-state 1) (or (goal df21-economy-state 2) (or (goal df21-economy-state 3) (goal df21-economy-state 4))))
+=>
+    (set-goal df22-attack-mode 0)
+)
+(defrule
+    (goal df21-economy-state 5)
+=>
+    (set-goal df22-attack-mode 2)
+)
+(defrule
+    (goal df21-economy-state 2)
+    (goal df22-pressure-state 1)
+=>
+    (set-goal df22-attack-mode 4)
+)
+(defrule
+    (goal df22-rescue-state 1)
+=>
+    (set-goal df22-attack-mode 3)
+)
+
+; --- Sole createarmy / attack-group owner -----------------------------------
+; Dark GROWTH saves the opening economy; Feudal+ continues normal production.
+(defrule
+    (current-age == dark-age)
+    (goal df22-attack-mode 0)
+=>
+    (set-goal createarmy 0)
+    (set-strategic-number sn-number-attack-groups 0)
+    (set-strategic-number sn-percent-attack-soldiers 0)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+(defrule
+    (current-age >= feudal-age)
+    (goal df22-attack-mode 0)
+=>
+    (set-goal createarmy 1)
+    (set-strategic-number sn-number-attack-groups 0)
+    (set-strategic-number sn-percent-attack-soldiers 0)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+
+; ASSAULT keeps a reserve but is decisively offensive.
+(defrule
+    (goal df22-attack-mode 2)
+    (difficulty == easy)
+=>
+    (set-goal createarmy 1)
+    (set-strategic-number sn-minimum-attack-group-size 10)
+    (set-strategic-number sn-maximum-attack-group-size 22)
+    (set-strategic-number sn-number-attack-groups 2)
+    (set-strategic-number sn-percent-attack-soldiers 62)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+(defrule
+    (goal df22-attack-mode 2)
+    (difficulty == moderate)
+=>
+    (set-goal createarmy 1)
+    (set-strategic-number sn-minimum-attack-group-size 12)
+    (set-strategic-number sn-maximum-attack-group-size 26)
+    (set-strategic-number sn-number-attack-groups 2)
+    (set-strategic-number sn-percent-attack-soldiers 70)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+(defrule
+    (goal df22-attack-mode 2)
+    (difficulty == hard)
+=>
+    (set-goal createarmy 1)
+    (set-strategic-number sn-minimum-attack-group-size 14)
+    (set-strategic-number sn-maximum-attack-group-size 30)
+    (set-strategic-number sn-number-attack-groups 3)
+    (set-strategic-number sn-percent-attack-soldiers 78)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+(defrule
+    (goal df22-attack-mode 2)
+    (difficulty == hardest)
+=>
+    (set-goal createarmy 1)
+    (set-strategic-number sn-minimum-attack-group-size 16)
+    (set-strategic-number sn-maximum-attack-group-size 32)
+    (set-strategic-number sn-number-attack-groups 3)
+    (set-strategic-number sn-percent-attack-soldiers 82)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+
+; PEACE PRESSURE is deliberately smaller than full ASSAULT.
+(defrule
+    (goal df22-attack-mode 4)
+=>
+    (set-goal createarmy 1)
+    (set-strategic-number sn-minimum-attack-group-size 10)
+    (set-strategic-number sn-maximum-attack-group-size 24)
+    (set-strategic-number sn-number-attack-groups 2)
+    (set-strategic-number sn-percent-attack-soldiers 60)
+    (set-strategic-number sn-target-evaluation-ally-proximity 0)
+)
+
+; ALLY RESCUE: 40 percent goes out, one local defend group remains even if our own
+; economy is simultaneously in DEFENSE or RECOVERY.
+(defrule
+    (goal df22-attack-mode 3)
+=>
+    (set-goal createarmy 1)
+    (set-strategic-number sn-minimum-attack-group-size 6)
+    (set-strategic-number sn-maximum-attack-group-size 18)
+    (set-strategic-number sn-number-attack-groups 2)
+    (set-strategic-number sn-percent-attack-soldiers 40)
+    (set-strategic-number sn-target-evaluation-ally-proximity 300)
+    (set-strategic-number sn-coop-share-attacking 1)
+    (set-strategic-number sn-number-defend-groups 1)
+    (set-strategic-number sn-minimum-defend-group-size 4)
+    (set-strategic-number sn-maximum-defend-group-size 12)
+)
+
+; One-shot launch pulses. These are the ONLY active attack-now actions in FIX22.
+(defrule
+    (goal df22-attack-mode 3)
+    (goal df22-rescue-pulse 1)
+=>
+    (attack-now)
+    (set-goal df22-rescue-pulse 0)
+)
+(defrule
+    (goal df22-attack-mode 4)
+    (goal df22-pressure-pulse 1)
+=>
+    (attack-now)
+    (set-goal df22-pressure-pulse 0)
+)
+(defrule
+    (goal df21-economy-state 5)
+    (goal df22-rescue-state 0)
+    (goal df22-assault-pulse 0)
+=>
+    (attack-now)
+    (set-goal df22-assault-pulse 1)
+)
+(defrule
+    (or (goal df21-economy-state 1) (or (goal df21-economy-state 2) (or (goal df21-economy-state 3) (goal df21-economy-state 4))))
+=>
+    (set-goal df22-assault-pulse 0)
+)
+
+; --- Compact elite guarantee ------------------------------------------------
+; Posture pools still make middle tiers the backbone. This small rotor only adds
+; a recurring top-tier slot when ASSAULT, or when an Imperial STABLE economy is
+; genuinely rich. One attempt every 24 seconds prevents queue/resource bursts.
+(defrule
+    (goal df21-economy-state 5)
+=>
+    (set-goal df22-elite-state 2)
+)
+(defrule
+    (goal df21-economy-state 2)
+    (current-age == imperial-age)
+    (food-amount > 650)
+    (wood-amount > 450)
+    (gold-amount > 350)
+    (military-population >= 24)
+=>
+    (set-goal df22-elite-state 1)
+)
+(defrule
+    (or (goal df21-economy-state 1) (or (goal df21-economy-state 3) (goal df21-economy-state 4)))
+=>
+    (set-goal df22-elite-state 0)
+)
+(defrule
+    (goal df21-economy-state 2)
+    (or (current-age < imperial-age) (or (food-amount < 550) (or (wood-amount < 380) (gold-amount < 280))))
+=>
+    (set-goal df22-elite-state 0)
+)
+(defrule
+    (timer-triggered df22-elite-timer)
+=>
+    (disable-timer df22-elite-timer)
+)
+
+; Slot 0: Champion.
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 0)
+    (up-timer-status df22-elite-timer == timer-disabled)
+    (research-completed ri-champion)
+    (unit-type-count-total champion < 18)
+    (food-amount > 220)
+    (gold-amount > 160)
+    (can-train champion)
+=>
+    (train champion)
+    (set-goal df22-elite-cycle 1)
+    (enable-timer df22-elite-timer 24)
+)
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 0)
+    (up-timer-status df22-elite-timer == timer-disabled)
+=>
+    (set-goal df22-elite-cycle 1)
+    (enable-timer df22-elite-timer 24)
+)
+
+; Slot 1: Arbalest.
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 1)
+    (up-timer-status df22-elite-timer == timer-disabled)
+    (research-completed ri-arbalest)
+    (unit-type-count-total arbalest < 20)
+    (wood-amount > 220)
+    (gold-amount > 160)
+    (can-train arbalest)
+=>
+    (train arbalest)
+    (set-goal df22-elite-cycle 2)
+    (enable-timer df22-elite-timer 24)
+)
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 1)
+    (up-timer-status df22-elite-timer == timer-disabled)
+=>
+    (set-goal df22-elite-cycle 2)
+    (enable-timer df22-elite-timer 24)
+)
+
+; Slot 2: Paladin.
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 2)
+    (up-timer-status df22-elite-timer == timer-disabled)
+    (research-completed ri-paladin)
+    (unit-type-count-total paladin < 14)
+    (food-amount > 300)
+    (gold-amount > 220)
+    (can-train paladin)
+=>
+    (train paladin)
+    (set-goal df22-elite-cycle 3)
+    (enable-timer df22-elite-timer 24)
+)
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 2)
+    (up-timer-status df22-elite-timer == timer-disabled)
+=>
+    (set-goal df22-elite-cycle 3)
+    (enable-timer df22-elite-timer 24)
+)
+
+; Slot 3: Siege Onager.
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 3)
+    (up-timer-status df22-elite-timer == timer-disabled)
+    (research-completed ri-siege-onager)
+    (unit-type-count-total siege-onager < 5)
+    (wood-amount > 320)
+    (gold-amount > 250)
+    (can-train siege-onager)
+=>
+    (train siege-onager)
+    (set-goal df22-elite-cycle 0)
+    (enable-timer df22-elite-timer 24)
+)
+(defrule
+    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
+    (goal df22-elite-cycle 3)
+    (up-timer-status df22-elite-timer == timer-disabled)
+=>
+    (set-goal df22-elite-cycle 0)
+    (enable-timer df22-elite-timer 24)
+)
