+
+; ============================================================================
+; FIX24 EARLY / RECOVERY MOBILIZATION OVERRIDES
+; ============================================================================
+; This is intentionally compact.  It does not choose elite quality and does not
+; create resources.  It only guarantees that the existing exact-tier dispatchers
+; receive cheap/middle family requests while the army is dangerously small.
+
+(defrule
+    (timer-triggered df24-mobilize-timer)
+=>
+    (disable-timer df24-mobilize-timer)
+)
+
+; Feudal: never let fast-castle/random-strategy flags leave the Fortress virtually
+; unarmed.  From 20 seconds after Feudal, a sub-10 field army enters mobilization.
+(defrule
+    (current-age == feudal-age)
+    (current-age-time >= 20)
+    (military-population < 10)
+=>
+    (set-goal feudalarmy 1)
+)
+
+; Ensure one range exists for the cheap spear/skirm/archer defensive triangle.
+(defrule
+    (current-age == feudal-age)
+    (current-age-time >= 35)
+    (military-population < 8)
+    (wood-amount > 150)
+    (building-type-count-total archery-range < 1)
+    (can-build archery-range)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (set-goal pausetsa 1)
+    (build archery-range)
+    (enable-timer df18-infra-timer 12)
+)
+
+; Baseline refresh: cheap families are requested every 18 seconds until ten
+; military population exists. Existing threat/civ rules can add scouts/infantry.
+(defrule
+    (current-age == feudal-age)
+    (current-age-time >= 25)
+    (military-population < 10)
+    (up-timer-status df24-mobilize-timer == timer-disabled)
+=>
+    (set-goal df13-spearman-request 1)
+    (set-goal df13-skirmisher-request 1)
+    (set-goal df13-archer-request 1)
+    (enable-timer df24-mobilize-timer 18)
+)
+
+; Direct threat adds a little more cheap mass; still no attack is forced here.
+(defrule
+    (current-age == feudal-age)
+    (town-under-attack)
+    (military-population < 14)
+=>
+    (set-goal df13-spearman-request 1)
+    (set-goal df13-skirmisher-request 1)
+    (set-goal df13-archer-request 1)
+)
+
+; RECOVERY is mobilization. Every eight seconds the standing cheap/middle families
+; are refreshed until a real field army exists. Posture 1 still controls quality.
+(defrule
+    (goal df21-economy-state 4)
+    (military-population < 30)
+    (up-timer-status df24-mobilize-timer == timer-disabled)
+=>
+    (set-goal df13-militia-request 1)
+    (set-goal df13-spearman-request 1)
+    (set-goal df13-archer-request 1)
+    (set-goal df13-skirmisher-request 1)
+    (set-goal df13-scout-request 1)
+    (enable-timer df24-mobilize-timer 8)
+)
+
+; Castle+ RECOVERY also requests a limited mounted/siege middle core. Caps avoid
+; turning reconstruction into an expensive elite queue.
+(defrule
+    (goal df21-economy-state 4)
+    (current-age >= castle-age)
+    (military-population < 26)
+    (unit-type-count-total knight-line < 6)
+    (food-amount > 140)
+    (gold-amount > 110)
+=>
+    (set-goal df13-knight-request 1)
+)
+(defrule
+    (goal df21-economy-state 4)
+    (current-age >= castle-age)
+    (military-population < 26)
+    (unit-type-count-total mangonel-line < 3)
+    (wood-amount > 180)
+    (gold-amount > 110)
+=>
+    (set-goal df13-mangonel-request 1)
+)
