#load-if-defined UP-POCKET-POSITION

(defrule
	(game-time > 420)
=>
	(set-goal fastcastle 1) 
;	(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I am in the Pocket position, so I will Fast Castle.")
	(disable-self)
) 

(defrule
	(game-time > 420) 
	(random-number >= 7) ;previously == 8
	(current-age == castle-age) 
	(goal boom 0) ;added
	(goal boomarmy 0) ;added
	(players-military-population every-enemy <= 2) 
	(game-time < 1500) 
	(or(goal nightmaredifficulty 1) ;added
	(or(difficulty <= hardest)
	(difficulty == hard)))
=>
	(set-goal fastcastle 1) 
	(set-goal boom 1)
	(set-goal boomarmy 1) ;added
;	(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I am in the Pocket position, so I will Boom.")
	(disable-self)
) 

