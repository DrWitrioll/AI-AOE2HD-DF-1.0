; ---------------------------------------------------------------------------
; Threat counters and cavalry reserve.
; ---------------------------------------------------------------------------
(defrule
    (current-age == feudal-age)
    (goal makecavalry 1)
    (unit-type-count-total scout-cavalry-line < 3)
    (food-amount > 120)
=>
    (set-goal df13-scout-request 1)
)
(defrule
    (current-age >= castle-age)
    (goal makecavalry 1)
    (unit-type-count-total knight-line < 8)
    (food-amount > 220)
    (gold-amount > 160)
=>
    (set-goal df13-knight-request 1)
)

; ---------------------------------------------------------------------------
; FIX06 NON-CONVERTING UPGRADE DOCTRINE
; Research unlocks a new full-price model.  Units already on the field remain
; their old model and are never deleted merely because a better tier exists.
; Small exact-tier floors prevent a line-total full of old units from blocking
; all production of the newly researched model.
; ---------------------------------------------------------------------------
(defrule
    (goal makeinfantry 1)
    (research-completed ri-man-at-arms)
    (unit-type-count-total man-at-arms < 4)
    (can-train man-at-arms)
=>
    (train man-at-arms)
)
(defrule
    (goal makeinfantry 1)
    (research-completed ri-long-swordsman)
    (unit-type-count-total long-swordsman < 4)
    (can-train long-swordsman)
=>
    (train long-swordsman)
)
(defrule
    (goal makeinfantry 1)
    (research-completed ri-two-handed-swordsman)
    (unit-type-count-total two-handed-swordsman < 6)
    (can-train two-handed-swordsman)
=>
    (train two-handed-swordsman)
)
(defrule
    (goal makeinfantry 1)
    (research-completed ri-champion)
    (unit-type-count-total champion < 8)
    (can-train champion)
=>
    (train champion)
)
(defrule
    (or (goal makeinfantry 1) (goal df13-threat-cavalry 1))
    (research-completed ri-pikeman)
    (unit-type-count-total pikeman < 5)
    (can-train pikeman)
=>
    (train pikeman)
)
(defrule
    (or (goal makeinfantry 1) (goal df13-threat-cavalry 1))
    (research-completed ri-halberdier)
    (unit-type-count-total halberdier < 8)
    (can-train halberdier)
=>
    (train halberdier)
)
(defrule
    (goal makearchers 1)
    (research-completed ri-crossbow)
    (unit-type-count-total crossbowman < 5)
    (can-train crossbowman)
=>
    (train crossbowman)
)
(defrule
    (goal makearchers 1)
    (research-completed ri-arbalest)
    (unit-type-count-total arbalest < 8)
    (can-train arbalest)
=>
    (train arbalest)
)
(defrule
    (goal df13-threat-archer 1)
    (research-completed ri-elite-skirmisher)
    (unit-type-count-total elite-skirmisher < 6)
    (can-train elite-skirmisher)
=>
    (train elite-skirmisher)
)
(defrule
    (goal makearchers 1)
    (research-completed ri-heavy-cavalry-archer)
    (unit-type-count-total heavy-cavalry-archer < 6)
    (can-train heavy-cavalry-archer)
=>
    (train heavy-cavalry-archer)
)
(defrule
    (goal makecavalry 1)
    (research-completed ri-heavy-camel)
    (unit-type-count-total heavy-camel < 6)
    (can-train heavy-camel)
=>
    (train heavy-camel)
)
(defrule
    (goal makesiege 1)
    (research-completed ri-capped-ram)
    (unit-type-count-total capped-ram < 3)
    (can-train capped-ram)
=>
    (train capped-ram)
)
(defrule
    (goal makesiege 1)
    (research-completed ri-siege-ram)
    (unit-type-count-total siege-ram < 4)
    (can-train siege-ram)
=>
    (train siege-ram)
)
(defrule
    (goal makesiege 1)
    (research-completed ri-onager)
    (unit-type-count-total onager < 3)
    (can-train onager)
=>
    (train onager)
)
(defrule
    (goal makesiege 1)
    (research-completed ri-siege-onager)
    (unit-type-count-total siege-onager < 4)
    (can-train siege-onager)
=>
    (train siege-onager)
)
(defrule
    (goal makesiege 1)
    (research-completed ri-heavy-scorpion)
    (unit-type-count-total heavy-scorpion < 4)
    (can-train heavy-scorpion)
=>
    (train heavy-scorpion)
)

; Naval families follow the same rule: old ships remain, the researched model
; is bought separately at full cost.
(defrule
    (goal createnavy 1)
    (research-completed ri-war-galley)
    (unit-type-count-total war-galley < 5)
    (can-train war-galley)
=>
    (train war-galley)
)
(defrule
    (goal createnavy 1)
    (research-completed ri-galleon)
    (unit-type-count-total galleon < 8)
    (can-train galleon)
=>
    (train galleon)
)
(defrule
    (goal createnavy 1)
    (research-completed ri-fast-fire-ship)
    (unit-type-count-total fast-fire-ship < 6)
    (can-train fast-fire-ship)
=>
    (train fast-fire-ship)
)
(defrule
    (goal createnavy 1)
    (research-completed ri-heavy-demolition-ship)
    (unit-type-count-total heavy-demolition-ship < 4)
    (can-train heavy-demolition-ship)
=>
    (train heavy-demolition-ship)
)
(defrule
    (goal createnavy 1)
    (research-completed ri-deck-guns)
    (unit-type-count-total elite-cannon-galleon < 3)
    (can-train elite-cannon-galleon)
=>
    (train elite-cannon-galleon)
)

; Knight family: custom DAT keeps all three tiers trainable.
; Rebuild/low reserves buy the cheap legacy Knight, balanced reserves use
; Cavalier, and a rich assault economy buys Paladin.  can-train is the final
; authority, so custom DAT prices and civ availability remain respected.







; Scout family follows the same paid-tier doctrine.  The Dark/Feudal Scout cap
; is still respected by the existing requester rules; late rebuilds may buy a
; cheap Scout instead of waiting for Light Cavalry/Hussar resources.






; Clear stale Scout requests at caps.  Legacy tactical rules may request again
; next cycle, but cannot bypass the difficulty cap.


(defrule
    (current-age >= feudal-age)
    (goal df13-threat-cavalry 1)
    (unit-type-count-total spearman-line < 8)
    (food-amount > 100)
=>
    (set-goal df13-spearman-request 1)
)
(defrule
    (current-age >= feudal-age)
    (goal df13-threat-archer 1)
    (unit-type-count-total skirmisher-line < 10)
    (food-amount > 100)
    (wood-amount > 100)
=>
    (set-goal df13-skirmisher-request 1)
)
(defrule
    (current-age >= feudal-age)
    (goal df13-threat-infantry 1)
    (unit-type-count-total archer-line < 10)
    (wood-amount > 120)
    (gold-amount > 80)
=>
    (set-goal df13-archer-request 1)
)

; ---------------------------------------------------------------------------
; Siege doctrine and packages.
; ---------------------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (or (goal makesiege 1)
        (or (goal df13-enemy-fortified 1) (goal df13-threat-siege 1)))
    (building-type-count-total siege-workshop < 1)
    (wood-amount > 260)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build siege-workshop)
    (enable-timer df18-infra-timer 15)
)
(defrule
    (current-age >= castle-age)
    (goal df13-pop-profile 2)
    (goal df13-enemy-fortified 1)
    (building-type-count-total siege-workshop < 2)
    (wood-amount > 420)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build siege-workshop)
    (enable-timer df18-infra-timer 15)
)
(defrule
    (current-age >= castle-age)
    (goal df13-pop-profile 3)
    (goal df13-enemy-fortified 1)
    (building-type-count-total siege-workshop < 3)
    (wood-amount > 500)
    (up-pending-objects c: siege-workshop < 1)
    (can-build siege-workshop)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build siege-workshop)
    (enable-timer df18-infra-timer 15)
)

; Rams for fixed defences.
(defrule
    (current-age >= castle-age)
    (goal df13-enemy-fortified 1)
    (unit-type-count-total battering-ram-line < 3)
    (wood-amount > 220)
    (gold-amount > 120)
=>
    (set-goal df13-ram-request 1)
)
; Mangonels against ranged masses.
(defrule
    (current-age >= castle-age)
    (goal df13-threat-archer 1)
    (unit-type-count-total mangonel-line < 3)
    (wood-amount > 220)
    (gold-amount > 150)
=>
    (set-goal df13-mangonel-request 1)
)
; Scorpions against massed infantry.
(defrule
    (current-age >= castle-age)
    (goal df13-threat-infantry 1)
    (unit-type-count-total scorpion-line < 4)
    (wood-amount > 220)
    (gold-amount > 120)
=>
    (set-goal df13-scorpion-request 1)
)

; Siege package readiness.
(defrule
    (current-age >= castle-age)
    (or (unit-type-count-total battering-ram-line >= 2)
        (or (unit-type-count-total mangonel-line >= 2)
            (unit-type-count-total scorpion-line >= 3)))
=>
    (set-goal df13-siege-ready 1)
)
(defrule
    (current-age >= castle-age)
    (unit-type-count-total battering-ram-line < 2)
    (unit-type-count-total mangonel-line < 2)
    (unit-type-count-total scorpion-line < 3)
=>
    (set-goal df13-siege-ready 0)
)

; Do not throw ordinary troops alone into a fortified enemy.  When a siege
; package exists, form a heavier assault group.
(defrule
    (goal df13-enemy-fortified 1)
    (goal df13-siege-ready 0)
    (goal df13-defense-state 0)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)
(defrule
    (goal df13-enemy-fortified 1)
    (goal df13-siege-ready 1)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (military-population >= 18)
=>
    (set-goal df13-assault-ready 1)
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 32)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 2)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 75)
)
(defrule
    (goal df13-enemy-fortified 0)
=>
    (set-goal df13-assault-ready 0)
)

; ---------------------------------------------------------------------------
; FIX05 FIELD PATROL / TARGET ARBITRATION
;
; Land soldiers are not released as one-unit trickles.  A field patrol is only
; permitted when at least ten land soldiers exist.  Attack groups themselves
; perform the map search; local targeting mode 1 (already configured by the
; inherited tactical engine) biases individual engagements toward useful
; damage/attack-bonus targets.
; ---------------------------------------------------------------------------
(defrule
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (soldier-count >= 10)
=>
    (set-goal df13-field-patrol 1)
)
(defrule
    (or (goal df13-defense-state 1)
        (or (goal df13-recovery 1)
            (or (goal df13-military-rebuild 1)
                (soldier-count < 10))))
=>
    (set-goal df13-field-patrol 0)
)

; No land offensive group may form below ten soldiers.
(defrule
    (goal df13-field-patrol 0)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)

; 10-23 soldiers: one coherent reconnaissance/combat group.
(defrule
    (goal df13-field-patrol 1)
    (soldier-count < 24)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
=>
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 16)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 100)
    (set-strategic-number sn-local-targeting-mode 1)
    (set-strategic-number sn-percent-enemy-sighted-response 0)
    (set-strategic-number sn-enemy-sighted-response-distance 0)
)

; 24+ soldiers: two groups, still never smaller than ten.  A quarter of the
; army remains outside the offensive allocation for local defense/reinforcing.
(defrule
    (goal df13-field-patrol 1)
    (soldier-count >= 24)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
=>
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 24)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 2)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 75)
    (set-strategic-number sn-local-targeting-mode 1)
    (set-strategic-number sn-percent-enemy-sighted-response 0)
    (set-strategic-number sn-enemy-sighted-response-distance 0)
)

; Wall/gate target policy.  Without any siege package, normal soldiers ignore
; walls and gates but can still attack ordinary buildings such as Outposts.
; Once siege is ready, wall/gate targeting is enabled for the assault package.
(defrule
    (unit-type-count-total battering-ram-line < 1)
    (unit-type-count-total mangonel-line < 1)
    (unit-type-count-total scorpion-line < 1)
    (unit-type-count-total trebuchet-set < 1)
    (unit-type-count-total bombard-cannon < 1)
=>
    (set-strategic-number sn-wall-targeting-mode 0)
    (set-strategic-number df13-building-targeting-mode 1)
)
(defrule
    (or (unit-type-count-total battering-ram-line >= 1)
        (or (unit-type-count-total mangonel-line >= 1)
            (or (unit-type-count-total scorpion-line >= 1)
                (or (unit-type-count-total trebuchet-set >= 1)
                    (unit-type-count-total bombard-cannon >= 1)))))
=>
    (set-strategic-number sn-wall-targeting-mode 1)
    (set-strategic-number df13-building-targeting-mode 0)
)

; ---------------------------------------------------------------------------
; End V13 Fortress doctrine.
; ---------------------------------------------------------------------------

; ============================================================================
; FIX10 ECONOMY / RESEARCH / EXACT-TIER DISPATCHERS
; ============================================================================

; FIX11 farm-order cooldown.  A valid completed placement releases normally.
; A placement still blocked after the cooldown is cleared from the placement
; list so one bad tile cannot freeze every future farm order.
(defrule
    (goal df13-farm-throttle 1)
    (timer-triggered df13-farm-timer)
    (up-pending-objects c: farm < 1)
=>
    (set-goal df13-farm-throttle 0)
    (disable-timer df13-farm-timer)
)
(defrule
    (goal df13-farm-throttle 1)
    (timer-triggered df13-farm-timer)
    (up-pending-objects c: farm > 0)
=>
    ; FIX12: unsupported up-reset-placement removed; cooldown will allow retry.
    (set-goal df13-farm-throttle 0)
    (disable-timer df13-farm-timer)
)


; Military unlock sweep.  In the custom DAT these researches add options rather
; than deleting the cheaper model, so there is no longer a strategic reason to
; postpone an available tier unlock indefinitely.


