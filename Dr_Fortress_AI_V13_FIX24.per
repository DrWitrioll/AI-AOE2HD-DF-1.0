;============Error Notifications=========================

(defrule
(game-time >= 240)
(game-time <= 600)
(goal nomadstart 1)
(building-type-count-total town-center < 1)
=>
(chat-to-all "[FORTRESS] [CMD-39] Critical setup error: no valid Town Center placement is available.")
(chat-to-all "[FORTRESS] Irregular Nomad generation can occasionally prevent valid AI placement.")
(chat-to-all "[FORTRESS] Restarting the map or using Land Nomad may avoid the placement failure.")
(resign)
)

(defrule
(game-time >= 360)
(game-time <= 900)
(goal nomadstart 0)
(unit-type-count-total villager <= 7)
(or(difficulty <= hardest)
(or(difficulty == hard)
(difficulty == moderate))) ;new v2.2b v2.2c, changed error text
=>
(chat-to-all "[FORTRESS] [CMD-39] Load failure detected in the AI script.")
(chat-to-all "[FORTRESS] For reliable testing, use the newest Doktor Fortress AI build.")
(chat-to-all "[FORTRESS] Restart on a fresh map; the legacy AI engine returned an initialization failure.")
(disable-self)
)

(defrule
(game-time >= 660)
(game-time <= 900)
(goal nomadstart 0)
(wood-amount <= 20)
(building-type-count mill > 1)
(building-type-count lumber-camp < 1) ;new v2.2b v2.2c
=>
(chat-to-all "[FORTRESS] [CMD-39] Load failure detected in the AI script.")
(chat-to-all "[FORTRESS] For reliable testing, use the newest Doktor Fortress AI build.")
(chat-to-all "[FORTRESS] Restart on a fresh map; the legacy AI engine returned an initialization failure.")
(disable-self)
)

(defrule
(game-time >= 150)
(game-time <= 210)
(or(death-match-game)
(not(starting-age == dark-age)))
=>
(chat-to-all "[FORTRESS] [CMD-39] Unsupported setup: this profile expects a Dark Age start.")
(chat-to-all "[FORTRESS] Supported inherited game modes are Random Map and Regicide.")
(chat-to-all "[FORTRESS] For reliable testing, use the newest Doktor Fortress AI build.")
(disable-self)
)

(defrule
(game-time >= 160)
(population-cap <= 125)
;(or(difficulty <= hardest)
;(or(difficulty == hard)
;(difficulty == moderate)))
=>
(chat-to-all "[FORTRESS] [CMD-39] Population limit is below the preferred operating range.")
(chat-to-all "[FORTRESS] Operational message: I play best on at least 200 population and with standard settings.")
(disable-self)
)

(defrule
(game-time >= 175)
(population-cap <= 50)
;(or(difficulty <= hardest)
;(or(difficulty == hard)
;(difficulty == moderate)))
=>
(chat-to-all "[FORTRESS] [CMD-39] Population 50 or lower is outside the supported tactical profile.")
(chat-to-all "[FORTRESS] Operational message: I play best on at least 200 population and with standard settings.")
(resign)
)

;============AI Options and Features, Toggle On and Off============
;Chat taunts to Enable or Disable various Features of the AI
;Uses Timers 11 up to Timers 27
;Actually only uses Timers 22,23,24 now. 
;chattaunts - toggleoptions1 
;chatadvice - toggleoptions2 
;earlyresign - toggleoptions3 
;dynamicdifficulty - toggleoptions4 
;fastcastle - togglefastcastle
;boom -toggleboom

(defrule
(game-time > 1)
=>     
(set-goal toggleoptions1 0)
(set-goal toggleoptions2 0)
(set-goal toggleoptions3 0)
(set-goal toggleoptions4 0)
(set-goal begintoggleoptions 0)
(set-goal chattaunts 1)
(set-goal chatadvice 0) ;previously 1
(set-goal earlyresign 1)
(set-goal dynamicdifficulty 1)
(set-goal specialcommands 1)
(set-goal disablecommands 0)
(disable-self)
)

(defrule
(taunt-detected any-human 125)
(game-time > 5)
=>     
(chat-to-all "[FORTRESS] Custom player commands are now disabled.")
(set-goal specialcommands 0)
(set-goal disablecommands 1)
(acknowledge-taunt this-any-human 125)
)

(defrule
(taunt-detected any-human 42)
(game-time > 120)
(goal specialcommands 0)
