	(goal uniqueflood 1)
	(goal createarmy 0)
	(current-age == imperial-age)
	(research-completed my-unique-unit-upgrade)
=>
	(set-goal df13-unique-request 1)
) 

;=======Advancing to the Next Age==========

(defrule
	(timer-triggered 10)
	(goal escrowtoadvance 1)
	(not(current-age == imperial-age))
=>
	(disable-timer 10)
	(enable-timer 10 120)
	(set-escrow-percentage food 90)
	(set-escrow-percentage gold 90)
) 

(defrule
	(timer-triggered 10)
	(or(up-research-status c: feudal-age >= research-pending)
	(or(up-research-status c: castle-age >= research-pending)
	(up-research-status c: imperial-age >= research-pending)))
=>
	(disable-timer 10)
	(enable-timer 10 120)
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
) 

(defrule
	(game-time > 720)
	(up-research-status c: feudal-age < research-pending)
	(current-age == dark-age)
=>
	(set-goal escrowtoadvance 1) 
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(game-time < 1200)
	(current-age == feudal-age)
	(goal escrowtoadvance 1)
=>
	(set-goal escrowtoadvance 0) 
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(game-time > 1380)
	(up-research-status c: castle-age < research-pending)
	(current-age == feudal-age)
=>
	(set-goal escrowtoadvance 1) 
	(disable-timer 10)
	(enable-timer 10 60)
	(disable-self)
) 

(defrule
	(game-time < 1800)
	(current-age == castle-age)
	(goal escrowtoadvance 1)
=>
	(set-goal escrowtoadvance 0) 
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(game-time > 1980)
	(up-research-status c: imperial-age < research-pending)
	(current-age == castle-age)
=>
	(set-goal escrowtoadvance 1) 
	(disable-timer 10)
	(enable-timer 10 120)
	(disable-self)
) 

(defrule
	(current-age == imperial-age)
	(goal escrowtoadvance 1)
=>
	(set-goal escrowtoadvance 0) 
	(set-escrow-percentage food 0)
	(set-escrow-percentage gold 0)
	(disable-timer 10)
	(disable-self)
) 

;=======Economic Boom Goal===============

(defrule
	(goal boom 1)
=>
;	(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I have decided to Boom this game. I will make a strong economy.")
	(disable-self)
) 

(defrule
	(game-time > 600)
	(game-time < 1200)
	(town-under-attack)
	(or(players-military-population any-enemy >= 3)
	(or(enemy-buildings-in-town)
	(cc-players-building-type-count any-enemy watch-tower-line >= 1)))
=>
;	(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I am being rushed! I can't boom this game.")
	(set-goal boom 0) 
	(disable-self)
) 

;=======Military Goals=================

(defrule
(or(civ-selected aztec)
(civ-selected mayan)) 
(goal scoutrush 1)
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I can't make cavalry! I will make infantry instead.")
(set-goal balancedarmy 1) ;previously makeinfantry 1, added
(set-goal makecavalry 0)
(set-goal scoutrush 0)
(set-goal feudalarmy 1)
)

(defrule
(goal water-map 0)
(or(players-building-type-count any-enemy bombard-tower >= 4)
(or(players-building-type-count any-enemy stone-wall-line >= 4)
(or(players-building-type-count any-enemy gate >= 2)
(players-building-type-count any-enemy castle >= 1))))
(or(unit-type-count-total battering-ram-line <= 3)
(or(unit-type-count-total bombard-cannon <= 2)
(or(unit-type-count-total mangonel-line <= 5)
(unit-type-count-total trebuchet-set <= 2))))
=>
(set-goal makesiege 1)
(disable-self)
)

(defrule
(goal water-map 0)
(or(current-age == imperial-age)
(game-time >= 1800))
(or(players-building-type-count any-enemy bombard-tower >= 4)
(or(players-building-type-count any-enemy stone-wall-line >= 4)
(or(players-building-type-count any-enemy gate >= 2)
(players-building-type-count any-enemy castle >= 1))))
(or(unit-type-count-total battering-ram-line <= 3)
(or(unit-type-count-total bombard-cannon <= 2)
(or(unit-type-count-total mangonel-line <= 5)
(unit-type-count-total trebuchet-set <= 2))))
=>
(set-goal makesiege 1)
(disable-self)
)

(defrule
(goal water-map 0)
(or(military-population >= 40)
(game-time >= 2100))
(or(players-building-type-count any-enemy bombard-tower >= 4)
(or(players-building-type-count any-enemy stone-wall-line >= 4)
(or(players-building-type-count any-enemy gate >= 2)
(players-building-type-count any-enemy castle >= 1))))
(or(unit-type-count-total battering-ram-line <= 3)
(or(unit-type-count-total bombard-cannon <= 2)
(or(unit-type-count-total mangonel-line <= 5)
(unit-type-count-total trebuchet-set <= 2))))
=>
(set-goal makesiege 1)
(disable-self)
)

(defrule
(goal water-map 0)
(goal makesiege 1)
=>
(set-escrow-percentage wood 30)
(set-escrow-percentage gold 70)
(disable-self)
)

(defrule
(goal water-map 0)
(or(unit-type-count-total battering-ram-line > 3)
(or(unit-type-count-total bombard-cannon > 2)
(or(unit-type-count-total mangonel-line > 5)
(unit-type-count-total trebuchet-set > 2))))
=>
(set-escrow-percentage wood 0)
(set-escrow-percentage gold 30)
(set-goal makesiege 0)
(disable-self)
)

;==========The Forgotten Military Goals==============

(defrule
(goal incanciv 1)
(goal scoutrush 1)
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I can't make cavalry! I will make infantry instead.")
(set-goal balancedarmy 1) ;previously makeinfantry 1, added
(set-goal makecavalry 0)
(set-goal scoutrush 0)
(set-goal feudalarmy 1)
)

;=======Check If Computer Teammates=======
;If there is a computer ally, we will attack in waves.
;We will also receive increased tributes.  

(defrule
(game-time > 65)
(game-time < 70)
(cc-players-building-count any-computer-ally >= 1)
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I have detected computer teammates. Adjusting to group tactics.")
(set-goal aiteammate 1)
)

(defrule
(game-time > 78)
(game-time < 85)
(not(cc-players-building-count any-computer-ally >= 1))
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I do not have computer teammates. Adjusting to solo tactics.")
(set-goal aiteammate 0)
)

(defrule
(game-time > 1200)
(player-resigned any-computer-ally)
=>
(set-goal aiteammate 0)
(disable-self)
)

;=======Check If Human Teammates=======
;If there is a human ally, we prioritize saving resources and booming.
;If we have surplus resources we will either make troops or tribute it! 

(defrule
(game-time > 120)
(game-time < 130)
(not(map-type gold-rush))
(cc-players-building-count any-human-ally >= 1)
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I have detected human teammates. Adjusting to supportive tactics.")
(set-strategic-number sn-home-exploration-time 600)
(set-goal teamplay 1)
(disable-self)
)

(defrule
(game-time > 120)
(game-time < 130)
(not(cc-players-building-count any-human-ally >= 1))
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I do not have human teammates. Adjusting to standard tactics.")
(set-goal teamplay 0)
(disable-self)
)

(defrule
(game-time > 1200)
(player-resigned any-human-ally)
=>
(set-goal teamplay 0)
(disable-self)
)

(defrule
(game-time > 1260)
(not(cc-players-building-count any-human-ally >= 1))
=>
(set-goal teamplay 0)
(disable-self)
)

(defrule
(game-time > 1860)
(not(cc-players-building-count any-human-ally >= 1))
=>
(set-goal teamplay 0)
(disable-self)
)

;=======Check If Human Enemies=======

;If there is a human enemy, we will pick from a wide variety of strategies.
;If there are only AI players, will pick the safest strategies! 

(defrule
(game-time > 60)
(game-time < 75) ;changed from 70 v2.2c
(cc-players-building-count any-human-enemy >= 1)
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I have detected human opponents. Adjusting to randomized tactics.")
(set-goal aibattle 0)
(disable-self)
)

(defrule
(game-time > 30)
(game-time < 45) ;changed from 40 v2.2c
(not(cc-players-building-count any-human-enemy >= 1))
=>
;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: I do not have human opponents. Adjusting to standard tactics.")
(set-goal aibattle 1)
;(set-goal fastcastle 0)
;(set-goal buildcastle 0)
;(set-goal balancedarmy 1)
(disable-self)
)

