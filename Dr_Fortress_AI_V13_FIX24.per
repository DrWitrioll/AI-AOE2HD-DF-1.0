;=======Build A Wonder Or Kill A Wonder===========================

#load-if-not-defined REGICIDE
#load-if-not-defined KING-OF-THE-HILL
#load-if-defined VICTORY-STANDARD

;Timer 28

(defrule
	(game-time > 2)
=>
	(set-goal buildwonder 0) 
	(set-goal wonderrush 0)
	(disable-self)
) 

(defrule
	(timer-triggered 28)
	(game-time < 3600)
	(goal buildwonder 1)
	(building-type-count wonder < 1)
=>
	(disable-timer 28)
	(enable-timer 28 90)
	; FIX22 ATTACK OWNER retired: (set-goal createarmy 0)
	(set-escrow-percentage wood 60)
	(set-escrow-percentage gold 90)
	(set-escrow-percentage stone 100)
) 

; FIX18 NO-CHEAT: retired inherited resource-creation rule #5.

(defrule
	(timer-triggered 28)
	(or(building-type-count wonder == 1)
	(goal buildwonder 0))
=>
	(disable-timer 28)
	(set-goal buildwonder 0)
	(set-goal wonderrush 0)
	; FIX22 ATTACK OWNER retired: (set-goal createarmy 1)
	(set-escrow-percentage wood 0)
	(set-escrow-percentage gold 30)
	(set-escrow-percentage stone 0)
) 

(defrule
(current-age == imperial-age)
(game-time > 1800)
(game-time < 3600)
(goal wonderrush 1)
(or(unit-type-count-total villager >= 30)
(goal water-map 1))
(building-type-count wonder < 1)
=>
(chat-to-allies "[FORTRESS/ALLY] [CMD-26] Wonder construction reserve has been activated.")
(chat-to-allies "[FORTRESS/ALLY] Allied tribute will accelerate Wonder construction.")
(set-strategic-number sn-food-gatherer-percentage 15)
(set-strategic-number sn-wood-gatherer-percentage 45)
(set-strategic-number sn-gold-gatherer-percentage 25)
(set-strategic-number sn-stone-gatherer-percentage 15)
(set-escrow-percentage wood 60)
(set-escrow-percentage gold 80)
(set-escrow-percentage stone 100)
(set-goal buildwonder 1)
(disable-timer 28)
(enable-timer 28 120)
(disable-self)
)

(defrule
(current-age == imperial-age)
(game-time > 1800)
(game-time < 3600)
(not(town-under-attack))
(military-population >= 30)
(players-military-population every-enemy < 35)
(or(unit-type-count-total villager >= 60)
(goal water-map 1))
(not(cc-players-building-type-count any-ally wonder > 0))
(building-type-count wonder < 1)
(building-type-count castle >= 1)
=>
(chat-to-allies "[FORTRESS/ALLY] [CMD-26] Wonder construction reserve has been activated.")
(chat-to-allies "[FORTRESS/ALLY] Allied tribute will accelerate Wonder construction.")
(set-strategic-number sn-food-gatherer-percentage 15)
(set-strategic-number sn-wood-gatherer-percentage 45)
(set-strategic-number sn-gold-gatherer-percentage 25)
(set-strategic-number sn-stone-gatherer-percentage 15)
(set-escrow-percentage wood 60)
(set-escrow-percentage gold 80)
(set-escrow-percentage stone 100)
(set-goal buildwonder 1)
(disable-timer 28)
(enable-timer 28 120)
(disable-self)
)

; FIX21 MARKET OWNER: retired inherited transaction rule 3.

; FIX21 MARKET OWNER: retired inherited transaction rule 4.

; FIX21 MARKET OWNER: retired inherited transaction rule 5.

; FIX21 MARKET OWNER: retired inherited transaction rule 6.

; FIX21 MARKET OWNER: retired inherited transaction rule 7.

(defrule
(goal buildwonder 1)
(current-age == imperial-age)
(game-time > 2100)
(game-time < 3600)
(or(players-military-population any-enemy > 55)
(or(military-population <= 20)
(or(town-under-attack)
(cc-players-building-type-count any-ally wonder > 0))))
=>
(chat-to-allies "[FORTRESS/ALLY] [CMD-12] Wonder construction has been cancelled.")
(release-escrow wood)
(release-escrow gold)
(release-escrow stone)
(set-strategic-number sn-percent-civilian-builders 40) 
(set-strategic-number sn-percent-civilian-gatherers 60)
(set-escrow-percentage wood 0)
(set-escrow-percentage gold 30)
(set-escrow-percentage stone 0)
(set-goal buildwonder 0)
(set-goal wonderrush 0)
(disable-timer 28)
(disable-self)
)

(defrule
(current-age == imperial-age)
(game-time > 3600)
(building-type-count wonder == 0)
=>
(set-strategic-number sn-percent-civilian-builders 40) 
(set-strategic-number sn-percent-civilian-gatherers 60)
(set-strategic-number sn-number-defend-groups 0)
(set-escrow-percentage wood 0)
(set-escrow-percentage gold 0)
(set-escrow-percentage stone 0)
; FIX22 ATTACK OWNER retired: (set-goal createarmy 1)
(disable-self)
)

(defrule
(goal buildwonder 1)
(current-age == imperial-age)
(game-time > 1860)
(game-time < 3600)
(not(town-under-attack))
;(not(cc-players-building-type-count any-ally wonder > 0))
(building-type-count wonder < 1)
(can-build-with-escrow wonder)
=>
(release-escrow wood)
(release-escrow gold)
(release-escrow stone)
(build wonder)
;(set-strategic-number sn-percent-civilian-builders 70) 
