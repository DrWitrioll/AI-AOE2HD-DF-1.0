(building-type-count dock <= 1)
(players-military-population any-enemy > 40)
(warboat-count <= 8)
(military-population <= 20)
(up-timer-status 30 == timer-disabled)
(up-timer-status 31 == timer-disabled)
=> 
(chat-to-all "[FORTRESS] [CMD-9] My defensive network has collapsed beyond practical recovery.")
(chat-to-all "[FORTRESS] My position is no longer recoverable. Do you accept my surrender?")
(chat-to-all "[FORTRESS] Respond through the Chat Menu with command 1 or 2.")
(enable-timer 30 35)
(disable-self)
)

(defrule 
(goal earlyresign 1)
(goal teamplay 0)
(goal water-map 1)
(difficulty == easiest)
(game-time > 3060)
(building-type-count wonder < 1)
(unit-type-count-total villager < 20)
(building-type-count dock <= 1)
(players-military-population any-enemy > 25)
(military-population <= 10)
(up-timer-status 30 == timer-disabled)
(up-timer-status 31 == timer-disabled)
=> 
(chat-to-all "[FORTRESS] [CMD-9] My defensive network has collapsed beyond practical recovery.")
(chat-to-all "[FORTRESS] My position is no longer recoverable. Do you accept my surrender?")
(chat-to-all "[FORTRESS] Respond through the Chat Menu with command 1 or 2.")
(enable-timer 30 35)
(disable-self)
)

