(defrule
(population >= 150)
(or(cc-players-unit-type-count 0 sea-fish == 0)
(cc-players-unit-type-count 0 shore-fish <= 2))
=>
(delete-unit fishing-ship) 
)

(defrule
(goal water-map 0)
(population >= 150)
(or(cc-players-unit-type-count 0 sea-fish <= 2)
(cc-players-unit-type-count 0 shore-fish <= 4))
=>
(delete-unit fishing-ship) 
)

(defrule
(or(goal water-map 0) ;new 2019 v2.2b v2.2c
(goal nomadstart 1))
(difficulty >= moderate) ;added
(population-cap <= 200) ;for when population cap is low
(game-time >= 3600) ;for long games
(or(cc-players-unit-type-count 0 sea-fish <= 20)
(military-population <= 50))
(unit-type-count-total fishing-ship > 2)
=>
(delete-unit fishing-ship) 
)

(defrule
(or(current-age == dark-age)
(current-age == feudal-age))
(or(cc-players-unit-type-count 0 sea-fish >= 1)
(cc-players-unit-type-count 0 shore-fish >= 2))
(wood-amount > 100)
(unit-type-count-total fishing-ship < 2)
(can-train fishing-ship)
=>
(train fishing-ship)  
)

(defrule
(current-age == dark-age)
(cc-players-unit-type-count 0 sea-fish >= 1) ;v2.2c previously 1
(or(cc-players-unit-type-count 0 sea-fish >= 6) ;v2.2c previously 3
(cc-players-unit-type-count 0 shore-fish >= 4))
(wood-amount > 100)
(unit-type-count-total fishing-ship < 4)
(can-train fishing-ship)
=>
(train fishing-ship)  
)

