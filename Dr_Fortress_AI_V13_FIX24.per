;-------
;Timers 35-36 are for player targeting.

(defrule
	(game-time > 3600)			
	(goal swaptargeting 1)
=>
	(enable-timer 35 300) 
	(disable-self)
)

(defrule
	(timer-triggered 35)	
	(goal swaptargeting 1)
=>
	(set-strategic-number sn-attack-winning-player 0) 	
	(disable-timer 35)
	(enable-timer 36 180) 
)

(defrule
	(timer-triggered 36)		
	(goal swaptargeting 1)
=>
	(set-strategic-number sn-attack-winning-player 1) 	
	(disable-timer 36)
	(enable-timer 35 300) 
)

