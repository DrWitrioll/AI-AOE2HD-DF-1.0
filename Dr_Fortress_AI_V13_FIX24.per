#load-if-defined DIFFICULTY-MODERATE

(defrule
(goal dynamicdifficulty 1)
(goal chatintroduction 1) ;added
(goal moderatecheats 0)
(timer-triggered 27)
(difficulty == moderate)
(game-time >= 420)
=>
(chat-to-all "[FORTRESS] Current difficulty may be below your skill level. A small increase is available.")
(chat-to-all "[FORTRESS] Send command 99 to Everyone through the Chat Menu to confirm.")
(set-goal requestmoderatecheats 1)
(disable-timer 27)
(disable-self)
)

; FIX18 NO-CHEAT: retired inherited resource-creation rule #70.

(defrule
(difficulty == moderate)
(game-time >= 420)
(game-time <= 455) ;previously 450
(goal moderatecheats 0)
(cc-players-unit-type-count any-human villager >= 18)
=>     
(enable-timer 27 5)
(disable-self)
)

(defrule
(difficulty == moderate)
(game-time >= 660)
(game-time <= 840) 
(goal moderatecheats 0)
(goal requestmoderatecheats 0)
(players-current-age any-human >= feudal-age)
(cc-players-unit-type-count any-human villager >= 27)
=>     
(enable-timer 27 5)
(disable-self)
)

