#load-if-defined DE-AVAILABLE

(defrule
	(true)
=>
	(set-strategic-number sn-wild-animal-exploration 1) ;new DE sn, allows wild horses and wild camels to explore  
	(set-strategic-number sn-minimum-dropsite-buffer 38) ;previously 30, then 35, new v2.2c
	(chat-local-to-self "[FORTRESS/DEBUG] Compatibility branch detected; experimental logic is active.") 
	;(chat-to-all "[FORTRESS] Operational message: ERROR: Please use the newest DE Fortress AI Dev Version! Support the official release this year.") 
	(disable-self)
) 

(defrule
	(game-time > 30)
	(difficulty <= hardest)  ;difficulties are apparently indexed backwards, extreme is -1 
=>
	(set-strategic-number sn-wild-animal-exploration 1) ;new DE sn, allows wild horses and wild camels to explore  
	(set-strategic-number sn-minimum-dropsite-buffer 38) ;previously 30, then 35, new v2.2c
	;(chat-local-to-self "[FORTRESS/DEBUG] Operational message: Debug: DE Detected. Are we Hardest or Extreme Difficulty?")
	(disable-self)
) 

(defrule
	(game-time > 1320) ;previously 1200 in Dev3.1a
=>
	(set-strategic-number sn-minimum-dropsite-buffer 35) ;previously 30, then 35, new v2.2c
	(chat-local-to-self "[FORTRESS/DEBUG] Compatibility branch detected; resource drop-site buffer reset.")
	(disable-self)
) 

#end-if

