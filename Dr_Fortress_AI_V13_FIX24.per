; ============================================================================
; DR FORTRESS V13 - DEFENSIVE / MILITARY / SIEGE DOCTRINE
; ============================================================================

(defconst df13-core 162)
(defconst df13-pop-profile 163)        ;1=125, 2=150, 3=200+
(defconst df13-counterattack 165)      ;0=off, 1=reform/counter window
(defconst df13-threat-archer 166)
(defconst df13-threat-cavalry 167)
(defconst df13-threat-infantry 168)
(defconst df13-threat-siege 169)
(defconst df13-enemy-fortified 170)
(defconst df13-recovery 171)
(defconst df13-siege-ready 172)
(defconst df13-fortress-stage 173)
(defconst df13-observation-tier 174)
(defconst df13-castle-opportunity 175)
(defconst df13-assault-ready 176)
(defconst df13-aftershock 177)
(defconst df13-wall-bootstrap 178)    ;0=no Feudal wall command yet, 1=walling started
(defconst df13-field-patrol 179)      ;0=hold, 1=10+ soldier search/engage posture
(defconst df13-military-rebuild 183)   ;0=normal, 1=rebuild army after catastrophic losses
(defconst df13-outpost 598)

; ---------------------------------------------------------------------------
; Initialization.  Deliberately does NOT touch civilian worker assignment,
; resource percentages, hunting or age-up priorities.
; ---------------------------------------------------------------------------
(defrule
    (goal df13-core 0)
=>
    (set-goal df13-core 1)
    (set-goal df13-pop-profile 2)
    (set-goal df13-defense-state 0)
    (set-goal df13-counterattack 0)
    (set-goal df13-threat-archer 0)
    (set-goal df13-threat-cavalry 0)
    (set-goal df13-threat-infantry 0)
    (set-goal df13-threat-siege 0)
    (set-goal df13-enemy-fortified 0)
    (set-goal df13-recovery 0)
    (set-goal df13-siege-ready 0)
    (set-goal df13-fortress-stage 0)
    (set-goal df13-observation-tier 0)
    (set-goal df13-castle-opportunity 0)
    (set-goal df13-assault-ready 0)
    (set-goal df13-military-rebuild 0)
)

; Population profiles.
(defrule
    (population-cap <= 125)
=>
    (set-goal df13-pop-profile 1)
)
(defrule
    (population-cap > 125)
    (population-cap <= 150)
=>
    (set-goal df13-pop-profile 2)
)
(defrule
    (population-cap > 150)
=>
    (set-goal df13-pop-profile 3)
)

; ---------------------------------------------------------------------------
; Preserve Resonance formation behaviour globally.  These are the same family
; of strategic numbers that make Resonance move soldiers as coherent groups.
; ---------------------------------------------------------------------------
(defrule
    (true)
=>
    (set-strategic-number sn-group-form-distance 70)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-group-leader-defense-distance 2)
)

; FIX08 reconnaissance discipline.  Captured livestock walks home automatically.
; While the only military presence is the reconnaissance element and no Scout
; rush is ordered, incidental enemy sightings do not pull it off exploration.
(defrule
    (true)
=>
    (set-strategic-number sn-livestock-to-town-center 1)
)
(defrule
    (or (current-age == dark-age) (current-age == feudal-age))
    (military-population <= 3)
    (goal scoutrush 0)
    (not (town-under-attack))
=>
    (set-strategic-number sn-percent-enemy-sighted-response 0)
    (set-strategic-number sn-enemy-sighted-response-distance 0)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
)

; ---------------------------------------------------------------------------
; Threat memory - inspired by Jester's confirmed town-under-attack state and
; Fortress threat layers.  Timer 44/45 are unused by ResonanceBot 5-1c.
; ---------------------------------------------------------------------------
(defrule
    (goal df13-defense-state 0)
    (town-under-attack)
    (players-military-population any-enemy > 1)
=>
    (set-goal df13-defense-state 1)
    (set-goal df18-defense-clear 0)
    (set-goal df13-counterattack 0)
    (disable-timer 44)
    (enable-timer 44 35)
)

(defrule
    (goal df13-defense-state 1)
    (timer-triggered 44)
    (town-under-attack)
=>
    (set-goal df18-defense-clear 0)
    (disable-timer 44)
    (enable-timer 44 35)
)

; FIX18 defense hysteresis: the first calm sample keeps the Fortress sheltered.
(defrule
    (goal df13-defense-state 1)
    (goal df18-defense-clear 0)
    (timer-triggered 44)
    (not (town-under-attack))
=>
    (set-goal df18-defense-clear 1)
    (disable-timer 44)
    (enable-timer 44 25)
)
; A second uninterrupted calm window is required before normal work resumes.
(defrule
    (goal df13-defense-state 1)
    (goal df18-defense-clear 1)
    (timer-triggered 44)
    (not (town-under-attack))
=>
    (set-goal df18-defense-clear 0)
    (set-goal df13-defense-state 0)
    (set-goal df13-counterattack 1)
    (set-goal df13-aftershock 1)
    (disable-timer 44)
    (disable-timer 45)
    (enable-timer 45 75)
)

(defrule
    (goal df13-counterattack 1)
    (timer-triggered 45)
=>
    (disable-timer 45)
    (set-goal df13-counterattack 0)
    (set-goal df13-aftershock 0)
)

; Threat typing.
(defrule
    (or (players-unit-type-count any-enemy archer-line >= 3)
        (players-unit-type-count any-enemy cavalry-archer-line >= 3))
=>
    (set-goal df13-threat-archer 1)
)
(defrule
    (or (players-unit-type-count any-enemy scout-cavalry-line >= 3)
        (players-unit-type-count any-enemy knight-line >= 3))
=>
    (set-goal df13-threat-cavalry 1)
)
(defrule
    (or (players-unit-type-count any-enemy militiaman-line >= 5)
        (players-unit-type-count any-enemy spearman-line >= 5))
=>
    (set-goal df13-threat-infantry 1)
)
(defrule
    (or (players-unit-type-count any-enemy battering-ram-line >= 1)
        (or (players-unit-type-count any-enemy mangonel-line >= 1)
            (players-unit-type-count any-enemy scorpion-line >= 2)))
=>
    (set-goal df13-threat-siege 1)
)

; Clear remembered composition after confirmed pressure is gone and the
; relevant enemy mass has disappeared.
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy archer-line < 2)
    (players-unit-type-count any-enemy cavalry-archer-line < 2)
=>
    (set-goal df13-threat-archer 0)
)
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy scout-cavalry-line < 2)
    (players-unit-type-count any-enemy knight-line < 2)
=>
    (set-goal df13-threat-cavalry 0)
)
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy militiaman-line < 3)
    (players-unit-type-count any-enemy spearman-line < 3)
=>
    (set-goal df13-threat-infantry 0)
)
(defrule
    (goal df13-defense-state 0)
    (players-unit-type-count any-enemy battering-ram-line < 1)
    (players-unit-type-count any-enemy mangonel-line < 1)
    (players-unit-type-count any-enemy scorpion-line < 1)
=>
    (set-goal df13-threat-siege 0)
)

; Fortification memory. Once the enemy shows a serious fixed defence, keep the
; memory - siege remains strategically relevant for the rest of the game.
(defrule
    (or (players-building-type-count any-enemy castle >= 1)
        (or (players-building-type-count any-enemy stone-wall-line >= 5)
            (players-building-type-count any-enemy watch-tower-line >= 2)))
=>
    (set-goal df13-enemy-fortified 1)
)

; ---------------------------------------------------------------------------
; Defensive formation state.  No global retreat on town-under-attack.
; Villager garrison remains enabled and civilian militia is disabled.
; ---------------------------------------------------------------------------
(defrule
    (goal df13-defense-state 1)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 5)
    (set-strategic-number sn-maximum-defend-group-size 24)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 45)
    (set-strategic-number sn-number-civilian-militia 0)
    (set-strategic-number sn-disable-villager-garrison 0)
)

; Concentrated counterattack after a defended assault.  Two coherent groups,
; not one-unit trickles.
(defrule
    (goal df13-counterattack 1)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (military-population >= 12)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 2)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 70)
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 28)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 16)
    (set-strategic-number sn-percent-enemy-sighted-response 65)
    (set-strategic-number sn-enemy-sighted-response-distance 30)
)

; ---------------------------------------------------------------------------
; Recovery mode.  Economy still remains Resonance-owned; this layer only stops
; suicidal attacks and reconstructs indispensable infrastructure when possible.
; ---------------------------------------------------------------------------
(defrule
    (game-time > 900)
    (current-age >= castle-age)
    (or (building-type-count-total town-center < 1)
        (unit-type-count-total villager < 24))
=>
    (set-goal df13-recovery 1)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total town-center >= 1)
    (unit-type-count-total villager >= 32)
=>
    (set-goal df13-recovery 0)
)
(defrule
    (goal df13-recovery 1)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 20)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total town-center < 1)
    (up-pending-objects c: town-center < 1)
    (can-build town-center)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build town-center)
    (enable-timer df18-infra-timer 28)
)
(defrule
    (goal df13-recovery 1)
    (housing-headroom < 4)
    (up-pending-objects c: house < 1)
    (can-build house)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build house)
    (enable-timer df18-infra-timer 6)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total lumber-camp < 1)
    (up-pending-objects c: lumber-camp < 1)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)
(defrule
    (goal df13-recovery 1)
    (building-type-count-total mill < 1)
    (up-pending-objects c: mill < 1)
    (can-build mill)
=>
    (build mill)
)

; ---------------------------------------------------------------------------
; FIX08 military-collapse recovery.  This is intentionally separate from the
; economic recovery state above.  A healthy town that loses its army must not
; continue as a villager-only economy.  Thresholds scale with 125/150/200+.
; ---------------------------------------------------------------------------
(defrule
    (game-time > 900)
    (current-age >= castle-age)
    (goal df13-recovery 0)
    (goal df13-pop-profile 1)
    (civilian-population >= 28)
    (military-population < 8)
=>
    (set-goal df13-military-rebuild 1)
)
(defrule
    (game-time > 900)
    (current-age >= castle-age)
    (goal df13-recovery 0)
    (goal df13-pop-profile 2)
    (civilian-population >= 30)
    (military-population < 10)
=>
    (set-goal df13-military-rebuild 1)
)
(defrule
    (game-time > 900)
    (current-age >= castle-age)
    (goal df13-recovery 0)
    (goal df13-pop-profile 3)
    (civilian-population >= 32)
    (military-population < 12)
=>
    (set-goal df13-military-rebuild 1)
)

(defrule
    (goal df13-recovery 1)
    (goal df13-military-rebuild 1)
=>
    (set-goal df13-military-rebuild 0)
)
(defrule
    (goal df13-military-rebuild 1)
    (goal df13-pop-profile 1)
    (military-population >= 18)
=>
    (set-goal df13-military-rebuild 0)
)
(defrule
    (goal df13-military-rebuild 1)
    (goal df13-pop-profile 2)
    (military-population >= 24)
=>
    (set-goal df13-military-rebuild 0)
)
(defrule
    (goal df13-military-rebuild 1)
    (goal df13-pop-profile 3)
    (military-population >= 30)
=>
    (set-goal df13-military-rebuild 0)
)

; Rebuild posture: no fresh offensive groups until a useful field force exists.
(defrule
    (goal df13-military-rebuild 1)
=>
    ; FIX22 ATTACK OWNER retired: (set-goal createarmy 1)
    (set-goal balancedarmy 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 4)
    (set-strategic-number sn-maximum-defend-group-size 20)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
)

; Recreate basic mixed-production infrastructure if it was destroyed.
(defrule
    (goal df13-military-rebuild 1)
    (building-type-count-total barracks < 1)
    (wood-amount > 170)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build barracks)
    (enable-timer df18-infra-timer 12)
)
(defrule
    (goal df13-military-rebuild 1)
    (building-type-count-total archery-range < 1)
    (wood-amount > 190)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build archery-range)
    (enable-timer df18-infra-timer 12)
)
(defrule
    (goal df13-military-rebuild 1)
    (building-type-count-total stable < 1)
    (wood-amount > 190)
    (up-pending-objects c: stable < 1)
    (can-build stable)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build stable)
    (enable-timer df18-infra-timer 12)
)

; Mixed emergency reserve.  These are floors, not a rigid army template.
; Normal civ strategy and threat counters continue to add appropriate units.
(defrule
    (goal df13-military-rebuild 1)
    (unit-type-count-total militiaman-line < 6)
    (food-amount > 140)
    (gold-amount > 60)
=>
    (set-goal df13-militia-request 1)
)
(defrule
    (goal df13-military-rebuild 1)
    (unit-type-count-total spearman-line < 6)
    (food-amount > 120)
    (wood-amount > 90)
=>
    (set-goal df13-spearman-request 1)
)
(defrule
    (goal df13-military-rebuild 1)
    (unit-type-count-total archer-line < 6)
    (wood-amount > 130)
    (gold-amount > 70)
=>
    (set-goal df13-archer-request 1)
)
(defrule
    (goal df13-military-rebuild 1)
    (unit-type-count-total knight-line < 4)
    (food-amount > 180)
    (gold-amount > 120)
=>
    (set-goal df13-knight-request 1)
)

; ---------------------------------------------------------------------------
; Fortress footprint and wall doctrine.
;
; FIX05 replay finding: on Archipelago, P1 issued 0 wall commands and P3 did
; not issue its first wall command until 17:41, 2:40 after Castle Age.  The old
; Feudal trigger waited for BOTH Market + Blacksmith + >210 wood.  In the
; replay that left only ~51-56 seconds between the Blacksmith and Castle Age.
;
; FIX10: Fortress owns its wall planners on every map size.
; ResonanceBot only enabled wall placement 2 on maps larger than Medium, which
; silently disabled our Tiny/Small/Medium Fortress wall rules.
(defrule
    (true)
=>
    (enable-wall-placement 1)
    (enable-wall-placement 2)
    (set-goal wall DONT-BUILD-WALL)
    (set-goal buildwalls 0)
    (disable-self)
)


; FIX17: during Feudal, inherited Resonance stone-wall goals stay off so the
; palisade planner is not displaced before it has a legal capture window.
(defrule
    (current-age == feudal-age)
=>
    (set-goal wall DONT-BUILD-WALL)
    (set-goal buildwalls 0)
)
(defrule
    (current-age >= castle-age)
    (goal buildwalls 0)
=>
    (enable-wall-placement 1)
    (enable-wall-placement 2)
    (set-goal wall BUILD-WALL)
    (set-goal buildwalls 1)
)

; New invariant: every Fortress instance attempts at least one palisade wall
; command during Feudal Age.  The first footprint is deliberately compact so
; islands/coasts have a much better chance of producing a valid partial wall.
; After the first command, town size expands again.  Feudal continuation is
; capped at 35% so the wall cannot eat the full Castle-age economy.
; ---------------------------------------------------------------------------
(defrule
    (current-age == feudal-age)
    (goal df13-wall-bootstrap 0)
=>
    (set-strategic-number sn-minimum-town-size 6)
    (set-strategic-number sn-maximum-town-size 12)
    (set-strategic-number sn-safe-town-size 10)
)
(defrule
    (current-age == feudal-age)
    (goal df13-wall-bootstrap 1)
=>
    (set-strategic-number sn-minimum-town-size 6)
    (set-strategic-number sn-maximum-town-size 13)
    (set-strategic-number sn-safe-town-size 11)
)
(defrule
    (current-age == castle-age)
    (building-type-count-total town-center < 2)
=>
    (set-strategic-number sn-minimum-town-size 9)
    (set-strategic-number sn-maximum-town-size 21)
    (set-strategic-number sn-safe-town-size 17)
)
(defrule
    (current-age == castle-age)
    (building-type-count-total town-center >= 2)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 27)
    (set-strategic-number sn-safe-town-size 21)
)
(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 31)
    (set-strategic-number sn-safe-town-size 24)
)

; ---------------------------------------------------------------------------
; Additive fortress expansion.  The replay-approved first wall geometry stays
; unchanged.  Only a mature fortress unlocks a larger envelope.  Re-enabling
; perimeter 2 recalculates it farther out while all existing wall segments stay.
; ---------------------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (goal df13-wall-expansion-stage 0)
    (building-type-count-total town-center >= 2)
    (building-type-count-total stone-wall-line >= 8)
    (civilian-population >= 55)
    (wall-completed-percentage 1 >= 80)
    (wall-completed-percentage 2 >= 65)
=>
    (set-goal df13-wall-expansion-stage 1)
    (enable-wall-placement 2)
)
(defrule
    (current-age >= castle-age)
    (goal df13-wall-expansion-stage 1)
    (building-type-count-total stone-wall-line >= 14)
    (civilian-population >= 70)
    (wall-completed-percentage 2 >= 80)
=>
    (set-goal df13-wall-expansion-stage 2)
    (enable-wall-placement 2)
)
(defrule
    (current-age == imperial-age)
    (goal df13-wall-expansion-stage 2)
    (building-type-count-total stone-wall-line >= 20)
    (civilian-population >= 85)
    (wall-completed-percentage 2 >= 82)
=>
    (set-goal df13-wall-expansion-stage 3)
    (enable-wall-placement 2)
)
(defrule
    (current-age == imperial-age)
    (goal df13-wall-expansion-stage 3)
    (building-type-count-total stone-wall-line >= 28)
    (civilian-population >= 100)
    (wall-completed-percentage 2 >= 85)
=>
    (set-goal df13-wall-expansion-stage 4)
    (enable-wall-placement 2)
)

; Maintenance rules run after the baseline footprint rules above.  Thus the
; initial wall stays the approved size, but later expansions can grow outward.
(defrule
    (goal df13-wall-expansion-stage 1)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 31)
    (set-strategic-number sn-safe-town-size 24)
)
(defrule
    (goal df13-wall-expansion-stage 2)
=>
    (set-strategic-number sn-minimum-town-size 11)
    (set-strategic-number sn-maximum-town-size 35)
    (set-strategic-number sn-safe-town-size 28)
)
(defrule
    (goal df13-wall-expansion-stage 3)
=>
    (set-strategic-number sn-minimum-town-size 12)
    (set-strategic-number sn-maximum-town-size 39)
    (set-strategic-number sn-safe-town-size 31)
)
(defrule
    (goal df13-wall-expansion-stage 4)
=>
    (set-strategic-number sn-minimum-town-size 13)
    (set-strategic-number sn-maximum-town-size 43)
    (set-strategic-number sn-safe-town-size 34)
)

; FIX16 CRASH-SAFE WALL PLANNER
; The crash replay is structurally intact but ends abruptly at 22:28.45.  It
; contains no Fortress WALL action at all.  FIX15's direct 25-second retries
; could therefore keep entering the HD wall planner without a successful plan.
; FIX16 never calls build-wall blindly: every new call is guarded by a planner
; predicate, and geometry changes are one-way stages rather than a tight timer.
;
; A real completed segment, not an issued command or a default planner
; percentage, confirms that the fortress wall bootstrap exists.
(defrule
    (goal df13-wall-bootstrap 0)
    (building-type-count-total palisade-wall >= 1)
=>
    (set-goal df13-wall-bootstrap 1)
)
(defrule
    (goal df13-wall-bootstrap 0)
    (building-type-count-total stone-wall-line >= 1)
=>
    (set-goal df13-wall-bootstrap 1)
)

; Stage 1: compact but useful Feudal envelope.  This is difficulty-independent:
; Standard/Moderate keeps the same ability to establish a defensive wall.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 25)
    (goal df13-wall-bootstrap 0)
    (goal df16-wall-stage 0)
=>
    (set-strategic-number sn-minimum-town-size 8)
    (set-strategic-number sn-maximum-town-size 18)
    (set-strategic-number sn-safe-town-size 14)
    (enable-wall-placement 1)
    (set-goal df16-wall-stage 1)
)

; Stage 2: if the compact envelope still has no segment, widen it once.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 100)
    (goal df13-wall-bootstrap 0)
    (goal df16-wall-stage 1)
=>
    (set-strategic-number sn-minimum-town-size 9)
    (set-strategic-number sn-maximum-town-size 22)
    (set-strategic-number sn-safe-town-size 17)
    (enable-wall-placement 2)
    (set-goal df16-wall-stage 2)
)

; Stage 3: final Feudal geometry fallback for blocked/coastal/large starts.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 180)
    (goal df13-wall-bootstrap 0)
    (goal df16-wall-stage 2)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 26)
    (set-strategic-number sn-safe-town-size 20)
    (enable-wall-placement 1)
    (enable-wall-placement 2)
    (set-goal df16-wall-stage 3)
)

; Castle transition gets one safe planner refresh and a wider stone envelope.
; Exact-stage OR tests are used because relational goal tests broke the HD
; parser in FIX07.
(defrule
    (current-age >= castle-age)
    (goal df13-wall-bootstrap 0)
    (or (goal df16-wall-stage 0) (goal df16-wall-stage 1))
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 27)
    (set-strategic-number sn-safe-town-size 21)
    (enable-wall-placement 1)
    (enable-wall-placement 2)
    (set-goal wall BUILD-WALL)
    (set-goal buildwalls 1)
    (set-goal df16-wall-stage 4)
)
(defrule
    (current-age >= castle-age)
    (goal df13-wall-bootstrap 0)
    (or (goal df16-wall-stage 2) (goal df16-wall-stage 3))
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 27)
    (set-strategic-number sn-safe-town-size 21)
    (enable-wall-placement 1)
    (enable-wall-placement 2)
    (set-goal wall BUILD-WALL)
    (set-goal buildwalls 1)
    (set-goal df16-wall-stage 4)
)

; Planner-guarded Feudal attempts.  Placement 1 is the normal inner line;
; placement 2 is a fallback only after the geometry has widened.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #5.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #6.

; Stable Resonance-style affordability fact is a late Feudal fallback.  Unlike
; FIX15's direct retry, this asks the planner for a complete affordable line
; before build-wall is issued.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #7.

; Castle stone fallback remains planner-gated.  The inherited wall/buildwalls
; goals are also active now, providing the proven Resonance stone-wall path.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #8.

; Mandatory safe Feudal bootstrap.  FIX16 keeps the affordability-aware
; paths as secondary helpers; success still requires a real wall segment.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #9.

; If the safe attempt had no window, retry after two Feudal minutes even under
; pressure.  This is the hard invariant requested for Fortress behaviour.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #10.

; Island/coast fallback: if wall placement 1 cannot find a legal segment, try
; placement 2 before leaving Feudal Age.  This is still only a bootstrap command.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #11.

; A limited Feudal continuation: enough to create a meaningful partial barrier
; without forcing a complete enclosure before the Castle transition.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #12.

; FIX10 pressure fallback: after three Feudal minutes the inner line keeps
; growing even while the town is under pressure.  This prevents a permanently
; abandoned 1-2 segment "bootstrap" wall.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #13.


; Castle fallback if terrain/resource timing prevented the Feudal command.
; Stone is preferred immediately.  Palisade is allowed only as a last emergency
; if NO wall bootstrap exists and stone is still unavailable; it never replaces
; or overwrites an existing stone defense.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #14.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #15.

; In Castle Age the developed inner barrier is stone-only.  Low stone delays
; further construction rather than downgrading a stone wall to palisade.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #16.

; Finish the inner line later when spare resources exist.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #17.

; Outer ring / expansion security.  The original inner wall is never removed.
; Once Castle Age is established, placement 2 is another stone security line.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #18.

; Enlarged perimeter 2 closes the next additive stone layer.  Because the old
; perimeter is never deleted, repeated mature expansions produce double/triple
; and, on very large late bases, deeper defensive rings.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #19.

; Controlled gates appear as soon as a useful section of wall exists.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #20.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #21.


; Serious path/access stress.  We deliberately ignore small detours.  Resource
; walking distances must be far above the normal dropsite targets before an
; extra gate is allowed.  This is a cheap legacy-HD proxy for a blocked/very
; indirect villager route and avoids running expensive pathfinding every pass.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #22.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #23.

; Large additive layers receive more controlled access points even when no
; wall segment is removed.  This prevents a huge late ring from forcing a
; villager to walk across half the fortress to the only gate.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #24.
; FIX18 SINGLE WALL OWNER: retired inherited wall/gate issuer #25.

; ---------------------------------------------------------------------------
; Observation network.  Local eyes first, forward eyes only after the economy
; is developed.  Targets: 2 Dark, 4 Feudal, 8 Castle, 15 Imperial on Hardest.
; ---------------------------------------------------------------------------

; FIX15: the replay produced exactly two Watch Towers for every Fortress AI.
; Enforce the intended four-tower Feudal defensive floor independently of
; whether the town is already under attack.
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (current-age-time >= 75)
    (building-type-count-total watch-tower-line < 4)
    (stone-amount > 100)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

; Local observation envelope sits three town-size steps inside the local wall:
; Dark Outposts 9 versus the 12-point bootstrap wall, Feudal local Outposts 10
; versus the compact 13-point inner palisade envelope.  Wall rules occur earlier in the
; pass, so the replay-approved wall geometry itself is not enlarged here.


(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 330)
    (building-type-count-total df13-outpost < 1)
    (wood-amount > 120)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == dark-age)
    (game-time > 480)
    (building-type-count-total df13-outpost < 2)
    (wood-amount > 150)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == feudal-age)
    (building-type-count-total df13-outpost < 4)
    (wood-amount > 170)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == castle-age)
    (building-type-count-total df13-outpost < 8)
    (wood-amount > 210)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build-forward df13-outpost)
)
(defrule
    (difficulty == hardest)
    (current-age == imperial-age)
    (building-type-count-total df13-outpost < 15)
    (wood-amount > 260)
    (up-pending-objects c: df13-outpost < 1)
    (can-build df13-outpost)
=>
    (build-forward df13-outpost)
)

; Combat towers face confirmed danger but never consume the opening economy.
(defrule
    (difficulty == hardest)
    (current-age >= feudal-age)
    (goal df13-defense-state 1)
    (building-type-count-total watch-tower-line < 2)
    (stone-amount > 220)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build-forward watch-tower-line)
)
(defrule
    (difficulty == hardest)
    (current-age >= castle-age)
    (goal df13-enemy-fortified 1)
    (building-type-count-total watch-tower-line < 5)
    (stone-amount > 320)
    (up-pending-objects c: watch-tower-line < 1)
    (can-build watch-tower-line)
=>
    (build-forward watch-tower-line)
)

; ---------------------------------------------------------------------------
; Opportunistic Castles.  No dedicated saving / stone escrow.  'can-build'
; itself is the affordability test.
; ---------------------------------------------------------------------------
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (goal df13-recovery 0)
    (not (town-under-attack))
    (goal df13-aftershock 1)
    (can-build castle)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (set-goal df13-castle-opportunity 1)
    (build-forward castle)
    (enable-timer df18-infra-timer 35)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (building-type-count-total town-center >= 2)
    (wall-completed-percentage 1 >= 50)
    (goal df13-recovery 0)
    (not (town-under-attack))
    (can-build castle)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (set-goal df13-castle-opportunity 1)
    (build castle)
    (enable-timer df18-infra-timer 35)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle >= 1)
    (building-type-count-total castle < 2)
    (building-type-count-total town-center >= 2)
    (goal df13-enemy-fortified 1)
    (goal df13-recovery 0)
    (not (town-under-attack))
    (can-build castle)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build-forward castle)
    (enable-timer df18-infra-timer 35)
)

; ---------------------------------------------------------------------------
; Civilization-aware production infrastructure.  ResonanceBot already selects
; makecavalry/makearchers/makeinfantry/makesiege by civ and strategy, so V13
; uses those proven goals instead of duplicating a second civ classifier.
; ---------------------------------------------------------------------------
(defrule
    (current-age == feudal-age)
    (goal makecavalry 1)
    (building-type-count-total stable < 1)
    (wood-amount > 150)
    (up-pending-objects c: stable < 1)
    (can-build stable)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build stable)
    (enable-timer df18-infra-timer 12)
)
(defrule
    (current-age == feudal-age)
    (goal makearchers 1)
    (building-type-count-total archery-range < 1)
    (wood-amount > 150)
    (up-pending-objects c: archery-range < 1)
    (can-build archery-range)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build archery-range)
    (enable-timer df18-infra-timer 12)
)
(defrule
    (current-age >= feudal-age)
    (goal makeinfantry 1)
    (building-type-count-total barracks < 2)
    (wood-amount > 170)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (build barracks)
    (enable-timer df18-infra-timer 12)
)

