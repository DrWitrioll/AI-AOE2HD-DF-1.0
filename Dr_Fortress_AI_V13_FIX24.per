(defrule
(game-time > 150)
(game-time < 900) 
(goal nomadstart 0)
(or(cc-players-building-type-count any-enemy dock >= 3)
(or(cc-players-unit-type-count any-enemy fire-ship-line >= 3)
(or(cc-players-unit-type-count any-enemy galley-line >= 4)
(cc-players-unit-type-count any-human galley-line >= 1))))
(cc-players-building-type-count every-enemy dock >= 1)
(cc-players-unit-type-count 0 sea-fish >= 16)
(cc-players-unit-type-count 0 shore-fish >= 6)
=>
(set-goal water-map 1)
;(chat-to-all "[FORTRESS] Operational message: DEBUG: Water Map Detected.")
(disable-self)
)

(defrule
(game-time > 120)
(game-time < 720)
(goal nomadstart 1)
(or(cc-players-building-type-count any-enemy dock >= 1) ;added
(map-type nomad))										;added
(or(cc-players-building-type-count every-enemy dock >= 1)
(cc-players-unit-type-count 0 sea-fish >= 16))
(cc-players-unit-type-count 0 shore-fish >= 6)
=>
(set-goal water-map 1)
;(chat-to-all "[FORTRESS] Operational message: DEBUG: Water Map Detected.")
(disable-self)
)

