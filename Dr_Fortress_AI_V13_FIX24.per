;============Taunts and Chats===============

(defrule
(game-time >= 30)
(game-time < 50)
(goal allowchats 1)
=>
(chat-to-all "[FORTRESS] [CMD-39] Doktor Fortress AI command core online. Tactical chat channel enabled.")
(chat-to-all "[FORTRESS] Random Map doctrine active; standard resources and a normal starting age are expected.")
;(chat-to-all "[FORTRESS] Operational message: Doktor Fortress project created me to be a flexible, challenging, and helpful AI.")
(disable-self)
)

(defrule
(game-time >= 90) ;previously 70
;(game-time < 300)
(taunt-detected any-human 205)
;(goal chatadvice 1)
(goal chatintroduction 1)
=>
(chat-to-all "[FORTRESS] This build is part of the Doktor Fortress AI development line.")
(chat-to-all "[FORTRESS] Use the in-game chat menu for the supported command interface.")
(chat-to-all "[FORTRESS] Command 40 raises the active difficulty profile by one half-step.")
(chat-to-all "[FORTRESS] Command 42 changes the active strategy profile; command 201 provides guidance.")
(disable-timer 41)
(enable-timer 41 30)
(acknowledge-taunt this-any-human 205)
;(disable-self)
)

(defrule
(game-time >= 110) ;previously 90
;(game-time < 300)
;(goal chatadvice 1)
(goal chatintroduction 1)
(timer-triggered 41)
(or(difficulty == easiest)
(or(difficulty == easy)
(difficulty == moderate)))
=>
(chat-to-enemies "[FORTRESS/ENEMY] On Easiest and Standard, offensive pressure is deliberately delayed.")
(chat-to-enemies "[FORTRESS/ENEMY] On Moderate, fewer restraints apply and an early attack is possible.")
(chat-to-enemies "[FORTRESS/ENEMY] A stable economy and consistent villager production are the key to defeating this AI.")
(chat-to-enemies "[FORTRESS/ENEMY] Use the project documentation for the complete command reference.")
(enable-timer 42 30)
(disable-timer 41)
;(disable-self)
)

(defrule
(game-time >= 110) ;previously 90
;(game-time < 300)
;(goal chatadvice 1)
(timer-triggered 41)
(goal chatintroduction 1)
(or(difficulty <= hardest)
(difficulty == hard))
=>
(chat-to-enemies "[FORTRESS/ENEMY] Legacy inherited difficulty compensation may activate on Hard and Hardest.")
(chat-to-enemies "[FORTRESS/ENEMY] That inherited compensation exists to offset limitations in the legacy AI engine.")
(chat-to-enemies "[FORTRESS/ENEMY] The difficulty model is intended to remain beatable with normal play.")
(chat-to-enemies "[FORTRESS/ENEMY] Use the project documentation for the complete command reference.")
(enable-timer 42 30)
(disable-timer 41)
;(disable-self)
)

