;==============Market Trading, Buy and Sell==========
; FIX21 ECONOMY GOVERNOR: retired inherited broad Market buy/sell rule pile.
; The old section could fire many independent transactions from overlapping scarcity
; tests.  A single throttled emergency stabilizer is installed in the final FIX21 layer.

;=======TributeRules======================

(defrule
	(or(research-completed ri-coinage)
	(current-age >= castle-age))
	(taunt-detected any-ally 3)
	(food-amount > 250) ;previously 400
=>
	(acknowledge-taunt this-any-ally 3)
	(tribute-to-player this-any-ally food 200)
)

(defrule
	(or(research-completed ri-coinage)
	(current-age >= castle-age))
	(taunt-detected any-ally 4)
	(wood-amount > 300) ;previously 500
=>
	(acknowledge-taunt this-any-ally 4)
	(tribute-to-player this-any-ally wood 200)
)

(defrule
	(or(research-completed ri-coinage)
	(current-age >= castle-age))
	(taunt-detected any-ally 5)
	(gold-amount > 250) ;previously 400
=>
	(acknowledge-taunt this-any-ally 5)
	(tribute-to-player this-any-ally gold 200)
)

