;========Build a Town Center=========

;The only resource cheat for lower Difficulties. 

; FIX18 NO-CHEAT: retired inherited resource-creation rule #2.

; FIX18 NO-CHEAT: retired inherited resource-creation rule #3.

; FIX18 NO-CHEAT: retired inherited resource-creation rule #4.


; ===========================================================================
; FIX11 explicit state initialization.  HD normally starts goals at zero, but
; explicit initialization keeps this layer deterministic across compatible
; parser/runtime variants and prevents a stale throttle from blocking farms.
; ===========================================================================
(defrule
    (game-time < 5)
=>
    (set-goal df13-farm-throttle 0)
    (set-goal df11-dock-throttle 0)
    (set-goal df11-miner-recovery 0)
    (set-goal df11-scout-recovery 0)
    (set-goal df11-civilian-danger 0)
    (set-goal df11-naval-recovery 0)
    (set-goal df11-threat-sample 0)
    (set-goal df11-threat-time 9999)
    (set-goal df11-threat-player 0)
    (set-goal df11-threat-source 0)
    (set-goal df11-threat-target 0)
    (disable-self)
)

; ===========================================================================
; FIX11 FARM MANAGER 2.0
; 0-10 farms: hold ~3 reseeds (180W), 11-18: 4 (240W), 19+: 5 (300W).
; This is a SOFT reserve: food below 200 immediately releases the hold.
; The reserve does not emulate the Mill reseed button; it prevents the AI from
; consuming its entire wood bank once a healthy farm economy exists.
; ===========================================================================
(defrule
    (goal df13-farm-throttle 0)
    (food-amount >= 200)
    (building-type-count-total farm <= 10)
    (wood-amount < 180)
=>
    (set-goal df13-farm-throttle 2)
)
(defrule
    (goal df13-farm-throttle 0)
    (food-amount >= 200)
    (building-type-count-total farm >= 11)
    (building-type-count-total farm <= 18)
    (wood-amount < 240)
=>
    (set-goal df13-farm-throttle 2)
)
(defrule
    (goal df13-farm-throttle 0)
    (food-amount >= 200)
    (building-type-count-total farm >= 19)
    (wood-amount < 300)
=>
    (set-goal df13-farm-throttle 2)
)

; Critical-food override.  Example: 150 food with a nominal 240W reserve still
; allows farm construction as soon as an inherited farm rule can actually pay.
(defrule
    (goal df13-farm-throttle 2)
    (food-amount < 200)
=>
    (set-goal df13-farm-throttle 0)
)
(defrule
    (goal df13-farm-throttle 2)
    (building-type-count-total farm <= 10)
    (wood-amount >= 180)
=>
    (set-goal df13-farm-throttle 0)
)
(defrule
    (goal df13-farm-throttle 2)
    (building-type-count-total farm >= 11)
    (building-type-count-total farm <= 18)
    (wood-amount >= 240)
=>
    (set-goal df13-farm-throttle 0)
)
(defrule
    (goal df13-farm-throttle 2)
    (building-type-count-total farm >= 19)
    (wood-amount >= 300)
=>
    (set-goal df13-farm-throttle 0)
)

(defrule 
(game-time > 3600)
(building-type-count town-center >= 1)
(building-type-count farm <= 10)
(can-build farm)
(goal df13-farm-throttle 0)
=> 
(build farm)
(set-goal df13-farm-throttle 1)
(enable-timer df13-farm-timer 8)
)

