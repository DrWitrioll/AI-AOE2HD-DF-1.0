(defrule
	(or(game-time > 3000)
	(or(current-age == imperial-age)
	(civilian-population >= 80)))
	(wood-amount > 300)
	(players-building-type-count any-ally market >= 1)
	(players-building-type-count any-ally dock >= 1)
	(can-train-with-escrow trade-cog)
	(unit-type-count-total trade-cog < 3)
=>
	(release-escrow wood)
	(release-escrow gold)
	(train trade-cog)
)

#end-if
#end-if

(defrule
	(or(current-age == imperial-age)
	(civilian-population >= 80))
	(goal water-map 1)
	(wood-amount > 300)
	(players-building-type-count any-ally market >= 1)
	(players-building-type-count any-ally dock >= 1)
	(can-train trade-cog)
	(unit-type-count-total trade-cog < 5)
=>
	(train trade-cog)
)

(defrule
	(or(current-age == imperial-age)
