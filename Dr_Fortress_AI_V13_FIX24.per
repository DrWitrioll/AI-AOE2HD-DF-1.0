; ============================================================================
; FIX18 DETERMINISTIC TIER RESERVATION DISPATCHER
; ============================================================================
; Middle tiers are the standing-army backbone. A researched reserved tier waits
; for legitimate resources; a cheap base model cannot steal that request.
; This deliberately slows the no-cheat economy while improving army quality.

; Defensive production continuity from FIX17. Defense stops attacks, not factories.
(defrule
    (goal df13-defense-state 1)
=>
    ; FIX22 ATTACK OWNER retired: (set-goal createarmy 1)
    (set-goal df22-retired-sink 0)
)
(defrule
    (goal df13-defense-state 1)
    (up-timer-status df17-defense-timer == timer-disabled)
=>
    (enable-timer df17-defense-timer 1)
)
(defrule
    (goal df13-defense-state 1)
    (timer-triggered df17-defense-timer)
    (military-population < 45)
=>
    (set-goal df13-militia-request 1)
    (set-goal df13-spearman-request 1)
    (set-goal df13-archer-request 1)
    (set-goal df13-skirmisher-request 1)
)
(defrule
    (goal df13-defense-state 1)
    (timer-triggered df17-defense-timer)
    (current-age >= castle-age)
    (military-population < 40)
=>
    (set-goal df13-knight-request 1)
    (set-goal df13-scout-request 1)
    (set-goal df13-mangonel-request 1)
)
(defrule
    (goal df13-defense-state 1)
    (timer-triggered df17-defense-timer)
=>
    (disable-timer df17-defense-timer)
    (enable-timer df17-defense-timer 10)
)
(defrule
    (goal df13-defense-state 0)
    (timer-triggered df17-defense-timer)
=>
    (disable-timer df17-defense-timer)
)

; ============================================================================
; FIX20 POSTURE-WEIGHTED SHORT-CYCLE TIER DISPATCHER
; ============================================================================
; Posture is now active control, not a dead label. Recovery/defense/low army => cheap+middle;
; standing => middle backbone; prepared Fortress Assault => middle+elite.
(defrule
    (or (goal df13-recovery 1) (or (goal df13-military-rebuild 1) (or (goal df13-defense-state 1) (military-population < 14))))
=>
    (set-goal df15-tier-posture 1)
)
(defrule
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (military-population >= 14)
=>
    (set-goal df15-tier-posture 2)
)
(defrule
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 1)
    (military-population >= 18)
=>
    (set-goal df15-tier-posture 3)
)

; --- FIX20 Militia line: requested standing sequence Long / adjacent / Long / Champion / Long / Militiaman. ---
(defrule
    (goal df13-militia-request 1)
    (goal df15-tier-posture 1)
    (goal df18-militia-cycle 0)
    (research-completed ri-long-swordsman)
    (food-amount > 75)
    (gold-amount > 35)
=>
    (train long-swordsman)
    (set-goal df13-militia-request 0)
    (set-goal df18-militia-cycle 1)
)
(defrule
    (goal df13-militia-request 1)
    (goal df15-tier-posture 1)
    (goal df18-militia-cycle 0)
    (not (research-completed ri-long-swordsman))
    (research-completed ri-man-at-arms)
    (food-amount > 65)
    (gold-amount > 30)
=>
    (train man-at-arms)
    (set-goal df13-militia-request 0)
    (set-goal df18-militia-cycle 1)
)
(defrule
    (goal df13-militia-request 1)
    (goal df15-tier-posture 1)
    (goal df18-militia-cycle 0)
    (not (research-completed ri-long-swordsman))
    (not (research-completed ri-man-at-arms))
    (can-train militiaman)
=>
    (train militiaman)
    (set-goal df13-militia-request 0)
    (set-goal df18-militia-cycle 1)
)
(defrule
    (goal df13-militia-request 1)
    (goal df15-tier-posture 1)
    (goal df18-militia-cycle 1)
    (research-completed ri-man-at-arms)
    (food-amount > 65)
    (gold-amount > 30)
=>
    (train man-at-arms)
    (set-goal df13-militia-request 0)
    (set-goal df18-militia-cycle 2)
)
(defrule
    (goal df13-militia-request 1)
    (goal df15-tier-posture 1)
    (goal df18-militia-cycle 1)
    (not (research-completed ri-man-at-arms))
    (can-train militiaman)
=>
    (train militiaman)
    (set-goal df13-militia-request 0)
    (set-goal df18-militia-cycle 2)
)
(defrule
    (goal df13-militia-request 1)
    (goal df15-tier-posture 1)
    (goal df18-militia-cycle 2)
    (research-completed ri-long-swordsman)
    (food-amount > 75)
    (gold-amount > 35)
=>
    (train long-swordsman)
    (set-goal df13-militia-request 0)
    (set-goal df18-militia-cycle 3)
)
(defrule
    (goal df13-militia-request 1)
