(defrule 
(goal earlyresign 1)
(goal teamplay 0)
(game-time > 3060)
(difficulty == easiest)
(building-type-count wonder < 1)
(unit-type-count-total villager < 15)
(military-population <= 10)
(player-resigned any-computer-ally)
(up-timer-status 30 == timer-disabled)
(up-timer-status 31 == timer-disabled)
=> 
(chat-to-all "[FORTRESS] [CMD-9] My allied support is gone and the strategic situation is no longer recoverable.")
(chat-to-all "[FORTRESS] My position is no longer recoverable. Do you accept my surrender?")
(chat-to-all "[FORTRESS] Respond through the Chat Menu with command 1 or 2.")
(enable-timer 30 35)
(disable-self)
)

