; --- FIX18 generic unique-unit request. ---
(defrule
    (goal df13-unique-request 1)
    (can-train my-unique-unit-line)
=>
    (train my-unique-unit-line)
    (set-goal df13-unique-request 0)
)
(defrule
    (goal df13-unique-request 1)
    (not (can-train my-unique-unit-line))
    (can-train my-unique-unit)
=>
    (train my-unique-unit)
    (set-goal df13-unique-request 0)
)

; ============================================================================
; End V13 FIX10 additions.
; ============================================================================


; ===========================================================================
; FIX11 SAFE RECOVERY LAYER - HD/UserPatch commands only, no direct search DUC
; ===========================================================================

; ---- Dock placement cooldown / blocked-placement retry ----
(defrule
    (goal df11-dock-throttle 1)
    (timer-triggered df11-dock-timer)
    (up-pending-objects c: dock < 1)
=>
    (set-goal df11-dock-throttle 0)
    (disable-timer df11-dock-timer)
)
(defrule
    (goal df11-dock-throttle 1)
    (timer-triggered df11-dock-timer)
    (up-pending-objects c: dock > 0)
=>
    ; FIX12: unsupported up-reset-placement removed; cooldown will allow retry.
    (set-goal df11-dock-throttle 0)
    (disable-timer df11-dock-timer)
)

; ---- FIX13 HD compatibility rollback ----
; The actual AoE2 HD parser rejected up-idle-unit-count (ERR2004).
; To avoid serial parser failures, every executable identifier introduced by FIX11
; that was absent from the known-good FIX10 vocabulary is disabled here as one
; compatibility unit: stuck-gatherer sampling, threat sampling, civilian-danger
; sampling, and wounded-scout recovery.  Core FIX10 systems and the safe FIX11
; additions that use only FIX10-proven identifiers remain active.

; ---- Naval Explorer Recovery ----
; No direct ship deletion.  With enemy water assets, release boats to inherited
; attack/defense grouping.  Otherwise keep one periodic water explorer moving.
(defrule
    (game-time > 120)
    (goal df11-naval-recovery 0)
    (warboat-count > 0)
=>
    (set-goal df11-naval-recovery 1)
    (enable-timer df11-naval-timer 35)
)
(defrule
    (goal df11-naval-recovery 1)
    (or (players-building-type-count any-enemy dock > 0)
        (or (players-unit-type-count any-enemy galley-line > 0)
            (or (players-unit-type-count any-enemy fire-ship-line > 0)
                (or (players-unit-type-count any-enemy demolition-ship-line > 0)
                    (players-unit-type-count any-enemy cannon-galleon-line > 0)))))
=>
    (set-strategic-number sn-number-boat-explore-groups 0)
)
(defrule
    (goal df11-naval-recovery 1)
    (timer-triggered df11-naval-timer)
    (players-building-type-count any-enemy dock < 1)
    (players-unit-type-count any-enemy galley-line < 1)
    (players-unit-type-count any-enemy fire-ship-line < 1)
    (players-unit-type-count any-enemy demolition-ship-line < 1)
    (players-unit-type-count any-enemy cannon-galleon-line < 1)
=>
    (set-strategic-number sn-number-boat-explore-groups 1)
    (set-strategic-number sn-minimum-boat-explore-group-size 1)
    (set-strategic-number sn-maximum-boat-explore-group-size 1)
    (up-send-scout df11-water-explore-group scout-opposite)
    (disable-timer df11-naval-timer)
    (enable-timer df11-naval-timer 35)
)
(defrule
    (goal df11-naval-recovery 1)
    (timer-triggered df11-naval-timer)
=>
    (disable-timer df11-naval-timer)
    (enable-timer df11-naval-timer 35)
)
(defrule
    (goal df11-naval-recovery 1)
    (warboat-count < 1)
=>
    (set-goal df11-naval-recovery 0)
    (disable-timer df11-naval-timer)
)

; ============================================================================
; FIX17 FINAL DIFFICULTY / TEAM / BREACH OVERRIDES
; ============================================================================
; Correct HD mapping: easy=Standard, moderate=Moderate.  Walls are not weakened.
(defrule
    (difficulty == easy)
    (goal df13-defense-state 0)
    (soldier-count < 12)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)
(defrule
    (difficulty == easy)
    (goal df13-defense-state 0)
    (soldier-count >= 12)
    (soldier-count < 28)
=>
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 16)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 55)
)
(defrule
    (difficulty == easy)
    (goal df13-defense-state 0)
    (soldier-count >= 28)
=>
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 22)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 65)
)
(defrule
    (difficulty == moderate)
    (goal df13-defense-state 0)
    (soldier-count < 14)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)
(defrule
    (difficulty == moderate)
    (goal df13-defense-state 0)
    (soldier-count >= 14)
    (soldier-count < 32)
=>
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 20)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 65)
)
(defrule
    (difficulty == moderate)
    (goal df13-defense-state 0)
    (soldier-count >= 32)
=>
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 24)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 2)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 72)
)

; A threatened Fortress keeps factories alive but does not launch offensive groups.
(defrule
    (goal df13-defense-state 1)
=>
    ; FIX22 ATTACK OWNER retired: (set-goal createarmy 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 100)
)

; Team help begins in Feudal, not after 25-30 minutes.  This shares legitimate
; sighted target pressure; it does not grant map vision or resources.
(defrule
    (current-age >= feudal-age)
    (or (goal aiteammate 1) (goal teamplay 1))
    (military-population >= 8)
=>
    (set-strategic-number sn-target-evaluation-ally-proximity 220)
    (set-strategic-number sn-coop-share-attacking 1)
)

; Early scout stays local longer.  Captured livestock is then automatically
; brought home by the proven livestock SN.  No unsupported direct-search DUC.
(defrule
    (current-age <= feudal-age)
    (game-time < 480)
    (unit-type-count-total scout-cavalry >= 1)
=>
    (set-strategic-number sn-home-exploration-time 480)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-livestock-to-town-center 1)
)

; Breach -> exploitation cycle.  Once siege has had a wall-opening window, the
; army spends time exploiting the opening instead of automatically chewing every
; adjacent wall segment.  If fortifications remain, another breach window follows.
(defrule
    (goal df17-wall-assault-phase 0)
    (or (players-building-type-count any-enemy stone-wall-line >= 4)
        (or (players-building-type-count any-enemy gate >= 1)
            (players-building-type-count any-enemy castle >= 1)))
    (or (unit-type-count-total battering-ram-line >= 1)
        (or (unit-type-count-total mangonel-line >= 1)
            (or (unit-type-count-total trebuchet >= 1)
                (unit-type-count-total bombard-cannon >= 1))))
=>
    (set-goal df17-wall-assault-phase 1)
    (set-strategic-number sn-wall-targeting-mode 1)
    (set-strategic-number sn-building-targeting-mode 0)
    (enable-timer df17-wall-assault-timer 50)
)
(defrule
    (goal df17-wall-assault-phase 1)
    (timer-triggered df17-wall-assault-timer)
=>
    (set-goal df17-wall-assault-phase 2)
    (set-strategic-number sn-wall-targeting-mode 0)
    (set-strategic-number sn-building-targeting-mode 1)
    (disable-timer df17-wall-assault-timer)
    (enable-timer df17-wall-assault-timer 70)
)
(defrule
    (goal df17-wall-assault-phase 2)
=>
    (set-strategic-number sn-wall-targeting-mode 0)
    (set-strategic-number sn-building-targeting-mode 1)
)
(defrule
    (goal df17-wall-assault-phase 2)
    (timer-triggered df17-wall-assault-timer)
=>
    (set-goal df17-wall-assault-phase 0)
    (disable-timer df17-wall-assault-timer)
)
(defrule
    (players-building-type-count any-enemy stone-wall-line < 4)
    (players-building-type-count any-enemy gate < 1)
    (players-building-type-count any-enemy castle < 1)
=>
    (set-goal df17-wall-assault-phase 0)
    (set-strategic-number sn-wall-targeting-mode 0)
    (set-strategic-number sn-building-targeting-mode 1)
    (disable-timer df17-wall-assault-timer)
)


; ============================================================================
; FIX18 FINAL STABLE-FORTRESS OVERRIDES
; ============================================================================

; Independent cooldowns: economic construction must not be frozen merely because
; a wall segment is cooling down, and vice versa.
(defrule
    (timer-triggered df18-infra-timer)
=>
    (disable-timer df18-infra-timer)
)
(defrule
    (timer-triggered df18-wall-build-timer)
=>
    (disable-timer df18-wall-build-timer)
)
(defrule
    (timer-triggered df24-gate-timer)
=>
    (disable-timer df24-gate-timer)
    (set-goal df24-gate-lock 0)
)

; One wall/gate owner. Legacy Resonance wall goals remain inert; final Fortress
; rules below issue all wall commands on every difficulty.
(defrule
    (true)
=>
    (set-goal wall DONT-BUILD-WALL)
    (set-goal buildwalls 0)
)

; Persistent Feudal palisade geometry. Earlier FIX17 reset this envelope every
; pass; these final rules make each stage durable until the next stage is reached.
(defrule
    (current-age == feudal-age)
    (or (goal df16-wall-stage 0) (goal df16-wall-stage 1))
=>
    (set-strategic-number sn-minimum-town-size 8)
    (set-strategic-number sn-maximum-town-size 18)
    (set-strategic-number sn-safe-town-size 14)
)
(defrule
    (current-age == feudal-age)
    (goal df16-wall-stage 2)
=>
    (set-strategic-number sn-minimum-town-size 9)
    (set-strategic-number sn-maximum-town-size 22)
    (set-strategic-number sn-safe-town-size 17)
)
(defrule
    (current-age == feudal-age)
    (goal df16-wall-stage 3)
=>
    (set-strategic-number sn-minimum-town-size 10)
    (set-strategic-number sn-maximum-town-size 26)
    (set-strategic-number sn-safe-town-size 20)
)

; One pending-aware Feudal palisade request at a time.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 35)
    (wall-completed-percentage 1 < 35)
    (wood-amount > 90)
    (up-pending-objects c: palisade-wall < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
    (enable-timer df18-wall-build-timer 14)
)
(defrule
    (current-age == feudal-age)
    (current-age-time >= 110)
    (or (goal df16-wall-stage 2) (goal df16-wall-stage 3))
    (wall-completed-percentage 2 < 35)
    (wood-amount > 120)
    (up-pending-objects c: palisade-wall < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-build-wall 2 palisade-wall)
=>
    (build-wall 2 palisade-wall)
    (enable-timer df18-wall-build-timer 14)
)
; Late Feudal safe fallback: affordability is checked before entering the planner.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 210)
    (goal df16-wall-stage 3)
    (wood-amount > 160)
    (up-pending-objects c: palisade-wall < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-afford-complete-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
    (enable-timer df18-wall-build-timer 18)
)
(defrule
    (current-age == feudal-age)
    (building-type-count-total palisade-wall >= 4)
    (building-type-count-total gate < 2)
    (goal df24-gate-lock 0)
    (up-pending-objects c: gate < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-build-gate 1)
=>
    (build-gate 1)
    (set-goal df24-gate-lock 1)
    (enable-timer df24-gate-timer 150)
    (enable-timer df18-wall-build-timer 20)
)

; Castle/Imperial fortress walling: same quality on every difficulty, but requests
; are slow enough for foundations to appear before the same geometry is retried.
(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 96)
    (stone-amount > 220)
    (up-pending-objects c: stone-wall-line < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-build-wall 1 stone-wall-line)
=>
    (build-wall 1 stone-wall-line)
    (enable-timer df18-wall-build-timer 18)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total stone-wall-line >= 8)
    (wall-completed-percentage 2 < 96)
    (stone-amount > 260)
    (up-pending-objects c: stone-wall-line < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-build-wall 2 stone-wall-line)
=>
    (build-wall 2 stone-wall-line)
    (enable-timer df18-wall-build-timer 18)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total stone-wall-line >= 6)
    (building-type-count-total gate < 4)
    (goal df24-gate-lock 0)
    (up-pending-objects c: gate < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-build-gate 1)
=>
    (build-gate 1)
    (set-goal df24-gate-lock 1)
    (enable-timer df24-gate-timer 150)
    (enable-timer df18-wall-build-timer 24)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total stone-wall-line >= 12)
    (building-type-count-total gate < 8)
    (goal df24-gate-lock 0)
    (up-pending-objects c: gate < 1)
    (up-timer-status df18-wall-build-timer == timer-disabled)
    (can-build-gate 2)
=>
    (build-gate 2)
    (set-goal df24-gate-lock 1)
    (enable-timer df24-gate-timer 150)
    (enable-timer df18-wall-build-timer 24)
)

; ---------------------------------------------------------------------------
; NO-CHEAT ECONOMIC RETUNE
; ---------------------------------------------------------------------------
; These are stable healthy-economy targets, not magical income. Scarcity rules
; below deliberately take precedence. Stone stays meaningful because walls and
; castles are core Fortress infrastructure.
(defrule
    (current-age == feudal-age)
    (food-amount > 220)
    (wood-amount > 180)
    (gold-amount > 100)
=>
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 34)
    (set-strategic-number sn-gold-gatherer-percentage 12)
    (set-strategic-number sn-stone-gatherer-percentage 12)
)
(defrule
    (current-age == castle-age)
    (goal df13-defense-state 0)
    (food-amount > 320)
    (wood-amount > 320)
    (gold-amount > 220)
    (stone-amount > 180)
=>
    (set-strategic-number sn-food-gatherer-percentage 38)
    (set-strategic-number sn-wood-gatherer-percentage 34)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)
(defrule
    (current-age == imperial-age)
    (goal df13-defense-state 0)
    (food-amount > 500)
    (wood-amount > 450)
    (gold-amount > 320)
    (stone-amount > 200)
=>
    (set-strategic-number sn-food-gatherer-percentage 36)
    (set-strategic-number sn-wood-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 24)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)
; Under attack the economy favors replacement troops, farms/repairs and wood-built
; infrastructure. It does not stop production or wait for an offensive window.
(defrule
    (current-age >= castle-age)
    (goal df13-defense-state 1)
    (food-amount > 250)
    (wood-amount > 250)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 36)
    (set-strategic-number sn-gold-gatherer-percentage 16)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)
(defrule
    (goal df13-recovery 1)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 14)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)
; Targeted scarcity correction. Order is intentional: food is the final emergency
; override, then wood; gold/stone only take over while basic food/wood are healthy.
(defrule
    (current-age >= castle-age)
    (stone-amount < 180)
    (food-amount > 280)
    (wood-amount > 280)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 20)
)
(defrule
    (current-age >= castle-age)
    (gold-amount < 180)
    (food-amount > 280)
    (wood-amount > 280)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 28)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)
(defrule
    (current-age >= feudal-age)
    (wood-amount < 220)
    (food-amount > 260)
=>
    (set-strategic-number sn-food-gatherer-percentage 32)
    (set-strategic-number sn-wood-gatherer-percentage 46)
    (set-strategic-number sn-gold-gatherer-percentage 14)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)
(defrule
    (current-age >= feudal-age)
    (food-amount < 220)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 26)
    (set-strategic-number sn-gold-gatherer-percentage 16)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)

; ---------------------------------------------------------------------------
; SLOWER, DEFENSE-FIRST FORTRESS PACING
; ---------------------------------------------------------------------------
; Always retain a real local reserve outside a committed Fortress Assault.
(defrule
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (military-population >= 10)
=>
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 18)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-percent-enemy-sighted-response 45)
    (set-strategic-number sn-enemy-sighted-response-distance 28)
)
; Standard: clearly active, but no longer spends a fragile early army.
(defrule
    (difficulty == easy)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count < 18)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)
(defrule
    (difficulty == easy)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count >= 18)
    (soldier-count < 36)
=>
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 18)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 50)
)
(defrule
    (difficulty == easy)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count >= 36)
=>
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 22)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 60)
)
; Moderate: stronger than Standard, but keeps roughly one third of the army home.
(defrule
    (difficulty == moderate)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count < 20)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)
(defrule
    (difficulty == moderate)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count >= 20)
    (soldier-count < 40)
=>
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 20)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 58)
)
(defrule
    (difficulty == moderate)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count >= 40)
=>
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 24)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 2)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 66)
)
; Hard/Hardest remain dangerous, but the normal field posture still keeps a reserve.
(defrule
    (difficulty == hard)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count < 18)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)
(defrule
    (difficulty == hard)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count >= 18)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 28)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 72)
)
(defrule
    (difficulty == hardest)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count < 16)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-goal df22-retired-sink 0)
)
(defrule
    (difficulty == hardest)
    (goal df13-defense-state 0)
    (goal df13-assault-ready 0)
    (soldier-count >= 16)
=>
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-minimum-attack-group-size 16)
    (set-strategic-number sn-maximum-attack-group-size 32)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 78)
)

; Defense itself is uncompromising: keep production enabled and commit sighted
; military locally, rather than trying to continue an offensive during collapse.
(defrule
    (goal df13-defense-state 1)
=>
    ; FIX22 ATTACK OWNER retired: (set-goal createarmy 1)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-number-attack-groups 0)
    ; FIX22 ATTACK OWNER retired: (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-minimum-defend-group-size 6)
    (set-strategic-number sn-maximum-defend-group-size 26)
    (set-strategic-number sn-gather-defense-units 1)
    (set-strategic-number sn-percent-enemy-sighted-response 100)
    (set-strategic-number sn-enemy-sighted-response-distance 100)
)

; ---------------------------------------------------------------------------
; RECOVERY-AWARE SURRENDER
; ---------------------------------------------------------------------------
; Solo: no TC, no Castle, almost no people/army, exhausted stored economy AND
; active enemy pressure. Merely losing villagers is never enough.
(defrule
    (goal earlyresign 1)
    (goal teamplay 0)
    (goal aiteammate 0)
    (game-time > 2700)
    (building-type-count wonder < 1)
    (building-type-count town-center == 0)
    (building-type-count-total castle < 1)
    (unit-type-count-total villager < 7)
    (military-population <= 5)
    (town-under-attack)
    (players-military-population any-enemy > 18)
    (food-amount < 350)
    (wood-amount < 350)
    (gold-amount < 350)
    (stone-amount < 350)
=>
    (chat-to-all "[FORTRESS] [CMD-9] Civilian, military, and reconstruction capacity are exhausted.")
    (chat-to-all "[FORTRESS] Your forces have secured the field. I concede. GG.")
    (resign)
)
; Team game: even more tolerant; the ally is given a long rescue/rebuild window.
(defrule
    (goal earlyresign 1)
    (or (goal teamplay 1) (goal aiteammate 1))
    (game-time > 3600)
    (building-type-count wonder < 1)
    (building-type-count town-center == 0)
    (building-type-count-total castle < 1)
    (unit-type-count-total villager < 5)
    (military-population <= 3)
    (town-under-attack)
    (players-military-population any-enemy > 35)
    (food-amount < 250)
    (wood-amount < 250)
    (gold-amount < 250)
    (stone-amount < 250)
=>
    (chat-to-all "[FORTRESS] [CMD-9] Allied recovery is no longer physically possible; I concede. GG.")
    (resign)
)

; ============================================================================
; FIX21 FORTRESS ECONOMY 2.0 - FINAL GOVERNOR
; ============================================================================
; This layer is intentionally final.  Older economy heuristics may still calculate
; situational plans, but the Governor owns the final gather profile and tier posture.
; It never creates resources.
;
; df21-economy-state:
;   1 GROWTH   - Dark/Feudal development; cheap+middle tier permission.
;   2 STABLE   - healthy Castle/Imperial economy; middle-tier backbone.
;   3 DEFENSE  - base under active pressure; replacement economy.
;   4 RECOVERY - post-loss rebuild; food/wood first, cheap+middle army.
;   5 ASSAULT  - tactically ready AND stocked above a soft reserve; controlled elite.

; --- Economy state ownership -------------------------------------------------
; Dark/Feudal normally grows.  Defense/recovery rules later in this block override it.
(defrule
    (current-age == dark-age)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
=>
    (set-goal df21-economy-state 1)
)
(defrule
    (current-age == feudal-age)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
=>
    (set-goal df21-economy-state 1)
)

; Castle/Imperial enters STABLE after growth, defense or recovery.  State 5 is
; excluded here so ASSAULT can persist until its lower exit reserve is crossed.
(defrule
    (current-age >= castle-age)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (or (goal df21-economy-state 0) (or (goal df21-economy-state 1) (or (goal df21-economy-state 3) (goal df21-economy-state 4))))
=>
    (set-goal df21-economy-state 2)
)

; Recovery is economic reconstruction, not a reason to stop producing an army.
(defrule
    (or (goal df13-recovery 1) (goal df13-military-rebuild 1))
=>
    (set-goal df21-economy-state 4)
)

; Immediate local danger has priority over every peaceful economic mode.
(defrule
    (goal df13-defense-state 1)
=>
    (set-goal df21-economy-state 3)
)

; ASSAULT entry requires tactical readiness plus a real no-cheat reserve.  Castle
; thresholds are deliberately moderate; Imperial can support a larger elite share.
(defrule
    (current-age == castle-age)
    (goal df21-economy-state 2)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (goal df13-assault-ready 1)
    (food-amount > 400)
    (wood-amount > 330)
    (gold-amount > 250)
=>
    (set-goal df21-economy-state 5)
)
(defrule
    (current-age == imperial-age)
    (goal df21-economy-state 2)
    (goal df13-defense-state 0)
    (goal df13-recovery 0)
    (goal df13-military-rebuild 0)
    (goal df13-assault-ready 1)
    (food-amount > 560)
    (wood-amount > 460)
    (gold-amount > 360)
=>
    (set-goal df21-economy-state 5)
)

; Reserve hysteresis: once ASSAULT starts, it remains funded through normal unit
; spending.  It drops to STABLE only after tactical readiness ends or reserves
; are materially depleted, not after a single expensive train command.
(defrule
    (goal df21-economy-state 5)
    (goal df13-assault-ready 0)
=>
    (set-goal df21-economy-state 2)
)
(defrule
    (current-age == castle-age)
    (goal df21-economy-state 5)
    (or (food-amount < 240) (or (wood-amount < 190) (gold-amount < 120)))
=>
    (set-goal df21-economy-state 2)
)
(defrule
    (current-age == imperial-age)
    (goal df21-economy-state 5)
    (or (food-amount < 330) (or (wood-amount < 270) (gold-amount < 190)))
=>
    (set-goal df21-economy-state 2)
)

; --- Economy state -> tier quality ------------------------------------------
; No military-population rotor can overwrite this final mapping.  The existing
; FIX20 family pools remain intact; only their allowed quality posture changes.
(defrule
    (goal df21-economy-state 1)
=>
    (set-goal df15-tier-posture 1)
)
(defrule
    (goal df21-economy-state 3)
=>
    (set-goal df15-tier-posture 1)
)
(defrule
    (goal df21-economy-state 4)
=>
    (set-goal df15-tier-posture 1)
)
(defrule
    (goal df21-economy-state 2)
=>
    (set-goal df15-tier-posture 2)
)
(defrule
    (goal df21-economy-state 5)
=>
    (set-goal df15-tier-posture 3)
)

; --- State gather profiles ---------------------------------------------------
; Dark Age keeps the earlier dedicated hunting/stone logic.  Governor percentages
; begin in Feudal so FIX21 does not undo the tuned opening assignments.
(defrule
    (current-age == feudal-age)
    (goal df21-economy-state 1)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)
(defrule
    (current-age == castle-age)
    (goal df21-economy-state 2)
=>
    (set-strategic-number sn-food-gatherer-percentage 38)
    (set-strategic-number sn-wood-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 22)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)
(defrule
    (current-age == imperial-age)
    (goal df21-economy-state 2)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 28)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)
(defrule
    (current-age >= feudal-age)
    (goal df21-economy-state 3)
=>
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 36)
    (set-strategic-number sn-gold-gatherer-percentage 16)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)
(defrule
    (current-age >= feudal-age)
    (goal df21-economy-state 4)
=>
    (set-strategic-number sn-food-gatherer-percentage 44)
    (set-strategic-number sn-wood-gatherer-percentage 38)
    (set-strategic-number sn-gold-gatherer-percentage 12)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)
(defrule
    (current-age == castle-age)
    (goal df21-economy-state 5)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)
(defrule
    (current-age == imperial-age)
    (goal df21-economy-state 5)
=>
    (set-strategic-number sn-food-gatherer-percentage 32)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 34)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)

; --- Dynamic scarcity correction --------------------------------------------
; These are soft reserves: they redirect future gatherers instead of blocking all
; spending behind one giant threshold.  Priority order is stone -> gold -> wood ->
; food, with food last so an actual food emergency always wins.
(defrule
    (current-age >= castle-age)
    (stone-amount < 100)
    (food-amount > 260)
    (wood-amount > 260)
    (gold-amount > 160)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 20)
    (set-strategic-number sn-stone-gatherer-percentage 16)
)
(defrule
    (current-age >= castle-age)
    (gold-amount < 120)
    (food-amount > 220)
    (wood-amount > 220)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)
(defrule
    (current-age >= feudal-age)
    (wood-amount < 160)
    (food-amount >= 180)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 46)
    (set-strategic-number sn-gold-gatherer-percentage 14)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)
(defrule
    (current-age >= feudal-age)
    (food-amount < 180)
=>
    (set-strategic-number sn-food-gatherer-percentage 52)
    (set-strategic-number sn-wood-gatherer-percentage 26)
    (set-strategic-number sn-gold-gatherer-percentage 16)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)

; --- Emergency Market stabilizer --------------------------------------------
; One transaction at most every 45 seconds.  Market is a safety valve, not an
; alternative economy.  No resource is created: every action is a normal buy/sell.
(defrule
    (goal df21-market-lock 1)
    (timer-triggered df21-market-timer)
=>
    (set-goal df21-market-lock 0)
    (disable-timer df21-market-timer)
)
(defrule
    (current-age >= feudal-age)
    (building-type-count-total market >= 1)
    (goal df21-market-lock 0)
    (food-amount < 140)
    (gold-amount > 350)
    (commodity-selling-price food <= 120)
    (can-buy-commodity food)
=>
    (buy-commodity food)
    (set-goal df21-market-lock 1)
    (enable-timer df21-market-timer 45)
)
(defrule
    (current-age >= feudal-age)
    (building-type-count-total market >= 1)
    (goal df21-market-lock 0)
    (wood-amount < 120)
    (food-amount >= 140)
    (gold-amount > 350)
    (commodity-selling-price wood <= 120)
    (can-buy-commodity wood)
=>
    (buy-commodity wood)
    (set-goal df21-market-lock 1)
    (enable-timer df21-market-timer 45)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total market >= 1)
    (goal df21-market-lock 0)
    (gold-amount < 110)
    (food-amount > 850)
    (can-sell-commodity food)
=>
    (sell-commodity food)
    (set-goal df21-market-lock 1)
    (enable-timer df21-market-timer 45)
)
(defrule
    (current-age >= castle-age)
    (building-type-count-total market >= 1)
    (goal df21-market-lock 0)
    (gold-amount < 110)
    (food-amount <= 850)
    (wood-amount > 850)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
    (set-goal df21-market-lock 1)
    (enable-timer df21-market-timer 45)
)
(defrule
    (current-age == imperial-age)
    (building-type-count-total market >= 1)
    (building-type-count-total castle >= 2)
    (goal df21-market-lock 0)
    (gold-amount < 80)
    (stone-amount > 1400)
    (can-sell-commodity stone)
=>
    (sell-commodity stone)
    (set-goal df21-market-lock 1)
    (enable-timer df21-market-timer 45)
)


; ============================================================================
; FIX22 FINAL ATTACK OWNER / ALLY RESCUE / PEACE PRESSURE / ELITE GUARANTEE
; ============================================================================
; Everything above may still calculate economy, threats, counters and formations,
; but only this final layer writes createarmy, sn-number-attack-groups,
; sn-percent-attack-soldiers or attack-now.
;
; Attack modes: 0 HOLD, 2 ASSAULT, 3 ALLY RESCUE, 4 PEACE PRESSURE.
; Rescue has highest priority.  It deliberately commits only about 40 percent of
; the existing army so a Fortress under DEFENSE/RECOVERY still keeps a local core.

; --- Rescue triggers ---------------------------------------------------------
; Human/AI ally explicit reinforcement and attack requests.
(defrule
    (player-valid any-ally)
    (goal df22-rescue-state 0)
    (military-population >= 4)
    (taunt-detected any-ally 12)
=>
    (set-goal df24-rescue-player 0)
    (set-goal df24-rescue-level 1)
    (set-goal df22-rescue-state 1)
    (set-goal df22-rescue-pulse 1)
    (enable-timer df22-rescue-timer 180)
    (acknowledge-taunt this-any-ally 12)
)
(defrule
    (player-valid any-ally)
    (goal df22-rescue-state 0)
    (military-population >= 6)
    (taunt-detected any-ally 31)
=>
    (set-goal df24-rescue-player 0)
    (set-goal df24-rescue-level 1)
    (set-goal df22-rescue-state 1)
    (set-goal df22-rescue-pulse 1)
    (enable-timer df22-rescue-timer 180)
    (acknowledge-taunt this-any-ally 31)
)
(defrule
    (player-valid any-ally)
    (goal df22-rescue-state 0)
    (military-population >= 3)
    (taunt-detected any-ally 222)
=>
    (set-goal df24-rescue-player 0)
    (set-goal df24-rescue-level 2)
    (set-goal df22-rescue-state 1)
    (set-goal df22-rescue-pulse 1)
    (enable-timer df22-rescue-timer 210)
    (acknowledge-taunt this-any-ally 222)
)

; Automatic rescue: an ally has effectively lost its TC anchor.
(defrule
    (player-valid any-ally)
    (game-time > 900)
    (goal df22-rescue-state 0)
    (military-population >= 4)
    (players-building-type-count any-ally town-center < 1)
=>
    (set-goal df24-rescue-player 0)
    (set-goal df24-rescue-level 2)
    (set-goal df22-rescue-state 1)
    (set-goal df22-rescue-pulse 1)
    (enable-timer df22-rescue-timer 180)
    (chat-to-allies "[FORTRESS/ALLY] Rescue force committed to the threatened allied sector.")
)

; Automatic rescue: severe civilian collapse.  Separate human/computer tests keep
; the selector parser-proven and avoid treating a missing ally class as a casualty.
(defrule
    (cc-players-building-count any-computer-ally >= 1)
    (game-time > 900)
    (goal df22-rescue-state 0)
    (military-population >= 5)
    (cc-players-unit-type-count any-computer-ally villager < 14)
    (players-military-population any-enemy >= 12)
=>
    (set-goal df24-rescue-player 0)
    (set-goal df24-rescue-level 2)
    (set-goal df22-rescue-state 1)
    (set-goal df22-rescue-pulse 1)
    (enable-timer df22-rescue-timer 180)
)
(defrule
    (cc-players-building-count any-human-ally >= 1)
    (game-time > 900)
    (goal df22-rescue-state 0)
    (military-population >= 5)
    (cc-players-unit-type-count any-human-ally villager < 14)
    (players-military-population any-enemy >= 12)
=>
    (set-goal df24-rescue-player 0)
    (set-goal df24-rescue-level 2)
    (set-goal df22-rescue-state 1)
    (set-goal df22-rescue-pulse 1)
    (enable-timer df22-rescue-timer 180)
)

; Automatic rescue: ally has both a small army and a damaged economy while the
; enemy still has a meaningful field force.  This is the safe HD approximation
; for allied "under strong pressure" because town-under-attack is self-only.
(defrule
    (player-valid any-ally)
    (game-time > 900)
    (goal df22-rescue-state 0)
    (military-population >= 6)
    (players-military-population any-ally < 10)
    (cc-players-unit-type-count any-ally villager < 40)
    (players-military-population any-enemy >= 6)
=>
    (set-goal df24-rescue-player 0)
    (set-goal df24-rescue-level 1)
    (set-goal df22-rescue-state 1)
    (set-goal df22-rescue-pulse 1)
    (enable-timer df22-rescue-timer 180)
)

(defrule
    (goal df22-rescue-state 1)
    (timer-triggered df22-rescue-timer)
=>
    (set-goal df22-rescue-state 0)
    (set-goal df24-rescue-level 0)
    (set-goal df24-rescue-player 0)
    (disable-timer df22-rescue-timer)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
    (set-strategic-number sn-focus-player-number 0)
)

; --- FIX24 concrete ally target selection ----------------------------------
; HD exposes no safe sender-ID accessor for a generic taunt.  We therefore lock
; the intervention to the first allied player whose visible TC/villager/military
; state is collapsing; if none qualifies, a stable first-allied fallback is used.
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 1 ally)
    (not (player-number 1))
    (players-building-count 1 >= 1)
    (or (players-building-type-count 1 town-center < 1) (or (players-unit-type-count 1 villager < 18) (players-military-population 1 < 10)))
=>
    (set-goal df24-rescue-player 1)
    (set-strategic-number sn-focus-player-number 1)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 2 ally)
    (not (player-number 2))
    (players-building-count 2 >= 1)
    (or (players-building-type-count 2 town-center < 1) (or (players-unit-type-count 2 villager < 18) (players-military-population 2 < 10)))
=>
    (set-goal df24-rescue-player 2)
    (set-strategic-number sn-focus-player-number 2)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 3 ally)
    (not (player-number 3))
    (players-building-count 3 >= 1)
    (or (players-building-type-count 3 town-center < 1) (or (players-unit-type-count 3 villager < 18) (players-military-population 3 < 10)))
=>
    (set-goal df24-rescue-player 3)
    (set-strategic-number sn-focus-player-number 3)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 4 ally)
    (not (player-number 4))
    (players-building-count 4 >= 1)
    (or (players-building-type-count 4 town-center < 1) (or (players-unit-type-count 4 villager < 18) (players-military-population 4 < 10)))
=>
    (set-goal df24-rescue-player 4)
    (set-strategic-number sn-focus-player-number 4)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 5 ally)
    (not (player-number 5))
    (players-building-count 5 >= 1)
    (or (players-building-type-count 5 town-center < 1) (or (players-unit-type-count 5 villager < 18) (players-military-population 5 < 10)))
=>
    (set-goal df24-rescue-player 5)
    (set-strategic-number sn-focus-player-number 5)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 6 ally)
    (not (player-number 6))
    (players-building-count 6 >= 1)
    (or (players-building-type-count 6 town-center < 1) (or (players-unit-type-count 6 villager < 18) (players-military-population 6 < 10)))
=>
    (set-goal df24-rescue-player 6)
    (set-strategic-number sn-focus-player-number 6)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 7 ally)
    (not (player-number 7))
    (players-building-count 7 >= 1)
    (or (players-building-type-count 7 town-center < 1) (or (players-unit-type-count 7 villager < 18) (players-military-population 7 < 10)))
=>
    (set-goal df24-rescue-player 7)
    (set-strategic-number sn-focus-player-number 7)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 8 ally)
    (not (player-number 8))
    (players-building-count 8 >= 1)
    (or (players-building-type-count 8 town-center < 1) (or (players-unit-type-count 8 villager < 18) (players-military-population 8 < 10)))
=>
    (set-goal df24-rescue-player 8)
    (set-strategic-number sn-focus-player-number 8)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 1 ally)
    (not (player-number 1))
    (players-building-count 1 >= 1)
=>
    (set-goal df24-rescue-player 1)
    (set-strategic-number sn-focus-player-number 1)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 2 ally)
    (not (player-number 2))
    (players-building-count 2 >= 1)
=>
    (set-goal df24-rescue-player 2)
    (set-strategic-number sn-focus-player-number 2)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 3 ally)
    (not (player-number 3))
    (players-building-count 3 >= 1)
=>
    (set-goal df24-rescue-player 3)
    (set-strategic-number sn-focus-player-number 3)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 4 ally)
    (not (player-number 4))
    (players-building-count 4 >= 1)
=>
    (set-goal df24-rescue-player 4)
    (set-strategic-number sn-focus-player-number 4)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 5 ally)
    (not (player-number 5))
    (players-building-count 5 >= 1)
=>
    (set-goal df24-rescue-player 5)
    (set-strategic-number sn-focus-player-number 5)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 6 ally)
    (not (player-number 6))
    (players-building-count 6 >= 1)
=>
    (set-goal df24-rescue-player 6)
    (set-strategic-number sn-focus-player-number 6)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 7 ally)
    (not (player-number 7))
    (players-building-count 7 >= 1)
=>
    (set-goal df24-rescue-player 7)
    (set-strategic-number sn-focus-player-number 7)
)
(defrule
    (goal df22-rescue-state 1)
    (goal df24-rescue-player 0)
    (stance-toward 8 ally)
    (not (player-number 8))
    (players-building-count 8 >= 1)
=>
    (set-goal df24-rescue-player 8)
    (set-strategic-number sn-focus-player-number 8)
)

; --- Peace -> pressure -------------------------------------------------------
; Four calm minutes in STABLE/ASSAULT arm a 90-second active pressure window.
(defrule
    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
    (goal df22-rescue-state 0)
    (goal df22-pressure-state 0)
    (not (town-under-attack))
    (up-timer-status df22-peace-timer == timer-disabled)
=>
    (enable-timer df22-peace-timer 240)
)
(defrule
    (or (goal df21-economy-state 3) (goal df21-economy-state 4))
=>
    (set-goal df22-pressure-state 0)
    (disable-timer df22-peace-timer)
    (disable-timer df22-pressure-timer)
)
(defrule
    (goal df22-rescue-state 1)
=>
    (set-goal df22-pressure-state 0)
    (disable-timer df22-peace-timer)
    (disable-timer df22-pressure-timer)
)
(defrule
    (timer-triggered df22-peace-timer)
    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
    (goal df22-rescue-state 0)
    (military-population >= 10)
=>
    (set-goal df22-pressure-state 1)
    (set-goal df22-pressure-pulse 1)
    (disable-timer df22-peace-timer)
    (enable-timer df22-pressure-timer 90)
)
(defrule
    (timer-triggered df22-peace-timer)
    (military-population < 10)
=>
    (disable-timer df22-peace-timer)
    (enable-timer df22-peace-timer 90)
)
(defrule
    (goal df22-pressure-state 1)
    (timer-triggered df22-pressure-timer)
=>
    (set-goal df22-pressure-state 0)
    (disable-timer df22-pressure-timer)
)

; --- Attack mode selection --------------------------------------------------
; Economy Governor owns the peaceful baseline; rescue overrides everything.
(defrule
    (or (goal df21-economy-state 1) (or (goal df21-economy-state 2) (or (goal df21-economy-state 3) (goal df21-economy-state 4))))
=>
    (set-goal df22-attack-mode 0)
)
(defrule
    (goal df21-economy-state 5)
=>
    (set-goal df22-attack-mode 2)
)
(defrule
    (goal df21-economy-state 2)
    (goal df22-pressure-state 1)
=>
    (set-goal df22-attack-mode 4)
)
(defrule
    (goal df22-rescue-state 1)
=>
    (set-goal df22-attack-mode 3)
)

; --- Sole createarmy / attack-group owner -----------------------------------
; Dark GROWTH saves the opening economy; Feudal+ continues normal production.
(defrule
    (current-age == dark-age)
    (goal df22-attack-mode 0)
=>
    (set-goal createarmy 0)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)
(defrule
    (current-age >= feudal-age)
    (goal df22-attack-mode 0)
=>
    (set-goal createarmy 1)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)

; ASSAULT keeps a reserve but is decisively offensive.
(defrule
    (goal df22-attack-mode 2)
    (difficulty == easy)
=>
    (set-goal createarmy 1)
    (set-strategic-number sn-minimum-attack-group-size 6)
    (set-strategic-number sn-maximum-attack-group-size 16)
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-percent-attack-soldiers 55)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)
(defrule
    (goal df22-attack-mode 2)
    (difficulty == moderate)
=>
    (set-goal createarmy 1)
    (set-strategic-number sn-minimum-attack-group-size 7)
    (set-strategic-number sn-maximum-attack-group-size 18)
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-percent-attack-soldiers 65)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)
(defrule
    (goal df22-attack-mode 2)
    (difficulty == hard)
=>
    (set-goal createarmy 1)
    (set-strategic-number sn-minimum-attack-group-size 8)
    (set-strategic-number sn-maximum-attack-group-size 22)
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-percent-attack-soldiers 72)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)
(defrule
    (goal df22-attack-mode 2)
    (difficulty == hardest)
=>
    (set-goal createarmy 1)
    (set-strategic-number sn-minimum-attack-group-size 9)
    (set-strategic-number sn-maximum-attack-group-size 24)
    (set-strategic-number sn-number-attack-groups 2)
    (set-strategic-number sn-percent-attack-soldiers 78)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)

; PEACE PRESSURE is deliberately smaller than full ASSAULT.
(defrule
    (goal df22-attack-mode 4)
=>
    (set-goal createarmy 1)
    (set-strategic-number sn-minimum-attack-group-size 5)
    (set-strategic-number sn-maximum-attack-group-size 18)
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-percent-attack-soldiers 55)
    (set-strategic-number sn-target-evaluation-ally-proximity 0)
)

; ALLY RESCUE: one coherent intervention group.  Normal support sends about
; 40 percent; critical TC/civilian collapse escalates to about 60 percent.
(defrule
    (goal df22-attack-mode 3)
    (goal df24-rescue-level 1)
=>
    (set-goal createarmy 1)
    (set-goal enabletsa 1)
    (set-strategic-number sn-minimum-attack-group-size 3)
    (set-strategic-number sn-maximum-attack-group-size 16)
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-percent-attack-soldiers 40)
    (set-strategic-number sn-target-evaluation-ally-proximity 350)
    (set-strategic-number sn-coop-share-attacking 1)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 3)
    (set-strategic-number sn-maximum-defend-group-size 10)
)
(defrule
    (goal df22-attack-mode 3)
    (goal df24-rescue-level 2)
=>
    (set-goal createarmy 1)
    (set-goal enabletsa 1)
    (set-strategic-number sn-minimum-attack-group-size 2)
    (set-strategic-number sn-maximum-attack-group-size 22)
    (set-strategic-number sn-number-attack-groups 1)
    (set-strategic-number sn-percent-attack-soldiers 60)
    (set-strategic-number sn-target-evaluation-ally-proximity 500)
    (set-strategic-number sn-coop-share-attacking 1)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-minimum-defend-group-size 2)
    (set-strategic-number sn-maximum-defend-group-size 8)
)

; One-shot launch pulses. These are the ONLY active attack-now actions in FIX22.
(defrule
    (goal df22-attack-mode 3)
    (goal df22-rescue-pulse 1)
=>
    (attack-now)
    (set-goal df22-rescue-pulse 0)
)
(defrule
    (goal df22-attack-mode 4)
    (goal df22-pressure-pulse 1)
=>
    (attack-now)
    (set-goal df22-pressure-pulse 0)
)
(defrule
    (goal df21-economy-state 5)
    (goal df22-rescue-state 0)
    (goal df22-assault-pulse 0)
=>
    (attack-now)
    (set-goal df22-assault-pulse 1)
)
(defrule
    (or (goal df21-economy-state 1) (or (goal df21-economy-state 2) (or (goal df21-economy-state 3) (goal df21-economy-state 4))))
=>
    (set-goal df22-assault-pulse 0)
)

; --- Compact elite guarantee ------------------------------------------------
; Posture pools still make middle tiers the backbone. This small rotor only adds
; a recurring top-tier slot when ASSAULT, or when an Imperial STABLE economy is
; genuinely rich. One attempt every 24 seconds prevents queue/resource bursts.
(defrule
    (goal df21-economy-state 5)
=>
    (set-goal df22-elite-state 2)
)
(defrule
    (goal df21-economy-state 2)
    (current-age == imperial-age)
    (food-amount > 650)
    (wood-amount > 450)
    (gold-amount > 350)
    (military-population >= 24)
=>
    (set-goal df22-elite-state 1)
)
(defrule
    (or (goal df21-economy-state 1) (or (goal df21-economy-state 3) (goal df21-economy-state 4)))
=>
    (set-goal df22-elite-state 0)
)
(defrule
    (goal df21-economy-state 2)
    (or (current-age < imperial-age) (or (food-amount < 550) (or (wood-amount < 380) (gold-amount < 280))))
=>
    (set-goal df22-elite-state 0)
)
(defrule
    (timer-triggered df22-elite-timer)
=>
    (disable-timer df22-elite-timer)
)

; Slot 0: Champion.
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 0)
    (up-timer-status df22-elite-timer == timer-disabled)
    (research-completed ri-champion)
    (unit-type-count-total champion < 18)
    (food-amount > 220)
    (gold-amount > 160)
    (can-train champion)
=>
    (train champion)
    (set-goal df22-elite-cycle 1)
    (enable-timer df22-elite-timer 24)
)
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 0)
    (up-timer-status df22-elite-timer == timer-disabled)
=>
    (set-goal df22-elite-cycle 1)
    (enable-timer df22-elite-timer 24)
)

; Slot 1: Arbalest.
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 1)
    (up-timer-status df22-elite-timer == timer-disabled)
    (research-completed ri-arbalest)
    (unit-type-count-total arbalest < 20)
    (wood-amount > 220)
    (gold-amount > 160)
    (can-train arbalest)
=>
    (train arbalest)
    (set-goal df22-elite-cycle 2)
    (enable-timer df22-elite-timer 24)
)
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 1)
    (up-timer-status df22-elite-timer == timer-disabled)
=>
    (set-goal df22-elite-cycle 2)
    (enable-timer df22-elite-timer 24)
)

; Slot 2: Paladin.
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 2)
    (up-timer-status df22-elite-timer == timer-disabled)
    (research-completed ri-paladin)
    (unit-type-count-total paladin < 14)
    (food-amount > 300)
    (gold-amount > 220)
    (can-train paladin)
=>
    (train paladin)
    (set-goal df22-elite-cycle 3)
    (enable-timer df22-elite-timer 24)
)
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 2)
    (up-timer-status df22-elite-timer == timer-disabled)
=>
    (set-goal df22-elite-cycle 3)
    (enable-timer df22-elite-timer 24)
)

; Slot 3: Siege Onager.
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 3)
    (up-timer-status df22-elite-timer == timer-disabled)
    (research-completed ri-siege-onager)
    (unit-type-count-total siege-onager < 5)
    (wood-amount > 320)
    (gold-amount > 250)
    (can-train siege-onager)
=>
    (train siege-onager)
    (set-goal df22-elite-cycle 0)
    (enable-timer df22-elite-timer 24)
)
(defrule
    (or (goal df22-elite-state 1) (goal df22-elite-state 2))
    (goal df22-elite-cycle 3)
    (up-timer-status df22-elite-timer == timer-disabled)
=>
    (set-goal df22-elite-cycle 0)
    (enable-timer df22-elite-timer 24)
)


; ============================================================================
; FIX24 EARLY / RECOVERY MOBILIZATION OVERRIDES
; ============================================================================
; This is intentionally compact.  It does not choose elite quality and does not
; create resources.  It only guarantees that the existing exact-tier dispatchers
; receive cheap/middle family requests while the army is dangerously small.

(defrule
    (timer-triggered df24-mobilize-timer)
=>
    (disable-timer df24-mobilize-timer)
)

; Feudal: never let fast-castle/random-strategy flags leave the Fortress virtually
; unarmed.  From 20 seconds after Feudal, a sub-10 field army enters mobilization.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 20)
    (military-population < 10)
=>
    (set-goal feudalarmy 1)
)

; Ensure one range exists for the cheap spear/skirm/archer defensive triangle.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 35)
    (military-population < 8)
    (wood-amount > 150)
    (building-type-count-total archery-range < 1)
    (can-build archery-range)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
    (set-goal pausetsa 1)
    (build archery-range)
    (enable-timer df18-infra-timer 12)
)

; Baseline refresh: cheap families are requested every 18 seconds until ten
; military population exists. Existing threat/civ rules can add scouts/infantry.
(defrule
    (current-age == feudal-age)
    (current-age-time >= 25)
    (military-population < 10)
    (up-timer-status df24-mobilize-timer == timer-disabled)
=>
    (set-goal df13-spearman-request 1)
    (set-goal df13-skirmisher-request 1)
    (set-goal df13-archer-request 1)
    (enable-timer df24-mobilize-timer 18)
)

; Direct threat adds a little more cheap mass; still no attack is forced here.
(defrule
    (current-age == feudal-age)
    (town-under-attack)
    (military-population < 14)
=>
    (set-goal df13-spearman-request 1)
    (set-goal df13-skirmisher-request 1)
    (set-goal df13-archer-request 1)
)

; RECOVERY is mobilization. Every eight seconds the standing cheap/middle families
; are refreshed until a real field army exists. Posture 1 still controls quality.
(defrule
    (goal df21-economy-state 4)
    (military-population < 30)
    (up-timer-status df24-mobilize-timer == timer-disabled)
=>
    (set-goal df13-militia-request 1)
    (set-goal df13-spearman-request 1)
    (set-goal df13-archer-request 1)
    (set-goal df13-skirmisher-request 1)
    (set-goal df13-scout-request 1)
    (enable-timer df24-mobilize-timer 8)
)

; Castle+ RECOVERY also requests a limited mounted/siege middle core. Caps avoid
; turning reconstruction into an expensive elite queue.
(defrule
    (goal df21-economy-state 4)
    (current-age >= castle-age)
    (military-population < 26)
    (unit-type-count-total knight-line < 6)
    (food-amount > 140)
    (gold-amount > 110)
=>
    (set-goal df13-knight-request 1)
)
(defrule
    (goal df21-economy-state 4)
    (current-age >= castle-age)
    (military-population < 26)
    (unit-type-count-total mangonel-line < 3)
    (wood-amount > 180)
    (gold-amount > 110)
=>
    (set-goal df13-mangonel-request 1)
)
