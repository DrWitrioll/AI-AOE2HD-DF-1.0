(goal chatadvice 1)
(goal chatintroduction 1)
(goal aibattle 0)
(or(goal aiteammate 0)
(random-number <= 4))
(game-time > 900)
(game-time < 1500)
(goal nomadstart 0)
(or(unit-type-count-total villager >= 25)
(difficulty == easiest))
(cc-players-unit-type-count any-human villager <= 25)
=>
(chat-to-all "[FORTRESS] Keep villager production continuous except when an age-up temporarily takes priority.")
(chat-to-all "[FORTRESS] By this stage, an economy of at least twenty-five villagers is a useful benchmark.")
(chat-to-all "[FORTRESS] A large late-game economy, often near one hundred villagers, supports sustained military production.")
(chat-to-all "[FORTRESS] If you are still learning, aim for roughly fifty villagers first and increase that target gradually.")
(set-goal allowchats 0)
(disable-self)
)

