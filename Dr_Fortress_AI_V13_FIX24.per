;===Start New Unit Micro v2.2b v2.2c Nov 2019 - July 2020===
;Military Unit Control Scaling

#load-if-defined DIFFICULTY-EASIEST

(defrule
	(difficulty == easiest) ;new v2.2b v2.2c
	(goal dynamicdifficulty 1)
	(game-time > 1860) ;changed from 1800
	(game-time < 2520) ;changed from 1920, 2160
	(or(goal aibattle 0)
	(goal resonancebot 1)) ;changed from not any computer player
	(or(cc-players-unit-type-count every-human villager <= 60) ;changed from 50
	(cc-players-unit-type-count any-human villager <= 30)) ;are we winning? 
	(players-military-population every-enemy <= 20) 
=>
	(set-difficulty-parameter ability-to-maintain-distance 85) ;defaults to 75, 80 in beta
	(set-difficulty-parameter ability-to-dodge-missiles 85) ;defaults to 75, 85 in beta
	(chat-to-all "[FORTRESS] Military force-control scaling engaged.")
	(disable-self)
) 

(defrule
	(difficulty == easiest) ;new v2.2b v2.2c
	(goal dynamicdifficulty 1)
	(game-time > 3000)
	(or(goal aibattle 0)
	(goal resonancebot 1)) ;changed from not any computer player
	(or(cc-players-unit-type-count every-human villager >= 30)
	(cc-players-unit-type-count any-human villager >= 50))
	(or(players-military-population every-enemy > 20) 
	(players-military-population any-enemy >= 40)) ;are we losing?
	(military-population < 20)
=>
	(set-difficulty-parameter ability-to-maintain-distance 75) ;defaults to 75
	(set-difficulty-parameter ability-to-dodge-missiles 75) ;defaults to 75
	(disable-self)
) 

#end-if

