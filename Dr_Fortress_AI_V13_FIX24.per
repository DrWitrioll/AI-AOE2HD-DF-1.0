(military-population >= 60)) ;new 2019 v2.2b v2.2c
(warboat-count >= 10)
(not(town-under-attack))
(cc-players-unit-type-count 0 sea-fish >= 2)
(or(cc-players-unit-type-count 0 sea-fish >= 8) ;previously 5, v2.2c 6 to 7
(cc-players-unit-type-count 0 shore-fish >= 7)) ;previously 6
(wood-amount > 100)
(unit-type-count-total fishing-ship < 6)
(can-train fishing-ship)
=>
(train fishing-ship)  
)

(defrule
(not(town-under-attack))
(population-cap >= 150) ;new 2019 v2.2b v2.2c 
(wood-amount > 200)
(game-time < 1500)
(cc-players-unit-type-count 0 sea-fish >= 2)
(or(cc-players-unit-type-count 0 sea-fish >= 10) ;previously 7, v2.2c 8 to 10
(cc-players-unit-type-count 0 shore-fish >= 9)) ;previously 8
(unit-type-count-total fishing-ship < 8)
(can-train fishing-ship)
=>
(train fishing-ship)  
)

(defrule
	(not (civ-selected chinese))
	(or
		(resource-found food)			
		(game-time > 180)
	)
	(building-type-count-total mill < 1)
	(can-build mill)
=>
	(build mill)
)

(defrule
	(civ-selected chinese)
	(resource-found food)
	(game-time > 40)
	(food-amount < 10)
	(building-type-count-total mill < 1)
	(building-type-count-total house >= 1)
	(can-build mill)
=>
	(build mill)
)

(defrule
	(civ-selected chinese)
	(or
		(resource-found food)
		(game-time > 180)
	)
	(building-type-count-total mill < 1)
	(building-type-count-total house >= 2)
	(can-build mill)
=>
	(build mill)
)

;lumber camp
(defrule
	(resource-found wood)
	(building-type-count-total mill >= 1)
