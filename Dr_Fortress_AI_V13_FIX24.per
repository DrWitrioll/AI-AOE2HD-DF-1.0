(defrule 
(goal earlyresign 1)
(game-time > 2760)
(building-type-count wonder >= 1)
(players-military-population any-enemy > 15)
(or(unit-type-count-total villager < 28)
(player-resigned any-computer-ally))
(military-population <= 10)
(up-timer-status 30 == timer-disabled)
(up-timer-status 31 == timer-disabled)
=> 
(chat-to-all "[FORTRESS] [CMD-24] Strategic withdrawal is under consideration.")
(chat-to-all "[FORTRESS] As long as the Wonder remains standing, resistance will continue.")
(disable-self)
)

