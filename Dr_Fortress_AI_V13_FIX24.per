;#end-if

;Timer 1 is for late game global timed free tributes of food and wood for Hard and Hardest.  
;Timer 2 is for late game global timed free tributes for Hard and Hardest when AI has teammates.
;Timer 3 is for building lumber camps.
;Timer 4 is for Attack logic, sets attack groups to 0.
;Timer 5 is for Attack logic on Standard and Easiest difficulties and Timed Attacks.
;Timer 6 is for Retreat logic (Userpatch only)
;Timer 7 is for the super late game free tributes on Hard and Hardest when AI has teammates.
;Timer 8 is for Retreat logic. (Userpatch only) 
;Timer 9 is for Retreat logic. (Userpatch only) 
;Timer 10 is for Escrowing resources to advance. 
;Timer 11 is for Patrolling to spread out troops. 
;Timer 12 is for Retreat logic. (Userpatch only). 
;Timer 13 is for late game global timed free tributes for Hard and Hardest when AI has teammates.
;Timer 14 is for thanking teammates for tributes.
;Timer 15 is for Feudal Age Galley Production.
;Timer 16 is for focusing on a target player. This prevents swapping targets prematurely. 
;Timer 17 is for Attack Now, similar to 5. 
;Timer 18 is for focusing on a target player. 
;Timer 19 is for Attack Now, but for low pop games. 
;Timer 21 is for Create Army goal. 
;Timers 22-24 are for Special Commands.
;Timer 25 is for Civ-specific unit types. 
;Timers 26-27 is for triggering a harder version of Moderate difficulty. 
;Timer 28 is for Escrowing resources for a Wonder. 
;Timer 29 is for thanking teammates. 
;Timers 30-31 are for Resigning. 
;Timers 32,33 are for Chat Priority, ensure that not all AIs talk at the same time. 
;Timer 34 is for Nightmare Difficulty
;Timers 35-36 are for player targeting. 
;Timers 37-38 are for maps with no gold. 
;Timers 39-40 are for Town Size Attack.
;Timers 41-42 is for triggering a help dialogue with taunt 205. 

;Timers 11-27 were once used for Options Menu Toggling with Taunt 42
;Actually only uses Timers 22,23,24 now. 
;Timer 20 for close resource maps, resets camp distance. new v2.2b v2.2c

;Difficulties descriptions:
;Easiest: 200% unit creation time. 25-50ish villagers max. 2 Castles max. 
;-Also: Cannot attack before 30 minutes. Only attacks every few minutes. Limited strategy selection. Technologies delayed. 
;-First attack is weak. Will delay attacks after controlling an objective, giving time for players to react. 
;-Attacks in slow waves. Very low military unit control. Delays or does not get all military upgrades. 
;Standard: 133% unit creation time. 50-70ish villagers max. 3 Castles max.
;-Also: Cannot attack before 30 minutes. Only attacks every few minutes. Broader strategy selection. Technologies delayed
;-First attack is weak but potentially threatening. Does not delay attacks after controlling an objective.  
;-Attacks in slower waves. Low military unit control. Delays or does not get all military upgrades. 
;Moderate: 100% unit creation time (normal). 100+ villagers max. 5 Castles max. 
;-May rush, but the rush is not strong. More strategies available, very broad. Will rebuild bases and adapt to opponents. 
;-Attacks in waves. Decent military unit control. Delays some military upgrades. 
;Hard: Same as Moderate. Periodically receives very tiny amounts of free resources until 50 mins. 
;-Wider variety of strategies compared to Moderate. More strategies available, even more. Will rebuild bases and adapt to opponents quicker. 
;Hardest: Same as Moderate. Periodically receives small amounts of free resources until 50 mins. 
;-Full variety of strategies available. Will always open up differently but will adapt to opponents as-needed.
;-Will make smarter decisions when to attack and defend, factoring in strength of opponent's defenses and economy. 

(defrule
	(true)
=>
	(skybox-set-name-mode 0) ;0 has no (ResBot) and 1 has no parenthesis at all, just random name
	(disable-self)
) 

(defrule 
	(building-type-count town-center < 1)
   	(game-time > 40)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
	(set-strategic-number sn-percent-civilian-explorers  0)
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-builders 100)
	(build town-center)
	(enable-timer df18-infra-timer 28)
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-coop-share-information 1) 
	(set-strategic-number sn-hits-before-alliance-change 10)
	(set-strategic-number sn-initial-exploration-required 0)
	(set-strategic-number sn-home-exploration-time 360) ;how long do we scout our home base before looking for other players
	(set-strategic-number sn-easiest-reaction-percentage 100)
	(set-strategic-number sn-easier-reaction-percentage 100)
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1)
	(set-strategic-number sn-number-civilian-militia 3) ;may be able to adjust in DE
	(set-strategic-number sn-wall-targeting-mode 0) ;FIX05: ordinary troops ignore walls/gates until a siege package exists
	(up-assign-builders c: 621 c: 4) ;town-center-foundation 
	(up-assign-builders c: castle c: 2)
	(up-assign-builders c: watch-tower-line c: 2)
	(up-assign-builders c: wonder c: 25)
	(disable-self)
) 

(defrule
	(game-time < 30) ;new v2.2b v2.2c
=>
	(up-assign-builders c: house c: 2)
	(disable-self)
) 

(defrule
	(game-time > 30) ;new v2.2b v2.2c
=>
	(up-assign-builders c: house c: 1)
	(disable-self)
) 

(defrule
	(building-type-count castle < 2) ;new v2.2b v2.2c
	(or(difficulty == moderate)
	(or(difficulty == hard)
	(difficulty <= hardest)))
	(current-age >= castle-age)
	(game-time > 900)
	(game-time < 2700) 
	(players-military-population any-enemy >= 15)
	(military-population <= 7)
=>
	(up-assign-builders c: castle c: 4)
	(disable-self)
) 

(defrule
	(or(building-type-count castle >= 2) ;new v2.2b v2.2c
	(game-time > 2700)) ;v2.2c v2.2d new previously 2400
=>
	(up-assign-builders c: castle c: 2)
	(disable-self)
) 

(defrule
	(true)
=>
	(set-strategic-number sn-maximum-town-size 15)
	(set-strategic-number sn-camp-max-distance 15)
	(set-strategic-number sn-mill-max-distance 20)
	(set-strategic-number sn-minimum-dropsite-buffer 35) ;previously 30
	(set-strategic-number sn-maximum-food-drop-distance 10)
	(set-strategic-number sn-maximum-wood-drop-distance 10)
	(set-strategic-number sn-maximum-gold-drop-distance 10)
	(set-strategic-number sn-maximum-stone-drop-distance 10)
	(set-strategic-number sn-maximum-hunt-drop-distance 35)
	(set-strategic-number sn-food-dropsite-distance 6)
	(set-strategic-number sn-wood-dropsite-distance 6)
	(set-strategic-number sn-gold-dropsite-distance 6)
	(set-strategic-number sn-stone-dropsite-distance 6)
	(set-strategic-number sn-zero-priority-distance 250)
	(disable-self)
) 

(defrule
	(true)
=>
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-blot-exploration-map 0)
	(set-difficulty-parameter ability-to-maintain-distance 0) 
	(set-difficulty-parameter ability-to-dodge-missiles 0)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	(set-strategic-number sn-placement-zone-size 16)
	(set-strategic-number sn-gather-defense-units 0)
	(set-strategic-number sn-build-frequency 1)
	(set-strategic-number sn-dock-training-filter 0) ;new, if 1 then only train boats in lakes with enemy ships
	(disable-self)
)

(defrule
	(goal water-map 0)
	(warboat-count >= 10)
=>
	(set-strategic-number sn-dock-training-filter 1) ;new
	(disable-self)
)

(defrule 
	(building-type-count town-center < 1)
	(unit-type-count-total eagle-warrior-line < 1)
	(unit-type-count-total scout-cavalry-line < 1)
   	(game-time < 50) ;new v2.2c previously 40
	(game-time > 5) ;new v2.2c previously 6
=>
	(set-strategic-number sn-percent-civilian-explorers  40)
	(set-strategic-number sn-percent-civilian-builders 60)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-explorers 2)
	(set-strategic-number sn-cap-civilian-builders 80)
	(set-strategic-number sn-camp-max-distance 20)
	(set-strategic-number sn-maximum-food-drop-distance 15)
	(set-strategic-number sn-minimum-water-body-size-for-dock 1200) ;normally 1150
	(set-goal nomadstart 1)
	(set-goal fastcastle 1)
	(chat-local-to-self "[FORTRESS/DEBUG] Nomad start profile detected.") ;new, disable for v2.2c
	(disable-self)
)

(defrule 
	(goal nomadstart 1)
	(game-time > 1800)
=>
	(set-strategic-number sn-camp-max-distance 50)
	(set-strategic-number sn-maximum-town-size 20)
	(disable-self)
)

(defrule
	(goal nomadstart 1)
	(building-type-count town-center >= 1)
	(game-time > 120)
=>
	(set-strategic-number sn-percent-civilian-explorers 50)
	(set-strategic-number sn-percent-civilian-builders 30) 
	(set-strategic-number sn-percent-civilian-gatherers 20)
	(set-strategic-number sn-cap-civilian-explorers 20)
	(set-strategic-number sn-cap-civilian-builders 1)
	(set-strategic-number sn-cap-civilian-gatherers 1)
	(set-strategic-number sn-food-gatherer-percentage 90)
	(set-strategic-number sn-wood-gatherer-percentage 10)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage	0)
	(set-strategic-number sn-maximum-wood-drop-distance 40) ;new, from 20 v2.2c
	;(chat-to-all "[FORTRESS] Operational message: Nomad map, scouting for resources.")
	(disable-self)
) 

(defrule
	(difficulty == easiest)
	(game-time > 300)
=>
	(set-difficulty-parameter ability-to-maintain-distance 75) 
	(set-difficulty-parameter ability-to-dodge-missiles 75)
	(disable-self)
) 

(defrule
	(difficulty == easy)
	(game-time > 300)
=>
	(set-difficulty-parameter ability-to-maintain-distance 50) 
	(set-difficulty-parameter ability-to-dodge-missiles 50)
	(disable-self)
) 

(defrule
	(game-time > 1)
=>
	(set-strategic-number sn-retask-gather-amount 50)
	(set-strategic-number sn-maximum-gaia-attack-response 3) 
	(set-strategic-number sn-allow-civilian-defense 1) 
	(set-strategic-number sn-intelligent-gathering 1)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 6)
	(set-strategic-number sn-number-build-attempts-before-skip 1)
	(set-goal nomadstart 0)
	;(chat-to-all "[FORTRESS] Operational message: Nomad Start not detected.")
	(disable-self)
) 

(defrule
	(or(goal nomadstart 0)
	(game-time > 300))
	(building-type-count town-center >= 1)
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 40) 
	(set-strategic-number sn-percent-civilian-gatherers 60)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-builders 25) ;previously 10
	(set-strategic-number sn-cap-civilian-gatherers 15)
	(set-strategic-number sn-food-gatherer-percentage 100)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage	0)
	;(chat-to-all "[FORTRESS] Operational message: Stopping scouting.")
	(disable-self)
) 

(defconst enabletsa 91) ;for land maps
(defconst enableattacknow 92) ;for water maps
(defconst pausetsa 93) ;for when building, reset town size to default for 3 sec
(defconst bigtownsize 94) ;30
(defconst medtownsize 95) ;22
(defconst smalltownsize 95) ;15

(defrule
 	(housing-headroom <= 5)
	(or(building-type-count-total town-center >= 1)
	(game-time > 30))
	(population-headroom > 0)
 	(can-build house)
    (up-timer-status df18-infra-timer == timer-disabled)
 =>
	(set-goal pausetsa 1)
	(build house)
	(enable-timer df18-infra-timer 6)
)

(defrule
 	(housing-headroom <= 5)
	(or(building-type-count-total town-center >= 1)
	(game-time > 30))
	(population-headroom > 0)
 	(can-build-with-escrow house)
    (up-timer-status df18-infra-timer == timer-disabled)
 =>
	(set-goal pausetsa 1)
	(build house)
	(enable-timer df18-infra-timer 6)
	(release-escrow wood)
)

(defrule
	(wood-amount >= 600)
	(game-time > 900)
	(population-headroom > 0)
	(building-type-count house <= 15)
	(can-build house)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
	(set-goal pausetsa 1)
	(build house)
	(enable-timer df18-infra-timer 6)
)

(defrule
	(wood-amount >= 600)
	(game-time > 1200)
	(population-headroom > 0)
	(building-type-count house <= 20)
	(can-build house)
    (up-timer-status df18-infra-timer == timer-disabled)
=>
	(set-goal pausetsa 1)
	(build house)
	(enable-timer df18-infra-timer 6)
)

(defrule
 	(unit-type-count-total villager < 15)
	(game-time < 5) ;new v2.2c
	(cc-players-building-type-count every-enemy town-center >= 1) ;new Patch 5.8 v2.1g
 	(can-train villager)
=>
 	(train villager)
	(disable-self) ;only occurs once
)

