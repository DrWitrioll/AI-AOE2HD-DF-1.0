;========Resign Rules=========
;Timer 30-31 is for requesting a Resign

;(defrule
;(up-timer-status 30 == timer-disabled)
;(up-timer-status 31 == timer-disabled)
;(taunt-detected any-human 8)
;(goal earlyresign 1)
;=>     
;(chat-to-all "[FORTRESS] My position is no longer recoverable. Do you accept my surrender?")
;(chat-to-all "[FORTRESS] Respond through the Chat Menu with command 1 or 2.")
;(enable-timer 30 20)
;(acknowledge-taunt this-any-human 8)
;)

(defrule
(up-timer-status 30 == timer-disabled)
(taunt-detected any-human 1)
=>     
(acknowledge-taunt this-any-human 1)
)

(defrule
(up-timer-status 30 == timer-disabled)
(taunt-detected any-human 2)
=>     
(acknowledge-taunt this-any-human 2)
)

(defrule
(timer-triggered 30)
(taunt-detected any-human 1)
=>     
(chat-to-all "[FORTRESS] My position is lost. I am withdrawing from the field.")
(chat-to-all "[FORTRESS] This engagement is over; another battle may end differently.")
(set-goal earlyresign 1)
(enable-timer 31 20)
(acknowledge-taunt this-any-human 1)
(disable-timer 30)
)

(defrule
(timer-triggered 30)
(taunt-detected any-human 2)
=>     
(chat-to-all "[FORTRESS] Surrender was not accepted. Defensive operations will continue.")
(chat-to-all "[FORTRESS] I will continue until no viable reconstruction remains.")
(set-goal earlyresign 0)
(acknowledge-taunt this-any-human 2)
(disable-timer 30)
)

(defrule
(timer-triggered 30)
(not(taunt-detected any-human 1))
(not(taunt-detected any-human 2))
=>     
(chat-to-all "[FORTRESS] No response to the surrender request was received.")
(chat-to-all "[FORTRESS] Combat operations will continue for now.")
(chat-to-all "[FORTRESS] Use the in-game Chat Menu to send commands to the AI.")
(set-goal earlyresign 1)
(disable-timer 30)
)

(defrule
(timer-triggered 31)
=>     
;(disable-timer 31)
(chat-to-all "[FORTRESS] [CMD-7] You fought with discipline and earned this victory.")
(chat-to-all "[FORTRESS] Your forces have secured the field. I concede. GG.")
(tribute-to-player every-ally food 200)
(tribute-to-player every-ally wood 200)
(tribute-to-player every-ally gold 200)
(tribute-to-player every-ally stone 200)
(resign))

; FIX18 RECOVERY-AWARE SURRENDER: retired legacy autonomous resign rule #1.

; FIX18 RECOVERY-AWARE SURRENDER: retired legacy autonomous resign rule #2.

