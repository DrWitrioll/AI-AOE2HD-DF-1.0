;===========Allies============

; FIX17 serialized land trade.  Trade supports a team; it must not consume the army population.
(defrule
    (or (current-age == imperial-age) (civilian-population >= 80))
    (goal water-map 0)
    (not (map-type islands))
    (players-building-type-count any-ally market >= 1)
    (goal df13-defense-state 0)
    (not (town-under-attack))
    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
    (goal df17-trade-throttle 0)
    (difficulty == easiest)
    (unit-type-count-total trade-cart < 5)
    (can-train trade-cart)
=>
    (train trade-cart)
    (set-goal df17-trade-throttle 1)
    (enable-timer df17-trade-timer 15)
)
(defrule
    (or (current-age == imperial-age) (civilian-population >= 80))
    (goal water-map 0)
    (not (map-type islands))
    (players-building-type-count any-ally market >= 1)
    (goal df13-defense-state 0)
    (not (town-under-attack))
    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
    (goal df17-trade-throttle 0)
    (difficulty == easy)
    (unit-type-count-total trade-cart < 8)
    (can-train trade-cart)
=>
    (train trade-cart)
    (set-goal df17-trade-throttle 1)
    (enable-timer df17-trade-timer 15)
)
(defrule
    (or (current-age == imperial-age) (civilian-population >= 80))
    (goal water-map 0)
    (not (map-type islands))
    (players-building-type-count any-ally market >= 1)
    (goal df13-defense-state 0)
    (not (town-under-attack))
    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
    (goal df17-trade-throttle 0)
    (difficulty == moderate)
    (unit-type-count-total trade-cart < 10)
    (can-train trade-cart)
=>
    (train trade-cart)
    (set-goal df17-trade-throttle 1)
    (enable-timer df17-trade-timer 15)
)
(defrule
    (or (current-age == imperial-age) (civilian-population >= 80))
    (goal water-map 0)
    (not (map-type islands))
    (players-building-type-count any-ally market >= 1)
    (goal df13-defense-state 0)
    (not (town-under-attack))
    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
    (goal df17-trade-throttle 0)
    (or (difficulty == hard) (difficulty == hardest))
    (unit-type-count-total trade-cart < 18)
    (can-train trade-cart)
=>
    (train trade-cart)
    (set-goal df17-trade-throttle 1)
    (enable-timer df17-trade-timer 12)
)
(defrule
    (goal df17-trade-throttle 1)
    (timer-triggered df17-trade-timer)
=>
    (set-goal df17-trade-throttle 0)
    (disable-timer df17-trade-timer)
)

