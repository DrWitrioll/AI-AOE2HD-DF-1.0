(defrule
	(population-cap >= 150) 
	(game-time > 1200)
	(difficulty == easiest)
	(cc-players-unit-type-count any-human villager >= 25)
	(unit-type-count-total villager < 30) ;the minimum max vils for us is 25
	(can-train villager)
=>
	(train villager)
)

