;==========Map Detection================
(defconst box-turtles 1141) ;rise of the rajas new

(defrule
(game-time > 600)
(goal water-map 0)
(building-type-count-total dock >= 1)
(building-type-count-total town-center < 2)
(cc-players-building-type-count every-enemy dock < 1)
(not(map-type fortress))
=>
(set-goal builddock 0)
;(chat-to-all "[FORTRESS] Operational message: Debug: I have decided not to build any more Docks.")
(disable-self) 
)

(defrule
(game-time > 1200)
(or(building-type-count-total town-center >= 2)
(cc-players-building-type-count every-enemy dock >= 1))
;(goal water-map 0)
(goal builddock 0)
(not(map-type fortress))
=>
(set-goal builddock 1)
;(chat-to-all "[FORTRESS] Operational message: Debug: I will build additional Docks now.")
(disable-self) 
)

