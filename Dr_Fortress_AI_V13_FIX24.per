;==========DarkAge===========

(defrule
 	(unit-type-count-total villager < 7)
	(or(goal nomadstart 0) ;For Land Nomad, since we start with a TC, we idle to be fair. 
	(goal water-map 1))
 	(can-train villager)
=>
 	(train villager)
)

(defrule
 	(unit-type-count-total villager < 8)
	(cc-players-building-type-count every-enemy town-center >= 1) ;new Patch 5.8 v2.1g
	;(goal nomadstart 1) ;For Nomad Maps like Steppe
 	(can-train villager)
=>
 	(train villager)
	(disable-self)
)

(defrule
 	(unit-type-count-total villager < 8)
	(food-amount >= 150)
	(game-time < 300)
	(game-time > 210)
