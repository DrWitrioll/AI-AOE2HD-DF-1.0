; FIX06: Fortress walls are permanent.  ResonanceBot's inherited late-game
; wall-cleanup routine is intentionally disabled.  Expansion adds another
; security line instead of removing the old one.
(defrule
    (goal deletewalls 1)
=>
    (set-goal deletewalls 0)
)

