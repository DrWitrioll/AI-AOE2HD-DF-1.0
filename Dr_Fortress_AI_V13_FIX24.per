(up-assign-builders c: castle c: 2)
(disable-self)
)

;===================Advice for Weaker Opponents================
;We only give advice if the enemy is falling behind for some reason. 
;Advice is currently enabled

(defrule
(goal chatadvice 1)
(goal chatintroduction 1)
(goal aibattle 0)
(goal nomadstart 0)
(or(goal aiteammate 0)
(random-number >= 5))
(game-time > 420)
(game-time < 900)
(unit-type-count-total villager >= 12)
(cc-players-unit-type-count any-human villager <= 14)
=>
(chat-to-all "[FORTRESS] Keep Town Center idle time as close to zero as possible.")
(chat-to-all "[FORTRESS] A Town Center should usually be training villagers or researching an age or technology.")
(chat-to-all "[FORTRESS] A large late-game economy, often near one hundred villagers, supports sustained military production.")
(chat-to-all "[FORTRESS] If you are still learning, aim for roughly fifty villagers first and increase that target gradually.")
(set-goal allowchats 0)
(disable-self)
)

