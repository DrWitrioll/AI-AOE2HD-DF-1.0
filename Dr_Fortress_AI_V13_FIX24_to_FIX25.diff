+
+; ============================================================================
+; FIX25 PRODUCTION UPTIME / SPENDING GOVERNOR / CASTLE TIMING
+; ============================================================================
+; Scope is deliberately narrow: make legal production exist, keep it fed, spend
+; healthy reserves, and reach Castle earlier when locally safe.  Attack ownership,
+; Rescue targeting, elite ratios and counter-composition remain untouched.
+
+; --- Local timers -----------------------------------------------------------
+(defrule
+    (timer-triggered df25-production-timer)
+=>
+    (disable-timer df25-production-timer)
+)
+(defrule
+    (timer-triggered df25-spend-timer)
+=>
+    (disable-timer df25-spend-timer)
+)
+
+; --- Mandatory Feudal production foundation --------------------------------
+; FIX24 could set exact-tier family requests while no Barracks existed. Because a
+; Range itself needs the Barracks prerequisite, that could leave a player unarmed
+; for ten or more minutes.  FIX25 establishes one legal mixed-production core.
+(defrule
+    (current-age == feudal-age)
+    (current-age-time >= 10)
+    (building-type-count-total barracks < 1)
+    (up-pending-objects c: barracks < 1)
+    (can-build barracks)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (set-goal pausetsa 1)
+    (build barracks)
+    (enable-timer df18-infra-timer 10)
+)
+(defrule
+    (current-age == feudal-age)
+    (current-age-time >= 25)
+    (building-type-count-total barracks >= 1)
+    (building-type-count-total archery-range < 1)
+    (up-pending-objects c: archery-range < 1)
+    (can-build archery-range)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (set-goal pausetsa 1)
+    (build archery-range)
+    (enable-timer df18-infra-timer 10)
+)
+
+; --- Direct cheap military floor --------------------------------------------
+; Feudal protects Castle timing by stopping the direct safety floor at ten field
+; soldiers. Castle+ raises the emergency floor to sixteen; normal Spending/Recovery
+; logic remains responsible for larger standing armies.
+(defrule
+    (current-age == feudal-age)
+    (military-population < 10)
+=>
+    (set-goal df25-production-floor 1)
+)
+(defrule
+    (current-age == feudal-age)
+    (military-population >= 10)
+=>
+    (set-goal df25-production-floor 0)
+)
+(defrule
+    (current-age >= castle-age)
+    (military-population < 16)
+=>
+    (set-goal df25-production-floor 1)
+)
+(defrule
+    (current-age >= castle-age)
+    (military-population >= 16)
+=>
+    (set-goal df25-production-floor 0)
+)
+(defrule
+    (population-headroom < 1)
+=>
+    (set-goal df25-production-floor 0)
+)
+; This is a safety floor, not a replacement for exact-tier family dispatchers.
+; When the field army is critically small, one affordable legacy unit is attempted
+; every four seconds. The custom DAT intentionally keeps those paid old tiers legal.
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 0)
+    (up-timer-status df25-production-timer == timer-disabled)
+    (can-train spearman)
+=>
+    (train spearman)
+    (set-goal df25-production-cycle 1)
+    (enable-timer df25-production-timer 4)
+)
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 0)
+    (up-timer-status df25-production-timer == timer-disabled)
+=>
+    (set-goal df25-production-cycle 1)
+    (enable-timer df25-production-timer 1)
+)
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 1)
+    (up-timer-status df25-production-timer == timer-disabled)
+    (can-train skirmisher)
+=>
+    (train skirmisher)
+    (set-goal df25-production-cycle 2)
+    (enable-timer df25-production-timer 4)
+)
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 1)
+    (up-timer-status df25-production-timer == timer-disabled)
+=>
+    (set-goal df25-production-cycle 2)
+    (enable-timer df25-production-timer 1)
+)
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 2)
+    (up-timer-status df25-production-timer == timer-disabled)
+    (can-train archer)
+=>
+    (train archer)
+    (set-goal df25-production-cycle 3)
+    (enable-timer df25-production-timer 4)
+)
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 2)
+    (up-timer-status df25-production-timer == timer-disabled)
+=>
+    (set-goal df25-production-cycle 3)
+    (enable-timer df25-production-timer 1)
+)
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 3)
+    (up-timer-status df25-production-timer == timer-disabled)
+    (can-train militiaman)
+=>
+    (train militiaman)
+    (set-goal df25-production-cycle 0)
+    (enable-timer df25-production-timer 4)
+)
+(defrule
+    (goal df25-production-floor 1)
+    (goal df25-production-cycle 3)
+    (up-timer-status df25-production-timer == timer-disabled)
+=>
+    (set-goal df25-production-cycle 0)
+    (enable-timer df25-production-timer 1)
+)
+
+; --- Spending Governor -------------------------------------------------------
+; STABLE/ASSAULT only.  It deliberately does not own gather percentages or tier
+; quality. It turns a healthy bank into recurring existing family requests until
+; either a useful field army exists or reserves fall back to the safety floor.
+(defrule
+    (current-age == castle-age)
+    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
+    (military-population < 35)
+    (food-amount > 430)
+    (wood-amount > 330)
+    (gold-amount > 230)
+=>
+    (set-goal df25-spend-state 1)
+)
+(defrule
+    (current-age == imperial-age)
+    (or (goal df21-economy-state 2) (goal df21-economy-state 5))
+    (military-population < 50)
+    (food-amount > 600)
+    (wood-amount > 450)
+    (gold-amount > 350)
+=>
+    (set-goal df25-spend-state 1)
+)
+(defrule
+    (or (goal df21-economy-state 1) (or (goal df21-economy-state 3) (goal df21-economy-state 4)))
+=>
+    (set-goal df25-spend-state 0)
+)
+(defrule
+    (current-age == castle-age)
+    (goal df25-spend-state 1)
+    (or (military-population >= 35) (or (food-amount < 240) (or (wood-amount < 180) (gold-amount < 120))))
+=>
+    (set-goal df25-spend-state 0)
+)
+(defrule
+    (current-age == imperial-age)
+    (goal df25-spend-state 1)
+    (or (military-population >= 50) (or (food-amount < 320) (or (wood-amount < 240) (gold-amount < 180))))
+=>
+    (set-goal df25-spend-state 0)
+)
+
+; One existing family request every seven seconds.  Exact-tier quality remains
+; owned by the FIX20/FIX21 dispatcher; FIX25 only keeps demand flowing.
+(defrule
+    (goal df25-spend-state 1)
+    (goal df25-spend-cycle 0)
+    (up-timer-status df25-spend-timer == timer-disabled)
+=>
+    (set-goal df13-spearman-request 1)
+    (set-goal df25-spend-cycle 1)
+    (enable-timer df25-spend-timer 7)
+)
+(defrule
+    (goal df25-spend-state 1)
+    (goal df25-spend-cycle 1)
+    (up-timer-status df25-spend-timer == timer-disabled)
+=>
+    (set-goal df13-archer-request 1)
+    (set-goal df25-spend-cycle 2)
+    (enable-timer df25-spend-timer 7)
+)
+(defrule
+    (goal df25-spend-state 1)
+    (goal df25-spend-cycle 2)
+    (up-timer-status df25-spend-timer == timer-disabled)
+=>
+    (set-goal df13-skirmisher-request 1)
+    (set-goal df25-spend-cycle 3)
+    (enable-timer df25-spend-timer 7)
+)
+(defrule
+    (goal df25-spend-state 1)
+    (goal df25-spend-cycle 3)
+    (up-timer-status df25-spend-timer == timer-disabled)
+=>
+    (set-goal df13-militia-request 1)
+    (set-goal df25-spend-cycle 4)
+    (enable-timer df25-spend-timer 7)
+)
+(defrule
+    (goal df25-spend-state 1)
+    (goal df25-spend-cycle 4)
+    (up-timer-status df25-spend-timer == timer-disabled)
+=>
+    (set-goal df13-knight-request 1)
+    (set-goal df25-spend-cycle 0)
+    (enable-timer df25-spend-timer 7)
+)
+
+; Healthy banks progressively buy queue capacity.  The shared infrastructure
+; timer serializes construction, so a rich AI cannot burst-order all buildings.
+(defrule
+    (current-age >= castle-age)
+    (goal df25-spend-state 1)
+    (building-type-count-total stable < 1)
+    (wood-amount > 330)
+    (up-pending-objects c: stable < 1)
+    (can-build stable)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (build stable)
+    (enable-timer df18-infra-timer 12)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df25-spend-state 1)
+    (building-type-count-total archery-range < 2)
+    (wood-amount > 450)
+    (up-pending-objects c: archery-range < 1)
+    (can-build archery-range)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (build archery-range)
+    (enable-timer df18-infra-timer 12)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df25-spend-state 1)
+    (building-type-count-total barracks < 2)
+    (wood-amount > 520)
+    (up-pending-objects c: barracks < 1)
+    (can-build barracks)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (build barracks)
+    (enable-timer df18-infra-timer 12)
+)
+(defrule
+    (current-age == imperial-age)
+    (goal df25-spend-state 1)
+    (building-type-count-total stable < 2)
+    (wood-amount > 650)
+    (up-pending-objects c: stable < 1)
+    (can-build stable)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (build stable)
+    (enable-timer df18-infra-timer 12)
+)
+
+; --- Locally-safe Castle timing ---------------------------------------------
+; Standard-start target is roughly 14:30-16:00. Saving begins around minute 12,
+; but confirmed local pressure/recovery cancels the accelerator immediately.
+(defrule
+    (current-age == feudal-age)
+    (game-time >= 720)
+    (goal df21-economy-state 1)
+    (goal df13-defense-state 0)
+    (goal df13-recovery 0)
+    (goal df13-military-rebuild 0)
+    (not (town-under-attack))
+    (up-research-status c: castle-age < research-pending)
+=>
+    (set-goal df25-castle-save 1)
+)
+
+; The second Feudal prerequisite is made explicit.  Range + Blacksmith is enough
+; to make the age-up legal without forcing a Market detour.
+(defrule
+    (current-age == feudal-age)
+    (goal df25-castle-save 1)
+    (building-type-count-total archery-range >= 1)
+    (building-type-count-total blacksmith < 1)
+    (up-pending-objects c: blacksmith < 1)
+    (can-build blacksmith)
+    (up-timer-status df18-infra-timer == timer-disabled)
+=>
+    (build blacksmith)
+    (enable-timer df18-infra-timer 10)
+)
+
+; 12:00-14:00: save without switching off the cheap military floor.
+(defrule
+    (current-age == feudal-age)
+    (goal df25-castle-save 1)
+    (game-time < 840)
+=>
+    (set-escrow-percentage food 60)
+    (set-escrow-percentage gold 45)
+    (set-strategic-number sn-food-gatherer-percentage 46)
+    (set-strategic-number sn-wood-gatherer-percentage 28)
+    (set-strategic-number sn-gold-gatherer-percentage 22)
+    (set-strategic-number sn-stone-gatherer-percentage 4)
+)
+; 14:00-15:00: stronger age-up pull.
+(defrule
+    (current-age == feudal-age)
+    (goal df25-castle-save 1)
+    (game-time >= 840)
+    (game-time < 900)
+=>
+    (set-escrow-percentage food 75)
+    (set-escrow-percentage gold 55)
+    (set-strategic-number sn-food-gatherer-percentage 48)
+    (set-strategic-number sn-wood-gatherer-percentage 26)
+    (set-strategic-number sn-gold-gatherer-percentage 22)
+    (set-strategic-number sn-stone-gatherer-percentage 4)
+)
+; After 15:00, finish the click unless local defense has taken ownership.
+(defrule
+    (current-age == feudal-age)
+    (goal df25-castle-save 1)
+    (game-time >= 900)
+=>
+    (set-escrow-percentage food 85)
+    (set-escrow-percentage gold 65)
+    (set-strategic-number sn-food-gatherer-percentage 50)
+    (set-strategic-number sn-wood-gatherer-percentage 24)
+    (set-strategic-number sn-gold-gatherer-percentage 22)
+    (set-strategic-number sn-stone-gatherer-percentage 4)
+)
+
+; Launch Castle as soon as prerequisites/resources are legal. Existing inherited
+; rules remain valid fallbacks; this accelerator simply makes the resources ready.
+(defrule
+    (current-age == feudal-age)
+    (goal df25-castle-save 1)
+    (game-time >= 840)
+    (can-research-with-escrow castle-age)
+=>
+    (release-escrow food)
+    (release-escrow gold)
+    (research castle-age)
+    (set-goal df25-castle-save 0)
+    (set-escrow-percentage food 0)
+    (set-escrow-percentage gold 0)
+)
+
+; Heavy local pressure/recovery overrides timing.  No forced fast castle while the
+; base is actually collapsing; the normal Economy Governor resumes control.
+(defrule
+    (current-age == feudal-age)
+    (goal df25-castle-save 1)
+    (or (goal df13-defense-state 1) (or (goal df13-recovery 1) (goal df13-military-rebuild 1)))
+=>
+    (release-escrow food)
+    (release-escrow gold)
+    (set-escrow-percentage food 0)
+    (set-escrow-percentage gold 0)
+    (set-goal df25-castle-save 0)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df25-castle-save 1)
+=>
+    (set-goal df25-castle-save 0)
+    (set-escrow-percentage food 0)
+    (set-escrow-percentage gold 0)
+)
+
