;dynamic targeting
(defrule
	(current-age <= feudal-age)
=>
	(up-set-offense-priority c: villager c: 2)
	(disable-self)
)

(defrule
	(current-age > feudal-age)
=>
	(up-set-offense-priority c: villager c: 1)
	(disable-self)
)
;some TARGETING PRIORITIES
(defrule
	(true)
=>
	(set-strategic-number sn-enable-offensive-priority 1)
	(up-set-offense-priority c: gate-class c: 2)
	(up-set-offense-priority c: stone-wall-line c: 0)
	(up-set-offense-priority c: palisade-wall c: 2)
	(up-set-offense-priority c: monk c: 11)
	(up-set-offense-priority c: demolition-ship c: 11)
	(up-set-offense-priority c: transport-ship c: 7)
	(up-set-offense-priority c: house c: -1) ;no more attacking random houses and farms when other priorities exist
	(up-set-offense-priority c: farm c: -1)
	(up-set-defense-priority c: stone-wall-line c: 1)
	(up-set-defense-priority c: palisade-wall c: 3000)
	(up-set-defense-priority c: castle c: 7)
	(set-strategic-number sn-disable-trade-evasion 1)
	(set-strategic-number sn-disable-builder-assistance 1)
	(set-strategic-number sn-gather-defense-units 1)
	(set-strategic-number sn-wall-targeting-mode 1) ;1 = on, 0 = off
	;(set-strategic-number sn-disable-villager-garrison 0) ;THIS STOPS VILLAGERS FROM DEFENSIVE GARRISONING
	(disable-self))

(defrule
	(true)
=>
	(up-set-offense-priority c: king-class c: 11)
	(up-set-offense-priority c: town-center-foundation c: 11)
	(up-set-offense-priority c: town-center c: 7)
	(up-set-defense-priority c: town-center-foundation c: 10000)
	(up-set-offense-priority c: battering-ram-line c: 7)
	(up-set-offense-priority c: armored-elephant-line c: 7)
	(up-set-offense-priority c: trebuchet c: 7) ;doesn't include packed-trebuchet
	(disable-self)
)

(defrule
	(true)
=>
	(set-strategic-number sn-max-retask-gather-amount 1)
	(set-strategic-number sn-retask-gather-amount 0)
	(set-strategic-number sn-use-by-type-max-gathering 0)
	(set-strategic-number sn-max-skips-per-attempt 1)
	(set-strategic-number sn-number-build-attempts-before-skip 1)
	(set-strategic-number sn-number-max-skip-cycles 1)
	(set-strategic-number sn-minimum-town-size 6)
	(set-strategic-number sn-blot-exploration-map 0)
	(set-strategic-number sn-blot-size 1)
	;(set-strategic-number sn-build-frequency 1) ;apparently only works in AOE1
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-livestock-to-town-center 1)
	(set-strategic-number sn-wild-animal-exploration 1) ;good for steppe and mega-random maps
	(set-strategic-number sn-minimum-number-hunters 0)
	(disable-self)
)
;re-explore rule
(defrule
	(game-time s:> 900) ;15 minutes
=>
	(set-strategic-number sn-blot-exploration-map 1)
	(disable-self)
)

;revert to map center as focal point
(defrule
	(goal ENEMY-LOCATED no)
	(strategic-number sn-placement-to-center != 1)
=>
	;(chat-local-to-self "Setting enemy base as focal point.")
	(set-strategic-number sn-placement-zone-size 5); 9 (default ; should be used in a case by case basis.
	(set-strategic-number sn-placement-to-center 1) ;0 = use enemies closest building, 1 = use map center
)


;revert to closest enemy building as focal point
(defrule
	(goal ENEMY-LOCATED yes)
	(strategic-number sn-placement-to-center != 0)
=>
	;(chat-local-to-self "Setting enemy base as focal point.")
	(set-strategic-number sn-placement-zone-size 5); 9 (default ;should be used in a case by case basis.
	(set-strategic-number sn-placement-to-center 0) ;0 = use enemies closest building, 1 = use map center
)

