;TOWN CENTER 4 (no escrow)
(defrule
	(population-cap >= 175)
	(game-time > 20)
	(food-amount > 400);500
(or	(unit-type-count-total villager >= max-vill-pop)
(and	(unit-type-count-total villager <= max-vill-pop)
	(up-pending-objects c: villager >= 3))) ; indicates need for a 4th TC
	(building-type-count-total town-center == 3) ;4th
	(can-build town-center)
=>
	(set-strategic-number sn-town-center-placement 0)
;	(up-modify-sn sn-maximum-town-size c:- 2) ;testing - don't build it outside of the town-size like it normally does
	(up-assign-builders c: town-center-foundation c: 4) ; town-center-foundation = 621
	(build town-center)
)

