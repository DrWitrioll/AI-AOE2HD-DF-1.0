;farms moved to gathering.per

;MINING CAMP
;RULES ARE IN DARK AGE SECTION.
;LUMBER CAMP
;RULES IN DARK AGE SECTION.

;FEUDAL-RESEARCH

;CASTLE AGE 
;see research per file


;CASTLE AGE

;CASTLE UNITS (see Jester/civ-strategy.per)
;VILLAGER
;moved to villager training section at the DARK-AGE UNITS section in this file.

;gl-trade-units high
(defrule
	(up-compare-goal gl-trade-units != high) ;low trade currently
(or	(goal high-res-vils yes)								;trigger high trade if we have excess resources and deleting villagers, OR,
	(unit-type-count-total villager > high-res-vil-pop)) 	;we have average villager numbers
(or	(and	(unit-type-count trade-cog > 0)					;only do this if there are NEITHER BOTH trade carts and cogs (otherwise it stays low)
			(unit-type-count trade-cart < 2))
	(and	(unit-type-count trade-cog < 2)
			(unit-type-count trade-cart > 0)))
	(unit-type-count-total villager > min-vills) ;safety ;we must have some villagers always
=>
	(chat-local-to-self "Raising desired trade unit levels.")
	(set-goal gl-trade-units high)) ;max outcome

;gl-trade-units low
(defrule
	(up-compare-goal gl-trade-units != low)
(or	(and	(goal high-res-vils no) 								;we are not deleting villagers, AND,
			(unit-type-count-total villager < high-res-vil-pop))	;we are under our average villager numbers
(or	(and	(goal high-res-vils yes)								;OR, we are deleting villagers, AND,
			(unit-type-count-total villager <= min-vills)) 			;we are dangerously low on villagers
(or	(unit-type-count-total villager <= min-vills) 					;always lower trade-pop if we are really running out of villagers
	(and	(unit-type-count trade-cart > 1) 						;always lower if we have both trade-cogs and trade-carts, therefore lower trade-unit counts for both
			(unit-type-count trade-cog > 1)))))
=>
	(chat-local-to-self "Lowering desired trade unit levels.")
	(set-goal gl-trade-units low)) ;lowest outcome

;TRADE-COG (low) (WATER-MAP yes)
(defrule
	(goal gl-trade-units low)
	(goal WATER-MAP separated)
	(goal is-town-under-attack no)
	(current-age >= castle-age)
	(players-building-type-count any-ally dock > 0)
(or	(warboat-count > 5)
	(soldier-count > 10))
	(unit-type-count trade-cog < min-trade-pop)
	(civilian-population > min-vills)
(or	(dropsite-min-distance wood < 8)
	(wood-amount > 300))
	(up-pending-objects c: trade-cog < 1) ;only one at a time
	(can-train trade-cog)
=>
(train trade-cog))

;TRADE-COG (high) (WATER-MAP yes)
(defrule
	(goal gl-trade-units high)
	(goal WATER-MAP separated)
	(goal is-town-under-attack no)
	(current-age >= castle-age)
	(players-building-type-count any-ally dock > 0)
(or	(warboat-count > 4)
	(soldier-count > 10))
	(unit-type-count trade-cog < max-trade-pop)
	(civilian-population > min-vills)
(or	(dropsite-min-distance wood < 8)
	(wood-amount > 450))
	(up-pending-objects c: trade-cog < 1)
	(can-train trade-cog)
=>
	(train trade-cog))


;TRADE-COG (low) (WATER-MAP no)
(defrule
	(goal gl-trade-units low)
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(goal is-town-under-attack no)
	(current-age >= castle-age)
	(players-building-type-count any-ally dock > 0)
(or	(warboat-count > 4)
	(soldier-count > 10))
	(unit-type-count trade-cog < min-trade-pop)
	(civilian-population > min-vills)
(or	(dropsite-min-distance wood < 7)
	(wood-amount > 300))
	(up-pending-objects c: trade-cog < 1)
	(can-train trade-cog)
=>
(train trade-cog))

;TRADE-COG (high) (WATER-MAP no)
(defrule
	(goal gl-trade-units high)
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(goal is-town-under-attack no)
	(current-age >= castle-age)
	(players-building-type-count any-ally dock > 0)
(or	(warboat-count > 5)
	(soldier-count > 10))
	(unit-type-count trade-cog < max-trade-pop)
	(civilian-population > min-vills)
(or	(dropsite-min-distance wood < 7)
	(wood-amount > 450))
	(up-pending-objects c: trade-cog < 1)
	(can-train trade-cog)
=>
	(train trade-cog))

;TRADE CARTS (low)
(defrule
(goal gl-trade-units low) ;default
(or (goal WATER-MAP no) ;no trade carts on full water maps except team-islands
(or	(goal WATER-MAP connected)
	(map-type team-islands))) ;exception
(current-age >= castle-age)
(military-population >= 10) ;5
(players-building-type-count any-ally market > 0)
(unit-type-count-total villager > min-vills)
(unit-type-count-total trade-cart < min-trade-pop); lowest trade cart const based on pop settings
(up-pending-objects c: trade-cart < 1) ;only one at a time
(can-train trade-cart)
=>
(train trade-cart)
)

;TRADE CARTS (high)
(defrule
(goal gl-trade-units high)
(or (goal WATER-MAP no) ;no trade carts on full water maps except team-islands
(or	(goal WATER-MAP connected)
	(map-type team-islands))) ;exception
(current-age >= castle-age)
(military-population >= 15); 10
(players-building-type-count any-ally market > 0)
(unit-type-count-total villager > min-vills)
(unit-type-count-total trade-cart < max-trade-pop)
(up-pending-objects c: trade-cart < 1) ;only one at a time
(can-train trade-cart)
=>
(train trade-cart)
)

