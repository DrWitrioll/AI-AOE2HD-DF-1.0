#load-if-defined DARK-AGE-START
(defrule
	(game-time > 5)
	(goal NOMAD no)
=>
	(set-strategic-number sn-home-exploration-time 400) ;just under 7 minutes
	(disable-self))
#else
	(defrule
	(game-time > 5)
	(goal NOMAD no)
=>
	(set-strategic-number sn-home-exploration-time 180) ;3 minutes
	(disable-self))
#end-if

	(defrule
	(game-time > 5)
	(goal NOMAD yes)
=>
	(set-strategic-number sn-home-exploration-time 660) ;11 minutes
	(disable-self))

   (defrule
   (true)
=>
   (set-strategic-number sn-mining-camp-max-distance 12) ;default mining-camp-distance ;10?
   (set-strategic-number sn-lumber-camp-max-distance 12)  ;default lumber-camp-distance ;14?
   (set-strategic-number sn-maximum-town-size 8)
   (set-strategic-number sn-safe-town-size 8)
   (set-strategic-number sn-initial-exploration-required 0) ;ALWAYS SET THIS TO 0. Otherwise this percent of the map must be explored before buildings are allowed
  ;(set-strategic-number sn-required-forest-tiles 30) ;AOE1 only
   (set-strategic-number sn-food-dropsite-distance 7) ;preferred distance to walk for resources (the lower the more villagers favor closer dropsites)
   (set-strategic-number sn-wood-dropsite-distance 5)
   (set-strategic-number sn-stone-dropsite-distance 5)
   (set-strategic-number sn-gold-dropsite-distance 5)
   (disable-self)
)
(defrule
	(true)
=>
   (set-strategic-number sn-maximum-food-drop-distance 23);25 ;max distance villagers will walk for a resource, if resource is farther they completely ignore it
   (set-strategic-number sn-maximum-wood-drop-distance 25)
   (set-strategic-number sn-maximum-stone-drop-distance 25)
   (set-strategic-number sn-maximum-gold-drop-distance 25)
   (set-strategic-number sn-maximum-hunt-drop-distance 25) ;max hunting distance
   (set-strategic-number sn-maximum-fish-boat-drop-distance -1)
   (set-strategic-number sn-mill-max-distance 20)
   (disable-self)
)
;extend wood walk distance
(defrule
	(building-type-count-total town-center <= 0)
(or	(building-type-count lumber-camp >= 1); -total
	(building-type-count mule-cart >= 1)); -total
	(dropsite-min-distance wood s:> sn-maximum-wood-drop-distance); chop wood at any distance
	(strategic-number sn-maximum-wood-drop-distance >= 0)
	(strategic-number sn-maximum-wood-drop-distance c:< map-size)
=>
	(up-modify-sn sn-maximum-wood-drop-distance c:+ 1)
)
;reset wood walk distance
	(defrule
;(or	(building-type-count-total town-center > 0)
;(or	(building-type-count lumber-camp >= 1); -total
;	(building-type-count mule-cart >= 1))); -total
	(dropsite-min-distance wood s:<= 7); we built a closer LC or Mule Cart
	(strategic-number sn-maximum-wood-drop-distance > 25)
=>
	(up-modify-sn sn-maximum-wood-drop-distance c:- 1) ;reset back to default 25
)
;extend food walk distance
(defrule
	(dropsite-min-distance food s:> sn-maximum-food-drop-distance); emergency gather food
	(strategic-number sn-maximum-food-drop-distance >= 0)
	(strategic-number sn-maximum-food-drop-distance c:< map-size)
=>
	(up-modify-sn sn-maximum-food-drop-distance c:+ 1)
)
;reset food walk distance
	(defrule
;(or	(building-type-count-total town-center > 0)
;(or	(building-type-count lumber-camp >= 1); -total
;	(building-type-count mule-cart >= 1))); -total
	(dropsite-min-distance food s:<= 7); we have farms again or close food
	(strategic-number sn-maximum-food-drop-distance > 25)
=>
	(up-modify-sn sn-maximum-food-drop-distance c:- 1) ;reset back to default 25
)
(defrule
	(true)
=>
	(set-strategic-number sn-consecutive-idle-unit-limit 1) ;if you're a micro god then consider 1 or 0.
	(set-strategic-number sn-attack-group-size-randomness 0)
	(set-strategic-number sn-attack-group-gather-spacing 9) ;20
	(set-strategic-number sn-ignore-attack-group-under-attack 0)
	(set-strategic-number sn-group-commander-selection-method 0)
	(set-strategic-number sn-group-leader-defense-distance 5)
	(set-strategic-number sn-group-form-distance 40); 15
	(set-strategic-number sn-attack-intelligence 1)
	;(set-strategic-number sn-attack-coordination 2) ;AOE1 only?
	(set-strategic-number sn-coop-share-attacking 1)
	(set-strategic-number sn-coop-share-information 1)
	(set-strategic-number sn-coop-share-attacking-interval 2)
	(set-strategic-number sn-percent-enemy-sighted-response 95) ;60
	(set-strategic-number sn-enemy-sighted-response-distance 20) ;25
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-target-evaluation-siege-weapon 500);300, ;555
	(set-strategic-number sn-target-evaluation-damage-capability 1);200
	(set-strategic-number sn-target-evaluation-in-progress -300);0
	(set-strategic-number sn-target-evaluation-distance -300);100
	(set-strategic-number sn-target-evaluation-hitpoints 50);-100
	(set-strategic-number sn-target-evaluation-range -200);-50
	(set-strategic-number sn-target-evaluation-rof 0);-200
	(set-strategic-number sn-target-evaluation-time-kill-ratio 100);50
	(set-strategic-number sn-target-evaluation-attack-attempts -25);0
	(set-strategic-number sn-target-evaluation-ally-proximity 300);300
	(set-strategic-number sn-target-evaluation-randomness 0);0
	(set-strategic-number sn-target-evaluation-boat 0);-50
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-target-evaluation-continent 100);100
	(set-strategic-number sn-target-evaluation-kills 0);0
	(set-strategic-number sn-cap-civilian-gatherers 500)
	;(set-strategic-number sn-target-point-adjustment 5) ;default = 0 (left), 5 = middle
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-maximum-gaia-attack-response 7);3 ;wolf-hill map... ughhhhh...
	(set-strategic-number sn-minimum-dropsite-buffer 0) ;30
	(set-strategic-number sn-object-repair-level 2) ;16384 repairs siege, 1 - 3 repairs buildings (this is also in civ-strategy.per file) ;2 = TC repairs only ;24575 does general repairs
	(set-strategic-number sn-minimum-water-body-size-for-dock 2000)
	(set-strategic-number sn-maximum-boat-explore-group-size 1)
	(set-strategic-number sn-minimum-boat-explore-group-size 1)
	(set-strategic-number sn-number-boat-explore-groups 1)
	(set-strategic-number sn-preferred-trade-distance 255);255 ;it is only the preferred trade distance, not max. 255 is the max value
	(set-difficulty-parameter ability-to-maintain-distance 1) ;this handles "kiting" where any type of ranged unit shoots then runs away from your unit, shoots again, runs away, etc
	(set-difficulty-parameter ability-to-dodge-missiles 1) ;this is what makes units dodge mangonel or trebuchet or cannon galleon shots etc
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-gold-defend-priority 0) ;these defend-priority sn's are for tower (and maybe) castle placement. Better to use up-placement-data for precise placements
	(set-strategic-number sn-stone-defend-priority 0) ;range is 1 to 5, 1 being highest, and 5 lowest
	(set-strategic-number sn-forage-defend-priority 0)
	(set-strategic-number sn-relic-defend-priority 0)
	(set-strategic-number sn-town-defend-priority 0) ;1
	(set-strategic-number sn-dock-defend-priority 0)
	(set-strategic-number sn-cap-civilian-builders 50);testing ;promi uses 100
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-strategic-number sn-percent-attack-boats 0)
	(set-strategic-number sn-intelligent-gathering 1)
	(set-strategic-number sn-local-targeting-mode 1) ;1 units prioritize targeting by their attack bonuses (ex: spearman chasing a knight instead of the closer skirmisher etc)
	(set-strategic-number sn-percent-building-cancellation 60);under 65% building completion will be cancelled ;was 50%
	(disable-self)
)

	;NEW defer dropsite update turns on after the first couple of camps (otherwise bugs)
	;OFF for first few (this helps with DUC placements)
(defrule
	(true)
=>
   (set-strategic-number sn-defer-dropsite-update 0) ;default 0, updates when dropsite is placed, 1 updates once the dropsite is fully built ;DO NOT LEAVE THIS AT 0, if the building gets cancelled all your vills continue going there anyway!
   (disable-self) ;disable it
)
	;ON for remaining (DUC assistance rules no longer needed)
(defrule
	(strategic-number sn-defer-dropsite-update == 0) ;it is currently off
(or	(building-type-count lumber-camp >= 2)	;we have reached at least 2 camps/carts AND:
(or	(building-type-count mule-cart >= 2)
	(building-type-count mining-camp >= 2)))
(or	(up-pending-objects c: lumber-camp > 0)	;the next one has started getting built, TURN ON SN-DEFER-DROPSITE-DISTANCE so mid game is not affected and early game is better!
(or	(up-pending-objects c: mule-cart > 0)
	(up-pending-objects c: mining-camp > 0)))
=>
	(set-strategic-number sn-defer-dropsite-update 1)
	(disable-self) ;disable it
)

(defrule
	(true)
=>
	;(set-strategic-number sn-track-player-history 1) ;(I have no idea what this does, apparently does not work)
	(set-strategic-number sn-defend-overlap-distance 1)
	(set-strategic-number sn-defense-distance 7) ;3
	(set-strategic-number sn-sentry-distance 10);12
	(set-strategic-number sn-sentry-distance-variation 0)
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 100)
	(set-strategic-number sn-allow-civilian-offense 0)
	(set-strategic-number sn-allow-civilian-defense 1) ;0 = no defence, 1 = only weak non-ranged units, 2 = all weak units except warships and units faster than villagers, 3 = all weak units except warships
	(disable-self)
)

	;civilian offense (default)
(defrule
	(true)
=>
	(set-strategic-number sn-number-civilian-militia 5);testing, number of civilian attackers
	(set-strategic-number sn-allow-civilian-offense 2);0 = vills attack forward towers without murder holes, 1 = vils do TS attacks with soldiers, 2 = vils target enemy vils and buildings in town-size even if defensive soldiers available
	(disable-self)
)

	;civilian offense (off)
(defrule
(or	(goal is-town-under-attack yes)
	(strategic-number sn-military-level <= -1))
	(strategic-number sn-allow-civilian-offense != 0)
=>
	(set-strategic-number sn-number-civilian-militia 0)
	(set-strategic-number sn-allow-civilian-offense 0)
)

	;civilian OFFENCE (on)
(defrule
	(goal is-town-under-attack no)
	(strategic-number sn-military-level >= 0)
	(strategic-number sn-allow-civilian-offense != 2)
=>
	(set-strategic-number sn-number-civilian-militia 5)
	(set-strategic-number sn-allow-civilian-offense 2)
)
	;civilian DEFENCE
	;low
(defrule
	(strategic-number sn-military-level <= 0)
	(strategic-number sn-allow-civilian-defense != 1) ;0 means no civ defence
=>
	(set-strategic-number sn-allow-civilian-defense 1) ;1 is default
)
	;medium
(defrule
(or	(strategic-number sn-military-level == 1)
	(strategic-number sn-military-level == 2))
	(strategic-number sn-allow-civilian-defense != 2) ;see strategic numbers for more info (RANGE: 0 - 3)
=>
	(set-strategic-number sn-allow-civilian-defense 2)
)
	;high
(defrule
	(strategic-number sn-military-level > 2)
	(strategic-number sn-allow-civilian-defense != 3)
=>
	(set-strategic-number sn-allow-civilian-defense 3)
)

	;NEW STRATEGIC NUMBERS
(defrule
	(true)
=>
	(set-strategic-number sn-dock-training-filter 2);testing? 							;0 = no training restrictions, 1 = some restrictions, 2 = full blocking if recent sighted enemy
	(set-strategic-number sn-allow-serjeant-building 0);keep this off its annoying 		;1 = any alive serjeants build donjons automatically, if none are alive then a villager will build it instead
	(set-strategic-number sn-allow-gathering-sea-fish-with-villagers 1)					;1 = allow villagers to gather deep sea fish in addition to shore fish , 0 = not allowed
	(set-strategic-number sn-boar-lure-destination 9) 									;values from 0 to 23. 0 is the default base of the TC.
	(set-strategic-number sn-number-garrison-units 0) 									;values 0 to 40. 0 defaults to maximum of 40 units per garrison command?
	(set-strategic-number sn-placement-fail-delta 0) 									;how much to increase zone if unable to place building (increase every pass) ;does not store with placement-data ;everyone seems to default 0 for this
	;(set-strategic-number sn-filter-under-attack 0) 									;0 = disabled filter, 1 = only under attack units retreat, 2 = units near the threatened unit also retreat. ;promi uses 0 only. may be computationally expensive
	;(set-strategic-number sn-keystates 0) 												;this SN could be useful for DUC. It allows the ai to simulate holding "shift" or "ctrl" when using micro commands. values 0 = off, 1 = shift, 2 = ctrl, 3 = both
	(set-strategic-number sn-maximum-garrison-fill 0);testing							 ;used with DUC commands ;values 0 to 20.
)


;===================END OF GENERAL STRATEGIC NUMBERS===================

	;rebuilding only town center - delete old buildings for relocating
(defrule
	(game-time > 300) ;5 minute safety
	(up-pending-objects c: town-center-foundation > 0) ;might be more accurate than (building-type-count-total town-center > 0)
	(building-type-count town-center == 0)
(or	(building-type-count farm > 0)
(or	(building-type-count mill > 0)
(or	(building-type-count lumber-camp > 0)
(or (building-type-count mining-camp > 0)
	(building-type-count mule-cart > 0))))) ;these things might not move from their old locations so best be safe and delete too
	;(population < min-vills)
=>
	(up-delete-objects c: farm c: 32767)
	(up-delete-objects c: mill c: 32767)
	(up-delete-objects c: lumber-camp c: 32767)
	(up-delete-objects c: mining-camp c: 32767)
	(up-delete-objects c: mule-cart c: 32767)
)
	;delete mining camps when all gold and stone are exhausted
(defrule
	(game-time > 300)
	(goal GOLD-REMAINING no)
	(goal STONE-REMAINING no)
;	(dropsite-min-distance gold <= -1)
;	(dropsite-min-distance gold >= 480))
;	(dropsite-min-distance stone <= -1)
;	(dropsite-min-distance stone >= 480))
	(building-type-count mining-camp > 1) ;leave 1 left
;(or	(unit-type-count-total trade-cart >= 1)
;	(up-compare-goal increase-town-size-goal != 0))
=>
	(delete-building mining-camp)	
	;(chat-local-to-self "Deleting old mining-camps.")
)
	;delete lumber-camps when all wood is exhausted
(defrule
	(game-time > 300)
(or	(goal WOOD-REMAINING no)
	(cc-players-unit-type-count 0 tree-class <= 10))
	(building-type-count lumber-camp > 1) ;don't delete mule-carts as they are mobile ;leave 1 left
=>
	(delete-building lumber-camp)
	;(chat-local-to-self "Deleting old lumber-camps.")
)

	;backup resource rules
	;NO MORE GOLD
(defrule
	(game-time > 60);prevent premature action
	(up-compare-goal GOLD-REMAINING != no)
	(cc-players-unit-type-count 0 gold-mine <= 2) ;likely last pile left
;(or	(dropsite-min-distance gold <= -1)
;	(dropsite-min-distance gold >= 480)))
=>
;	(chat-to-player my-player-number "No more gold remaining on the map.")
	(set-goal GOLD-REMAINING no)) ;these 3 goals affect many rules

	;NO MORE STONE
(defrule
	(game-time > 60)
	(up-compare-goal STONE-REMAINING != no)
	(cc-players-unit-type-count 0 stone-mine <= 2) ;likely last pile left
;(or	(dropsite-min-distance stone <= -1)
;	(dropsite-min-distance stone >= 480)))
=>
;	(chat-to-player my-player-number "No more stone remaining on the map.")
	(set-goal STONE-REMAINING no))

	;NO MORE WOOD
(defrule
	(game-time > 60)
	(up-compare-goal WOOD-REMAINING != no)
	(cc-players-unit-type-count 0 915 <= 15) ;915 = tree-class ;likely last forest left
;	(dropsite-min-distance wood <= -1)
;	(dropsite-min-distance wood >= 480)))
=>
;	(chat-to-player my-player-number "No more wood remaining on the map.")
	(set-goal WOOD-REMAINING no))

	;currently no rules to reactivate these 3 resource goals

;==========;TAUNTS;==========;

	;NOTE: other than taunt 32 and 33, the rest of the specific unit taunts are located in Jester/Civ-Strategy.per
	;this also includes "taunt 43" rules. Located in Civ-Strategy.

;disable wait for my signal to attack
(defrule
	(taunt-detected any-ally 31)
	(up-compare-goal stop-attacking != no)
=>
	(chat-to-player this-any-ally "I will freely attack again.")
	(set-goal stop-attacking no)
	(set-goal ATTACK yes)
	(set-goal attack-goal standby)
)

;31 ATTACK AN ENEMY NOW - NO
(defrule
(or	(building-type-count town-center < 1)
(or	(military-population <= 9)
(or	(strategic-number sn-military-level <= -4) ;badly outnumbered
	(goal is-town-under-attack yes))))
	(taunt-detected any-ally 31)
=>
	(acknowledge-taunt this-any-ally 31)
	(chat-to-player this-any-ally "I'm unable to attack at this time.")
	(chat-to-player my-player-number "Attack request denied.")
)

;31 ATTACK AN ENEMY NOW - YES
(defrule
	(building-type-count town-center > 0)
	(military-population >= 10)
	(strategic-number sn-military-level >= -3)
	(goal is-town-under-attack no)
	(taunt-detected any-ally 31)
=>
	(acknowledge-taunt this-any-ally 31)
	(chat-to-player this-any-ally "Yes, attacking now!")
	(chat-to-player my-player-number "Attack request accepted.")
	(set-goal GL-FOCUS-PLAYER 1); resets to closest-enemy
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now)
)

;Already set-up
(defrule
	(taunt-detected any-ally 36)
	(up-compare-goal stop-attacking == yes)
=>
	(acknowledge-taunt this-any-ally 36)
	(chat-to-allies "I'm already set to not attack.")
)

;36 WAIT FOR MY SIGNAL TO ATTACK
(defrule
	(taunt-detected any-ally 36)
	(up-compare-goal stop-attacking != yes)
=>
	(acknowledge-taunt this-any-ally 36)
	(chat-to-player this-any-ally "I'll hold back until you say otherwise.")
	(set-goal stop-attacking yes)
	(set-goal ATTACK no)
	(set-goal attack-goal reset-attack);does nothing
	(disable-timer attack-timer)
	(up-retreat-now);safety
	(set-goal RETREAT yes);should immediately disable afterwards
)

;make sure attack-timer is disabled for taunt 36 (safety)
(defrule
	(goal stop-attacking yes)
	(up-timer-status attack-timer == timer-running)
=>
	;(chat-to-player every-ally "Disabling attack timer.")
	(disable-timer attack-timer)
)

; 44 How many resources do you have? (Thanks Promi!)
(defrule
	(taunt-detected any-human-ally 44)
=>
	(acknowledge-taunt every-ally 44)
	(up-get-fact wood-amount 0 temporary-goal)
	(up-chat-data-to-player-using-id this-any-human-ally 22080 g: temporary-goal); "Wood: %d"
	(up-get-fact food-amount 0 temporary-goal)
	(up-chat-data-to-player-using-id this-any-human-ally 22081 g: temporary-goal); "Food: %d"
	(up-get-fact gold-amount 0 temporary-goal)
	(up-chat-data-to-player-using-id this-any-human-ally 22082 g: temporary-goal); "Gold: %d"
	(up-get-fact stone-amount 0 temporary-goal)
	(up-chat-data-to-player-using-id this-any-human-ally 22083 g: temporary-goal); "Stone: %d"
	(up-chat-data-to-player this-any-human-ally "Population %d." g: my-pop)); "Population: %d"


;45 Retreat now!
(defrule
	(taunt-detected any-ally 45)
=>
	(acknowledge-taunt this-any-ally 45)
	(chat-to-player this-any-ally "Retreating!")
	(set-goal ATTACK no); probably doesn't do much, must disable other attacking rules (see taunt 36 rule)
	(up-retreat-now)
	(set-goal RETREAT yes)
)

;48 I'm being attacked, please help! (to be implemented soon)
