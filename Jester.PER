;TAUNT 52 RULES

;RESEND THE FLARE FOR THE MARKET
(defrule
	(cc-players-unit-type-count any-ally flare < 1)
	(taunt-detected any-ally 52)
=>
	(acknowledge-taunt this-any-ally 52)
	(chat-to-player this-any-ally "Signal me a new flare first!")
)

;prepare market placement (from taunt)
(defrule
	(up-pending-objects c: market < 2)
	(taunt-detected any-ally 52)
=>
	(up-reset-placement c: market))

;BUILD A MARKET AT FLARED LOCATION (taunt 52)
(defrule
	(taunt-detected any-ally 52)
	(cc-players-unit-type-count any-ally flare >= 1)
	(up-pending-objects c: market <= 2)
	(can-build market)
=>	
	;(set-strategic-number sn-placement-zone-size 3); 4
	;(up-reset-search 1 1 1 1)	;these two rules are not necessary
	;(up-reset-filters)
	(up-find-flare building-point-x)
	(up-set-target-point building-point-x)
	(up-build place-point 0 c: market)
	(acknowledge-taunt this-any-ally 52)
	(chat-to-player this-any-ally "Okay, building a market there!")
)

;CANNOT BUILD A MARKET AT FLARED LOCATION (taunt 52)
(defrule
	(cc-players-unit-type-count any-ally flare >= 1)
	(taunt-detected any-ally 52)
(not	(can-build market))
=>
	(acknowledge-taunt this-any-ally 52)
	(chat-to-player this-any-ally "I'm unable to build a market right now.")
)

;GIVE ME YOUR EXTRA RESOURCES
(defrule
(taunt-detected any-ally 38)
=>
(acknowledge-taunt this-any-ally 38)
(chat-to-player this-any-ally "haha no thanks LEECH! give me yours instead!")
)

;REFUSE TO BUILD A WONDER ANY EARLIER THAN IMPERIAL AGE
(defrule
(current-age <= castle-age)
(taunt-detected any-ally 37)
=>
(acknowledge-taunt this-any-ally 37)
(chat-to-player this-any-ally "Help me reach the Imperial-Age first.")
)

;BUILD A WONDER
(defrule
(goal BUILD-THE-WONDER no)
(current-age >= imperial-age)
(taunt-detected any-ally 37)
=>
(acknowledge-taunt this-any-ally 37)
(chat-to-player this-any-ally "Yes! It will be... WONDERFUL!")
(chat-local-to-self "goal BUILD-THE-WONDER yes")
(set-goal BUILD-THE-WONDER yes)
)

;ALREADY BUILDING A WONDER
(defrule
(goal BUILD-THE-WONDER yes)
(taunt-detected any-ally 37)
=>
(acknowledge-taunt this-any-ally 37)
(chat-to-player this-any-ally "I am already attempting to build the chonker boi."))

;DISABLE BUILD-THE-WONDER ONCE ITS BUILT
(defrule
(goal BUILD-THE-WONDER yes)
(building-type-count wonder > 0)
=>
(set-goal BUILD-THE-WONDER no))

; 42 - WHAT AGE ARE YOU IN?
(defrule
(taunt-detected any-ally 42)
=>
(chat-to-player this-any-ally "If I told you, I'd have to kill you for sure...")
(acknowledge-taunt this-any-ally 42)
)

;---END OF 42---

;69 delete the object at the flared location
(defrule
	(taunt-detected any-human-ally 69)
	(players-unit-type-count any-human-ally flare > 0)
=>
	(up-find-flare building-point-x)
	(up-full-reset-search)
	(up-set-target-point building-point-x)
	(up-filter-distance c: -1 c: 1)
	(up-find-local c: building-class c: 240)
	(up-find-local c: tower-class c: 240)
	(up-find-local c: wall-class c: 240)
	(up-find-local c: gate-class c: 240)
	(up-target-point 0 action-delete -1 -1)
	(acknowledge-taunt every-human 69)
	(chat-to-allies "Nice.")
)

		;RESOURCE REQUESTS

;FOOD - YES
;LEVEL 1 (high)
(defrule
	(player-in-game any-ally)
(not	(town-under-attack))
	(food-amount > 1000)
	(up-allied-resource-amount any-ally food <= 1000)
	(building-type-count market > 0)
	(taunt-detected any-ally 3)
=>
	(acknowledge-taunt this-any-ally 3)
	(tribute-to-player this-any-ally food 250)
	(chat-to-player this-any-ally "This IS the sauce!")
	(chat-local-to-self "Tributing 250 food to ally.")
)

;LEVEL 2 (average)
