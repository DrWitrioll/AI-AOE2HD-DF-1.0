;all LOAD files
(load "Jester/Constants_Jester")
(load "Jester/gathering")
(load "Jester/camp_rules")
(load "Jester/research")
(load "Jester/town_under_attack")
(load "Jester/civ_strategy")
(load "Jester/attacking")
(load "Jester/micro")

	;communicate current version number
(defrule
	(taunt-detected my-player-number 250)
=>
	(acknowledge-taunt my-player-number 250)
	(chat-to-player my-player-number CURRENT-VERSION-CHAT)) ;-----------------------------REMEMBER TO UPDATE THIS EVERY UPDATE IN DEFCONSTS!!!

(defrule
	(taunt-detected any-human 250) ;old aoe2 strategy taunt
=>
	(acknowledge-taunt this-any-human 250)
	(chat-to-player every-human CURRENT-VERSION-CHAT))

(defrule
	(taunt-detected any-computer 250)
=>
	(acknowledge-taunt this-any-computer 250)
	(chat-to-player every-computer CURRENT-VERSION-CHAT))

	;GOALS

	;ALL DEFAULT GOALS (yes)
	(defrule
	(true)
=>
	(set-goal GOLD-REMAINING yes) ;assume at game start for these 3 resources
	(set-goal STONE-REMAINING yes)
	(set-goal WOOD-REMAINING yes)
	(set-goal VILLAGER yes)
	(set-goal DODGE-ARROWS wait) ;yes = on, no = off, wait = (only for starting)
	(disable-self))

	;ALL DEFAULT GOALS (no)
	(defrule
	(true)
=>
	(set-goal ENEMY-LOCATED no)
	(set-goal TRASH-UNITS no)
	(set-goal RETREAT no)
	(set-goal feudal-pending no)
	(set-goal castle-pending no)
	(set-goal imperial-pending no)
	(set-goal BUILD-THE-WONDER no)
	(set-goal TRUSH no)
	(set-goal BOOM no); (currently unused)
	(set-goal NOMAD no)
	(set-goal FLUSH no)
	(set-goal WONDER-MODE no)
	(set-goal GIVE-UP no)
	(set-goal is-town-under-attack no)
	(disable-self))

	(defrule
	(true)
=>
	(set-goal SIEGE-FOR-CASTLE no)
	(set-goal BUILD-THE-WALL no)
	;(set-goal ALLY-IN-GAME no) ;taken care of in #load-if-defined rule
	(set-goal EMERGENCY-WALL no)
	(set-goal CAN-RESIGN no); CAN-RESIGN == yes once a town-center is constructed (nomad map style debug)
	(set-goal FAST-CASTLE no)
	;(set-goal position-goal flank) ;defined by #load-if-defined or not-defined rule above
	(set-goal being-drushed no)
	(set-goal DRUSH no)
	(set-goal defend-feudal no)
;	(set-goal can-flush no); this is decided in Jester\civ-strategy.PER
	(set-goal need-siege-workshop no)
	(set-goal need-castle no)
	(set-goal high-res-vils no) ;drop villager numbers when we have excess resources & train more trade units
	(disable-self))

(defrule
	(true)
=>
	(set-goal feudal-strategy-selected no)
	(set-goal castle-strategy-selected no)
	(set-goal imperial-strategy-selected no)
	(set-goal DEFAULT-STRATEGY no)
	(set-goal HUSSAR no)
	;(set-goal EMERGENCY-ATTACK no) ;found in attacking rules
	;(set-goal stop-attacking no); found in attacking rules
	(disable-self))

	;SPECIAL DEFAULT GOALS (no)
(defrule
	(true)
=>
	(set-goal WATER-MAP maybe) ;WATER-MAP is actually just the map-type. maybe is middleground for starting
	(set-goal allow-walls wait) ;middle ground for allowing walls ;note Jester does not build walls
	(set-goal GARRISON no)
	(set-goal RESIGN-CHAT 0) ;Random chats when Jester resigns
	(set-goal BANTER-CHAT 0) ;NEW first random sassy chat at game start
	(set-goal FIRST-ATTACK-CHAT 0) ;NEW random chat when Jester first attacks
	(set-goal UNDER-ATTACK-CHAT 0)
	(set-goal MEME-STRATEGY no) ;oof you found it! Now turn it on in the "Jester/civ-strategy" file. Only one rule to enable (erase the semi-colons ";")
	(set-goal sheep-micro no) ;why does no other AI have this?!?! Not even Promi?! (only in nomad games for getting the far away sheep to the tc after it gets built)
	(set-goal RESET-STRATEGY no) ;don't ask don't tell
	(set-goal BOOM no)
	(set-goal FEUDAL-SCOUT-CAVALRY no) ;only feudal scouts
	(set-goal VILLAGER-PRIORITY no) ;yes = villager production priority, no = no special priority
	(set-goal MILITARY-TRAINING no) ;yes = allow military production, no = don't allow military production , has dynamic rules located below in this file
	(set-goal SIEGE-RUSH no)
	(disable-self)
)

	;DEFAULT GOAL VALUES
(defrule
	(true)
=>
	(set-goal enemy-dark-strategy no) ;I've given up on the insane amount of work these 4 goals could take to implement (competitive maybe?)
	(set-goal enemy-feudal-strategy no) ;only one that is currently implemented
	(set-goal enemy-castle-strategy no)
	(set-goal enemy-imperial-strategy no)
	(set-goal gl-trade-units low) ;default, some to start, then raise it later (and lower it again if both trade-cart and trade-cog > 0)
	(set-goal town-size-goal 0) ;dynamic town-size goal, 0 = no change, 1 = increase, 2 = decrease
	(set-goal SKIRM-TYPE SKIRM) ;SKIRM = skirmishers , GENITOUR = genitours
	(set-goal defend-castle no) ;NEW activates when booming and under attack in castle-age
	(disable-self))

;=============END OF INITIAL GOAL VALUES=============

;=============CUSTOM GOALS=============

	;REOCCURING GOAL VALUES
(defrule
	(true)
=>
	(up-get-fact population 0 my-pop)
	(up-get-fact civilian-population 0 my-civ-pop)
	(up-get-fact military-population 0 my-mil-pop)
	(up-get-target-fact military-population 0 enemy-mil-pop))
	
	;testing purposes
(defrule
	(taunt-detected my-player-number 252)
=>
	(acknowledge-taunt my-player-number 252)
	(up-chat-data-to-player my-player-number "my-mil-pop: %d." g: my-mil-pop)
	(up-chat-data-to-player my-player-number "enemy-mil-pop: %d." g: enemy-mil-pop)
	(up-modify-goal my-mil-pop g:- enemy-mil-pop) ;for quick checking
	(up-chat-data-to-player my-player-number "mil-diff: %d." g: my-mil-pop)
	(up-modify-goal my-mil-pop g:= military-population) ;reset
	(up-chat-data-to-player my-player-number "town-size: %d." s: sn-maximum-town-size)
	(up-chat-data-to-player my-player-number "border-distance: %d." s: sn-safe-border-distance) ;works with some DUC rules & building placement (town-size SN + 4 tiles I think)
	(up-chat-data-to-player my-player-number "sn-military-level: %d." s: sn-military-level)
	(up-chat-data-to-player my-player-number "sn-focus-player: %d." s: sn-focus-player-number)
	(up-chat-data-to-player my-player-number "sn-target-player: %d." s: sn-target-player-number)
	;(up-chat-data-to-player my-player-number "sn-repair-level: %d." s: sn-object-repair-level) ;SN is working again
	;(up-chat-data-to-player my-player-number "infantry-threat-level %d." g: infantry-threat-level) ;WIP
)

;==========CUSTOM SN'S==========
(defrule
	(true)
=>
	(set-strategic-number sn-military-level 0)	;default start
	(set-strategic-number current-mining-distance 14) ;these goals keep track of lumber & mining camp max distances
	(set-strategic-number current-lumber-distance 10)
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1) ; set to "1" to not have your ai nerfed. This needs to be set before all strategic numbers (not custom)
	(set-strategic-number sn-scale-minimum-attack-group-size 0) ;ai ref says better to leave this at 0
	;(set-strategic-number sn-scaling-frequency 0) ;default is 10, but because sn-scale-minimum-attack-group-size it should not increase the minimum. If set, the minimum-size can exceed the maximum size causing inactive attack-groups. Best leave it this way.
	(set-strategic-number sn-safe-border-distance 15) ;used with up-set-placement-data & DUC
	(disable-self))

	;NEW MILITARY LEVEL ANALYSIS

;NEW: MILITARY LEVELS

; 4 means enemy completely outnumbered
; 3 means drastically more military
; 2 means much more military
; 1 means a little more military
; 0 means around the same military
; -1 means a little less military
; -2 means much less military
; -3 means drastically less military
; -4 means we're completely outnumbered

;==========;military-level calculation;==========;
	;SET-UP
(defrule
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
=>
	(up-get-fact military-population 0 my-mil-count)
	(up-get-target-fact military-population 0 enemy-mil-count)
	;(up-modify-goal enemy-mil-count c:max 0) ;what does this do?
	(up-modify-goal my-mil-count g:- enemy-mil-count))

	;NEW IMPROVED MILITARY-LEVEL RULES						;these numbers overestimate the enemies ability with numbers (home-base advantage), so we only attack when we have much more numbers, and retreat when the enemy is getting close to our military numbers.
	;NEW LOW LEVEL MILITARY CALCULATION
;level 4
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count >= 20)
	(strategic-number sn-military-level != 4)
=>
	(set-strategic-number sn-military-level 4))
;level 3
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= 19)
	(up-compare-goal my-mil-count >= 15)
	(strategic-number sn-military-level != 3)
=>
	(set-strategic-number sn-military-level 3))
;level 2
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= 14)
	(up-compare-goal my-mil-count >= 10)
	(strategic-number sn-military-level != 2)
=>
	(set-strategic-number sn-military-level 2))
;level 1
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= 9)
	(up-compare-goal my-mil-count >= 5)
	(strategic-number sn-military-level != 1)
=>
	(set-strategic-number sn-military-level 1))
;level 0
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= 4)
	(up-compare-goal my-mil-count >= 0)
	(strategic-number sn-military-level != 0)
=>
	(set-strategic-number sn-military-level 0))
;level -1
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= -1)
	(up-compare-goal my-mil-count >= -5)
	(strategic-number sn-military-level != -1)
=>
	(set-strategic-number sn-military-level -1))
;level -2
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= -6)
	(up-compare-goal my-mil-count >= -10)
	(strategic-number sn-military-level != -2)
=>
	(set-strategic-number sn-military-level -2))
;level -3
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= -11)
	(up-compare-goal my-mil-count >= -15)
	(strategic-number sn-military-level != -3)
=>
	(set-strategic-number sn-military-level -3))
;level -4
(defrule
	(up-compare-goal enemy-mil-count < 30)
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count <= -16)
	(strategic-number sn-military-level != -4)
=>
	(set-strategic-number sn-military-level -4))

	;NEW HIGH MILITARY LEVEL CALCULATION
;level 4
(defrule
	(up-compare-goal enemy-mil-count >= 30)				;we should not compare all military-levels as alike, more enemy military means more risk hence why this is broken up into 2 sections now
	(player-in-game any-enemy)
	(players-building-count any-enemy >= 1)
	(up-compare-goal my-mil-count >= 32)
	(strategic-number sn-military-level != 4)
