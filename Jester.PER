;BUYING RESOURCES FOR TOWN-CENTER

;TOO MUCH WOOD BEFORE 2ND TOWN-CENTER (this rule is not needed?)
;(defrule
;(current-age >= castle-age)
;(building-type-count-total town-center <= 1) ;not neccessary
;(wood-amount > 1200)
;(gold-amount < 500)
;(commodity-selling-price wood >= 50)
