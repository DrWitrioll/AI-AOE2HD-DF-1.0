;FAST CASTLE STABLE
(defrule
	(goal FAST-CASTLE yes) ;important
(or	(goal KNIGHT yes)
(or	(goal BATTLE-ELEPHANT yes)
(or	(goal STEPPE-LANCER yes)
(or	(goal CAMEL main) ;temp fix
	(goal SCOUT-CAVALRY main)))))
	(building-type-count town-center > 0)
	(building-type-count-total stable < 1)
	(can-build stable)
=>
	(up-assign-builders c: stable c: 2)
	(build stable))

;MARKET (normal) (ally yes)
(defrule
(current-age == feudal-age)
(player-in-game any-ally) ;ally alive and well
(goal is-town-under-attack no)
(goal FAST-CASTLE no)
(or	(building-type-count stable >= 2)
	(building-type-count archery-range >= 2))
(building-type-count blacksmith > 0)
(building-type-count-total town-center > 0)
(or	(wood-amount > 275)
	(dropsite-min-distance wood <= 8))
(building-type-count-total market < 1)
(can-build market)
=>
	(set-strategic-number sn-placement-zone-size 10)
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data my-player-number -1 c: -20) ;home town center = -1
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: market)
)

;MARKET (normal) (ally no)
(defrule
(current-age == feudal-age)
(not	(player-in-game any-ally)) ;no ally
(goal is-town-under-attack no)
(goal FAST-CASTLE no)
(or	(building-type-count stable >= 2)
	(building-type-count archery-range >= 2))
(building-type-count blacksmith > 0)
(building-type-count-total town-center > 0)
(wood-amount > 400) ;don't waste wood
(building-type-count-total market < 1)
(can-build market)
=>
	(set-strategic-number sn-placement-zone-size 10)
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data my-player-number -1 c: -12) ;home town center = -1
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: market)
)
;MARKET (FAST-CASTLE)
(defrule
(goal FAST-CASTLE yes)
(goal MEME-STRATEGY no)
(not	(civ-selected khmer)) ;no buildings required for castle-age
(current-age == feudal-age)
(current-age-time > 10) ;for empire wars and similar game modes
(or	(building-type-count-total stable < 1) ;pointless building a market if there is already a stable or range plus a blacksmith
	(building-type-count-total archery-range < 1))
(building-type-count-total blacksmith > 0) ;must have a blacksmith
(building-type-count-total town-center > 0)
(building-type-count-total market < 1)
(can-build market)
=>
	(set-strategic-number sn-placement-zone-size 10)
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data my-player-number -1 c: -12) ;home town center = -1
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: market)
)

;EMERGENCY FEUDAL MARKET (for age progression)
(defrule
	(current-age == feudal-age)
	(goal castle-pending no)
	(current-age-time >= 180) ;minimal time to consider a market
	(food-amount > 800) ;minumum acceptable resources for feudal-age
	(gold-amount >= 200)
(or	(building-type-count-total blacksmith < 1)
	(and	(building-type-count-total blacksmith >= 1)
	(and	(building-type-count-total archery-range < 1)
			(building-type-count-total stable < 1)))) ;age-progression buildings
	(building-type-count town-center > 0)
	(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(building-type-count-total market < 1)
	(can-build market)
=>
	;(chat-local-to-self "Building emergency market.")
	(build market) ;don't use place-control because this is an emergency
)

;MARKET (CASTLE & ABOVE) ;I cant believe after all this time it didn't have any market rules beyond feudal-age LMAO xD
(defrule
	(current-age >= castle-age)
	(current-age-time >= 120) ;some buffer
	(building-type-count-total town-center >= 3) ;default rules will be to build after 3 town-centers built
	(building-type-count-total market < 1)
	(can-build market)
=>
	(up-set-placement-data my-player-number -1 c: -20) ;home town center = -1 ;build it behind regardless of allies or not
	(up-build place-control 0 c: market)
)

;CARAVANSERAI ;for persians and hindustanis
;1st
(defrule
(or	(up-compare-goal WATER-MAP == no) ;only connected or full land maps to prevent bugs
	(up-compare-goal WATER-MAP == connected))
	(current-age >= imperial-age)
	(goal is-town-under-attack no)
	(dropsite-min-distance wood <= 7) ;safe wood
	(players-building-type-count any-ally market > 0)
	(building-type-count-total town-center >= 3)
	(unit-type-count-total villager > min-vills)
	(unit-type-count trade-cart >= 5) ;must have some trade already
	(building-type-count market > 0)
	(building-type-count-total caravanserai == 0) ;1st
	(can-build caravanserai)
=>
	(set-strategic-number sn-placement-zone-size 9)
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data my-player-number market c: -3) ;build near our market
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: caravanserai)
)

;2nd
(defrule
(or	(up-compare-goal WATER-MAP == no) ;only connected or full land maps to prevent bugs
	(up-compare-goal WATER-MAP == connected))
	(current-age >= imperial-age)
	(goal is-town-under-attack no)
	(dropsite-min-distance wood <= 7) ;safe wood
	(players-building-type-count any-ally market > 0)
	(building-type-count-total town-center >= 3)
	(unit-type-count-total villager > min-vills)
	(unit-type-count trade-cart >= min-trade-pop) ;must have some trade already
	(building-type-count market > 0)
	(building-type-count-total caravanserai == 1) ;2nd
	(can-build caravanserai)
=>
	(set-strategic-number sn-placement-zone-size 10); 20
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data any-ally market c: -3) ;2nd goes near ally market
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: caravanserai)
)

