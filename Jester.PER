;==========RANDOM FIRST ATTACK CHATS SET-UP==========
(defrule
	(game-time > 5)
	(goal FIRST-ATTACK-CHAT 0)
=>
	(generate-random-number 5) ;get a random number from 1 to 5
	(up-get-fact random-number 0 FIRST-ATTACK-CHAT) ;store the random number into FIRST-ATTACK-CHAT
	(disable-self))
;1
(defrule
	(goal ATTACK yes)
	(strategic-number sn-military-level >= 1)
	(strategic-number sn-target-player-number > 0)
	(goal FIRST-ATTACK-CHAT 1)
=>
	(chat-to-player target-player "23 DO YOU KNOW WHAT TIME IT IS? THATS RIGHT ITS DYING TIME!") ;NEW VERSION 2.3
	(disable-self))
;2
(defrule
	(goal ATTACK yes)
	(strategic-number sn-military-level >= 1)
	(strategic-number sn-target-player-number > 0)
	(goal FIRST-ATTACK-CHAT 2)
=>
	(chat-to-player target-player "Time for me to feebly attempt to ctrl-alt-delete that beautiful town of yours!") ;NEW VERSION 2.3
	(disable-self))
;3
(defrule
	(goal ATTACK yes)
	(strategic-number sn-military-level >= 1)
	(strategic-number sn-target-player-number > 0)
