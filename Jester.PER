(building-type-count-total market > 0)
(wood-amount >= 800)
(unit-type-count-total villager > min-vills)
(building-type-count-total barracks < 8)
(up-pending-objects c: barracks < 1) ;one at a time so other buildings can build too
(can-build barracks)
