;DEFENSIVE WATCH TOWERS
(defrule
	(current-age >= imperial-age)
	(strategic-number sn-military-level <= -1)
	(building-type-count town-center > 1)
	(building-type-count castle > 1)
	(building-type-count-total watch-tower-line < 4)
	(can-build watch-tower-line)
=>
	(build watch-tower-line)
)

;DONJON (for serjeant production) (feudal-age)
(defrule
	(goal sicilian-civ yes)
	(goal SWORDMAN yes); automatically makes serjeants now instead of longswords
	(current-age == feudal-age)
	(building-type-count town-center >= 1)
	(building-type-count-total donjon < 1) ;make 1 like a barracks
	(can-build donjon)
=>
	(up-set-placement-data my-player-number -1 c: 3) ;home town center = -1
	(up-assign-builders c: donjon c: 6)
	(build donjon)
)

;DONJON (for serjeant production) (castle-age and higher) LEVEL 1
(defrule
	(goal sicilian-civ yes)
	(goal SWORDMAN yes); automatically makes serjeants now instead of longswords
	(current-age >= castle-age)
	(building-type-count town-center >= 1) ;2
	(building-type-count-total castle < 1) ;if no castle then make 1 donjon
	(building-type-count-total donjon < 1) ;make 1 to start
	(can-build donjon)
=>
	(up-set-placement-data my-player-number -1 c: 3)
	(up-assign-builders c: donjon c: 6)
	(build donjon)
)

;DONJON (for serjeant production) (castle-age and higher) LEVEL 2
(defrule
	(goal sicilian-civ yes)
	(goal SWORDMAN yes); automatically makes serjeants now instead of longswords
	(current-age >= castle-age)
	(building-type-count town-center >= 3) ; 3 TCS
	(building-type-count-total castle > 0) ;if 1 or more castles, make 4 donjon
	(building-type-count-total donjon < 4)
	(can-build donjon)
=>
	(up-set-placement-data my-player-number -1 c: 3)
	(up-assign-builders c: donjon c: 6)
	(build donjon)
)

;DEFENSIVE TOWERS
(defrule
(or	(and	(goal UNIQUE-ENEMY-ARCHER yes) 
		(players-unit-type-count target-player my-unique-unit-line > 20))
(or	(and	(goal UNIQUE-ENEMY-CAV-ARCHER yes) 
		(players-unit-type-count target-player my-unique-unit-line > 25))
(or	(and	(goal UNIQUE-ENEMY-SIEGE yes) 
		(players-unit-type-count target-player my-unique-unit-line > 20))
(or	(and	(goal UNIQUE-ENEMY-HAND-CANNONEER yes) 
		(players-unit-type-count target-player my-unique-unit-line > 20))
(or	(players-unit-type-count target-player archer-line > 22)
(or	(players-unit-type-count target-player skirmisher-line > 26)
(or	(players-unit-type-count target-player genitour-line > 26)
(or	(players-unit-type-count target-player cavalry-archer-line > 25)
(or	(players-unit-type-count target-player hand-cannoneer > 20)
	(players-unit-type-count target-player slinger > 24))))))))))
=>
	(up-jump-rule 1)
)
(defrule
	(true)
=>
	(up-jump-rule 2)
) ;end jump

;WATCH TOWER
(defrule
	(current-age >= castle-age)
(not	(town-under-attack))
	(strategic-number sn-military-level <= -3)
	(building-type-count town-center > 1);1
	(goal sicilian-civ no) ;donjon rule below
	(goal cuman-civ no)
	(not (civ-selected gothic))
	(not (civ-selected hun))
	(building-type-count-total castle < 2)
	(building-type-count-total watch-tower-line < 4)
	(can-build watch-tower-line)
=>
	(up-assign-builders c: watch-tower-line c: 6)
	(build watch-tower-line)
)

;DONJON
(defrule
	(goal sicilian-civ yes)
	(current-age >= castle-age)
(not	(town-under-attack))
	(strategic-number sn-military-level <= -3)
	(building-type-count town-center > 1);1
	(building-type-count-total castle < 2)
	(building-type-count-total donjon < 4)
	(can-build donjon)
=>
	(up-assign-builders c: donjon c: 6)
	(build donjon)
);end jump

	;drop a safety tower
(defrule
	(current-age == feudal-age)
	(goal position-goal flank) ;only flanks
(not	(town-under-attack))
	(goal is-town-under-attack no); help prevent villager suicide
(or	(goal enemy-feudal-strategy archers)
(or	(goal enemy-feudal-strategy skirmishers)
(or	(goal enemy-feudal-strategy arch/skirm)
	(strategic-number sn-military-level <= -2))))
	(building-type-count-total watch-tower-line < 1)
	(building-type-count town-center > 0)
	(can-build watch-tower-line)
=>
	(up-full-reset-search)
	(up-set-placement-data my-player-number -1 c: 5) ;home town center = -1
	(up-assign-builders c: watch-tower c: 6)
	(up-build place-control 0 c: watch-tower-line)
)

	;expect a flush against us
(defrule
	(current-age == feudal-age)
	(goal is-town-under-attack no); help prevent villager suicide
	(goal position-goal flank) ;only flanks
	(goal FAST-CASTLE yes); we are trying to up
(or	(up-enemy-units-in-town > 3)
	(strategic-number sn-military-level <= -1))
	(building-type-count-total watch-tower-line < 1)
	(building-type-count town-center > 0)
	(up-pending-objects c: watch-tower-line < 1)
	(can-build watch-tower-line)
=>
	(up-full-reset-search)
