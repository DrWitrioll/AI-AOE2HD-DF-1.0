	;OVERIDE MILITARY LEVEL (special circumstances)

	;rule 1: enemy is stuck in previous age
(defrule
	(military-population >= 8) ;minimum 8 military
	(players-military-population target-player <= 15)
	(current-age >= castle-age)
	(current-age-time > 120)
	(players-current-age target-player <= feudal-age)
	(players-current-age-time target-player > 300)
	(strategic-number sn-military-level < 4) ;safety so it can't go above 4
=>
	(up-modify-sn sn-military-level c:+ 1)	;this will only add 1 level max per rule pass so it shouldn't bug out
)

	;rule 2: we are stuck in previous age
(defrule
	(military-population <= 15)
	(players-military-population target-player >= 8)
	(current-age <= feudal-age)
	(current-age-time > 60)
	(players-current-age target-player >= castle-age)
	(players-current-age-time target-player > 60)
	(strategic-number sn-military-level > -4) ;safety so it can't go below -4
=>
	(up-modify-sn sn-military-level c:- 1)	;this will only subtract 1 level max per rule pass so it shouldn't bug out
)

;==========END OF CUSTOM SN'S==========

;START ECO-TIMER

	(defrule
(or	(and	(goal sheep-micro no); let sheep micro finish first
	(and	(building-type-count town-center > 0)
			(research-completed ri-loom)))
	(and	(game-time > 240)
			(current-age >= feudal-age)))
=>
	(enable-timer eco-timer 120)
	;(chat-local-to-self "Starting eco-timer.")
	(disable-self))

	;ENABLE GOALS

	;detect allies reliably throughout entire game

;ALLY IN GAME (for if players change teams)
(defrule
	(game-time > 30)
	(up-compare-goal ALLY-IN-GAME != yes)
	(player-in-game any-ally)
=>
	(set-goal ALLY-IN-GAME yes)
	;(chat-to-player my-player-number "I have an ally.")
); don't disable, as players can switch teams

;DISABLE ALLY IN GAME
(defrule
	(game-time > 30)
	(up-compare-goal ALLY-IN-GAME != no)
(not	(player-in-game any-ally))
=>
	;(chat-to-player my-player-number "No allies detected.")
	(set-goal ALLY-IN-GAME no)
)

;siege for castle goal
(defrule
	(goal SIEGE-FOR-CASTLE no)
(or	(unit-type-count battering-ram-line > 1)
(or	(unit-type-count armored-elephant-line > 1)
(or	(unit-type-count trebuchet-set > 0)
(or	(unit-type-count bombard-cannon-line > 1) ;includes houfnice?
	(goal EMERGENCY-ATTACK yes))))); prevents bugs
=>
	(chat-to-player my-player-number "Enough siege for any enemy castles.")
	(set-goal SIEGE-FOR-CASTLE yes))
;reset
(defrule
	(up-compare-goal SIEGE-FOR-CASTLE != yes)
	(goal EMERGENCY-ATTACK no); prevents bugs
	(unit-type-count battering-ram-line <= 1)
	(unit-type-count armored-elephant-line <= 1)
	(unit-type-count trebuchet-set <= 0)
	(unit-type-count bombard-cannon-line <= 1)
	(up-projectile-detected projectile-castle < 5000) ;NEW we must detect castle arrow fire to prevent retreating too soon
=>
	(chat-to-player my-player-number "Not enough siege for enemy castles.")
	(set-goal SIEGE-FOR-CASTLE no))

;feudal-pending
(defrule
	(goal feudal-pending no)
	(up-research-status c: feudal-age == research-pending)
=>
	(set-goal feudal-pending yes)
	(disable-self))

;disable feudal-pending
(defrule
	(goal feudal-pending yes)
	(research-completed feudal-age)
=>
	(set-goal feudal-pending no)
	(disable-self))

;castle-pending
(defrule
	(goal castle-pending no)
	(up-research-status c: castle-age == research-pending)
=>
	(set-goal castle-pending yes)
	(disable-self))

;disable castle-pending
(defrule
	(goal castle-pending yes)
	(research-completed castle-age)
=>
	(set-goal castle-pending no)
	(disable-self))

;imperial-pending
(defrule
	(goal imperial-pending no)
	(up-research-status c: imperial-age == research-pending)
=>
	(set-goal imperial-pending yes)
	(disable-self))

;disable imperial-pending
(defrule
	(goal imperial-pending yes)
	(research-completed imperial-age)
=>
	(set-goal imperial-pending no)
	(disable-self))

;enable high-res-vils
(defrule
	;(current-age >= castle-age) ;do this for any age
	(up-compare-goal high-res-vils != yes) ;high-res-vils == no
(or	(population >= max-pop); wait until we are pop-maxed or have max eco, then consider the rest
	(civilian-population >= max-vill-pop)) ;consider trade carts as part of the conditions (not just villagers as sometimes we never hit max vill pop due to high military)
(or	(goal WOOD-REMAINING no) ;almost all trees are gone from the map, OR:
(or	(building-type-count feitoria >= 2) ;NEW lower vills if portuguese build multiple feitorias
			(and	(food-amount > 2600) ;we have excess resources for more military or trade
			(and	(wood-amount > 2600)
					(gold-amount > 1000))))) ;gold is lower, since it is usually low by the late game
=>
	(chat-local-to-self "Lowering max villager population.")
	(set-goal high-res-vils yes)
)

;disable high-res-vils
(defrule
	;(current-age >= castle-age) ;any age now
	(up-compare-goal high-res-vils != no) ;only consider returning to normal villager training, IF:
	(goal WOOD-REMAINING yes) ;If wood is so low on the map then we don't need excessive villagers
	(unit-type-count villager < high-res-vil-pop); Villager numbers are dropping below our limit, AND:
	(building-type-count feitoria <= 1) ;NEW raise villagers if we only have 1 or they are all lost
	(food-amount < 500)	;food, wood & gold are all low under 500.
	(wood-amount < 500)
	(gold-amount < 500)
=>
	(chat-local-to-self "Resetting max villager population.")
	(set-goal high-res-vils no)
)

;DETECT DEFEND THE WONDER MODE
(defrule
(game-time > 10)
(game-time < 30)
(or	(building-type-count wonder > 0)
(or	(players-building-type-count any-ally wonder > 0)
	(players-building-type-count any-enemy wonder > 0)))
	(current-age >= imperial-age) ;includes post-imperial-age ;if this one condition isn't met then we need escrow for upgrades and age up
=>
	(chat-local-to-self "Defend the wonder mode detected, no escrow.")
	(set-goal WONDER-MODE yes)
	(disable-self))

;set correct goal based on if we have a wonder or not when the game starts
(defrule
(goal IS-WONDER-ALIVE no)
(game-time >= 5)
(building-type-count wonder > 0)
=>
(set-goal IS-WONDER-ALIVE yes))

(defrule
(goal IS-WONDER-ALIVE yes)
(game-time > 5)
(building-type-count wonder < 1)
=>
(set-goal IS-WONDER-ALIVE no))

;BUILD A WONDER IF: (disabled for now, if a player taunts to build a wonder then this ai will do it as described in rules below.
;(defrule
;(current-age >= imperial-age) ; includes post-imperial
;(nor    (players-building-type-count any-ally wonder > 0); One is good enough for the team.
	;(players-building-type-count any-enemy wonder > 0)) ; Don't waste resources building one if the enemy already has one.
	;(goal BUILD-THE-WONDER no)
	;(or (game-time > 5400)
	;(and (wood-amount > 2000)
	;(and (gold-amount > 2000)
	;(stone-amount > 1000))))
;=>
	;(set-goal BUILD-THE-WONDER yes)
	;(chat-to-allies "I will attempt to build a wonder!")
	;(disable-self))

;GO NOMAD
(defrule
(goal NOMAD no)
(game-time < 30)
(building-type-count town-center < 1)
=>
(chat-to-player my-player-number "Nomad-type map detected.")
(set-goal NOMAD yes)
(disable-self)
)

;====================SURVIVAL RULES (see also "gathering rules" for extra survival rules)

;EMERGENCY NEED A TOWN CENTER (turn on) (lumber-camp)
(defrule
	(current-age-time > 30) ;min time to consider such a measure
	(goal REACTIVE-GATHERING no)
	(building-type-count-total town-center < 1)
	(building-type-count-total lumber-camp < 1) ;fixed
(not	(building-available mule-cart))
	(unit-type-count villager > 0)
(or	(wood-amount < 275)
(or	(stone-amount < 100)
(not	(can-build town-center))))
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
	(release-escrow food) ;safety
	(release-escrow wood)
	(release-escrow gold)
	(release-escrow stone)
	(build lumber-camp)
	(set-goal REACTIVE-GATHERING yes)); basically means basic gathering based on many different scenarios

;EMERGENCY NEED A TOWN CENTER (turn on) (mule-cart)
(defrule
	(current-age-time > 30) ;min time to consider such a measure
	(goal REACTIVE-GATHERING no)
	(building-type-count-total town-center < 1)
	(building-type-count-total mule-cart < 1) ;fixed
(not	(building-available lumber-camp))
	(unit-type-count villager > 0)
(or	(wood-amount < 275)
(or	(stone-amount < 100)
(not	(can-build town-center))))
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(release-escrow food) ;safety
	(release-escrow wood)
	(release-escrow gold)
	(release-escrow stone)
	;(set-strategic-number sn-mule-cart-dropsite-placement lumber-camp) ;already defined in CAMP_RULES.per
	(build mule-cart)
	(set-goal REACTIVE-GATHERING yes)); basically means basic gathering based on many different scenarios

;EMERGENCY NEED A TOWN CENTER (turn off)
(defrule
	(current-age-time > 45)
	(goal REACTIVE-GATHERING yes)
(or	(building-type-count-total town-center >= 1)	;we're building a town-center
	(unit-type-count villager < 1))					;OR all vills are dead
=>
	(release-escrow food) ;just in case we acquire escrow during our survival rules
	(release-escrow wood)
	(release-escrow gold)
	(release-escrow stone)
	(set-goal REACTIVE-GATHERING no))

;extend max lumber distance
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1)
(or	(dropsite-min-distance wood >= 25)
(or	(and	(building-type-count-total lumber-camp < 1)
			(building-available lumber-camp)) ;for armenian and georgian civs
	(and	(building-type-count-total mule-cart < 1)
			(building-available mule-cart))))
	(strategic-number sn-lumber-camp-max-distance != 200)
=>
	(set-strategic-number sn-lumber-camp-max-distance 200))

;extend max mining distance
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1)
(or	(dropsite-min-distance stone > 25)
(or	(building-type-count-total mining-camp < 1)
	(building-type-count-total mule-cart < 1)))
	(strategic-number sn-mining-camp-max-distance != 200)
=>
	(set-strategic-number sn-mining-camp-max-distance 200))

;reset max lumber distance
(defrule
	(goal REACTIVE-GATHERING yes)
	(dropsite-min-distance wood <= 25)
	(strategic-number sn-lumber-camp-max-distance == 200) ;reset
=>
	(set-strategic-number sn-lumber-camp-max-distance 14)) ;avg

;reset max mining distance
(defrule
	(goal REACTIVE-GATHERING yes)
	(dropsite-min-distance stone <= 25)
	(strategic-number sn-mining-camp-max-distance == 200) ;reset
=>
	(set-strategic-number sn-mining-camp-max-distance 14)) ;avg

;delete old lumber-camp's
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1)
	(dropsite-min-distance wood > 25); old LC's
	(up-pending-objects c: lumber-camp < 1) ;don't delete current LC's
	(building-type-count lumber-camp > 1); never delete our only LC
	(wood-amount > 100); only delete if we can afford a replacement
=>
	(delete-building lumber-camp))

;delete old mining-camp's
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1)
	(dropsite-min-distance stone > 25); old MC's
	(up-pending-objects c: mining-camp < 1) ;don't delete current MC's
	(building-type-count mining-camp > 1); never delete our only MC
	(wood-amount > 100); only delete if we can afford a replacement
=>
	(delete-building mining-camp))

;EMERGENCY LUMBER-CAMP
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1)
(or	(dropsite-min-distance wood >= 25)
	(building-type-count-total lumber-camp < 1))
	(wood-amount < 275)
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
	(build lumber-camp))

;EMERGENCY MINING-CAMP
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1)
(or	(dropsite-min-distance stone >= 25)
	(building-type-count-total mining-camp < 1))
	(building-type-count-total lumber-camp > 0) ;LC first
	(stone-amount < 100)
	(up-pending-objects c: mining-camp < 1) ;defer dropsite SN now in use
	(can-build mining-camp)
=>
	(build mining-camp))

;EMERGENCY MULE-CART
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1)
(or	(dropsite-min-distance wood > 25)
	(building-type-count-total mule-cart < 1))
	(wood-amount < 275)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(build mule-cart))

;====================END OF SURVIVAL RULES 

;BACKUP DISABLE NOMAD
(defrule
(up-compare-goal NOMAD != yes) ;not defined yet
(up-compare-goal NOMAD != no)
(game-time > 15)
(game-time < 30)
(building-type-count town-center > 1)
=>
(set-goal NOMAD no)
(disable-self)
)

;Disable Trush goal in castle or greater age or if enemy is. AND disable Trush goal if enemy has more than 7 soldier-count
(defrule
(goal TRUSH yes)
(goal defend-feudal no)
(current-age-time > 5)
(or (current-age >= castle-age) ; Disable if we're in the castle age.
(or (players-current-age target-player >= castle-age)
(players-military-population target-player > 7))) ; Disable if the enemy is in the castle age first.
=>
;(chat-local-to-self "Disabling Tower-Rush goal.")
(set-goal TRUSH no)
(disable-self))

;FLUSH (only flush if we're in feudal and target player is in feudal or dark)
;(defrule
;(or (current-age == feudal-age)
;(goal feudal-pending yes))
;(players-current-age target-player <= feudal-age)
;(goal ENEMY-LOCATED yes)
;(goal FAST-CASTLE no)
;(goal POCKET no)
;(goal can-flush yes)
;=>
;(set-goal FLUSH yes)
;(chat-local-to-self "I'll attempt to flush the enemy.")
;(chat-to-player every-ally "I'm going to flush the enemy.")
;(disable-self))
; NEW RULES FOR FLUSHING, found in civ-strategy.per

;========================================================================================

	;DISABLE DRUSH NORMALLY
(defrule
	(goal DRUSH yes)
(or	(current-age >= feudal-age)
	(goal feudal-pending yes))
=>
;	(chat-local-to-self "Disabling drushing strategy.")
	(set-goal DRUSH no)
)

	;FAST-CASTLE AUTOMATICALLY IF IN POCKET (NOT NOMAD)
	(defrule
	(current-age <= feudal-age)
	(current-age-time > 20)
	(current-age-time < 30)
	(goal NOMAD no)
	(goal feudal-pending yes)
	(goal position-goal pocket)
	(goal FAST-CASTLE no)
=>
	(chat-to-allies "Going for pocket Fast Castle.")
	(set-goal FAST-CASTLE yes)
	(disable-self)
)
	;FAST-CASTLE IF NOT FLUSHING OR IN A POCKET POSITION (DOUBLE CHECK)
	(defrule
	(current-age == feudal-age)
	(current-age-time > 20)
	(current-age-time < 30)
	(goal NOMAD no)
	(goal FAST-CASTLE no)
	(or	(goal FLUSH no)
		(goal position-goal pocket))
=>
	(chat-to-allies "Going for Fast Castle.")
	;(chat-to-player my-player-number "Enabling Fast Castle strategy.")
	(set-goal FAST-CASTLE yes)
	(disable-self)
)
	;DISABLE FLUSH IF FAST-CASTLE IS YES
	(defrule
	(goal FLUSH yes)
	(goal FAST-CASTLE yes)
=>
	(chat-local-to-self "Disabling Flush goal because of Fast-Castle.")
	(set-goal FLUSH no)
	(disable-self)
)
	;DISABLE FAST CASTLE IF UNDER ATTACK
	(defrule
	(goal defend-feudal yes)
	(goal FAST-CASTLE yes)
	(goal castle-pending no);don't stop if we're already on our way to the castle-age
=>
	(chat-local-to-self "Canceling fast-castle to defend town.")
	(set-goal FAST-CASTLE no); There is already a rule which enables defend-feudal
)
	;DISABLE FAST CASTLE NORMALLY
	(defrule
	(goal FAST-CASTLE yes)
	(current-age >= castle-age)
	(current-age-time > 3) ;safety
=>
	(chat-local-to-self "Fast castle complete.")
	(set-goal FAST-CASTLE no)
)
	;DISABLE BOOM NORMALLY
	(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes)) ;clicked-up
	(goal BOOM yes)
=>
	(chat-local-to-self "Boom complete.")
	(set-goal BOOM no)
)

;========================================================================================

;defend-feudal (flank)
(defrule
	(current-age == feudal-age)
	(goal position-goal flank) ;ONLY FLANKS
(or	(and	(strategic-number sn-military-level <= -2)			;must be outnumbered
			(goal is-town-under-attack yes))					;AND under attack
(or	(strategic-number sn-military-level <= -3) 					;OR moderately outnumbered
(or	(and	(up-enemy-units-in-town >= 4)						;imminent threats
			(strategic-number sn-military-level <= -2))			;AND outnumbered
(or	(up-building-type-in-town c: watch-tower-line > 0)
(or	(up-building-type-in-town c: donjon > 0)
(or	(up-building-type-in-town c: town-center-foundation > 0)	;getting douched?
(or	(up-building-type-in-town c: town-center > 0)
(or	(up-building-type-in-town c: krepost > 0)
	(up-building-type-in-town c: castle > 0)))))))))
=>
	(chat-local-to-self "Enabling Feudal defense strategy.")
	(set-goal defend-feudal yes)
	(disable-self))

;defend-feudal (pocket) ;this should never really happen but it could
(defrule
	(current-age == feudal-age)
	(goal position-goal pocket) ;ONLY POCKETS
(or	(and	(strategic-number sn-military-level <= -3) ;must be very outnumbered
			(goal is-town-under-attack yes)) ;and under attack
(or	(up-enemy-units-in-town >= 7) ;decent threats
(or	(up-building-type-in-town c: watch-tower-line > 0)
(or	(up-building-type-in-town c: donjon > 0)
(or	(up-building-type-in-town c: town-center-foundation > 0)
(or	(up-building-type-in-town c: town-center > 0)
(or	(up-building-type-in-town c: krepost > 0)
	(up-building-type-in-town c: castle > 0))))))))
=>
	;(chat-local-to-self "Enabling Feudal defense strategy.")
	(set-goal defend-feudal yes)
	(disable-self))

	;DISABLE FEUDAL-DEFENCE
(defrule
(goal defend-feudal yes)
(or	(and	(current-age == feudal-age)
			(current-age-time > 1200))
(or		(current-age >= castle-age)
		(goal castle-pending yes)))

=>
	(chat-local-to-self "Disabling feudal-defence.")
	(set-goal defend-feudal no)
	(disable-self))

;INITIALIZATION
;DARK AGE
;STRATEGIES

	;dark-build-order

	;NEW allow villager and military priority training;=====================================================================================

	; NEW villager priority rules

;turn on villager priority training
(defrule															;IF
	(up-compare-goal VILLAGER-PRIORITY != yes)						;villager priority is turned off
	(unit-type-count-total villager < high-res-vil-pop)				;AND we are under our ideal villager population
	(unit-type-count-total villager > 0)							;AND we have at least 1 villager (who can rebuild everything)
	(building-type-count-total town-center > 0)						;AND we have at least 1 built or building 1 town-center
=>																	;THEN
;	(chat-local-to-self "Villager priority ON.")					;(debug message)
	(set-goal VILLAGER-PRIORITY yes)								;Turn on villager priority
)

;turn off villager priority training
(defrule
	(up-compare-goal VILLAGER-PRIORITY != no)
(or	(unit-type-count-total villager >= high-res-vil-pop)
	(and	(unit-type-count-total villager < 1)
			(building-type-count-total town-center < 1)))
=>
;	(chat-local-to-self "Villager priority OFF.")
	(set-goal VILLAGER-PRIORITY no)
)

	;MILITARY TRAINING (PRIORITY)
	;like a master switch for training any military
	;turn on military priority training
(defrule
	(up-compare-goal MILITARY-TRAINING != yes)
(or	(unit-type-count-total villager >= min-vills) ;must have minimum villagers trained before military (average: 20)
	(current-age == dark-age)); ignore in dark-age so we can pursue DRUSH
(or	(and	(goal VILLAGER-PRIORITY yes)
	(or	(not	(up-train-site-ready c: villager))
				(up-pending-objects c: villager > 0)))
	(goal VILLAGER-PRIORITY no))
=>
;	(chat-local-to-self "Military training ON.")
	(set-goal MILITARY-TRAINING yes)
)
	;turn off military priority training
(defrule
	(current-age > dark-age); don't stop drushing
	(up-compare-goal MILITARY-TRAINING != no)
(or	(and	(goal VILLAGER-PRIORITY yes)
	(and	(up-train-site-ready c: villager)
			(up-pending-objects c: villager < 1)))
	(unit-type-count-total villager < min-vills))
=>
;	(chat-local-to-self "Military training OFF.")
	(set-goal MILITARY-TRAINING no)
);============================================================================================================================================
		;ALL VILLAGER TRAINING	

	;DARK-AGE UNITS

;VILLAGER (fc yes) (NOT malay)
(defrule
	(goal VILLAGER yes)
	(goal FAST-CASTLE yes)
	(current-age == dark-age)
(not	(civ-selected malay))
(not	(and	(unit-type-count-total villager >= 27)
		(can-research feudal-age)))
	(unit-type-count-total villager < max-vill-pop)
	(unit-type-count-total villager <= amount-villagers-dark)
	(can-train villager)
=>
	(train villager)
)

;VILLAGER (fc yes) (malay)
(defrule
	(goal VILLAGER yes)
	(goal FAST-CASTLE yes)
	(current-age == dark-age)
	(civ-selected malay)
(not	(and	(unit-type-count-total villager >= 29) ;fast up-times
				(can-research feudal-age)))
	(unit-type-count-total villager < max-vill-pop)
	(unit-type-count-total villager <= amount-villagers-dark)
	(can-train villager)
=>
	(train villager)
)

;VILLAGER (fc no) (not malay)
(defrule
	(goal VILLAGER yes)
	(current-age == dark-age)
	(goal FAST-CASTLE no)
(not	(civ-selected malay))
(not	(and	(unit-type-count-total villager >= 21) ;18
		(can-research feudal-age))) ;DONT make villagers if FC no and over 21 vils and can advance to feudal
	(unit-type-count-total villager < max-vill-pop)
	(unit-type-count-total villager <= amount-villagers-dark)
	(can-train villager)
=>
	(train villager)
)

;VILLAGER (fc no) (malay)
(defrule
	(goal VILLAGER yes)
	(current-age == dark-age)
	(goal FAST-CASTLE no)
	(civ-selected malay)
(not	(and	(unit-type-count-total villager >= 23)
		(can-research feudal-age))) ;DONT make villagers if FC no and over 21 vils and can advance to feudal
	(unit-type-count-total villager < max-vill-pop)
	(unit-type-count-total villager <= amount-villagers-dark)
	(can-train villager)
=>
	(train villager)
)

	;feudal-age VILLAGER (fc yes) (IDEAL FC TIME)
(defrule
	(goal VILLAGER yes)
	(current-age == feudal-age)
	(current-age-time < 60)
	(goal FAST-CASTLE yes)
	(not (can-research castle-age))
	(unit-type-count-total villager < max-vill-pop)
	(unit-type-count-total villager < amount-villagers-fc)
	(can-train villager)
=>
	(train villager)
)

	;feudal-age VILLAGER (fc yes) (not ideal fast castle time (possibly taunted 33 by an ally earlier))
(defrule
	(goal VILLAGER yes)
	(current-age == feudal-age)
	(current-age-time > 60)
	(goal FAST-CASTLE yes)
	(not (can-research castle-age))
	(unit-type-count-total villager < max-vill-pop) ;only max now
	;(unit-type-count-total villager < amount-villagers-fc)
	(can-train villager)
=>
	(train villager)
)

;feudal-age VILLAGER (fc no)
(defrule
	(goal VILLAGER yes)
	(current-age == feudal-age)
(or	(goal FAST-CASTLE no);indicates flushing
(or	(building-type-count-total town-center > 1);so cumans keep producing
	(goal defend-feudal yes)))
(not	(can-research castle-age))
	(unit-type-count-total villager < max-vill-pop) ;only max now
	;(unit-type-count-total villager < amount-villagers-flush)
	(can-train villager)
=>
	(train villager)
)

;castle-age VILLAGER (high-resources no)
(defrule
	(goal VILLAGER yes)
	(goal high-res-vils no)
	(current-age == castle-age)
(not	(can-research-with-escrow imperial-age))
(not	(can-research imperial-age))
	(unit-type-count-total villager < max-vill-pop) ;always max only
	(can-train villager)
=>
	(train villager)
)

;castle-age VILLAGER (high-resources yes)
(defrule
	(goal VILLAGER yes)
	(goal high-res-vils yes)
	(current-age == castle-age)
(not	(can-research-with-escrow imperial-age))
(not	(can-research imperial-age))
	(unit-type-count-total villager < high-res-vil-pop)
	(unit-type-count-total villager < max-vill-pop)
	(can-train villager)
=>
	(train villager)
)

;imperial-age VILLAGER (high-res-vils no)
(defrule
	(goal VILLAGER yes)
	(goal high-res-vils no)
	(current-age >= imperial-age)
	(unit-type-count-total villager < max-vill-pop)
	(can-train villager)
=>
	(train villager)
)

;imperial-age VILLAGER (high-res-vils yes)
(defrule
	(goal VILLAGER yes)
	(goal high-res-vils yes)
	(current-age >= imperial-age)
	(unit-type-count-total villager < high-res-vil-pop)
	(unit-type-count-total villager < max-vill-pop)
	(can-train villager)
=>
	(train villager)
)

	;BUG FIX FOR NO VILLAGER TRAINING
(defrule
	(goal VILLAGER yes)
	(food-amount >= 50)
	(escrow-amount food > 1)
	(up-pending-objects c: villager < 1)
	(housing-headroom >= 1)
	(population-headroom >= 2)
	(unit-type-count-total villager < high-res-vil-pop); potential minimal vils
	(building-type-count town-center > 0)
=>
	(chat-local-to-self "Releasing food escrow for villagers.")
	(release-escrow food))

;DELETE EXCESS VILLAGERS
(defrule
(or	(goal is-town-under-attack no)	;don't help the enemy with killing our vills too soon
	(not	(town-under-attack)))
	(goal high-res-vils yes)
	(unit-type-count villager > high-res-vil-pop)
=>
	(chat-local-to-self "Deleting excess villager.")
	(delete-unit villager)
)

;DELETE EXCESS TRADE-CARTS
(defrule
	(goal ALLY-IN-GAME no) ;all allies dead (but we could become allies with someone later...)
	(players-building-type-count any-ally market < 1) ;AND no markets left to trade with
	(unit-type-count trade-cart > 0) ;we have trade-carts wasting population space
=>
	(chat-local-to-self "Deleting excess trade-cart.")
	(delete-unit trade-cart)
)

;DELETE EXCESS TRADE-COGS
(defrule
	(goal ALLY-IN-GAME no)
	(players-building-type-count any-ally dock < 1)
	(unit-type-count trade-cog > 0)
=>
	(chat-local-to-self "Deleting excess trade-cog.")
	(delete-unit trade-cog)
)

	;MAKE EMERGENCY TRANSPORT SHIPS
(defrule
	(population >= max-pop)
	(goal EMERGENCY-ATTACK yes)
	(unit-type-count-total villager >= min-vills) ;quite low indeed heha
	(unit-type-count-total transport-ship < 3)
	(strategic-number sn-military-level >= 0); must not be dying
	(building-type-count dock > 1) ;some water?
	(warboat-count > 0)
	(wood-amount > 300)
=>
	;(chat-local-to-self "Unable to reach enemy? Making transports.")
	(delete-unit villager)
	(delete-unit spearman-line) ;delete trash
	(delete-unit skirmisher-line)
	(delete-unit scout-cavalry-line)
	(delete-unit fishing-ship)
	(train transport-ship))


;DISABLE TRADE CARTS
(defrule
	(goal TRADE-CART yes)
	(goal ALLY-IN-GAME no)
(or	(goal WATER-MAP separated)
	(not	(map-type team-islands))) ;team islands exception
	(players-building-type-count any-ally market < 1)
=>
	(chat-local-to-self "Disabling trade-carts.")
	(set-goal TRADE-CART no)
)

;DISABLE TRADE COGS
(defrule
	(goal TRADE-COG yes)
	(goal ALLY-IN-GAME no)
	(players-building-type-count any-ally dock < 1)
=>
	(chat-local-to-self "Disabling trade-cogs.")
	(set-goal TRADE-COG no)
)

;RE-ENABLE TRADE CARTS (if we ally during game)
(defrule
	(goal TRADE-CART no)
	(goal ALLY-IN-GAME yes)
(or	(not	(goal WATER-MAP separated)) ;any map type other than islands type map
	(map-type team-islands)) ;team islands exception
	(players-building-type-count any-ally market > 0)
=>
	(chat-local-to-self "Re-enabling trade-carts.")
	(set-goal TRADE-CART yes)
)

;RE-ENABLE TRADE COGS (if we ally during game)
(defrule
	(goal TRADE-COG no)
	(goal ALLY-IN-GAME yes)
	(players-building-type-count any-ally dock > 0)
=>
	(chat-local-to-self "Re-enabling trade-cogs.")
	(set-goal TRADE-COG yes)
)

;(defrule
;	(current-age >= imperial-age)
;(or	(food-amount > 3000)
;(or	(wood-amount > 3000)
;	(gold-amount > 3000)))
;	(unit-type-count villager < high-res-vil-pop )
;	(can-train villager)
;=>
;	(train villager)
;)

;SCOUT UNITS
;EMERGENCY SCOUT (spearman) (this one first)
(defrule
	(goal MILITARY-TRAINING yes)
	(goal is-town-under-attack no)
	(current-age >= feudal-age)
	(soldier-count < 1) ;no land military
	;(current-age-time < 300) ;do this forever
	(unit-type-count-total spearman-line == 0)
	(can-train spearman-line)
=>
	(chat-local-to-self "Training emergency scout.")
	(train spearman-line)
)

;SCOUT MILITIA
(defrule
(goal MILITARY-TRAINING yes) ;yes = allowed, no = stop
(current-age == dark-age)
(not (town-under-attack))
(goal is-town-under-attack no)
(goal feudal-pending no); better to wait for a quicker scout in feudal
(soldier-count < 1)
(unit-type-count-total militiaman-line < 1)
(can-train militiaman-line)
=>
(train militiaman-line)
)

;SCOUT (ANY AGE)
(defrule
(goal MILITARY-TRAINING yes)
(goal is-town-under-attack no)
(soldier-count < 1)
(unit-type-count-total scout-cavalry-line < 1)
(not	(can-train spearman-line)) ;prefer spear over scout
(can-train scout-cavalry-line)
=>
(train scout-cavalry-line)
)

;SCOUT (AZTEC OR MAYAN OR INCAN) [BECAUSE NO SCOUT HORSE FOR THEM LOL]
(defrule
(goal MILITARY-TRAINING yes)
(goal my-civ-type meso)
(not (town-under-attack))
(soldier-count < 1)
(unit-type-count-total eagle-warrior-line < 1)
(not	(can-train spearman-line)) ;prefer a spear over gold unit like eagle
(can-train eagle-warrior-line)
=>
(train eagle-warrior-line)
)

