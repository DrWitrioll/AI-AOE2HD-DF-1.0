;STABLE (offensive) - 1 (escrow)
(defrule
(or	(current-age == castle-age)
	(goal castle-pending yes))
(or	(goal KNIGHT yes)
(or	(goal BATTLE-ELEPHANT yes)
(or	(goal STEPPE-LANCER yes)
(or	(goal CAMEL main) ;temp fix
	(goal SCOUT-CAVALRY main))))) ;temp fix
