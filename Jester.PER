;Default barracks
(defrule
	(current-age >= imperial-age)
	(unit-type-count-total villager > min-vills)
	(building-type-count-total town-center > 2);1
	(building-type-count-total barracks < 1)
	(can-build barracks)
=>
	;(chat-local-to-self "Building a barracks.")
	(build barracks)
)
;BARRACKS (lots and imperial-pending)
(defrule
(goal imperial-pending yes)
(or	(goal SWORDMAN yes)
	(goal EAGLE-WARRIOR yes))
(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7))
(unit-type-count-total villager > min-vills)
(building-type-count town-center > 1)
(building-type-count-total barracks < 4)
(can-build barracks)
=>
(build barracks)
)
;BARRACKS (lots)
