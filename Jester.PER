;DOCK-BUILDINGS

;1ST DOCK (water-map NO)
(defrule
	(goal WATER-MAP no) ;indicates a land-map
	(goal is-town-under-attack no)
(or	(and	(goal DRUSH yes)
			(building-type-count barracks > 0))
			(goal DRUSH no))
	(dropsite-min-distance wood <= 5) ;very safe wood
	(wood-amount >= 500) ;for land maps we want to stay away from docks unless we have extra wood to spare
(or	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mule-cart > 0))
	(building-type-count town-center > 0)
	(building-type-count-total dock == 0)
	(can-build dock)
=>
	(build dock)
)

;1ST DOCK (water-map YES)
(defrule
	(goal is-town-under-attack no)
(or	(and	(goal DRUSH yes)
		(building-type-count-total barracks > 0))
(or	(and	(goal WATER-MAP separated)
		(goal DRUSH no))
	(and	(goal WATER-MAP connected)
		(goal DRUSH no))))
(or	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mule-cart > 0))
	(building-type-count town-center > 0)
	(building-type-count-total dock == 0)
	(can-build dock)
=>
	(build dock)
)

;ADDITIONAL DOCKS (land maps)
(defrule
	(goal WATER-MAP no) ;land-maps
	(building-type-count-total dock > 0)
	(wood-amount > 500) ;we don't like lots of docks on land maps
(or	(and (players-unit-type-count target-player warboat-count >= 6);build if either the enemy is aggressive on water or, ;NOTE THIS IS BUGGED I WILL FIX IT SOON
	(building-type-count-total dock <= 3))
(or	(and	(building-type-count-total town-center >= 2); build when we have the economy to sustain it.
			(building-type-count-total dock <= 1))
(or	(and	(building-type-count-total town-center >= 3)
			(building-type-count-total dock <= 2))
	(and	(building-type-count-total town-center >= 5)
			(building-type-count-total dock <= 3)))))
(or	(unit-type-count fishing-ship > 1) ;must have 2 fishing ships or 2 warships minimal
	(warboat-count > 1))
	(can-build dock)
=>
	(build dock)
)

;ADDITIONAL DOCKS (water maps)
(defrule
(or	(goal WATER-MAP separated)
	(goal WATER-MAP connected))
	(building-type-count-total dock > 0)
(or	(and	(players-unit-type-count target-player warboat-count >= 6);build if either the enemy is aggressive on water or,
			(building-type-count-total dock <= 3))
(or	(and	(building-type-count-total town-center >= 2); build when we have the economy to sustain it.
			(building-type-count-total dock <= 2))
(or	(and	(building-type-count-total town-center >= 3)
			(building-type-count-total dock <= 3))
	(and	(building-type-count-total town-center >= 5)
			(building-type-count-total dock <= 4)))))
(or	(unit-type-count fishing-ship > 1) ;must have 2 fishing ships or 2 warships minimal
	(warboat-count > 1))
	(can-build dock)
=>
	(build dock)
)

			;CASTLE-AGE BUILDINGS 2

;1ST BARRACKS
(defrule
(current-age == castle-age)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
(building-type-count town-center > 2)
(building-type-count-total barracks < 1)
(can-build barracks)
=>
(build barracks)
)

	;OFFENSIVE BUILDINGS

;BARRACKS (offensive) going into castle-age (for quicker offensive strategy)
(defrule
	(goal castle-pending yes)
	(goal BOOM no);indicates going aggressive strategy
	(up-pending-objects c: barracks == 0)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(building-type-count-total barracks < 1)
	(building-type-count town-center > 0)
	(can-build barracks)
=>
	(chat-local-to-self "Building aggressive barracks.")
	(build barracks)
)


;BARRACKS (offensive) - 1
(defrule
(or	(current-age == castle-age)
	(goal castle-pending yes))
(or	(goal SWORDMAN yes)
	(goal EAGLE-WARRIOR yes))
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 0)
	(building-type-count-total barracks < 2)
	(can-build barracks)
=>
	(build barracks)
)

