;MARKET LOGIC
;feudal age

;EMERGENCY CASTLE-AGE ADVANCE (extra food)
(defrule
(current-age == feudal-age)
(up-research-status c: castle-age < research-pending)
(or	(goal FAST-CASTLE yes)
	(current-age-time > 400))
(food-amount > 900)
(gold-amount < 200)
(can-sell-commodity food)
(commodity-selling-price food >= 14)
(building-type-count market > 0)
=>
(chat-to-player my-player-number "Selling food for castle-age gold.")
(sell-commodity food)
)

;EMERGENCY CASTLE-AGE ADVANCE (extra wood)
(defrule
(current-age == feudal-age)
(up-research-status c: castle-age < research-pending)
(or	(goal FAST-CASTLE yes)
	(current-age-time > 400))
(wood-amount > 400)
(gold-amount < 250)
(can-sell-commodity wood)
(commodity-selling-price wood >= 14)
(building-type-count market > 0)
=>
(chat-to-player my-player-number "Selling wood for castle-age gold.")
(sell-commodity wood)
)

;EMERGENCY CASTLE-AGE ADVANCE (not enough food)
(defrule
(current-age == feudal-age)
(up-research-status c: castle-age < research-pending)
(or	(goal FAST-CASTLE yes)
	(current-age-time > 400))
(food-amount < 800)
(gold-amount > 300)
(can-buy-commodity food)
(commodity-buying-price food <= 200)
(building-type-count market > 0)
=>
(chat-to-player my-player-number "Buying food for castle-age.")
(buy-commodity food)
)

;EMERGENCY CASTLE-AGE ADVANCE (stone)
(defrule
	(current-age == feudal-age)
	(goal castle-pending no) ;don't waste stone if we clicked up already
	(goal need-castle no) ;don't waste stone if we need a castle for our strategy
	(up-research-status c: castle-age < research-pending)
	(current-age-time > 300) ;5 minutes minimum
(or	(goal FAST-CASTLE yes)
	(players-current-age target-player >= castle-age)) ;enemy beat us
(not	(can-research castle-age))
	(stone-amount >= 200) ;don't go under 100
(or	(and	(food-amount > 800) ;high food / low gold
			(gold-amount < 200))
	(and		(food-amount < 800)
			(gold-amount > 200))) ;OR low food / high gold
	(building-type-count market > 0)
	(commodity-selling-price stone >= 80) ;decent
	(can-sell-commodity stone)
=>
	(chat-to-player my-player-number "Selling stone for faster castle-age.")
	(sell-commodity stone)
)

;buy stone - need castle
(defrule
(or	(goal castle-pending yes)
	(current-age >= castle-age))
	(goal need-castle yes)
(or	(and	(civ-selected frankish)
			(stone-amount < 480))
	(and	(not	(civ-selected frankish))
			(stone-amount < 650)))
	(commodity-buying-price stone <= 250)
	(can-buy-commodity stone)
=>
	(chat-local-to-self "Buying stone for a castle.")
	(buy-commodity stone)
)

;Advancing to Imperial Age

;need food
(defrule
	(current-age == castle-age)
	(up-research-status c: imperial-age < research-pending)
(or	(and	(goal BOOM yes)
			(current-age-time > 600))
	(current-age-time > 1200));20 minutes
	(food-amount < 1000)
	(gold-amount > 700)
	(building-type-count market > 0)
	(can-buy-commodity food)
	(commodity-buying-price food <= 250)
=>
	(chat-to-player my-player-number "Buying food for Imperial-age.")
	(buy-commodity food)
)

;need gold (high food)
(defrule
	(current-age == castle-age)
	(up-research-status c: imperial-age < research-pending)
(or	(and	(goal BOOM yes)
		(current-age-time > 600))
	(current-age-time > 1200));20 minutes
	(food-amount > 1300)
	(gold-amount < 800)
	(building-type-count market > 0)
	(can-sell-commodity food)
	(commodity-selling-price food >= 14)
=>
	(chat-to-player my-player-number "Selling food for Imperial-age gold.")
	(sell-commodity food)
)

;need gold (high wood)
(defrule
	(current-age == castle-age)
	(up-research-status c: imperial-age < research-pending)
(or	(and	(goal BOOM yes)
		(current-age-time > 600))
	(current-age-time > 1200));20 minutes
	(wood-amount > 800)
	(gold-amount < 800)
	(building-type-count market > 0)
	(can-sell-commodity wood)
	(commodity-selling-price wood >= 14)
=>
	(chat-to-player my-player-number "Selling wood for Imperial-age gold.")
	(sell-commodity wood)
)

;need gold (high stone)
(defrule
	(current-age == castle-age)
	(up-research-status c: imperial-age < research-pending)
(or	(and	(goal BOOM yes)
		(current-age-time > 600))
	(current-age-time > 1200));20 minutes
	(stone-amount > 900)
	(gold-amount < 800)
	(building-type-count market > 0)
	(can-sell-commodity wood)
	(commodity-selling-price stone >= 50)
=>
	(chat-to-player my-player-number "Selling stone for Imperial-age gold.")
	(sell-commodity stone)
)

