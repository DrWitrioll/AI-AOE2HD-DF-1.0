;EMERGENCY WOOD FOR TOWN-CENTER
(defrule
(current-age >= castle-age)
(unit-type-count villager >= 1) ;must have a villager to build it
(building-type-count-total town-center == 0)
(wood-amount < 275)
;(commodity-buying-price wood <= 300) ;any price
(can-buy-commodity wood)
=>
(chat-local-to-self "Buying wood for a town center.")
(buy-commodity wood)
)
;EMERGENCY STONE FOR TOWN-CENTER
(defrule
(current-age >= castle-age)
(unit-type-count villager >= 1) ;must have a villager to build it
(building-type-count-total town-center < 1)
(stone-amount < 100)
;(commodity-buying-price stone <= 300) ;any price
(can-buy-commodity stone)
=>
(chat-local-to-self "Buying stone for a town center.")
(buy-commodity stone)
)

;SELLING RESOURCES FOR TOWN-CENTER
;EXCESS FOOD
(defrule
	(unit-type-count villager >= 1)
	(building-type-count-total town-center < 1)
	(building-type-count market > 0)
(not	(can-build town-center))
(or	(wood-amount < 275) ;need wood or stone
	(stone-amount < 100))
	;(commodity-selling-price food >= 14) ;price doesn't matter
	(can-sell-commodity food)
=>
	;(chat-local-to-self "Selling food for town center resources.")
	(sell-commodity food)
)
;EXCESS WOOD
(defrule
	(unit-type-count villager >= 1)
	(building-type-count-total town-center < 1)
	(building-type-count market > 0)
(not	(can-build town-center))
	(wood-amount > 400)
	(stone-amount < 100) ;need stone
	(commodity-selling-price wood >= 50) ;lowest amount
	(can-sell-commodity wood)
=>
	;(chat-local-to-self "Selling excess wood for town center resources.")
	(sell-commodity wood)
)
;EXCESS STONE
(defrule
	(unit-type-count villager >= 1)
	(building-type-count-total town-center < 1)
	(building-type-count market > 0)
(not	(can-build town-center))
	(wood-amount < 275)
	(stone-amount > 300) ;excess stone
	(commodity-selling-price stone >= 50) ;lowest amount
	(can-sell-commodity stone)
=>
	;(chat-local-to-self "Selling excess wood for town center resources.")
	(sell-commodity stone)
)

	;USE MARKET TO GET RI-WHEEL-BARROW & RI-HAND-CART FASTER
;BUY FOOD FOR RI-WHEEL-BARROW
(defrule
	(current-age >= castle-age) ;don't mess up feudal strategies
	(current-age-time > 10) ;safety
	(up-research-status c: ri-wheel-barrow < research-pending) ;not clicked research yet
(not	(can-research ri-wheel-barrow)) ;doesn't account for escrowed resources
(not (research-completed ri-wheel-barrow))
(or	(unit-type-count villager > 40)
	(unit-type-count-total villager >= high-res-vil-pop))
	(food-amount < 175) ;typical values
	(wood-amount >= 50)
	(gold-amount >= 200)
	(commodity-buying-price food < 190)
	(can-buy-commodity food)
=>
	(chat-local-to-self "Buying food for ri-wheel-barrow.")
	(buy-commodity food)
)
;only 50 wood for ri-wheel-barrow , not worth making a rule for it...

;BUY FOOD FOR RI-HAND-CART
(defrule
	(current-age >= castle-age) ;don't mess up feudal strategies
	(current-age-time > 15) ;safety
(or	(unit-type-count villager > 55)
	(unit-type-count-total villager >= max-vill-pop))
	(research-completed ri-wheel-barrow)
(not (research-completed ri-hand-cart))
	(up-research-status c: ri-hand-cart < research-pending) ;not clicked research yet
(not	(can-research ri-hand-cart)) ;doesn't account for escrowed resources
	(food-amount < 300)
	(wood-amount >= 200)
	(gold-amount >= 200)
	(commodity-buying-price food < 190)
	(can-buy-commodity food)
=>
	(chat-local-to-self "Buying food for ri-hand-cart.")
	(buy-commodity food)
)

;REQUESTING RESOURCES
;NO TOWN CENTER REQUEST
(defrule
	(goal GIVE-UP no) ; so AI doesnt ask for resources when hes resigning anyway.
	(timer-triggered eco-timer) ;NEW
	(building-type-count-total town-center == 0)
	(stone-amount < 100)
	(unit-type-count-total villager >= 1)
	(players-building-type-count any-ally market >= 1)
	(players-building-type-count any-ally town-center >= 0)
=>
	(chat-to-player every-ally "6 Gimme bricks for a TC!")
)
(defrule
	(goal GIVE-UP no)
	(timer-triggered eco-timer) ;NEW
	(building-type-count-total town-center == 0)
	(wood-amount < 275)
	(unit-type-count-total villager >= 1)
	(players-building-type-count any-ally market >= 1)
	(players-building-type-count any-ally town-center >= 0)
=>
	(chat-to-player every-ally "4 Gimme logs for a TC!")
)

;DIPLOMACY
;STANCES
(defrule
	(players-stance any-enemy neutral)
=>
	(chat-to-player this-any-enemy "41 YES, PROCEED TO CONFUSE MY SMALL BRAIN EVEN MORE!")
	(set-stance this-any-enemy neutral))
	
(defrule
	(players-stance any-enemy ally)
=>
	(chat-to-player this-any-enemy "39 OH WOW! I'm so glad I changed your feeble mind!")
	(set-stance this-any-enemy ally))

(defrule
	(players-stance any-neutral ally)
=>
	(chat-to-player this-any-neutral "39 I knew you would come to your silly little senses!") ;NEW VERSION 2.3
	(set-stance this-any-neutral ally))

(defrule
	(players-stance any-neutral enemy)
=>
	(chat-to-player this-any-neutral "40 So... You have chosen death.")
	(set-stance this-any-neutral enemy))

(defrule
	(players-stance any-ally neutral)
=>
	(chat-to-player this-any-ally "41 SCUMBAG ALERT WEE WOO WEE WOO SCUMBAG ALERT!")
	(set-stance this-any-ally neutral))

(defrule
	(players-stance any-ally enemy)
=>
	(chat-to-player this-any-ally "40 You would dare betray me? Prepare to die BETA.")
	(set-stance this-any-ally enemy))

	;ASKING FOR AND LENDING ECONOMIC ASSISTANCE (VIA MARKET)
;asking for resources

;	(up-allied-resource-amount any-ally wood > 500) (USE THIS)

	;ally is in next age, ask for help
	;food
(defrule
	(timer-triggered eco-timer); timer is a 2 minute timer
	(current-age <= feudal-age)
	(player-in-game any-ally)
	(players-current-age any-ally >= castle-age)
	(players-current-age-time any-ally > 60)
	(players-building-type-count any-ally market > 0)
	(up-allied-resource-amount any-ally food > 500)
	(food-amount < 800)
=>
	(chat-to-allies "3 Spare me some scrumptious crumbs.")
)

(defrule
	(timer-triggered eco-timer)
	(current-age <= feudal-age)
	(player-in-game any-ally)
	(players-current-age any-ally >= castle-age)
	(players-current-age-time any-ally > 60)
	(players-building-type-count any-ally market > 0)
	(up-allied-resource-amount any-ally wood > 500)
	(wood-amount < 300)
=>
	(chat-to-allies "4 Broother, give me your splinty logs.")
)

(defrule
	(timer-triggered eco-timer)
	(current-age <= feudal-age)
	(player-in-game any-ally)
	(players-current-age any-ally >= castle-age)
	(players-current-age-time any-ally > 60)
	(players-building-type-count any-ally market > 0)
	(up-allied-resource-amount any-ally gold > 500)
	(gold-amount < 200)
=>
	(chat-to-allies "5 Spare me some shiney boys.")
)

(defrule
	(timer-triggered eco-timer)
	;(goal need-castle yes)
	(building-type-count-total castle < 1)
	(player-in-game any-ally)
	(players-current-age any-ally >= castle-age)
	(players-current-age-time any-ally > 60)
	(players-building-type-count any-ally market > 0)
	(up-allied-resource-amount any-ally stone > 500)
	(stone-amount < 100)
=>
	(chat-to-allies "6 Hand over those pokey lads.")
)

	;Automatic slinging (high food) ;thanks goes to Esty Tutomaster for some of these rules
(defrule
	(current-age-time > 30)
	(goal is-town-under-attack no)
	(current-age >= imperial-age) ;do not do unless in the final age
	(player-in-game any-ally) ;"player-in-game" is more reliable than "player-valid" apparently
	(building-type-count market > 0)
	(food-amount > 1600)
	(up-allied-resource-amount any-ally food < 800)
=>	
	(up-get-player-fact this-any-ally player-number 0 gl-ally-in-need)
	(up-modify-sn sn-focus-player-number g:= gl-ally-in-need))
(defrule
	(players-stance focus-player ally)
	(current-age >= imperial-age)
	(food-amount > 1600)
	(up-allied-resource-amount focus-player food < 800)
	(player-in-game focus-player)
=>	
	(tribute-to-player focus-player food 200) ;100
	(clear-tribute-memory focus-player food))

