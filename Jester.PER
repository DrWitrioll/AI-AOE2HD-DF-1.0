(or	(current-age == castle-age)
	(goal castle-pending yes))
(or	(goal SWORDMAN yes)
	(goal EAGLE-WARRIOR yes))
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 0)
	(building-type-count-total barracks < 2)
	(can-build-with-escrow barracks)
=>
	(release-escrow wood)
	(build barracks)
)

