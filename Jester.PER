(building-type-count-total barracks > 0)
(building-type-count-total stable < 1)
(can-build stable)
=>
(build stable)
)
;2ND STABLE 
(defrule
(goal castle-pending yes) ;age up
(or	(goal KNIGHT yes)
(or	(goal BATTLE-ELEPHANT yes)
(or	(goal STEPPE-LANCER yes)
(or	(goal CAMEL main) ;temp fix
	(goal SCOUT-CAVALRY main)))))
(or	(wood-amount >= 250) ;better condition than lumber-camp
	(dropsite-min-distance wood <= 7))
(building-type-count-total town-center > 0)
(building-type-count-total blacksmith > 0)
(building-type-count-total stable < 2)
(can-build stable)
