;=>
;(set-strategic-number sn-cap-civilian-builders 50)
;(disable-self)
;)

;1ST HOUSE (NOMAD)
(defrule
(goal NOMAD yes)
(not (civ-selected hun))
(building-type-count town-center > 0)
(building-type-count-total house < 1)
(can-build house)
(up-pending-objects c: house == 0)
(housing-headroom <= 3) ;current population to supportable population.
(population-headroom >= 1) ;current population and population limit.
=>
(up-assign-builders c: house c: 1)
(build house)
)

;1ST HOUSE (original DONT DELETE)
;(defrule
;(goal NOMAD no)
;(not (civ-selected hun))
;(building-type-count-total town-center > 0)
;(building-type-count-total house < 1)
;(can-build house)
;(up-pending-objects c: house == 0)
;(housing-headroom <= 3) ;current population to supportable population.
;(population-headroom > 3) ;current population and population limit.
;=>
;(up-assign-builders c: house c: 2)
;(build house)
;)

;2ND HOUSE (original DONT DELETE)
;(defrule
;(goal NOMAD no)
;(not (civ-selected hun))
;(building-type-count-total town-center > 0)
;(building-type-count-total house == 1)
;(can-build house)
;(up-pending-objects c: house == 1)
;(housing-headroom <= 3) ;current population to supportable population.
;(population-headroom > 3) ;current population and population limit.
;=>
;(up-assign-builders c: house c: 1)
;(build house)
;)

;1ST HOUSE 
(defrule
(goal NOMAD no)
(not (civ-selected hun))
(housing-headroom <= 3) ;current population to supportable population.
(population-headroom >= 1) ;current population and population limit.
(building-type-count town-center > 0)
(up-pending-objects c: house == 0)
(building-type-count-total house == 0)
(can-build house)
=>
(up-full-reset-search)
(up-set-placement-data my-player-number villager c: 1) ;home town center = -1
(up-assign-builders c: house c: 2)
(up-build place-control 0 c: house)
)

;2ND HOUSE
(defrule
(goal NOMAD no)
(not	(civ-selected hun)) ;don't need houses
(not	(civ-selected incan));10 house pop per house
(not	(civ-selected chinese));town center extra pop
(building-type-count town-center > 0)
(housing-headroom <= 3) ;current population to supportable population.
(population-headroom >= 1) ;current population and population limit.
(up-pending-objects c: house == 1)
(building-type-count-total house == 1)
(can-build house)
=>
(up-full-reset-search)
;(up-find-local c: villager c: 1)
(up-set-placement-data my-player-number villager c: 1);look at this insane house micro :D
(up-assign-builders c: house c: 1)
(up-build place-control 0 c: house)
(disable-self)
)

;HOUSE (DARK-AGE)
(defrule
(current-age == dark-age)
(not (civ-selected hun))
(building-type-count town-center > 0)
(building-type-count house > 0) ; see 1st house rule above.
(can-build house)
(up-pending-objects c: house == 0)
(housing-headroom <= 3) ;current population to supportable population.
(population-headroom >= 1) ;current population and population limit.
=>
(up-assign-builders c: house c: 1)
(build house)
)

;HOUSE (FEUDAL-AGE)
(defrule
(current-age == feudal-age)
(not (civ-selected hun))
(building-type-count town-center > 0)
(building-type-count house > 0) ; see 1st house rule above.
(up-pending-objects c: house == 0)
(housing-headroom <= 5) ;current population to supportable population.
(population-headroom >= 1) ;current population and population limit.
(can-build house)
=>
(up-assign-builders c: house c: 1)
(build house)
)

;HOUSE (CASTLE-AGE AND IMPERIAL-AGE)
(defrule
(or	(current-age >= castle-age)
	(goal castle-pending yes));no more delaying town-size increasing!
(not (civ-selected hun))
(building-type-count town-center > 0)
(building-type-count house > 0) ; see 1st house rule above.
(up-pending-objects c: house <= 1); 2 houses at once
(housing-headroom <= 10) ;current population to supportable population.
(population-headroom >= 1) ;current population and population limit.
(can-build house)
=>
(up-assign-builders c: house c: 1)
(build house)
)

;DARK-AGE BARRACKS (default aggressive feudal barracks)
(defrule
(goal FAST-CASTLE no)
(up-research-status c: feudal-age == research-pending);same as (goal feudal-pending yes)
(or	(wood-amount >= 250) ;safety
	(dropsite-min-distance wood <= 7))
(building-type-count town-center > 0)
(building-type-count-total mill > 0)
(building-type-count-total barracks < 1)
(can-build barracks)
=>
(build barracks)
)

;DARK-AGE BARRACKS (conditional aggressive fast-castle barracks)
(defrule
(goal FAST-CASTLE yes)
(goal feudal-pending yes)
(or	(goal KNIGHT yes)
(or	(goal STEPPE-LANCER yes)
(or	(goal BATTLE-ELEPHANT yes)
(or	(goal SCOUT-CAVALRY main)
	(goal CAMEL main)))))
(or	(wood-amount >= 250) ;safety
	(dropsite-min-distance wood <= 7))
(building-type-count town-center > 0)
(building-type-count-total mill > 0)
(building-type-count-total barracks < 1)
(can-build barracks)
=>
(build barracks)
)

;EMERGENCY DARK-AGE BARRACKS
;See Jester/town-under-attack for one conditional under-attack rule.

;DRUSH BARRACKS
(defrule
(goal DRUSH yes)
(current-age == dark-age)
(building-type-count town-center > 0)
(or	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mule-cart > 0))
(building-type-count-total barracks < 1)
(can-build barracks)
=>
(build barracks)
)

;DARK AGE RESEARCH
;ALL RESEARCHES IN RESEARCH PER

		;DISABLE (goal TRUSH yes) IF (goal DEFEND-FEUDAL yes)
(defrule
(goal TRUSH yes)
(goal defend-feudal yes)
=>
(chat-local-to-self "Disabling trushing to defend town.")
(set-goal TRUSH no)
(disable-self))

;disable flushing to defend town
(defrule
	(goal FLUSH yes)
(or	(goal defend-feudal yes) ;flush and defend-feudal have conflicting gathering strategies when both turned on
	(strategic-number sn-military-level <= -2))
=>
	(chat-local-to-self "Outnumbered. Disabling Flush goal.")
	(set-goal FLUSH no)
	(disable-self))

;Disable flush goal in castle or greater age
(defrule
	(goal FLUSH yes)
(or	(and	(current-age >= castle-age)
		(current-age-time > 3))
	(and	(players-current-age target-player >= castle-age)
		(strategic-number sn-military-level < 0))); cancel flushing if outnumbered
=>
	(chat-to-player my-player-number "Disabling Flush goal.")
	(set-goal FLUSH no)
	(disable-self)
)

;FEUDAL-UNITS
;all villager training rules moved to villager training section in this file in the dark age section.
;units are in civ-strategy.per

;EMERGENCY GOLD IN FEUDAL TRADE-CART
(defrule
(current-age == feudal-age)
(or (goal WATER-MAP no)
(goal WATER-MAP connected))
(goal is-town-under-attack no)
(not (town-under-attack))
;	(unit-type-count 579 < 1)  ;male gold miner
;	(unit-type-count 581 < 1) ; female gold miner
(unit-type-count villager-gold < 1) ;considers both
(players-building-type-count any-ally market > 0)
(current-age-time > 600)
(gold-amount < 200)
(wood-amount > 400)
(unit-type-count-total trade-cart < 3)
(can-train trade-cart)
=>
(train trade-cart))

;FEUDAL-BUILDINGS
;==========meme-strategy 1 buildings==========

(defrule
	(goal MEME-STRATEGY 1)
(or	(goal feudal-pending yes)
	(current-age == feudal-age))
	(building-type-count town-center > 0)
	(building-type-count-total barracks < 1)
	(can-build barracks)
=>
	;(chat-local-to-self "Meme barracks.")
	(build barracks)
)

(defrule
	(goal MEME-STRATEGY 1)
	(current-age == feudal-age)
	(building-type-count-total stable < 1)
	(can-build stable)
=>
	;(chat-local-to-self "Meme stable.")
	(build stable)
)

;meme-strategy 1 buildings
(defrule
	(goal MEME-STRATEGY 1)
	(current-age == feudal-age)
	(building-type-count-total blacksmith < 1)
	(can-build blacksmith)
=>
	;(chat-local-to-self "Meme blacksmith.")
	(build blacksmith)
)
;====================

;===============================DEFENSIVE BUILDINGS (flanks only)

(defrule
	(goal position-goal pocket) ;POCKETS WILL HAVE THEIR OWN RULES EVENTUALLY
=>
	(up-jump-rule 10) ;fixed, was 11 before
)
;1ST BARRACKS (defensive)
(defrule
	(current-age >= feudal-age)
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
		(players-unit-type-count target-player my-unique-unit-line > 1))
(or	(players-unit-type-count target-player knight-line > 0)
(or	(players-unit-type-count target-player scout-cavalry-line > 2)
(or	(players-unit-type-count target-player camel-line > 1)
(or	(players-unit-type-count target-player battle-elephant-line > 0)
(or	(players-unit-type-count target-player steppe-lancer-line > 1)
(or	(players-unit-type-count target-player konnik-set > 1)
	(players-building-type-count target-player stable > 1))))))))
(or	(wood-amount >= 250) ;safety
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 0)
	(building-type-count-total barracks < 1)
	(can-build barracks)
=>
	(chat-local-to-self "Building defensive barracks (1).")
	(build barracks)
)
;2ND BARRACKS (defensive)
(defrule
	(current-age >= feudal-age) ;max 2 barracks for feudal
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
		(players-unit-type-count target-player my-unique-unit-line > 5))
(or	(players-unit-type-count target-player scout-cavalry-line > 7)
(or	(players-unit-type-count target-player knight-line > 5)
(or	(players-unit-type-count target-player camel-line > 5)
(or	(players-unit-type-count target-player battle-elephant-line > 5)
(or	(players-unit-type-count target-player steppe-lancer-line > 5)
(or	(players-unit-type-count target-player konnik-set > 5)
	(players-building-type-count target-player stable > 2))))))))
(or	(wood-amount >= 250) ;safety
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 0)
	(building-type-count-total barracks < 2)
	(can-build barracks)
=>
	(chat-local-to-self "Building defensive barracks (2).")
	(build barracks)
)
;3RD BARRACKS (defensive)
(defrule
	(current-age >= castle-age) ;3 for castle
	(goal counter-units yes)
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
		(players-unit-type-count target-player my-unique-unit-line > 14))
(or	(players-unit-type-count target-player knight-line > 13)
(or	(players-unit-type-count target-player scout-cavalry-line > 15)
(or	(players-unit-type-count target-player camel-line > 14)
(or	(players-unit-type-count target-player battle-elephant-line > 10)
(or	(players-unit-type-count target-player steppe-lancer-line > 14)
(or	(players-unit-type-count target-player konnik-set > 12)
	(players-building-type-count target-player stable > 3))))))))
(or	(wood-amount >= 250) ;safety
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 1)
	(building-type-count-total barracks < 3)
	(can-build barracks)
=>
	(chat-local-to-self "Building defensive barracks (3).")
	(build barracks)
)
	;ARCHERY RANGES

;DEFENSIVE ARCHERY RANGE (level 1) (any age)
(defrule
(or	(and	(goal UNIQUE-ENEMY-HAND-CANNONEER yes)
		(players-unit-type-count target-player my-unique-unit-line > 1))
(or	(and	(goal UNIQUE-ENEMY-ARCHER yes)
		(players-unit-type-count target-player my-unique-unit-line > 1))
(or	(and	(goal UNIQUE-ENEMY-CAV-ARCHER yes)
		(players-unit-type-count target-player my-unique-unit-line > 1))
(or	(players-unit-type-count target-player cavalry-archer-line > 1)
(or	(players-unit-type-count target-player archer-line > 1)
(or	(players-unit-type-count target-player slinger > 1)
(or	(players-unit-type-count target-player genitour-line > 1)
(or	(players-unit-type-count target-player hand-cannoneer > 1)
(or	(players-building-type-count target-player archery-range > 1)
	(players-unit-type-count target-player skirmisher-line > 1))))))))))
	(building-type-count town-center > 0)
	(building-type-count-total archery-range < 1)
	(can-build archery-range)
=>
	(chat-to-player my-player-number "Building defensive archery range (1).")
	(build archery-range))

;DEFENSIVE ARCHERY RANGE (level 2) (any age)
(defrule
(or	(and	(goal UNIQUE-ENEMY-HAND-CANNONEER yes)
		(players-unit-type-count target-player my-unique-unit-line > 5))
(or	(and	(goal UNIQUE-ENEMY-ARCHER yes)
		(players-unit-type-count target-player my-unique-unit-line > 6))
(or	(and	(goal UNIQUE-ENEMY-CAV-ARCHER yes)
		(players-unit-type-count target-player my-unique-unit-line > 6))
(or	(players-unit-type-count target-player cavalry-archer-line > 7)
(or	(players-unit-type-count target-player archer-line > 7)
(or	(players-unit-type-count target-player slinger > 7)
(or	(players-unit-type-count target-player genitour-line > 8)
(or	(players-unit-type-count target-player hand-cannoneer > 1)
(or	(players-building-type-count target-player archery-range > 2)
	(players-unit-type-count target-player skirmisher-line > 8))))))))))
	(building-type-count town-center > 0)
	(building-type-count-total archery-range < 2)
	(can-build archery-range)
=>
	(chat-to-player my-player-number "Building defensive archery range (2).")
	(build archery-range))

;DEFENSIVE ARCHERY RANGE (level 3) (any age)
(defrule
(or	(and	(goal UNIQUE-ENEMY-HAND-CANNONEER yes)
		(players-unit-type-count target-player my-unique-unit-line > 15))
(or	(and	(goal UNIQUE-ENEMY-ARCHER yes)
		(players-unit-type-count target-player my-unique-unit-line > 15))
(or	(and	(goal UNIQUE-ENEMY-CAV-ARCHER yes)
		(players-unit-type-count target-player my-unique-unit-line > 15))
(or	(players-unit-type-count target-player cavalry-archer-line > 17)
(or	(players-unit-type-count target-player archer-line > 13)
(or	(players-unit-type-count target-player slinger > 13)
(or	(players-unit-type-count target-player genitour-line > 13)
(or	(players-unit-type-count target-player hand-cannoneer > 13)
(or	(players-building-type-count target-player archery-range > 4)
	(players-unit-type-count target-player skirmisher-line > 15))))))))))
	(building-type-count town-center > 1) ;fixed
	(building-type-count-total archery-range < 3)
	(can-build archery-range)
=>
	(chat-to-player my-player-number "Building defensive archery range (3).")
	(build archery-range)
)
	;STABLES
	;defend-feudal
;STABLE 1
(defrule
	;(goal defend-feudal yes) ;any age now
(or		(and	(goal UNIQUE-ENEMY-ARCHER yes)
		(players-unit-type-count target-player my-unique-unit-line > 2))
(or		(players-unit-type-count target-player archer-line > 3)
		(players-unit-type-count target-player skirmisher-line > 3)))
	(players-unit-type-count target-player spearman-line < 7)
	(building-type-count-total town-center > 0)
	(building-type-count-total mill > 0)
(or	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mule-cart > 0)) ;for armenian & georgian civs
	(building-type-count-total stable < 1)
	(unit-type-count-total scout-cavalry-line <= 3)
	(can-build stable)
=>
	(chat-local-to-self "Building defensive stable (1).")
	(build stable))

;STABLE 1 (extra x 2)
(defrule
	;(goal defend-feudal yes) ;any age now
(or	(players-unit-type-count target-player battering-ram-line > 0)
(or	(players-unit-type-count target-player mangonel-line > 0)
(or	(players-unit-type-count target-player scorpion-line > 0)
(or	(players-unit-type-count target-player armored-elephant-line > 0)
	(players-unit-type-count target-player eagle-warrior-line > 2)))))
	(players-unit-type-count target-player spearman-line < 7)
	(building-type-count-total town-center > 0)
	(building-type-count-total mill > 0)
(or	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mule-cart > 0))
	(building-type-count-total stable < 1)
	(can-build stable)
=>
	(chat-local-to-self "Building defensive stable (1).")
	(build stable)
)
	;defend-castle
;STABLE 1 (repel archer units)
(defrule
	;(goal defend-castle yes) ;any age now
(or	(and	(goal UNIQUE-ENEMY-ARCHER yes)
			(players-unit-type-count target-player my-unique-unit-line > 7))
(or	(players-unit-type-count target-player archer-line > 7)
	(players-unit-type-count target-player skirmisher-line > 7)))
	(players-unit-type-count target-player spearman-line < 8) ;not too many enemy spears
	(building-type-count-total town-center > 0)
	(building-type-count-total stable < 1)
	(soldier-count <= 12) ;not enough defenders
	(can-build stable)
=>
	(chat-local-to-self "Building defensive stable (1).")
	(build stable))

;DEFENSIVE MONASTERY
(defrule
	(unit-type-count villager >= min-vills)
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
		(players-unit-type-count target-player my-unique-unit-line > 1))
(or	(players-unit-type-count target-player knight-line > 1)
(or	(players-unit-type-count target-player shrivamsha-rider-line > 1)
(or	(players-unit-type-count target-player scout-cavalry-line > 4)
(or	(players-unit-type-count target-player camel-line > 2)
(or	(players-unit-type-count target-player battle-elephant-line > 0)
(or	(players-unit-type-count target-player steppe-lancer-line > 2)
	(players-unit-type-count target-player konnik-set > 2))))))))
	(building-type-count-total town-center > 0)
	(building-type-count-total monastery < 1)
	(building-type-count-total market > 0)
	(can-build monastery)
=>
	(build monastery)
);end jump

;==========END OF DEFENSIVE BUILDINGS==========
;BARRACKS (covered in town-under-attack rule in town-under-attack.per)
(defrule
(goal FAST-CASTLE no)
(or	(current-age == feudal-age)
	(goal feudal-pending yes))
(building-type-count town-center > 0)
(or	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mule-cart > 0))
(building-type-count-total mill > 0)
(building-type-count-total barracks < 1)
(can-build barracks)
=>
(build barracks)
)

