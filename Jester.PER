;NORMAL SIEGE WORKSHOP (IMPERIAL-AGE) (first building)
(defrule
(current-age >= imperial-age)
(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7))
(unit-type-count-total villager > min-vills)
(building-type-count-total town-center > 1)
(building-type-count-total siege-workshop < 1) ;one for starters
(can-build siege-workshop)
=>
(build siege-workshop)
)

;NORMAL SIEGE WORKSHOP (IMPERIAL-AGE) (multiple)
(defrule
(current-age >= imperial-age)
(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7))
(unit-type-count-total villager > min-vills)
(building-type-count-total town-center >= 3);1
(or	(building-type-count-total barracks >= 5)
(or	(building-type-count-total archery-range >= 5)
	(building-type-count-total stable >= 5)))
(building-type-count-total monastery > 0)
(building-type-count-total university > 0)
(building-type-count-total market > 0)
(building-type-count-total siege-workshop < 3)
(up-pending-objects c: siege-workshop < 1) ;1 at a time so other buildings can build first
(can-build siege-workshop)
=>
(build siege-workshop)
)

;SIEGE-WORKSHOP (excess wood)
(defrule
(current-age >= imperial-age)
(building-type-count town-center >= 3)
(or	(building-type-count-total barracks >= 5)
(or	(building-type-count-total archery-range >= 5)
	(building-type-count-total stable >= 5)))
(building-type-count-total monastery > 0)
(building-type-count-total university > 0)
(building-type-count-total market > 0)
(wood-amount >= 1000)
(unit-type-count-total villager > min-vills)
(building-type-count-total siege-workshop < 4)
(up-pending-objects c: siege-workshop < 1)
(can-build siege-workshop)
=>
(build siege-workshop)
)

;WONDER
(defrule
(goal BUILD-THE-WONDER yes)
(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7))
(unit-type-count-total villager > min-vills)
(building-type-count town-center >= 3)
(building-type-count-total wonder < 1)
(can-build wonder)
=>
;(up-modify-sn sn-cap-civilian-builders c:= 30)
(up-assign-builders c: wonder c: 20)
(build wonder))

;WONDER (with escrow)
(defrule
(goal BUILD-THE-WONDER yes)
(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7))
(unit-type-count-total villager > min-vills)
(building-type-count town-center > 2)
(building-type-count-total wonder < 1)
(can-build-with-escrow wonder)
=>
(release-escrow food)
(release-escrow wood)
(release-escrow gold)
(release-escrow stone)
;(up-modify-sn sn-cap-civilian-builders c:= 30)
(up-assign-builders c: wonder c: 20)
(build wonder))

;TOWN CENTER
;See castle age town center rules.

;FEITORIA ;always build at least 1 as portuguese
(defrule
	(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7))
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total feitoria < 1)
	(can-build feitoria)
=>
	(up-assign-builders c: feitoria c: 4)
	(build feitoria))

;FEITORIA (escrow)
(defrule
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total feitoria < 1)
	(can-build-with-escrow feitoria)
=>
	(release-escrow gold)
	(release-escrow stone)
	(up-assign-builders c: feitoria c: 4)
	(build feitoria))

;FEITORIA 2 ;no resources?!
(defrule
(population-cap >= 150) ;no point if we have no pop space afterwards
(or	(goal WOOD-REMAINING no)
(or	(goal GOLD-REMAINING no)
	(goal STONE-REMAINING no)))
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total feitoria < 2)
	(can-build feitoria)
=>
	(up-assign-builders c: feitoria c: 4)
	(build feitoria))

;FEITORIA 2 ;no resources?! escrow
(defrule
(population-cap >= 150) ;no point if we have no pop space afterwards
(or	(goal WOOD-REMAINING no)
(or	(goal GOLD-REMAINING no)
	(goal STONE-REMAINING no)))
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total feitoria < 2)
	(can-build-with-escrow feitoria)
=>
	(release-escrow gold)
	(release-escrow stone)
	(up-assign-builders c: feitoria c: 4)
	(build feitoria))

#load-if-defined VICTORY-STANDARD
(defrule
	(goal is-town-under-attack no)
	(unit-type-count-total villager > high-res-vil-pop)
	(building-type-count town-center > 0)
	(players-building-type-count every-ally wonder < 1)
	(players-building-type-count every-ally wonder < 1) ;don't waste resources if enemy already has a wonder
	(building-type-count-total wonder < 1)
	(can-build wonder)
=>
;	(up-modify-sn sn-cap-civilian-builders c:= 30)
	(up-assign-builders c: wonder c: 20)
	(build wonder))
#end-if

#load-if-defined WONDER-RACE
(defrule
	(goal is-town-under-attack no)
	(unit-type-count-total villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total wonder < 1)
	(can-build wonder)
=>
;	(up-modify-sn sn-cap-civilian-builders c:= 30)
	(up-assign-builders c: wonder c: 20)
	(build wonder))
#end-if

