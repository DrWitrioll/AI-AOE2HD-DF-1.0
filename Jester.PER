(or	(building-type-count-total castle > 0)
	(goal BOOM yes))))
	(building-type-count-total town-center < 1) ;1st town-center (usually nomad)
	(can-build-with-escrow town-center)
=>
	(set-strategic-number sn-town-center-placement lumber-camp) ;only for 1st town center for now
	(release-escrow wood)
	(release-escrow stone)
	(up-assign-builders c: town-center-foundation c: 8) ; town-center-foundation = 621
	(build town-center)
)

