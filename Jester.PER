;taunt 50 (yes) (castle)
(defrule
	(taunt-detected any-ally 50)
	(cc-players-unit-type-count any-ally flare >= 1)
	(can-build castle)
=>
	(acknowledge-taunt this-any-ally 50)
	(chat-to-player this-any-ally "I'll attempt to build a castle there!")
	(up-reset-search 1 1 1 1) ;reset all unit search stuff
	(up-reset-filters) ;reset the search filters
	(up-find-flare building-point-x)
	(up-set-target-point building-point-x)
	(up-assign-builders c: castle c: 7)
	(up-build place-point 0 c: castle)
)

