;NORMAL MONASTERY
(defrule
	(unit-type-count villager >= min-vills)
(or	(and	(building-type-count-total town-center >= 2)
			(wood-amount > 500)) ;safe wood
		(building-type-count-total town-center >= 3))
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(building-type-count-total monastery < 1)
	(building-type-count-total market > 0)
	(can-build monastery)
=>
	(build monastery)
)

;2ND MONASTERY (lumber-camp)
(defrule
(or	(goal MONK yes)
	(goal EMERGENCY-ATTACK yes))
	(building-type-count-total town-center > 2)
	(building-type-count-total monastery == 1)
	(building-type-count-total university > 0)
	(building-type-count-total blacksmith > 0)
	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mill > 0)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(can-build monastery)
=>
	(up-set-placement-data my-player-number lumber-camp c: -2) ;3
	(build monastery)
)

;2ND MONASTERY (mule-cart)
(defrule
(or	(goal MONK yes)
	(goal EMERGENCY-ATTACK yes))
	(building-type-count-total town-center > 2)
	(building-type-count-total monastery == 1)
	(building-type-count-total university > 0)
	(building-type-count-total blacksmith > 0)
	(building-type-count-total mule-cart > 0) ;armenians & georgians
	(building-type-count-total mill > 0)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(can-build monastery)
=>
	(up-set-placement-data my-player-number mule-cart c: -2) ;3
	(build monastery)
)

;===========BOOMING BUILDINGS

;MONASTERY
(defrule
	(goal BOOM yes)
(or	(building-type-count-total town-center >= 3)
(and	(food-amount > 900);getting close to enough res for imp
		(gold-amount > 700)))
	(building-type-count town-center > 0)
	(building-type-count-total castle < 1)
	(building-type-count-total monastery < 1)
	(can-build monastery)
=>
	(build monastery)
)

;UNIVERSITY
(defrule
	(goal BOOM yes)
(or	(building-type-count-total town-center >= 3)
(and	(food-amount > 900)
		(gold-amount > 700)))
	(building-type-count town-center > 0)
	(building-type-count-total castle < 1)
	(building-type-count-total monastery > 0)
	(building-type-count-total university < 1)
	(can-build university)
=>
	(build university)
)

;======================

;FORWARD CASTLE
	(defrule
	(goal WONDER-MODE no)
	(goal BUILD-THE-WONDER no)
	(goal ATTACK yes)
	(strategic-number sn-military-level >= 3)
	(goal is-town-under-attack no)
(or	(unit-type-count-total 213 <= 2); Dead female builder
	(unit-type-count-total 225 <= 2)); Dead male builder
	(building-type-count town-center > 1)
	(up-pending-objects c: castle <= 1);
	(building-type-count castle > 0) ;no limit ;build after 1st castle rule
	(up-can-build 0 c: castle)
=>
	(up-assign-builders c: castle c: 8)
	(up-build place-forward 0 c: castle)
)

;1ST CASTLE (should always be placed at front of base) (NO WONDER)
(defrule
	(current-age >= castle-age)
	(building-type-count wonder < 1)
	(game-time > 50) ;DELAY
(or	(unit-type-count-total 213 < 1); Dead female builder
	(unit-type-count-total 225 < 1)); Dead male builder
	(building-type-count-total town-center > 0)
	(up-pending-objects c: castle <= 1);
	(building-type-count-total castle < 1)
	(up-can-build 0 c: castle)
=>
	(up-full-reset-search)
	(set-strategic-number sn-placement-zone-size 9)
	(set-strategic-number sn-placement-to-center 0) ;closest enemy
	;(up-modify-sn sn-safe-border-distance c: -2) ;should be town-size +2 instead of +4 ;this was not helping
	(up-set-placement-data my-player-number -1 s: sn-safe-border-distance) ;town-size + 4 normally
	(up-assign-builders c: castle c: 9)
	(up-build place-control 0 c: castle)
)

;CASTLE (place near wonder) (WITH WONDER)
(defrule
	(current-age >= castle-age)
	(building-type-count wonder > 0)
	(game-time > 50) ;DELAY
(or	(unit-type-count-total 213 < 1); Dead female builder
	(unit-type-count-total 225 < 1)); Dead male builder
	(building-type-count-total town-center > 0)
	(up-pending-objects c: castle <= 1);
	;(building-type-count-total castle < 1) ;build at least 1 castle with the wonder
	(up-can-build 0 c: castle)
=>
	(up-full-reset-search)
	(set-strategic-number sn-placement-zone-size 9)
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data my-player-number wonder c: 4)
	(up-assign-builders c: castle c: 5)
	(up-build place-control 0 c: castle)
	(disable-self)
)
;CASTLE (any placement)
(defrule
	(current-age >= castle-age)
	(game-time > 60) ;DELAY
(or	(unit-type-count-total 213 < 1); Dead female builder
	(unit-type-count-total 225 < 1)); Dead male builder
	(building-type-count-total town-center > 0)
	(building-type-count-total castle > 0) ;no limit
	(up-pending-objects c: castle <= 1); build 2 at a time only
	(can-build castle)
=>
	(up-assign-builders c: castle c: 8)
	(build castle)
)

(defrule
(or	(building-available krepost)
	(can-build krepost))
	(building-type-count-total krepost > 2) ;make sure we get a castle eventually
	(building-type-count-total castle < 1)
=>
	(up-jump-rule 2)) ;start jump

;KREPOST (FORWARD)
(defrule
(or	(strategic-number sn-military-level > 0)
(or	(goal ATTACK yes)
	(goal is-town-under-attack no)))
(or	(unit-type-count-total 213 < 1); Dead female builder
	(unit-type-count-total 225 < 1)); Dead male builder
(or	(unit-type-count villager > 50)
	(unit-type-count-total villager >= max-vill-pop)) ;low pop games
	(building-type-count town-center > 0)
	(building-type-count-total krepost < 4)
	(can-build krepost)
=>
	(up-assign-builders c: krepost c: 6)
	(build-forward krepost))

;KREPOST (DEFENSIVE)
(defrule
	(strategic-number sn-military-level <= 0)
;(or	(goal ATTACK no)
;	(goal is-town-under-attack yes)))
	(building-type-count town-center > 0)
	(building-type-count-total krepost < 4)
	(can-build krepost)
=>
	(up-assign-builders c: krepost c: 6)
	(build krepost))
;end-jump

;UNIVERSITY
(defrule
	(goal is-town-under-attack no)
	(soldier-count > 10) ;min some soldiers
(or	(goal ARCHER yes)
(or	(and	(goal MY-UNIQUE-UNIT yes)
		(or	(goal unique-archer-class yes)
			(goal unique-cav-archer-class yes)))
(or	(warboat-count > 5)
(or	(building-type-count-total krepost > 0)
(or	(building-type-count-total castle > 0)
(or	(wood-amount > 900)
	(building-type-count-total monastery > 0)))))))
	(building-type-count-total barracks > 0)
	(building-type-count-total town-center > 2)
	(building-type-count-total university < 1)
	(can-build university)
=>
	(build university)
)
;SPECIAL UNIVERSITY (bohemian hand-cannoneers)
(defrule
	(goal HAND-CANNONEER yes)
	(goal bohemian-civ yes)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7)) ;safe wood
	(building-type-count-total archery-range >= 1) ;at least one
	(building-type-count town-center > 0)
	(building-type-count-total university < 1)
	(can-build university)
=>
	(build university)
)
;MARKET
(defrule
	(goal is-town-under-attack no)
	(current-age >= castle-age)
	(building-type-count-total market < 1)
	(building-type-count-total town-center > 1)
	(can-build market)
=>
	(set-strategic-number sn-placement-zone-size 10)
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data my-player-number -1 c: -20) ;home town center = -1
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: market)
)
;2ND MARKET (sn-placement-to-center == 1) ;map-center focal point
(defrule
	(goal is-town-under-attack no)
	(current-age >= castle-age)
(or	(building-type-count-total archery-range > 0)
(or	(building-type-count-total stable > 0)
	(wood-amount > 1000)))
	(players-building-type-count any-ally market > 0); must have an ally for 2 markets.
	(building-type-count-total market == 1) ;2nd
	(building-type-count town-center > 2)
	(building-type-count blacksmith > 0)
	(building-type-count monastery > 0)
	(building-type-count university > 0)
	(up-can-build 0 c: market)
=>
	(set-strategic-number sn-placement-zone-size 10)
	(set-strategic-number sn-placement-to-center 1)
	(up-set-placement-data any-ally market c: -30); 50 ;home town center = -1
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: market)
)
;3RD MARKET (sn-placement-to-center == 1) ;map-center focal point	;see micro.per file for DUC markets!
(defrule
	(goal is-town-under-attack no)
	(current-age >= castle-age)
(or	(building-type-count-total archery-range >= 2)
(or	(building-type-count-total stable >= 2)
	(wood-amount > 1000)))
	(players-building-type-count any-ally market > 0); must have an ally for 2 markets.
	(building-type-count-total market == 2) ;3rd
	(building-type-count town-center >= 3)
	(building-type-count blacksmith > 0)
	(building-type-count monastery > 0)
	(building-type-count university > 0)
	(up-can-build 0 c: market)
=>
	(set-strategic-number sn-placement-zone-size 15)
	(set-strategic-number sn-placement-to-center 1) ;other rule will change it back to the other way ; focal point: 0 = enemy's closest building, 1 = map-center
	(up-set-placement-data my-player-number -1 c: -60); 50 ;home town center = -1
	(set-strategic-number sn-placement-fail-delta 0)
	(up-build place-control 0 c: market)
)

;SIEGE WORKSHOP (cumans feudal-age siege-workshop)
(defrule
	(current-age == feudal-age)
	(goal FAST-CASTLE no)
(or	(goal FLUSH yes)
(or	(enemy-buildings-in-town)
	(wood-amount > 500)))
	(building-type-count-total barracks > 0)
	(building-type-count-total siege-workshop < 1)
	(building-type-count-total town-center > 0)
	(strategic-number sn-military-level >= 2) ;delay until needed
	(can-build siege-workshop)
=>
	(build siege-workshop)
)
;SIEGE WORKSHOP
(defrule
	(current-age == castle-age)
	(building-type-count-total barracks > 0)
	(building-type-count-total town-center > 2)
	(building-type-count-total siege-workshop < 1)
	(building-type-count-total town-center > 2)
	(can-build siege-workshop)
=>
	(build siege-workshop)
)

;SIEGE-RUSH SIEGE WORKSHOP
(defrule
	(goal SIEGE-RUSH yes)
(or	(building-type-count-total town-center > 1) ;min 2
	(and	(building-type-count town-center > 0) ;or 1 and not enough resources for TC
	(not	(can-build town-center))))
	(building-type-count-total siege-workshop < 1)
	(can-build siege-workshop)
=>
	(build siege-workshop))

;SIEGE-RUSH SIEGE WORKSHOP
(defrule
	(goal SIEGE-RUSH yes)
	(unit-type-count villager > min-vills)
	(building-type-count-total town-center > 2) ;min 3 for 2nd
	(building-type-count-total siege-workshop < 2)
	(can-build siege-workshop)
=>
	(build siege-workshop))

;EMERGENCY SIEGE WORKSHOP 1
(defrule
	(current-age == castle-age)
	(goal need-siege-workshop yes)
	(building-type-count-total siege-workshop < 1)
	(building-type-count-total town-center > 0)
	(can-build siege-workshop)
=>
	(build siege-workshop)
)

;EMERGENCY SIEGE WORKSHOP 2
(defrule
	(current-age == castle-age)
	(goal need-siege-workshop yes)
	(building-type-count-total siege-workshop < 1)
	(building-type-count-total town-center > 0)
	(can-build-with-escrow siege-workshop)
=>
	(release-escrow wood)
	(build siege-workshop)
)

	;SAFETY BACKUP TOWN-CENTER (when town-under-attack is yes) , and there is an ally nearby
(defrule
	(up-pending-objects c: town-center == 0)
	(building-type-count-total town-center >= 1)
	(building-type-count-total town-center < 5)
	(goal is-town-under-attack yes)
	(strategic-number sn-military-level <= -3) ;may likely need to run
	(players-military-population any-ally >= 10)
	(can-build town-center)
=>
	(set-strategic-number sn-placement-to-center 1);test
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 3)
;	(up-assign-builders c: town-center-foundation c: 4)
	(set-strategic-number sn-town-center-placement 0)
	(set-strategic-number sn-placement-zone-size 20); 25
	(up-set-placement-data this-any-ally -1 c: -20) ;-25
	(up-build place-control 0 c: town-center))

; Simple TOWN CENTER's (no escrow) (2 to 3)
(defrule
	(game-time > 20)
(not	(goal MEME-STRATEGY 1));prevents unnecesary building for elephants
(or	(goal need-siege-workshop no)
(or	(and	(goal need-castle yes)
		(or	(stone-amount < 450) ;550
			(stone-amount > 750)))
(or	(building-type-count-total castle > 0)
	(goal BOOM yes))))
	(building-type-count-total town-center > 0)
	(building-type-count-total town-center < 3)
	(can-build town-center)
=>
	(set-strategic-number sn-town-center-placement 0) ;anywhere in town-size
	(up-assign-builders c: town-center-foundation c: 4) ; town-center-foundation = 621
	(build town-center)
)

; Simple TOWN CENTER's (escrow) (2 to 3)
(defrule
	(game-time > 20)
(not	(goal MEME-STRATEGY 1));prevents unnecesary building for elephants
(or	(goal need-siege-workshop no)
(or	(and	(goal need-castle yes)
		(or	(stone-amount < 450) ;550
			(stone-amount > 750))) ;don't use stone when we need a castle
(or	(building-type-count-total castle > 0)
	(goal BOOM yes))))
	(building-type-count-total town-center > 0)
	(building-type-count-total town-center < 3)
	(can-build-with-escrow town-center)
=>
	(set-strategic-number sn-town-center-placement 0) ;anywhere in town-size
	(release-escrow wood)
	(release-escrow stone)
	(up-assign-builders c: town-center-foundation c: 4) ; town-center-foundation = 621
	(build town-center)
)

;TOWN CENTER 1  (no escrow) (accounts for Cumans extra town-center in the feudal-age) (NOMAD YES)
(defrule
	(game-time > 15) ;minimal wait time for rules to be defined
(or	(goal need-siege-workshop no) ;set to no when we have no town-center
(or	(building-type-count town-center < 1) ;we have no town-center
(or	(and	(goal need-castle yes)
		(or	(stone-amount < 450) ;550
			(stone-amount > 750)))
(or	(building-type-count-total castle > 0)
	(goal BOOM yes)))))
	(building-type-count-total town-center < 1) ;1st town-center (usually nomad)
	(can-build town-center)
=>
	(set-strategic-number sn-town-center-placement lumber-camp) ;only for 1st town center for now
	(up-assign-builders c: town-center-foundation c: 8) ; town-center-foundation = 621 ;8 builders max for first TC
	;(up-assign-builders c: town-center c: 3) error, does not work with town-centers
	(build town-center)
)

;TOWN CENTER 1  (escrow)
(defrule
	(game-time > 15) ;minimal wait time for rules to be defined
(not	(goal MEME-STRATEGY 1));prevents unnecesary building for elephants
(or	(goal need-siege-workshop no)
