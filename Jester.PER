;==================================================================

	;WALLS AND GATES

	;removed for added competitiveness

;=========================END OF WALL RULES===========================

	;SCOUTING

	;scouting-timer
(defrule
	(game-time s:> sn-home-exploration-time)
=>
	(enable-timer scout-timer 420);every 7 minutes ;used to be 8 minutes
	(disable-self))

;==========;LAND SCOUTING;==========;

;default scouting strategic-numbers
(defrule
	(true)
=>
	(set-strategic-number sn-percent-civilian-gatherers 100)
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-builders 50) ;100 is default but then no one gathers sometimes
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-total-number-explorers 1)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-minimum-explore-group-size 1)
	(set-strategic-number sn-maximum-explore-group-size 1)
	(disable-self)
)
;food found => set to normal scouting
(defrule
   (goal NOMAD no)
	(building-type-count town-center > 0)
(or	(not	(sheep-and-forage-too-far))
(or			(resource-found food)
      		(building-type-count-total mill > 0)))
   (strategic-number sn-percent-civilian-explorers != 0)
   =>
   (set-strategic-number sn-percent-civilian-explorers 0)
   (set-strategic-number sn-minimum-civilian-explorers 0)
   (set-strategic-number sn-cap-civilian-explorers 0)
   (set-strategic-number sn-total-number-explorers 1)
   (set-strategic-number sn-number-explore-groups 1)
)

;INITIAL NOMAD VILLAGER SCOUTING (text)
(defrule
	(goal NOMAD yes)
=>
	(chat-local-to-self "Searching for a good spot to settle.")
	(disable-self)
)

;INITIAL NOMAD VILLAGER SCOUTING
(defrule
	(goal NOMAD yes)
	(building-type-count-total town-center < 1)
	(game-time > 3) ;allow nomad rules to load
=>
	(set-strategic-number sn-percent-civilian-explorers 85)
	(set-strategic-number sn-percent-civilian-builders 15)
	(set-strategic-number sn-percent-civilian-gatherers 0)
	(set-strategic-number sn-cap-civilian-explorers 100)
	(set-strategic-number sn-food-gatherer-percentage  0)
	(set-strategic-number sn-gold-gatherer-percentage  0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage  0)
	(disable-self)
)

;FORCE NOMAD SCOUTING
;(defrule
;	(goal NOMAD yes)
;	(building-type-count-total town-center < 1)
;=>
;	(up-send-scout group-type-land-explore scout-opposite)
;	(disable-self)
;)

;RESET NOMAD VILLAGER SCOUTING
(defrule
	(goal NOMAD yes)
(or	(building-type-count-total town-center > 0)
(or	(building-type-count-total lumber-camp > 0)
	(building-type-count-total mule-cart > 0)))
	(resource-found wood)
	(game-time > 15) ;min scouting time
=>
	(chat-local-to-self "Pitching a tent.")
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-gatherers 100)
	(set-strategic-number sn-cap-civilian-explorers 0)
;	(set-strategic-number sn-minimum-explore-group-size 1)
;	(set-strategic-number sn-maximum-explore-group-size 1)
	(disable-self)
)

;NOMAD: use a villager to scout for awhile (text)
(defrule
	(goal NOMAD yes)
(or	(building-type-count-total town-center > 0) ;MUST HAVE 1 OF THESE BUILDINGS, OR:
(or	(building-type-count-total lumber-camp > 0)
(or	(building-type-count-total mule-cart > 0)
	(game-time > 480))))						;we cant find resources, AND
(or	(and	(building-type-count-total town-center > 0) ;we built the town-center and making villagers, OR:
	(and	(unit-type-count villager > 10)
			(unit-type-count villager < 20)))
	(and	(building-type-count-total town-center < 1) ;it may be a lumber or mule-cart start
			(game-time > 480))) ;start scouting for more resources after 8 minutes
	(soldier-count < 1); AND no scout available (maybe a horse scout animal though...)
=>
	(chat-local-to-self "Enabling villager scouting for more resources.")
	(set-strategic-number sn-percent-civilian-gatherers 50)
	(set-strategic-number sn-percent-civilian-builders 40)
	(set-strategic-number sn-percent-civilian-explorers 10)
	(set-strategic-number sn-minimum-civilian-explorers 1)
	(set-strategic-number sn-cap-civilian-explorers 1)
	(set-strategic-number sn-total-number-explorers 2)
	;(set-strategic-number sn-number-explore-groups 2) ;military
	;(set-strategic-number sn-minimum-explore-group-size 1); military
	;(set-strategic-number sn-maximum-explore-group-size 2); military
	(disable-self)
)

;NOMAD: stop villager scouting
(defrule
	(goal NOMAD yes)
	(building-type-count town-center > 0)
(or	(unit-type-count villager > 20)
	(soldier-count > 0));attained a scout
=>
	(chat-local-to-self "Canceling villager scouting.")
	(set-strategic-number sn-percent-civilian-gatherers 100); reset all values to these
	(set-strategic-number sn-percent-civilian-builders 100)
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-total-number-explorers 1)
	(set-strategic-number sn-number-explore-groups 1)
;	(set-strategic-number sn-minimum-explore-group-size 1)
	(set-strategic-number sn-maximum-explore-group-size 1)
	(disable-self)
);do disable

;find food before building mill (max 100 seconds)
(defrule
	(goal NOMAD no)
	(game-time > 3)
	(game-time < 100)
(or	(sheep-and-forage-too-far)
	(dropsite-min-distance food > 9)) ;takes into account farms (like empire wars mode)
	(not(resource-found food)) ;Haven't found the berries yet.
	(building-type-count-total mill == 0)
	(building-type-count town-center > 0)
=>
;	(chat-local-to-self "Searching for food.")
	(set-strategic-number sn-percent-civilian-explorers 100)
	(set-strategic-number sn-minimum-civilian-explorers 100)
	(set-strategic-number sn-cap-civilian-explorers 100)
	(set-strategic-number sn-total-number-explorers 101)
	(set-strategic-number sn-number-explore-groups 101)
	(set-strategic-number sn-minimum-explore-group-size 1)
	(set-strategic-number sn-maximum-explore-group-size 1)
);don't disable

;stop looking for sheep after 101 seconds
(defrule
(goal NOMAD no)
(or	(not	(sheep-and-forage-too-far))
(or		(dropsite-min-distance food <= 9)
		(game-time > 101)))
		;(building-type-count town-center > 0) ;don't bug out
=>
	(set-strategic-number sn-percent-civilian-explorers 0)
	(set-strategic-number sn-minimum-civilian-explorers 0)
	(set-strategic-number sn-cap-civilian-explorers 0)
	(set-strategic-number sn-total-number-explorers 1)
	(set-strategic-number sn-number-explore-groups 1)
	(set-strategic-number sn-minimum-explore-group-size 1)
	(set-strategic-number sn-maximum-explore-group-size 1)
	(disable-self); do disable
)

#load-if-defined UP-SCENARIO-GAME
;land (1st) (ANY SCENARIO GAMES)
(defrule
	(player-in-game any-enemy)
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(goal NOMAD no)
	(game-time s:> sn-home-exploration-time)
=>
	(chat-to-player my-player-number "Scouting the closest enemy.")
	(up-send-scout group-type-land-explore scouting-type) ;scout-opposite default for scenarios
	(disable-self))
#else
;land (1st) (ANY NON-SCENARIO GAMES)
(defrule
	(player-in-game any-enemy)
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(goal NOMAD no)
	(game-time s:> sn-home-exploration-time)
=>
	(chat-to-player my-player-number "Scouting the closest enemy.")
	(up-send-scout group-type-land-explore scout-flank) ;flank is default for all non-scenario games
	(disable-self))
#end-if

;land (2nd time) (drush no)
(defrule
	(goal position-goal flank) ;only flank players
	(goal DRUSH no) ;not drushing
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(goal NOMAD no)
	(player-in-game any-enemy)
	(game-time > 600) ;at 10 minutes
=>
	;(chat-to-player my-player-number "Scouting the flank.")
	(up-send-scout group-type-land-explore scout-flank)
	(disable-self))

	;land (2nd time) (drush yes)
(defrule
	(goal position-goal flank) ;only flank players
	(goal DRUSH yes) ;drushing yes
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(goal NOMAD no)
	(player-in-game any-enemy)
	(game-time > 420) ;at 7 minutes
=>
	;(chat-to-player my-player-number "Scouting the flank.")
	(up-send-scout group-type-land-explore scout-flank)
	(disable-self))

	;scout the border ;NEW
(defrule
	(goal position-goal flank) ;flanks
(or	(goal feudal-pending yes)
(or	(goal castle-pending yes)
(or	(goal imperial-pending yes) ;when we age up once
	(game-time > 1800)))) ;safety
	(goal ENEMY-LOCATED yes) ;our enemy is found already
	(game-time s:> sn-home-exploration-time) ;we've sent our scout to find the enemy already
=>
	;(chat-to-player my-player-number "Scouting the border.")
	(up-send-scout group-type-land-explore scout-border) ;flanks scout the border closest to them
	(disable-self)
)

	;scout the corner ;NEW
(defrule
	(goal position-goal pocket) ;pockets
(or	(goal feudal-pending yes)
(or	(goal castle-pending yes)
(or	(goal imperial-pending yes) ;when we age up once
	(game-time > 1800)))) ;safety
	(goal ENEMY-LOCATED yes) ;our enemy is found already
	(game-time s:> sn-home-exploration-time) ;we've sent our scout to find the enemy already
=>
	;(chat-to-player my-player-number "Scouting the border.")
	(up-send-scout group-type-land-explore scout-corner) ;pockets scout the corner
	(disable-self)
)

	;land (recurring) (enemy found)
(defrule
	(player-in-game any-enemy)
	(goal ENEMY-LOCATED yes) ;we can only use scout-enemy if we have found at least 1 enemy
	(timer-triggered scout-timer)
=>
	(chat-to-player my-player-number "Scouting my enemy.")
	(up-send-scout group-type-land-explore scout-enemy))

	;land (recurring) (enemy not found)
(defrule
	(player-in-game any-enemy)
	(goal ENEMY-LOCATED no) ;we can only use scout-enemy if we have found at least 1 enemy
	(timer-triggered scout-timer)
=>
	(chat-to-player my-player-number "Continuing search for an enemy.")
	(up-send-scout group-type-land-explore scouting-type))

;==========WATER SCOUTING
	;water (1st)
(defrule
	(player-in-game any-enemy)
(or	(unit-type-count fishing-ship > 0)
	(warboat-count > 0))
	(game-time s:> sn-home-exploration-time)
=>
	(chat-to-player my-player-number "Scouting the closest enemy.")
	(up-send-scout group-type-water-explore scouting-type)
	(disable-self))

	;water (re-occuring)
(defrule
	(player-in-game any-enemy)
(or	(unit-type-count fishing-ship > 0)
	(warboat-count > 0))
	(timer-triggered scout-timer)
=>
	(chat-to-player my-player-number "Scouting my enemy.")
	(up-send-scout group-type-water-explore scout-enemy))

;==========ADDITIONAL SCOUTING RULES

	;reduce scouting time if drushing
(defrule
	(goal DRUSH yes)
	(game-time s:< sn-home-exploration-time)
=>
	;(chat-to-player my-player-number "Decreasing home exploration time to scout enemy quicker.")
	(up-modify-sn sn-home-exploration-time c:- 120); 5 minutes
	(disable-self)
)

	;increase scouting time if pocket
(defrule
	(goal position-goal pocket)
	(goal DRUSH no)
	(game-time s:< sn-home-exploration-time)
=>
	;(chat-to-player my-player-number "Increasing home exploration time to scout base longer.")
	(up-modify-sn sn-home-exploration-time c:+ 60); about 8 minutes total
	(disable-self)
)

	;increase scouting time if nomad
(defrule
	(goal NOMAD yes)
	(game-time s:< sn-home-exploration-time)
=>
	;(chat-to-player my-player-number "Nomad home exploration time.")
	(up-modify-sn sn-home-exploration-time c:= 720); 12 minutes total
	(disable-self)
)

	;build additional camps

	;gold mining-camps (not worried about stone for now) ;favour mining-camps first
(defrule
	(timer-triggered scout-timer) ;build camps every so often
	(goal GOLD-REMAINING yes)
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(current-age-time >= 120) ;safety
	(building-type-count-total mining-camp > 0) ;first one built
	(building-type-count-total mining-camp < 7) ;max for this rule
	(dropsite-min-distance gold <= 25) ;not too far away
	(up-pending-objects c: mining-camp < 1) ;defer dropsite SN now in use
	(can-build mining-camp)
=>
	(set-strategic-number sn-allow-adjacent-dropsites 1) ;0
	(set-strategic-number sn-dropsite-separation-distance 5) ;8 ;lowered to encourage getting the closer resources
	(build mining-camp))

	;lumber-camps
(defrule
	(timer-triggered scout-timer) ;build camps every so often
	(goal WOOD-REMAINING yes)
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(current-age-time >= 120) ;safety
(or	(building-type-count-total mining-camp >= 2) ;wait until there are at least 2 mining-camps
	(game-time > 1200)) ;don't wait forever ;safety
	(building-type-count-total lumber-camp >= 2) ;two already built
	(building-type-count-total lumber-camp <= 9) ;max for this rule
	(dropsite-min-distance wood <= 25) ;not too far away from any camp
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
	(set-strategic-number sn-allow-adjacent-dropsites 1) ;0
	(set-strategic-number sn-dropsite-separation-distance 5) ;8 ;lowered to encourage getting the closer resources
	(build lumber-camp))

	;NEW mule-carts
(defrule
	(timer-triggered scout-timer) ;build camps every so often
(or	(goal WOOD-REMAINING yes)
	(goal GOLD-REMAINING yes))
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(current-age-time >= 120) ;safety
	(building-type-count-total mule-cart >= 2) ;two already built
	(building-type-count-total mule-cart <= 12) ;max for this rule
(or	(dropsite-min-distance wood <= 25) ;not too far away
	(dropsite-min-distance gold <= 25))
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(set-strategic-number sn-allow-adjacent-dropsites 1) ;0
	(set-strategic-number sn-dropsite-separation-distance 9) ;8 ;raised to prevent bunching
	(build mule-cart)) ;sn-mule-cart-placement already defined

	;loop scout-timer
(defrule
	(timer-triggered scout-timer)
=>
	(up-delete-distant-farms c: 12);delete distant farms that equal (dropsite-min-distance food (farm) > 12)
	(up-reset-placement c: farm) ;farm placement check ;rare cases of vils stuck in walls trying to build farms
	;(up-reset-unit c: villager) ;vil check ;HAS BEEN CAUSING IDLE VILLS!
	(up-retask-gatherers food c: 1) ;this works better than up-reset-unit (for villagers) ;keep these numbers low
	(up-retask-gatherers wood c: 1) ;reset this number of villager-gatherers to retask to a closer resource dropsite
	(up-retask-gatherers gold c: 1)
	(up-retask-gatherers stone c: 1)
	(up-drop-resources food c: 1) ;attempt to reset stuck villagers
	(up-drop-resources wood c: 1)
	(up-drop-resources gold c: 1)
	(up-drop-resources stone c: 1)
	(chat-to-player my-player-number "Economy and scouting reset!")
	(disable-timer scout-timer)
	(enable-timer scout-timer 420)) ;every 7 minutes ;used to be 8 mins

	;first 3 dropsites have 1 time manual retask for better efficiency

	;1st mill retask (only once)
(defrule
	(building-type-count mill == 1)
=>
	(up-retask-gatherers food c: 3)
	(disable-self)
)
	;1st lumber-camp retask
(defrule
	(building-type-count lumber-camp == 1)
=>
	(up-retask-gatherers wood c: 10)
	(disable-self)
)
	;2nd lumber-camp retask
(defrule
	(building-type-count lumber-camp == 2)
=>
	(up-retask-gatherers wood c: 5)
	(disable-self)
)
	;3rd lumber-camp retask
(defrule
	(building-type-count lumber-camp == 3)
=>
	(up-retask-gatherers wood c: 5)
	(disable-self)
)
	;1st mining-camp retask
(defrule
	(building-type-count mining-camp == 1)
=>
	(up-retask-gatherers gold c: 10)
	(up-retask-gatherers stone c: 5)
	(disable-self)
)
	;2nd mining-camp retask
(defrule
	(building-type-count mining-camp == 2)
=>
	(up-retask-gatherers gold c: 5)
	(up-retask-gatherers stone c: 3)
	(disable-self)
)
	;3rd mining-camp retask
(defrule
	(building-type-count mining-camp == 3)
=>
	(up-retask-gatherers gold c: 5)
	(up-retask-gatherers stone c: 3)
	(disable-self)
)
	;1st mule-cart retask
(defrule
	(building-type-count mule-cart == 1)
=>
	(up-retask-gatherers wood c: 10) ;prefer closer resources
	(up-retask-gatherers gold c: 10)
	(up-retask-gatherers stone c: 5)
	(disable-self)
)
	;2nd mule-cart retask
(defrule
	(building-type-count mule-cart == 2)
=>
	(up-retask-gatherers wood c: 3)	;prefer closer resources
	(up-retask-gatherers gold c: 3)
	(up-retask-gatherers stone c: 3)
	(disable-self)
)
	;3rd mule-cart retask
(defrule
	(building-type-count mule-cart == 3)
=>
	(up-retask-gatherers wood c: 3)	;prefer closer resources
	(up-retask-gatherers gold c: 3)
	(up-retask-gatherers stone c: 3)
	(disable-self)
)


;NEW essential ai systems to enable
(defrule
	(true)
=>
	(set-strategic-number sn-enable-new-building-system 1) ;allows building of multiple buildings at once
	(set-strategic-number sn-enable-research-queue 1)	;allows queued research techs along with units) default 0, 1 = enabled
	(set-strategic-number sn-enable-training-queue 1) ;allows 2 units in a queue in any building at once (most efficient/economical)
	(disable-self))

	;disable training queue (for faster feudal-age up)
(defrule
	(current-age == dark-age)
	(goal feudal-pending no)
	(current-age-time > 15)
	(goal FLUSH yes) ;fast-castle will ignore this rule
	(unit-type-count-total villager >= min-vills)
	(food-amount >= 400) ;close to aging up to feudal-age
	(strategic-number sn-enable-training-queue != 0)
=>
	(set-strategic-number sn-enable-training-queue 0)
)
	;disable training queue (for faster castle-age up)
(defrule
	(current-age == feudal-age)
	(goal castle-pending no)
	(current-age-time > 15)
	(unit-type-count-total villager >= min-vills)
	(food-amount >= 720) ;close to aging up to castle-age
	(gold-amount >= 180)
	(strategic-number sn-enable-training-queue != 0)
=>
	(set-strategic-number sn-enable-training-queue 0)
)
	;disable training queue (for faster imperial-age up)
(defrule
	(current-age == castle-age)
	(goal castle-pending no)
	(current-age-time > 15)
	(unit-type-count-total villager >= min-vills)
	(food-amount >= 950) ;close to aging up to imperial-age (assume we have buildings)
	(gold-amount >= 780)
	(strategic-number sn-enable-training-queue != 0)
=>
	(set-strategic-number sn-enable-training-queue 0)
)
	;up-jump for feudal-age
(defrule
	(current-age == feudal-age)
	(current-age-time < 180)
	(goal FLUSH yes)
	(unit-type-count-total villager >= min-vills)
=>
	(up-jump-rule 1)
)
	;re-enable sn-enable-training-queue (faster age up)
(defrule
(or		(and	(current-age == dark-age)	;dark-age condition 1
				(goal feudal-pending yes))	;we clicked up
(or		(and	(current-age == dark-age)	;dark-age condition 2
				(food-amount < 400))		;not near enough food to click up
(or		(and	(current-age == feudal-age) ;feudal-age condition 1
		(and	(goal castle-pending no)	;we have not clicked up
		(or		(food-amount <= 700)		;not close in either food or gold to click up
				(gold-amount <= 150))))
(or		(unit-type-count-total villager <= min-vills) ;any less than this then might as well be villager efficient ;avg 20
(or		(current-age > feudal-age)			;feudal-age condition 2 (and general castle-age and above condition)
		(goal castle-pending yes))))))		;feudal-age condition 3
	(strategic-number sn-enable-training-queue != 1)
=>
	(set-strategic-number sn-enable-training-queue 1)
) ;end jump

	;SPECIAL disable sn-enable-training-queue ;DRUSH
(defrule
	(goal DRUSH yes)
	(building-type-count barracks > 0)				;prevents from queuing 2 vils instead of militia
	(or		(unit-type-count villager < min-vills)	;we are under minimum vills
			(unit-type-count militia < 3))			;under default number of militia for flush
	(strategic-number sn-enable-training-queue != 0)
=>
	(set-strategic-number sn-enable-training-queue 0)
	(disable-self) ;only once
)
	;SPECIAL re-enable sn-enable-training-queue ;DRUSH
(defrule
	(goal DRUSH yes)
	(or		(unit-type-count villager >= min-vills)	;min vills achieved, OR:
	(or		(unit-type-count militia >= 3)			;min militia achieved, OR:
	(or		(goal DRUSH no)							;we have stopped drushing, OR:
			(goal is-town-under-attack yes))))		;we ended up getting attacked, prioritize villager production instead
	(strategic-number sn-enable-training-queue != 1)
=>
	(set-strategic-number sn-enable-training-queue 1)
	(disable-self) ;only once
)
	;SPECIAL disable sn-enable-training-queue ;FLUSH
(defrule
	(goal FLUSH yes)								;indicates aggressive feudal-age strategy
	(current-age == feudal-age)
	(current-age-time < 180)						;first 3 minutes of feudal-age to prioritize military more
	(unit-type-count-total villager >= min-vills)	;don't activate this rule if we are low on villagers already
(or	(up-pending-objects c: militiaman-line > 0)
(or	(up-pending-objects c: eagle-warrior-line > 0)
(or	(up-pending-objects c: archer-line > 0)
(or	(up-pending-objects c: skirmisher-line > 0)
(or	(up-pending-objects c: scout-cavalry-line > 0)
	(up-pending-objects c: camel-line > 0)))))) 	;gurjara camel scouts
	(strategic-number sn-enable-training-queue != 0)
=>
	(set-strategic-number sn-enable-training-queue 0)
	(disable-self) ;only once
)
	;up-jump rule above will allow sn-enable-training-queue to re-enable after first 3 minutes

	;Repair levels
	;Town Center Only Repairs
	;1st
(defrule
	(timer-triggered eco-timer)						;we now loop the repair levels so everything gets repairs once in awhile depending on attacking/defending ;starts off set at 2 by default
	(goal ATTACK no)	;only while defending ;1st
	(strategic-number sn-object-repair-level == 16384)
=>
	(set-strategic-number sn-object-repair-level 2))

	;all repairs other than walls/gates?
	;2nd
(defrule
	(timer-triggered eco-timer)
	(goal ATTACK no)	;only while defending ;2nd
	(strategic-number sn-object-repair-level == 2) 
=>
	(set-strategic-number sn-object-repair-level 24575))
	
	;repair siege units
	;3rd
(defrule
	(timer-triggered eco-timer)
	(goal ATTACK yes)	;only while attacking
	(strategic-number sn-object-repair-level != 16384) ;16384 = siege units
=>
	(set-strategic-number sn-object-repair-level 16384))

	;eco-timer re-enable
	(defrule
	(timer-triggered eco-timer)
=>
	;(chat-local-to-self "Looping economy timer.")
	(disable-timer eco-timer)
	(up-full-reset-search) ;TESTING help prevent endless bugs?
	(enable-timer eco-timer 120)) ;check every 120 seconds

;=========================================================================================

