	;FORWARD TOWERS

;WATCH TOWER TRUSH
(defrule
	(goal TRUSH yes)
	(goal ENEMY-LOCATED yes)
	(building-available watch-tower)
(or	(players-building-type-count target-player mining-camp > 0); means we have actually seen one of these enemy eco buildings.
(or	(players-building-type-count target-player lumber-camp > 0)
(or	(players-building-type-count target-player mule-cart > 0)
	(players-building-type-count target-player mill > 0))))
	(unit-type-count villager > min-vills)
(or	(unit-type-count-total 213 < 1); Dead female builder (can't afford any villager casualties)
	(unit-type-count-total 225 < 1)); Dead male builder
	(building-type-count town-center > 0)
	(building-type-count-total watch-tower < 4)
	(can-build watch-tower)
=>
	(up-assign-builders c: watch-tower c: 4)
	(build-forward watch-tower)
)
;FORWARD GUARD TOWER
(defrule
	(goal TRUSH yes)
	(goal ENEMY-LOCATED yes)
	(goal is-town-under-attack no)
	(research-completed ri-guard-tower)
(or	(unit-type-count-total 213 < 1); Dead female builder
	(unit-type-count-total 225 < 1)); Dead male builder
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total guard-tower < 7)
	(can-build guard-tower)
=>
	(up-assign-builders c: guard-tower c: 4)
	(build-forward guard-tower)
)

;FORWARD KEEP
(defrule
	(goal TRUSH yes)
	(goal ENEMY-LOCATED yes)
	(goal is-town-under-attack no)
	(research-completed ri-keep)
(or	(unit-type-count-total 213 < 1); Dead female builder
	(unit-type-count-total 225 < 1)); Dead male builder
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total keep < 10)
	(can-build keep)
=>
	(up-assign-builders c: keep c: 4)
	(build-forward keep)
)

;FORWARD BOMBARD TOWER
(defrule
	(goal TRUSH yes)
	(goal ENEMY-LOCATED yes)
	(goal is-town-under-attack no)
	(research-completed ri-bombard-tower)
(nor	(unit-type-count-total 213 < 2); Dead female builder
	(unit-type-count-total 225 < 2)); Dead male builder
	(unit-type-count villager > min-vills)
	(building-type-count town-center > 0)
	(building-type-count-total bombard-tower < 10)
	(can-build bombard-tower)
=>
	(up-assign-builders c: bombard-tower c: 4)
	(build-forward bombard-tower)
)

;DONJON TRUSH
(defrule
	(goal sicilian-civ yes)
	(goal TRUSH yes)
	(goal ENEMY-LOCATED yes)
	(building-available donjon)
(or	(players-building-type-count target-player mining-camp > 0); means we have actually seen one of these enemy eco buildings.
(or	(players-building-type-count target-player lumber-camp > 0)
(or	(players-building-type-count target-player mule-cart > 0)
	(players-building-type-count target-player mill > 0))))
	(unit-type-count villager > min-vills)
(or	(unit-type-count-total 213 < 2); Dead female builder (can't afford any villager casualties)
	(unit-type-count-total 225 < 2)); Dead male builder
	(building-type-count town-center > 0)
	(building-type-count-total donjon < 4)
	(can-build donjon)
=>
	(up-assign-builders c: donjon c: 4)
	(build-forward donjon)
)

;OUTPOST (defence)
(defrule
	(current-age > dark-age)
	(goal position-goal flank); only flanks for now
	(goal WATER-MAP no); only land maps
	(goal is-town-under-attack no)
	(unit-type-count villager >= min-vills) ;some eco
(or	(stone-amount >= 105) ;try to maintain at least 100 stone
(or	(civ-selected ethiopian) ;no stone outposts
	(players-civ any-ally ethiopian))) ;no stone outposts team bonus
	(dropsite-min-distance wood <= 7) ;safe wood
	(strategic-number sn-military-level <= -2)
	(building-type-count town-center > 0)
	(building-type-count-total outpost < 1)
	(can-build outpost)
=>
	;(up-full-reset-search) ;not needed
	(chat-to-player target-player "46 What are you making over there?")
	(up-set-placement-data my-player-number -1 c: 30)
	(up-build place-control 0 c: outpost)
	(disable-self) ;happens 1 time only
)

