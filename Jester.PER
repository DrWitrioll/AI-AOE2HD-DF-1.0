(defrule
	(current-age == castle-age)
(or	(goal KNIGHT yes)
(or	(goal BATTLE-ELEPHANT yes)
(or	(goal STEPPE-LANCER yes)
(or	(goal CAMEL main) ;temp fix
	(goal SCOUT-CAVALRY main))))) ;temp fix
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 2) ;1
	(building-type-count-total stable < 3)
	(can-build stable)
=>
	(build stable)
