;=================================================RESIGN=================================================

;ENABLE DEFAULT RESIGN
(defrule
	(game-time > 60)
	(up-compare-goal CAN-RESIGN != yes)
	(building-type-count town-center > 0) ;helps with preventing premature resigning for nomad games
=>
	(set-goal CAN-RESIGN yes)
	(disable-self)
)

;Resign Rules

	;REMEMBER, you can always taunt Jester "104" (don't resign!) if you don't want him to ever resign, or "105" to resume normal resign rules
	;OR, you can taunt "151" to him, or "150" while spectating as him to force a resign message out!

(defrule
	(goal CAN-RESIGN no);skip 1vs1 rules if not yes
=>
	(up-jump-rule 4)
)
;=====================1VS1 Resign Rules (Basic)
;1 (population) 100 < x
(defrule
	(population-cap <= 100) ;take note
	(current-age-time > 120) ;buffer
	(goal CAN-RESIGN yes)
	(goal GIVE-UP no)
	(goal ALLY-IN-GAME no) ;no new friends
	(strategic-number sn-military-level <= -4);outnumbered greatly
(or	(and	(players-population target-player >= 24) ;full possible pop-cap ;12%
		(population <= 3))
(or	(and	(players-population target-player >= 45) ;5 from next possible pop-cap ;15%
		(population <= 7))
(or	(and	(players-population target-player >= 70);15%
		(population <= 10))
	(and	(players-population target-player >= 95);20%
		(population <= 19)))))
=>
	(set-goal GIVE-UP yes))

;2 (population) 200 < x > 100
(defrule
	(population-cap > 100)
	(population-cap <= 200)
	(current-age-time > 120)
	(goal CAN-RESIGN yes)
	(goal GIVE-UP no)
	(goal ALLY-IN-GAME no)	;NO ALLIES ALIVE
	(strategic-number sn-military-level <= -4)
(or	(and	(players-population target-player >= 120) ;25% difference in populations
		(population <= 30))
(or	(and	(players-population target-player >= 145)
		(population <= 36))
(or	(and	(players-population target-player >= 170)
		(population <= 42))
	(and	(players-population target-player >= 195)
		(population <= 48)))))
=>
	(set-goal GIVE-UP yes))

;3 (population) 400 < x > 200
(defrule
	(population-cap > 200) ;take note
	(population-cap <= 400) ;take note
	(current-age-time > 120) ;buffer
	(goal CAN-RESIGN yes)
	(goal GIVE-UP no)
	(goal ALLY-IN-GAME no) ;no new friends
	(strategic-number sn-military-level <= -4);outnumbered greatly
(or	(and	(players-population target-player >= 245) ;25% difference in populations
		(population <= 61))
(or	(and	(players-population target-player >= 295)
		(population <= 74))
(or	(and	(players-population target-player >= 345)
		(population <= 86))
	(and	(players-population target-player >= 395)
		(population <= 99)))))
=>
	(set-goal GIVE-UP yes))

;4 (population) x > 500
(defrule
	(population-cap > 500) ;take note
	(current-age-time > 120) ;buffer
	(goal CAN-RESIGN yes)
	(goal GIVE-UP no)
	(goal ALLY-IN-GAME no) ;no new friends
	(strategic-number sn-military-level <= -4)
(or	(and	(players-population target-player >= 495) ;30% difference in populations
		(population <= 149))
(or	(and	(players-population target-player >= 745) ;35%
		(population <= 260))
	(and	(players-population target-player >= 945) ;40%
		(population <= 378))))
=>
	(set-goal GIVE-UP yes)) ;end jump

;=====================End of 1vs1 Rules

;=====================Team Game Resign Rules ;they don't resign for as long as possible to prevent too early resigning
;NEW all ages
(defrule
	(current-age >= dark-age)
	;(goal is-town-under-attack yes)	;if he has no town-center this might not trigger...
	(game-time > 600)	;gives time to make vils	;10 minutes
(or	(and	(building-type-count-total town-center > 0)
			(unit-type-count-total villager <= resign-vill-pop)) ;on last vill they resign in team games
	(and	(building-type-count-total town-center == 0)
			(unit-type-count-total villager <= 2)))	;last 2 vills when no town-center is built
	(soldier-count <= min-vills)	;number varies based on pop-cap settings, see Constants_Jester.per at the bottom
	(goal CAN-RESIGN yes); default once a town-center is built ;IF JESTER IS TAUNTED TO NOT RESIGN HE WILL NEVER RESIGN NOW (as of JESTER VERSION 2.1 UPDATE)
	(goal GIVE-UP no)
=>
	(set-goal GIVE-UP yes)
)

; TEAM GAME - EMERGENCY RESIGN
(defrule
	(goal CAN-RESIGN yes) ;can be turned of with taunt 104
	(goal ALLY-IN-GAME yes) ;team game
	(population-cap >= 200) ;default settings
	(game-time > 1200) ;20 minutes minimum to consider this emergency rule
	(players-military-population any-enemy >= 50) ;some players on enemy team could be weak, but overall we are outnumbered, so use any-enemy
	(players-population any-enemy >= 150) ;high pops
	(building-type-count-total town-center <= 1)
	(population <= 30)	;we are almost dead
	(military-population < 10) ;low military
	(players-population every-ally < 40) ;all allies are almost dead
	(players-military-population every-ally < 10) ;all allies military almost dead
	(strategic-number sn-military-level <= -4) ;super outnumbered by military
=>
	;(chat-to-all "Initiating emergency team resign.")
	(set-goal GIVE-UP yes))

;==========RANDOM BANTER-CHATS SET-UP==========
(defrule
	(game-time > 3)
	(goal BANTER-CHAT 0)
=>
	(generate-random-number 12) ;get a random number from 1 to 12
	(up-get-fact random-number 0 BANTER-CHAT) ;store the random number into BANTER-CHAT
	(disable-self))

