;====================END OF RE-ENABLE ATTACKING====================

;====================SPECIAL ATTACKING RULES====================

;Rule 1: don't attack if we have a wonder
	(defrule
	(building-type-count wonder > 1)
	(goal ATTACK yes)
	(up-compare-goal stop-attacking != yes)
=>
	;(chat-to-allies "Defending my wonder.")
	(set-goal IS-WONDER-ALIVE yes) ;just in case
	(set-goal stop-attacking yes)
	(set-goal ATTACK no)
	(disable-timer attack-timer)
	(set-goal attack-goal reset-attack) ; reset-attack does nothing so that the attack-goal doesnt trigger again.
	(set-goal RETREAT yes)
	(up-retreat-now)
)

;Rule 2: EMERGENCY-ATTACK, if population is maxed out (basically a stalemate).
;Re-Enable Attacking
	(defrule
	(building-type-count wonder < 1)
	(goal EMERGENCY-ATTACK no)
	(population >= max-pop)
	(goal stop-attacking no)
=>
	(chat-to-player my-player-number "Enabling emergency attacking.")
	(set-goal EMERGENCY-ATTACK yes)
	(set-goal ATTACK yes)
	(set-goal attack-goal standby))

;Disable EMERGENCY ATTACK
(defrule
	(goal EMERGENCY-ATTACK yes)
(or	(and	(strategic-number sn-military-level <= -1) ;-2
			(population < min-emergency-attack-pop)) ;allows time for attack to be successful
(or	(goal stop-attacking yes)
	(military-population <= 5))) ;7
=>
	(chat-to-player my-player-number "Canceling emergency attack.")
	(set-goal EMERGENCY-ATTACK no)
	(set-goal ATTACK no)
	(set-goal RETREAT yes)
	(up-retreat-now) ;extra needed most times
	(disable-timer attack-timer))

;Rule 3: RESUME ATTACK GOAL IF WONDER IS DESTROYED
(defrule
(goal IS-WONDER-ALIVE yes)
(building-type-count wonder < 1)
=>
(chat-to-player my-player-number "26 The wonder has been destroyed! Resetting attack rules!")
(set-goal stop-attacking no) ;safety
(set-goal IS-WONDER-ALIVE no)
(set-goal ATTACK yes)
(set-goal attack-goal standby))

;Rule 4: special attack types ;thanks Gandalf!
	;SPECIAL TARGETING ORDER
	;SECTION 1: NO SIEGE
(defrule
	(unit-type-count armored-elephant-line < 1) ;NEW
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1) ;includes houfnice?
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder > 0)
=>
	(set-strategic-number sn-special-attack-type2 wonder) ;priority always
)

(defrule
	(unit-type-count armored-elephant-line < 1)
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1)
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder < 1)
	(players-unit-type-count target-player villager > 0) ;once wonders are dead, go for all villagers
=>
	(set-strategic-number sn-special-attack-type2 villager);this one line makes more difference than you would ever dream, early on.
)

(defrule
	(unit-type-count armored-elephant-line < 1)
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1)
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder < 1) ;wonders are the priority
	(players-unit-type-count target-player villager < 1)
	(players-building-type-count target-player town-center > 0) ;once villagers are dead then town-centers, and so on (rules below)
=>
	(set-strategic-number sn-special-attack-type2 town-center)
)

(defrule
	(unit-type-count armored-elephant-line < 1)
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1)
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder < 1)
	(players-unit-type-count target-player villager < 1)
	(players-building-type-count target-player town-center < 1)
	(players-building-type-count target-player monastery > 0)
=>
	(set-strategic-number sn-special-attack-type2 monastery)
)

(defrule
	(unit-type-count armored-elephant-line < 1)
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1)
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder < 1)
	(players-unit-type-count target-player villager < 1)
	(players-building-type-count target-player town-center < 1)
	(players-building-type-count target-player monastery < 1)
	(players-building-type-count target-player lumber-camp > 0)
=>
	(set-strategic-number sn-special-attack-type2 lumber-camp)
)

(defrule
	(unit-type-count armored-elephant-line < 1)
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1)
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder < 1)
	(players-unit-type-count target-player villager < 1)
	(players-building-type-count target-player town-center < 1)
	(players-building-type-count target-player monastery < 1)
	(players-building-type-count target-player lumber-camp < 1)
	(players-building-type-count target-player mining-camp > 0)
=>
	(set-strategic-number sn-special-attack-type2 mining-camp)
)

(defrule
	(unit-type-count armored-elephant-line < 1)
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1)
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder < 1)
	(players-unit-type-count target-player villager < 1)
	(players-building-type-count target-player town-center < 1)
	(players-building-type-count target-player monastery < 1)
	(players-building-type-count target-player lumber-camp < 1)
	(players-building-type-count target-player mining-camp < 1)
	(players-building-type-count target-player mule-cart > 0) ;NEW ;this is a building
=>
	(set-strategic-number sn-special-attack-type2 mule-cart)
)

(defrule
	(unit-type-count armored-elephant-line < 1)
	(unit-type-count battering-ram-line < 1)
	(unit-type-count bombard-cannon-line < 1)
	(unit-type-count trebuchet-set < 1)
	(players-building-type-count target-player wonder < 1)
	(players-unit-type-count target-player villager < 1)
	(players-building-type-count target-player town-center < 1)
	(players-building-type-count target-player monastery < 1)
	(players-building-type-count target-player lumber-camp < 1)
	(players-building-type-count target-player mining-camp < 1)
	(players-building-type-count target-player mule-cart < 1)
	(players-building-type-count target-player castle > 0) ;castle is last because we have no siege in these rules (siege rules order below)
=>
	(set-strategic-number sn-special-attack-type2 castle)
)

	;SECTION 2: HAVE SIEGE
	;prioritize enemy wonder
(defrule
	(or (unit-type-count armored-elephant-line > 0) ;NEW
	(or	(unit-type-count battering-ram-line > 0)
	(or	(unit-type-count bombard-cannon-line > 0)
		(unit-type-count trebuchet-set > 0))))
	(players-building-type-count target-player wonder > 0) ;wonders are top priority
=>
	(set-strategic-number sn-special-attack-type2 wonder)
)
	;prioritize enemy castles
(defrule
	(or (unit-type-count armored-elephant-line > 0)
	(or	(unit-type-count battering-ram-line > 0)
	(or	(unit-type-count bombard-cannon-line > 0)
		(unit-type-count trebuchet-set > 0))))
	(players-building-type-count target-player wonder < 1)
	(players-building-type-count target-player castle > 0)
=>
	(set-strategic-number sn-special-attack-type2 castle)
)
	;prioritize enemy town-centers
(defrule
	(or (unit-type-count armored-elephant-line > 0)
	(or	(unit-type-count battering-ram-line > 0)
	(or	(unit-type-count bombard-cannon-line > 0)
		(unit-type-count trebuchet-set > 0))))
	(players-building-type-count target-player wonder < 1)
	(players-building-type-count target-player castle < 1)
	(players-building-type-count target-player town-center > 0)
=>
	(set-strategic-number sn-special-attack-type2 town-center)
)
	;prioritize enemy villagers
(defrule
	(or (unit-type-count armored-elephant-line > 0)
	(or	(unit-type-count battering-ram-line > 0)
	(or	(unit-type-count bombard-cannon-line > 0)
		(unit-type-count trebuchet-set > 0))))
	(players-building-type-count target-player castle < 1)
	(players-building-type-count target-player wonder < 1)
	(players-building-type-count target-player town-center < 1)
	(players-unit-type-count target-player villager > 0)
=>
	(set-strategic-number sn-special-attack-type2 villager)
)

;====================END OF SPECIAL ATTACKING RULES====================

;====================ATTACK TIMER====================

	;attack == no
(defrule
(or	(goal ATTACK no)
	(goal stop-attacking yes))
	(up-timer-status attack-timer == timer-running) ;active timer
=>
	(chat-local-to-self "Disabling attack timer.")
	(disable-timer attack-timer)
)

	;attack == yes (loop rule)
(defrule
	(goal ATTACK yes)
	(goal stop-attacking no)
	(timer-triggered attack-timer)
=>
	(chat-local-to-self "Normal attack timer.")
	(disable-timer attack-timer)
	(enable-timer attack-timer 30)
)

	;safety enable
(defrule
	(goal ATTACK yes)
	(goal stop-attacking no)
	(up-timer-status attack-timer < timer-running) ;disabled timer
=>
	(chat-local-to-self "Looping attack timer.")
	(enable-timer attack-timer 30)
)
;====================END OF ATTACK TIMER====================

	;END OF ATTACKING RULES


