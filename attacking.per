	;RESET SPECIFIC-ENEMY TARGET-PLAYER
(defrule
	(up-compare-goal GL-FOCUS-PLAYER != 1)
	(goal GL-FOCUS-PLAYER 3) ;specific-enemy
(or	(goal is-town-under-attack yes)				;STOP targeting the taunted player if we are under attack OR,
	(not	(player-in-game target-player)))	;the enemy has resigned or died
=>
	(set-goal GL-FOCUS-PLAYER 1)
)	

	;TARGET-PLAYER (my-player-number)
(defrule
	(goal GL-FOCUS-PLAYER 0)
	(timer-triggered focus-player-timer)
=>
	;(up-modify-sn sn-target-player-number c:= my-player-number) ;we don't ever need to target ourselves, only enemies for attacking
	(up-modify-sn sn-focus-player-number c:= my-player-number) 	;focus-player is for DUC & getting information about that player
)

	;TARGET-PLAYER (closest)
(defrule
	(goal GL-FOCUS-PLAYER 1)
	(up-allied-goal every-ally 11 != 1)	;11 is general ai under-attack goal
	(timer-triggered focus-player-timer)
=>
	(up-find-player enemy find-closest TARGET-ENEMY)
	(up-modify-sn sn-target-player-number g:= TARGET-ENEMY)
	(up-modify-sn sn-focus-player-number g:= TARGET-ENEMY)
)

	;TARGET-PLAYER (help allies)
(defrule
	(goal GL-FOCUS-PLAYER 1)
	(up-allied-goal any-ally 11 == 1)	;11 is general ai under-attack goal
	(timer-triggered focus-player-timer)
=>
	;(up-find-player enemy find-closest TARGET-ENEMY)
	(up-modify-sn sn-target-player-number == -1) ;-1 is supposed to target allies for helping?
	(up-modify-sn sn-focus-player-number == -1)
)

	;TARGET-PLAYER (attacking-enemy)
(defrule
	(goal GL-FOCUS-PLAYER 2)
	(timer-triggered focus-player-timer)
=>
	(up-find-player enemy find-attacker TARGET-ENEMY)
	(up-modify-sn sn-target-player-number g:= TARGET-ENEMY)
	(up-modify-sn sn-focus-player-number g:= TARGET-ENEMY)
)

	;TARGET-PLAYER (specific taunt) ;this is already set-up when taunted, don't change the focus or target player
;(defrule
;	(goal GL-FOCUS-PLAYER 3)
;	(timer-triggered focus-player-timer)
;=>
;	(up-modify-sn sn-target-player-number g:= TARGET-ENEMY) ;should update specific player
;	(up-modify-sn sn-focus-player-number g:= TARGET-ENEMY)
;)

(defrule
	(game-time > 30)	;safety
	(goal ENEMY-LOCATED no) ;safety
=>
	(up-jump-rule 4)
)

	;FOCUS-PLAYER TIMER (not helping allies)
(defrule
	(game-time > 30) ;safety
	(up-allied-goal every-ally 11 != 1)
(or	(timer-triggered focus-player-timer)
	(up-timer-status focus-player-timer < timer-running)) ;may have bugged out ;safety
=>
	;(chat-to-player my-player-number "Looping focus-player timer.")
	(disable-timer focus-player-timer)
	(enable-timer focus-player-timer 3)) ;10 ;the lower the better

	;FOCUS-PLAYER TIMER (helping allies)
(defrule
	(game-time > 30) ;safety
	(up-allied-goal any-ally 11 == 1)
(or	(timer-triggered focus-player-timer)
	(up-timer-status focus-player-timer < timer-running)) ;may have bugged out ;safety
=>
	;(chat-to-player my-player-number "Looping focus-player timer.")
	(disable-timer focus-player-timer)
	(enable-timer focus-player-timer 30)) ;sometime to help allies


	;DEBUG FOCUS & TARGET-PLAYER RULES
	;fix invalid focus-player
(defrule
	(game-time > 30)	;safety
(or	(strategic-number sn-focus-player-number <= -2)	;only players 0 to 8 exists, -1 is for allies
	(strategic-number sn-focus-player-number >= 9))
=>
	;(chat-to-player my-player-number "ERROR: focus-player does not exist. Debugging.")
	(up-find-player enemy find-closest TARGET-ENEMY)	;default
	(up-modify-sn sn-target-player-number g:= TARGET-ENEMY)
	(up-modify-sn sn-focus-player-number g:= TARGET-ENEMY)
)
	;fix invalid-target-player
(defrule
	(game-time > 30)	;safety
(or	(strategic-number sn-target-player-number <= -2)	;only players 0 to 8 exists, -1 is for allies
	(strategic-number sn-target-player-number >= 9))
=>
	;(chat-to-player my-player-number "ERROR: target-player does not exist. Debugging.")
	(up-find-player enemy find-closest TARGET-ENEMY)
	(up-modify-sn sn-target-player-number g:= TARGET-ENEMY)
	(up-modify-sn sn-focus-player-number g:= TARGET-ENEMY)
)
	;fix bugged closest-enemy target-player
(defrule
	(game-time > 30)	;safety
	(goal GL-FOCUS-PLAYER 1)
(or	(strategic-number sn-target-player-number == my-player-number)
	(strategic-number sn-target-player-number == 0))
=>
	;(chat-to-player my-player-number "ERROR: invalid target-player. Debugging.")
	(up-find-player enemy find-closest TARGET-ENEMY)
	(up-modify-sn sn-target-player-number g:= TARGET-ENEMY)
	(up-modify-sn sn-focus-player-number g:= TARGET-ENEMY)
)

	;END OF FOCUS-PLAYER RULES

;FOUND THE ENEMY
(defrule
	(goal ENEMY-LOCATED no); default goal
	(players-building-count any-enemy > 0); testing 1 building but may change to more specific later, like a town-center
=>
	(chat-to-allies "An enemy has been located.")
	(set-goal ENEMY-LOCATED yes)
	(disable-self))

;====================FIRST ATTACK====================

	;drush
(defrule
	(current-age == dark-age)
	(goal ATTACK no)
	(goal ENEMY-LOCATED yes)
	(goal DRUSH yes)
	(goal stop-attacking no)
	(strategic-number sn-military-level >= -3) ;don't attack if extremely outnumbered
(or	(goal EMERGENCY-ATTACK yes); triggers if population is maxed out.
	(soldier-count >= 3)); minimal 2 militia plus 1 scout (or 3 militia) to start attack
=>
	(set-goal ATTACK yes)
	(set-goal attack-goal standby)
	(chat-to-player my-player-number "Preparing an attack.")
	(disable-self))

	;flush
(defrule
	(current-age == feudal-age)
	(building-type-count-total wonder < 1) ;unlikely but you never know these days!
	;(up-compare-goal ATTACK != yes)
	(goal ENEMY-LOCATED yes)
	(goal FLUSH yes)
	(goal stop-attacking no)
	(strategic-number sn-military-level >= -2) ;don't attack if outnumbered
(or	(goal EMERGENCY-ATTACK yes)
	(soldier-count >= 5)) ;5
=>
	(set-goal ATTACK yes)
	(set-goal attack-goal standby)
	(chat-to-player my-player-number "Preparing an attack.")
	(disable-self))

	;castle-age attack
	(defrule
	(current-age == castle-age)
	(building-type-count-total wonder < 1)
	(goal ENEMY-LOCATED yes)
	(goal stop-attacking no)
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= 2));3
	(soldier-count >= 5)
=>
	(set-goal ATTACK yes)
	(set-goal attack-goal standby)
	(chat-to-player my-player-number "Preparing an attack.")
	(disable-self)
)
	;imperial-age attack
	(defrule
	(current-age >= imperial-age)
	(building-type-count-total wonder < 1)
	(goal ENEMY-LOCATED yes)
	(goal stop-attacking no)
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= 2))
	(soldier-count >= 5)
=>
	(set-goal ATTACK yes)
	(set-goal attack-goal standby)
	(chat-to-player my-player-number "Preparing an attack.")
	(disable-self)
)

;====================SPECIAL POCKET ATTACK RULES====================

;castle-age FIRST attack only (POCKET)
	(defrule
	(current-age == castle-age)
	(up-compare-goal WATER-MAP != separated) ;no rush on water-maps as pocket players
	(building-type-count wonder < 1)
	(goal ENEMY-LOCATED yes)
	(goal stop-attacking no)
	(goal position-goal pocket) ;pocket
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= -3)) ;pockets attack to help flanks, but should retreat if hugely outnumbered
	(soldier-count >= 8) ;minimal 8 military though
=>
	(up-gather-inside c: barracks c: 0) ;just in case...
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: donjon c: 0)
	(up-gather-inside c: krepost c: 0)
	(up-gather-inside c: castle c: 0)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now) ;this will force a 1 wave attack
	(disable-self)
)
;imperial-age FIRST attack only (POCKET)
	(defrule
	(current-age >= imperial-age)
	(up-compare-goal WATER-MAP != separated) ;no rush on water-maps as pocket players
	(building-type-count wonder < 1)
	(goal ENEMY-LOCATED yes)
	(goal stop-attacking no)
	(goal position-goal pocket) ;pocket
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= -3)) ;pockets attack to help flanks, but should retreat if hugely outnumbered
	(soldier-count >= 8) ;minimal 8 military though
=>
	(up-gather-inside c: barracks c: 0) ;just in case...
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: donjon c: 0)
	(up-gather-inside c: krepost c: 0)
	(up-gather-inside c: castle c: 0)
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(attack-now) ;this will force a 1 wave attack
	(disable-self)
)
;====================END OF SPECIAL POCKET ATTACK RULES====================

;====================END OF FIRST ATTACK====================

;====================STOP ATTACKING====================
	;NEW Stop attacking (dark-age)
(defrule
	(current-age == dark-age) ;stop if:
	(goal ATTACK yes) ;we were set to attack
	(goal EMERGENCY-ATTACK no) ;we are NOT emergency attacking (maxed-out pop)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle > 0)) ;the enemy has a castle (we don't have siege to deal with it)
(or	(goal stop-attacking yes); we've been told to stop attacking (taunt from ally)
(or	(goal is-town-under-attack yes) ;we are under attack
	(soldier-count <= 1)))) ;lost some soldiers
=>
	(chat-local-to-self "Disabling attacking.")
	(set-goal attack-goal wait)
	(set-goal ATTACK no)
	(disable-timer attack-timer)
	;(up-reset-unit c: -1) ;was affecting trade units (they stop trading).
	(set-goal RETREAT yes)
	(up-retreat-now)
)
	;NEW Stop attacking (feudal-age)
(defrule
	(current-age == feudal-age) ;stop if:
	(current-age-time > 260);safety for hopefully getting out first attack out
	(goal ATTACK yes) ;we were set to attack
	(goal EMERGENCY-ATTACK no) ;we are NOT emergency attacking (maxed-out pop)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle > 0)) ;the enemy has a castle (we don't have siege to deal with it)
(or	(goal stop-attacking yes); we've been told to stop attacking (taunt from ally)
(or (building-type-count-total wonder > 0) ;imagine xD
(or	(goal is-town-under-attack yes)
(or	(and	(soldier-count <= 3); low on military
		(current-age-time > 260))
	(strategic-number sn-military-level <= -1)))))) ;we are outnumbered.
=>
	(chat-to-player my-player-number "Disabling attacking.")
	(set-goal attack-goal wait)
	(set-goal ATTACK no)
	(disable-timer attack-timer)
	;(up-reset-unit c: -1)
	(set-goal RETREAT yes)
	(up-retreat-now)
)

;Don't attack (feudal-age) level 2
;	(defrule
;	(current-age == feudal-age)
;	(goal FLUSH yes) ;TAKE NOTE
;	(goal ATTACK yes)
;	(goal SIEGE-FOR-CASTLE no)
;	(players-building-type-count target-player castle > 1)
;(or	(and	(goal EMERGENCY-ATTACK yes)
;	(or	(strategic-number sn-military-level <= -1);different than >= castle-age rule 1 rule below
;		(military-population < 15)))
;(or	(and	(goal EMERGENCY-ATTACK no)
;	(strategic-number sn-military-level <= -2))
;	(goal stop-attacking yes)))
;=>
;	(chat-to-player my-player-number "Retreating.")
;	(disable-timer attack-timer)
;	(set-goal attack-goal wait)
;	(set-goal ATTACK no)
;	(up-reset-unit c: -1)
;	(up-retreat-now))

	; NEW Stop attacking (>= castle-age) (FLANKS)
(defrule
	(current-age == castle-age) ;stop if:
	(goal position-goal flank)
	(goal ATTACK yes) ;we were set to attack
	(goal EMERGENCY-ATTACK no) ;we are NOT emergency attacking (maxed-out pop)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle > 0)) ;the enemy has a castle and we don't have any siege to deal with it
(or	(goal stop-attacking yes); we've been told to stop attacking (taunt from ally)
(or	(strategic-number sn-military-level <= 0) ;we are outnumbered.
(or	(soldier-count <= 5) ;too few
(or	(building-type-count-total wonder > 0)
	(goal is-town-under-attack yes)))))) ;we are under attack
=>
	(chat-to-player my-player-number "Disabling attacking.")
	(set-goal attack-goal wait)
	(set-goal ATTACK no)
	(disable-timer attack-timer)
	;(up-reset-unit c: -1)
	(set-goal RETREAT yes)
	(up-retreat-now)
)

	; NEW Stop attacking (== imperial-age) (FLANKS)
(defrule
	(current-age >= imperial-age) ;stop if:
	(goal position-goal flank)
	(goal ATTACK yes) ;we were set to attack
	(goal EMERGENCY-ATTACK no) ;we are NOT emergency attacking (maxed-out pop)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle > 0)) ;the enemy has a castle and we don't have any siege to deal with it
(or	(goal stop-attacking yes); we've been told to stop attacking (taunt from ally)
(or	(strategic-number sn-military-level <= -1) ;we are outnumbered.
(or	(soldier-count <= 5) ;too few
(or	(building-type-count-total wonder > 0)
	(goal is-town-under-attack yes)))))) ;we are under attack
=>
	(chat-to-player my-player-number "Disabling attacking.")
	(set-goal attack-goal wait)
	(set-goal ATTACK no)
	(disable-timer attack-timer)
	;(up-reset-unit c: -1)
	(set-goal RETREAT yes)
	(up-retreat-now)
)
	; NEW Stop attacking (>= castle-age) (POCKETS)
(defrule
	(current-age >= castle-age) ;stop if:
	(goal position-goal pocket)
	(goal ATTACK yes) ;we were set to attack
	(goal EMERGENCY-ATTACK no) ;we are NOT emergency attacking (maxed-out pop)
;(or	(and	(goal SIEGE-FOR-CASTLE no) ;we can dodge their arrows ;)
;		(players-building-type-count target-player castle > 0))
(or	(goal stop-attacking yes); we've been told to stop attacking (taunt from ally)
(or	(strategic-number sn-military-level <= -4) ;we are completely outnumbered.
(or	(soldier-count <= 3) ;we lost almost everyone
(or	(building-type-count-total wonder > 0)
	(goal is-town-under-attack yes))))) ;we are under attack
=>
	(chat-to-player my-player-number "Disabling attacking.")
	(set-goal attack-goal wait)
	(set-goal ATTACK no)
	(disable-timer attack-timer)
	;(up-reset-unit c: -1)
	(set-goal RETREAT yes)
	(up-retreat-now)
)
;====================END OF STOP ATTACKING====================

;====================PREPARE ATTACK====================

	;prepare attack
(defrule
	(current-age <= feudal-age)
	(goal ATTACK yes)
	(goal attack-goal standby)
;(or	(goal WATER-MAP no)
;	(goal WATER-MAP connected))
=> 
	(set-strategic-number sn-group-form-distance 90) ;30
	(set-strategic-number sn-attack-group-gather-spacing 10) ;20 ;testing
	(set-strategic-number sn-maximum-attack-group-size 0) 
	(set-strategic-number sn-minimum-attack-group-size 0) 
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-number-boat-attack-groups 0)
	(set-strategic-number sn-minimum-boat-attack-group-size 0)
	(set-strategic-number sn-maximum-boat-attack-group-size 0)
	(set-goal attack-goal offence);this goal does nothing. This keeps this rule from repeating itself a million times a second.
	;(disable-timer attack-timer)
	(enable-timer attack-timer 30)
)

	;prepare attack
(defrule
	(current-age >= castle-age)
	(goal ATTACK yes)
	(goal attack-goal standby)
;(or	(goal WATER-MAP no)
;	(goal WATER-MAP connected))
=> 
	(set-strategic-number sn-group-form-distance 90) ;60
	(set-strategic-number sn-attack-group-gather-spacing 15) ;20 ;testing
	(set-strategic-number sn-maximum-attack-group-size 0) 
	(set-strategic-number sn-minimum-attack-group-size 0) 
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-number-boat-attack-groups 0)
	(set-strategic-number sn-minimum-boat-attack-group-size 0)
	(set-strategic-number sn-maximum-boat-attack-group-size 0)
	(set-goal attack-goal offence);This keeps this rule from repeating itself a million times a second.
	;(disable-timer attack-timer)
	(enable-timer attack-timer 30)
)
;====================END OF PREPARE ATTACK====================

;====================ATTACK!====================
	;LOW POP ATTACKS

	(defrule
	(current-age <= feudal-age)
	(military-population <= 30)
	(goal EMERGENCY-ATTACK no)
	(goal ATTACK yes)
	(goal attack-goal offence)
	;(unit-type-count transport-ship < 1)
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(timer-triggered attack-timer)
=>
	(chat-local-to-self "Attacking.")
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(set-strategic-number sn-number-attack-groups 500) ;100
	(set-strategic-number sn-number-boat-attack-groups 500) ;100
	(set-strategic-number sn-maximum-attack-group-size 40) ;10
	(set-strategic-number sn-minimum-attack-group-size 40) ;1
	(set-strategic-number sn-maximum-boat-attack-group-size 10) ;10
	(set-strategic-number sn-minimum-boat-attack-group-size 10) ;1
	;(attack-now)
	(disable-timer attack-timer)
	(set-goal attack-goal standby) ;loops attacking
)

	(defrule
