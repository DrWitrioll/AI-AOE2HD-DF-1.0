	;target specific-player YES (until (town-under-attack) or enemy is no longer in-game)
;player 1
(defrule
	(taunt-detected any-ally 61)
=>
	(acknowledge-taunt this-any-ally 61)
	(chat-to-allies specific-player-chat-yes) ;defconst chat strings saves alot of chat string slots for other uses!
	(set-goal GL-FOCUS-PLAYER 3)
	(set-strategic-number sn-target-player-number 1)
	(set-strategic-number sn-focus-player-number 1))
