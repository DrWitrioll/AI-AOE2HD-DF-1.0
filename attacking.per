
	;Attacking rules for Jester.per , includes sn-focus-player & sn-target-player rules

(defrule
	(true)
=>
	(set-goal ATTACK no)
	(set-goal EMERGENCY-ATTACK no)
	(set-goal stop-attacking no)
	(disable-self))

	;miscellaneous sn's for attacking
(defrule
(or	(goal stop-attacking yes)
(or	(goal ATTACK no)
	(goal RETREAT yes)))
(or	(strategic-number sn-percent-attack-soldiers != 0)
(or	(strategic-number sn-percent-attack-boats != 0)
(or	(strategic-number sn-number-attack-groups != 0)
	(strategic-number sn-number-boat-attack-groups != 0))))
=>
	(up-modify-sn sn-percent-attack-soldiers c:= 0)
	(up-modify-sn sn-percent-attack-boats c:= 0)
	(up-modify-sn sn-number-attack-groups c:= 0)
	(up-modify-sn sn-number-boat-attack-groups c:= 0)
)

	;stop-attacking = force no attacking
(defrule
(or	(goal stop-attacking yes)
	(and	(goal EMERGENCY-ATTACK no)
			(strategic-number sn-military-level <= -4)));suicide
	(up-compare-goal ATTACK != no)
=>
	(chat-local-to-self "Forcing no attacking.")
	(set-goal ATTACK no)
)

			;ATTACK RULES

	;target-player-timer starting
(defrule
	(game-time > 30)
=>
	(enable-timer focus-player-timer 3) ;10 ;lowered to 3 as it was taking too long sometimes to update targets (especially for initial TC arrow dodging)
	(chat-to-player my-player-number "Enabling focus-player timer.")
	(disable-self))

	;BACKUP focus-player rule
(defrule
	;(goal GL-FOCUS-PLAYER 3) ;this rule accounts for this
	(up-compare-goal GL-FOCUS-PLAYER != 1)
(not	(goal GL-FOCUS-PLAYER 0)) ;my-player-number
	(game-time > 60) ;buffer time
	(goal ENEMY-LOCATED yes) ;found initial enemy already
(not	(player-in-game target-player)) ;current target is not in the game anymore
	(players-building-count any-enemy > 0) ;enemy buildings left
=>
	(chat-local-to-self "INVALID TARGET PLAYER. Targeting closest enemy.")
	(set-goal GL-FOCUS-PLAYER 1)
)

;DEFAULT ENABLE TARGET-PLAYER (closest-enemy)
(defrule
		(up-compare-goal GL-FOCUS-PLAYER != 1)
(not	(goal GL-FOCUS-PLAYER 0)) ;my-player-number	;1 = closest enemy
(not	(goal GL-FOCUS-PLAYER 2)) ;temp attacking player
(not	(goal GL-FOCUS-PLAYER 3)) ;specific enemy player
(not	(goal GL-FOCUS-PLAYER 4)) ;allies
		(timer-triggered focus-player-timer)
=>
	(set-goal GL-FOCUS-PLAYER 1)
)

;ENABLE ATTACKING TARGET-PLAYER (attacking-enemy)
(defrule
	(up-compare-goal GL-FOCUS-PLAYER != 2)
	(goal is-town-under-attack yes)
=>
	;(chat-local-to-self "Targeting attacking player.")
	(set-goal GL-FOCUS-PLAYER 2)
)

;DISABLE ATTACKING TARGET-PLAYER (attacking-enemy)
(defrule
	(up-compare-goal GL-FOCUS-PLAYER != 1)
	(goal GL-FOCUS-PLAYER 2)
	(goal is-town-under-attack no)
=>
	;(chat-local-to-self "Attack is over, retargeting closest enemy.")
	(set-goal GL-FOCUS-PLAYER 1)
)
