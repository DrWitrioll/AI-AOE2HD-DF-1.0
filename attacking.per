;SPECIAL TARGET-PLAYER (specific enemy taunt)
	;not ready to target a specific enemy
;player 1
(defrule
		(taunt-detected any-ally 61) ;we detect a specific taunt
	(or	(player-number 1)
	(or	(goal is-town-under-attack yes) ;targeting goes to attacking player
	(or	(players-stance 1 ally) ;don't target allies perpetually
	(or	(players-building-count 1 < 1) ;no targetable buildings
	(or	(not	(player-in-game 1))
		(up-timer-status focus-player-timer < timer-triggered)))))) ;disabled-timer
=>
	(acknowledge-taunt this-any-ally 61)
	(chat-to-player this-any-ally specific-player-chat-no))	;using defconst chats saves alot of string chat slots!!!
