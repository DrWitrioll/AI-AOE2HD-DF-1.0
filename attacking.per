	(timer-triggered attack-timer)
=>
	(chat-local-to-self "Attacking.")
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(set-strategic-number sn-number-attack-groups 500)
	(set-strategic-number sn-number-boat-attack-groups 500)
	(set-strategic-number sn-maximum-attack-group-size 40)
	(set-strategic-number sn-minimum-attack-group-size 40)
	(set-strategic-number sn-maximum-boat-attack-group-size 10)
	(set-strategic-number sn-minimum-boat-attack-group-size 10)
	;(attack-now)
	(disable-timer attack-timer)
	(set-goal attack-goal standby)
)

	(defrule
	(current-age >= imperial-age)
	(military-population <= 30)
	(goal EMERGENCY-ATTACK no)
	(goal ATTACK yes)
	(goal attack-goal offence)
(or	(goal WATER-MAP no)
	(goal WATER-MAP connected))
	(timer-triggered attack-timer)
=>
	(chat-local-to-self "Attacking.")
	(set-strategic-number sn-percent-attack-soldiers 100)
	(set-strategic-number sn-percent-attack-boats 100)
	(set-strategic-number sn-number-attack-groups 500)
	(set-strategic-number sn-number-boat-attack-groups 500)
