	(set-strategic-number sn-minimum-attack-group-size 5) ;40
	(set-strategic-number sn-maximum-boat-attack-group-size 5) ;40
	(set-strategic-number sn-minimum-boat-attack-group-size 5) ;40
	;(attack-now)
	(disable-timer attack-timer)
	(set-goal attack-goal standby) ;loops attacking
)

	(defrule
	(current-age == castle-age)
(or	(military-population > 30)
