;====================END OF ATTACKING====================

;====================RE-ENABLE ATTACKING====================

	; NEW Re-enable attacking (feudal-age)
	(defrule
	(current-age == feudal-age)
	(goal ENEMY-LOCATED yes) ;don't attack unless an enemy has been found
	(building-type-count-total wonder < 1)
	(goal is-town-under-attack no)
	(goal ATTACK no)
	(goal stop-attacking no)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle < 1))
		(goal SIEGE-FOR-CASTLE yes))
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= 2))
	(soldier-count > 4); must have some soldiers
=>
	;(set-strategic-number sn-group-form-distance 40) ;30
	(chat-to-player my-player-number "Prepping for an attack.")
	(set-goal ATTACK yes)
	(set-goal attack-goal standby)); preps attackers, just on standby. use "no" to disable attacking, use "standby and attack" when re-enabling attacking.
	;(up-reset-unit c: -1)
	;(up-retreat-now)) ;gathers units into town (only initially [not for looping]) ;removed - was causing too many bugs

	; NEW Re-enable attacking (castle-age) (FLANKS)
	(defrule
	(current-age == castle-age)
	(goal position-goal flank)
	(goal ENEMY-LOCATED yes)
	(building-type-count-total wonder < 1)
	(goal is-town-under-attack no)
	(goal ATTACK no)
	(goal stop-attacking no)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle < 1))
		(goal SIEGE-FOR-CASTLE yes))
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= 2))
	(soldier-count >= 10)
=>
	;(set-strategic-number sn-group-form-distance 40) ;30
	(chat-to-player my-player-number "Prepping for an attack.")
	(set-goal ATTACK yes)
	(set-goal attack-goal standby))
	;(up-reset-unit c: -1)
	;(up-retreat-now)) ;removed - was causing too many bugs

	;NEW Re-enable attacking (imperial-age) (FLANKS)
	(defrule
	(current-age >= imperial-age)
	(goal position-goal flank)
	(goal ENEMY-LOCATED yes)
	(building-type-count-total wonder < 1)
	(goal is-town-under-attack no)
	(goal ATTACK no)
	(goal stop-attacking no)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle < 1))
		(goal SIEGE-FOR-CASTLE yes))
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= 1));0
	(soldier-count >= 10)
=>
	;(set-strategic-number sn-group-form-distance 40) ;30
	(chat-to-player my-player-number "Prepping for an attack.")
	(set-goal ATTACK yes)
	(set-goal attack-goal standby))
	;(up-reset-unit c: -1)
	;(up-retreat-now))

	; NEW Re-enable attacking (castle-age) (POCKETS)
	(defrule
	(current-age == castle-age)
	(goal position-goal pocket)
	(goal ENEMY-LOCATED yes)
	(building-type-count-total wonder < 1)
	(goal is-town-under-attack no)
	(goal ATTACK no)
	(goal stop-attacking no)
(or	(and	(goal SIEGE-FOR-CASTLE no) ;don't stop a current attack but don't start a new one if no siege for castle
		(players-building-type-count target-player castle < 1))
		(goal SIEGE-FOR-CASTLE yes))
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= -3)) ;go very aggressive
	(soldier-count >= 10) ;minimal 10 soldiers to attack
=>
	;(set-strategic-number sn-group-form-distance 40) ;30
	(chat-to-player my-player-number "Prepping for an attack.")
	(set-goal ATTACK yes)
	(set-goal attack-goal standby))
	;(up-reset-unit c: -1)
	;(up-retreat-now))

	;NEW Re-enable attacking (imperial-age) (POCKETS)
	(defrule
	(current-age >= imperial-age)
	(goal position-goal pocket)
	(goal ENEMY-LOCATED yes)
	(building-type-count-total wonder < 1)
	(goal is-town-under-attack no)
	(goal ATTACK no)
	(goal stop-attacking no)
(or	(and	(goal SIEGE-FOR-CASTLE no)
		(players-building-type-count target-player castle < 1))
		(goal SIEGE-FOR-CASTLE yes))
(or	(goal EMERGENCY-ATTACK yes)
	(strategic-number sn-military-level >= -3)) ;go very aggressive
	(soldier-count >= 10); don't retreat scout at beginning of the game.
=>
	;(set-strategic-number sn-group-form-distance 40) ;30
	(chat-to-player my-player-number "Prepping for an attack.")
	(set-goal ATTACK yes)
	(set-goal attack-goal standby))
	;(up-reset-unit c: -1)
	;(up-retreat-now))


