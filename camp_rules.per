;==============emergency expand wood distances==============
(defrule
	(resource-found wood)
	(goal is-town-under-attack no)
(not	(town-under-attack))
	(building-type-count town-center > 0)
	(unit-type-count villager > 10);temporary fix
	(dropsite-min-distance wood >= 8)
	(strategic-number sn-lumber-camp-max-distance c:< map-size)
	(strategic-number sn-wood-gatherer-percentage > 0);indicates need
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(up-modify-sn sn-lumber-camp-max-distance c:+ 2)) ;6
;	(chat-local-to-self "Increasing wood build distance.")
;	(up-chat-data-to-player my-player-number "Lumber-camp distance: %d." s: sn-lumber-camp-max-distance)


	;emergency expand gold-distances
(defrule
	(resource-found gold)
	(goal is-town-under-attack no)
	(building-type-count town-center > 0)
	(unit-type-count villager > 10);temporary fix
	(dropsite-min-distance gold >= 8)
	(strategic-number sn-mining-camp-max-distance c:< map-size)
(or	(dropsite-min-distance wood <= 8);safish woodline
	(wood-amount >= 250))
	(strategic-number sn-gold-gatherer-percentage > 0);indicates need
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
;	(chat-local-to-self "Increasing gold build distance.")
	(up-modify-sn sn-mining-camp-max-distance c:+ 2)
;	(up-chat-data-to-player my-player-number "Mining-camp distance: %d." s: sn-mining-camp-max-distance)
)
	;starting stone-mine distances
;1
(defrule
	(resource-found stone)
	(goal is-town-under-attack no)
(or	(dropsite-min-distance wood <= 8);safish woodline
	(wood-amount >= 250))
	(dropsite-min-distance stone > 8)
	(dropsite-min-distance stone c:< map-size)
	(strategic-number sn-stone-gatherer-percentage > 0);indicates need
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
;	(chat-local-to-self "Increasing camp-distances to cover stone distance.")
	(up-modify-sn sn-mining-camp-max-distance c:+ 2)
)

