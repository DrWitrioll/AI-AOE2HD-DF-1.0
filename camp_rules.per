;INCREASE MILL MAX DISTANCE (1)
(defrule
	(building-type-count mill == 1)
	(strategic-number sn-mill-max-distance < 38)
=>
;	(chat-to-player my-player-number "mill-max-distance 25.")
	(set-strategic-number sn-mill-max-distance 38) ;38
	(disable-self)
)
	;mining-camp rules

	;emergency mining-camp
;	(defrule
;	(unit-type-count villager > 19)
;	(building-type-count-total mining-camp == 0)
;	(strategic-number sn-mining-camp-max-distance < 50)
;=>
;	(chat-local-to-self "Mining camp distance 50.")
;	(set-strategic-number sn-mining-camp-max-distance 50)
;	(disable-self)
;)


		;MINING-CAMP BUILDINGS
	;IGNORE IF Armenian or Georgian Civs (they get mule carts)
(defrule
(or	(goal armenian-civ yes)
	(goal georgian-civ yes))
=>
	(up-jump-rule 4))	;start jump

	;first mining-camp (gold)
	(defrule
(or	(and	(goal DRUSH yes)
			(building-type-count-total barracks > 0))
(or	(and	(goal DRUSH no)
			(unit-type-count villager > 17))
	(unit-type-count villager >= max-vill-pop)))
	(resource-found gold)
	(strategic-number sn-gold-gatherer-percentage > 0)
	(up-pending-objects c: mining-camp < 1)
	(building-type-count-total mining-camp < 1)
	(building-type-count lumber-camp > 0);fully built
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7)); to ensure wood is used for a new lumbercamp instead of wasted
	(dropsite-min-distance gold s:< sn-mining-camp-max-distance)
	(dropsite-min-distance gold c:< map-size)
	(up-pending-objects c: mining-camp < 1) ;defer dropsite SN now in use
	(can-build mining-camp)
=>
;	(chat-to-player my-player-number "Building first gold mining camp.")
	(set-strategic-number sn-allow-adjacent-dropsites 1) ;0
	(set-strategic-number sn-dropsite-separation-distance 1)
	(build mining-camp)
	;(disable-self) ;this may have caused a bug for first camp not getting built for a long time
)
	;main gold mining-camp
	(defrule
	(goal GOLD-REMAINING yes)
	(up-gaia-type-count c: gold-mine > 0) 
	(resource-found gold)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(dropsite-min-distance gold >= 5)
	(dropsite-min-distance gold s:< sn-mining-camp-max-distance)
	(dropsite-min-distance gold c:< map-size)
	(strategic-number sn-gold-gatherer-percentage > 0)
	(building-type-count lumber-camp > 0)
	(building-type-count town-center > 0)
	(building-type-count mining-camp < 16)
	(up-pending-objects c: mining-camp < 1) ;defer dropsite SN now in use
	(can-build mining-camp)
=>
	(set-strategic-number sn-allow-adjacent-dropsites 1) ;0
	(set-strategic-number sn-dropsite-separation-distance 7) ;8
	(build mining-camp)
)
	;main stone mining-camp
	(defrule
	(goal STONE-REMAINING yes)
	(up-gaia-type-count c: stone-mine > 0) 
	(resource-found stone)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
	(dropsite-min-distance stone >= 5)
	(dropsite-min-distance stone s:< sn-mining-camp-max-distance)
	(dropsite-min-distance stone c:< map-size)
	(strategic-number sn-stone-gatherer-percentage > 0);must want stone
	(building-type-count lumber-camp > 0)
	(building-type-count town-center > 0)
	(building-type-count mining-camp > 0); gold camp first
	(building-type-count mining-camp < 16)
	(up-pending-objects c: mining-camp < 1) ;defer dropsite SN now in use
	(can-build mining-camp)
=>
	(set-strategic-number sn-allow-adjacent-dropsites 1) ;0
	(set-strategic-number sn-dropsite-separation-distance 7) ;8
	(build mining-camp)
)

	;TRUSH FIX
	(defrule
	(goal TRUSH yes)
	(goal is-town-under-attack no)
	(unit-type-count-total villager >= min-vills)
	(dropsite-min-distance stone s:< sn-mining-camp-max-distance)
	(building-type-count-total mining-camp < 1)
	(up-pending-objects c: mining-camp < 1) ;defer dropsite SN now in use
	(can-build mining-camp)
=>
	(build mining-camp)
); end jump (4)

	;keep track of lumber and mining camp max distances!

	;(1st pass) lumber-camp-max-distance
;(defrule
;	(strategic-number sn-lumber-camp-max-distance >= 14); minimum
;	(strategic-number current-lumber-distance s:!= sn-lumber-camp-max-distance)
;=>
	;(up-get-fact sn-lumber-camp-max-distance 0 current-lumber-distance)) ;UP-GET-FACT DOES NOT WORK WITH SN'S, only goals!

	;Track lumber distances
(defrule
	(strategic-number sn-lumber-camp-max-distance >= 14); minimum
	(strategic-number current-lumber-distance s:!= sn-lumber-camp-max-distance)
=>
	(up-modify-goal current-lumber-distance s:= sn-lumber-camp-max-distance))

	;mining-camp-max-distance
;(defrule
;	(strategic-number sn-mining-camp-max-distance >= 10); minimum
;	(up-compare-goal current-mining-distance s:!= sn-mining-camp-max-distance)
;=>
;	(up-get-fact sn-mining-camp-max-distance 0 current-mining-distance))

	;Track mining distances
(defrule
	(strategic-number sn-mining-camp-max-distance >= 10); minimum
	(up-compare-goal current-mining-distance s:!= sn-mining-camp-max-distance)
=>
	(up-modify-goal current-mining-distance s:= sn-mining-camp-max-distance))

	;GATHERING MICRO

	;force drop food when in need of villagers
	(defrule
(not	(town-under-attack))
	(goal feudal-pending no) ;not currently researching any ages
	(goal castle-pending no)
	(goal imperial-pending no)
	(building-type-count town-center > 0)
	(unit-type-count villager < high-res-vil-pop)
	;(research-completed ri-loom)
(or	(and	(up-pending-objects c: villager == 0) ;PANIK
			(food-amount < 50))
	(and	(up-pending-objects c: villager == 1) ;KALM
	(and	(food-amount < 50)
			(food-amount >= 25))))
	=>
	;(chat-local-to-self "Force dropping food for a villager.")
	(up-drop-resources 949 c: 5)
	(up-drop-resources 907 c: 5)
	(up-drop-resources 910 c: 10))

	;force drop food for feudal-age
	(defrule
	(current-age == dark-age)
	(goal feudal-pending no)
	(goal is-town-under-attack no)
	(research-completed ri-loom)
(or	(and	(goal FAST-CASTLE yes)
		(unit-type-count-total villager >= 27)) ;default fast-castle vills
	(and	(goal FAST-CASTLE no)
		(unit-type-count-total villager >= 21))) ;default flush vills
	(food-amount >= 450)
	(food-amount < 500)
=>
	;(chat-local-to-self "Force dropping food for next age.")
	(up-drop-resources 949 c: 5)
	(up-drop-resources 907 c: 5)
	(up-drop-resources 910 c: 10))

	;force drop food for castle-age
	(defrule
	(goal castle-pending no)
	(goal is-town-under-attack no)
	(current-age == feudal-age)
	(gold-amount >= 200)
	(food-amount >= 750)
	(food-amount < 800)
=>
	;(chat-local-to-self "Force dropping food for next age.")
	(up-drop-resources 949 c: 5)
	(up-drop-resources 907 c: 5)
	(up-drop-resources 910 c: 10))

	;force drop gold for castle-age
	(defrule
	(goal castle-pending no)
	(goal is-town-under-attack no)
	(current-age == feudal-age)
	(gold-amount >= 175)
	(gold-amount < 200)
	(food-amount >= 750) ;very close
=>
	;(chat-local-to-self "Force dropping gold for next age.")
	(up-drop-resources gold c: 5))

	;force drop food for imperial-age
	(defrule
	(goal imperial-pending no)
	(goal is-town-under-attack no)
	(current-age == castle-age)
	(gold-amount > 750)
	(food-amount >= 950)
	(food-amount < 1000)
=>
	(chat-local-to-self "Force dropping food for next age.")
	(up-drop-resources 949 c: 7)
	(up-drop-resources 907 c: 7)
	(up-drop-resources 910 c: 15))

	;force drop gold for imperial-age
	(defrule
	(goal imperial-pending no)
	(goal is-town-under-attack no)
	(current-age == castle-age)
	(food-amount > 950)
	(gold-amount >= 750)
	(gold-amount < 800)
=>
	;(chat-local-to-self "Force dropping gold for next age.")
	(up-drop-resources gold c: 7))

	;force drop wood for most buildings
(defrule
	(unit-type-count-total villager >= min-vills)
	(building-type-count town-center > 0)
	(wood-amount < 175) ;for important buildings
	(wood-amount >= 150)
	(dropsite-min-distance wood <= 7) ;don't force drop if far drop distances
=>
	;(chat-local-to-self "Force dropping wood for buildings.")
	(up-drop-resources wood c: 7)
)

	;force drop wood for town centers
(defrule
	(unit-type-count-total villager >= min-vills)
(or	(and	(unit-type-count villager >= 75)
	(and		(wood-amount < 275)
				(wood-amount >= 200)))
	(and	(unit-type-count villager < 75)
	(and		(wood-amount < 275)
				(wood-amount >= 230))))
	(dropsite-min-distance wood <= 7) ;don't force drop if far drop distances
=>
	;(chat-local-to-self "Force dropping wood for a town center.")
	(up-drop-resources wood c: 7)
)
	;force drop stone for castles
(defrule
	(unit-type-count-total villager >= min-vills)
	(building-type-count town-center > 0)
(or	(and	(not	(civ-selected frankish))
	(and			(stone-amount < 650) ;for non-frank castles
					(stone-amount >= 615)))
	(and	(civ-selected frankish)
	(and		(stone-amount < 488) ;for frank castles
				(stone-amount >= 450))))			
	(dropsite-min-distance stone <= 5) ;don't force drop if far drop distances
=>
	;(chat-local-to-self "Force dropping stone for a castle.")
	(up-drop-resources stone c: 6)
)

	;TESTING

	;task a villager to farms (DOESN'T WORK)
