	;NEW Extra Farm Mills
;Mill 2
(defrule
	(current-age-time > 60) ;any age (buffer)
	(building-type-count-total mill == 1)
	(building-type-count farm > 18)
(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7));ensures reliable wood supply
	(building-type-count town-center > 0)
	(can-build mill)
=>
	(set-strategic-number sn-allow-adjacent-dropsites 1) ;0
