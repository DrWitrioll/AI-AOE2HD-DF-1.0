;	(up-retask-gatherers food c: 1)) ;give extra reason to quit being a turd


;--------------------------------------------------start of main boar hunt rules----------------------------------------------------------------

;as of May 3 patch, up-remaining-boar-amount == 65535 DOESNT WORK ANYMORE

	;default initial hunting
	(defrule
	(true)
=>
	(set-strategic-number sn-enable-boar-hunting 0)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-strategic-number sn-minimum-boar-lure-group-size 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 0)
	(set-goal boar-hunt no);no is only used initially
	(disable-self)
)

	;simple boar hunting rules

	;capture boar (rule must be here to give one last chance of triggering another boar)
(defrule
	(goal boar-hunt capture)
	(timer-triggered boar-timer)
	(up-remaining-boar-amount < 340);currently eating a boar
;(and	(dropsite-min-distance live-boar s:< sn-maximum-hunt-drop-distance); theres another boar we are not eating
;(and	(dropsite-min-distance live-boar s:> 6);outside tc
;	(up-remaining-boar-amount == 65535)))); no longer works in DE
=>
	(chat-local-to-self "Boar captured.")
	(set-strategic-number sn-enable-boar-hunting 0);reset
	(set-strategic-number sn-minimum-boar-lure-group-size 0)
	(set-strategic-number sn-minimum-boar-hunt-group-size 0)
	(set-strategic-number sn-minimum-number-hunters 0)
	(set-goal boar-hunt no);restart process
	(disable-timer boar-timer)
)

	;NOMAD no (1st rule)
(defrule
	(goal NOMAD no)
	(goal boar-hunt no);initial goal
	(unit-type-count villager >= 8) ;on vil 8 now
(or	(up-remaining-boar-amount >= 340); just means NOT currently eating a boar
	(up-remaining-boar-amount < 120)); get another boar lol
	(dropsite-min-distance live-boar s:< sn-maximum-hunt-drop-distance)
	(dropsite-min-distance live-boar > 3);outside tc range
	(strategic-number sn-enable-boar-hunting != 2)
=>
	(chat-local-to-self "Hunting a boar.")
	(set-goal boar-hunt lure)
	(set-strategic-number sn-enable-boar-hunting 2)
	(set-strategic-number sn-minimum-boar-lure-group-size 1)
	(set-strategic-number sn-minimum-boar-hunt-group-size 1);none until boar is close
	(set-strategic-number sn-minimum-number-hunters 1)
	(up-request-hunters c: 1)
	(up-retask-gatherers villager-food c: 2)); get someone to do something!


(defrule
	(goal boar-hunt lure)
	(dropsite-min-distance live-boar <= 10);close enough
	(strategic-number sn-enable-boar-hunting == 2)
	(strategic-number sn-minimum-boar-hunt-group-size <= 7) ;min 7
=>
	(chat-local-to-self "Adding boar hunters.")
	(up-modify-sn sn-minimum-boar-hunt-group-size c:= 7)
	(up-modify-sn sn-minimum-number-hunters c:= 7)
	(up-request-hunters c:= 7)
	(up-retask-gatherers villager-food c: 7)
	(set-goal boar-hunt capture)
	(enable-timer boar-timer 12))

(defrule
	(up-compare-goal boar-hunt != nomad-hunt)
	(up-compare-goal boar-hunt != deer-hunt)
	(game-time > 180)
	(unit-type-count villager > 10)
	;(up-remaining-boar-amount == 65535) ;testing without
	(building-type-count-total farm > 1)
(not	(dropsite-min-distance live-boar s:< sn-maximum-hunt-drop-distance))
	;(up-gaia-type-count c: live-boar < 1))
	(strategic-number sn-enable-boar-hunting != 1)
=>
	(set-goal boar-hunt deer-hunt)
)

(defrule
	(goal boar-hunt deer-hunt)
	(strategic-number sn-enable-boar-hunting != 1)
=>
	;(chat-local-to-self "Disabling hunting restrictions.")
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-boar-lure-group-size 1)
	(set-strategic-number sn-minimum-boar-hunt-group-size 4)
	(set-strategic-number sn-minimum-number-hunters 3));for deer

	;FORCE no hunting restrictions after 15 minutes

(defrule
	(game-time > 600)
	(up-compare-goal boar-hunt != deer-hunt)
=>
	;(chat-local-to-self "Force disabling hunting restrictions.")
	(set-goal boar-hunt deer-hunt))

	;NOMAD yes
(defrule
	(goal NOMAD yes)
	(goal boar-hunt no)
	(game-time > 300) ;minimum time to consider hunting & gathering sheep
	(building-type-count town-center > 0)
(or	(sheep-and-forage-too-far)
(or	(and	(up-object-type-count c: livestock-class <= 1) ;last sheep or none remaining
	(or		(building-type-count lumber-camp > 0); gives some time to find and prioritze sheep before hunting
			(building-type-count-total mule-cart > 0)))
	(current-age-time >= 540))) ;safety after 9 minutes
=>
	;(chat-local-to-self "Enabling Nomad hunting tactics.")
	(set-goal boar-hunt nomad-hunt)
	(disable-self)
)

(defrule
	(goal NOMAD yes)
	(goal boar-hunt nomad-hunt)
(or	(strategic-number sn-enable-boar-hunting != 1)
(or	(strategic-number sn-minimum-boar-lure-group-size != 1)
	(strategic-number sn-minimum-boar-hunt-group-size != 4)))
=>
	(set-strategic-number sn-enable-boar-hunting 1)
	(set-strategic-number sn-minimum-number-hunters 4);5
	(set-strategic-number sn-minimum-boar-lure-group-size 1)
	(set-strategic-number sn-minimum-boar-hunt-group-size 4)
);don't disable

;--------------------------------------------------end of main boar hunt rules----------------------------------------------------------------

	;TOO MANY BOAR HUNTERS!!!
(defrule
	(strategic-number sn-enable-boar-hunting == 2)
	(unit-type-count villager-hunter >= 10)
=>
	;(chat-local-to-self "Retasking boar hunters.")
	(up-retask-gatherers 910 c: 2))

