;	(up-retask-gatherers 907 c: 3))

	;retask more villagers to wood (too many on food!) (DOESN'T WORK EITHER)
;(defrule
;	(unit-type-count villager <= 20);baseline
;	(unit-type-count villager < max-vill-pop); don't interfere with low pop games
