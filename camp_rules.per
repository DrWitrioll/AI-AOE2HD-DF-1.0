;chat size numbers
(defrule
	(timer-triggered camp-size-timer)
=>
	(up-chat-data-to-player my-player-number "Town-size: %d." s: sn-maximum-town-size)
	(up-chat-data-to-player my-player-number "Lumber-camp distance: %d." s: sn-lumber-camp-max-distance)
	(up-chat-data-to-player my-player-number "Mining-camp distance: %d." s: sn-mining-camp-max-distance)
	(up-delete-distant-farms c: 12); occasional farm delete check
)

;disable camp-size-timer
(defrule
	(timer-triggered camp-size-timer)
=>
	(disable-timer camp-size-timer)
	(enable-timer camp-size-timer 360) ;every 6 minutes
)

