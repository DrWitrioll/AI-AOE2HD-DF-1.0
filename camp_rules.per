
	;Camp rules (like economy buildings and sn's) for Jester.per

;AOE2HD REQUIRES SN-CAMP-DISTANCE RULE.  (HAS BEEN REMOVED).
;AOE2DE REQUIRES SN-MINING-CAMP-DISTANCE, AND SN-LUMBER-CAMP-DISTANCE. (CURRENTLY SET TO THIS).

	;custom goals (default starting numbers)
(defrule
	(true)
=>
	(set-goal gold-mine-distance 0)
	(set-goal stone-mine-distance 0)
	(set-goal deer-luring no);default
	(set-goal town-size-ready no) ; yes or no, no = default to start
	(disable-self)
)

	;camp-timer
(defrule
	(goal town-size-ready yes) ;default start
(or	(building-type-count lumber-camp > 0)
(or	(building-type-count mining-camp > 0)
		(building-type-count-total mule-cart > 0))) ;Armenian & Georgian camp
=>
	(enable-timer camp-size-timer 120) ;quicker than normal for safety only for start
	(disable-self))

	;town-size rules

	;default
(defrule
	(true)
=>
	(set-strategic-number sn-maximum-town-size 8)
	(set-strategic-number sn-safe-town-size 8)
	(disable-self))

	;these next two rules define when town-size rules can activate or disable, yes = enable, no = wait (or disable)
	;town-size ready yes
(defrule
	(goal town-size-ready no)
	(game-time > 30) ;buffer ;current-age-time
	(building-type-count town-center > 0)
	(goal is-town-under-attack no)
(not	(town-under-attack))
=>
	(set-goal town-size-ready yes))

	;town-size ready no
(defrule
	(goal town-size-ready yes)
(or	(game-time <= 30) ;buffer ;current-age-time
(or	(building-type-count town-center <= 0)
(or	(goal is-town-under-attack yes)
	(town-under-attack))))
=>
	(set-goal town-size-ready no))


;enable town-size-timer
;(defrule
;(or	(and	(goal NOMAD yes)
;		(game-time > 240))
;	(game-time > 300)) ;60
;	(building-type-count town-center > 0)
;=>
;	(enable-timer town-size-timer 120)
;	(chat-local-to-self "Starting town-size timer")
;	(disable-self)
;)

;expand town size (default)
;(defrule
;	(timer-triggered town-size-timer)
;	(building-type-count town-center > 0)
;	(strategic-number sn-maximum-town-size > 0)
;	(strategic-number sn-maximum-town-size <= 60)
;=>
;	(up-modify-sn sn-maximum-town-size c:+ 2)
;	(up-modify-sn sn-safe-town-size s:= sn-maximum-town-size)
;)

	;minimum town-size's depending on ages
;DARK
	(defrule
	(current-age <= dark-age)
	(current-age-time > 60)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size < 8)
=>
	;(chat-local-to-self "Town-size 8.")
	(set-strategic-number sn-maximum-town-size 8)
	(set-strategic-number sn-safe-town-size 8)
	(disable-self)) ;happens once

;FEUDAL
	(defrule
	(current-age == feudal-age)
	(current-age-time > 60)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size < 12)
=>
	;(chat-local-to-self "Town-size 12.")
	(set-strategic-number sn-maximum-town-size 12)
	(set-strategic-number sn-safe-town-size 12)
	(disable-self)) ;happens once

;CASTLE
	(defrule
	(current-age == castle-age)
	(current-age-time > 60)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size < 14)
=>
	;(chat-local-to-self "Town-size 16.")
	(set-strategic-number sn-maximum-town-size 14)
	(set-strategic-number sn-safe-town-size 14)
	(disable-self))

;IMPERIAL
	(defrule
	(current-age >= imperial-age)
	(current-age-time > 60)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size < 16)
=>
	;(chat-local-to-self "Town-size 20.")
	(set-strategic-number sn-maximum-town-size 16)
	(set-strategic-number sn-safe-town-size 16)
	(disable-self))


;expand town-size for tc (any-age) (nomad or not nomad)
(defrule
	(building-type-count-total town-center == 0)
	(up-pending-objects c: town-center-foundation <= 0)
	(strategic-number sn-maximum-town-size < 100) ;100
	(can-build town-center); should release escrow in other rules
=>
;	(chat-local-to-self "Expanding town-size for new town-center.")
	(up-modify-sn sn-maximum-town-size c:= 100)
)

;reset town-size for tc (dark-age)
(defrule
	(current-age == dark-age)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size >= 100)
	;(up-pending-objects c: town-center-foundation > 0)
=>
;	(chat-local-to-self "Town-size 8.")
	(up-modify-sn sn-maximum-town-size c:= 12) ;default size
	(up-modify-sn sn-safe-town-size s:= sn-maximum-town-size)
)

;reset town-size for tc (feudal-age)
(defrule
	(current-age == feudal-age)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size >= 100)
	;(up-pending-objects c: town-center-foundation > 0)
=>
;	(chat-local-to-self "Town-size 12.")
	(up-modify-sn sn-maximum-town-size c:= 12)
	(up-modify-sn sn-safe-town-size s:= sn-maximum-town-size)
)

;reset town-size for tc (castle-age)
(defrule
	(current-age == castle-age)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size >= 100)
	;(up-pending-objects c: town-center-foundation > 0)
=>
;	(chat-local-to-self "Town-size 16.")
	(up-modify-sn sn-maximum-town-size c:= 14)
	(up-modify-sn sn-safe-town-size s:= sn-maximum-town-size)
)

;reset town-size for tc (imperial-age)
(defrule
	(current-age >= imperial-age)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size >= 100)
	;(up-pending-objects c: town-center-foundation > 0)
=>
;	(chat-local-to-self "Town-size 20.")
	(up-modify-sn sn-maximum-town-size c:= 16)
	(up-modify-sn sn-safe-town-size s:= sn-maximum-town-size)
)

;====================NEW dynamic town-size rules===================

	;slow town size increase (supplemental)
(defrule
	;(goal is-town-under-attack no)
	(timer-triggered camp-size-timer)
	(building-type-count town-center > 0)
	(strategic-number sn-maximum-town-size < 34) ;only supplement this up to 34
=>
	(up-modify-sn sn-maximum-town-size c:+ 1))

	;medium town size increase (supplemental) ;was increasing town-size too fast while the above rule was enabled too (obviously, especially after disabling goal is-town-under-attack condition)
;(defrule
	;(goal is-town-under-attack yes)
;	(timer-triggered camp-size-timer)
;	(building-type-count town-center > 0)
;	(strategic-number sn-maximum-town-size < 30) ;only supplement this up to 30
;=>
;	(up-modify-sn sn-maximum-town-size c:+ 2))

	;slow town size decrease (supplemental)
(defrule
	(timer-triggered camp-size-timer)
	(strategic-number sn-maximum-town-size > 36) ;this slightly helps in balancing a healthy town size
	(strategic-number sn-maximum-town-size < 50)
=>
	(up-modify-sn sn-maximum-town-size c:- 2))

	;medium town size decrease (supplemental)
(defrule
	(timer-triggered camp-size-timer)
	(strategic-number sn-maximum-town-size > 50) ;this helps in balancing a healthy town size
	(strategic-number sn-maximum-town-size < 100)
=>
	(up-modify-sn sn-maximum-town-size c:- 4)) ;slowly decrease so that this doesn't out-do possibly needed town-size increases.

	;safe-town-size
(defrule
	(game-time > 60)
	(building-type-count town-center > 0)
	(strategic-number sn-safe-town-size s:!= sn-maximum-town-size)
=>
	(up-modify-sn sn-safe-town-size s:= sn-maximum-town-size)
	(up-modify-sn sn-safe-town-size c:- 2) ;town-size -2
)

	;enable town-size goal
(defrule
	(goal town-size-ready yes) ;prevents these rules in certain situations
	(up-compare-goal town-size-goal != 1)
(or	(and	(up-pending-placement c: town-center)
		(up-pending-objects c: town-center-foundation < 1))
(or	(and	(up-pending-placement c: farm) ;farms prevent needed expansion sometimes
		(up-pending-objects c: farm < 1))
(or	(and	(up-pending-placement c: house)
		(up-pending-objects c: house < 1))
(or	(and	(up-pending-placement c: barracks)
		(up-pending-objects c: barracks < 1))
(or	(and	(up-pending-placement c: archery-range)
		(up-pending-objects c: archery-range < 1))
	(and	(up-pending-placement c: stable)
		(up-pending-objects c: stable < 1)))))))
	(strategic-number sn-maximum-town-size < 100) ;max
=>
	;(chat-local-to-self "Enabling town size goal.")
	(set-goal town-size-goal 1)
	(enable-timer town-size-timer 5)) ;7

	;enable town-size goal
(defrule
	(goal town-size-ready yes)
	(up-compare-goal town-size-goal != 1)
(or	(and	(up-pending-placement c: blacksmith)
		(up-pending-objects c: blacksmith < 1))
(or	(and	(up-pending-placement c: market)
		(up-pending-objects c: market < 1))
(or	(and	(up-pending-placement c: siege-workshop)
		(up-pending-objects c: siege-workshop < 1))
(or	(and	(up-pending-placement c: castle)
		(up-pending-objects c: castle < 1))
(or	(and	(up-pending-placement c: wonder)
		(up-pending-objects c: wonder < 1))
	(and	(up-pending-placement c: feitoria)
		(up-pending-objects c: feitoria < 1)))))))
	(strategic-number sn-maximum-town-size < 100) ;max
=>
	;(chat-local-to-self "Enabling town size goal.")
	(set-goal town-size-goal 1)
	(enable-timer town-size-timer 5)) ;7

	;enable town-size goal (NEW)
(defrule
	(goal town-size-ready yes)
	(up-compare-goal town-size-goal != 1)
(or	(and	(up-pending-placement c: monastery)
		(up-pending-objects c: monastery < 1))
(or	(and	(up-pending-placement c: university)
		(up-pending-objects c: university < 1))
(or	(and	(up-pending-placement c: watch-tower-line) ;added
		(up-pending-objects c: watch-tower-line < 1))
(or	(and	(up-pending-placement c: krepost) ;added
		(up-pending-objects c: krepost < 1))
	(and	(up-pending-placement c: bombard-tower) ;added
		(up-pending-objects c: bombard-tower < 1))))))
=>
	;(chat-local-to-self "Enabling town size goal.")
	(set-goal town-size-goal 1)
	(enable-timer town-size-timer 5)) ;7

	;hold town-size
(defrule
	(goal town-size-goal 1)
(or	(up-pending-objects c: town-center-foundation > 0)
(or	(up-pending-objects c: farm > 0)
(or	(up-pending-objects c: house > 0)
(or	(up-pending-objects c: barracks > 0)
(or	(up-pending-objects c: archery-range > 0)
(or	(up-pending-objects c: stable > 0)
(or	(up-pending-objects c: watch-tower-line > 0)
(or	(up-pending-objects c: bombard-tower > 0)
(or	(up-pending-objects c: monastery > 0) ;added
(or (up-pending-objects c: university > 0) ;added
(or (up-pending-objects c: wonder > 0) ;added
	(up-pending-objects c: krepost > 0)))))))))))) ;added
=>
	(set-goal town-size-goal 0)
	(disable-timer town-size-timer))
	;(chat-local-to-self "Disabling town size goal.")

	;hold town-size
(defrule
	(goal town-size-goal 1)
(or	(up-pending-objects c: blacksmith > 0)
(or	(up-pending-objects c: market > 0)
(or	(up-pending-objects c: siege-workshop > 0)
(or	(up-pending-objects c: castle > 0)
;(or	(up-pending-objects c: dock > 0)
	(up-pending-objects c: feitoria > 0)))));)
=>
	(set-goal town-size-goal 0)
	(disable-timer town-size-timer))
	;(chat-local-to-self "Disabling town size goal.")

	;increase town-size
(defrule
	(goal town-size-ready yes)
	(goal town-size-goal 1)
	(timer-triggered town-size-timer)
(or	(and	(up-pending-placement c: town-center)
		(up-pending-objects c: town-center-foundation < 1))
(or	(and	(up-pending-placement c: farm)
		(up-pending-objects c: farm < 1))
(or	(and	(up-pending-placement c: house)
		(up-pending-objects c: house < 1))
(or	(and	(up-pending-placement c: barracks)
		(up-pending-objects c: barracks < 1))
(or	(and	(up-pending-placement c: archery-range)
		(up-pending-objects c: archery-range < 1))
	(and	(up-pending-placement c: stable)
		(up-pending-objects c: stable < 1)))))))
	(strategic-number sn-maximum-town-size < 100) ;max
=>
	(up-modify-sn sn-maximum-town-size c:+ 2)) ;1
	;(chat-local-to-self "Increasing town size.")

	;increase town-size
(defrule
	(goal town-size-ready yes)
	(goal town-size-goal 1)
	(timer-triggered town-size-timer)
(or	(and	(up-pending-placement c: blacksmith)
		(up-pending-objects c: blacksmith < 1))
(or	(and	(up-pending-placement c: market)
		(up-pending-objects c: market < 1))
(or	(and	(up-pending-placement c: siege-workshop)
		(up-pending-objects c: siege-workshop < 1))
(or	(and	(up-pending-placement c: castle)
		(up-pending-objects c: castle < 1))
	(and	(up-pending-placement c: feitoria)
		(up-pending-objects c: feitoria < 1))))))
	(strategic-number sn-maximum-town-size < 100) ;max
=>
	(up-modify-sn sn-maximum-town-size c:+ 2)) ;1
	;(chat-local-to-self "Increasing town size.")

	;increase town-size (NEWLY ADDED)
(defrule
	(goal town-size-ready yes)
	(goal town-size-goal 1)
	(timer-triggered town-size-timer)
(or	(and	(up-pending-placement c: monastery)
		(up-pending-objects c: monastery < 1))
(or	(and	(up-pending-placement c: university)
		(up-pending-objects c: university < 1))
(or	(and	(up-pending-placement c: watch-tower-line)
		(up-pending-objects c: watch-tower-line < 1))
(or	(and	(up-pending-placement c: bombard-tower)
		(up-pending-objects c: bombard-tower < 1))
(or	(and	(up-pending-placement c: wonder)
		(up-pending-objects c: wonder < 1))
	(and	(up-pending-placement c: krepost)
		(up-pending-objects c: krepost < 1)))))))
	(strategic-number sn-maximum-town-size < 100) ;max
=>
	(up-modify-sn sn-maximum-town-size c:+ 2)) ;1
	;(chat-local-to-self "Increasing town size.")

	;OVERRIDE TOWN SIZE FOR TOWN CENTERS
(defrule
	(timer-triggered town-size-timer) ;prevent excessive town-sizes
	(game-time > 60) ;nomad games
	(goal is-town-under-attack no)
(not	(town-under-attack))
	(unit-type-count-total villager >= 7)
	(up-pending-placement c: town-center)
	(up-pending-objects c: town-center < 1)
	(can-build town-center)
=>
	(up-modify-sn sn-maximum-town-size c:+ 3)
	;(chat-to-all "Expanding town size for town-centers.")
)

	;OVERRIDE TOWN SIZE FOR HOUSES
(defrule
	(timer-triggered town-size-timer)	;prevent excessive town-sizes
	(game-time > 60) ;nomad games
	(goal is-town-under-attack no)
(not	(civ-selected hun))
(not	(town-under-attack))
	(unit-type-count-total villager >= 7)
	(housing-headroom <= 0) ;totally housed!
	(population-headroom >= 2) ;still more potential population
	(up-pending-placement c: house)
	(up-pending-objects c: house < 1)
	(can-build house)
=>
	(up-modify-sn sn-maximum-town-size c:+ 2)
	;(chat-to-all "Expanding town size for houses.")
)

	;CUSTOM SN-SAFE-BORDER-DISTANCE		;custom sn that relates to up-building-placement & DUC rules
(defrule
	(game-time > 30) ;safety
	(up-compare-sn sn-safe-border-distance s:!= sn-maximum-town-size)
=>
	(up-modify-sn sn-safe-border-distance s:= sn-maximum-town-size)		;set to safe-border to current max-town-size
)
	;CALCULATION
(defrule
	(up-compare-sn sn-safe-border-distance >= 10)	;between min & max
	(up-compare-sn sn-safe-border-distance <= 35)
=>
	(up-modify-sn sn-safe-border-distance c:+ 5)
)

	;MINIMUM SN-SAFE-BORDER-DISTANCE
(defrule
	(game-time > 30) ;safety
	(up-compare-sn sn-safe-border-distance < 15)
=>
	(up-modify-sn sn-safe-border-distance c:= 15)		;minimum distance
)
	;MAXIMUM SN-SAFE-BORDER-DISTANCE
(defrule
	(game-time > 30) ;safety
	(up-compare-sn sn-safe-border-distance > 40)
=>
	(up-modify-sn sn-safe-border-distance c:= 40)		;maximum distance
)

	;continue looping until done
(defrule
	(timer-triggered town-size-timer)
=>
	(disable-timer town-size-timer)
	(enable-timer town-size-timer 7)) ;8

;======================lumber-camp distances======================

;expand lumber camp size 1
(defrule
	(timer-triggered camp-size-timer)
	;(building-type-count lumber-camp > 0)
	(strategic-number sn-lumber-camp-max-distance <= 22)
	(strategic-number sn-lumber-camp-max-distance c:< map-size)
=>
	(up-modify-sn sn-lumber-camp-max-distance c:+ 3);3
)

;expand lumber camp size 2
(defrule
	(timer-triggered camp-size-timer)
	;(building-type-count lumber-camp > 0)
	(strategic-number sn-lumber-camp-max-distance > 22)
	(strategic-number sn-lumber-camp-max-distance c:< map-size)
=>
	(up-modify-sn sn-lumber-camp-max-distance c:+ 4);4
)

;======================mining-camp distances======================

;expand mining camp 1
(defrule
	(timer-triggered camp-size-timer)
	;(building-type-count mining-camp > 0); starts after first one is built
	(strategic-number sn-mining-camp-max-distance <= 22)
	(strategic-number sn-mining-camp-max-distance c:< map-size)
=>
	(up-modify-sn sn-mining-camp-max-distance c:+ 3)
)

;expand mining camp 2
(defrule
	(timer-triggered camp-size-timer)
	;(building-type-count mining-camp > 0)
	(strategic-number sn-mining-camp-max-distance > 22)
	(strategic-number sn-mining-camp-max-distance <= 60)
	(strategic-number sn-mining-camp-max-distance c:< map-size)
=>
	(up-modify-sn sn-mining-camp-max-distance c:+ 5)
)

;expand mining camp 3 (fast)
(defrule
	(timer-triggered camp-size-timer)
	;(building-type-count mining-camp > 0)
	(strategic-number sn-mining-camp-max-distance > 60)
	(strategic-number sn-mining-camp-max-distance c:< map-size)
=>
	(up-modify-sn sn-mining-camp-max-distance c:+ 7)
)

;DECREASE HUNT-DROP-DISTANCE
(defrule
(game-time > 1500) ;25 minutes
=>
(up-modify-sn sn-maximum-hunt-drop-distance c:= 18) ;default now 25. (25 - 7 = 18)
(disable-self)
)

;===================MULE-CART RESOURCE DISTANCES===================
;normal (goal NOMAD no)
(defrule
	(goal NOMAD no)
	(resource-found wood)
	(building-type-count-total mule-cart < 1)
	(building-available mule-cart)
	(dropsite-min-distance wood <= 10); currently counts straggler trees too >:(
	(unit-type-count-total villager > 6);gives some time to explore map
	(strategic-number sn-lumber-camp-max-distance < 15)
=>
   (set-strategic-number sn-lumber-camp-max-distance 15) ;12 testing 
;   (chat-local-to-self "lumber-camp distance 15.")
   (disable-self)
)

(defrule
	(goal NOMAD no)
	(resource-found wood)
	(building-type-count-total mule-cart < 1)
	(building-available mule-cart)
	(dropsite-min-distance wood >= 10)
	(dropsite-min-distance wood < 13)
	(unit-type-count-total villager > 6)
	(strategic-number sn-lumber-camp-max-distance < 16)
=>
   (set-strategic-number sn-lumber-camp-max-distance 16) ;14
;   (chat-local-to-self "lumber-camp distance 16.")
   (disable-self)
)

(defrule
	(goal NOMAD no)
	(resource-found wood)
	(building-type-count-total mule-cart < 1)
	(building-available mule-cart)
	(dropsite-min-distance wood >= 13)
	(dropsite-min-distance wood < 15)
	(unit-type-count-total villager > 6)
	(strategic-number sn-lumber-camp-max-distance < 18)
=>
   (set-strategic-number sn-lumber-camp-max-distance 18) ;15
;   (chat-local-to-self "lumber-camp distance 18.")
   (disable-self)
)

(defrule
	(goal NOMAD no)
	(resource-found wood)
	(building-type-count-total mule-cart < 1)
	(building-available mule-cart)
	(dropsite-min-distance wood >= 15)
	(dropsite-min-distance wood < 17)
	(unit-type-count-total villager > 6)
	(strategic-number sn-lumber-camp-max-distance < 20)
=>
   (set-strategic-number sn-lumber-camp-max-distance 20);17
 ;  (chat-local-to-self "lumber-camp distance 20.")
   (disable-self)
)

(defrule
	(goal NOMAD no)
   (resource-found wood)
	(building-type-count-total mule-cart < 1)
	(building-available mule-cart)
   (dropsite-min-distance wood >= 17)
   (dropsite-min-distance wood < 20)
   (unit-type-count-total villager > 6)
	(strategic-number sn-lumber-camp-max-distance < 22)
=>
   (set-strategic-number sn-lumber-camp-max-distance 22);20
;   (chat-local-to-self "lumber-camp distance 22.")
   (disable-self)
)

(defrule
	(goal NOMAD no)
   (resource-found wood)
	(building-type-count-total mule-cart < 1)
	(building-available mule-cart)
   (dropsite-min-distance wood >= 20)
   (dropsite-min-distance wood < 22)
   (unit-type-count-total villager > 6)
	(strategic-number sn-lumber-camp-max-distance < 24)
=>
   (set-strategic-number sn-lumber-camp-max-distance 24);22
;   (chat-local-to-self "lumber-camp distance 24.")
   (disable-self)
)

(defrule
	(goal NOMAD no)
   (resource-found wood)
	(building-type-count-total mule-cart < 1)
	(building-available mule-cart)
   (dropsite-min-distance wood >= 22)
   (unit-type-count-total villager > 6)
	(strategic-number sn-lumber-camp-max-distance < 30)
