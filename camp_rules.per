	(strategic-number sn-stone-gatherer-percentage > 0);indicates need
	(up-pending-objects c: mining-camp < 1)
	(can-build mining-camp)
=>
;	(chat-local-to-self "Increasing camp-distances to cover stone distance.")
	(up-modify-sn sn-mining-camp-max-distance c:+ 2)
)

;====================LUMBER CAMP RULES====================

	;1ST LUMBERCAMP (goal gurjara-civ no)
(defrule
(or	(civ-selected hun)
	(building-type-count-total house > 0))
	(building-type-count town-center > 0)
	(goal gurjara-civ no) ;GURJARA BUILDS MILL FIRST NOW FOR SHEEP
	;(building-type-count mill > 0) lumber camp first before mill
	(resource-found wood)
	(up-gaia-type-count c: wood > 50) ;less chance of missing a forest
	(unit-type-count villager > 6) ; villager 7 builds a lumber-camp.
	(building-type-count-total lumber-camp < 1)
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
;	(chat-local-to-self "First normal lumber-camp.")
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 5) ;6
	(build lumber-camp)
)

	;1ST LUMBERCAMP (goal gurjara-civ yes)
(defrule
	(goal gurjara-civ yes) ;GURJARA BUILDS MILL FIRST NOW FOR SHEEP
	(building-type-count-total house >= 2)
	(building-type-count town-center > 0)
	(building-type-count-total mill > 0) ;MILL 1ST for gurjara
	;(building-type-count mill > 0) lumber camp first before mill
	(resource-found wood)
	(up-gaia-type-count c: wood > 50) ;less chance of missing a forest
	(unit-type-count villager >= 10) ; villager 10 builds a lumber-camp.
	(building-type-count-total lumber-camp < 1)
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
;	(chat-local-to-self "First normal lumber-camp.")
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 5) ;6
	(build lumber-camp)
)

	;BACKUP 1ST LUMBERCAMP
(defrule
	(current-age-time > 420) ;backup
(or	(civ-selected hun)
	(building-type-count-total house > 0))
	(building-type-count town-center > 0)
	;(building-type-count mill > 0) lumber camp first before mill
	;(resource-found wood)
	;(up-gaia-type-count c: wood <= 60) ;low wood?
	(unit-type-count villager >= 18)
	(building-type-count-total lumber-camp < 1)
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
;	(chat-local-to-self "Emergency 1st low-wood lumber camp.")
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 1)
	(build lumber-camp)
)

	;DESPERATE 1ST lumber-camp
(defrule
	(game-time > 360)
	(up-gaia-type-count c: wood > 50)
(or   (unit-type-count villager >= 15) ;17
	(unit-type-count villager >= max-vill-pop))
   (building-type-count-total lumber-camp == 0)
   (strategic-number sn-lumber-camp-max-distance < 35)
   (can-build lumber-camp)
=>
   (set-strategic-number sn-lumber-camp-max-distance 35)
 ;  (chat-local-to-self "lumber-camp distance 35.")
   (disable-self)
)
	;Extra desperate 1ST lumber-camp
(defrule
	(game-time > 500)
	(up-gaia-type-count c: wood > 50)
(or   (unit-type-count villager >= 17) ;19
	(unit-type-count villager >= max-vill-pop))
   (strategic-number sn-lumber-camp-max-distance < 45)
   (dropsite-min-distance wood < 45)
   (building-type-count-total lumber-camp == 0)
   (can-build lumber-camp)
=>
   (set-strategic-number sn-lumber-camp-max-distance 45)
;   (chat-local-to-self "lumber-camp distance 45.")
   (disable-self))

	;EMERGENCY LUMBER-CAMP
(defrule
	(goal is-town-under-attack yes)
	(unit-type-count villager > min-vills) ;20
	(building-type-count town-center > 0)
	(building-type-count-total lumber-camp < 3)
	(up-pending-objects c: lumber-camp < 1)
	(can-build lumber-camp)
=>
	(chat-local-to-self "Building emergency lumber-camp.")
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 20) ;NEW ;this forces a camp far away from others
	(build lumber-camp)
)
	;2nd lumber-camp
(defrule
	(goal WOOD-REMAINING yes)
	(up-gaia-type-count c: wood > 30)
(or			(goal DRUSH no)
	(and	(goal DRUSH yes)
		(building-type-count-total barracks > 0)));barracks first for DRUSH yes
	(building-type-count lumber-camp == 1)
	(unit-type-count villager > min-vills) ;10
	(dropsite-min-distance wood >= 3) ;2 ;delay it a little longer for other buildings
	(dropsite-min-distance wood s:< sn-lumber-camp-max-distance)
	(dropsite-min-distance wood c:< map-size)
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
	;(chat-local-to-self "Second lumber-camp.")
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 11) ;6 ;go 11 to encourage building on another woodline
	(build lumber-camp)
	(disable-self)
)
	;MAIN LUMBER-CAMP RULE
(defrule
	(goal WOOD-REMAINING yes) ;yes = there are at least 15 trees still on the map, no = less-than 15 tree remain on the map
	(unit-type-count villager > 6)
	(dropsite-min-distance wood >= 4) ;>= 5 ;trying 4 for more LC's throughout the game
	(dropsite-min-distance wood s:< sn-lumber-camp-max-distance)
	(dropsite-min-distance wood c:< map-size)
	(building-type-count town-center > 0)
	(building-type-count lumber-camp > 0)
	(building-type-count lumber-camp < 33); testing
	(up-pending-objects c: lumber-camp < 1) ;defer dropsite SN now in use
	(can-build lumber-camp)
=>
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 6)
	(build lumber-camp)
);end jump; 32 total

	;MULE-CARTS

	;MULE-CART LOGIC ;UPDATED
	;WOOD
(defrule
(or	(building-type-count mule-cart <= 1)
    (building-type-count mule-cart == 3))
=>
    (set-strategic-number sn-mule-cart-dropsite-placement lumber-camp)
)
	;GOLD/STONE
(defrule
(or	(building-type-count mule-cart == 2)
    (building-type-count mule-cart == 4))
=>
    (set-strategic-number sn-mule-cart-dropsite-placement mining-camp)
)
	;GOLD/STONE
(defrule
(or	(building-type-count mule-cart == 5)
    (building-type-count mule-cart == 7))
=>
    (set-strategic-number sn-mule-cart-dropsite-placement mining-camp)
)
	;WOOD
(defrule
(or	(building-type-count mule-cart == 6)
    (building-type-count mule-cart == 8))
=>
    (set-strategic-number sn-mule-cart-dropsite-placement lumber-camp)
)
	;GOLD/STONE
(defrule
(or	(building-type-count mule-cart == 9)
    (building-type-count mule-cart == 10))
=>
    (set-strategic-number sn-mule-cart-dropsite-placement lumber-camp)
)
	;DEFAULT
(defrule
    (building-type-count mule-cart > 10)
=>
    (set-strategic-number sn-mule-cart-dropsite-placement 0) ;default = any resource
)
;LEVEL 1 ;1 wood
(defrule
;(or (goal armenian-civ yes) ;explanatory not needed
;	(goal georgian-civ yes))
	(resource-found wood) ;1st mule-cart is for wood
	(up-gaia-type-count c: wood > 50) ;less chance of missing a forest
	(unit-type-count villager >= 7) ;7th vil builds a lumber-camp or mule-cart
	(building-type-count-total house > 0)
	(building-type-count town-center > 0)
	(building-available mule-cart)
	(building-type-count-total mule-cart < 1)
	(up-pending-objects c: mule-cart < 1) ;needed for sn-defer-dropsite-placement == 1
	(can-build mule-cart)
=>
    (set-strategic-number sn-mule-cart-dropsite-placement lumber-camp)
	(build mule-cart)
)

;LEVEL 2
(defrule
(or	(unit-type-count villager >= min-vills)
(or	(strategic-number sn-gold-gatherer-percentage > 0); we want gold
(or	(strategic-number sn-stone-gatherer-percentage > 0); we want stone
	(unit-type-count villager-wood >= 10)))); speed up 2nd dropsite for wood
	(building-available mule-cart)
	(building-type-count-total mule-cart == 1) ;we have 1, need 2
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
    (set-strategic-number sn-mule-cart-dropsite-placement mining-camp) ;not needed as its defined above but safety for first few carts
	(build mule-cart)
)

;LEVEL 3
(defrule
(or	(unit-type-count-total villager >= max-vill-pop) ;safety for low-pop games
	(unit-type-count villager >= 25))
	(building-available mule-cart)
	(building-type-count-total mule-cart == 2) ;need 3rd (2nd woodline)
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
    (set-strategic-number sn-mule-cart-dropsite-placement lumber-camp)
	(build mule-cart)
)

;LEVEL 4
(defrule
(or	(unit-type-count-total villager >= max-vill-pop) ;safety for low-pop games
	(unit-type-count villager >= 40))
	(building-available mule-cart)
	(building-type-count-total mule-cart == 3) ;need 4th (2nd gold or stone)
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
    (set-strategic-number sn-mule-cart-dropsite-placement mining-camp)
	(build mule-cart)
)

;LEVEL 5
(defrule
(or	(unit-type-count-total villager >= max-vill-pop) ;safety for low-pop games
	(unit-type-count villager >= 60))
	(building-available mule-cart)
	(building-type-count-total mule-cart == 4) ;5th
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(build mule-cart)
)

;LEVEL 6
(defrule
	(population-cap >= 100)
(or	(unit-type-count-total villager >= max-vill-pop) ;safety for low-pop games
	(unit-type-count villager >= 75))
	(building-available mule-cart)
	(building-type-count-total mule-cart == 5) ;6th
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(build mule-cart)
)

;LEVEL 7
(defrule
	(population-cap >= 125)
(or	(unit-type-count-total villager >= max-vill-pop) ;safety for low-pop games
	(unit-type-count villager >= 100))
	(building-available mule-cart)
	(building-type-count-total mule-cart == 6) ;7th
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(build mule-cart)
)

;LEVEL 8
(defrule
	(population-cap >= 150)
(or	(unit-type-count-total villager >= max-vill-pop) ;safety for low-pop games
	(unit-type-count villager >= 115))
	(building-available mule-cart)
	(building-type-count-total mule-cart == 7) ;8th
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(build mule-cart)
)

;LEVEL 9
(defrule
	(population-cap >= 175)
	(unit-type-count villager >= max-vill-pop)
	(building-available mule-cart)
	(building-type-count-total mule-cart == 8) ;max now for testing
	(building-type-count town-center > 0)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
	(build mule-cart)
)

;emergency mule cart (wood)
(defrule
	(game-time > 20)
    (resource-found wood)
	(wood-amount < 275)
(not	(can-build town-center))
	(building-available mule-cart)
    (building-type-count-total town-center < 1)
    (building-type-count-total mule-cart < 1)
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
    (set-strategic-number sn-mule-cart-dropsite-placement lumber-camp)
    (build mule-cart)
)

;emergency mule cart (stone)
(defrule
	(game-time > 20)
    (resource-found stone)
	(wood-amount >= 275)
	(stone-amount < 100)
(not	(can-build town-center))
	(building-available mule-cart)
    (building-type-count-total town-center < 1)
    (building-type-count-total mule-cart < 2) ;1st is wood
	(dropsite-min-distance stone >= 15) ;only build if stone is far
	(up-pending-objects c: mule-cart < 1)
	(can-build mule-cart)
=>
    (set-strategic-number sn-mule-cart-dropsite-placement mining-camp) ;hopefully gets placed near wood for a double whammy ;in the future we should DUC the wood mule-cart to a stone-mine
    (build mule-cart)
)

	;MAX GATHERING DISTANCES (food, wood, gold, and stone)
	;remember, "resource-found" only works if it is within the max distance, so we don't use it here

	;emergency max food gathering
(defrule
	(goal is-town-under-attack no)
	(unit-type-count villager >= 6)
	(unit-type-count villager-food < 1)
	(strategic-number sn-food-gatherer-percentage > 0)
	(dropsite-min-distance food s:>= sn-maximum-food-drop-distance) ;updated version 1.8
	(strategic-number sn-maximum-food-drop-distance c:< map-size)
=>
;	(chat-local-to-self "Increasing max food gathering distance.")
	;(set-strategic-number sn-food-dropsite-distance -1);this strategic-number is PREFERRED, not max, so it should not be changed
	(up-modify-sn sn-maximum-food-drop-distance c:+ 1)
)

	;reset emergency max food gathering
(defrule
(or		(goal is-town-under-attack yes)
(or		(strategic-number sn-maximum-food-drop-distance c:> map-size)
(and	(strategic-number sn-food-gatherer-percentage > 0)
(and	(unit-type-count villager >= 6)
(and	(unit-type-count villager-food >= 1) ;food is restored
		(dropsite-min-distance food s:<= sn-food-dropsite-distance)))))) ;and the minimum distance to food is restored
=>
;	(chat-local-to-self "Resetting max food gathering distance.")
	(set-strategic-number sn-food-dropsite-distance 7) ;remember, THIS sn is the "preferred" gathering distance
	(set-strategic-number sn-maximum-food-drop-distance 23) ;this sn is the absolute MAXIMUM gathering distance ;default is 23 (see Jester.per main file)
)

	;emergency max wood cutting
(defrule
	(goal WOOD-REMAINING yes)
	(goal is-town-under-attack no)
	(unit-type-count villager >= 10)
	(unit-type-count villager-wood < 1)
	(strategic-number sn-wood-gatherer-percentage > 0)
	(dropsite-min-distance wood s:>= sn-maximum-wood-drop-distance) ;updated version 1.8
	(strategic-number sn-maximum-wood-drop-distance c:< map-size)
=>
;	(chat-local-to-self "Increasing max wood cutting distance.")
	;(set-strategic-number sn-wood-dropsite-distance -1);this strategic-number is PREFERRED, not max, so it should not be changed
	(up-modify-sn sn-maximum-wood-drop-distance c:+ 1)
)

	;reset emergency max wood cutting
(defrule
(or		(goal is-town-under-attack yes)
(or		(strategic-number sn-maximum-wood-drop-distance c:> map-size) ;expansion bugged out, reset it
(or		(goal WOOD-REMAINING no) ;if no wood left dont send vils to their death across the map for the last 15 trees
(and	(goal WOOD-REMAINING yes)
(and	(unit-type-count villager >= 10)
(and	(unit-type-count villager-wood >= 1) ;wood is restored
(and	(strategic-number sn-wood-gatherer-percentage > 0)
		(dropsite-min-distance wood s:<= sn-wood-dropsite-distance)))))))) ;wood gathering is restored ;5
=>
;	(chat-local-to-self "Resetting max wood cutting distance.")
	(set-strategic-number sn-wood-dropsite-distance 5) ;7
	(set-strategic-number sn-maximum-wood-drop-distance 25) ;default is 25 (see Jester.per main file)
)

	;emergency max gold mining 
(defrule
	(goal GOLD-REMAINING yes)
	(goal is-town-under-attack no)
	(unit-type-count villager >= min-vills) ;avg 20
	(unit-type-count villager-gold < 1)
	(strategic-number sn-gold-gatherer-percentage > 0)
	(dropsite-min-distance gold s:>= sn-maximum-gold-drop-distance) ;25
	(strategic-number sn-maximum-gold-drop-distance c:< map-size)
=>
;	(chat-local-to-self "Increasing max gold mining distance.")
	;(set-strategic-number sn-gold-dropsite-distance -1) ;this strategic-number is PREFERRED, not max, so it should not be changed
	(up-modify-sn sn-maximum-gold-drop-distance c:+ 1)
)

	;reset emergency max gold mining
(defrule
(or		(goal is-town-under-attack yes)
(or		(strategic-number sn-maximum-gold-drop-distance c:> map-size) ;expansion bugged out, reset it
(or		(goal GOLD-REMAINING no) ;if no gold left dont send vils to their death across the map for the last pile
(and	(goal GOLD-REMAINING yes)
(and	(unit-type-count villager >= min-vills) ;20
(and	(unit-type-count villager-gold >= 1)
(and	(strategic-number sn-gold-gatherer-percentage > 0)
		(dropsite-min-distance gold s:<= sn-gold-dropsite-distance)))))))) ;gold gathering is restored ;5
=>
;	(chat-local-to-self "Resetting max gold mining distance.")
	(set-strategic-number sn-gold-dropsite-distance 5)
	(set-strategic-number sn-maximum-gold-drop-distance 25) ;default is 25 (see Jester.per main file)
)

	;emergency max stone mining 
(defrule
	(goal STONE-REMAINING yes)
	(goal is-town-under-attack no)
	(unit-type-count villager >= min-vills) ;20
	(unit-type-count villager-stone < 1)
	(strategic-number sn-stone-gatherer-percentage > 0)
	(dropsite-min-distance stone s:>= sn-maximum-stone-drop-distance) ;25
	(strategic-number sn-maximum-stone-drop-distance c:< map-size) ;max
=>
;	(chat-local-to-self "Increasing max stone mining distance.")
	(up-modify-sn sn-maximum-stone-drop-distance c:+ 1)
)

	;reset emergency max stone mining
(defrule
(or		(goal is-town-under-attack yes)
(or		(strategic-number sn-maximum-stone-drop-distance c:> map-size) ;expansion rule bugged out, reset it
(or		(goal STONE-REMAINING no) ;if no stone left dont send vils to their death across the map for the last pile
(and	(goal STONE-REMAINING yes)
(and	(unit-type-count villager >= min-vills) ;20
(and	(unit-type-count villager-stone >= 1)
(and	(strategic-number sn-stone-gatherer-percentage > 0)
		(dropsite-min-distance stone s:<= sn-stone-dropsite-distance)))))))) ;stone gathering is restored ;5
=>
;	(chat-local-to-self "Resetting max stone mining distance.")
	(set-strategic-number sn-stone-dropsite-distance 5) ;default ;we want to prefer the closest stone-mine
	(set-strategic-number sn-maximum-stone-drop-distance 25) ;default is 25 (see Jester.per main file)
)

;(defrule DISABLED FOR TESTING PURPOSES
;   (building-type-count-total lumber-camp == 2)
;   =>
;   (set-strategic-number sn-maximum-wood-drop-distance 15)
;   (disable-self)
;)

	;MILL RULES

;preferred mill distance
;0 = forage, 1 = deer, 2 = shore fish

	;default mill (game-start)
(defrule
	(building-type-count-total mill <= 0)
	(strategic-number sn-preferred-mill-placement != 0)
=>
	(set-strategic-number sn-preferred-mill-placement 0)
	(disable-self))

	;prefer fishing
(defrule
(up-gaia-type-count c: shore-fish-class > 4)
(dropsite-min-distance food >= 5)
(or	(unit-type-count male-forager < 1)
(or	(unit-type-count female-forager < 1)
(or	(unit-type-count male-hunter < 1)
(or	(unit-type-count female-hunter < 1)
(or	(building-type-count farm < 1)
	(and	(building-type-count farm > 0)
			(idle-farm-count <= 1)))))))
	(strategic-number sn-preferred-mill-placement != 2)
=>
	(set-strategic-number sn-preferred-mill-placement 2))

	;prefer berries/farms
(defrule
	(strategic-number sn-preferred-mill-placement != 0)
(or	(unit-type-count male-forager > 0)
(or	(unit-type-count female-forager > 0)
	(and	(building-type-count farm > 0)
			(idle-farm-count <= 1))))
=>
	(set-strategic-number sn-preferred-mill-placement 0))

	;prefer hunting
(defrule
(or	(up-compare-goal boar-hunt == nomad-hunt)
	(up-compare-goal boar-hunt == deer-hunt)); only consider these rules if we are following nomad hunting rules OR regular deer-hunting rules (due to general boar hunting)
(or	(unit-type-count male-hunter > 1) ; minimal 2 males OR
	(unit-type-count female-hunter > 1)) ; 2 females
	(strategic-number sn-preferred-mill-placement != 1)
=>
	(set-strategic-number sn-preferred-mill-placement 1)
	(up-modify-sn sn-mill-max-distance c:= 30) ;decent hunting distance
)

;MILL for sheep (gurjara-civ yes) ONLY
(defrule
	(goal gurjara-civ yes) ;GURJARA BUILDS MILL FIRST NOW FOR SHEEP
	(up-object-type-count c: livestock-class >= 2) ;must be worthwhile
	(resource-found food)
	(building-type-count-total house >= 2)
	(unit-type-count villager >= 8) ;at least some villagers and time to explore for bushes
	(building-type-count town-center > 0)
	(building-type-count-total mill < 1)
	(can-build mill)
=>
	(build mill)
)

;MILL (NORMAL) (DRUSH no)
(defrule
	(goal DRUSH no)
(or	(building-type-count-total house > 0)
	(civ-selected hun))
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 8));ensures reliable wood supply
   (building-type-count town-center > 0)
(or		(building-type-count-total lumber-camp > 0); Trying lumber-camp before mill now.
		(unit-type-count-total mule-cart > 0)) ;NEW CIVS!!!
   (building-type-count-total mill < 1)
   (resource-found food)  
   (can-build mill)
=>
	(chat-local-to-self "Normal mill.")
	(set-strategic-number sn-allow-adjacent-dropsites 0)
	(set-strategic-number sn-dropsite-separation-distance 8) ;6
	(build mill))

;MILL (NORMAL) (DRUSH yes)
(defrule
	(goal DRUSH yes)
	(building-type-count-total barracks > 0)
(or	(building-type-count-total house > 0)
	(civ-selected hun))
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 8));ensures reliable wood supply
	(building-type-count town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(unit-type-count-total mule-cart > 0))
	(building-type-count-total mill < 1)
	(resource-found food)  
	(can-build mill)
=>
	(chat-local-to-self "Drush mill.")
	(set-strategic-number sn-allow-adjacent-dropsites 0)
	(set-strategic-number sn-dropsite-separation-distance 10) ;6
	(build mill))

;2ND MILL (hunting)
(defrule
	(unit-type-count-total villager >= min-vills)
	(building-type-count-total mill == 1)
	(wood-amount > 275) ;must have sufficient wood to consider
	;(dropsite-min-distance wood <= 7));ensures reliable wood supply
(or		(building-type-count-total lumber-camp > 0)
		(unit-type-count-total mule-cart > 0)) ;my ai isn't smart enough to utilize mule carts for hunting yet
	(building-type-count town-center > 0)
(or	(resource-found hunting)
	(resource-found food))
(or	(and	(dropsite-min-distance hunting >= 14)
			(dropsite-min-distance hunting <= 38))
(or	(and	(dropsite-min-distance boar-hunting >= 14)
			(dropsite-min-distance boar-hunting <= 38))
	(and	(dropsite-min-distance food >= 18)
			(dropsite-min-distance food <= 38))))
	(can-build mill)
=>
;	(chat-to-player my-player-number "Building a 2nd mill.")
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(set-strategic-number sn-dropsite-separation-distance 12) ;6
	(build mill))

;EMERGENCY MILL
(defrule
(or	(and	(goal DRUSH yes)
			(building-type-count-total barracks > 0))
	(and	(goal DRUSH no)
		(current-age-time > 180))) ;150
(or	(civ-selected hun)
	(building-type-count house > 0))
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 8));ensures reliable wood supply
(or	(sheep-and-forage-too-far)
	(game-time > 600));MAX 10 MINUTES
   (building-type-count town-center > 0)
   (building-type-count-total mill < 1)
   (can-build mill)
=>
	(chat-local-to-self "Building an emergency mill.")
	(set-strategic-number sn-preferred-mill-placement 0); default for forage bush
	(build mill)
)

