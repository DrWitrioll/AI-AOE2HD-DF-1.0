(or	(players-civ target-player malian)
(or	(players-civ target-player teutonic)
	(players-civ target-player viking))))))))))
=>
	;(chat-to-player my-player-number "Target-enemy's unique unit is infantry.")
	(set-goal UNIQUE-ENEMY-INFANTRY yes)
	(set-goal UNIQUE-ENEMY-ARCHER no)
	(set-goal UNIQUE-ENEMY-CAVALRY no)
	(set-goal UNIQUE-ENEMY-CAV-ARCHER no)
	(set-goal UNIQUE-ENEMY-SIEGE no); organ guns
	(set-goal UNIQUE-ENEMY-HAND-CANNONEER no)
)

