; Emergency Boom Strategy (no strategy was selected) (meso or non-meso) (pocket or flank)
(defrule
	(current-age == castle-age); important as we dont want to change imp strategies here
	(goal imperial-pending no) ;don't potentially change our imperial strategy
	(current-age-time > 10) ;3 is for other strategies
	(current-age-time <= 30) ;safety
	(goal castle-strategy-selected no)
	(up-compare-goal BOOM != yes)
=>
	(chat-to-allies "Going for boom.")
	(chat-local-to-self "Going for boom.")
	(set-goal castle-strategy-selected yes)
	(set-goal BOOM yes)
	(disable-self)
)

	;CAVALRY-UNITS

;INDIANS ONLY FIX camel-line
(defrule
	(goal CAVALRY-UNITS yes)
	(up-compare-goal CAMEL != main) ;means main strategy
	(civ-selected indian)
(not	(players-civ target-player aztec))
(not	(players-civ target-player mayan))
(not	(players-civ target-player incan))
=>
	(chat-local-to-self "Going for camels.")
	(chat-to-allies "Going for camels.")
	(set-goal CAMEL main)
	(set-goal CAVALRY-UNITS no)
)
;INDIANS ONLY FIX scout-cavalry-line
(defrule
	(goal CAVALRY-UNITS yes)
	(up-compare-goal SCOUT-CAVALRY != main)
	(civ-selected indian)
(or	(players-civ target-player aztec)
(or	(players-civ target-player mayan)
	(players-civ target-player incan)))
=>
	(chat-local-to-self "Going for light-cavalry.")
	(chat-to-allies "Going for light-cavalry.")
	(set-goal SCOUT-CAVALRY main)
	(set-goal CAVALRY-UNITS no)
)
;battle-elephant
(defrule
	(goal CAVALRY-UNITS yes)
	(goal BATTLE-ELEPHANT no)
(or	(civ-selected burmese)
(or	(civ-selected khmer)
(or	(civ-selected malay)
(or	(civ-selected vietnamese)
(or	(goal bengali-civ yes) ;for now
	(goal dravidian-civ yes)))))) ;bad cav civ but if they have to then castle elephants
=>
	(chat-local-to-self "Going for battle elephants.")
	(chat-to-allies "Going for battle elephants.")
	(set-goal BATTLE-ELEPHANT yes)
	(set-goal CAVALRY-UNITS no)
)
;steppe-lancer
(defrule
	(goal CAVALRY-UNITS yes)
	(goal STEPPE-LANCER no)
(or	(goal cuman-civ yes)
(or	(civ-selected mongol)
	(goal tatar-civ yes)))
=>
	(chat-local-to-self "Going for steppe lancers.")
	(chat-to-allies "Going for steppe lancers.")
	(set-goal STEPPE-LANCER yes)
	(set-goal CAVALRY-UNITS no)
)
;shrivamsha-rider
(defrule
	(goal CAVALRY-UNITS yes)
	(goal KNIGHT no) ;unique situation where it creates shrivamsha-riders
	(goal gurjara-civ yes) ;gurjara have special shrivamsha-rider-line
(not	(civ-selected indian))
(not	(unit-available steppe-lancer-line))
(not	(unit-available battle-elephant-line))
=>
	(chat-local-to-self "Going for shrivamsha riders.") ;like knights
	(chat-to-allies "Going for shrivamsha riders")
	(set-goal KNIGHT yes)
	(set-goal CAVALRY-UNITS no)
)
;knight
(defrule
	(goal CAVALRY-UNITS yes)
	(goal BATTLE-ELEPHANT no)
	(goal STEPPE-LANCER no)
	(goal KNIGHT no)
	(goal gurjara-civ no) ;gurjara have special shrivamsha-rider-line
(not	(civ-selected indian))
(not	(unit-available steppe-lancer-line))
(not	(unit-available battle-elephant-line))
=>
	(chat-local-to-self "Going for knights.")
	(chat-to-allies "Going for knights.")
	(set-goal KNIGHT yes)
	(set-goal CAVALRY-UNITS no)
)

;==========;IMPERIAL STRATEGY;==========;

;CAMEL ;needs improvement
(defrule
	(current-age >= castle-age);it's weird when hes focusing on camels in dark or feudal age
	(goal counter-units yes)
	(goal CAMEL no)
	(unit-available camel-line)
=>
	;(chat-to-player my-player-number "Camels available.")
	(set-goal CAMEL yes)
)

;SPEARMAN
(defrule
	(goal counter-units yes)
	(goal SPEARMAN no)
	(unit-available spearman-line)
=>
	(set-goal SPEARMAN yes)
)

;SKIRMISHER
(defrule
	(goal counter-units yes)
	(goal SKIRMISHER no)
	(unit-available skirmisher-line)
=>
;	(chat-local-to-self "Enabling skirm-units.") ;defaults to genitours unless they are not available
	(set-goal SKIRMISHER yes)
)

;ENABLE HANDCANNONEER COUNTER
(defrule
	(current-age >= imperial-age)
	(current-age-time > 5)
	(goal HAND-CANNONEER no)
(or	(and	(goal UNIQUE-ENEMY-INFANTRY yes)
			(players-unit-type-count target-player my-unique-unit-line > 8))
(or	(players-unit-type-count target-player militiaman-line > 8)
	(players-unit-type-count target-player eagle-warrior-line > 8)))
	(goal KNIGHT no) ;no need for hand cannons if we are going cavalry
	(goal STEPPE-LANCER no)
	(goal BATTLE-ELEPHANT no)
	(goal MY-UNIQUE-UNIT no) ;for now
	(goal HAND-CANNONEER no)
	(soldier-count < 25) ;we need help
	(unit-available hand-cannoneer)
=>
	(chat-to-player my-player-number "I'll focus on hand cannoneers.")
	(chat-to-allies "I'll focus on hand cannoneers.")
	(set-goal HAND-CANNONEER yes)
);don't disable

;DISABLE HANDCANNONEER COUNTER
(defrule
	(current-age >= imperial-age)
	(current-age-time > 10)
	(goal HAND-CANNONEER yes)
	(goal bohemian-civ no); don't disable bohemian strategy
	(goal UNIQUE-ENEMY-INFANTRY yes)
	(players-unit-type-count target-player my-unique-unit-line < 4) ;we've beaten them back, focus on main strategy now
	(players-unit-type-count target-player militiaman-line < 4)
	(players-unit-type-count target-player eagle-warrior-line < 4)
=>
	(chat-to-player my-player-number "Disabling hand-cannoneer training.")
;	(chat-to-allies "I'll focus on hand cannoneers.") ;don't need to tell allies
	(set-goal HAND-CANNONEER no)
);don't disable

;CHAMPION
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes); USE RESET STRATEGY instead of current-age-time
(or	(civ-selected celtic)
;(or	(civ-selected bulgarian) ; Bugged civ identifier
;(or	(goal bulgarian-civ yes)
(or	(civ-selected gothic)
(or	(civ-selected japanese)
;(or	(civ-selected malay)
(or	(civ-selected malian)
;(or	;(civ-selected slavic)
;(or	(civ-selected burmese)
;(or	(civ-selected teutonic)
(or	(goal sicilian-civ yes)
;(or	(goal bohemian-civ yes) ;moved to hand-cannoneer imperial-age strategy
(or	(goal armenian-civ yes) ;NEW
(or	(goal dravidian-civ yes) ;NEW ;for now
(or	(goal roman-civ yes) ;NEW
	(civ-selected viking)))))))))
=>
	(chat-to-player my-player-number "I'll focus on champions.")
	(chat-to-allies "I'll focus on champions.")
	(set-goal SWORDMAN yes)
	(disable-self))

;EAGLE-WARRIOR
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
	;(unit-type-count-total archer-line < 5) ;old condition
(or	(civ-selected aztec)
	(civ-selected incan))
;	(civ-selected mayan); focuses on archers
=>
	(chat-to-player my-player-number "I'll focus on eagles.")
	(chat-to-allies "I'll focus on eagle warriors.")
	(set-goal EAGLE-WARRIOR yes)
	(disable-self))

;ARCHER
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
(or	(civ-selected briton)
(or	(civ-selected chinese)
(or	(civ-selected ethiopian)
(or	(civ-selected italian)
(or	(civ-selected korean); archers for now
(or	(civ-selected mayan); mainly archer strategy for now
(or	(civ-selected portuguese); archers for now
(or	(civ-selected saracen); they have good archers so archers for now
(or	(civ-selected malay);everything else sucks for them so archers too
	(civ-selected vietnamese))))))))))
=>
	(chat-to-player my-player-number "I'll focus on foot archers.")
	(chat-to-allies "I'll focus on foot archers.")
	(set-goal ARCHER yes)
	(disable-self))

;HAND-CANNONEER (NEW)
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
	(goal bohemian-civ yes) ;NEW imperial-strategy
=>
	(chat-to-player my-player-number "I'll focus on hand-cannoneers.")
	(chat-to-allies "I'll focus on hand-cannoneers.")
	(set-goal HAND-CANNONEER yes)
	(disable-self))

;CAV-ARCHER (only indians)
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
	(civ-selected indian)
=>
	(chat-to-player my-player-number "I'll focus on cavalry archers.")
	(chat-to-allies "I'll focus on cavalry archers.")
	(set-goal CAV-ARCHER yes)
	(disable-self))

