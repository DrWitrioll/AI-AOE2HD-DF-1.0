;EAGLE WARRIOR (castle-age)
(defrule
(goal MILITARY-TRAINING yes)
(current-age == castle-age)
(or (goal ARCHER no)
	(goal unique-archer-class no))
(goal EAGLE-WARRIOR yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train eagle-warrior-line)
=>
(train eagle-warrior-line))

;eagle-warrior-line-imperial
;EAGLE WARRIOR (imperial-age or post-imperial-age)
(defrule
(goal MILITARY-TRAINING yes)
(current-age >= imperial-age)
(or (goal ARCHER no)
	(goal unique-archer-class no))
(goal EAGLE-WARRIOR yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train eagle-warrior-line)
=>
(train eagle-warrior-line))


;eagle-warrior-line counter, train for eagle and archer civs as counters
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age >= castle-age)
(or	(goal ARCHER yes)
	(goal unique-archer-class yes))
	(goal EAGLE-WARRIOR yes)
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
		(players-unit-type-count target-player my-unique-unit-line > 3))
;(or	(players-unit-type-count target-player camel-line > 3) ;disabled for now
(or	(players-unit-type-count target-player scout-cavalry-line > 3)
(or	(players-unit-type-count target-player knight-line > 3)
(or	(players-unit-type-count target-player battle-elephant-line > 2)
(or	(players-unit-type-count target-player steppe-lancer-line > 3)
	(players-unit-type-count target-player konnik-set > 3))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count-total eagle-warrior-line < 30)
	(can-train eagle-warrior-line)
=>
	(train eagle-warrior-line))

