	;(goal sicilian-civ no) ;serjeants ;allow production if we have no donjons or castles
	(current-age >= castle-age)
(or (up-research-status c: ri-long-swordsman == research-pending) ;NEW only train full strength if researching or researched ri-longswordsman
	(research-completed ri-long-swordsman))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(can-train militiaman-line)
=>
	(train militiaman-line)) ;end-jump

	;FLEMISH MILITIA (pikeman?)
(defrule ;testing
	;(research-completed ri-flemish-revolution)
		(goal MILITARY-TRAINING yes)
(or	(unit-type-count-total villager > 50)
	(unit-type-count-total villager > max-vill-pop))
	(unit-type-count-total flemish-militia < 20) ;fixed
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(goal VILLAGER-PRIORITY no)
	(can-train flemish-militia)
=>
	(train flemish-militia))

;SERJEANT
;taken care by unique unit rules

;DONJON SERJEANT 
(defrule
	(goal MILITARY-TRAINING yes)
	(goal sicilian-civ yes)
	(current-age <= feudal-age)
	(unit-type-count-total villager >= min-vills)
(or	(goal TRUSH yes)
	(goal SWORDMAN yes))
	(building-type-count donjon > 0)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count-total serjeant-set < 10)
	(can-train donjon-serjeant-line)
=>
	(train donjon-serjeant-line))

;DONJON SERJEANT (train alongside castle serjeants)
(defrule
	(goal MILITARY-TRAINING yes)
	(goal sicilian-civ yes)
	(current-age >= castle-age)
	(unit-type-count-total villager >= min-vills)
(or	(goal SWORDMAN yes);unique unit and serjeants are the same
	(goal MY-UNIQUE-UNIT yes))
	(up-compare-goal my-mil-pop c:< max-mil-pop) ;FIXED as of Version 1.8
	(can-train donjon-serjeant-line) ;however this only trains from donjons (my-unique-unit-line is already taken care of)
=>
	(train donjon-serjeant-line))

