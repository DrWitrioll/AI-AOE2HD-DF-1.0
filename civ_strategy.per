	;ACKNOWLEDGE TAUNT 43 (allies)
(defrule
	(taunt-detected any-ally 43)
=>
	(acknowledge-taunt this-any-ally 43)
)

	;ACKNOWLEDGE TAUNT 43 (my-player-number)
(defrule
	(taunt-detected my-player-number 43)
=>
	(acknowledge-taunt my-player-number 43)
)

	;DETECT CERTAIN ENEMY STRATEGIES (alpha testing stage)

	;ENEMY-DARK-STRATEGIES
(defrule
	(goal position-goal flank)
	(current-age == dark-age)
	(players-current-age target-player == dark-age)
	(players-unit-type-count target-player militiaman-line > 0)
=>
	(chat-to-allies "My enemy might be drushing.")
	(set-goal enemy-dark-strategy militia)
	(disable-self))

	;ENEMY-FEUDAL-STRATEGIES

	;feudal archers
(defrule
	(goal position-goal flank)
	(current-age == feudal-age)
(or	(game-time < 1200); 20 mins game time (for feudal start games like empire wars)
	(current-age-time < 600)) ;less than 10 minutes feudal time to acquire this many units
	(players-current-age target-player == feudal-age)
(or	(and	(players-unit-type-count target-player archer-line > 4);5
		(players-unit-type-count target-player skirmisher-line < 1))
	(players-building-type-count target-player archery-range >= 2))
=>
	(chat-to-allies "My enemy is going archers.")
	(set-goal enemy-feudal-strategy archers)
	(disable-self))

	;feudal skirmishers
(defrule
	(goal position-goal flank)
	(current-age == feudal-age)
	(game-time < 1200)
	(current-age-time < 600)
	(up-compare-goal enemy-feudal-strategy != archers);prevent multiple triggers
	(players-current-age target-player == feudal-age)
(or	(and	(players-unit-type-count target-player archer-line < 1)
		(players-unit-type-count target-player skirmisher-line > 4));5
	(players-building-type-count target-player archery-range >= 2))
=>
	(chat-to-allies "My enemy is going skirmishers.")
	(set-goal enemy-feudal-strategy skirmishers)
	(disable-self))

	;feudal arch/skirm
(defrule
	(goal position-goal flank)
	(current-age == feudal-age)
	(game-time < 1200)
	(current-age-time < 600)
	(up-compare-goal enemy-feudal-strategy != archers);prevent multiple triggers
	(players-current-age target-player == feudal-age)
(or	(and	(players-unit-type-count target-player archer-line > 2)
		(players-unit-type-count target-player skirmisher-line > 2))
	(players-building-type-count target-player archery-range >= 2))
=>
	(chat-to-allies "My enemy is going arch/skirm.")
	(set-goal enemy-feudal-strategy arch/skirm)
	(disable-self))

	;feudal scouts
(defrule
	(goal position-goal flank)
	(current-age == feudal-age)
	(game-time < 1200)
	(current-age-time < 600)
	(players-current-age target-player == feudal-age)
(or	(players-unit-type-count target-player scout-cavalry-line > 1)
	(players-building-type-count target-player stable >= 1))
=>
	(chat-to-allies "My enemy is going scouts.")
	(set-goal enemy-feudal-strategy scouts)
	(disable-self))

	;get a barracks ready!
(defrule
	(goal position-goal flank)
	(current-age == feudal-age)
	(goal feudal-pending no)
(or	(goal enemy-feudal-strategy archers)
(or	(goal enemy-feudal-strategy skirmishers)
(or	(goal enemy-feudal-strategy arch/skirm)
(or	(goal enemy-feudal-strategy scouts)
(or	(players-unit-type-count target-player eagle-warrior-line >= 2) ;enemy is going eagles, prep militiaman-line
	(players-unit-type-count target-player militiaman-line >= 3))))))
	(building-type-count town-center > 0)
	(building-type-count-total barracks < 1)
	(can-build barracks)
=>
	(up-assign-builders c: barracks c: 3)
	(build barracks))

	;build an archery range
(defrule
	(goal position-goal flank)
	(current-age == feudal-age)
	(goal feudal-pending no)
(or	(goal enemy-feudal-strategy archers)
(or	(goal enemy-feudal-strategy skirmishers)
	(goal enemy-feudal-strategy arch/skirm)))
	(building-type-count town-center > 0)
	(building-type-count-total archery-range < 1)
	(can-build archery-range)
=>
	(up-assign-builders c: archery-range c: 3)
	(build archery-range))

	;prep spearman defence (this rule is mostly regarding the spotted enemy stable)
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age == feudal-age)
	(goal enemy-feudal-strategy scouts)
	(unit-type-count-total spearman-line < 2) ;3
	(can-train spearman-line)
=>
	(train spearman-line))

;DEFAULT DISABLE RESET-STRATEGY
(defrule
	(goal RESET-STRATEGY yes)
=>
	;(set-goal counter-units wait)
	(set-goal RESET-STRATEGY no)
)


