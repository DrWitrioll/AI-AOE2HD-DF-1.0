
	;Civilization strategies for Jester.per (strategy file).

;reset strategy (villager,trade-cart,trade-cog,fishing-ship (economic units) separate)

;(defrule
;	(game-time < 5)
;	(goal RESET-STRATEGY no)
;=>
;	(set-goal RESET-STRATEGY yes)
;	(disable-self)
;)

;==========STRATEGY TAUNTS (part 1)==========

;32 CEASE CREATING EXTRA VILLAGERS (no)
(defrule
	(taunt-detected any-ally 32)
	(goal DEFAULT-STRATEGY yes)
=>
	(acknowledge-taunt this-any-ally 32)
	(chat-to-player this-any-ally "I am already following my default strategy.")
)

;32 CEASE CREATING EXTRA VILLAGERS (yes) (this is aggressive) [PART 1]
(defrule
	(taunt-detected any-ally 32)
	(goal RESET-STRATEGY no)
	(up-compare-goal DEFAULT-STRATEGY != yes)
=>
	;(acknowledge-taunt this-any-ally 32);acknowledge in part 2
	;(chat-to-player every-ally "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

;TEMPORARY 32 RULE
;(defrule
;	(current-age == feudal-age)
;	(goal DEFAULT-STRATEGY yes);is only temporary for 1 full rule pass so it should stop automatically
;	(up-compare-goal SCOUT-CAVALRY != no)
;=>
;	(set-goal SCOUT-CAVALRY no)
;)

	;33

;33 CREATE EXTRA VILLAGERS (<= feudal-age) (no)
(defrule
	(taunt-detected any-ally 33)
	(current-age <= feudal-age)
	;(up-compare-goal castle-pending != yes) ;doesn't matter
	(up-compare-goal FAST-CASTLE == yes)
=>
	(acknowledge-taunt this-any-ally 33)
	(chat-to-player this-any-ally "I am already going for a fast castle.")
)

;33 (<= feudal-age extra) (LEAVE BETWEEN THE TAUNTS SO IT ISNT PREMATURELY DISABLED)
(defrule
(or	(taunt-detected any-ally 33)
	(taunt-detected any-ally 32))
	(current-age <= feudal-age)
	(up-compare-goal castle-pending != yes)
	(up-compare-goal FAST-CASTLE != yes)
	(up-compare-goal feudal-strategy-selected != yes)
=>
	(set-goal feudal-strategy-selected yes)
	(disable-self)
)

;33 CREATE EXTRA VILLAGERS (<= feudal-age) (yes) [part 1]
(defrule
	(taunt-detected any-ally 33)
	(current-age <= feudal-age)
	(goal castle-pending no)
	(goal FAST-CASTLE no)
=>
	;(acknowledge-taunt this-any-ally 33) ;part 2
	;(chat-to-allies "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

;33 CREATE EXTRA VILLAGERS (BOOM) (no)
(defrule
	(taunt-detected any-ally 33)
	(goal BOOM yes)
(or	(current-age == castle-age)
	(goal castle-pending yes))
=>
	(acknowledge-taunt this-any-ally 33)
	(chat-to-player this-any-ally "I am already attempting to boom.")
)

;33 (<= castle-age extra) (LEAVE BETWEEN THE TAUNTS SO IT ISNT PREMATURELY DISABLED)
(defrule
(or	(taunt-detected any-ally 33)
	(taunt-detected any-ally 32))
	(current-age == castle-age)
	(up-compare-goal BOOM != yes)
	(up-compare-goal imperial-pending != yes)
	(up-compare-goal castle-strategy-selected != yes)
=>
	(up-modify-goal castle-strategy-selected c:= yes)
	(disable-self)
)

;33 CREATE EXTRA VILLAGERS (imperial-pending yes) (yes) [BOOM] [part 1]
(defrule
	(taunt-detected any-ally 33)
	(current-age == castle-age)
	(up-compare-goal imperial-pending != yes)
	(up-compare-goal BOOM != yes)
=>
	;(acknowledge-taunt this-any-ally 33) ;part 2
	;(chat-to-allies "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

;33 CREATE EXTRA VILLAGERS (castle-pending yes) (yes) [BOOM] [part 1]
(defrule
	(taunt-detected any-ally 33)
	(current-age == feudal-age)
	(up-compare-goal castle-pending == yes)
	(up-compare-goal BOOM != yes)
=>
	;(acknowledge-taunt this-any-ally 33) ;part 2
	;(chat-to-allies "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

;==========UNIT TAUNT STRATEGIES (part 1)==========

	;INFANTRY (72)

;initiate infantry
(defrule
	(current-age >= dark-age)
	(goal my-civ-type non-meso); any civ that isnt aztec, incan, or mayan
	(taunt-detected any-ally 72)
	(goal RESET-STRATEGY no)
	(up-compare-goal SWORDMAN != yes)
=>
	;(chat-to-allies "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

;initiate eagles (if meso civ)
(defrule
	(current-age >= dark-age)
	(goal my-civ-type meso)
	(taunt-detected any-ally 72)
	(goal RESET-STRATEGY no)
	(up-compare-goal EAGLE-WARRIOR != yes)
=>
	;(chat-to-allies "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

	;CAVALRY-UNITS (73) (battle-elephant, knight, or steppe-lancer)

	;unable to use cavalry units
(defrule
	(goal my-civ-type meso)
	(taunt-detected any-ally 73)
=>
	(chat-to-player this-any-ally "You know my civ doesn't support cavalry, right?")
	(acknowledge-taunt this-any-ally 73)
)

	;initiate cavalry-units 
(defrule
	(current-age >= dark-age)
	(goal my-civ-type non-meso)
	(taunt-detected any-ally 73)
	(goal RESET-STRATEGY no)
	(up-compare-goal CAVALRY-UNITS != yes)
=>
	;(chat-to-allies "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

	;ARCHERS (74)
	;initiate archers
(defrule
	(current-age >= dark-age)
	(taunt-detected any-ally 74)
	(goal RESET-STRATEGY no)
	(up-compare-goal ARCHER != yes)
=>
	;(acknowledge-taunt this-any-ally 74) ; allow next rule to acknowledge taunt so reset-strategy can trigger
	;(chat-to-allies "Resetting my strategy.")
	(set-goal RESET-STRATEGY yes)
)

;======================================================================================

;default castle reset-strategy
(defrule
	(goal RESET-STRATEGY no)
(or	(current-age == castle-age)
	(goal castle-pending yes))
=>
	(set-goal RESET-STRATEGY yes)
	(disable-self)
)

	;NEW go for a defensive boom after a long time spent in castle-age (PART 1)
	;CONDITION 1 (both flank and pocket players (too long in castle)
(defrule
	(current-age == castle-age)
	(goal imperial-pending no)
(or	(current-age-time >= 1320) ;22 minutes
	(game-time >= 3600)) ;we should be in imperial by now
	(up-compare-goal defend-castle != yes) ;must be != yes or wait, as it will be set to yes down below
	(up-compare-goal defend-castle != wait)
=>
	(set-goal defend-castle wait) ;trigger reset-strategy then activate boom and defend-castle
	(set-goal RESET-STRATEGY yes)
)

	;CONDITION 2 (aggressive strategy is not working) (this rule first) (PART 1)
(defrule
	(up-compare-goal defend-castle != yes)
	(up-compare-goal defend-castle != wait)
	(up-compare-goal BOOM == no) ;indicates we are pursuing an aggressive strategy
	(current-age == castle-age)
	(goal imperial-pending no) ;not currently advancing
	(goal position-goal flank) ;only flank players
(or	(and	(current-age-time >= 600) ;10 minutes of getting decently owned, OR
			(strategic-number sn-military-level <= -3)) ;our strategy is not working
			(strategic-number sn-military-level <= -4)) ;dangerously outnumbered
=>
	(set-goal defend-castle wait) ;in between condition that allows defend-castle to work 
	(set-goal RESET-STRATEGY yes)
)
	;CONDITION 3 (largely outnumbered by military while booming) (PART 1)
(defrule
	(up-compare-goal defend-castle != yes)
	(up-compare-goal defend-castle != wait)
	(up-compare-goal BOOM == yes) ;indicates we are pursuing an eco boom
	(current-age == castle-age)
	(goal imperial-pending no) ;not currently advancing
	(current-age-time >= 300) ;5 minutes of getting owned
	(goal position-goal flank) ;only flank players
(or	(strategic-number sn-military-level <= -3)
	(up-enemy-units-in-town >= 15)) ;large threat
=>
	(set-goal defend-castle wait) ;in between condition that allows defend-castle to work 
	(set-goal RESET-STRATEGY yes)
)

;default imperial reset-strategy
(defrule
	(goal RESET-STRATEGY no)
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
=>
	(set-goal RESET-STRATEGY yes)
	(disable-self)
)
	;==========RESET-STRATEGY RULES==========

(defrule
	(goal RESET-STRATEGY yes)
=>
	(chat-to-allies "Resetting my strategy.")
	(chat-to-player my-player-number "Resetting my strategy.")
)

	;(main units)
(defrule
	(goal RESET-STRATEGY yes);does not disable eco units
=>
	(set-goal SWORDMAN no)
	(set-goal EAGLE-WARRIOR no)
	(set-goal ARCHER no)
	(set-goal FEUDAL-SKIRMISHER no)
	(set-goal CAV-ARCHER no)
	(set-goal KNIGHT no)
	(set-goal BATTLE-ELEPHANT no)
	(set-goal STEPPE-LANCER no)
	(set-goal CONDOTTIERO no)
	(set-goal GENITOUR no)
	(set-goal SLINGER no)
	(set-goal SERJEANT-DONJON no)
)

	;(strategies)
(defrule
	(goal RESET-STRATEGY yes)
=>
	(set-goal DRUSH no)
	(set-goal TRUSH no)
	(set-goal FAST-CASTLE no)
	(set-goal need-castle no); for fast-castle unique units
	(set-goal need-siege-workshop no)
	(set-goal BOOM no)
	(set-goal DEFAULT-STRATEGY no)
	(set-goal FEUDAL-SCOUT-CAVALRY no)
	(set-goal SIEGE-RUSH no) ;NEW
)

;	TO BE INCORPORATED IN FUTURE UPDATE
;
	;(set-goal SPEARMAN no) COUNTER UNIT

	;(set-goal SKIRMISHER no) COUNTER UNIT
	;(set-goal SLINGER no)

	;(set-goal HAND-CANNONEER no)
	;(set-goal SCOUT-CAVALRY no) bugged by disabling so fix later
	;(set-goal CAMEL no) COUNTER UNIT

	;extra units
(defrule
	(goal RESET-STRATEGY yes)
=>
	(set-goal MONK no)
	(set-goal MISSIONARY no)
	(set-goal MY-UNIQUE-UNIT no)
;	(set-goal BATTERING-RAM no) ;I had to steal the defconst for these lol
;	(set-goal MANGONEL no)
	(set-goal SCORPION no)
	(set-goal BOMBARD-CANNON no)
	(set-goal TREBUCHET no)
	(set-goal PETARD no)
	(set-goal SIEGE-TOWER no)
	(set-goal TRANSPORT-SHIP no)
	(set-goal WAR-GALLEY no)
	(set-goal FIRE-SHIP no)
)

(defrule
	(goal RESET-STRATEGY yes)
=>
	(set-goal DEMOLITION-SHIP no)
	(set-goal CANNON-GALLEON no)
	(set-goal TURTLE-SHIP no)
	(set-goal LONGBOAT no)
	(set-goal HUSSAR no)
)

;default disable reset-strategy at the bottom of this file.

;==========STRATEGY TAUNTS (part 2)======================================

;32 CEASE CREATING EXTRA VILLAGERS (yes) (this is aggressive) [PART 2]
(defrule
	(taunt-detected any-ally 32)
	(goal RESET-STRATEGY yes)
	(up-compare-goal DEFAULT-STRATEGY != yes)
=>
	(acknowledge-taunt this-any-ally 32);acknowledge in part 2
	(chat-to-player every-ally "Focusing on my civ's default strategy.")
	(set-goal DEFAULT-STRATEGY yes)
)

;33 CREATE EXTRA VILLAGERS (<= feudal-age) (yes) [FAST-CASTLE] [part 2]
(defrule
	(taunt-detected any-ally 33)
	(current-age <= feudal-age)
	(goal castle-pending no)
	(up-compare-goal FAST-CASTLE != yes)
	(goal RESET-STRATEGY yes)
=>
	(acknowledge-taunt this-any-ally 33)
	(chat-to-allies "I'll focus on a fast castle.")
	(set-goal FAST-CASTLE yes)
)


;33 CREATE EXTRA VILLAGERS (imperial-pending yes) (yes) [BOOM] [part 1]
(defrule
	(taunt-detected any-ally 33)
	(current-age == castle-age)
	(up-compare-goal imperial-pending != yes)
	(up-compare-goal BOOM != yes)
	(goal RESET-STRATEGY yes)
=>
	(acknowledge-taunt this-any-ally 33)
	(chat-to-allies "I will attempt to boom.")
	(set-goal BOOM yes)
)

;33 CREATE EXTRA VILLAGERS (castle-pending yes) (yes) [BOOM] [part 2]
(defrule
	(taunt-detected any-ally 33)
	(current-age == feudal-age)
	(up-compare-goal castle-pending == yes)
	(up-compare-goal BOOM != yes)
=>
	(acknowledge-taunt this-any-ally 33)
	(chat-to-allies "I will attempt to boom.")
	(set-goal BOOM yes)
)


;==========UNIT TAUNT STRATEGIES (part 2)======================================

	;activate infantry
(defrule
	(taunt-detected any-ally 72)
	(goal my-civ-type non-meso)
	(goal RESET-STRATEGY yes)
	(up-compare-goal SWORDMAN != yes)
=>
	(set-goal SWORDMAN yes)
	(chat-to-allies "I will focus on infantry units.")
	(acknowledge-taunt this-any-ally 72)
)

	;activate eagles
(defrule
	(taunt-detected any-ally 72)
	(goal my-civ-type meso)
	(goal RESET-STRATEGY yes)
	(up-compare-goal EAGLE-WARRIOR != yes)
=>
	(set-goal EAGLE-WARRIOR yes)
	(chat-to-allies "I will focus on eagles.")
	(acknowledge-taunt this-any-ally 72)
)

	;activate cavalry-units
(defrule
	(taunt-detected any-ally 73)
	(goal RESET-STRATEGY yes)
	(up-compare-goal CAVALRY-UNITS != yes)
=>
	(set-goal CAVALRY-UNITS yes)
	;(chat-to-allies "I will focus on cavalry-units.") ;already set-up in cavalry-units rules.
	(acknowledge-taunt this-any-ally 73)
)

	;activate archers
(defrule
	(taunt-detected any-ally 74)
	(goal RESET-STRATEGY yes)
	(up-compare-goal ARCHER != yes)
=>
	(set-goal ARCHER yes)
	(chat-to-allies "I will focus on foot archers.")
	(acknowledge-taunt this-any-ally 74)
)

;====================================================================================

	;COUNTER-UNITS

;default counter-units yes
(defrule
	(game-time > 60)
	(goal position-goal flank)
	(up-compare-goal counter-units != yes)
=>
	(chat-local-to-self "Enabling default counter-units.")
	(set-goal counter-units yes))

;enable counter units (non-meso civ)
(defrule
	(goal counter-units yes)
	(goal my-civ-type non-meso)
(or	(goal SPEARMAN no)
(or	(goal SKIRMISHER no)
(or	(goal CAMEL no)
	(goal SCOUT-CAVALRY no))))
=>
	(chat-local-to-self "Enabling counter units.")
	(set-goal SPEARMAN yes)
	(set-goal SKIRMISHER yes)
	(set-goal CAMEL yes)
	(set-goal SCOUT-CAVALRY yes)
)

;enable counter units (meso-civ)
(defrule
	(goal counter-units yes)
	(goal my-civ-type meso)
(or	(goal SPEARMAN no)
	(goal SKIRMISHER no))
=>
	(chat-local-to-self "Enabling counter units.")
	(set-goal SPEARMAN yes)
	(set-goal SKIRMISHER yes)
)

;pocket player counter units (disabled) (start)
(defrule
	(game-time < 60)
(or	(goal position-goal pocket)
	(goal MEME-STRATEGY 1))
	(up-compare-goal counter-units != no)
=>
	(set-goal counter-units no)
	(disable-self))

;pocket player counter units (disabled)
(defrule
	(goal position-goal pocket)
	(current-age < imperial-age)
	(goal is-town-under-attack no)
	(goal TRASH-UNITS no)
	(soldier-count > 10);min soldiers ;15
	(strategic-number sn-military-level >= 2) ;-1
	(up-compare-goal counter-units != no)
=>
	(set-goal counter-units no))

;pocket player counter units (enable)
(defrule
	(goal position-goal pocket)
(or	(current-age >= imperial-age)
(or	(goal is-town-under-attack yes)
(or	(strategic-number sn-military-level <= -4);not good
	(goal TRASH-UNITS yes))))
	(soldier-count <= 10);safety
	(up-compare-goal counter-units != yes)
=>
	(set-goal counter-units yes))

;disable counter units
(defrule
	(goal counter-units no)
(or	(goal SPEARMAN yes)
(or	(goal SKIRMISHER yes)
(or	(goal CAMEL yes)
	(goal SCOUT-CAVALRY yes))))
=>
	(chat-local-to-self "Disabling counter units.")
	(set-goal SPEARMAN no)
	(set-goal SKIRMISHER no)
	(set-goal CAMEL no)
	(set-goal SCOUT-CAVALRY no))

;NEW Skirmisher or Genitour?
;genitours
(defrule
	(up-compare-goal GENITOUR != yes)
	(up-compare-goal SKIRM-TYPE != GENITOUR)
(not	(civ-selected briton)) ;skirms are better
(not	(civ-selected vietnamese)) ;imperial skirms are better
(not	(players-civ any-ally vietnamese)) ;imperial skirm upgrade available from ally
	(unit-available genitour-line)
=>
	(set-goal GENITOUR yes)
	(set-goal SKIRM-TYPE GENITOUR)
)
;skirmishers
(defrule
	(up-compare-goal GENITOUR != no)
	(up-compare-goal SKIRM-TYPE != SKIRM)
(not	(unit-available genitour-line))
=>
	(set-goal GENITOUR no)
	(set-goal SKIRM-TYPE SKIRM)
)

;---------------------------ENEMY CIV UNIQUE UNIT--------------------------------
;(defrule
;(goal ENEMY-LOCATED yes)
;=>
;(enable-timer CIV-CHECK-TIMER 10) ;timer not needed
;(disable-self))

;---------------------------ENEMY TARGET-PLAYER THREAT LEVELS--------------------------------
;INITIAL SETUP
(defrule
	(true)
=>
	(set-goal infantry-threat-level 0)			;all melee infantry units
	(set-goal archer-threat-level 0)			;all foot archers
	;(set-goal cav-archer-threat-level 0)		;all cavalry archers
	(set-goal cavalry-threat-level 0)			;all melee cavalry
	(set-goal siege-threat-level 0)				;all general siege (battering-ram, mangonel, scorpion, bombard-cannon, trebuchet etc)
	(set-goal unique-siege-threat-level 0)		;all unique siege (war-wagon, hussite-wagon, organ-gun etc)
	(set-goal hand-cannoneer-threat-level 0)	;hand-cannoneer & jannisaries
	(set-goal navy-threat-level 0)				;all warboats
	(disable-self))

;----------INFANTRY THREAT LEVEL----------
;level 1 (a) 																;These rules may be long but they run in DE so that's the way it is! ;) (easier for me)
(defrule
	(strategic-number sn-target-player-number > 0)
	(up-compare-goal infantry-threat-level < 1)
(or	(players-unit-type-count target-player militiaman-line >= 3)
(or	(players-unit-type-count target-player spearman-line >= 5)
(or	(players-unit-type-count target-player eagle-warrior-line >= 3)
(or	(players-unit-type-count target-player warrior-priest >= 3)
(or	(players-unit-type-count target-player jaguar-man-line >= 3)
(or	(players-unit-type-count target-player flemish-pikeman >= 3)
(or	(players-unit-type-count target-player woad-raider-line >= 3)
(or	(players-unit-type-count target-player urumi-swordsman-line >= 3)
(or	(players-unit-type-count target-player shotel-warrior-line >= 3)
(or	(players-unit-type-count target-player throwing-axeman-line >= 3)
(or	(players-unit-type-count target-player huskarl-set >= 3)
	(players-unit-type-count target-player chakram-thrower-line >= 3))))))))))))
=>
	(set-goal infantry-threat-level 1)
)

;level 1 (b)
(defrule
	(strategic-number sn-target-player-number > 0)
	(up-compare-goal infantry-threat-level < 1)
(or	(players-unit-type-count target-player ghulam-line >= 3)
(or	(players-unit-type-count target-player kamayuk-line >= 3)
(or	(players-unit-type-count target-player condottiero >= 3)
(or	(players-unit-type-count target-player samurai-line >= 3)
(or	(players-unit-type-count target-player karambit-warrior-line >= 5)
(or	(players-unit-type-count target-player gbeto-line >= 3)
(or	(players-unit-type-count target-player obuch-line >= 3)
(or	(players-unit-type-count target-player legionary >= 3)
(or	(players-unit-type-count target-player serjeant-set >= 3)
(or	(players-unit-type-count target-player teutonic-knight-line >= 3)
	(players-unit-type-count target-player berserk-line >= 3)))))))))))
=>
	(set-goal infantry-threat-level 1)
)
;level 2 (a)
(defrule
	(strategic-number sn-target-player-number > 0)
	(up-compare-goal infantry-threat-level < 2)
(or	(players-unit-type-count target-player militiaman-line >= 7)
(or	(players-unit-type-count target-player spearman-line >= 12)
(or	(players-unit-type-count target-player eagle-warrior-line >= 7)
(or	(players-unit-type-count target-player warrior-priest >= 7)
(or	(players-unit-type-count target-player jaguar-man-line >= 7)
(or	(players-unit-type-count target-player flemish-pikeman >= 7)
(or	(players-unit-type-count target-player woad-raider-line >= 7)
(or	(players-unit-type-count target-player urumi-swordsman-line >= 7)
(or	(players-unit-type-count target-player shotel-warrior-line >= 7)
(or	(players-unit-type-count target-player throwing-axeman-line >= 7)
(or	(players-unit-type-count target-player huskarl-set >= 7)
	(players-unit-type-count target-player chakram-thrower-line >= 7))))))))))))
=>
	(set-goal infantry-threat-level 2)
)
;level 2 (b)
(defrule
	(strategic-number sn-target-player-number > 0)
	(up-compare-goal infantry-threat-level < 2)
(or	(players-unit-type-count target-player ghulam-line >= 7)
(or	(players-unit-type-count target-player kamayuk-line >= 7)
(or	(players-unit-type-count target-player condottiero >= 7)
(or	(players-unit-type-count target-player samurai-line >= 7)
(or	(players-unit-type-count target-player karambit-warrior-line >= 10)
(or	(players-unit-type-count target-player gbeto-line >= 7)
(or	(players-unit-type-count target-player obuch-line >= 7)
(or	(players-unit-type-count target-player legionary >= 7)
(or	(players-unit-type-count target-player serjeant-set >= 7)
(or	(players-unit-type-count target-player teutonic-knight-line >= 7)
	(players-unit-type-count target-player berserk-line >= 7)))))))))))
=>
	(set-goal infantry-threat-level 2)
)
;level 3 (a)
(defrule
	(strategic-number sn-target-player-number > 0)
	(up-compare-goal infantry-threat-level < 3)
(or	(players-unit-type-count target-player militiaman-line >= 14)
(or	(players-unit-type-count target-player spearman-line >= 18)
(or	(players-unit-type-count target-player eagle-warrior-line >= 14)
(or	(players-unit-type-count target-player warrior-priest >= 12)
(or	(players-unit-type-count target-player jaguar-man-line >= 12)
(or	(players-unit-type-count target-player flemish-pikeman >= 14)
