;spearman-line LEVEL 1
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SPEARMAN yes)
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
			(players-unit-type-count target-player my-unique-unit-line > 0))
(or	(players-unit-type-count target-player scout-cavalry-line > 1)
(or	(players-unit-type-count target-player knight-line > 0)
(or	(players-unit-type-count target-player camel-line > 0)
(or	(players-unit-type-count target-player battle-elephant-line > 0)
(or	(players-unit-type-count target-player steppe-lancer-line > 0)
(or	(players-unit-type-count target-player krepost-konnik-line > 0)
	(players-unit-type-count target-player shrivamsha-rider-line > 0))))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	;(unit-type-count-total camel-line <= 3) ;always have a few spears on standby for safety
	(unit-type-count villager > min-vills)
	(unit-type-count-total spearman-line < spear-low) ;3
	(can-train spearman-line)
=>
