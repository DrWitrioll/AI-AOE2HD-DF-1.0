	;Activate defend-castle goal (PART 2)

	; defend-castle (PART 2)
(defrule
	(up-compare-goal defend-castle == wait)
=>
	(chat-to-allies "I'll focus on training defensive units while I boom.")
	(chat-to-player my-player-number "Enabling defend-castle strategy.")
	(set-goal defend-castle yes)
)

