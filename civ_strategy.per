;(or	(players-unit-type-count target-player militiaman-line > 5)
;(or	(players-unit-type-count target-player condottiero > 5)
;(or	(players-unit-type-count target-player eagle-warrior-line > 5)
;	(and	(players-unit-type-count target-player spearman-line > 10)
;		(strategic-number sn-military-level < -1))))))
;	(soldier-count < 20) ;10
;=>
;	(chat-to-player my-player-number "I'll focus on infantry.")
;	(chat-to-allies "I'll focus on infantry.")
;	(set-goal SWORDMAN yes))

	;INFANTRY UNITS
(defrule
	(goal defend-castle yes)
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(strategic-number sn-military-level <= 0) ;even the odds
(or	(up-villager-type-in-town c: villager >= 4) ;possible villager rush
(or	(and	(goal UNIQUE-ENEMY-INFANTRY yes)
			(players-unit-type-count target-player my-unique-unit-line >= 10))
(or	(players-unit-type-count target-player militiaman-line >= 10)
(or	(players-unit-type-count target-player spearman-line >= 10)
(or	(players-unit-type-count target-player eagle-warrior-line >= 10)
(or	(players-unit-type-count target-player condottiero >= 10)
(or	(players-unit-type-count target-player huskarl-set >= 10)
(or	(players-unit-type-count target-player serjeant-set >= 10) ;should include donjon-serjeant-line and serjeant-line
	(players-unit-type-count target-player warrior-priest >= 10)))))))))
	(can-train militiaman-line)
=>
	(train militiaman-line)
)

;hand-cannoneer (ANY AGE TO INCLUDE BOHEMIANS)
(defrule
(goal MILITARY-TRAINING yes)
(goal HAND-CANNONEER yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train hand-cannoneer)
=>
(train hand-cannoneer))

	;default disable defend-castle
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(up-compare-goal defend-castle != no)
	(game-time >= 10)
=>
	(chat-to-player my-player-number "Disabling defend-castle strategy.")
	(set-goal defend-castle no)
)

;TRASH-UNITS STRATEGY when no gold is left
(defrule
	(goal TRASH-UNITS no)
	(game-time > 3600)  ;1 hour of gameplay
(or	(gold-amount <= 300) ;low gold for late game
	(goal GOLD-REMAINING no)) ;most gold on the map is gone
	(unit-type-count 579 <= 1)  ;male gold miner (this rule means no gold miners after an hour of gameplay)
	(unit-type-count 581 <= 1) ; female gold miner
(or	(unit-type-count trade-cart <= 8) ;low carts
	(players-building-type-count any-ally market < 1)) ;nothing to trade with
(or	(unit-type-count trade-cog <= 8) ;low cogs
	(players-building-type-count any-ally dock < 1)) ;nothing to trade with
	(military-population <= 30) ;military is starting to hurt late game
=>
	(chat-to-player my-player-number "Focusing on trash units.")
	(set-goal TRASH-UNITS yes)
)

	;disable all strategies for TRASH-UNITS goal

(defrule
	(goal TRASH-UNITS yes)
=>
	(set-goal SWORDMAN no)
	(set-goal EAGLE-WARRIOR no)
	(set-goal ARCHER no)
	(set-goal FEUDAL-SKIRMISHER no)
	(set-goal CAV-ARCHER no)
	(set-goal KNIGHT no)
	(set-goal BATTLE-ELEPHANT no)
	(set-goal STEPPE-LANCER no)
	(set-goal CONDOTTIERO no)
	(set-goal GENITOUR no)
	(set-goal SLINGER no)
	(set-goal SERJEANT-DONJON no)
	(disable-self)
)

(defrule
	(goal TRASH-UNITS yes)
=>
	(set-goal DRUSH no)
	(set-goal TRUSH no)
	(set-goal FAST-CASTLE no)
	(set-goal need-castle no); for fast-castle unique units
	(set-goal need-siege-workshop no)
	(set-goal BOOM no)
	(set-goal DEFAULT-STRATEGY no)
	(set-goal FEUDAL-SCOUT-CAVALRY no)
	(disable-self)
)

	;extra units
(defrule
	(goal TRASH-UNITS yes)
=>
	(set-goal MONK no)
	(set-goal MISSIONARY no)
	(set-goal MY-UNIQUE-UNIT no)
;	(set-goal BATTERING-RAM no) ;needs new defconst if going to use again
;	(set-goal MANGONEL no)
	(set-goal SCORPION no)
	(set-goal BOMBARD-CANNON no)
	(set-goal TREBUCHET no)
	(set-goal PETARD no)
	(set-goal SIEGE-TOWER no)
	(set-goal TRANSPORT-SHIP no)
	(set-goal WAR-GALLEY no)
	(set-goal FIRE-SHIP no)
	(disable-self)
)

(defrule
	(goal TRASH-UNITS yes)
=>
	(set-goal DEMOLITION-SHIP no)
	(set-goal CANNON-GALLEON no)
	(set-goal TURTLE-SHIP no)
	(set-goal LONGBOAT no)
	(set-goal HUSSAR no)
	(disable-self)
)

;----------default trash strategies

(defrule
	(goal TRASH-UNITS yes)
	(up-compare-goal TRASH-SCOUTS != no)
(or	(unit-available ri-hussar)
	(unit-available ri-winged-hussar))
=>
	(set-goal TRASH-SCOUTS yes)
)

(defrule
	(goal TRASH-UNITS yes)
	(up-compare-goal TRASH-SPEARS != no)
	(up-compare-goal TRASH-SKIRMS != no)
(or	(not	(unit-available ri-hussar))
	(not	(unit-available ri-winged-hussar)))
=>
	(set-goal TRASH-SPEARS yes)
	(set-goal TRASH-SKIRMS yes)
)

;SPECIAL TRASH UNIT STRATEGIES
;EMERGENCY BATTERING-RAM (escrow)
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-UNITS yes)
(goal is-town-under-attack no)
(soldier-count >= 10)
;(strategic-number sn-military-level >= -1)
(unit-type-count-total villager > min-vills)
(unit-type-count battering-ram-line < max-siege-pop)
(can-train-with-escrow battering-ram-line)
=>
(release-escrow wood)
(release-escrow gold)
(train battering-ram-line))

;EMERGENCY ARMORED-ELEPHANT (escrow)
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-UNITS yes)
(goal is-town-under-attack no)
(soldier-count >= 10)
;(strategic-number sn-military-level >= -1)
(unit-type-count-total villager > min-vills)
(unit-type-count armored-elephant-line < max-siege-pop)
(can-train-with-escrow armored-elephant-line)
=>
(release-escrow food)
(release-escrow gold)
(train armored-elephant-line))

;EMERGENCY BATTERING-RAM (no escrow)
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-UNITS yes)
(goal is-town-under-attack no)
(soldier-count >= 10)
;(strategic-number sn-military-level >= -1)
(unit-type-count-total villager > min-vills)
(unit-type-count battering-ram-line < max-siege-pop)
(can-train battering-ram-line)
=>
(train battering-ram-line))

;EMERGENCY ARMORED-ELEPHANT (no escrow)
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-UNITS yes)
(goal is-town-under-attack no)
(soldier-count >= 10)
;(strategic-number sn-military-level >= -1)
(unit-type-count-total villager > min-vills)
(unit-type-count armored-elephant-line < max-siege-pop)
(can-train armored-elephant-line)
=>
(train armored-elephant-line))

;EMERGENCY TREBUCHET (escrow)
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-UNITS yes)
(strategic-number sn-military-level >= 0) ;military advantage
(soldier-count >= 10)
(unit-type-count-total villager > min-vills)
(unit-type-count trebuchet-set < max-siege-pop)
(can-train-with-escrow trebuchet)
=>
(release-escrow wood)
(release-escrow gold)
(train trebuchet))

;EMERGENCY TREBUCHET (no escrow)
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-UNITS yes)
(strategic-number sn-military-level >= 0) ;military advantage
(soldier-count >= 10)
(unit-type-count-total villager > min-vills)
(unit-type-count trebuchet-set < max-siege-pop)
(can-train trebuchet)
=>
(train trebuchet))

;SPEARMAN
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-SPEARS yes)
(unit-type-count-total villager > min-vills)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train spearman-line)
=>
(train spearman-line))
;SKIRMISHER
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-SKIRMS yes)
(unit-type-count-total villager > min-vills)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train skirmisher-line)
=>
(train skirmisher-line))
;SCOUT CAVALRY
(defrule
(goal MILITARY-TRAINING yes)
(goal TRASH-SCOUTS yes)
(unit-type-count-total villager > min-vills)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train scout-cavalry-line)
=>
(train scout-cavalry-line)
)
	;GARRISON RULES

	;garrison hold (drush)
(defrule
	(current-age <= dark-age)
(or	(and	(unit-type-count militiaman-line < 3);normal hold until 3
		(goal ATTACK no))
	(and	(unit-type-count militiaman-line < 3) ;wait until we have at least 3
		(players-unit-type-count target-player militiaman-line > 2)))
=>
	(up-gather-inside c: barracks c: 1) ;hold
)
	;garrison release (drush)
(defrule
	(current-age <= dark-age)
	(unit-type-count militiaman-line >= 3)
(or	(goal ATTACK yes)
(or	(players-unit-type-count target-player militiaman-line > 2) ;enemy has some militia
(or	(goal is-town-under-attack yes)
(or	(enemy-buildings-in-town) ;pesky nomad games
	(current-age > dark-age))))) ;don't hold forever
=>
	(up-gather-inside c: barracks c: 0) ;release
)

;default garrison hold
(defrule
	(current-age >= feudal-age)
	(goal EMERGENCY-ATTACK no) ;if yes, then release
(or	(and	(up-enemy-buildings-in-town > 0); don't let them mindlessly die on nomad games.
			(soldier-count <= 7)) ;9
	(and	(strategic-number sn-military-level <= -1) ;-1
			(strategic-number sn-military-level > -4)))
=>
	(up-gather-inside c: barracks c: 1)
	(up-gather-inside c: archery-range c: 1)
	(up-gather-inside c: stable c: 1)
	(up-gather-inside c: siege-workshop c: 1)
	(up-gather-inside c: donjon c: 1)
	(up-gather-inside c: krepost c: 1)
	(up-gather-inside c: castle c: 1)
;	(up-gather-inside c: dock c: 1)
)

	;NEW hold flush for first few minutes in feudal-age
(defrule
	(current-age == feudal-age)
	(current-age-time < 180)
	(goal FLUSH yes)
	(goal ATTACK no)
	(goal EMERGENCY-ATTACK no)
	(goal defend-feudal no)
	(goal is-town-under-attack no)
=>
	(up-gather-inside c: barracks c: 1)
	(up-gather-inside c: archery-range c: 1)
	(up-gather-inside c: stable c: 1)
	(up-gather-inside c: siege-workshop c: 1)
	(up-gather-inside c: donjon c: 1)
	(up-gather-inside c: krepost c: 1)
	(up-gather-inside c: castle c: 1)
)

	;NEW hold flush for first few minutes in feudal-age
(defrule
	(current-age == feudal-age)
	(current-age-time < 300) ;max 5 minutes
	(goal FLUSH yes)
	(goal ATTACK no)
	(goal EMERGENCY-ATTACK no)
	(goal defend-feudal no)
	(goal is-town-under-attack no)
=>
	(up-jump-rule 1)
)

;default garrison release
(defrule
	(current-age >= feudal-age)
(or	(and	(up-enemy-buildings-in-town > 0); release siege weapons!
	(and	(soldier-count >= 6) ;some soldiers to retaliate with siege
	(or		(unit-type-count battering-ram-line > 0)
	(or		(unit-type-count trebuchet-set > 0)
			(unit-type-count armored-elephant-line > 0)))))
(or	(and	(goal is-town-under-attack yes)
			(strategic-number sn-military-level <= -4));might as well fight
(or	(soldier-count >= 8);safety ;was 10 before
(or	(strategic-number sn-military-level >= -1);normal release ;was 0
(or	(goal EMERGENCY-ATTACK yes) ;new
	(goal ATTACK yes)))))) ;normal attack goal
=>
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: donjon c: 0)
	(up-gather-inside c: krepost c: 0)
	(up-gather-inside c: castle c: 0)
;	(up-gather-inside c: dock c: 0)
) ;end jump (1)

;special garrison release (cavalry attack and we have spears)
(defrule
	(current-age >= feudal-age)
(or	(up-unit-type-in-town c: scout-cavalry-line > 1)
(or	(up-unit-type-in-town c: knight-line > 1)
	(up-unit-type-in-town c: camel-line > 1)))
	(up-enemy-units-in-town <= 10) ;small group
	(unit-type-count spearman-line >= 3)
=>
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: barracks c: 0)
	(up-gather-inside c: barracks c: 0)
)

;special garrison release (archer attack and we have skirms)
(defrule
	(current-age >= feudal-age)
(or	(up-unit-type-in-town c: archer-line > 1)
(or	(up-unit-type-in-town c: skirmisher-line > 1)
(or	(up-unit-type-in-town c: slinger > 1)
(or	(up-unit-type-in-town c: genitour-line > 1)
	(up-unit-type-in-town c: cavalry-archer-line > 1)))))
	(up-enemy-units-in-town <= 10) ;small group
	(unit-type-count skirmisher-line >= 3)
=>
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: archery-range c: 0)
)

;special garrison release (archer attack and we have cavalry)
(defrule
	(current-age >= feudal-age)
(or	(up-unit-type-in-town c: archer-line > 1)
(or	(up-unit-type-in-town c: skirmisher-line > 1)
(or	(up-unit-type-in-town c: slinger > 1)
(or	(up-unit-type-in-town c: genitour-line > 1)
	(up-unit-type-in-town c: cavalry-archer-line > 1)))))
	(up-enemy-units-in-town <= 15) ;small group
(or	(unit-type-count knight-line >= 3)
(or	(unit-type-count scout-cavalry-line >= 3)
(or	(unit-type-count camel-line >= 3)
(or	(unit-type-count steppe-lancer-line >= 3)
(or	(unit-type-count battle-elephant-line >= 3)
	(unit-type-count shrivamsha-rider-line >= 3))))))
=>
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: stable c: 0)
)

;special garrison release (archer attack and we have mangonels/scorpions)
(defrule
	(current-age >= feudal-age)
(or	(up-unit-type-in-town c: archer-line > 1)
(or	(up-unit-type-in-town c: skirmisher-line > 1)
(or	(up-unit-type-in-town c: slinger > 1)
(or	(up-unit-type-in-town c: genitour-line > 1)
	(up-unit-type-in-town c: cavalry-archer-line > 1)))))
	(up-enemy-units-in-town <= 20) ;medium group
(or	(unit-type-count mangonel-line >= 1)
	(unit-type-count scorpion-line >= 1))
=>
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: siege-workshop c: 0)
)

;garrison hold (dock)
(defrule
	(building-type-count dock > 0)
	(players-unit-type-count target-player warboat-count >= 3);outnumbered
	(unit-type-count warboat-count <= 3)
=>
	(up-gather-inside c: dock c: 1)
)

;garrison release (dock)
(defrule
(or	(and	(players-unit-type-count target-player warboat-count <= 8);mostly equal ground
		(unit-type-count warboat-count >= 6))
(or	(building-type-count dock < 1)
(or	(unit-type-count warboat-count >= 9);max holding
	(unit-type-count demolition-ship-line >= 2))));release if 2 demos
=>
	(up-gather-inside c: dock c: 0)
)

;be mean to enemy by garrisoning at the end lmao
(defrule
	(game-time > 60)
	(goal GIVE-UP yes)
=>
	(up-gather-inside c: town-center c: 1) ;set to hold all villagers
	(up-garrison town-center c: villager-class) ;send them home
	(up-gather-inside c: barracks c: 0) ;release everything else
	(up-gather-inside c: archery-range c: 0)
	(up-gather-inside c: stable c: 0)
	(up-gather-inside c: siege-workshop c: 0)
	(up-gather-inside c: krepost c: 0)
	(up-gather-inside c: donjon c: 0)
	(up-gather-inside c: castle c: 0)
	(up-gather-inside c: dock c: 0))

;RETREAT STRATEGIES

;Retreat because of enemy castle and too few siege
(defrule
	(goal SIEGE-FOR-CASTLE no)
	(goal RETREAT no)
	(goal EMERGENCY-ATTACK no) ;don't interfere with our very end!
	(goal is-town-under-attack no)
(or	(goal attack-goal offence)
	(strategic-number sn-percent-attack-soldiers > 50))
	(players-building-type-count target-player castle > 0)
	(up-projectile-detected projectile-castle < 10000) ;NEW castle must fire on our soldiers to indicate it is completed.
	(military-population < 50)
=>
	(chat-to-player my-player-number "Retreating! Not enough siege available for castle.")
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-goal RETREAT yes)
	(up-retreat-now))

;miscellaneous rules

(defrule
	(goal ATTACK yes)
	(strategic-number sn-gather-defense-units != 0)
=>
	(set-strategic-number sn-gather-defense-units 0))

(defrule
	(goal ATTACK no)
	(strategic-number sn-gather-defense-units != 1)
=>
	(set-strategic-number sn-gather-defense-units 1))

;(defrule
;	(goal ATTACK no)
;	(unit-type-count 913 < 1)
;	(strategic-number sn-object-repair-level != 2) ;3 , 2 = town-center
;=>
;	(set-strategic-number sn-object-repair-level 2)) ;3

;========================================Reset retreat goal
(defrule
	(goal RETREAT yes)
=>
	(set-strategic-number sn-percent-attack-soldiers 0)
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-gather-defense-units 1)
	(set-goal ATTACK no) ;NEW
	(up-retreat-now)
	(up-update-targets) ;NEW
	(set-goal RETREAT no))

;========================================

	;boom defence strategies

	;goal DEFAULT-STRATEGY yes

;====================================================================================

	;DARK-AGE default-strategy (dark-age OR feudal-pending yes)
;infantry
(defrule
(or	(current-age == dark-age)
	(goal feudal-pending yes))
	(goal DEFAULT-STRATEGY yes)
	(goal RESET-STRATEGY yes)
	(goal SWORDMAN no)
(or	(civ-selected celtic)
(or	(civ-selected gothic)
(or	(civ-selected japanese)
(or	(civ-selected malian)
(or	(civ-selected burmese)
(or	(goal sicilian-civ yes)
(or	(goal armenian-civ yes) ;NEW
(or	(goal dravidian-civ yes) ;NEW
(or	(goal roman-civ yes) ;NEW
	(civ-selected viking))))))))))
=>
	(chat-to-player my-player-number "I'll focus on men-at-arms.")
	(chat-to-allies "I'll focus on infantry units.")
	(set-goal feudal-strategy-selected yes) ;prevents resetting going into feudal-age
	(set-goal SWORDMAN yes)
	(set-goal DEFAULT-STRATEGY no);TURN OFF DEFAULT-STRATEGY SO IT STILL HAS A CHANCE TO COME UP WITH RANDOM STRATEGIES LATER (this is only a temporary strategy change)
)

;eagle-warrior
(defrule
(or	(current-age == dark-age)
	(goal feudal-pending yes))
	(goal DEFAULT-STRATEGY yes)
	(goal RESET-STRATEGY yes)
	(goal EAGLE-WARRIOR no)
(or	(civ-selected aztec)
	(civ-selected incan))
;	(civ-selected mayan); focuses on archers
=>
	(chat-to-player my-player-number "I'll focus on eagles.")
	(chat-to-allies "I'll focus on eagle warriors.")
	(set-goal feudal-strategy-selected yes)
	(set-goal EAGLE-WARRIOR yes)
	(set-goal DEFAULT-STRATEGY no)
)

;archer
(defrule
(or	(current-age == dark-age)
	(goal feudal-pending yes))
	(goal DEFAULT-STRATEGY yes)
	(goal RESET-STRATEGY yes)
	(goal ARCHER no)
(or	(civ-selected briton)
(or	(civ-selected chinese)
(or	(civ-selected ethiopian)
(or	(civ-selected italian)
(or	(civ-selected korean)
(or	(civ-selected mayan)
	(civ-selected portuguese)))))))
=>
	(chat-to-player my-player-number "I'll focus on archers.")
	(chat-to-allies "I'll focus on archers.")
	(set-goal feudal-strategy-selected yes)
	(set-goal ARCHER yes)
	(set-goal DEFAULT-STRATEGY no)
)

;extra archer civs
(defrule
(or	(current-age == dark-age)
	(goal feudal-pending yes))
	(goal DEFAULT-STRATEGY yes)
	(goal RESET-STRATEGY yes)
	(goal ARCHER no)
