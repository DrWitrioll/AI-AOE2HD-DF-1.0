	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(players-unit-type-count target-player hussite-wagon-line >= 10)
(or	(players-unit-type-count target-player ballista-elephant-line >= 10)
(or	(players-unit-type-count target-player war-wagon-line >= 10)
	(players-unit-type-count target-player organ-gun-line >= 10))))
	(unit-type-count-total mangonel-line < 3)
	(can-train mangonel-line)
=>
	(train mangonel-line)
)
;medium-high
