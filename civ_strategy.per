; ENABLE CONDOTTIERO
(defrule
	(goal CONDOTTIERO no)
(or	(and	(goal UNIQUE-ENEMY-SIEGE yes)
		(players-unit-type-count target-player my-unique-unit-line > 2))
(or	(and	(goal UNIQUE-ENEMY-HAND-CANNONEER yes)
		(players-unit-type-count target-player my-unique-unit-line > 2))
(or	(players-unit-type-count target-player hand-cannoneer > 0)
(or	(players-unit-type-count target-player armored-elephant-line > 0)
(or	(players-unit-type-count target-player battering-ram-line > 0)
(or	(players-unit-type-count target-player mangonel-line > 0)
(or	(players-unit-type-count target-player scorpion-line > 0)
	(players-unit-type-count target-player trebuchet-set > 0))))))))
	(unit-available condottiero) ;italians and allies
	(soldier-count < 25)
=>
	(chat-local-to-self "I'll focus on Condottiero's.")
	(chat-to-allies "I'll focus on Condottiero's.")
	(set-goal CONDOTTIERO yes))

; DISABLE CONDOTTIERO
(defrule
	(goal CONDOTTIERO yes)
(and	(goal UNIQUE-ENEMY-SIEGE yes)
		(players-unit-type-count target-player my-unique-unit-line < 2))
(and	(goal UNIQUE-ENEMY-HAND-CANNONEER yes)
		(players-unit-type-count target-player my-unique-unit-line < 2))
	(players-unit-type-count target-player hand-cannoneer < 1)
	(players-unit-type-count target-player armored-elephant-line < 1)
	(players-unit-type-count target-player battering-ram-line < 1)
	(players-unit-type-count target-player mangonel-line < 1)
	(players-unit-type-count target-player scorpion-line < 1)
	(players-unit-type-count target-player trebuchet-set < 1)
	(strategic-number sn-military-level >= 3) ;safe to focus on main strategy
=>
	(chat-local-to-self "Disabling Condottiero training.")
	(set-goal CONDOTTIERO no))

;CONDOTTIERO (non italian) (defensive unit for now)
(defrule
	(goal MILITARY-TRAINING yes)
	(goal CONDOTTIERO yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	;(unit-type-count-total condottiero-placeholder < 25);20
	(can-train condottiero-placeholder)
=>
	(train condottiero-placeholder))

;WARRIOR-PRIEST (low)
(defrule
	(goal MILITARY-TRAINING yes)
;	(goal WARRIOR-PRIEST yes) ;no specific goal for now
	(up-compare-goal my-mil-pop c:< max-mil-pop)
    (food-amount > 200)
(or		(gold-amount > 900)
    	(current-age-time < 300))
(or		(game-time < 3600)
		(gold-amount > 700))
    (unit-type-count-total warrior-priest < 1)
    (can-train warrior-priest)
=>
    (train warrior-priest)
)

;WARRIOR-PRIEST (high)
(defrule
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(current-age == castle-age)
    (research-completed ri-inspired-clergy))
    (players-unit-type-count target-player archer-line < 7)
	(players-unit-type-count target-player cavalry-archer-line < 7)
    (players-unit-type-count target-player hand-cannoneer < 3)
    (unit-type-count-total warrior-priest <= 7)
    (can-train warrior-priest)
=>
    (train warrior-priest)
)

;fishing-ship (scout)
(defrule
	(goal is-town-under-attack no)
	(building-type-count town-center > 0)
	(building-type-count-total dock > 0)
	(warboat-count < 1)
	(unit-type-count-total fishing-ship < 1)
	(can-train fishing-ship)
=>
	(chat-local-to-self "Training a water scout.")
	(train fishing-ship)
)

;fishing-ship (1st set)
(defrule
	(goal is-town-under-attack no)
	(not (town-under-attack))
(or	(dropsite-min-distance wood < 8)
	(wood-amount >= 500))
;	(players-unit-type-count target-player warboat-count <= warboat-count) ;BUGGED
	(building-type-count town-center > 0)
(or	(up-gaia-type-count c: ocean-fish-class > 1)
	(up-gaia-type-count c: shore-fish-class > 1));must be at least 2 sighted fish.
	(unit-type-count-total fishing-ship < 3) ;4
	(can-train fishing-ship)
=>
(train fishing-ship))

;fishing-ship (2nd set)
(defrule
(building-type-count town-center > 0)
(or (goal is-town-under-attack no)
(not (town-under-attack)))
(or	(dropsite-min-distance wood <= 8)
	(wood-amount >= 500))
;(players-unit-type-count target-player warboat-count <= warboat-count) ;BUGGED
(warboat-count > 1); we want a couple galley-line or fire-ship-lines before making more.
(or	(up-gaia-type-count c: ocean-fish-class > 4)
	(up-gaia-type-count c: shore-fish-class > 4));must be at least 5 sighted fish.
(unit-type-count-total fishing-ship > 2) ;3
(unit-type-count-total fishing-ship < 5)
(can-train fishing-ship)
=>
(train fishing-ship))

;fishing-ship (3rd set)
(defrule
(building-type-count town-center > 0)
(current-age >= feudal-age)
(or (goal is-town-under-attack no)
(not (town-under-attack)))
(can-train fishing-ship)
(or	(dropsite-min-distance wood <= 8)
	(wood-amount >= 500))
(or	(up-gaia-type-count c: ocean-fish-class > 9)
	(up-gaia-type-count c: shore-fish-class > 9));must be at least 10 sighted fish.
;(players-unit-type-count target-player warboat-count <= warboat-count) ;this is bugged, does not work
(warboat-count > 5); we want many warboats before making more.
(unit-type-count-total fishing-ship < 7)
=>
(train fishing-ship))

;fishing-ship (WATER-MAP YES)
(defrule
(goal WATER-MAP separated) ;full water-map
(building-type-count town-center > 0)
(or	(goal is-town-under-attack no)
		(not	(town-under-attack)))
(or	(and	(dropsite-min-distance wood <= 7) ;safe
		(wood-amount > 200))
	(wood-amount >= 500)); safety for buildings
(or	(up-gaia-type-count c: ocean-fish-class > 11)
	(up-gaia-type-count c: shore-fish-class > 11));must be at least 12 sighted fish.
(players-unit-type-count target-player warboat-count <= warboat-count)
(unit-type-count-total warboat-count > 2) ;safety
(unit-type-count-total fishing-ship > 6)
(unit-type-count-total fishing-ship < 12)
(unit-type-count-total civilian-population < max-vill-pop); dont dip into military
(can-train fishing-ship)
=>
(train fishing-ship))

;transport-ship (feudal-age) (water-map yes)
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age == feudal-age)
	(goal WATER-MAP separated)
	(soldier-count >= 5);indicates need for a transport ship
	(civilian-population >= 25)
	(unit-type-count-total transport-ship < 1)
	(warboat-count > 2)
	(can-train transport-ship)
=>
	(train transport-ship))

;transport-ship (feudal-age) (water-map yes)
(defrule
	(goal MILITARY-TRAINING yes)
	(game-time > 600)
	(current-age == feudal-age)
	(goal WATER-MAP separated)
	(soldier-count >= 7)
	(civilian-population >= 25)
	(unit-type-count-total transport-ship < 2)
	(warboat-count > 3)
	(can-train transport-ship)
=>
	(train transport-ship))
;transport-ship
(defrule
	(goal MILITARY-TRAINING yes)
	(game-time < 900)
	(current-age == castle-age)
	(goal WATER-MAP separated)
	(soldier-count >= 15)
	(civilian-population >= min-vills)
	(unit-type-count-total transport-ship < 3)
	(warboat-count > 4)
	(can-train transport-ship)
=>
	(train transport-ship))
;transport-ship
(defrule
	(goal MILITARY-TRAINING yes)
	(game-time > 900)
	(current-age == castle-age)
	(goal WATER-MAP separated)
	(soldier-count >= 15)
	(civilian-population >= min-vills)
	(unit-type-count-total transport-ship < 6)
	(warboat-count > 5)
	(can-train transport-ship)
=>
	(train transport-ship))
;transport-ship
(defrule
	(goal MILITARY-TRAINING yes)
	(game-time < 900)
	(current-age >= imperial-age)
	(goal WATER-MAP separated)
	(soldier-count >= 15)
	(civilian-population >= 30)
	(unit-type-count-total transport-ship < 4)
	(warboat-count > 2)
	(can-train transport-ship)
=>
	(train transport-ship)
)
;transport-ship (many)
(defrule
	(goal MILITARY-TRAINING yes)
	(game-time > 900)
	(current-age >= imperial-age)
	(goal WATER-MAP separated)
	(soldier-count >= 15)
	(civilian-population >= min-vills)
	(unit-type-count-total transport-ship < 8)
	(warboat-count > 5)
	(can-train transport-ship)
=>
	(train transport-ship)
)
;transport-ship (few)
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age >= castle-age)
(or	(goal WATER-MAP no) ;still possibility of needing transport ships
	(goal WATER-MAP connected))
	(soldier-count >= 20)
	(civilian-population >= 30)
	(unit-type-count-total transport-ship < 3)
	(unit-type-count warboat-count > 5)
	(can-train transport-ship)
=>
	(train transport-ship))

