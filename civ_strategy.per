(or	(current-age == castle-age)
	(goal castle-pending yes))
	(current-age-time > 5)
(or	(goal gl-castle-strategy 1)
	(goal ARCHER yes))
=>
	(chat-to-allies "Actually, going for knights instead.")
	(chat-local-to-self "Crossbows not available. Going for knights instead.")
	(set-goal KNIGHT yes)
	(set-goal ARCHER no)
	(disable-self)
)

