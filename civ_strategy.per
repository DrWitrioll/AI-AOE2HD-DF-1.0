;ENABLE SLINGERS
(defrule
	(current-age >= castle-age)
	(current-age-time > 5)
	(goal ARCHER no)
	(goal SLINGER no)
(or	(and	(goal UNIQUE-ENEMY-INFANTRY yes)
		(players-unit-type-count target-player my-unique-unit-line > 8))
(or	(players-unit-type-count target-player militiaman-line > 8)
(or	(players-unit-type-count target-player slinger > 9)
(or	(players-unit-type-count target-player condottiero > 8)
	(players-unit-type-count target-player eagle-warrior-line > 8)))))
	(soldier-count < 25) ;we need help
	(unit-available slinger)
=>
	(chat-to-player my-player-number "I'll focus on slingers.")
	(chat-to-allies "I'll focus on slingers.")
	(set-goal SLINGER yes))

;DISABLE SLINGERS
(defrule
	(current-age >= castle-age)
	(current-age-time > 10)
	(goal SLINGER yes)
	(goal UNIQUE-ENEMY-INFANTRY yes)
	(players-unit-type-count target-player my-unique-unit-line < 3) ;no longer a threat
	(players-unit-type-count target-player militiaman-line < 3)
	(players-unit-type-count target-player slinger < 3)
	(players-unit-type-count target-player eagle-warrior-line < 3)
	;(up-compare-goal my-mil-pop c:>= max-mil-pop)
	(unit-available slinger)
=>
	(chat-to-player my-player-number "Disabling slinger training.")
	(set-goal SLINGER no)
)

;SCOUT-CAVALRY (COUNTER UNIT)
(defrule
	(current-age >= castle-age)
	(current-age-time > 5)
	(goal my-civ-type non-meso)
(not	(civ-selected teutonic)) ;nothing above scout-cavalry
=>
	(set-goal SCOUT-CAVALRY yes)
	(disable-self))

;KNIGHT
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
(or	(civ-selected berbers)
;(or	(civ-selected briton)
(or	(civ-selected byzantine)
(or	(civ-selected frankish)
(or	(civ-selected hun)
;(or	(civ-selected khmer)
(or	(civ-selected magyar)
;(or	(civ-selected malay) removed
;(or	(civ-selected mongol) ;moved to steppe-lancers
(or	(civ-selected persian)
(or	(civ-selected spanish)
(or	(civ-selected teutonic)
	(civ-selected turkish)))))))))
=>
	(chat-to-player my-player-number "I'll focus on knights.")
	(chat-to-allies "I'll focus on knights.")
	(set-goal KNIGHT yes)
	(disable-self))

;EXTRA KNIGHT CIVS
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
;(or	(unit-available keshik-line); tatars steppe-lancer only for now
(or	(goal lithuanian-civ yes)
(or	(civ-selected slavic)
(or	(goal burgundian-civ yes)
;(or	(unit-available kipchak-line); cummans steppe-lancer only for now
(or	(goal bulgarian-civ yes)
(or	(goal pole-civ yes)
(or	(goal georgian-civ yes)
	(goal gurjara-civ yes))))))) ;for gurjara the (goal KNIGHT yes) works with shrivamsha riders (special rule above in this file ^)
=>
	(chat-to-player my-player-number "I'll focus on knights.") ;
	(chat-to-allies "I'll focus on knights.")
	(set-goal KNIGHT yes)
	(disable-self))

;BATTLE ELEPHANT
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
(or	(civ-selected burmese)
(or	(civ-selected khmer)
;(or	(civ-selected malay) they don't get any good cavalry blacksmith armour upgrades. Going archers!
(or	(civ-selected vietnamese) ;for now
	(goal bengali-civ yes))))
=>
	(chat-to-player my-player-number "I'll focus on battle elephants.")
	(chat-to-allies "I'll focus on battle elephants.")
	(set-goal BATTLE-ELEPHANT yes)
	(disable-self))


;STEPPE LANCER
(defrule
(or	(current-age >= imperial-age)
	(goal imperial-pending yes))
	(goal RESET-STRATEGY yes)
(or	(goal cuman-civ yes)
(or	(goal tatar-civ yes)
	(civ-selected mongol))) ;NEW
=>
	(chat-to-player my-player-number "I'll focus on steppe lancers.")
	(chat-to-allies "I'll focus on steppe lancers.")
	(set-goal STEPPE-LANCER yes)
	(disable-self))

;-----------------CIVS THAT CHANGE GENERAL UNIT-----------------------

;This will be where variable strategies are implemented in future updates

;----------------GO UNIQUE-UNIT ONLY INSTEAD OF GENERAL MILITARY----------------------

;PURSUE UNIQUE-INFANTRY-UNIT ONLY
(defrule
(goal sicilian-civ no); every civ BUT sicilians
(game-time > 15)
(current-age >= castle-age)
(up-compare-goal defend-castle == no)
(not (research-completed ri-two-handed-swordsman)); don't do this if we have invested
(goal unique-infantry-class yes); includes eagle civs which we want to train unique-units alongside eagles.
(goal SWORDMAN yes); doesnt stop eagle warriors.
(not (civ-selected frankish)); dont ever focus on only throwing axemen lol.
(building-type-count castle > 1); 2 castles is enough for production and to save for imperial age.
=>
(chat-to-player my-player-number "Stopping swordman goal to pursue unique infantry units.")
(set-goal SWORDMAN wait) ; wait and maybe are the only two current middle-ground values.
(set-goal MY-UNIQUE-UNIT yes))

;RE-ENABLE SWORD CLASS IF ONLY ONE CASTLE
(defrule
(goal sicilian-civ no); every civ BUT sicilians
(game-time > 15)
(current-age >= castle-age)
(goal unique-infantry-class yes)
(goal SWORDMAN wait)
(building-type-count castle < 2) ; only one castle or less.
=>
(chat-to-player my-player-number "Re-enabling swordman goal, not enough castles for unique-unit.")
(set-goal SWORDMAN yes))

	;This next section is turned off because as sicilian-civ, serjeant's are favoured automatically when:
	; goal SWORDMAN yes , donjon > 0 , and sicilian-civ yes.

;PURSUE UNIQUE-INFANTRY-UNIT ONLY ONE DONJON
;(defrule
;	(goal sicilian-civ yes)
;	(game-time > 15)
;	(current-age >= castle-age)
;(not	(research-completed ri-two-handed-swordsman)); don't do this if we have invested
;	(goal unique-infantry-class yes)
;	(goal SWORDMAN yes)
;	(goal SERJEANT-DONJON no)
;(or	(building-type-count donjon > 1); 2 donjon's is enough for production and to save for imperial age.
;(or	(building-type-count castle > 1); 2 castles
;	(and	(building-type-count donjon > 0); or one of each building.
;		(building-type-count castle > 0))))
;=>
;	(chat-to-player my-player-number "Stopping swordman goal to pursue serjeant's.")
;	(set-goal SWORDMAN wait) ; wait and maybe are the only two current middle-ground values.
;	(set-goal MY-UNIQUE-UNIT yes)
;	(set-goal SERJEANT-DONJON yes))

;RE-ENABLE SWORD CLASS IF ONLY ONE DONJON (or castle)
;(defrule
;	(goal sicilian-civ yes)
;	(game-time > 15)
;	(current-age >= castle-age)
;	(goal unique-infantry-class yes)
;	(goal SWORDMAN wait)
;	(goal SERJEANT-DONJON yes)
;(or	(and	(building-type-count castle < 1) ;0 castle
;		(building-type-count donjon < 2)) ;1 or 0 donjon
;	(and	(building-type-count castle < 2) ;1 or 0 castle
;		(building-type-count donjon < 1))) ;0 donjon
;=>
;	(chat-to-player my-player-number "Re-enabling swordman goal, not enough donjon's or castle's for serjeant's.")
;	(set-goal SERJEANT-DONJON no)
;	(set-goal MY-UNIQUE-UNIT no)
;	(set-goal SWORDMAN yes))

;PURSUE UNIQUE-ARCHER-UNIT ONLY
(defrule
(game-time > 15)
(current-age >= castle-age)
(up-compare-goal defend-castle == no)
(not (research-completed ri-arbalest)); don't do this if we invested in arbalest already
(goal unique-archer-class yes)
(goal ARCHER yes)
(building-type-count castle > 1)
=>
(chat-to-player my-player-number "Stopping archer goal to pursue unique archer units.")
(set-goal MY-UNIQUE-UNIT yes)
(set-goal ARCHER wait))

;RE-ENABLE ARCHER CLASS IF ONLY ONE CASTLE
(defrule
(game-time > 15)
(current-age >= castle-age)
(goal unique-archer-class yes)
(goal ARCHER wait)
(building-type-count castle < 2)
=>
(chat-to-player my-player-number "Re-enabling archer goal, not enough castles for unique-unit.")
(set-goal ARCHER yes))

;PURSUE UNIQUE-CAV-ARCHER-UNIT ONLY
(defrule
(game-time > 15)
(current-age >= castle-age)
(up-compare-goal defend-castle == no)
(not (research-completed ri-heavy-cavalry-archer))
(goal unique-cav-archer-class yes)
(goal CAV-ARCHER yes)
(not (civ-selected saracen)) ; saracens should still pursue archers for now.
(building-type-count castle > 1)
=>
(chat-to-player my-player-number "Stopping cav-archer goal to pursue unique cav-archer units.")
(set-goal MY-UNIQUE-UNIT yes)
(set-goal CAV-ARCHER wait))

;RE-ENABLE CAV-ARCHER CLASS IF ONLY ONE CASTLE
(defrule
(game-time > 15)
(current-age >= castle-age)
(goal unique-cav-archer-class yes)
(goal CAV-ARCHER wait)
(building-type-count castle < 2) ; only one castle or less.
=>
(chat-to-player my-player-number "Re-enabling cav-archer goal, not enough castles for unique-unit.")
(set-goal CAV-ARCHER yes))

;PURSUE UNIQUE-CAVALRY-UNIT ONLY
(defrule
(game-time > 15)
(current-age >= castle-age)
(up-compare-goal defend-castle == no)
(not (research-completed ri-paladin))
(not (research-completed ri-elite-shrivamsha-rider))
(not (civ-selected persian)) ; please no more big stampy fellas!!
(not (civ-selected frankish)); please no more beardy boys!
(goal unique-cavalry-class yes)
(goal KNIGHT yes)
(building-type-count castle >= 2)
=>
(chat-to-player my-player-number "Stopping knight goal to pursue unique cavalry units.")
(set-goal MY-UNIQUE-UNIT yes)
(set-goal KNIGHT wait))

;RE-ENABLE KNIGHT CLASS IF ONLY ONE CASTLE
(defrule
(game-time > 15)
(current-age >= castle-age)
(goal unique-cavalry-class yes)
(goal KNIGHT wait)
(building-type-count castle <= 1) ; only one castle or less.
=>
(chat-to-player my-player-number "Re-enabling knight goal instead of unique units.")
;(set-goal MY-UNIQUE-UNIT no) ;don't waste gold on both
(set-goal KNIGHT yes))

	;STOP PURSUING UNIQUE UNITS IF WE HAVE ALREADY HEAVILY INVESTED IN MAIN STRATEGY
(defrule
	(current-age >= imperial-age)
	(up-research-status c: my-unique-unit-upgrade < research-pending) ;we are not researching or have researched our elite upgrade
	(unit-type-count-total my-unique-unit-line < 10);not alot of unique-units
(or	(up-research-status c: ri-champion >= research-pending) ;we have best infantry upgrade
(or	(up-research-status c: ri-legionary >= research-pending) ;we have best roman infantry upgrade
(or	(up-research-status c: ri-elite-eagle-warrior >= research-pending) ;we have best eagle upgrade
(or	(up-research-status c: ri-arbalest >= research-pending) ;we have best archer upgrade
(or	(up-research-status c: ri-heavy-cavalry-archer >= research-pending) ;we have best cav-archer upgrade
(or	(up-research-status c: ri-elite-elephant-archer >= research-pending) ;we have best elephant-archer upgrade
(or	(up-research-status c: ri-paladin >= research-pending) ;we have best cavalry upgrade
(or	(up-research-status c: ri-elite-battle-elephant >= research-pending) ;we have best cavalry upgrade
(or	(up-research-status c: ri-elite-steppe-lancer >= research-pending) ;we have best cavalry upgrade
	(up-research-status c: ri-elite-shrivamsha-rider >= research-pending)))))))))) ;we have best gurjara cavalry upgrade
=>
	(up-jump-rule 1) ;skip enabling my unique unit line (unless we research the elite upgrade)
)

;ENABLE MY-UNIQUE UNIT
(defrule
	(current-age >= castle-age)
	(goal defend-castle no)
	(goal TRASH-UNITS no) ;don't reactivate if we are going trash units
	(goal MY-UNIQUE-UNIT no)
	;(up-research-status c: my-unique-unit-upgrade >= research-pending)) ;if we invested in them then pursue them
(not	(civ-selected persian)) ;they are just so not good lol
(not	(civ-selected frankish)) ;the axemen are ok sometimes but not going full knights into paladin is criminal
	(building-type-count castle >= 2)
=>
	(chat-to-player my-player-number "I'll focus on unique units.")
	(set-goal MY-UNIQUE-UNIT yes)
);end jump

;DISABLE MY-UNIQUE UNIT
(defrule
	(current-age >= castle-age)
	;(goal imperial-pending no)
	(current-age-time > 660) ;allow first castle time to get built and create some units
	(goal MY-UNIQUE-UNIT yes)
	(building-type-count castle <= 0) ;fix
=>
	(chat-to-player my-player-number "Stopping unique units.")
	(set-goal MY-UNIQUE-UNIT no)
)

;EAGLE-WARRIOR CLASS ISN'T DISABLED FOR UNIQUE UNITS FOR NOW


;Default Goals
;unique unit classes
(defrule
(true)
=>
(set-goal unique-infantry-class no)
(set-goal unique-archer-class no)
(set-goal unique-cavalry-class no)
(set-goal unique-cav-archer-class no)
(set-goal unique-eagle-class no)
(set-goal unique-siege-class no)
(set-goal unique-hand-cannoneer-class no)
(set-goal UNIQUE-ENEMY-INFANTRY no)
(set-goal UNIQUE-ENEMY-ARCHER no)
(set-goal UNIQUE-ENEMY-CAVALRY no)
(set-goal UNIQUE-ENEMY-CAV-ARCHER no)
(set-goal UNIQUE-ENEMY-SIEGE no)
(set-goal UNIQUE-ENEMY-HAND-CANNONEER no)
(disable-self))

;general military classes
(defrule
(true); start of game
=>
(set-goal SWORDMAN no)
(set-goal SPEARMAN no) ; COUNTER UNIT
(set-goal EAGLE-WARRIOR no)
(set-goal ARCHER no)
(set-goal SKIRMISHER no) ; COUNTER UNIT
(set-goal CAV-ARCHER no)
(set-goal FEUDAL-SCOUT-CAVALRY no)
(set-goal SCOUT-CAVALRY no) ; COUNTER UNIT
(set-goal KNIGHT no)
(set-goal CAMEL no) ; yes = counter, main = main strategy
(disable-self))

;continued
(defrule
(true)
=>
(set-goal BATTLE-ELEPHANT no)
(set-goal STEPPE-LANCER no)
(set-goal HAND-CANNONEER no)
(set-goal MONK no)
(set-goal CAVALRY-UNITS no)
(disable-self))

;INFANTRY START TRAINING BETWEEN DARK AND FEUDAL AGE
(defrule
(goal MILITARY-TRAINING yes)
(current-age == dark-age)
(goal SWORDMAN yes)
(goal FAST-CASTLE no)
(goal sicilian-civ no) ;SERJEANTS HAVE THEIR OWN RULES
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total villager > min-vills)

(can-train militiaman-line)
(unit-type-count-total militiaman-line < 4)
=>
(train militiaman-line))

	;DARK-AGE UNITS

	;DRUSH AND BEING DRUSHED RULES

;enable being drushed
(defrule
	(current-age == dark-age)
	(goal being-drushed no)
	(goal is-town-under-attack yes)
	(players-unit-type-count target-player militiaman > 1); assumes enemy uses militia only
=>
	;(chat-to-allies "12")
	(chat-to-allies "12 The enemy is drushing me!")
	(chat-local-to-self "Enemy drush detected.")
	(set-goal being-drushed yes)
	(disable-self)
)
;disable being drushed
(defrule
	(current-age >= feudal-age)
	(goal being-drushed yes)
=>
	(chat-local-to-self "No longer being drushed.")
	(set-goal being-drushed no)
)

;disable drush
(defrule
	(goal DRUSH yes)
	(current-age >= feudal-age)
=>
	(chat-local-to-self "Disabling drush.")
	(disable-self)
)

;drush defence
;(barracks will be built automatically from town-under-attack rules)
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age == dark-age)
	(goal being-drushed yes)
	(unit-type-count-total militiaman < 3)
	(can-train militiaman-line) ;use line just in case man-at-arms or others already researched (custom scenario?)
=>
	(train militiaman-line)
)

;drush offence
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age == dark-age)
	(goal DRUSH yes)
	(goal is-town-under-attack no)
	(unit-type-count-total militiaman-line < 4)
	(unit-type-count-total villager <= 24);stop drushing after 24 vils
	(can-train militiaman-line)
=>
	(train militiaman-line)
)

	;OFFENSIVE FEUDAL-AGE UNITS

;if sicilian, focus on serjeants instead
(defrule
	(goal SWORDMAN yes)
	(current-age == feudal-age)
	(goal sicilian-civ yes)
	(building-type-count donjon > 0)
=>
	(up-jump-rule 2))

;men-at-arms
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal SWORDMAN yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total militiaman-line < 3)
(can-train militiaman-line)
=>
(train militiaman-line))

;men-at-arms (only when man-at-arms is researching or researched)
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal SWORDMAN yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total militiaman-line > 2)
(unit-type-count-total militiaman-line < 10)
(or (up-research-status c: ri-man-at-arms == research-pending)
(research-completed ri-man-at-arms))
(can-train militiaman-line)
=>
(train militiaman-line)) ;end-jump

;eagle-warriors
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal EAGLE-WARRIOR yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total eagle-warrior-line < 10)
(can-train eagle-warrior-line)
=>
(train eagle-warrior-line))

;feudal archers
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal ARCHER yes)
(not (players-unit-type-count target-player skirmisher-line > 4))
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total archer-line < 20)
(can-train archer-line)
=>
(train archer-line))

;skirmisher support for feudal archers
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal ARCHER yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total archer-line >= 10)
(unit-type-count-total skirmisher-line < 8)				;enough to repel a skirm attack but not too many
(or	(not	(can-train archer-line))					;not enough resources to train, OR
			(unit-type-count-total archer-line > 10))	;we have more than 10 archers out
=>
(train skirmisher-line))

;feudal scouts
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal gurjara-civ no) ;they go camel scouts
(goal FEUDAL-SCOUT-CAVALRY yes)
(not (players-unit-type-count target-player spearman-line > 4)) ; temporary fix
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total scout-cavalry-line < 8)
(can-train scout-cavalry-line)
=>
(train scout-cavalry-line))

;feudal scouts (gurjara camel-scout)
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal gurjara-civ yes) ;they go camel scouts
(goal FEUDAL-SCOUT-CAVALRY yes)
(not (players-unit-type-count target-player spearman-line > 4)) ; temporary fix
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total camel-line < 8) ;special gurjara unit
(can-train camel-line)
=>
(train camel-line))

;feudal skirmishers
(defrule
(goal MILITARY-TRAINING yes)
(current-age == feudal-age)
(goal defend-feudal no)
(goal FEUDAL-SKIRMISHER yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total skirmisher-line < 12);10
(can-train skirmisher-line)
=>
(train skirmisher-line))

	;DEFENSIVE FEUDAL-AGE UNITS

;skirms and spears enabled by default for defense (when needed)

;low archers
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(players-unit-type-count target-player skirmisher-line < 4)
	(players-unit-type-count target-player archer-line < 4)
(or	(players-unit-type-count target-player militiaman-line >= 2)
(or	(players-unit-type-count target-player donjon-serjeant-line >= 2)
(or	(players-unit-type-count target-player serjeant-set >= 2)
	(players-unit-type-count target-player spearman-line >= 4)))) ;help our scouts out
	(unit-type-count-total archer-line < 4)
	(can-train archer-line)
=>
	(train archer-line)
)

;high archers
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(players-unit-type-count target-player skirmisher-line < 5)
	(players-unit-type-count target-player archer-line < 5)
(or	(players-unit-type-count target-player militiaman-line >= 5)
(or	(players-unit-type-count target-player donjon-serjeant-line >= 5)
(or	(players-unit-type-count target-player serjeant-set >= 5)
	(players-unit-type-count target-player spearman-line >= 8)))) ;help our scouts out
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count-total archer-line < 8) ;10
	(can-train archer-line)
=>
	(train archer-line)
)

;low serjeant
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(goal sicilian-civ yes)
	(players-unit-type-count target-player archer-line <= 8) ;ignore if decent archers are around
(or	(and	(goal UNIQUE-ENEMY-INFANTRY yes)
			(players-unit-type-count target-player my-unique-unit-line >= 1))
(or	(players-unit-type-count target-player skirmisher-line >= 6) ;turned it around so we pursue skirmishers instead of hide from them!
(or	(players-unit-type-count target-player militiaman-line >= 2)
(or	(players-unit-type-count target-player spearman-line >= 2) ;slaughter them for our cavalry
(or	(players-unit-type-count target-player eagle-warrior-line >= 2)
(or	(players-unit-type-count target-player battering-ram-line >= 1)
(or	(players-unit-type-count target-player armored-elephant-line >= 1)
	(players-unit-type-count target-player donjon-serjeant-line >= 2)))))))) ;mirror civ?
	(unit-type-count archer-line <= 4); not making enough archers
	(unit-type-count-total serjeant-set < 4)
	(can-train donjon-serjeant-line)
=>
	(train donjon-serjeant-line))

;high serjeant
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(goal sicilian-civ yes)
	(players-unit-type-count target-player archer-line <= 12) ;ignore our training if mass enemy archers
(or	(and	(goal UNIQUE-ENEMY-INFANTRY yes)
			(players-unit-type-count target-player my-unique-unit-line >= 5))
(or	(players-unit-type-count target-player skirmisher-line >= 12) ;kill em
(or	(players-unit-type-count target-player militiaman-line >= 5)
(or	(players-unit-type-count target-player spearman-line >= 5) ;kill em
(or	(players-unit-type-count target-player eagle-warrior-line >= 5)
(or	(players-unit-type-count target-player battering-ram-line >= 2)
(or	(players-unit-type-count target-player armored-elephant-line >= 2)
	(players-unit-type-count target-player donjon-serjeant-line >= 5))))))))
	(unit-type-count archer-line <= 8); not making archers
	(unit-type-count-total serjeant-set < 10)
	(can-train donjon-serjeant-line)
=>
	(train donjon-serjeant-line))

;if sicilian, focus on serjeants instead
(defrule
	(current-age == feudal-age)
	(goal sicilian-civ yes)
	(building-type-count donjon > 0)
=>
	(up-jump-rule 2))

;spearmen and skirmishers already have defensive rules

;low men-at-arms
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(goal my-civ-type non-meso) ;any civ that isn't aztec, mayan, or incan
	(players-unit-type-count target-player archer-line <= 8) ;ignore if decent archers are around
(or	(and	(goal UNIQUE-ENEMY-INFANTRY yes)
			(players-unit-type-count target-player my-unique-unit-line >= 1))
(or	(players-unit-type-count target-player skirmisher-line >= 6) ;turned it around so we pursue skirmishers instead of hide from them!
(or	(players-unit-type-count target-player militiaman-line >= 2)
(or	(players-unit-type-count target-player spearman-line >= 2) ;slaughter them for our cavalry
(or	(players-unit-type-count target-player eagle-warrior-line >= 2)
(or	(players-unit-type-count target-player battering-ram-line >= 1)
(or	(players-unit-type-count target-player armored-elephant-line >= 1)
	(players-unit-type-count target-player donjon-serjeant-line >= 2))))))))
	(unit-type-count archer-line <= 4); not making enough archers
	(unit-type-count-total militiaman-line < 4)
	(can-train militiaman-line)
=>
	(train militiaman-line)
)
;high men-at-arms
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(goal my-civ-type non-meso)
	(players-unit-type-count target-player archer-line <= 12) ;ignore our training if mass enemy archers
(or	(and	(goal UNIQUE-ENEMY-INFANTRY yes)
			(players-unit-type-count target-player my-unique-unit-line >= 5))
(or	(players-unit-type-count target-player skirmisher-line >= 12) ;kill em
(or	(players-unit-type-count target-player militiaman-line >= 5)
(or	(players-unit-type-count target-player spearman-line >= 5) ;kill em
(or	(players-unit-type-count target-player eagle-warrior-line >= 5)
(or	(players-unit-type-count target-player battering-ram-line >= 2)
(or	(players-unit-type-count target-player armored-elephant-line >= 2)
	(players-unit-type-count target-player donjon-serjeant-line >= 5))))))))
	(unit-type-count archer-line < 10); not making archers
	(unit-type-count-total militiaman-line < 10)
	(can-train militiaman-line)
=>
	(train militiaman-line)
) ;end jump

;low scouts
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(players-unit-type-count target-player spearman-line < 5) ;6
	(players-unit-type-count target-player camel-line < 5)
(or	(players-unit-type-count target-player archer-line > 2)
(or	(players-unit-type-count target-player skirmisher-line > 2)
(or	(players-unit-type-count target-player battering-ram-line > 0)
(or	(players-unit-type-count target-player mangonel-line > 0)
(or	(players-unit-type-count target-player armored-elephant-line > 0)
	(players-unit-type-count target-player scorpion-line > 0))))))
	(unit-type-count-total scout-cavalry-line < 2)
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
)

;high scouts
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
	(players-unit-type-count target-player spearman-line < 5) ;6
	(players-unit-type-count target-player camel-line < 5)
(or	(players-unit-type-count target-player archer-line > 5)
(or	(players-unit-type-count target-player skirmisher-line > 6)
(or	(players-unit-type-count target-player battering-ram-line > 1)
(or	(players-unit-type-count target-player armored-elephant-line > 1)
(or	(players-unit-type-count target-player mangonel-line > 2)
	(players-unit-type-count target-player scorpion-line > 2))))))
	(unit-type-count-total scout-cavalry-line < 5) ;6
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line)
)

;eagle-warriors
(defrule
	(goal MILITARY-TRAINING yes)
	(goal defend-feudal yes)
(or	(and	(goal is-town-under-attack yes)
		(strategic-number sn-military-level <= 1))
	(and	(goal is-town-under-attack no)
		(unit-type-count-total eagle-warrior-line < 8)))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(can-train eagle-warrior-line)
=>
	(train eagle-warrior-line)
)

;emergency spearman (feudal) when we cant train other melee units
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age == feudal-age)
(or	(goal is-town-under-attack yes)
	(town-under-attack))
(or	(players-unit-type-count target-player spearman-line > 3) ;fight trash with trash
	(players-unit-type-count target-player skirmisher-line > 3))
(not	(can-train militiaman-line))
(not	(can-train eagle-warrior-line))
(not	(can-train scout-cavalry-line))
	(unit-type-count-total spearman-line < 1) ;just one for now to help
	(can-train spearman-line)
=>
	(train spearman-line)
)

	;NEW Defensive Units (any-age)

	;These rules are just quick emergency short-term counters until other rules catch up (town under attack rules)
	;(Usually to counter pocket players raiding Jester's base, so just a quick reaction)

	;defensive camels

	;EMERGENCY CAMEL 1 (general cavalry counter) (LOW CAMELS)
(defrule
	(goal MILITARY-TRAINING yes)
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
			(up-unit-type-in-town c: my-unique-unit-line > 1))
(or	(up-unit-type-in-town c: scout-cavalry-line > 1) ;2 or more indicates most likely some investment worthy of countering
(or	(up-unit-type-in-town c: knight-line > 1)
(or	(up-unit-type-in-town c: camel-line > 1)
(or	(up-unit-type-in-town c: battle-elephant-line > 1)
(or	(up-unit-type-in-town c: steppe-lancer-line > 1)
(or	(up-unit-type-in-town c: krepost-konnik-line > 1)
	(up-unit-type-in-town c: shrivamsha-rider-line > 1))))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count spearman-line < 4) ;don't overdue camels if we have spears already
	(unit-type-count-total camel-line < 3); train some camels, other rules should catch up though
	(can-train camel-line)
=>
	;(chat-to-all "Countering cavalry in town with camels.")
	(train camel-line))

	;EMERGENCY CAMEL 2 (general cavalry counter) (MEDIUM CAMELS)
(defrule
	(goal MILITARY-TRAINING yes)
(or	(and	(goal UNIQUE-ENEMY-CAVALRY yes)
			(up-unit-type-in-town c: my-unique-unit-line > 7))
(or	(up-unit-type-in-town c: scout-cavalry-line > 8)
(or	(up-unit-type-in-town c: knight-line > 7)
(or	(up-unit-type-in-town c: camel-line > 7)
(or	(up-unit-type-in-town c: battle-elephant-line > 5)
(or	(up-unit-type-in-town c: steppe-lancer-line > 7)
(or	(up-unit-type-in-town c: krepost-konnik-line > 7)
	(up-unit-type-in-town c: shrivamsha-rider-line > 7))))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count spearman-line < 8) ;don't overdue camels if we have spears already
	(unit-type-count-total camel-line < 6); other rules should be caught up by now
	(can-train camel-line)
=>
	;(chat-to-all "Countering cavalry in town with camels.")
	(train camel-line))

