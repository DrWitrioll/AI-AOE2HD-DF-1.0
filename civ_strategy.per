;archer-line (no crossbow)
(defrule
(goal MILITARY-TRAINING yes)
(goal ARCHER yes)
(current-age >= castle-age)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-type-count-total archer-line < 12); NEW force crossbows
(can-train archer-line)
=>
(train archer-line))

;archer-line (with crossbow)
(defrule
(goal MILITARY-TRAINING yes)
(goal ARCHER yes)
(current-age >= castle-age)
(or (up-research-status c: ri-crossbow == research-pending) ;NEW only train full strength if researching or researched ri-crossbow
	(research-completed ri-crossbow))
(up-compare-goal my-mil-pop c:< max-mil-pop) ;back to full strength
(can-train archer-line)
=>
(train archer-line))

;cavalry-archer-line
(defrule
(goal bengali-civ no) ;elephant-archers
(goal dravidian-civ no) ;elephant-archers
(goal gurjara-civ no) ;elephant-archers
(goal MILITARY-TRAINING yes)
(current-age >= castle-age)
(goal CAV-ARCHER yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-available cavalry-archer-line)
(can-train cavalry-archer-line)
=>
(train cavalry-archer-line)
)

;elephant-archer-line
(defrule
(or	(goal bengali-civ yes) ;elephant-archers
(or	(goal dravidian-civ yes) ;elephant-archers
	(goal gurjara-civ yes))) ;elephant-archers
(goal MILITARY-TRAINING yes)
(current-age >= castle-age)
(goal CAV-ARCHER yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(unit-available elephant-archer-line)
(can-train elephant-archer-line)
=>
(train elephant-archer-line)
)

;CUMAN MERCENARY FREE KIPCHAKS
(defrule
(or	(can-train 1259)
	(can-train mercenary-kipchak))
=>
	(train 1259)
	(train mercenary-kipchak)
)

;non-meso civ temporary skirm, archer, or eagle counter ( >= castle-age) (knights) (low)
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age >= castle-age)
	(goal gurjara-civ no)
	(goal my-civ-type non-meso)
(or	(players-unit-type-count target-player archer-line >= 3) ;enemy is going hardcore range strat
(or	(players-unit-type-count target-player skirmisher-line >= 5)
	(players-unit-type-count target-player eagle-warrior-line >= 3)))
	(players-unit-type-count target-player spearman-line <= 8);don't do it if they're going heavy spears too
	(soldier-count < 30) ;we don't have a full army
	(unit-available knight-line) ;this will be helpful when we made a stable in feudal and can train just a couple to kill off the ranged units
	(unit-type-count-total knight-line < 3) ;hopefully enough to wipe them out
	(up-compare-goal my-mil-pop c:< max-mil-pop) ;backup
	(can-train knight-line)
=>
	(train knight-line)
)

