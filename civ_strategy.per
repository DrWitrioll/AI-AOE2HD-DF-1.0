	;SPECIAL HUSSAR RULE
(defrule
	(current-age >= imperial-age)
;(not	(unit-type-count-total paladin > 3)) ;we could run out of gold later so still train hussar alongside paladin
(or	(up-research-status c: ri-hussar == research-pending)
(or	(research-completed ri-hussar) ;FIXED now
	(unit-available ri-hussar)))
	(research-completed ri-hussar)
(or	(unit-type-count villager-gold < min-vills); avg 25
(or	(and	(goal WATER-MAP no)
		(unit-type-count trade-cart < 10)) ;not enough trade
	(and	(goal WATER-MAP connected)
	(and	(goal WATER-MAP separated)
		(unit-type-count trade-cog < 10)))))
=>
	(chat-to-allies "Focusing on Hussars.")
	(chat-local-to-self "Focusing on Hussars.")
;	(set-goal KNIGHT no) ;train knights alongside hussars
	(set-goal HUSSAR yes)
	(disable-self))

	;SPECIAL WINGED-HUSSAR RULE
(defrule
	(current-age >= imperial-age)
;(not	(unit-type-count-total paladin > 3)) ;we could run out of gold later so still train hussar alongside paladin
(or	(up-research-status c: ri-winged-hussar == research-pending)
(or	(research-completed ri-winged-hussar)
	(unit-available ri-winged-hussar)))
	(research-completed ri-winged-hussar)
(or	(unit-type-count villager-gold < min-vills); avg 25
(or	(and	(goal WATER-MAP no)
		(unit-type-count-total trade-cart < 10)) ;not enough trade
	(and	(goal WATER-MAP connected)
	(and	(goal WATER-MAP separated)
		(unit-type-count-total trade-cog < 10)))))
=>
	(chat-to-allies "Focusing on Winged Hussars.")
	(chat-local-to-self "Focusing on Winged Hussars.")
;	(set-goal KNIGHT no) ;train knights alongside hussars
	(set-goal HUSSAR yes) ;includes winged-hussars
	(disable-self))

