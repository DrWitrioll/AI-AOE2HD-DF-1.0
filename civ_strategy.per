;scout-cavalry-line COUNTER units
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SCOUT-CAVALRY yes)
	(current-age >= castle-age)
(or	(and	(or	(goal UNIQUE-ENEMY-ARCHER yes)
			(or	(goal UNIQUE-ENEMY-CAV-ARCHER yes)
			(or	(goal UNIQUE-ENEMY-SIEGE yes)
				(goal UNIQUE-ENEMY-HAND-CANNONEER yes))))
		(players-unit-type-count target-player my-unique-unit-line > 9))
(or	(players-unit-type-count target-player archer-line > 9)
(or	(players-unit-type-count target-player skirmisher-line > 9)
(or	(players-unit-type-count target-player genitour-line > 9)
	(players-unit-type-count target-player cavalry-archer-line > 9)))))
(soldier-count >= 15)
(can-train scout-cavalry-line)
(unit-type-count scout-cavalry-line < 8) ;10
=>
(train scout-cavalry-line))

;scout-cavalry-line COUNTER siege units
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SCOUT-CAVALRY yes)
	(current-age >= castle-age)
(or	(players-unit-type-count target-player armored-elephant-line > 0)
(or	(players-unit-type-count target-player battering-ram-line > 0)
(or	(players-unit-type-count target-player mangonel-line > 0)
(or	(players-unit-type-count target-player bombard-cannon-line > 0)
(or	(players-unit-type-count target-player hand-cannoneer > 0)
	(players-unit-type-count target-player scorpion-line > 1))))))
(soldier-count >= 15)
(can-train scout-cavalry-line)
(unit-type-count scout-cavalry-line < 8) ;10
=>
(train scout-cavalry-line))

;scout-cavalry-line-castle (train alongside cavalry)
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age >= castle-age)
	(goal SCOUT-CAVALRY yes)
(or	(and	(or	(goal unique-cavalry-class yes)
				(goal unique-cav-archer-class yes))
				(unit-type-count-total my-unique-unit-line > 10)) ;usually only 2 castles producing at this point
(or	(unit-type-count-total knight-line > 20)
(or	(unit-type-count-total camel-line > 14)
(or	(unit-type-count-total battle-elephant-line > 14)
(or	(unit-type-count-total shrivamsha-rider-line > 20)
	(unit-type-count-total steppe-lancer-line > 20))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count scout-cavalry-line < 10) ;10
	(can-train scout-cavalry-line)
=>
	(train scout-cavalry-line))

;emergency late-game scout-cavalry-line
(defrule
(goal MILITARY-TRAINING yes)
(game-time > 3600)
(or	(goal SCOUT-CAVALRY yes)
	(goal TRASH-UNITS yes))
(or (unit-type-count-total skirmisher-line > 10)
	(unit-type-count-total spearman-line > 10))
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train scout-cavalry-line)
=>
(train scout-cavalry-line))

;main strategy scout-cavalry-line (indians only) temp (scale-barding no)
(defrule
(goal MILITARY-TRAINING yes)
(current-age >= castle-age)
(goal SCOUT-CAVALRY main)
(nor (up-research-status c: ri-scale-barding == research-pending)
	(research-completed ri-scale-barding))
(unit-type-count-total scout-cavalry-line < 8)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train scout-cavalry-line)
=>
(train scout-cavalry-line))

