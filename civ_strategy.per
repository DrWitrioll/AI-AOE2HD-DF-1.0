	(current-age >= castle-age)
	(players-unit-type-count target-player my-unique-unit-line <= 5) ;more leniency
	(players-unit-type-count target-player skirmisher-line <= 4)
	(players-unit-type-count target-player genitour-line <= 4)
	(players-unit-type-count target-player mangonel-line <= 2)
	(players-unit-type-count target-player scorpion-line <= 2)
	(players-unit-type-count target-player knight-line <= 4)
	(players-unit-type-count target-player scout-cavalry-line <= 5)
	(players-unit-type-count target-player steppe-lancer-line <= 4)
	(players-unit-type-count target-player battle-elephant-line <= 4)
	(players-unit-type-count target-player hand-cannoneer <= 4)
	(players-unit-type-count target-player eagle-warrior-line <= 5)
=>
