	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(players-unit-type-count target-player hussite-wagon-line >= 16)
(or	(players-unit-type-count target-player ballista-elephant-line >= 16)
(or	(players-unit-type-count target-player war-wagon-line >= 16)
	(players-unit-type-count target-player organ-gun-line >= 16))))
	(unit-type-count-total mangonel-line < 4)
