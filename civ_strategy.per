;CASTLE-AGE STRATEGIES

;random selection for now

;==========;NON MESO;==========;

(defrule
(or		(current-age == castle-age)
(and	(goal RESET-STRATEGY yes);only for first time enable of random castle strategy
		(goal castle-pending yes)))
(not	(civ-selected aztec))
(not	(civ-selected mayan))
(not	(civ-selected incan))
	(goal castle-strategy-selected no)
=>
	(chat-local-to-self "Choosing a castle strategy.")
	(set-goal RESET-STRATEGY yes)
	(generate-random-number 6) ;get a random number from 1 to 6
	(up-get-fact random-number 0 gl-castle-strategy) ;store the random number into gl-castle-strategy
	(disable-self)
)

;non-meso strategies
;1 - crossbows
(defrule
(or	(current-age == castle-age)
	(goal castle-pending yes))
	(goal my-civ-type non-meso)
	(goal ARCHER no)
	(current-age-time > 3)
	(goal gl-castle-strategy 1)
	(goal castle-strategy-selected no)
=>
