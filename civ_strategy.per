(not	(map-type arena)) ;no flushing for now on these maps
(not	(map-type fortress))
	(goal feudal-strategy-selected no)
=>
	(chat-local-to-self "Choosing a strategy.")
	(generate-random-number 8) ;get a random number from 1 to 8
