(or		(goal ARCHER yes)
		(and	(goal MY-UNIQUE-UNIT yes)
				(or	(goal unique-infantry-class yes)
					(goal unique-archer-class yes)))))
(or	(players-unit-type-count target-player composite-bowman-line >= 10)
(or	(players-unit-type-count target-player longbowman-line >= 9)
(or	(players-unit-type-count target-player chu-ko-nu-line >= 10)
(or	(players-unit-type-count target-player genoese-crossbowman-line >= 10)
(or	(players-unit-type-count target-player plumed-archer-line >= 9)
(or	(players-unit-type-count target-player rattan-archer-line >= 9)
	(players-unit-type-count target-player janissary-line >= 10)))))))
