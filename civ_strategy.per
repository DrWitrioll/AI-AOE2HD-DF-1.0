;====================================================================================

	;SPECIFIC UNIT TAUNT STRATEGIES

	; DRUSH yes
(defrule
	(goal feudal-pending no)
	(current-age == dark-age)
	(taunt-detected any-ally 76)
	(goal DRUSH no)
=>
	(acknowledge-taunt this-any-ally 76)
	(chat-to-player this-any-ally "I will drush the enemy at once!")
	(set-goal DRUSH yes)
); don't disable rule

; DRUSH yes (from self for testing purposes)
(defrule
	(goal feudal-pending no)
	(current-age == dark-age)
	(taunt-detected my-player-number 76)
	(goal DRUSH no)
=>
	(acknowledge-taunt my-player-number 76)
	(chat-to-player my-player-number "I will drush the enemy at once!")
	(set-goal DRUSH yes)
); don't disable rule

; already drushing
(defrule
	(goal feudal-pending no)
	(current-age == dark-age)
	(taunt-detected any-ally 76)
	(goal DRUSH yes)
=>
	(acknowledge-taunt this-any-ally 76)
	(chat-to-player this-any-ally "I am already drushing.")
); don't disable rule

(defrule
	(goal feudal-pending no)
	(current-age == dark-age)
	(taunt-detected my-player-number 76)
	(goal DRUSH yes)
=>
	(acknowledge-taunt my-player-number 76)
	(chat-to-player my-player-number "I am already drushing.")
); don't disable rule

; can't drush anymore (from self)
(defrule
(or	(current-age > dark-age)
	(goal feudal-pending yes))
	(taunt-detected my-player-number 76)
=>
	(acknowledge-taunt my-player-number 76)
	(chat-to-player my-player-number "It's too late to drush anymore.")
); don't disable rule

; can't drush anymore
(defrule
(or	(current-age > dark-age)
	(goal feudal-pending yes))
	(taunt-detected any-ally 76)
=>
	(acknowledge-taunt this-any-ally 76)
	(chat-to-player this-any-ally "It's too late to drush anymore.")
); don't disable rule

	;TRUSH yes
(defrule
	(taunt-detected any-ally 83)
	(current-age > dark-age)
	(goal TRUSH no)
=>
	(acknowledge-taunt this-any-ally 83)
	(chat-to-player this-any-ally "I will trush the enemy!")
	(set-goal TRUSH yes)
);don't disable rule

;TRUSH no
(defrule
	(taunt-detected any-ally 83)
	(current-age > dark-age)
	(goal TRUSH yes)
=>
	(acknowledge-taunt this-any-ally 83)
	(chat-to-player this-any-ally "I will stop trushing.")
	(set-goal TRUSH no)
); don't disable rule

;safe TRUSH disable
(defrule
(or	(goal castle-pending yes)
(and	(current-age == feudal-age)
	(current-age-time > 1200)))
	(goal TRUSH yes)
=>
	(chat-local-to-self "Disabling trushing.")
	(set-goal TRUSH no)
); dont disable rule


