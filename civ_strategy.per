	(disable-self)
)

;can flush? no
(defrule
	(game-time > 15)
	(goal WATER-MAP separated)
=>
;	(chat-local-to-self "Flushing not possible on this map.")
	(set-goal can-flush no)
	(disable-self)
)

;only drush and trush supported with taunts for strategy (until further updates)
;TAUNT STRATEGY RULES
(defrule ;from a taunt
(current-age <= feudal-age)
(current-age-time <= 55)
(goal feudal-strategy-selected no)
(or	(goal DRUSH yes)
(or	(goal TRUSH yes)
(or	(goal SWORDMAN yes)
(or	(goal EAGLE-WARRIOR yes)
(or	(goal ARCHER yes)
(or	(goal FEUDAL-SCOUT-CAVALRY yes)
(or	(goal FEUDAL-SKIRMISHER yes)
	(goal FAST-CASTLE yes))))))))
=>
	(set-goal feudal-strategy-selected yes)
	(chat-local-to-self "Strategy selected.")
	(disable-self)
)

;FEUDAL-AGE STRATEGIES

	;MEME-STRATEGY 1 (ENABLE THIS TO RE-ENABLE THE MEME) => also go to Jester.per and delete the ";" on the liar chat messages to trigger too (they were disabled because I already use too many chat string messages for this ai lol)
;(defrule
;	(current-age <= feudal-age)
;	(game-time > 10)
;(or	(goal WATER-MAP no)
;	(goal WATER-MAP connected))
;	(goal MEME-STRATEGY no)
;	(civ-selected malay)
;=>
;	(chat-local-to-self "THE LIAR MEME STRATEGY SELECTED.")
;	(set-goal feudal-strategy-selected yes)
;	(set-goal castle-strategy-selected yes)
;	(set-goal MEME-STRATEGY 1);malay elephants
;	(set-goal counter-units no)
;	(set-goal FAST-CASTLE yes) ;testing
;	(set-goal BATTLE-ELEPHANT yes)
;	(up-change-name "MSG IN MY MOUTH")
;	(disable-self)
;)

	;garrison elephants
(defrule
	(goal MEME-STRATEGY 1)
	(current-age-time < 600)
	(unit-type-count-total battle-elephant < 10)
=>
	(up-gather-inside c: stable c: 1)
)

(defrule
	(goal MEME-STRATEGY 1)
(or	(current-age-time > 600)
	(unit-type-count-total battle-elephant >= 10))
=>
	(up-gather-inside c: stable c: 0)
)

	;prevent meme-strategy 1 from being disabled
(defrule
	(goal MEME-STRATEGY 1);malay elephants
	(current-age <= castle-age)
	(goal imperial-pending no)
	(goal BATTLE-ELEPHANT no)
=>
;	(chat-local-to-self "The show must go on.")
	(set-goal BATTLE-ELEPHANT yes)
	;(set-goal counter-units no)
)

	;prevent villager training meme-strategy 1
(defrule
	(goal MEME-STRATEGY 1)
	(goal VILLAGER yes)
	(unit-type-count-total villager >= 40)
=>
;	(chat-local-to-self "Disabling villagers.")
	(set-goal VILLAGER no)
	(disable-self)
)

	;re-enable counter units
(defrule
	(goal MEME-STRATEGY 1)
	(goal counter-units no)
	(unit-type-count battle-elephant >= 30)
=>
;	(chat-local-to-self "Enabling counter units.")
	(set-goal counter-units yes)
	(disable-self)
)

	;meme-strategy 1 escrow release
(defrule
	(goal MEME-STRATEGY 1)
(or	(escrow-amount food > 200)
	(escrow-amount gold > 200))
=>
;	(chat-local-to-self "Releasing meme escrow.")
	(release-escrow food)
	(release-escrow gold)
)

	;its time to stop
(defrule
	(goal MEME-STRATEGY 1)
(or	(strategic-number sn-military-level <= -3) ;-4
	(game-time > 1900))
=>
;	(chat-local-to-self "Okay. It's time to stop.")
	(set-goal MEME-STRATEGY no)
	(set-goal VILLAGER yes)
	(disable-self)
)

;initial random strategies (based on whether civ is a meso civ or not, and if they are a pocket player or not)

; Emergency feudal-age strategy (meso or non meso civs) (pocket or flank) - BACKUP RULE IF NO STRATEGY IS SELECTED
(defrule
	(current-age <= feudal-age); important as we dont want to change castle or imp strategies here
	(goal castle-pending no) ;dont potentially change our castle strategy
	(current-age-time > 25);important ;20
	(current-age-time <= 60)
(or	(goal can-flush no) ;usually water-maps for now
	(goal feudal-strategy-selected no))
	(up-compare-goal FAST-CASTLE != yes) 
=>
	(chat-to-allies "Going for fast-castle.")
	(chat-local-to-self "Going for fast-castle.")
	(set-goal feudal-strategy-selected yes)
	(set-goal FAST-CASTLE yes)
	(disable-self)
)

;==========;non-meso POCKET strategies;==========;
(defrule
	(current-age <= feudal-age)
	(current-age-time > 10)
	(goal position-goal pocket); pocket strategies
(not	(civ-selected aztec)) ;these 3 conditions are the same as: (goal my-civ-type non-meso) , and the opposite is: (goal my-civ-type meso) ;aztec, mayan, and incan
(not	(civ-selected mayan))
(not	(civ-selected incan))
	(goal feudal-strategy-selected no)
=>
	(chat-local-to-self "Choosing a strategy.")
	(generate-random-number 4) ;get a random number from 1 to 4
	(up-get-fact random-number 0 gl-pocket-strategy) ;store the random number into gl-feudal-strategy
	(disable-self)
)

;1 - pocket - fast-castle
(defrule
	(current-age <= feudal-age)
	(goal position-goal pocket)
	(goal my-civ-type non-meso)
	(current-age-time > 15)
	(goal gl-pocket-strategy 1)
=>
	(chat-to-allies "Going for fast-castle.")
	(chat-local-to-self "Going for fast-castle.")
	(set-goal FAST-CASTLE yes)
	(set-goal feudal-strategy-selected yes)
	;(set-goal castle-strategy-selected yes) ;should decide later
	(disable-self)
)

;2 - pocket - fast-castle into unique units
(defrule
	(current-age <= feudal-age)
	(goal position-goal pocket)
	(goal my-civ-type non-meso)
	(current-age-time > 15)
	(goal gl-pocket-strategy 2)
=>
	(chat-to-allies "Going for fast-castle into unique units.")
	(chat-local-to-self "Going for fast-castle into unique-units.")
	(set-goal FAST-CASTLE yes)
	(set-goal need-castle yes)
	(set-goal MY-UNIQUE-UNIT yes)
	(set-goal feudal-strategy-selected yes)
	(set-goal castle-strategy-selected yes)
	(disable-self)
)

;3 - pocket - fast-castle into cavalry units
(defrule
	(current-age <= feudal-age)
	(goal position-goal pocket)
	(goal my-civ-type non-meso)
	(goal CAVALRY-UNITS no)
	(current-age-time > 15)
	(goal gl-pocket-strategy 3)
=>
	(chat-to-allies "Going for fast-castle into cavalry units.")
	(chat-local-to-self "Going for fast-castle into cavalry units.")
	(set-goal FAST-CASTLE yes)
	(set-goal CAVALRY-UNITS yes)
	(set-goal feudal-strategy-selected yes)
	(set-goal castle-strategy-selected yes)
	(disable-self)
)

;4 - siege-rush
(defrule
	(current-age <= feudal-age)
	(goal position-goal pocket)
	(goal my-civ-type non-meso)
	(goal SIEGE-RUSH no)
	(current-age-time > 15)
	(goal gl-pocket-strategy 4)
=>
	(chat-to-allies "Going for siege-rush.")
	(chat-local-to-self "Going for siege-rush.")
	(set-goal FAST-CASTLE yes)
	(set-goal SIEGE-RUSH yes)
	(set-goal feudal-strategy-selected yes)
	(set-goal castle-strategy-selected yes)
	(disable-self)
)

;==========;meso POCKET strategies;==========;
(defrule
	(current-age <= feudal-age)
	(current-age-time > 10)
	(goal position-goal pocket)
(or	(civ-selected aztec) ;(goal my-civ-type meso)
(or	(civ-selected mayan)
	(civ-selected incan)))
	(goal feudal-strategy-selected no)
=>
	(chat-local-to-self "Choosing a strategy.")
	(generate-random-number 3) ;get a random number from 1 to 3
