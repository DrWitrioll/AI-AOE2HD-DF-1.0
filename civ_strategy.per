	(unit-type-count villager > min-vills)
	(unit-type-count-total skirmisher-line < 20)
	(can-train skirmisher-line)
=>
	;(chat-to-all "Countering with skirms in town.")
	(train skirmisher-line))

	;EMERGENCY SKIRMISHER 4 (DOOMED LEVEL skirms)
(defrule
	(goal MILITARY-TRAINING yes)
(or		(goal UNIQUE-ENEMY-ARCHER yes) ;longbowmen & all foot archer unique-units
(or		(goal UNIQUE-ENEMY-CAV-ARCHER yes) ;war wagons & all cav-archer unique-units
(or		(goal UNIQUE-ENEMY-SIEGE yes) ;organ-guns & hussite-wagons
		(goal UNIQUE-ENEMY-HAND-CANNONEER yes)))) ;janissary's
	(up-unit-type-in-town c: my-unique-unit-line > 30)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total skirmisher-line < 30); train some skirms, other rules should catch up though
	(can-train skirmisher-line)
=>
	;(chat-to-all "Countering with skirms in town.")
	(train skirmisher-line))

	;EMERGENCY SKIRMISHER 4 EXTRA (DOOMED LEVEL skirms)
(defrule
	(goal MILITARY-TRAINING yes)
(or	(up-unit-type-in-town c: archer-line > 30)
(or	(up-unit-type-in-town c: skirmisher-line > 35)
(or	(up-unit-type-in-town c: cavalry-archer-line > 30)
(or	(up-unit-type-in-town c: hand-cannoneer > 30)
(or	(up-unit-type-in-town c: slinger > 30)
(or	(up-unit-type-in-town c: genitour-line > 30)
	(up-unit-type-in-town c: elephant-archer-line > 20)))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total skirmisher-line < 30)
	(can-train skirmisher-line)
=>
	;(chat-to-all "Countering with skirms in town.")
	(train skirmisher-line))


;CASTLE-UNITS STRATEGY

;siege units are FIRST in this list so that after each script pass it will favour training siege units more (it was training too many units before considering siege)

;SIEGE UNITS (NEW main strategy)

	;BATTERING RAM & ARMORED ELEPHANTS
;Level 1
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SIEGE-RUSH yes)
	(current-age >= castle-age)
	(up-compare-goal my-mil-pop c:< max-mil-pop) ;prevents going over predetermined amount
	(unit-type-count scorpion-line >= 15)
	(unit-type-count mangonel-line >= 2)
	(unit-type-count battering-ram-line < 4)
	(can-train battering-ram-line)
=>
	(train battering-ram-line))

;ARMORED-ELEPHANT-LINE
;LEVEL 1
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SIEGE-RUSH yes)
	(current-age >= castle-age)
	(up-compare-goal my-mil-pop c:< max-mil-pop) ;prevents going over predetermined amount
	(unit-type-count scorpion-line >= 15)
	(unit-type-count mangonel-line >= 2)
	(unit-type-count armored-elephant-line < 4)
	(can-train armored-elephant-line)
=>
	(train armored-elephant-line))

	;SCORPION
;Level 1 (few)
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SIEGE-RUSH yes)
	(current-age >= castle-age)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count scorpion-line <= 10)
	(can-train scorpion-line)
=>
	(train scorpion-line))

;Level 2 (many)
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SIEGE-RUSH yes)
	(current-age >= castle-age)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count scorpion-line <= 40) ;MAX 
	(unit-type-count mangonel-line >= 4)
	(can-train scorpion-line)
=>
	(train scorpion-line))

	;MANGONEL
;Level 1
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SIEGE-RUSH yes)
	(current-age >= castle-age)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count scorpion-line >= 9)
	(unit-type-count mangonel-line <= 5)
	(can-train mangonel-line)
=>
	(train mangonel-line))
;Level 2
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SIEGE-RUSH yes)
	(current-age >= castle-age)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count scorpion-line >= 25)
	(unit-type-count mangonel-line <= 9) ;MAX
	(can-train mangonel-line)
=>
	(train mangonel-line)
)

;REGULAR SIEGE UNITS
;battering-ram-line
;armored-elephant-line

;feudal cuman battering ram
(defrule
(current-age == feudal-age)
(goal MILITARY-TRAINING yes)
(or (goal FLUSH yes)
(enemy-buildings-in-town)); only build rams in the feudal if ai is flushing (otherwise rams won't attack) or if enemy-buildings-in-town.
(unit-type-count-total battering-ram-line < 2) ;ignore armored-elephant
(strategic-number sn-military-level > 1) ;2
;(up-compare-goal my-mil-pop c:< max-siege-pop) ;bad condition
(up-compare-goal my-mil-pop c:< max-mil-pop) ;using generic military goal instead
(can-train battering-ram-line)
=>
(train battering-ram-line))

;(1st set) (battering-ram)
(defrule
(current-age >= castle-age)
(goal MILITARY-TRAINING yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(goal is-town-under-attack no); was training too many rams when town was under attack
(or	(strategic-number sn-military-level >= 1) ;train at least 1 ram if we are ahead or attacking
	(goal ATTACK yes))
(can-train battering-ram-line)
(unit-type-count battering-ram-line <= 1)
=>
(train battering-ram-line))

;(1st set) (armored-elephant)
(defrule
(current-age >= castle-age)
(goal MILITARY-TRAINING yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(goal is-town-under-attack no); was training too many elephants when town was under attack
(or	(strategic-number sn-military-level >= 1) ;train at least 1 armored-elephant if we are ahead or attacking
	(goal ATTACK yes))
(unit-type-count armored-elephant-line <= 1)
(can-train armored-elephant-line)
=>
(train armored-elephant-line))

;(2nd set) (battering-ram)
(defrule
(current-age >= castle-age)
(goal MILITARY-TRAINING yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(goal is-town-under-attack no)
(strategic-number sn-military-level >= 2) ;3
(unit-type-count battering-ram-line <= 4)
(can-train battering-ram-line)
=>
(train battering-ram-line))

;(2nd set) (armored-elephant)
(defrule
(current-age >= castle-age)
(goal MILITARY-TRAINING yes)
(goal is-town-under-attack no)
(strategic-number sn-military-level >= 2) ;3
(unit-type-count armored-elephant-line <= 4)
(can-train armored-elephant-line)
=>
(train armored-elephant-line))

;(3rd set) (battering-ram)
(defrule
(current-age >= castle-age)
(goal MILITARY-TRAINING yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(goal is-town-under-attack no)
(strategic-number sn-military-level >= 3) ;4
(can-train battering-ram-line)
(unit-type-count battering-ram-line <= 7) ;8
=>
(train battering-ram-line))

;(3rd set) (armored-elephant)
(defrule
(current-age >= castle-age)
(goal MILITARY-TRAINING yes)
(goal is-town-under-attack no)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(strategic-number sn-military-level >= 3) ;4
(can-train armored-elephant-line)
(unit-type-count armored-elephant-line <= 7) ;8
=>
(train armored-elephant-line))

;EMERGENCY battering-ram-line
(defrule
(goal MILITARY-TRAINING yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(enemy-buildings-in-town)
(unit-type-count villager > min-vills)
(unit-type-count-total battering-ram-line < 2)
(can-train battering-ram-line)
=>
(train battering-ram-line))

;EMERGENCY armored-elephant-line
(defrule
(goal MILITARY-TRAINING yes)
(up-compare-goal my-mil-pop c:< max-mil-pop)
(enemy-buildings-in-town)
(unit-type-count villager > min-vills)
(unit-type-count-total armored-elephant-line < 2)
(can-train armored-elephant-line)
=>
(train armored-elephant-line))

;need aggressive battering-ram-line
(defrule
	(goal MILITARY-TRAINING yes)
	(goal is-town-under-attack no)
	(building-type-count town-center > 0)
(or	(and	(strategic-number sn-military-level >= 3)
			(soldier-count > 10))
	(goal EMERGENCY-ATTACK yes))
	(unit-type-count-total battering-ram-line < 3)
	(up-can-train 0 c: battering-ram-line)
=>
	(up-train 0 c: battering-ram-line)
)

;need aggressive armored-elephant-line
(defrule
	(goal MILITARY-TRAINING yes)
	(goal is-town-under-attack no)
	(building-type-count town-center > 0)
	(strategic-number sn-military-level >= 3)
(or	(and	(strategic-number sn-military-level >= 3)
			(soldier-count > 10))
	(goal EMERGENCY-ATTACK yes))
	(unit-type-count-total armored-elephant-line < 3)
	(up-can-train 0 c: armored-elephant-line)
=>
	(up-train 0 c: armored-elephant-line)
)

	;SIEGE DEFENCE - mangonels for MANY units, scorpions for FEW

(defrule
	(goal position-goal pocket)
=>
	(up-jump-rule 5)
)
;mangonel-line COUNTER (part 1)
(defrule
	(current-age >= castle-age)
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(goal UNIQUE-ENEMY-ARCHER yes)
	(or	(goal UNIQUE-ENEMY-CAV-ARCHER yes)
		(or	(goal UNIQUE-ENEMY-SIEGE yes)
				(goal UNIQUE-ENEMY-HAND-CANNONEER yes))))
	(players-unit-type-count target-player my-unique-unit-line > 9)
	(unit-type-count-total mangonel-line < 1);2
	(can-train mangonel-line)
=>
	(train mangonel-line))

;mangonel-line COUNTER (part 2)
(defrule
	(current-age >= castle-age)
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(players-unit-type-count target-player archer-line > 9)
(or	(players-unit-type-count target-player skirmisher-line > 9)
(or	(players-unit-type-count target-player cavalry-archer-line > 9)
(or	(players-unit-type-count target-player hand-cannoneer > 9)
(or	(players-unit-type-count target-player slinger > 9)
(or	(players-unit-type-count target-player genitour-line > 9)
(or	(players-unit-type-count target-player elephant-archer-line > 7)
(or	(players-unit-type-count target-player mangonel-line > 1)
	(players-unit-type-count target-player scorpion-line > 1)))))))))
	(unit-type-count skirmisher-line < 10) ;insufficient skirms
	(unit-type-count scorpion < 4) ;insufficient scorpions
	(unit-type-count-total mangonel-line < 1);2
	(can-train mangonel-line)
=>
	(train mangonel-line))

;scorpion-line COUNTER (part 1)
(defrule
	(current-age >= castle-age)
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(strategic-number sn-military-level < 1); obtain superiority
(or	(goal UNIQUE-ENEMY-ARCHER yes)
	(or	(goal UNIQUE-ENEMY-CAV-ARCHER yes)
		(or	(goal UNIQUE-ENEMY-SIEGE yes)
				(goal UNIQUE-ENEMY-HAND-CANNONEER yes))))
	(players-unit-type-count target-player my-unique-unit-line > 5)
	(players-unit-type-count target-player knight-line <= 3);don't make if there are knights
	(players-unit-type-count target-player shrivamsha-rider-line <= 3) ;or shrivamsha
	(players-unit-type-count target-player mangonel-line < 2); dont make if there are mangonels
	(unit-type-count-total scorpion-line < 3) ;6
	(can-train scorpion-line)
=>
	(train scorpion-line)
)
;scorpion-line COUNTER (part 2)
(defrule
	(goal MILITARY-TRAINING yes)
	(current-age >= castle-age)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(players-unit-type-count target-player archer-line > 5)
(or	(players-unit-type-count target-player skirmisher-line > 5)
(or	(players-unit-type-count target-player cavalry-archer-line > 5)
(or	(players-unit-type-count target-player hand-cannoneer > 5)
(or	(players-unit-type-count target-player slinger > 5)
(or	(players-unit-type-count target-player genitour-line > 5)
	(players-unit-type-count target-player elephant-archer-line > 3)))))))
	(players-unit-type-count target-player scorpion-line < 3) ;let mangonels deal with these
	(players-unit-type-count target-player knight-line < 2)
	(players-unit-type-count target-player shrivamsha-rider-line <= 3)
	(players-unit-type-count target-player mangonel-line < 2); dont make if there are some mangonels
	(unit-type-count-total scorpion-line < 3); just enough to stop the threat
	(can-train scorpion-line)
=>
	(train scorpion-line)
)
;need-siege-workshop goal (1) (defensive)
(defrule
	(current-age >= castle-age)
	(goal need-siege-workshop no)
(or	(and	(or	(goal UNIQUE-ENEMY-ARCHER yes)
			(or	(goal UNIQUE-ENEMY-CAV-ARCHER yes)
			(or	(goal UNIQUE-ENEMY-SIEGE yes)
				(goal UNIQUE-ENEMY-HAND-CANNONEER yes))))
				(players-unit-type-count target-player my-unique-unit-line > 9)) ;all were at 5 before
(or	(players-unit-type-count target-player archer-line > 9)
(or	(players-unit-type-count target-player skirmisher-line > 9)
(or	(players-unit-type-count target-player cavalry-archer-line > 7)
(or	(players-unit-type-count target-player hand-cannoneer > 7)
(or	(players-unit-type-count target-player mangonel-line > 1)
	(players-unit-type-count target-player scorpion-line > 3))))))) ;2
	(building-type-count town-center > 0) ;IMPORTANT FOR TC RULES
	(building-type-count-total siege-workshop < 1)
=>
(chat-to-player my-player-number "Need a defensive siege workshop.")
(set-goal need-siege-workshop yes)
); don't disable
;end jump

;need siege workshop (2) (aggressive)
(defrule
	(goal need-siege-workshop no)
	(building-type-count-total town-center > 1)
	(strategic-number sn-military-level >= 3)
	(soldier-count >= 10);minimum number of military land units
	(building-type-count-total siege-workshop < 1)
=>
	(chat-local-to-self "Need an aggressive siege workshop.")
	(set-goal need-siege-workshop yes)
)

;reset need-siege-workshop goal
(defrule
	(goal need-siege-workshop yes)
	(building-type-count siege-workshop > 0)
=>
	(chat-local-to-self "Siege workshop complete.")
	(set-goal need-siege-workshop no)
); don't disable

;turn off need-siege-workshop goal if no town-center
(defrule
	(goal need-siege-workshop yes)
	(building-type-count town-center < 0)
=>
;	(chat-local-to-self "Disabling need-siege-workshop goal to prioritize town-center.")
	(set-goal need-siege-workshop no)
); don't disable

;reset need-castle goal
(defrule
	(goal need-castle yes)
	(building-type-count castle > 0)
=>
	(chat-local-to-self "Castle complete.")
	(set-goal need-castle no)
	(disable-self);for now
)

