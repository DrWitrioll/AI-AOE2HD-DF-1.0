;==========unique siege counter==========

;BASIC UNQIUE SIEGE COUNTER FOR BOTH POCKETS AND FLANKS

;need siege workshop (for unique siege enemy units)
(defrule
	(up-compare-goal need-siege-workshop != no)
	(soldier-count < 30) ;only worry about this if we have a small army
(or	(players-unit-type-count target-player hussite-wagon-line >= 3)	;enemy is starting to create unique siege, need to counter
(or	(players-unit-type-count target-player ballista-elephant-line >= 3)
(or	(players-unit-type-count target-player war-wagon-line >= 3)
	(players-unit-type-count target-player organ-gun-line >= 3))))
	(building-type-count-total siege-workshop < 1)
	(building-type-count town-center > 0)
=>
	(set-goal need-siege-workshop yes)
)

;low
(defrule
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(players-unit-type-count target-player hussite-wagon-line >= 2)
(or	(players-unit-type-count target-player ballista-elephant-line >= 2)
(or	(players-unit-type-count target-player war-wagon-line >= 2)
	(players-unit-type-count target-player organ-gun-line >= 2))))
	(unit-type-count-total mangonel-line < 1)
	(can-train mangonel-line)
=>
	(train mangonel-line)
)

;medium-low
(defrule
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
(or	(players-unit-type-count target-player hussite-wagon-line >= 6)
(or	(players-unit-type-count target-player ballista-elephant-line >= 6)
(or	(players-unit-type-count target-player war-wagon-line >= 6)
	(players-unit-type-count target-player organ-gun-line >= 6))))
	(unit-type-count-total mangonel-line < 2)
	(can-train mangonel-line)
=>
	(train mangonel-line)
)

;medium
