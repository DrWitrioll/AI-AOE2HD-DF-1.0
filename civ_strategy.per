(or		(goal UNIQUE-ENEMY-CAV-ARCHER yes) ;war wagons & all cav-archer unique-units
(or		(goal UNIQUE-ENEMY-SIEGE yes) ;organ-guns & hussite-wagons
		(goal UNIQUE-ENEMY-HAND-CANNONEER yes)))) ;janissary's
	(up-unit-type-in-town c: my-unique-unit-line > 0)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total skirmisher-line < 3); train some skirms, other rules should catch up though
	(can-train skirmisher-line)
