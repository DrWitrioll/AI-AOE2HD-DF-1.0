(or		(goal SWORDMAN yes)							;pockets only counter if going infantry, foot archers, siege, OR unique-units that are infantry, foot archers, or siege
(or		(goal ARCHER yes)
(or		(goal SIEGE-RUSH yes)
		(and	(goal MY-UNIQUE-UNIT yes)
				(or	(goal unique-infantry-class yes)
				(or	(goal unique-archer-class yes)
					(goal unique-siege-class yes)))))))
(or	(players-unit-type-count target-player tarkan-set >= 1)
(or	(players-unit-type-count target-player keshik-line >= 1)
(or	(players-unit-type-count target-player coustillier-line >= 1) ;burgundian
(or	(players-unit-type-count target-player monaspa-line >= 1) ;georgian
	(players-unit-type-count target-player centurion-line >= 1))))) ;roman
	(unit-type-count-total spearman-line < spear-low) ;3
	(can-train spearman-line)
=>
	(train spearman-line)
