;genitour-line LEVEL 1
(defrule
	(goal MILITARY-TRAINING yes)
	(goal GENITOUR yes)
	(goal SKIRM-TYPE GENITOUR)
(or		(goal UNIQUE-ENEMY-ARCHER yes) ;longbowmen & all foot archer unique-units
(or		(goal UNIQUE-ENEMY-CAV-ARCHER yes) ;war wagons & all cav-archer unique-units
(or		(goal UNIQUE-ENEMY-SIEGE yes) ;organ-guns & hussite-wagons
		(goal UNIQUE-ENEMY-HAND-CANNONEER yes)))) ;janissary's
	(players-unit-type-count target-player my-unique-unit-line > 0)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total genitour-line <= skirm-low) ;3 ;skirms are either skirmishers or genitours (specific numbers are in the constants.per)
	(can-train genitour-line)
=>
	(train genitour-line))

