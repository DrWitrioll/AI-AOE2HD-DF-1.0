;PAUSE CAV-ARCHER OR ELEPHANT-ARCHER AGAINST UNIQUE-UNITS (1) (castle-age)
(defrule
(goal CAV-ARCHER yes) ;includes cavalry-archer-line & elephant-archer-line
(current-age >= castle-age)
(or		(goal UNIQUE-ENEMY-ARCHER yes)
(or		(goal UNIQUE-ENEMY-CAV-ARCHER yes)
(or		(goal UNIQUE-ENEMY-SIEGE yes)
		(goal UNIQUE-ENEMY-HAND-CANNONEER yes))))
		(players-unit-type-count target-player my-unique-unit-line >= 8)
	(unit-type-count cavalry-archer-line <= 15)
	(unit-type-count elephant-archer-line <= 15)
=>
(chat-local-to-self pause-archers)
(set-goal CAV-ARCHER maybe))

