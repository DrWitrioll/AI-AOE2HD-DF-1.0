(or	(players-unit-type-count target-player hand-cannoneer >= 9)
	(players-unit-type-count target-player eagle-warrior-line >= 11))))))))))
	(unit-type-count cavalry-archer-line <= 15)
	(unit-type-count elephant-archer-line <= 15)
=>
