;=============================Specific strategy fix (fixes)

	;cavalry-units temp fix
(defrule
	(game-time > 120)
	(current-age <= castle-age)
	(goal imperial-pending no)
	(goal my-civ-type non-meso)
(or	(goal gl-feudal-strategy 9)
(or	(goal gl-castle-strategy 2)
	(goal gl-pocket-strategy 3))) ;cavalry-units
	(goal castle-strategy-selected yes) ;was previously activated
	(goal imperial-strategy-selected no);fix
	(goal KNIGHT no)
	(goal BATTLE-ELEPHANT no)
	(goal STEPPE-LANCER no);indicates one of them was turned off
=>
	(chat-to-player my-player-number "Re-enabling cavalry-unit strategy.")
	(set-goal CAVALRY-UNITS yes)
	(disable-self))

	;unique-units temp fix
(defrule
	(game-time > 120)
	(current-age <= castle-age)
(or	(goal gl-pocket-strategy 2);both meso and non meso goal
	(goal gl-feudal-strategy 6));both meso and non-meso goal
	;(goal gl-castle-strategy );no castle strategy for this
	(goal MY-UNIQUE-UNIT no)
	(goal castle-strategy-selected yes); important
	(goal imperial-strategy-selected no);fix
=>
	(chat-to-player my-player-number "Re-enabling my-unique-unit training.")
	(set-goal need-castle yes) ;re-enable this too
	(set-goal MY-UNIQUE-UNIT yes)
	(disable-self))

		;siege-units temp fix (meso)
(defrule
	(goal my-civ-type meso)
	(game-time > 120)
	(current-age <= castle-age)
;(or	(goal gl-pocket-strategy 4)
(or	(goal gl-pocket-strategy 3)
	(goal gl-feudal-strategy 8))
	;(goal gl-castle-strategy );no castle strategy for this
	(goal SIEGE-RUSH no)
	(goal castle-strategy-selected yes); important
	(goal imperial-strategy-selected no);fix
=>
	(chat-to-player my-player-number "Re-enabling siege-rush strategy.")
	(set-goal SIEGE-RUSH yes)
	(disable-self))

		;siege-units temp fix (non-meso)
(defrule
	(goal my-civ-type non-meso)
	(game-time > 120)
	(current-age <= castle-age)
(or	(goal gl-pocket-strategy 4) ;verified
	(goal gl-feudal-strategy 12))
	;(goal gl-castle-strategy );no castle strategy for this
	(goal SIEGE-RUSH no)
	(goal castle-strategy-selected yes); important
	(goal imperial-strategy-selected no);fix
=>
	(chat-to-player my-player-number "Re-enabling siege-rush strategy.")
	(set-goal SIEGE-RUSH yes)
	(disable-self))

	;safety disable siege-rush normally
(defrule
(or	(current-age >= imperial-age)
(or	(goal imperial-pending yes)
	(goal defend-castle yes)))
	(current-age-time > 5)
	(goal SIEGE-RUSH yes)
=>
	(set-goal SIEGE-RUSH no))

