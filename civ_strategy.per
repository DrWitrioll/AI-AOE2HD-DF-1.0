(goal KNIGHT yes)
(goal gurjara-civ no)
(or	(up-research-status c: ri-scale-barding >= research-pending)
	(research-completed ri-scale-barding))
(up-compare-goal my-mil-pop c:< max-mil-pop)
(can-train knight-line)
=>
