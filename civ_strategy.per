(or	(players-unit-type-count target-player archer-line > 39)
(or	(players-unit-type-count target-player skirmisher-line > 39)
(or	(players-unit-type-count target-player cavalry-archer-line > 36)
(or	(players-unit-type-count target-player hand-cannoneer > 35)
(or	(players-unit-type-count target-player slinger > 35)
(or	(players-unit-type-count target-player genitour-line > 40)
	(players-unit-type-count target-player elephant-archer-line > 31)))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total genitour-line <= skirm-high) ;45
	(can-train genitour-line)
=>
	(train genitour-line))

;genitour-line LEVEL 6
(defrule
	(goal MILITARY-TRAINING yes)
	(goal GENITOUR yes)
	(goal SKIRM-TYPE GENITOUR)
(or		(goal UNIQUE-ENEMY-ARCHER yes) ;longbowmen & all foot archer unique-units
(or		(goal UNIQUE-ENEMY-CAV-ARCHER yes) ;war wagons & all cav-archer unique-units
(or		(goal UNIQUE-ENEMY-SIEGE yes) ;organ-guns & hussite-wagons
		(goal UNIQUE-ENEMY-HAND-CANNONEER yes)))) ;janissary's
	(players-unit-type-count target-player my-unique-unit-line > 55)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total genitour-line <= skirm-max) ;60
	(can-train genitour-line)
=>
	(train genitour-line))

;genitour-line LEVEL 6 extra
(defrule
(goal MILITARY-TRAINING yes)
(goal GENITOUR yes)
(goal SKIRM-TYPE GENITOUR)
(or	(players-unit-type-count target-player archer-line > 55)
(or	(players-unit-type-count target-player skirmisher-line > 55)
(or	(players-unit-type-count target-player cavalry-archer-line > 50)
(or	(players-unit-type-count target-player hand-cannoneer > 48)
(or	(players-unit-type-count target-player slinger > 48)
(or	(players-unit-type-count target-player genitour-line > 55)
	(players-unit-type-count target-player elephant-archer-line > 44)))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total genitour-line <= skirm-max) ;60
	(can-train genitour-line)
=>
	(train genitour-line))

;PAUSE ARCHER-LINE AGAINST UNIQUE-UNITS (1) (feudal-age)
(defrule
	(goal ARCHER yes)
	(current-age == feudal-age)
(or		(goal UNIQUE-ENEMY-ARCHER yes) ;longbowmen & all foot archer unique-units
(or		(goal UNIQUE-ENEMY-CAV-ARCHER yes) ;war wagons & all cav-archer unique-units
(or		(goal UNIQUE-ENEMY-SIEGE yes) ;organ-guns & hussite-wagons
		(goal UNIQUE-ENEMY-HAND-CANNONEER yes)))) ;janissary's
		(players-unit-type-count target-player my-unique-unit-line >= 5) ;more leniency
	(unit-type-count archer-line <= 10) ;alive archers
=>
	(chat-local-to-self pause-archers)
	(set-goal ARCHER maybe))

;PAUSE ARCHER-LINE (2) (feudal-age)
(defrule
	(goal ARCHER yes)
	(current-age == feudal-age)
(or	(players-unit-type-count target-player skirmisher-line >= 3)
(or	(players-unit-type-count target-player genitour-line >= 3)
(or	(players-unit-type-count target-player mangonel-line >= 2)
(or	(players-unit-type-count target-player scorpion-line >= 2)
(or	(players-unit-type-count target-player knight-line >= 2)
(or	(players-unit-type-count target-player scout-cavalry-line >= 4)
(or	(players-unit-type-count target-player steppe-lancer-line >= 3)
(or	(players-unit-type-count target-player battle-elephant-line >= 3)
(or	(players-unit-type-count target-player hand-cannoneer >= 4)
	(players-unit-type-count target-player eagle-warrior-line >= 4))))))))))
	(unit-type-count archer-line <= 10)
=>
	(chat-local-to-self pause-archers)
	(set-goal ARCHER maybe))

;RESET ARCHER-LINE (3) (feudal-age)
(defrule
	(goal ARCHER maybe)
	(current-age == feudal-age)
	(players-unit-type-count target-player my-unique-unit-line <= 5) ;more leniency
	(players-unit-type-count target-player skirmisher-line <= 2)
	(players-unit-type-count target-player genitour-line <= 2)
	(players-unit-type-count target-player mangonel-line <= 1)
	(players-unit-type-count target-player scorpion-line <= 1)
	(players-unit-type-count target-player knight-line <= 1)
	(players-unit-type-count target-player scout-cavalry-line <= 2)
	(players-unit-type-count target-player steppe-lancer-line <= 1)
	(players-unit-type-count target-player battle-elephant-line <= 1)
	(players-unit-type-count target-player hand-cannoneer <= 2)
	(players-unit-type-count target-player eagle-warrior-line <= 2)
=>
	(set-goal ARCHER yes)
	(chat-local-to-self resume-archers))

