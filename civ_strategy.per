;==========UNIQUE FOOT ARCHERS, CAVALRY ARCHERS, & SIEGE COUNTERS==========
;----------SKIRMISHERS----------
;==========POCKETS
;----------unique foot archers (and hand-cannoneer) counter----------
;----------POCKET NORMAL----------
;low skirm (pocket)
(defrule
	(goal position-goal pocket)
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(goal SKIRM-TYPE SKIRM)
(or		(goal SWORDMAN yes)							;pockets only counter if going infantry, foot archers, OR unique-units that are infantry, foot archers
(or		(goal ARCHER yes)
		(and	(goal MY-UNIQUE-UNIT yes)
				(or	(goal unique-infantry-class yes)
					(goal unique-archer-class yes)))))
(or	(players-unit-type-count target-player composite-bowman-line >= 1)
(or	(players-unit-type-count target-player longbowman-line >= 1)
(or	(players-unit-type-count target-player chu-ko-nu-line >= 1)
(or	(players-unit-type-count target-player genoese-crossbowman-line >= 1)
(or	(players-unit-type-count target-player plumed-archer-line >= 1)
(or	(players-unit-type-count target-player rattan-archer-line >= 1)
	(players-unit-type-count target-player janissary-line >= 1)))))))
	(unit-type-count-total skirmisher-line < skirm-low) ;3
	(can-train skirmisher-line)
=>
	(train skirmisher-line)
)
;medium-low (pocket)
(defrule
	(goal position-goal pocket)
	(goal MILITARY-TRAINING yes)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(goal SKIRM-TYPE SKIRM)
(or		(goal SWORDMAN yes)
(or		(goal ARCHER yes)
		(and	(goal MY-UNIQUE-UNIT yes)
				(or	(goal unique-infantry-class yes)
					(goal unique-archer-class yes)))))
(or	(players-unit-type-count target-player composite-bowman-line >= 3)
(or	(players-unit-type-count target-player longbowman-line >= 3)
(or	(players-unit-type-count target-player chu-ko-nu-line >= 3)
(or	(players-unit-type-count target-player genoese-crossbowman-line >= 3)
(or	(players-unit-type-count target-player plumed-archer-line >= 3)
(or	(players-unit-type-count target-player rattan-archer-line >= 3)
	(players-unit-type-count target-player janissary-line >= 3)))))))
	(unit-type-count-total skirmisher-line < skirm-medium-low) ;7
	(can-train skirmisher-line)
=>
	(train skirmisher-line)
)
