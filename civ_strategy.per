)

;------------------------------MY UNIQUE CIV UNIT CLASSES------------------------------
;UNIQUE UNIT INFANTRY CLASS
(defrule
	(game-time > 5) ;bugs out if you don't do this idk why!
	(or (civ-selected aztec)
	(or (civ-selected celtic)
	(or (civ-selected ethiopian)
	(or (civ-selected frankish)
	(or (civ-selected gothic)
	(or (civ-selected incan)
	(or (civ-selected japanese)
	(or (civ-selected malay)
	(or (civ-selected malian)
	(or (civ-selected teutonic)
	(or (civ-selected viking)
	(or	(civ-selected indian)
	(or (goal pole-civ yes) ;NEW DE CIV
	(goal sicilian-civ yes))))))))))))))
=>
	(chat-to-player my-player-number "My unique unit is infantry.")
	(set-goal unique-infantry-class yes)
	(disable-self))

