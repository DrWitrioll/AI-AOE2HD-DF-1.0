		(goal UNIQUE-ENEMY-HAND-CANNONEER yes)))) ;janissary's
	(players-unit-type-count target-player my-unique-unit-line > 55)
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total skirmisher-line < skirm-max) ;60
	(can-train skirmisher-line)
=>
	(train skirmisher-line))

;skirmisher-line LEVEL 6 extra
(defrule
	(goal MILITARY-TRAINING yes)
	(goal SKIRMISHER yes)
	(goal SKIRM-TYPE SKIRM)
(or	(players-unit-type-count target-player archer-line > 55)
(or	(players-unit-type-count target-player skirmisher-line > 55) ;prevent skirm wars
(or	(players-unit-type-count target-player cavalry-archer-line > 50)
(or	(players-unit-type-count target-player hand-cannoneer > 50)
(or	(players-unit-type-count target-player slinger > 50)
(or	(players-unit-type-count target-player genitour-line > 50)
	(players-unit-type-count target-player elephant-archer-line > 45)))))))
	(up-compare-goal my-mil-pop c:< max-mil-pop)
	(unit-type-count villager > min-vills)
	(unit-type-count-total skirmisher-line < skirm-max) ;60
	(can-train skirmisher-line)
=>
	(train skirmisher-line)
)
