;----------aggressive-castle gathering (high food + gold)----------
(defrule
(goal REACTIVE-GATHERING no)
(goal BOOM no);indicates aggressive behaviour
(goal castle-pending yes)
(goal need-castle no)
(or	(goal SWORDMAN yes);infantry
(or	(goal EAGLE-WARRIOR yes)
(or (goal KNIGHT yes)
(or (goal BATTLE-ELEPHANT yes)
(or (goal STEPPE-LANCER yes)
(or (goal CAMEL main)
	(goal SCOUT-CAVALRY main)))))))
=>
(set-strategic-number sn-food-gatherer-percentage 40) ;45
(set-strategic-number sn-wood-gatherer-percentage 32) ;25
(set-strategic-number sn-gold-gatherer-percentage 28)
(set-strategic-number sn-stone-gatherer-percentage 0)
)

;aggressive-castle gathering (high wood + gold)
(defrule
(goal REACTIVE-GATHERING no)
(goal BOOM no);indicates aggressive behaviour
(goal castle-pending yes)
(goal need-castle no)
(or	(goal ARCHER yes)
(or	(goal CAV-ARCHER yes)
	(goal SIEGE-RUSH yes)))
=>
(set-strategic-number sn-food-gatherer-percentage 25)
(set-strategic-number sn-wood-gatherer-percentage 45)
(set-strategic-number sn-gold-gatherer-percentage 30)
(set-strategic-number sn-stone-gatherer-percentage 0)
)

