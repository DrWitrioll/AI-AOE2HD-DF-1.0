	;castle-age and imperial-age farming
;FARM
(defrule
	(up-compare-goal WATER-MAP != separated) ;not a full water map
	(current-age >= castle-age)
	(current-age-time >= 10) ;allow buildings first
(or	(wood-amount >= 300) ;stable wood
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0))
	(idle-farm-count <= 1) ;1 extra farm
	(up-pending-objects c: farm < 3) ; only build 3 farms at a time max
	(can-build farm)
=>
	(build farm)
)

	;EMERGENCY CASTLE AND IMPERIAL FARMS
(defrule
	(up-compare-goal WATER-MAP != separated) ;not a full water map
	(current-age >= castle-age)
	(current-age-time >= 120) ;safety
	(unit-type-count-total villager > min-vills) ;avg 25 min vills
(or	(wood-amount >= 500) ;stable wood
	(and	(wood-amount >= 300)
			(dropsite-min-distance wood <= 7)))
	(building-type-count town-center > 0)
	(building-type-count-total farm < 14) ;10
	(can-build farm)
=>
	(build farm)
)

	;FARMS for full water maps
;dark-age
(defrule
	(goal WATER-MAP separated) ;full water map
	(current-age <= dark-age)
	(sheep-and-forage-too-far)
(or	(wood-amount >= 300) ;stable wood
	(dropsite-min-distance wood <= 7))
(or	(unit-type-count-total fishing-ship < 4)
(or	(building-type-count dock < 1)
	(unit-type-count villager-food < 10)))
	(building-type-count town-center > 0)
	(building-type-count-total farm < 3)
	(up-pending-objects c: farm < 1)
	(idle-farm-count <= 1)
	(can-build farm)
=>
	(build farm))

;feudal-age
(defrule
	(goal WATER-MAP separated) ;full water map
	(current-age == feudal-age)
	(sheep-and-forage-too-far)
(or	(wood-amount >= 300) ;stable wood
	(dropsite-min-distance wood <= 7))
(or	(unit-type-count-total fishing-ship < 9)
	(building-type-count dock < 1))
	(building-type-count town-center > 0)
	(building-type-count-total farm < 6) ;max
	(up-pending-objects c: farm < 2)
	(idle-farm-count <= 1)
	(can-build farm)
=>
	(build farm))

;castle and imperial age
;minimal
(defrule
	(goal WATER-MAP separated) ;full water map
	(current-age >= castle-age)
	(sheep-and-forage-too-far)
(or	(wood-amount >= 300) ;stable wood
	(dropsite-min-distance wood <= 7))
	(unit-type-count-total fishing-ship < 11)
	(building-type-count town-center > 0)
	(building-type-count-total farm < 20) ;minimal
	(up-pending-objects c: farm < 2); max 2
	(idle-farm-count <= 1)
	(can-build farm)
=>
	(build farm))

;maximum (normal amount in a land map game)
(defrule
	(goal WATER-MAP separated) ;full water map
	(current-age >= castle-age)
	(sheep-and-forage-too-far)
(or	(wood-amount >= 300) ;stable wood
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 0)
(or	(unit-type-count-total fishing-ship < 4) ;really need more food
	(building-type-count dock < 1)) ;no drop-off
	(up-pending-objects c: farm < 2)
	(idle-farm-count <= 1)
	(can-build farm)
=>
	(build farm))

(defrule
	(goal WATER-MAP separated) ;full water map
	(game-time > 1800) ;30 mins
	(current-age >= castle-age)
	(sheep-and-forage-too-far)
(or	(wood-amount >= 300) ;stable wood
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 2) ;established
	(civilian-population >= max-vill-pop) ;go max farms at this point
	(up-pending-objects c: farm < 2)
	(idle-farm-count <= 1)
	(can-build farm)
=>
	(build farm))

	;FEUDAL-AGE GATHERING

;NORMAL FEUDAL-AGE GATHERING (usually fast-castle) (LOW GOLD)
(defrule
(goal REACTIVE-GATHERING no)
(goal castle-pending no)
(goal FLUSH no)
(goal TRUSH no)
(goal need-castle no)
(goal defend-feudal no)
(unit-type-count-total villager > 20) ;min vil-pop is under 20 ;(19)
(gold-amount < 200)
(current-age == feudal-age)
(current-age-time < 120) ;first 2 minutes of age-up
=>
(set-strategic-number sn-food-gatherer-percentage 53)	;52 ;avg 14 vils	;this is the best formula for fast-castle for humans, ai arent perfect so prefer a little more wood
(set-strategic-number sn-wood-gatherer-percentage 40)	;38 ;avg 10 vils
(set-strategic-number sn-gold-gatherer-percentage 7)	;10 ;avg 3 vils
(set-strategic-number sn-stone-gatherer-percentage 0)
)

;HIGH FOOD AND WOOD (LOW GOLD)
(defrule
(goal REACTIVE-GATHERING no)
(goal castle-pending no)
(goal FLUSH no)
(goal TRUSH no)
(goal need-castle no)
(goal defend-feudal no)
(unit-type-count-total villager > 20)
(current-age == feudal-age)
(current-age-time > 120)
(food-amount > 800)
(wood-amount > 400)
(gold-amount < 200)
=>
(set-strategic-number sn-food-gatherer-percentage 39) ;40
(set-strategic-number sn-wood-gatherer-percentage 28) ;30
(set-strategic-number sn-gold-gatherer-percentage 33)
(set-strategic-number sn-stone-gatherer-percentage 0) ;0
)
