;===========================REACTIVE GATHERING RULES (just a gathering strategy)==========================

;=========CONDITION 1a: NEED A TOWN CENTER=========

	;any-age
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1); no tc
	(wood-amount < 275); need tc wood
=>
	(set-strategic-number sn-food-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage 100)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;
(defrule
	(goal REACTIVE-GATHERING yes)
	(building-type-count-total town-center < 1); no tc
	(wood-amount >= 275); good on wood
	(stone-amount < 100) ;need tc stone
=>
	(set-strategic-number sn-food-gatherer-percentage 0)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 100)
)


;=========CONDITION 1b: LAND GATHERING=========

	;dark-age (land) (normal) 1
(defrule
	(goal REACTIVE-GATHERING yes);SPECIAL GATHERING STRATEGIES
	(goal WATER-MAP no)
	(goal being-drushed no)
	(goal DRUSH no)
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(wood-amount > 30);good on wood
	(unit-type-count villager <= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 100)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;dark-age (land) (low-wood) 1
(defrule
	(goal REACTIVE-GATHERING yes)
	(goal WATER-MAP no)
	(goal being-drushed no)
	(goal DRUSH no)
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(wood-amount < 30);low wood
	(unit-type-count villager <= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 25)
	(set-strategic-number sn-wood-gatherer-percentage 75)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;dark-age (land) (normal) 2
(defrule
	(goal REACTIVE-GATHERING yes)
	(goal WATER-MAP no)
	(goal being-drushed no)
	(goal DRUSH no)
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(strategic-number sn-food-gatherer-percentage != 75)
	(strategic-number sn-wood-gatherer-percentage != 25)
	(current-age == dark-age)
	(unit-type-count villager >= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 75)
	(set-strategic-number sn-wood-gatherer-percentage 25)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

;=========CONDITION 2: WATER-GATHERING=========
	;dark-age (water) (normal) 1
(defrule
	(goal REACTIVE-GATHERING yes)
(or	(goal WATER-MAP separated)
	(goal WATER-MAP connected))
	(goal being-drushed no)
	(goal DRUSH no)
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(strategic-number sn-food-gatherer-percentage != 100);testing
	(unit-type-count villager <= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 100)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;dark-age (water) (low-wood) 1
(defrule
	(goal REACTIVE-GATHERING yes)
(or	(goal WATER-MAP separated)
	(goal WATER-MAP connected))
	(goal being-drushed no)
	(goal DRUSH no)
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(wood-amount < 30);low wood
	(unit-type-count villager <= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 25)
	(set-strategic-number sn-wood-gatherer-percentage 75)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;dark-age (water) (normal) 2
(defrule
	(goal REACTIVE-GATHERING yes)
(or	(goal WATER-MAP separated)
	(goal WATER-MAP connected))
	(goal being-drushed no)
	(goal DRUSH no)
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(strategic-number sn-food-gatherer-percentage != 100);testing
	(unit-type-count villager > 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 65)
	(set-strategic-number sn-wood-gatherer-percentage 35)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

;=========CONDITION 3: DRUSH=========
	;dark-age (drush or being drushed)

	;dark-age (land) (drush) 1
(defrule
	(goal REACTIVE-GATHERING yes)
;	(goal WATER-MAP no) ;map-type doesnt matter
(or	(goal being-drushed yes)
	(goal DRUSH yes))
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(unit-type-count villager <= 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 80)
	(set-strategic-number sn-wood-gatherer-percentage 20)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;dark-age (land) (drush) (need baracks) 
(defrule
	(goal REACTIVE-GATHERING yes)
;	(goal WATER-MAP no) ;map-type doesnt matter
(or	(goal being-drushed yes)
	(goal DRUSH yes))
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(building-type-count barracks < 1)
	(unit-type-count villager > 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 60)
	(set-strategic-number sn-wood-gatherer-percentage 40)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;dark-age (land) (drush) (have baracks) 
(defrule
	(goal REACTIVE-GATHERING yes)
;	(goal WATER-MAP no) ;map-type doesnt matter
(or	(goal being-drushed yes)
	(goal DRUSH yes))
	(goal feudal-pending no)
	(building-type-count-total town-center > 0)
	(current-age == dark-age)
	(building-type-count barracks > 0)
	(unit-type-count villager > 6)
=>
	(set-strategic-number sn-food-gatherer-percentage 65)
	(set-strategic-number sn-wood-gatherer-percentage 32)
	(set-strategic-number sn-gold-gatherer-percentage 3)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

;=========CONDITION 4: ADVANCE TO FEUDAL-AGE=========

	;FAST-CASTLE

	;advancing to feudal-age (flush no) (low gold)
(defrule
	(goal REACTIVE-GATHERING yes)
	(goal feudal-pending yes)
	(goal FAST-CASTLE yes)
	(goal TRUSH no)
	(goal need-castle no);no stone needed
	(building-type-count-total town-center > 0)
	(gold-amount < 200);need gold still
=>
	(set-strategic-number sn-food-gatherer-percentage 50)
	(set-strategic-number sn-wood-gatherer-percentage 45)
	(set-strategic-number sn-gold-gatherer-percentage 5)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;advancing to feudal-age (flush no) (high gold)
(defrule
	(goal REACTIVE-GATHERING yes)
	(goal feudal-pending yes)
	(goal FLUSH no);indicates fast-castle
	(goal TRUSH no)
	(goal need-castle no)
	(building-type-count-total town-center > 0)
	(gold-amount > 200) ;lots of gold
=>
	(set-strategic-number sn-food-gatherer-percentage 50)
	(set-strategic-number sn-wood-gatherer-percentage 50)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;SCOUTS (no gold needed)

(defrule
	(goal REACTIVE-GATHERING yes)
	(goal feudal-pending yes)
	(goal FAST-CASTLE no)
	(goal FEUDAL-SCOUT-CAVALRY yes)
	(goal TRUSH no)
	(goal need-castle no);no stone needed
	(building-type-count-total town-center > 0)
=>
