;====================RESEARCHING FEUDAL-AGE (feudal-pending) strategies====================
	;specialized gathering

;FAST CASTLE yes (water-map)
(defrule
	(goal REACTIVE-GATHERING no)
(or	(goal WATER-MAP connected) ;like coastal
	(goal WATER-MAP separated)) ;like islands
	(goal feudal-pending yes)
	(goal FAST-CASTLE yes)
	(goal TRUSH no)
	(unit-type-count villager <= 15)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-wood-gatherer-percentage 60)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
