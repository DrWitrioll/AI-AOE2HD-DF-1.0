	;Temporary rule until reactive gathering is fully implemented
(defrule
	(up-compare-goal REACTIVE-GATHERING != no)
=>
	(set-goal REACTIVE-GATHERING no)
	(disable-self)
)

;(defrule
;	(goal REACTIVE-GATHERING yes)
;	(game-time > 10)
;=>
;	(chat-local-to-self "REACTIVE GATHERING ENABLED.")
;	(disable-self)
;)

	;dark-age

;GATHERING

(defrule
(or	(goal WATER-MAP connected)
	(goal WATER-MAP separated))
	(unit-type-count villager > 0)
=>
	(chat-local-to-self "Water-map gathering strategy.")
	(disable-self)
)

(defrule
	(goal WATER-MAP no)
	(unit-type-count villager > 0)
=>
	(chat-local-to-self "Land-map gathering strategy.")
	(disable-self)
)

;WATER STRATEGY
;  normal start
(defrule
	(goal REACTIVE-GATHERING no)
(or	(goal WATER-MAP connected)
	(goal WATER-MAP separated))
(goal being-drushed no)
(goal DRUSH no)
(goal feudal-pending no)
	(wood-amount >= 30) ;normal
(unit-type-count villager <= 6)
=>
   (set-strategic-number sn-food-gatherer-percentage 100);these set the percentage of what resources that villagers will gather.
   (set-strategic-number sn-wood-gatherer-percentage 0)
   (set-strategic-number sn-gold-gatherer-percentage 0)
   (set-strategic-number sn-stone-gatherer-percentage 0)
)

;  low wood start
(defrule
	(goal REACTIVE-GATHERING no)
(or	(goal WATER-MAP connected)
	(goal WATER-MAP separated))
(goal being-drushed no)
(goal DRUSH no)
(goal feudal-pending no)
	(wood-amount < 30) ;not enough for a house
	(housing-headroom <= 1) ;need house
	(up-pending-objects c: house == 0)
(unit-type-count villager <= 6)
=>
   (set-strategic-number sn-food-gatherer-percentage 30) ;temporary
   (set-strategic-number sn-wood-gatherer-percentage 70)
   (set-strategic-number sn-gold-gatherer-percentage 0)
   (set-strategic-number sn-stone-gatherer-percentage 0)
)
;GATHERING 2
(defrule
	(goal REACTIVE-GATHERING no)
(or	(goal WATER-MAP connected)
	(goal WATER-MAP separated))
(goal being-drushed no)
(goal DRUSH no)
(goal feudal-pending no)
(unit-type-count villager == 7)
=>
(set-strategic-number sn-food-gatherer-percentage 100); 86
(set-strategic-number sn-wood-gatherer-percentage 0); 14
(set-strategic-number sn-gold-gatherer-percentage 0)
(set-strategic-number sn-stone-gatherer-percentage 0)
)
