	;EXTENDED LAND-MAP GATHERING (current-age == dark-age)

;GATHERING (LAND) (gold yes)
(defrule
 ;gold prep
	(current-age == dark-age)
	(goal feudal-pending no) ;before clicking-up
	(goal REACTIVE-GATHERING no)
	(goal WATER-MAP no)
	(goal being-drushed no)
	(goal DRUSH no)
(or	(goal ARCHER yes) ;archers
(or	(goal SWORDMAN yes); m@a
(or	(goal EAGLE-WARRIOR yes); eagles
	(goal FAST-CASTLE yes))))
	(unit-type-count villager > 20)
=>
	(set-strategic-number sn-food-gatherer-percentage 60)
	(set-strategic-number sn-wood-gatherer-percentage 36)
	(set-strategic-number sn-gold-gatherer-percentage 4) ;prep gold
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

;GATHERING (LAND) (gold no)
(defrule
 ;no gold prep
	(current-age == dark-age)
	(goal feudal-pending no) ;before clicking-up
	(goal REACTIVE-GATHERING no)
	(goal WATER-MAP no)
	(goal being-drushed no)
	(goal DRUSH no)
(or	(goal FEUDAL-SCOUT-CAVALRY yes) ;scouts
	(goal FEUDAL-SKIRMISHER yes))
	(unit-type-count villager > 20)
=>
	(set-strategic-number sn-food-gatherer-percentage 65) ;try to maintain 13 or 14 on food
	(set-strategic-number sn-wood-gatherer-percentage 35)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;END OF LAND GATHERING (for low-pop and dark-age)

;	GATHERING IF being-drushed IS YES (any map-type)

;no barracks
(defrule
	(goal REACTIVE-GATHERING no)
(or	(goal being-drushed yes)
	(goal DRUSH yes))
	(goal feudal-pending no)
	(unit-type-count villager <= 6)
	(building-type-count-total barracks < 1)
=>
	(set-strategic-number sn-food-gatherer-percentage 100)
	(set-strategic-number sn-wood-gatherer-percentage 0)
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
	(goal REACTIVE-GATHERING no)
(or	(goal being-drushed yes)
	(goal DRUSH yes))
	(goal feudal-pending no)
