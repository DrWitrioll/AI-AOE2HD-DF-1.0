;==========(GOAL CASTLE-PENDING YES)========== ;we are currently researching castle-age

;----------defensive-castle gathering----------
;LOW WOOD LOW STONE
(defrule
(goal REACTIVE-GATHERING no)
(goal BOOM yes);indicates booming behaviour
(goal castle-pending yes)
(goal need-castle no)
(wood-amount < 1000) ;lots of wood for multiple tc's and farms
(stone-amount < 200) ;stone for at least 2 tc's
=>
(set-strategic-number sn-food-gatherer-percentage 23)
(set-strategic-number sn-wood-gatherer-percentage 60)
(set-strategic-number sn-gold-gatherer-percentage 2) ;gold not needed
(set-strategic-number sn-stone-gatherer-percentage 15) ;make sure we have enough stone for new TC's
)

