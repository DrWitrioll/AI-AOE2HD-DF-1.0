	(goal FEUDAL-SCOUT-CAVALRY yes)
	(unit-type-count villager > 15)
	(unit-type-count villager <= 21)
=>
	(set-strategic-number sn-food-gatherer-percentage 38) ;45
	(set-strategic-number sn-wood-gatherer-percentage 55) ;55
	(set-strategic-number sn-gold-gatherer-percentage 7) ;0
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(goal REACTIVE-GATHERING no)
	(goal feudal-pending yes)
	(goal gurjara-civ yes) ;camel scouts
	(goal FEUDAL-SCOUT-CAVALRY yes)
	(unit-type-count villager > 21)
	(unit-type-count villager <= 25)
=>
	(set-strategic-number sn-food-gatherer-percentage 38) ;45
	(set-strategic-number sn-wood-gatherer-percentage 55) ;55
	(set-strategic-number sn-gold-gatherer-percentage 7) ;0
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(goal REACTIVE-GATHERING no)
	(goal feudal-pending yes)
	(goal gurjara-civ yes)
	(goal FEUDAL-SCOUT-CAVALRY yes)
	(unit-type-count villager > 25)
=>
	(set-strategic-number sn-food-gatherer-percentage 38) ;45
	(set-strategic-number sn-wood-gatherer-percentage 55) ;55
	(set-strategic-number sn-gold-gatherer-percentage 7) ;0
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;dark-age farming

;FARM (dark-age)
(defrule
	(current-age == dark-age)
	(up-compare-goal WATER-MAP != separated) ;not a full water map
	(goal feudal-pending no)
(or	(and	(goal DRUSH yes)
			(building-type-count-total barracks > 0))
(or	(unit-type-count villager-forager >= 7) ;4
(or	(sheep-and-forage-too-far)
	(current-age-time > 550))))
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
   (building-type-count-total mill > 0)
   (building-type-count town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0)) ;NEW
   (building-type-count-total farm < 20) ;max
   (up-pending-objects c: farm < 1);1 ; only build 1 farm at a time max
   (idle-farm-count <= 1) ;have 0 idle farm on standby
   (can-build farm)
=>
	(build farm)
)

;FARM (dark-age) (EMERGENCY)
(defrule
	(current-age == dark-age)
	(current-age-time > 60) ;safety
	(wood-amount > 700) ;high wood
   (building-type-count-total mill > 0)
   (building-type-count town-center > 0)
   (building-type-count-total farm < 20) ;max 20
   (up-pending-objects c: farm < 3) ;build up to 3 farms at a time
   (idle-farm-count <= 1) ;have 1 idle farm on standby
   (can-build farm)
=>
	(build farm)
)

;FARM (feudal pending) (fc no) (barracks no)
(defrule
	(current-age == dark-age)
	(up-compare-goal WATER-MAP != separated) ;not a full water map
   (goal FAST-CASTLE no) ;aggressive strategy
   (goal feudal-pending yes)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 8))
   (up-pending-objects c: farm < 1);2 ; only build 1 farm at a time max
   (building-type-count-total mill > 0)
   (building-type-count-total town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0))
   (building-type-count-total barracks <= 0)
   (building-type-count-total farm < 10)
   (can-build farm)
   (idle-farm-count <= 1)
=>
	(build farm)
)

;FARM (feudal pending) (fc no) (barracks yes)
(defrule
	(current-age == dark-age)
	(up-compare-goal WATER-MAP != separated) ;not a full water map
   (goal FAST-CASTLE no)
   (goal feudal-pending yes)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 8))
   (up-pending-objects c: farm < 1);2 ; only build max 1 farm at a time
   (building-type-count-total town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0))
   (building-type-count-total barracks > 0)
   (building-type-count-total farm < 12)
   (can-build farm)
   (idle-farm-count <= 1)
=>
	(build farm)
)

;FARM (feudal pending) (fc yes)
(defrule
	(current-age == dark-age)
	(up-compare-goal WATER-MAP != separated) ;not a full water map
	(goal FAST-CASTLE yes)
	(goal feudal-pending yes)
(or	(wood-amount >= 250)
	(dropsite-min-distance wood <= 7))
   (up-pending-objects c: farm < 1);2 ; only build 1 farm at a time max
   (building-type-count-total town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0))
   (building-type-count-total farm < 12)
   (idle-farm-count <= 0)
    (can-build farm)
=>
	(build farm)
)

	;feudal-age farming

;MINIMUM FEUDAL FARM
(defrule
	(current-age == feudal-age)
	(current-age-time > 15) ;allow buildings first
	(up-compare-goal WATER-MAP != separated) ;not a full water map
(or	(wood-amount >= 200) ;safe wood for farms
	(dropsite-min-distance wood <= 7)) ;or we have reliable wood source
	(building-type-count town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0))
	(building-type-count-total farm < 8) ;10
	(idle-farm-count <= 1)
	(up-pending-objects c: farm < 1);3 ; only build 1 farm at a time
	(can-build farm)
=>
	(build farm)
)

;NORMAL FEUDAL FARM
(defrule
	(current-age == feudal-age)
	(current-age-time > 60) ;allow buildings first
	(up-compare-goal WATER-MAP != separated) ;not a full water map
;	(goal castle-pending no) ;not needed
(not	(town-under-attack)) ;avoid sending vils to their deaths while under attack
(or	(wood-amount >= 300)
	(dropsite-min-distance wood <= 7))
	(building-type-count town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0))
	(idle-farm-count <= 1)
	(up-pending-objects c: farm < 3) ; only build 3 farms at time max
	(can-build farm)
=>
	(build farm)
)

;EMERGENCY FEUDAL FARM
(defrule
	(current-age == feudal-age)
	(current-age-time > 120) ;safety
	(up-compare-goal WATER-MAP != separated) ;not a full water map
;	(goal castle-pending no) ;not needed
	(wood-amount >= 700) ;high wood
	(building-type-count town-center > 0)
(or		(building-type-count-total lumber-camp > 0)
		(building-type-count-total mule-cart > 0))
	(idle-farm-count <= 2)
	(up-pending-objects c: farm < 4) ; only build 4 farms at time max
	(can-build farm)
=>
	(build farm)
)

;FARM (early dark-age) to help not use up all food too fast
