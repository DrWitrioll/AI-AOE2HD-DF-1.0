	;EXTENDED WATER-MAP GATHERING (current-age == dark-age)

;GATHERING (WATER) (gold yes)
(defrule
 ;gold prep
	(current-age == dark-age)
	(goal feudal-pending no) ;before clicking-up
	(goal REACTIVE-GATHERING no)
(or	(goal WATER-MAP connected)
	(goal WATER-MAP separated))
	(goal being-drushed no)
	(goal DRUSH no)
(or	(goal ARCHER yes) ;archers
(or	(goal SWORDMAN yes); m@a
	(goal EAGLE-WARRIOR yes))); eagles
	(unit-type-count villager > 20)
=>
	(set-strategic-number sn-food-gatherer-percentage 55)
	(set-strategic-number sn-wood-gatherer-percentage 45) ;focus on wood
	(set-strategic-number sn-gold-gatherer-percentage 0) ;no gold too soon on water maps
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

;GATHERING (WATER) (gold no)
(defrule
 ;gold prep
	(current-age == dark-age)
	(goal feudal-pending no) ;before clicking-up
	(goal REACTIVE-GATHERING no)
(or	(goal WATER-MAP connected)
	(goal WATER-MAP separated))
	(goal being-drushed no)
	(goal DRUSH no)
(or	(goal FEUDAL-SCOUT-CAVALRY yes) ;scouts
(or	(goal FEUDAL-SKIRMISHER yes)
	(goal FAST-CASTLE yes)))
	(unit-type-count villager > 20)
=>
	(set-strategic-number sn-food-gatherer-percentage 55)
	(set-strategic-number sn-wood-gatherer-percentage 45); focus on wood
	(set-strategic-number sn-gold-gatherer-percentage 0)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)

	;END OF WATER GATHERING

