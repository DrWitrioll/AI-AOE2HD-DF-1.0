	;TOWN-CENTER RETREAT (1 town-center only) (step 1)
(defrule
	;(true)
	(goal DODGE-ARROWS yes)													;our MUST HAVE conditions at all times
	(soldier-count <= 50);testing
	(players-building-type-count target-player town-center == 1)			;no projectile-detected for this specific rule
=>
	(up-full-reset-search)														;ALWAYS reset search stuff before starting new DUC
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number) 		;find-remote works with the focus-player, we are only worried about our current target-player for this example
	(up-find-remote c: town-center c: 1) 									;find the 1 town-center from the focus-player
	(up-clean-search search-remote -1 search-order-asc) 					;sort the search-remote results from oldest to newest town-center, we want to find their home town-center
	(up-set-target-object search-remote c: 0) 								;set the first search-remote result as the target-object if it exists
	(up-get-search-state gl-local-total) 									;store all search state information into consecutive goals
	(set-goal gl-temp-state 19) 											;create a split-goal-rule for continuing rules, set-up for step-2
)
	;TOWN-CENTER RETREAT (1 town-center only) (step 2)
(defrule
	(goal DODGE-ARROWS yes)													;our MUST HAVE conditions at all times
	(soldier-count <= 50)
	(players-building-type-count target-player town-center == 1)
	(goal gl-temp-state 19)														;we've successfully moved onto step 2
	(up-compare-goal gl-remote-total == 1) 									;we have successfully stored the 1 town-center in the results
(or	(and	(soldier-count < 40) 											;avoid tc at all costs with under 30 soldiers number or,
			(up-object-data object-data-garrison-count >= 0))				;under 30 soldiers ALWAYS avoids TC no matter the garrison
	(and		(soldier-count <= 50) 										;only avoid arrow-fire if between 30 and 39 soldiers, AND either
	(and		(soldier-count >= 40)
			(or		(up-projectile-detected projectile-town-center < 20000)	;an arrow has been fired in the last 10 seconds by this TC, OR:
					(up-object-data object-data-garrison-count > 1)))))		;at least 2 unit garrisoned in the enemy TC (2 minimum to fire arrows)
=>
																			;prepare our units for retreat
	(up-get-point position-object gl-fort-point1-x) 								;store the town-center position (x,y) into gl-fort-point1-x (gl-fort-point1-x and gl-fort-point1-y)
	(up-set-target-point gl-fort-point1-x) 										;set the town-center position as the target-point
	(up-filter-distance c: -1 c: 9)										;set up a filter to include only objects that are up to 9 tiles away from the center of the target-point
	(up-filter-exclude -1 -1 -1 913) 										;filter out any unit class 913 (siege weapons like rams, etc.) that were included following the previous filter
	(set-goal gl-temp-state 20) 											;set-up step-3 if everything here is TRUE
)
	;TOWN-CENTER RETREAT (1 town-center only) (step 3)
(defrule
	(goal DODGE-ARROWS yes)													;our MUST HAVE conditions at all times
	(soldier-count <= 50)
	(players-building-type-count target-player town-center == 1)
	(goal gl-temp-state 20) 													;begin step-3
	(up-compare-goal gl-remote-total == 1) 									;we still have the 1 enemy town-center from our search-remote results from step 1
(or	(and	(soldier-count < 40) 											;keep all of the same conditions from step-2 to prevent DUC leaks
			(up-object-data object-data-garrison-count >= 0))
		(and	(soldier-count <= 50)
		(and	(soldier-count >= 40)
			(or		(up-projectile-detected projectile-town-center < 20000)
					(up-object-data object-data-garrison-count > 1)))))
	(up-find-local c: all-units-class c: 1) 								;LASTLY: find up to a max of 1 of our units that are within 9 tiles of the enemy town-center and are not class 913 (siege)
=>
	;if we're here, we have found a matching unit
	(up-remove-objects search-local object-data-class == 913)
	(generate-random-number 4) 												;get a random number from 1 to 4 (we'll use this to get a random retreat distance)
	(up-get-fact random-number 0 gl-random) 								;store the random number into gl-random
	(up-modify-goal gl-random c:+ 1) 										;add 1 to gl-random, so its range is now 2 to 5
	(up-modify-goal gl-random g:neg gl-random) 								;negate gl-random, so it's now -2 to -5
	(up-set-target-object search-local c: 0) 								;set our matching unit as the target-object
	(up-get-point position-object gl-fort-point2-x) 						;store our unit's position into gl-fort-point2-x
	(up-cross-tiles gl-fort-point2-x gl-fort-point1-x c: -3)				;shift the point of our soldier relative to the point of the town-center so our unit slowly circles the town-center rather than runs away in a straight line
	(up-lerp-tiles gl-fort-point2-x gl-fort-point1-x g: gl-random) 			;shift gl-fort-point2-x by "gl-random" tiles toward gl-fort-point1-x (gl-random is negative, so it moves AWAY) and store the result in gl-fort-point2-x
	(up-bound-point gl-fort-point2-x gl-fort-point2-x)						;make sure the point we are retreating to is inside the map bounds
	(up-set-target-point gl-fort-point2-x) 									;set the new position as the target-point
	(up-target-point 0 action-move -1 -1) 									;move our unit to the target-point (the up-target-point command performs the action on everyone in the local search results list, which is only the 1 unit)
	(up-set-target-point gl-fort-point1-x) 									;set the target-point back to the enemy town-center for our next unit to use
	(up-reset-search 0 1 0 0) 												;remove our current unit from the local search results, but leave everything else as-is to resume searching after it
	(up-jump-rule -1) 														;-1 means it will repeat this rule
)

;TOWN-CENTER RETREAT 2 (ANY TOWN-CENTER) (step 1)
(defrule
	(goal DODGE-ARROWS yes)
	(soldier-count <= 45);testing
	(players-building-type-count target-player town-center > 1)				;must be only when more than 1 town-center
	(up-projectile-detected projectile-town-center < 20000)					;at least 1 enemy town-center has fired in the last 20 seconds
=>
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number) 		;find-remote works with the focus-player, so set it to the target
	(up-find-remote c: town-center c: 10) 									;try to find up to 10 town-centers from the focus-player
	(up-clean-search search-remote -1 search-order-asc) 					;sort from oldest built first to newest built (this helps in situations with more than 1 town-center firing at the same time)
	(up-remove-objects search-remote object-data-action != actionid-attack)	;remove any town-centers that are not currently attacking something
	(up-get-search-state gl-local-total) 									;store search state information NOTE: ALWAYS use the local-total as 4 goals in ascending order get stored for local & remote
	(set-goal gl-temp-state 21)												;used for continuing rules
)
;TOWN-CENTER RETREAT 2 (ANY TOWN-CENTER) (step 2)
(defrule
	;please add a timer or goal check here to block these rules from repeating each pass 
	(goal DODGE-ARROWS yes)													;relist our MUST HAVE conditions
	(soldier-count <= 45)
	(players-building-type-count target-player town-center > 1)
	(goal gl-temp-state 21)													;the first rule fired, so we are on the next step
	(up-compare-goal gl-remote-total > 0) 									;we have successfully found and stored at least 1 town-center in the results, so now we can target one of the town-centers
	(up-set-target-object search-remote c: 0) 								;set the first search-remote result as the target-object
(or	(up-projectile-detected projectile-town-center < 20000)					;retreat from the town-center IF: any town-center has fired in the last 20 seconds, OR:
	(up-object-data object-data-garrison-count >= 0))						;just retreat from last fired town-center
=>
	;prepare to check my own units
	(up-get-point position-object gl-fort-point1-x) 								;find and store the tower position (x,y) into gl-fort-point1-x (gl-fort-point1-x and gl-fort-point1-y), so we are targeting the point on the map, not the tower
	(up-set-target-point gl-fort-point1-x) 										;set the tower's position as the target-point
	(up-filter-exclude -1 -1 -1 913) 										;set up filters to exclude certain units from retreating: this excludes unit class 913 (siege weapons like rams, etc.)
	(up-filter-distance c: -1 c: 10) 										;this command uses the target-point as the center and will find our units up to 10 tiles away from the center of it (within the towers approximate range)
	(set-goal gl-temp-state 22) 											;continue on the next rule if possible
)
;TOWN-CENTER RETREAT 2 (ANY TOWN-CENTER) (step 3)
(defrule
	(goal DODGE-ARROWS yes)													;relist our MUST HAVE conditions
	(soldier-count <= 45)
	(players-building-type-count target-player town-center > 1)
	(up-compare-goal gl-remote-total > 0) 									;we have successfully found and stored at least 1 town-center in the results, so now we can target one of the town-center
	(goal gl-temp-state 22) 												;continuing only if the previous rule worked
(or	(up-projectile-detected projectile-town-center < 20000)					;retreat from the town-center IF: any town-center has fired in the last 20 seconds, OR:
	(up-object-data object-data-garrison-count >= 0))						;just retreat from last fired town-center
	(up-find-local c: all-units-class c: 1) 								;find 1 of our units that are within 12 tiles of the enemy tower and are not any of the excluded classes listed in the last rule
=>
	;if we're here, we found a matching unit
	(up-remove-objects search-local object-data-class == 913)
	(generate-random-number 5) 												;get a random number from 1 to 4 (we'll use this to get a random retreat distance)
	(up-get-fact random-number 0 gl-random) 								;store the random number into gl-random
	(up-modify-goal gl-random c:+ 2) 										;add 1 to gl-random, so its range is now 2 to 5
	(up-modify-goal gl-random g:neg gl-random) 								;negate gl-random, so it's now -2 to -5
	(up-set-target-object search-local c: 0) 								;set my first matching unit as the target-object
	(up-get-point position-object gl-fort-point2-x) 						;store my unit's position into gl-fort-point2-x
	(up-cross-tiles gl-fort-point2-x gl-fort-point1-x c: -2)				;don't run away in a straight line
	(up-lerp-tiles gl-fort-point2-x gl-fort-point1-x g: gl-random) 			;shift gl-fort-point2-x by "gl-random" tiles toward gl-point1 (gl-random is negative, so it moves AWAY) and store the result in gl-fort-point2-x
	(up-bound-point gl-fort-point2-x gl-fort-point2-x)
	(up-set-target-point gl-fort-point2-x) 									;set the new position as the target-point
	(up-target-point 0 action-move -1 stance-no-attack) 					;move my unit to the target-point (the up-target-point command performs the action on everyone in the local search results list, which is only the 1 unit) stand-ground helps to prevent retaliation
	;prepare to check the next unit
	(up-set-target-point gl-fort-point1-x) 										;set the target-point back to the enemy tower for our next units to use
	;(up-full-reset-search)
	(up-reset-search 0 1 0 0) 												;remove our current unit from the local search results, but leave everything else as-is to resume searching after it
	(up-jump-rule -1) 														;-1 means it will repeat this same rule, going back to (goal gl-temp-state 1)
) ;end jump

	;reset military units to attack-stance
(defrule
	(game-time > 60) ;safety
	(goal sheep-micro no) ;safety
	(timer-triggered temp-timer)	;prevent possible lag ;changes based on (goal ATTACK no) & (goal ATTACK yes)
	(military-population >= 1) ;ignore if no military
=>
	(up-full-reset-search)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-filter-exclude -1 actionid-explore -1 -1)
	(up-find-local c: all-units-class c: 240)
	(up-remove-objects search-local object-data-order == orderid-explore);
	(up-target-objects 0 action-default -1 stance-aggressive)
)

	;temp fix for weird bug on first emergency attack (hopefully only needed 1 time) (anti-luring micro affects this)
(defrule
	(goal EMERGENCY-ATTACK yes)
	(population >= max-pop)
	(goal ATTACK yes)
=>
	(up-full-reset-search)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-filter-exclude -1 actionid-explore -1 -1)
	(up-find-local c: all-units-class c: 240)
	(up-remove-objects search-local object-data-order == orderid-explore)
	(up-target-point 0 action-stop -1 -1)
	(disable-self)
)

(defrule
	(timer-triggered temp-timer)		;on a timer to prevent possible lag
(or	(up-enemy-units-in-town > 0)		;enemy units other than villagers
(or	(up-enemy-villagers-in-town > 0)	;enemy villagers
	(up-enemy-buildings-in-town > 0)))	;enemy buildings
=>
	(up-update-targets)
)
	;low timer
(defrule
	(goal ATTACK no)
	(strategic-number sn-maximum-town-size < 18) ;lower time needed to retreat
	(timer-triggered temp-timer)
=>
	(disable-timer temp-timer)
	(enable-timer temp-timer 14)
)
	;medium timer
(defrule
	(goal ATTACK no)
	(strategic-number sn-maximum-town-size >= 18) ;medium time needed to retreat
	(strategic-number sn-maximum-town-size <= 26)
	(timer-triggered temp-timer)
=>
	(disable-timer temp-timer)
	(enable-timer temp-timer 20)
)
	;high timer
(defrule
	(goal ATTACK no)
	(strategic-number sn-maximum-town-size > 26) ;high time needed to retreat
	(timer-triggered temp-timer)
=>
	(disable-timer temp-timer)
	(enable-timer temp-timer 25)
)

	;low timer (when we are attacking to prevent too long of stance-no-attack)
(defrule
	(goal ATTACK yes)
	(timer-triggered temp-timer)
=>
	(disable-timer temp-timer)
	(enable-timer temp-timer 8)
)

	;SAFETY FIX FOR TEMP-TIMER (without this sometimes units stay in no-attack-stance)
(defrule
	(military-population > 1)
	(building-type-count town-center > 0)
	(up-timer-status temp-timer < timer-running) ;timer disabled or not running
=>
	(disable-timer temp-timer)
	(enable-timer temp-timer 10)
)

