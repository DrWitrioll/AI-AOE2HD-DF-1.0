;==========END OF SCOUT MICRO==========

	;NEW TESTING TECHNIQUES

;==========GATHER VILS INSIDE TC IF ENEMY WITHIN RANGE==========
;rules here

;==========;enable sheep-micro goal==========
(defrule
	(goal NOMAD yes)
	(goal sheep-micro no)
	(building-type-count town-center > 0)
	(up-object-type-count c: livestock-class > 0)
=>
	;(chat-local-to-self "Enabling sheep-micro.")
	(enable-timer temp-timer 10)
	(set-goal sheep-micro yes)
	(set-goal GL-FOCUS-PLAYER 0) ;my-player-number
	(set-goal DODGE-ARROWS no)
	(disable-self)
)

;==========;NOMAD sheep-micro==========
	;GET HOME TC POSITION
(defrule
	(goal sheep-micro yes)
	;(timer-triggered temp-timer)
	(building-type-count town-center > 0)							;any number of town-centers because we set the point of our home tc (oldest built or first built one)
	(up-object-type-count c: livestock-class > 0)
=>
	;(chat-local-to-self "Rule 1.")
	(up-reset-search 1 1 1 1)
	(up-reset-filters)
	;(set-strategic-number sn-focus-player-number my-player-number)	;make sure we are only finding units owned by us (for remote-search)
	(up-find-local c: town-center c: 10)
	(up-clean-search search-local -1 search-order-asc)				;sort the search-local results from the oldest TC built as the first result 
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 2) ;all DUC rules use their own values! NEVER CROSS THEM TOGETHER ;this is like a split-rule-goal
)

(defrule
	(goal sheep-micro yes)
	(goal gl-temp-state 2)
	;(timer-triggered temp-timer)
	(up-compare-goal gl-local-total > 0)
	(building-type-count town-center > 0)
	(up-object-type-count c: livestock-class > 0)
	(up-set-target-object search-local c: 0)			;since we sorted from oldest to newest search-local results, set the target as our oldest built tc, therefore our home town-center
=>
	;(chat-local-to-self "Rule 2.")
	(up-get-point position-object gl-fort-point1-x)			;store gl-point-x of the TC for lerping later
	(up-set-target-point gl-fort-point1-x)					;got the home TC position
	(set-goal gl-temp-state 3);split rule goal
)

(defrule
	(goal sheep-micro yes)
	(goal gl-temp-state 3)
	(building-type-count town-center > 0)
	(up-object-type-count c: livestock-class > 0)
	(timer-triggered temp-timer)
=>
	;(chat-local-to-self "Rule 3.")
	(up-filter-distance c: 7 c: -1) 								;this filter will only find new search-local results (sheep) if they are MORE THAN 7 tiles away from the tc using gl-fort-point1-x
	(up-filter-exclude -1 -1 -1 904)								;not really needed to filter out villager-class
	(up-reset-search 1 1 1 1)										;remove the town-center from the search-local list
	(up-find-local c: livestock-class c: 20) 						;find up to 20 livestock at once outside the filter-distance parameters (7 tiles)
	(up-clean-search search-local -1 search-order-asc) 				;sort results from oldest to newest (so the first sheep found will be first in the list)
	(up-cross-tiles gl-fort-point1-x gl-position-center-x c: 3)		;this works better than lerp-tiles in this specific situation
	;(up-lerp-tiles gl-fort-point1-x gl-position-center-x c: -3) 	;on nomad games we can shift the point position at the TC away a few tiles using the map center as a point of reference so sheep don't bunch touching the TC
	(up-set-target-point gl-fort-point1-x)
	(up-target-point gl-fort-point1-x action-move -1 -1)
)

;disable sheep-micro goal
(defrule
		(game-time > 240) ;min time to consider cancelling
		(up-compare-goal sheep-micro != no)
(or	(and	(unit-type-count villager > 10)				
			(up-pending-objects c: villager > 0))		;indicates we have a tc & actively creating villagers
	(up-object-type-count c: livestock-class <= 2))	
=>
	(chat-local-to-self "Disabling sheep-micro.")
	(set-goal sheep-micro no)
	(set-goal GL-FOCUS-PLAYER 1) ;this is an early game thing so we need to manually reset our default focus & target player to the closest enemy
	(disable-timer temp-timer)
	(disable-self)
)

(defrule
	(goal sheep-micro yes)
	(timer-triggered temp-timer);use for sheep timer
=>
	(disable-timer temp-timer)
	(enable-timer temp-timer 10) ;15
)


	;CORNER MARKETS (part 1) - set-up corner position
(defrule
	(goal REACTIVE-GATHERING no)									;don't attempt this market rule if we are trying to rebuild
	(up-compare-goal WATER-MAP == no)								;only land maps for now
(or	(player-in-game any-ally) 										;a currently alive ally
	(players-building-type-count any-ally market > 0))				;OR if they are dead we can trade with their market
	(unit-type-count villager > min-vills)							;don't waste resources with low villagers
	(building-type-count town-center >= 3)							;must have 3 tc's minimal
	(building-type-count-total market < 6)							;don't build endless markets if it bugs out
	(wood-amount > 700)												;don't affect other needed buildings earlier on
	(up-pending-objects c: market < 1)								;only 1 attempt at a time
	(up-can-build 0 c: market)										;can build with no escrow
=>
	;(chat-to-all "Attempting to build corner market.")
	(up-full-reset-search)
	(up-get-point position-corner gl-position-corner-x)				;refresh the tile at position-corner
	(up-bound-point gl-position-corner-x gl-position-corner-x)		;make sure the point is not outside of the map bounds
	(up-copy-point building-point-x gl-position-corner-x)			;copy from the bounded position-corner point into our own building point
	(up-lerp-tiles building-point-x gl-position-center-x c: 5)		;shift the position from the far corner towards the map-center by 5 tiles
	(up-set-target-point building-point-x)							;target the point for other rules to check if its reachable
	(set-goal gl-temp-state 23)
)
; (part 2) - target corner
(defrule
	(goal REACTIVE-GATHERING no)									;don't attempt this market rule if we are trying to rebuild
	(up-compare-goal WATER-MAP == no)								;only land maps for now
(or	(player-in-game any-ally) 										;a currently alive ally
	(players-building-type-count any-ally market > 0))				;OR if they are dead we can trade with their market
	(unit-type-count villager > min-vills)							;don't waste resources with low villagers
	(building-type-count town-center >= 3)							;must have 3 tc's minimal
	(building-type-count-total market < 6)							;don't build endless markets if it bugs out
	(wood-amount > 700)												;don't affect other needed buildings earlier on
	(up-pending-objects c: market < 1)								;only 1 attempt at a time
	(goal gl-temp-state 23)
;(not	(up-point-contains gl-position-corner-x c: tree-class))		;might not be needed?
(not	(up-point-contains building-point-x c: market))				;this only turns true if the exact center tile of the building is actually on top of the point
	(up-point-explored building-point-x != explored-no)				;this means the point has been explored in the past or can currently be seen (same as == explored-yes OR == explored-active)
	(up-path-distance building-point-x 0 != 65535)  				;this makes sure the corner point can be pathed to
	(up-can-build 0 c: market)										;can build with no escrow
=>
	;(chat-to-all "Attempting to build corner market.")
	(up-assign-builders c: market c: 1)								;1 builder needed only
	(up-build place-point 0 c: market)								;build the market without escrow on the point targeted in the rule previous
)


