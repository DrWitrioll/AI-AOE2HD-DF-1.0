;==========RETASK 1ST GEORGIAN MULE-CART TO A FOREST==========
(defrule
	(game-time > 120)								;enough time to find a forest
	(building-type-count town-center > 0)
	(unit-type-count villager >= 3)					;we are on track for a normal game
	(goal georgian-civ yes)							;only georgians start the game with a free mule-cart
	(building-type-count mule-cart > 0)
	(up-gaia-type-count c: wood > 40) 				;likely a forest nearby ;this helps in ally games too so that we have time to find our own trees (if shared exploration is turned on)
=>
	(up-full-reset-search)
	(up-get-point position-self gl-position-self-x)
	(up-set-target-point gl-position-self-x)
	(up-filter-distance c: 9 c: 30)					;try to avoid stragglers near our TC (min distance 9, max distance 30)
	(up-find-resource c: wood c: 100) 				;must be at least some trees in range
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 24)
	(disable-self)									;this entire section is only attempted 1 time (if it fails its not a big deal)
)
(defrule
	(game-time > 120)
	(building-type-count town-center > 0)
	(unit-type-count villager >= 3)
	(goal georgian-civ yes)
	(building-type-count mule-cart > 0)
	(up-gaia-type-count c: wood > 40)
	(up-compare-goal gl-remote-total > 15)
	(goal gl-temp-state 24)
=>
	(up-clean-search search-remote object-data-distance search-order-asc)	;sort the trees that are greater than 9 tiles from our TC to within 30 tiles of the TC of the shortest distance
	(up-set-target-object search-remote c: 0)								;target the closest found tree
	(up-get-point position-object gl-point1-x)								;get the point of the tree
	(up-full-reset-search)
	(up-set-target-point gl-point1-x)										;target the point of the tree so we can make sure the tree is apart of a forest
	(up-filter-distance c: -1 c: 3)											;filter up to 3 tiles from the tree to find other trees
	(up-find-resource c: wood c: 10)										;try to find up to 10 other trees around the point of this tree
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 25)
	(disable-self)
)
(defrule
	(game-time > 120)
	(building-type-count town-center > 0)
	(unit-type-count villager >= 3)
	(goal georgian-civ yes)
	(building-type-count mule-cart > 0)
	(up-gaia-type-count c: wood > 40)
	(up-compare-goal gl-remote-total >= 4)									;there MUST be at least 4 other trees in the 3 tile zone of this tree for this rule to fire
	(goal gl-temp-state 25)
=>
	(up-clean-search search-remote object-data-distance search-order-asc)	;now we sort the closest found tree to our initial tree for targeting (if we are at this point we have found a nearby forest)
	(up-set-target-object search-remote c: 0)								;target this object so our mule-cart can be sent to it
	(up-reset-filters)														;clear the distance filter set-up earlier so we can find our mule-cart wherever it is
	(up-find-local c: mule-cart c: 1)
	(up-target-objects 0 action-default -1 -1)
	(chat-local-to-self "Retasking mule-cart to nearby forest.")			;mission accomplished
	(disable-self)
)
;====================fix bad lumber-camp & mining-camp placement====================
(defrule
	(up-gaia-type-count c: wood > 30) ;in-case we are building an emergency lumber-camp with no trees in sight
	(resource-found wood)
	(up-pending-objects c: lumber-camp >= 1)
	(strategic-number sn-lumber-camp-max-distance < 40) ;max 40 for this rule
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: lumber-camp c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object building-point-x)
	(up-set-target-point building-point-x)
	(up-reset-filters)
	(up-filter-distance c: -1 c: 4)
	(up-find-resource c: wood c: 3)
	(up-get-search-state gl-local-total))
(defrule
	(resource-found wood)
	(strategic-number sn-lumber-camp-max-distance < 40) ;max 40 for this rule
	(up-gaia-type-count c: wood > 30)
	(up-pending-objects c: lumber-camp >= 1)
	(up-pending-objects c: mule-cart < 1)
	(up-compare-goal gl-local-total >= 1)
	(up-compare-goal gl-remote-total <= 2)
	(up-object-data object-data-hitpoints <= 1)
=>
	;(chat-local-to-self "Fixing bad lumber-camp placement.")
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: lumber-camp)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(up-modify-sn sn-lumber-camp-max-distance c:+ 1)
)

(defrule
(or	(goal GOLD-REMAINING yes)				;these goals ensure there is gold or stone physically somewhere on the map
	(goal STONE-REMAINING yes))
(or	(up-gaia-type-count c: gold >= 1)		;these ensure we have sighted at least 1 gold-mine or 1 stone-mine
	(up-gaia-type-count c: stone >= 1))		;this prevents an endless cycle of deleting mining-camps and prevents bugs
	(up-pending-objects c: mining-camp >= 1)
	(strategic-number sn-mining-camp-max-distance < 30) ;max 30 for this rule
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: mining-camp c: 1)
	(up-set-target-object search-local c: 0)
	(up-get-point position-object building-point-x)
	(up-set-target-point building-point-x)
	(up-reset-filters)
	(up-filter-distance c: -1 c: 4)
	(set-strategic-number sn-focus-player-number 0)	;fixed ;since we are using search-remote to find gold or stone we need to focus on gaia
	(up-find-remote c: gold-mine c: 1)
	(up-find-remote c: stone-mine c: 1)
	(up-get-search-state gl-local-total) ;fixed
)
(defrule
(or	(goal GOLD-REMAINING yes)
	(goal STONE-REMAINING yes))
(or	(up-gaia-type-count c: gold >= 1)
	(up-gaia-type-count c: stone >= 1))
	(strategic-number sn-mining-camp-max-distance < 30) ;max 30 for this rule
	(up-pending-objects c: mining-camp >= 1)
	(up-compare-goal gl-local-total >= 1)
	(up-compare-goal gl-remote-total <= 0) ;fixed ;no gold or stone found near mining-camp THEN delete the foundation
	(up-object-data object-data-hitpoints <= 1)
=>
	;(chat-local-to-self "Fixing bad mining-camp placement.")
	(up-target-point 0 action-delete -1 -1)
	(up-reset-placement c: mining-camp)
	(set-strategic-number sn-allow-adjacent-dropsites 1)
	(up-modify-sn sn-mining-camp-max-distance c:+ 1)
)
;----------delete old lumber-camps----------
;PART 1
(defrule
	(building-type-count lumber-camp >= 7) 					;when we have more than 6 total LC's, AND:
	(up-pending-objects c: lumber-camp < 1)					;none currently getting built
=>
	(up-full-reset-search)									;clear all search & filters
	(up-find-local c: lumber-camp c: 30)					;find up to a max of 30 LC's
	(up-clean-search search-local -1 search-order-desc)		;sort the search-local results from newest first to oldest last
	(up-remove-objects search-local object-data-index <= 6) 	;remove our newest built LC's from search-local (so we target the old ones only)
	(up-get-search-state gl-local-total)					;store our results in gl-local-total (local-total goal)
	(set-goal gl-temp-state 26)								;this is a split-rule-goal for keeping our DUC rules separate to prevent DUC leaks
)
;PART 2
(defrule
	(building-type-count lumber-camp >= 7) 					;copy same 2 conditions from above ;1
	(up-pending-objects c: lumber-camp < 1)					;2
	(up-compare-goal gl-temp-state == 26)					;our split-rule-goal matches up with the above rule
	(up-compare-goal gl-local-total > 0)					;search-local returned more than 1 lumber-camp after deleting the newest results, these will be the old lc's
=>
	(up-set-target-object search-local c: 0)				;target the first search-local result
	(up-get-point position-object gl-point1-x)				;find & store the point on the map of the LC into one of our coordinates
	(up-set-target-point gl-point1-x)						;target the point so we can delete the LC.
	(up-target-point gl-point1-x action-delete -1 -1)		;delete the LC at the point.
	;(chat-to-all "Deleting oldest lumber-camp.")			;chat verification
)
;----------delete old mining-camps----------
;PART 1
(defrule
	(building-type-count mining-camp >= 8) 			;when we have more than 7 total MC's, AND:
	(up-pending-objects c: mining-camp < 1)					;none currently getting built
=>
	(up-full-reset-search)									;clear all search & filters
	(up-find-local c: mining-camp c: 30)					;find up to a max of 30 MC's
	(up-clean-search search-local -1 search-order-desc)		;sort the search-local results from newest first to oldest last
	(up-remove-objects search-local object-data-index <= 7) 	;remove our newest built MC's from search-local (so we target the old ones only)
	(up-get-search-state gl-local-total)					;store our results in gl-local-total (local-total goal)
	(set-goal gl-temp-state 26)								;this is a split-rule-goal for keeping our DUC rules separate to prevent DUC leaks
)
;PART 2
(defrule
	(building-type-count mining-camp >= 6) 					;copy same 2 conditions from above ;1
	(up-pending-objects c: mining-camp < 1)					;2
	(up-compare-goal gl-temp-state == 26)					;our split-rule-goal matches up with the above rule
	(up-compare-goal gl-local-total > 0)					;search-local returned more than 1 mining-camp after deleting the newest results, these will be the old MC's
=>
	(up-set-target-object search-local c: 0)				;target the first search-local result
	(up-get-point position-object gl-point1-x)				;find & store the point on the map of the MC into one of our coordinates
	(up-set-target-point gl-point1-x)						;target the point so we can delete the MC.
	(up-target-point gl-point1-x action-delete -1 -1)		;delete the MC at the point.
	;(chat-to-all "Deleting oldest mining-camp.")			;chat verification
)

;===================EXPERIMENTAL hold vils in town when under heavy attacks===================
	;town-center garrison hold
;(defrule
;	(goal is-town-under-attack yes)
;(or	(soldier-count <= 3)
;(or	(up-enemy-units-in-town >= 20)
;	(strategic-number sn-military-level <= -3)))
;=>
;	(up-gather-inside c: town-center c: 1) ;hold
;)
;	;town-center garrison release
;(defrule
;	;(goal is-town-under-attack no) ;holds them too long because of this
;(or	(soldier-count > 3)
;(or	(up-enemy-units-in-town < 10)
;	(strategic-number sn-military-level >= -1)))
;=>
;	(up-gather-inside c: town-center c: 0) ;release
;)

;==========;NOMAD: flare allies position at start of game==========
(defrule
	(goal NOMAD yes)
	(building-type-count town-center <= 0)
	(building-type-count-total town-center >= 1)
	(unit-type-count villager >= 1)
	(game-time >= 16)
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: town-center-foundation c: 16)
	(disable-self))

(defrule
	(goal NOMAD yes)
	(up-set-target-object search-local c: 0)
	(building-type-count town-center <= 0)
	(building-type-count-total town-center >= 1)
	(unit-type-count villager >= 1)
	(game-time >= 16)
=>
	(up-get-point position-object gl-fort-point1-x)
	(up-send-flare gl-fort-point1-x)
	(chat-to-allies "I will settle here.")
	(disable-self))

	;=========MICRO TESTING=========

	;==========GURJARA GARRISON SHEEP IN A MILL;==========

	;Garrison sheep-class into mills (Gurjara's)
(defrule
	(goal gurjara-civ yes)
	(up-object-type-count c: livestock-class >= 1)
	(up-object-type-count c: livestock-class <= 10) ;NEW ignore these rules if we have more than 10 sheep (can't garrison more than 10)
	(building-type-count mill > 0) ;as soon as a mill is built then we garrison immediately
=>
;	(chat-to-player my-player-number "Time for you to pull your weight around here, silly livestock!")
	(up-gather-inside c: mill c: 1) ;hold forever for now
	(up-garrison mill c: livestock-class)
	(disable-self) ;only happens once
)
	;Villagers avoid killing sheep (testing)
(defrule
	(game-time < 300) ;safety
	(goal gurjara-civ yes)
	(unit-type-count villager-shepherd >= 1)
	(up-object-type-count c: livestock-class >= 1) ;must have at least 1 sheep
	(up-object-type-count c: livestock-class <= 10) ;BUT NO MORE THAN 10
	(up-gaia-type-count c: forage-bush-class >= 1) ;must be at least 1 scouted forage bush (for gurjara they spawn with them, so this is a backup to prevent bugs)
	(building-type-count mill < 1)
	(building-type-count town-center > 0)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 12) ;its hard to get more than even 10 on 2 berry bushes, but this will do for now
	(up-clean-search search-local -1 search-order-asc)
	(up-remove-objects search-local object-data-gather-type != food) ;only find food villagers
	;(up-object-data object-data-target == 958) ;sheep-food
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 4)
)
(defrule
	(game-time < 300)
	(goal gurjara-civ yes)
	(unit-type-count villager-shepherd >= 1)
	(up-object-type-count c: livestock-class >= 1)
	(up-object-type-count c: livestock-class <= 10)
	(up-gaia-type-count c: forage-bush-class > 0)
	(building-type-count mill < 1)
	(building-type-count town-center > 0)
	(goal gl-temp-state 4)
	(up-compare-goal gl-local-total >= 1) ;at least 1 shepherd found
=>
	(up-get-point position-self gl-position-self-x)
	(up-set-target-point gl-position-self-x)
	(up-filter-distance c: -1 c: 20) ;no more going across the map for a teammates berries!
	(up-modify-sn sn-focus-player-number s:= gaia) ;focus on finding forage bushes
	(up-filter-status c: status-resource c: list-active)
	(up-find-resource c: forage-bush-class c: 1) ;goes into remote-results
	(up-set-target-object search-remote c: 0)
	(up-target-objects 0 action-default -1 -1)
)
;DEBUG - send food villagers back to boar when avoiding killing sheep
(defrule
	(game-time < 400)
	(goal gurjara-civ yes)
	(strategic-number sn-enable-boar-hunting == 2) ;currently targeting boars only
	(up-remaining-boar-amount <= 349) ;boar is dead
	(unit-type-count villager-hunter <= 5)
	(unit-type-count villager-class >= 10)
	(building-type-count town-center > 0)
=>
	;(up-retask-gatherers food c: 3)
	(up-request-hunters c: 2)
)

;====================PREVENT UNITS FROM GETTING LURED OUT OF TOWN-SIZE====================
;part 1 (flanks only for now)
(defrule
	(goal position-goal flank)
	(goal is-town-under-attack no)						;better to have units defend than retreat forever and slowly die
	(goal ATTACK no)									;town-under-attack makes units retreat forever and slowly die, so only this for now
	(goal EMERGENCY-ATTACK no) 							;if this is on, ignore all of these rules
	(up-compare-goal GL-FOCUS-PLAYER != 4) 				;don't do this if we are defending an ally
	(up-enemy-buildings-in-town < 1)					;prevents sn-safe-town-size from bugging units out
	(up-compare-goal WATER-MAP != separated) 			;don't run this rule on full water maps
	(strategic-number sn-number-attack-groups < 1) 		;don't retreat our early first attack or taunt 31 attacks
	(strategic-number sn-percent-attack-soldiers < 1)	 ;don't retreat if we are ever attacking
	(soldier-count > 1)									;scout bug fixed
	(building-type-count town-center > 0)
=>
	(up-full-reset-search)
	(up-get-point position-self gl-position-self-x)
	(up-set-target-point gl-position-self-x)
	(up-filter-include cmdid-military -1 -1 -1) 									;include only military units, then EXCLUDE ALL:
	;(up-filter-exclude -1 actionid-explore orderid-explore -1)						;scouts (need to explore!) ; BUGGED
	(up-filter-exclude -1 actionid-explore -1 -1)									;fix scouts?
	(up-filter-exclude -1 -1 -1 warship-class) 										;warship-class (they don't belong in our town-size!!!)
	(up-filter-exclude cmdid-monk -1 -1 -1) 										;monks (might be getting needed relics)
	(up-filter-distance s: sn-safe-border-distance c: -1)							;MINIMUM distance is our border distance, maximum distance has no limit ;bugs if sn-safe-town-size gets bigger than this number
	(up-find-local c: all-units-class c: 100)										;downside of finding up to this many units at once is they tend to create annoying formations on the border of sn-maximum-town-size
	(up-clean-search search-local -1 search-order-desc) 							;sort from newest created to oldest created, oldest is most likely a scout and we don't want scouts in this (filter doesn't appear to work for explorers?)
	(up-remove-objects search-local object-data-order == orderid-explore)			;remove scouts
	(up-remove-objects search-local object-data-class == warship-class)				;never make warships try to go near our town-center lol
	(up-remove-objects search-local object-data-attack-stance == stance-no-attack)	;prevent constantly DUCing units already heading back to town
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 5)
)
;part 2 (flanks only for now)
(defrule
	(goal position-goal flank)
	(goal is-town-under-attack no)
	(goal ATTACK no)
	(goal EMERGENCY-ATTACK no)
	(up-compare-goal GL-FOCUS-PLAYER != 4)
	(up-enemy-buildings-in-town < 1)
	(up-compare-goal WATER-MAP != separated)
	(strategic-number sn-number-attack-groups < 1)
	(strategic-number sn-percent-attack-soldiers < 1)
	(soldier-count >= 2)
	(building-type-count town-center > 0)
	(up-compare-goal gl-local-total > 0) ;scout bug fixed
	(goal gl-temp-state 5)
=>
	(up-copy-point gl-fort-point1-x gl-position-self-x)						;copy our home town-center point into gl-fort-point1-x (so we don't mess with gl-position-self-x, it should always be our home town-center)
	(up-get-point position-center gl-position-self-x)						;refresh the center point of the map for reference
	(up-lerp-tiles gl-fort-point1-x gl-position-center-x c: -6)				;shift gl-fort-point1-x away from the center of the map by 6 tiles, so our units won't crowd the town-center, and the TC can help defend the units
	(up-bound-point gl-fort-point1-x gl-fort-point1-x)						;make sure the point we are retreating to is inside the map bounds
	(up-target-point gl-fort-point1-x action-move -1 stance-no-attack)		;order our units to retreat back to the home town-center AND set stance to no-attack
	;(chat-to-all "Preventing units from getting lured.")
)
;====================TARGET BATTERING-RAMS IN OUR TOWN====================
;part 1
(defrule
	;(timer-triggered temp-timer)									;prevent excessive DUC ;disabled for better results, doesn't appear to affect performance
	(building-type-count town-center > 0)
(or	(players-unit-type-count target-player battering-ram-line > 0)
	(players-unit-type-count target-player armored-elephant-line > 0))
(or	(up-unit-type-in-town c: battering-ram-line > 0)				;if not target-players ram, focus-player rules should update to target the attacking enemy
	(up-unit-type-in-town c: armored-elephant-line > 0))
	(unit-type-count villager >= min-vills)
=>
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)			
	(up-get-point position-self gl-position-self-x)
	(up-set-target-point gl-position-self-x)
	(up-filter-distance c: -1 s: sn-safe-border-distance)				;find battering rams & armored-elephants within our town-size + a few tiles more
	(up-find-remote c: battering-ram-line c: 4)
	(up-find-remote c: armored-elephant-line c: 4)
	(up-find-local c: villager-class c: 7)
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 6)
)

(defrule
	;(timer-triggered temp-timer)									;prevent excessive DUC ;disabled for better results, doesn't appear to affect performance
	(building-type-count town-center > 0)
(or	(players-unit-type-count target-player battering-ram-line > 0)
	(players-unit-type-count target-player armored-elephant-line > 0))
(or	(up-unit-type-in-town c: battering-ram-line > 0)				;if not target-players ram, focus-player rules should update to target the attacking enemy
	(up-unit-type-in-town c: armored-elephant-line > 0))
	(unit-type-count villager >= min-vills)
	(up-compare-goal gl-local-total > 0)							;this was working without checking local and remote total, but better be safe in preventing DUC leaks
	(up-compare-goal gl-remote-total > 0)
	(goal gl-temp-state 6)
=>
	(up-target-objects 0 action-default -1 -1)
	;(chat-to-all "Using villagers to destroy a siege.")
)

;==========MAKE FARMERS GO TO BERRIES==========
(defrule
	(game-time < 1800)										;safety
(or	(unit-type-count male-farmer > 0)
	(unit-type-count female-farmer > 0))					;we have started making farms
	(unit-type-count villager-forager < 6)					;we have less than 10 villagers on berries
	(up-gaia-type-count c: forage-bush-class >= 2)			;must be at least 2 remaining (remember team games can affect this)
	(building-type-count mill > 0)
	(building-type-count town-center > 0)
=>
	(up-full-reset-search)
	(up-find-local c: mill c: 10)							;find local mill (was using TC but was causing far walk distances in Yucatan sometimes)
	(up-clean-search search-local -1 search-order-asc)
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 27)
)
(defrule
	(game-time < 1800)
(or	(unit-type-count male-farmer > 0)
	(unit-type-count female-farmer > 0))
	(unit-type-count villager-forager < 6)
	(up-gaia-type-count c: forage-bush-class >= 2)
	(building-type-count mill > 0)
	(building-type-count town-center > 0)
	(up-compare-goal gl-local-total > 0)
	(goal gl-temp-state 27)
=>
	(up-set-target-object search-local c: 0)								;target the first search-local result (home tc)
	(up-get-point position-object gl-point2-x)								;find & store the point on the map of the mill into one of our coordinate points
	(up-set-target-point gl-point2-x)
	(up-reset-search 1 1 1 1)												;clear the mill from our search results
	(up-filter-distance c: -1 c: 8)											;only find close forage bushes close to our lovely mill (from the gl-point2-x)
	(up-filter-status c: status-resource c: list-active)					;for active resources
	(up-find-resource c: forage-bush-class c: 10) 							;find up to 10 forage bushes ;this goes into remote-results
	(up-clean-search search-remote object-data-distance search-order-asc)	;sort the forage-bushes by the closest distance to the mill
	(up-get-search-state gl-local-total)									;store the berries into search-remote, we will check if they exist in the next rule
	(set-goal gl-temp-state 28)
)
(defrule
	(game-time < 1800)
(or	(unit-type-count male-farmer > 0)
	(unit-type-count female-farmer > 0))
	(unit-type-count villager-forager < 6)
	(up-gaia-type-count c: forage-bush-class >= 2)
	(building-type-count mill > 0)
	(building-type-count town-center > 0)
	(up-compare-goal gl-remote-total > 1)					;at least 2 bushes have been found, so yes, they do exist! Continue! (don't want to clobber farmers to berries if only 1 bush left)
	(goal gl-temp-state 28)
=>
	(up-set-target-object search-remote c: 0)				;target the forage bush now that it for sure exists
	(up-reset-filters)										;clear the distance filter so we can find villagers anywhere
	(up-find-local c: male-farmer c: 10)					;must define these in constants (userpatch file probably)
	(up-find-local c: female-farmer c: 10)
	(up-clean-search search-local -1 search-order-asc)
	;(up-remove-objects search-local object-data-gather-type != food) ;safety for farmers (not needed now)
	(up-target-objects 0 action-default -1 -1)				;use 0 so they spread to multiple bushes?
)

	;==========SEND TROOPS TO THE FRONT WHEN ATTACKING==========
(defrule
	(goal ATTACK yes)
	(goal ENEMY-LOCATED yes)
	(timer-triggered eco-timer)
	(building-type-count town-center > 0)
	(military-population >= 4) ;scout plus a few military
	(players-building-count any-enemy > 0)
=>
	(up-full-reset-search)
	(up-get-point position-self gl-position-self-x)
	(up-set-target-point gl-position-self-x)
	(up-filter-distance c: -1 s: sn-safe-border-distance)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-filter-exclude -1 actionid-explore -1 -1)
	(up-find-local c: all-units-class c: 240)
	(up-remove-objects search-local object-data-order == orderid-explore)
    (up-clean-search search-local -1 search-order-asc)
	(up-get-search-state gl-local-total)
	(set-goal gl-temp-state 29)
	;(chat-to-all "Attack rule 1.") ;debug
)
(defrule
	(goal ATTACK yes)
	(goal ENEMY-LOCATED yes)
	(timer-triggered eco-timer)
	(building-type-count town-center > 0)
	(military-population >= 4) ;scout plus a few military
	(players-building-count any-enemy > 0)
	(up-compare-goal gl-local-total >= 1) 	
	(goal gl-temp-state 29)
=>
	(up-reset-filters)
    (up-modify-sn sn-focus-player-number g:= TARGET-ENEMY)
    (up-find-remote c: building-class c: 1)
	(up-find-remote c: tower-class c: 1)
	(up-find-remote c: wall-class c: 1)
	(up-find-remote c: gate-class c: 1)
    (up-clean-search search-remote -1 search-order-asc)
	(up-target-objects 0 action-default -1 -1)
	;(chat-to-all "Attack rule 2.") ;debug
)




