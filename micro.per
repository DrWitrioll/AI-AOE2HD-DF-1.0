;====================RETREAT UNITS FROM ARROW FIRE====================

	;default TURN ON dodge-arrows
(defrule
	(goal DODGE-ARROWS wait)
	(building-type-count town-center > 0)
(or	(and	(goal NOMAD yes)
	(and	(goal sheep-micro no)
			(game-time > 180)))
(or	(and	(goal NOMAD no)
		(game-time > 30))
	(up-projectile-detected projectile-any < 5000))) ;10,000
=>
	;(chat-local-to-self "Arrow dodging micro enabled.")
	(set-goal DODGE-ARROWS yes)
	(disable-self))

	;BACKUP DODGE ARROWS RULE
(defrule
	(game-time > 480)
	(building-type-count town-center > 0)
	(goal is-town-under-attack no)
	(up-compare-goal DODGE-ARROWS != yes)
=>
	(set-goal DODGE-ARROWS yes)
	(disable-self))

	;wait by default (see main Jester.per)
	;these two rules help prevent Jester from getting all glitchy
	;ON
	(defrule
	(up-compare-goal DODGE-ARROWS != yes) ;starts off as "wait"
	(goal is-town-under-attack no) ;added 2 conditions to prevent spam turning on & off
(not	(enemy-buildings-in-town))
	(game-time > 30) ;safety
=>
	;(chat-local-to-self "Enabling arrow dodging.")
	(set-goal DODGE-ARROWS yes)
)
	;OFF
	(defrule
	(up-compare-goal DODGE-ARROWS != no)
(or	(goal is-town-under-attack yes)
	(enemy-buildings-in-town))
	(game-time > 30) ;safety
;(or	(up-building-type-in-town c: town-center-foundation > 0)
;(or	(up-building-type-in-town c: town-center > 0)
;(or	(up-building-type-in-town c: watch-tower-line > 0)
;(or	(up-building-type-in-town c: donjon > 0)
;(or	(up-building-type-in-town c: bombard-tower > 0)
;(or	(up-building-type-in-town c: krepost > 0)
;	(up-building-type-in-town c: castle > 0))))))))
=>
	(chat-local-to-self "Disabling arrow dodging.")
	(set-goal DODGE-ARROWS no)
)

;======================LEGEND FOR PROJECTILE-TYPES======================;thanks Leif

;ID	Name							;Description
;0	projectile-town-center			Town Center arrows.
;1	projectile-castle				Castle arrows.
;2	projectile-watch-tower			Watch Tower, Guard Tower, and Keep.
;3	projectile-bombard-tower		Bombard Tower cannonballs.
;4	projectile-ship					Projectiles from any warship.
;5	projectile-siege				Projectiles from any ranged siege weapon, except scorpions.
;6	projectile-fortification		Projectiles from Kreposts or Donjons.
;7	projectile-any					Any projectile from soldiers, siege weapons, scorpions, ships, or buildings.

(defrule
(or	(goal DODGE-ARROWS no) 											;ignore when we aren't focusing on dodging arrows
(or	(town-under-attack)												;ignore if we are under attack at any time (prevents weird behavior)
(or	(goal is-town-under-attack yes)									;ignore if we are actively defending our town (prevents weird behavior)
(or	(strategic-number sn-focus-player-number == my-player-number)	;ignore when we are using other DUC rules while focused on ourself (prevents weird behavior)
(or	(goal EMERGENCY-ATTACK yes) 									;ignore when we are pop-capped
(or	(game-time < 30)												;ignore at game start
(or	(goal MEME-STRATEGY 1) 											;ignore when meme-strategy "the liar" is activated
(or	(soldier-count > 50)											;ignore if high military count
(or	(military-population >= max-mil-pop)							;ignore if maxed out military (low-pop games)
;(or	(goal ENEMY-LOCATED no)										;ignore if we have not seen any enemies (causes early scouts to run into arrows)
	(building-type-count town-center < 1))))))))))					;ignore if no fully built town-center
=>
	(up-jump-rule 24)) ;save performance by skipping altogether

;------------------------------
; Dodge Fortification Arrow Fire From any enemy Fortifications
;------------------------------
;ENEMY KREPOST RETREAT (ANY KREPOST TEST) (step 1)
(defrule
	(goal DODGE-ARROWS yes)
	(soldier-count <= 50);testing
	(players-building-type-count target-player krepost > 0)					;enemy has at least 1 krepost
	(up-projectile-detected projectile-fortification < 20000)
=>
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number) 		;find-remote works with the focus-player, so set it to the target
	(up-find-remote c: krepost c: 10) 										;try to find up to 10 kreposts from the focus-player
	(up-clean-search search-remote -1 search-order-asc) 					;sort from oldest built first to newest built (this helps in situations with more than 1 krepost firing at the same time)
	(up-remove-objects search-remote object-data-action != actionid-attack)	;remove any kreposts that are not currently attacking something
	(up-get-search-state gl-local-total) 									;store search state information NOTE: ALWAYS use the local-total as 4 goals in ascending order get stored for local & remote
	(set-goal gl-temp-state 7)												;used for continuing rules
)
	;ENEMY KREPOST (step 2)
(defrule
	;please add a timer or goal check here to block these rules from repeating each pass 
	(goal DODGE-ARROWS yes)														;relist our MUST HAVE conditions
	(soldier-count <= 50)
	(players-building-type-count target-player krepost > 0)
	(goal gl-temp-state 7)														;the first rule fired, so we are on the next step
	(up-compare-goal gl-remote-total > 0) 										;we have successfully found and stored at least 1 krepost in the results, so now we can target the krepost
	(up-set-target-object search-remote c: 0) 									;set the first search-remote result as the target-object
(or	(up-projectile-detected projectile-fortification < 20000)					;retreat from the krepost IF: any krepost has fired in the last 20 seconds, OR:
	(up-object-data object-data-garrison-count >= 0))							;just retreat from last fired krepost
=>
	;prepare to check my own units
	(up-get-point position-object gl-fort-point1-x) 								;find and store the krepost position (x,y) into gl-fort-point1-x (gl-fort-point1-x and gl-fort-point1-y), so we are targeting the point on the map, not the krepost
	(up-set-target-point gl-fort-point1-x) 										;set the krepost's position as the target-point
	(up-filter-exclude -1 -1 -1 913) 										;set up filters to exclude certain units from retreating: this excludes unit class 913 (siege weapons like rams, etc.)
	(up-filter-distance c: -1 c: 13) 										;this command uses the target-point as the center and will find our units up to 13 tiles away from the center of it (within the kreposts approximate range)
	(set-goal gl-temp-state 8) 											;continue on the next rule if possible
)
	;ENEMY KREPOST (step 3)
(defrule
	(goal DODGE-ARROWS yes)													;relist our MUST HAVE conditions
	(soldier-count <= 50)
	(players-building-type-count target-player krepost > 0)
	(up-compare-goal gl-remote-total > 0) 									;we have successfully found and stored at least 1 krepost in the results, so now we can target the krepost
	(goal gl-temp-state 8) 												;continuing only if the previous rule worked
(or	(up-projectile-detected projectile-fortification < 20000)					;retreat from the krepost IF: any krepost has fired in the last 20 seconds, OR:
	(up-object-data object-data-garrison-count >= 0))						;we are within distance of the krepost last fired krepost
	(up-find-local c: all-units-class c: 1) 								;find 1 of our units that are within the distance filter by tiles of the enemy krepost and are not any of the excluded classes listed in the last rule
=>
	;if we're here, we found a matching unit
	(up-remove-objects search-local object-data-class == 913)
	(generate-random-number 5) 												;get a random number from 1 to 4 (we'll use this to get a random retreat distance)
	(up-get-fact random-number 0 gl-random) 								;store the random number into gl-random
	(up-modify-goal gl-random c:+ 2) 										;add 1 to gl-random, so its range is now 2 to 5
	(up-modify-goal gl-random g:neg gl-random) 								;negate gl-random, so it's now -2 to -5
	(up-set-target-object search-local c: 0) 								;set my first matching unit as the target-object
	(up-get-point position-object gl-fort-point2-x) 						;store my unit's position into gl-fort-point2-x
	(up-cross-tiles gl-fort-point2-x gl-fort-point1-x c: -2)				;don't run away in a straight line
	(up-lerp-tiles gl-fort-point2-x gl-fort-point1-x g: gl-random) 			;shift gl-fort-point2-x by "gl-random" tiles toward gl-point1 (gl-random is negative, so it moves AWAY) and store the result in gl-fort-point2-x
	(up-bound-point gl-fort-point2-x gl-fort-point2-x)
	(up-set-target-point gl-fort-point2-x) 									;set the new position as the target-point
	(up-target-point 0 action-move -1 stance-no-attack) 					;move my unit to the target-point (the up-target-point command performs the action on everyone in the local search results list, which is only the 1 unit) stand-ground helps to prevent retaliation
	;prepare to check the next unit
	(up-set-target-point gl-fort-point1-x) 										;set the target-point back to the enemy tower for our next units to use
	;(up-full-reset-search)
	(up-reset-search 0 1 0 0) 												;remove our current unit from the local search results, but leave everything else as-is to resume searching after it
	(up-jump-rule -1) 														;-1 means it will repeat this same rule, going back to (goal gl-temp-state 1)
)
;ENEMY CASTLE RETREAT (ANY castle TEST) (step 1)
(defrule
	(goal DODGE-ARROWS yes)
	(soldier-count <= 50);testing
	(players-building-type-count target-player castle > 0)					;enemy has at least 1 castle
	(up-projectile-detected projectile-castle < 20000)
=>
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number) 		;find-remote works with the focus-player, so set it to the target
	(up-find-remote c: castle c: 10) 										;try to find up to 10 castles from the focus-player
	(up-clean-search search-remote -1 search-order-asc) 					;sort from oldest built first to newest built (this helps in situations with more than 1 castle firing at the same time)
	(up-remove-objects search-remote object-data-action != actionid-attack)	;remove any castles that are not currently attacking something
	(up-get-search-state gl-local-total) 									;store search state information NOTE: ALWAYS use the local-total as 4 goals in ascending order get stored for local & remote
	(set-goal gl-temp-state 9)												;used for continuing rules
)
	;ENEMY CASTLE (step 2)
(defrule
	;please add a timer or goal check here to block these rules from repeating each pass 
	(goal DODGE-ARROWS yes)														;relist our MUST HAVE conditions
	(soldier-count <= 50)
	(players-building-type-count target-player castle > 0)
	(goal gl-temp-state 9)														;the first rule fired, so we are on the next step
	(up-compare-goal gl-remote-total > 0) 										;we have successfully found and stored at least 1 castle in the results, so now we can target the castle
	(up-set-target-object search-remote c: 0) 									;set the first search-remote result as the target-object
(or	(up-projectile-detected projectile-castle < 20000)							;retreat from the castle IF: any castle has fired in the last 20 seconds, OR:
	(up-object-data object-data-garrison-count >= 0))							;just retreat from last fired castle
=>
	;prepare to check my own units
	(up-get-point position-object gl-fort-point1-x) 								;find and store the castle position (x,y) into gl-fort-point1-x (gl-fort-point1-x and gl-fort-point1-y), so we are targeting the point on the map, not the castle
	(up-set-target-point gl-fort-point1-x) 										;set the castle's position as the target-point
	(up-filter-exclude -1 -1 -1 913) 										;set up filters to exclude certain units from retreating: this excludes unit class 913 (siege weapons like rams, etc.)
	(up-filter-distance c: -1 c: 16) 										;this command uses the target-point as the center and will find our units up to 16 tiles away from the center of it (within the castles approximate range)
	(set-goal gl-temp-state 10) 											;continue on the next rule if possible
)
	;ENEMY CASTLE (step 3)
(defrule
	(goal DODGE-ARROWS yes)													;relist our MUST HAVE conditions
	(soldier-count <= 50)
	(players-building-type-count target-player castle > 0)
	(up-compare-goal gl-remote-total > 0) 									;we have successfully found and stored at least 1 castle in the results, so now we can target the castle
	(goal gl-temp-state 10) 												;continuing only if the previous rule worked
(or	(up-projectile-detected projectile-castle < 20000)					;retreat from the castle IF: any castle has fired in the last 20 seconds, OR:
	(up-object-data object-data-garrison-count >= 0))						;we are within distance of the castle last fired castle
	(up-find-local c: all-units-class c: 1) 								;find 1 of our units that are within the distance filter by tiles of the enemy castle and are not any of the excluded classes listed in the last rule
=>
	;if we're here, we found a matching unit
	(up-remove-objects search-local object-data-class == 913)
	(generate-random-number 5) 												;get a random number from 1 to 5 (we'll use this to get a random retreat distance)
	(up-get-fact random-number 0 gl-random) 								;store the random number into gl-random
	(up-modify-goal gl-random c:+ 4) 										;add 4 to gl-random, so its range is now 5 to 9
	(up-modify-goal gl-random g:neg gl-random) 								;negate gl-random, so it's now -2 to -5
	(up-set-target-object search-local c: 0) 								;set my first matching unit as the target-object
	(up-get-point position-object gl-fort-point2-x) 						;store my unit's position into gl-fort-point2-x
	(up-cross-tiles gl-fort-point2-x gl-fort-point1-x c: -2)				;don't run away in a straight line
	(up-lerp-tiles gl-fort-point2-x gl-fort-point1-x g: gl-random) 			;shift gl-fort-point2-x by "gl-random" tiles toward gl-point1 (gl-random is negative, so it moves AWAY) and store the result in gl-fort-point2-x
	(up-bound-point gl-fort-point2-x gl-fort-point2-x)
	(up-set-target-point gl-fort-point2-x) 									;set the new position as the target-point
	(up-target-point 0 action-move -1 stance-no-attack) 					;move my unit to the target-point (the up-target-point command performs the action on everyone in the local search results list, which is only the 1 unit) stand-ground helps to prevent retaliation
	;prepare to check the next unit
	(up-set-target-point gl-fort-point1-x) 										;set the target-point back to the enemy tower for our next units to use
	;(up-full-reset-search)
	(up-reset-search 0 1 0 0) 												;remove our current unit from the local search results, but leave everything else as-is to resume searching after it
	(up-jump-rule -1) 														;-1 means it will repeat this same rule, going back to (goal gl-temp-state 1)
)

