
	;Unit micro for Jester (direct unit control - DUC file)
;
;=========IMPORTANT INFORMATION ABOUT DUC:
;
; 	"search-local" store objects we want to control. MAX: 240 items. ONLY the ai itself.
;	use "up-find-local" with search-local
; 	"search-remote" stores objects we want to target. MAX: 40 items. Can be any player including the ai itself.
;	use "up-find-remote" with search-remote
;
;	All "point goals" values must be greater-than 40
;
; I am a beginner with DUC in ai, so only basic DUC has been added to limit ai breaking errors.

;NOTE: gl-temp-state is a split rule goal. So every micro rule has its own goal. REMEMBER THIS SCREAMING!

;GET INTIAL POSITIONS ON THE MAP (other rules will update these later)
(defrule
	(game-time > 30)						;safety
	(building-type-count town-center > 0)	;safety
	(unit-type-count villager > 0)			;safety
=>
	(up-full-reset-search)
	(up-get-point position-center gl-position-center-x)		;store the map-center
	(up-get-point position-self gl-position-self-x)			;store our home TC position & use another point goal for lerping tiles later
	(up-get-point position-corner gl-position-corner-x)		;for market-placement or other corner activities
	(disable-self)
	;(up-get-point position-map-size gl-point-x) ;for later
)

	;enable temp-timer to be used for resetting military attack stance
(defrule
	(game-time > 30)
	(goal sheep-micro no)
	(building-type-count town-center > 0)
	(up-timer-status attack-timer < timer-running) ;timer disabled or not running
=>
	(enable-timer temp-timer 10) ;10 seconds to prevent lag & units getting stuck at the border when retreating to town ;15 seconds for looping
	(disable-self)
)

;==========SCOUT MICRO==========

	;set scouting unit stance to no-attack
(defrule
	(game-time < 360)
	(unit-type-count scout-unit > 0) ;should be no duc leaks
=>
	(up-full-reset-search)
	(up-find-local c: scout-unit c: 1)
	(up-target-objects 0 action-default -1 stance-no-attack)		;no-attack prevents Jester from attacking buildings after retreating from tc or other fortifications.
	(disable-self))

	;NEW reset scouting unit stance to defensive
(defrule
	(goal is-town-under-attack yes)
(or	(up-enemy-units-in-town > 1)
	(enemy-buildings-in-town))
	(unit-type-count scout-unit > 0)
=>
	(up-full-reset-search)
	(up-find-local c: scout-unit c: 1)
	(up-target-objects 0 action-default -1 stance-defensive)
	(disable-self))

;==========Make Scout Gather Sheep==========

(defrule
	;IF:													;===the following are conditions===
	(game-time <= 1000) 									;only execute before 1000 game seconds
	(unit-type-count scout-unit > 0) 						;we have 1 scout-cavalry, eagle-scout, or camel-scout (defined in constants.per file)
	(building-type-count town-center > 0)					;we have at least 1 built town center still alive
	(up-gaia-type-count c: livestock-class > 0) 			;we currently see at least 1 alive livestock
=>	;THEN:													;===the following are actions if the conditions are met===
	(up-full-reset-search)									;reset (or clear) all search and filters for new micro (prevents DUC leaks from affecting other DUC rules)
	(up-find-local c: scout-unit c: 1) 						;find our scout-unit (scout cavalry, eagle warrior, or camel-line from before)
	(up-get-search-state gl-local-total) 					;store search state information (1 scout unit in results)
	(set-goal gl-temp-state 1)								;update our temp-state goal for further progression to next rule below (prevents DUC leaks)
)

(defrule
	(game-time <= 1000)										;only execute before 1000 game seconds
	(goal gl-temp-state 1)									;our temporary goal set from before that allows us to progress
	(unit-type-count scout-unit > 0)						;our scout unit is still alive
	(building-type-count town-center > 0)					;we have at least 1 built town center still alive
	(up-compare-goal gl-local-total c:== 1) 				;we have found our scout
	(up-gaia-type-count c: livestock-class > 0)				;we have spotted an alive gaia-owned livestock-class in our sights
=> 
	(up-set-target-object search-local c: 0) 				;set-up our scout for DUC (0 is the first unit in the list found, 1 would be 2, 2 would be 3 and so on)
	(up-get-point position-object gl-fort-point1-x)			;find the point the scout is in our X and Y coordinates value on the map
	(up-set-target-point gl-fort-point1-x) 					;target the point the scout is located on the map
	(up-filter-distance c: -1 c: 30) 						;set up a distance filter to only find objects up to 30 tiles away from our scout (in this case, livestock)
	(up-modify-sn sn-focus-player-number s:= gaia)			;with up-find-remote coming up next, we will focus on gaia as we want to find sheep not owned by any other players
	(up-find-remote c: livestock-class c: 1) 				;search for the first sheep owned by gaia (with the filter on)
	(up-target-objects 0 action-move -1 stance-no-attack) 	;send our scout to the first sheep found in the results
	(up-full-reset-search) 									;clear filters and search results (so future micro is not affected)
	;(chat-local-to-self "I am a micro god for sheep!") 	;confirmation message for debugging purposes (to see if the rule is working correctly)
)

