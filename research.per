
	;Research and escrow rules for Jester.per

;==========ESCROW RULES==========

;DEFAULT ESCROW GOAL
(defrule
	(true)
=>
	(set-goal DEFAULT-ESCROW yes) ;yes or no for now
	(disable-self)
)

;----------DEFAULT ESCROW RULES----------

;First escrow release (usually high res games, but you never know in DE!)
(defrule
	(game-time > 30)
(or	(escrow-amount food > 0)
(or	(escrow-amount wood > 0)
(or	(escrow-amount gold > 0)
	(escrow-amount stone > 0))))
=>
	(release-escrow food)
	(release-escrow wood)
	(release-escrow gold)
	(release-escrow stone)
	(disable-self))

;Second escrow
;(defrule
;	(current-age >= castle-age)
;(or	(escrow-amount food > 1500)
;(or	(escrow-amount wood > 1200)
;	(escrow-amount gold > 1000)))
;=>
;	(release-escrow food)
;	(release-escrow wood)
;	(release-escrow gold)
;	(release-escrow stone)
;	(disable-self))

;Backup escrow release (in case it gets too high)
(defrule
	(current-age >= castle-age)
	(escrow-amount food > 1000)
=>
	(release-escrow food))

(defrule
	(current-age >= castle-age)
	(escrow-amount wood > 500) ;most buildings aren't more than this
=>
	(release-escrow wood))

(defrule
	(current-age >= castle-age)
	(escrow-amount gold > 1000)
=>
	(release-escrow gold))

(defrule
	(current-age >= castle-age)
	(escrow-amount stone > 1); stone escrow should be turned off...
=>
	(release-escrow stone))

	;EMERGENCY ESCROW RELEASE IF 0 TOWN-CENTERS
(defrule
	(current-age-time > 15) ;safety
	(unit-type-count villager >= 1) ;at least 1 alive
	(building-type-count-total town-center < 1) ;none at all built or currently building
(or	(escrow-amount food > 1)
(or	(escrow-amount wood > 1)
(or	(escrow-amount gold > 1)
	(escrow-amount stone > 1))))
=>
	;(chat-to-player my-player-number "Releasing all escrow for a town-center.")
	(release-escrow food)
	(release-escrow wood)
	(release-escrow gold)
	(release-escrow stone)
); don't disable

	;EMERGENCY escrow release (when town is under attack)
(defrule
	(goal is-town-under-attack yes)
	(strategic-number sn-military-level <= 0)
(or	(escrow-amount food >= 10) ;200
(or	(escrow-amount wood >= 10) ;200
(or	(escrow-amount gold >= 10) ;200
	(escrow-amount stone >= 10)))) ;200
=>
	;(chat-to-player my-player-number "Releasing all escrow to defend town.")
	(release-escrow food)
	(release-escrow wood)
	(release-escrow gold)
	(release-escrow stone)
)

;no escrow for dark-age or feudal-age.

;CASTLE AGE ESCROW 1
(defrule
	(goal DEFAULT-ESCROW yes) ; yes = average escrow, no = special escrow
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age == castle-age)
	(unit-type-count villager <= 45)
	(unit-type-count villager < max-vill-pop) ;for low pop games
=>
	(set-escrow-percentage wood 6) ;5
	(set-escrow-percentage food 6) ;5
	(set-escrow-percentage gold 6) ;5
	(set-escrow-percentage stone 0)
)
;CASTLE AGE ESCROW 2
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age == castle-age)
	(unit-type-count villager > 45)
	(unit-type-count villager <= 75)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 12)
	(set-escrow-percentage food 12)
	(set-escrow-percentage gold 12)
	(set-escrow-percentage stone 0)
)
;CASTLE AGE ESCROW 3
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age == castle-age)
	(unit-type-count villager > 75)
	(unit-type-count villager <= 100)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 16)
	(set-escrow-percentage food 16)
	(set-escrow-percentage gold 16)
	(set-escrow-percentage stone 0)
)
;CASTLE AGE ESCROW 4
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age == castle-age)
	(unit-type-count villager > 100)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 18)
	(set-escrow-percentage food 18)
	(set-escrow-percentage gold 18)
	(set-escrow-percentage stone 0)
)

;CASTLE AGE MAX POP ESCROW (low pop)
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age == castle-age)
	(unit-type-count villager <= 100)
	(unit-type-count villager >= max-vill-pop)
=>
	(set-escrow-percentage wood 12)
	(set-escrow-percentage food 12)
	(set-escrow-percentage gold 12)
	(set-escrow-percentage stone 0)
)

;CASTLE AGE MAX POP ESCROW (high pop)
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age == castle-age)
	(unit-type-count villager > 100)
	(unit-type-count villager >= max-vill-pop)
=>
	(set-escrow-percentage wood 15)
	(set-escrow-percentage food 15)
	(set-escrow-percentage gold 15)
	(set-escrow-percentage stone 0)
)

;NORMAL IMPERIAL ESCROW
;none

;IMPERIAL AGE ESCROW 1
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age >= imperial-age)
	(unit-type-count villager <= 45)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 5)
	(set-escrow-percentage food 5)
	(set-escrow-percentage gold 5)
	(set-escrow-percentage stone 0)
)
;IMPERIAL AGE ESCROW 2
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age >= imperial-age)
	(unit-type-count villager > 45)
	(unit-type-count villager <= 75)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 10)
	(set-escrow-percentage food 10)
	(set-escrow-percentage gold 10)
	(set-escrow-percentage stone 0)
)
;IMPERIAL AGE ESCROW 3
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age >= imperial-age)
	(unit-type-count villager > 75)
	(unit-type-count villager <= 100)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 17)
	(set-escrow-percentage food 17)
	(set-escrow-percentage gold 17)
	(set-escrow-percentage stone 0)
)

;IMPERIAL AGE ESCROW max vill pop (low)
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age >= imperial-age)
	(current-age-time < 1500) ; 25 minutes
	(unit-type-count villager <= 100)
	(unit-type-count villager >= max-vill-pop)
=>
	(set-escrow-percentage wood 14)
	(set-escrow-percentage food 14)
	(set-escrow-percentage gold 14)
	(set-escrow-percentage stone 0)
)

;IMPERIAL AGE ESCROW max vill pop (high)
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age >= imperial-age)
	(current-age-time < 1500) ; 25 minutes
	(unit-type-count villager > 100)
	(unit-type-count villager >= max-vill-pop)
=>
	(set-escrow-percentage wood 18)
	(set-escrow-percentage food 18)
	(set-escrow-percentage gold 18)
	(set-escrow-percentage stone 0)
)
;IMPERIAL AGE ESCROW under 25 minutes of age time
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age >= imperial-age)
	(current-age-time < 1500) ; 25 minutes
	(unit-type-count villager > 100)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 22)
	(set-escrow-percentage food 22)
	(set-escrow-percentage gold 22)
	(set-escrow-percentage stone 0)
)
; IMPERIAL AGE ESCROW after 25 minutes of age time
(defrule
	(goal DEFAULT-ESCROW yes)
	(goal BUILD-THE-WONDER no)
	(goal WONDER-MODE no)
	(current-age >= imperial-age)
	(current-age-time > 1500) ; 25 minutes
	(unit-type-count villager > 100)
	(unit-type-count villager < max-vill-pop)
=>
	(set-escrow-percentage wood 10)
	(set-escrow-percentage food 10)
	(set-escrow-percentage gold 10)
	(set-escrow-percentage stone 0)
)

;GO IMPERIAL WHEN ENEMY IS IMPERIAL (Currently does nothing)
(defrule
(goal WONDER-MODE no)
(current-age == castle-age)
(players-current-age target-player == imperial-age)
=>
(do-nothing) ;this is here until we add a goal to this
;(chat-to-player my-player-number "Enemy is in the Imperial age first.")
(disable-self)
)

;BUILD-THE-WONDER ESCROW OFF
(defrule
	(goal WONDER-MODE yes)
=>
	(set-escrow-percentage food 0)
	(set-escrow-percentage wood 0)
	(set-escrow-percentage gold 0)
	(set-escrow-percentage stone 0)
)

(defrule
	(game-time > 30); backup rule to make sure no escrow is collected.
	(goal WONDER-MODE yes)
=>
	(release-escrow food)
	(release-escrow wood)
	(release-escrow gold)
	(release-escrow stone)
	(disable-self))

;==========RESEARCH RULES

	;DARK-AGE RESEARCH

;LOOM (nomad no)
(defrule
	(goal NOMAD no)
(or	(and	(game-time > 36) ;enough time for building houses
		(up-pending-objects c: villager < 1))
(or	(unit-type-count villager >= amount-villagers-dark); get loom when we have enough vils.
(or	(unit-type-count villager >= max-vill-pop) ;just in case
(or	(civ-selected chinese)
(or	(civ-selected mayan)
	(goal is-town-under-attack yes))))))
	(can-research ri-loom)
=>
	;(chat-to-player my-player-number "Researching loom.")
	(research ri-loom)
)

;LOOM (nomad yes)
(defrule
	(goal NOMAD yes)
(or	(and	(up-pending-objects c: villager < 1)
		(unit-type-count-total villager >= 6)) ;min nomad vills
(or	(unit-type-count villager >= amount-villagers-dark); get loom when we have enough vils.
(or	(unit-type-count villager >= max-vill-pop) ;just in case
(or	(civ-selected chinese)
(or	(civ-selected mayan)
	(goal is-town-under-attack yes))))))
	(can-research ri-loom)
=>
	;(chat-to-player my-player-number "Researching loom.")
	(research ri-loom)
)

;FEUDAL-AGE (fast-castle yes) (NOT malay)
(defrule
	(goal FAST-CASTLE yes)
(not	(civ-selected malay))
(or	(unit-type-count-total villager >= 27) ;26 is optimium, but for a stubborn ai 27 is better
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(current-age == dark-age)
	(can-research feudal-age)
	;(research-completed ri-loom) testing
=>
	(research feudal-age))

;FEUDAL-AGE (fast-castle yes) (malay only)
(defrule
	(goal FAST-CASTLE yes)
	(civ-selected malay)
(or	(unit-type-count-total villager >= 29) ;29 for malay
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(current-age == dark-age)
	(can-research feudal-age)
	;(research-completed ri-loom) testing
=>
	(research feudal-age))

;FEUDAL-AGE (fast-castle no) (NOT malay)
(defrule
	(goal FAST-CASTLE no)
(not	(civ-selected malay))
(or	(unit-type-count-total villager >= 21) ;minimum allowed
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(current-age == dark-age)
	(can-research feudal-age)
	;(research-completed ri-loom) testing
=>
	(research feudal-age))

;FEUDAL-AGE (fast-castle no) (malay)
(defrule
	(goal FAST-CASTLE no)
	(civ-selected malay)
(or	(unit-type-count-total villager >= 23) ;minimum allowed for malay
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(current-age == dark-age)
	(can-research feudal-age)
	;(research-completed ri-loom) testing
=>
	(research feudal-age))

;FEUDAL-AGE (escrow - high res start game) (not malay)
(defrule
	(current-age == dark-age)
(not	(civ-selected malay))
(or	(and	(goal FAST-CASTLE no)
		(unit-type-count-total villager >= 21))
(or	(and	(goal FAST-CASTLE yes)
		(unit-type-count-total villager >= 27))
	(unit-type-count-total villager >= max-vill-pop)));for low-pop games
	(can-research-with-escrow feudal-age)
	;(research-completed ri-loom) testing
=>
	(release-escrow food)
	(research feudal-age))

;FEUDAL-AGE (escrow - high res start game) (malay)
(defrule
	(current-age == dark-age)
(not	(civ-selected malay))
(or	(and	(goal FAST-CASTLE no)
		(unit-type-count-total villager >= 23))
(or	(and	(goal FAST-CASTLE yes)
		(unit-type-count-total villager >= 29))
	(unit-type-count-total villager >= max-vill-pop)));for low-pop games
	(can-research-with-escrow feudal-age)
	;(research-completed ri-loom) testing
=>
	(release-escrow food)
	(research feudal-age))

;EMERGENCY RESEARCH FEUDAL-AGE ;introduced after discovering major bug with malay not researching feudal age if too much food and going for a rushing strategy
(defrule
	(current-age == dark-age)
	(current-age-time >= 600)
	(food-amount >= 1500) ;alot
	(building-type-count town-center > 0)
	(can-research feudal-age)
=>
	(research feudal-age)
)

;ADVANCING TO FEUDAL AGE TEXT
(defrule
(up-research-status c: feudal-age == research-pending)
=>
(chat-local-to-self "I'm advancing to the Feudal Age.")
(chat-to-allies "I'm advancing to the Feudal Age.")
(disable-self))

			;FEUDAL-AGE RESEARCH

;ECONOMY
;TOWN-CENTER

;WHEEL BARROW (no escrow)
(defrule
(or	(current-age >= castle-age)
	(goal FAST-CASTLE no))
(or	(unit-type-count-total villager >= 35) ;37
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(can-research ri-wheel-barrow)
=>
	(research ri-wheel-barrow)
)
;WHEEL BARROW (escrow)
(defrule
(or	(current-age >= castle-age)
	(goal FAST-CASTLE no))
(or	(unit-type-count-total villager >= 37) ;35
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(can-research-with-escrow ri-wheel-barrow)
=>
	(release-escrow food)
	(release-escrow wood)
	(research ri-wheel-barrow)
)
;TOWN WATCH
(defrule
	(current-age-time > 15) ;allow other upgrades first
	(goal is-town-under-attack no); don't waste if already under attack
(or	(and	(current-age >= castle-age)
			(population > 60))
	(unit-type-count-total villager >= max-vill-pop)) ;backup
	(can-research-with-escrow ri-town-watch)
=>
	(release-escrow food)
	(research ri-town-watch)
)

;MILL
;HORSE COLLAR (part 1) (FAST-CASTLE YES)
(defrule
(or	(and	(goal FAST-CASTLE yes)
			(goal castle-pending yes))
(or	(and	(current-age >= castle-age)
			(building-type-count-total farm > 3))
	(building-type-count-total farm > 11)))
(or	(unit-type-count-total villager > min-vills)
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(research-completed ri-double-bit-axe) ;MUST COME FIRST
	(can-research ri-horse-collar)
=>
	(research ri-horse-collar)
)

;HORSE COLLAR (part 2) (FAST-CASTLE no)
(defrule
	(goal FAST-CASTLE no)
(or	(building-type-count archery-range > 0)
(or	(building-type-count stable > 0)
(or	(and	(current-age >= castle-age)
			(building-type-count-total farm > 5))
	(building-type-count farm >= 12)))); max farms without horse collar allowed
(or	(unit-type-count-total villager-farmer >= 4); at least 4 farms being used (minimal allowed)
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(research-completed ri-double-bit-axe)
	(can-research ri-horse-collar)
=>
	(research ri-horse-collar)
)

;HORSE COLLAR (burgundians)
(defrule
	(goal burgundian-civ yes)
;	(current-age >= dark-age) ;any-age
	(unit-type-count villager >= 10);6 ;min vils
	(building-type-count-total farm >= 2) ;beginning to make farms
	(wood-amount > 200) ;wood buffer
	(dropsite-min-distance wood <= 7) ;stable woodline
	(research-completed ri-double-bit-axe)
	(can-research ri-horse-collar)
=>
	(research ri-horse-collar)
)

	;EMERGENCY HORSE-COLLAR
(defrule
	;(current-age >= feudal-age) ;any-age
(or	(unit-type-count-total villager-farmer >= 15) ;too many farmers without horse-collar
(or	(building-type-count-total farm >= 15) ;17
	(unit-type-count-total villager >= max-vill-pop)))
(or	(dropsite-min-distance wood <= 8) ;stable woodline
	(wood-amount >= 250))
	(can-research-with-escrow ri-horse-collar)
=>
	(release-escrow food)
	(release-escrow wood)
	(research ri-horse-collar))

;LUMBER CAMP
;DOUBLE-BIT-AXE
(defrule
	(goal FAST-CASTLE yes)
(or	(goal castle-pending yes)
(or	(current-age >= castle-age)
(or	(and	(current-age == feudal-age)
		(current-age-time > 240)) ;more than 4 minutes just get it anyway
	(food-amount > 930))));excess that won't interfere with age-up
(or	(unit-type-count-total villager-wood >= 10) ;min wood vills for double-bit
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(can-research ri-double-bit-axe)
=>
	(research ri-double-bit-axe)
)

;DOUBLE-BIT-AXE (fast-castle no)
(defrule
	(goal FAST-CASTLE no)
(or	(building-type-count archery-range > 0)
(or	(building-type-count stable > 0)
(or	(building-type-count castle > 0)
(or	(building-type-count town-center > 1)
	(building-type-count farm >= 10)))))
(or	(unit-type-count villager-wood >= 10) ;min wood vills
(or	(unit-type-count-total villager > min-vills)
	(unit-type-count-total villager >= max-vill-pop)));for low-pop games
	(can-research ri-double-bit-axe)
=>
	(research ri-double-bit-axe)
)

	;EMERGENCY DOUBLE-BIT AXE (escrow)
(defrule
(or	(unit-type-count-total villager-wood >= 20) ;too many wood cutters
(or	(unit-type-count-total villager-farmer >= 16) ;need to support many farms
	(unit-type-count-total villager >= max-vill-pop))) ;low pop maxed out
	(can-research-with-escrow ri-double-bit-axe)
=>
	(release-escrow food)
	(release-escrow wood)
	(research ri-double-bit-axe))

;DOUBLE-BIT-AXE (burgundians)
(defrule
	(goal burgundian-civ yes)
(or	(goal FAST-CASTLE yes) ;will work in dark or feudal-age
(or	(goal feudal-pending yes) ;get it early anyway
(or	(current-age >= castle-age)
	(unit-type-count-total villager >= max-vill-pop)))) ;backup
	(unit-type-count villager-wood >= 6) ;min wood cutters required
	(can-research ri-double-bit-axe)
=>
	(research ri-double-bit-axe))

;MINING CAMP
;GOLD MINING
(defrule
	(goal FAST-CASTLE no) ;never when fast-castle == yes
	(goal is-town-under-attack no)
	(current-age-time > 15) ;allow other upgrades first
	(unit-type-count villager > min-vills);required
	(unit-type-count villager-gold >= 7);new minimum required
(or	(unit-type-count villager >= max-vill-pop) ;backup
	(and	(current-age >= castle-age)
			(unit-type-count villager-gold >= 8))) ;prioritize other upgrades
	(research-completed ri-double-bit-axe)
	(research-completed ri-horse-collar)
	(up-research-status c: ri-wheel-barrow >= research-pending) ;NEW
	(can-research ri-gold-mining)
=>
	(research ri-gold-mining)
)

;STONE MINING
(defrule
	(current-age-time > 15) ;allow other upgrades first
	(goal FAST-CASTLE no) ;never when fast-castle == yes
(or	(current-age >= castle-age)
	(and	(goal need-castle yes)
			(unit-type-count villager > min-vills)))
	(unit-type-count villager-stone >= 7) ;new minimum required
(or	(unit-type-count-total villager > min-vills)
	(unit-type-count-total villager >= max-vill-pop));for low-pop games
	(building-type-count-total town-center > 2)
(up-research-status c: ri-wheel-barrow >= research-pending) ;NEW
	(can-research ri-stone-mining)
=>
	(research ri-stone-mining)
)

;BLACKSMITH

;FLETCHING
(defrule
(or	(and	(goal unique-archer-class yes)
		(unit-type-count my-unique-unit-line > 0))
(or	(and	(goal unique-cav-archer-class yes)
		(unit-type-count my-unique-unit-line > 0))
(or (goal is-town-under-attack yes)
(or (unit-type-count-total cavalry-archer-line > 2)
(or (unit-type-count-total archer-line > 2)
(or (building-type-count-total watch-tower-line > 1)
(or (building-type-count-total krepost > 0)
(or (building-type-count-total donjon > 1)
(building-type-count-total castle > 0)))))))))
(can-research ri-fletching)
=>
(research ri-fletching)
)

;FLETCHING (extra rule)
(defrule
(or	(unit-type-count-total skirmisher-line > 2)
(or	(unit-type-count-total genitour-line > 2)
(or	(unit-type-count-total slinger > 2)
(or	(unit-type-count-total galley-line > 1)
(or	(unit-type-count-total caravel-line > 0)
(or	(unit-type-count-total longboat-line > 0)
(or	(unit-type-count-total skirmisher-line > 3)
(or	(unit-type-count-total elephant-archer-line > 2)
(or	(unit-type-count-total thirisadai > 0)
	(unit-type-count-total turtle-ship-line > 0))))))))))
	(can-research ri-fletching)
=>
	(research ri-fletching)
)

