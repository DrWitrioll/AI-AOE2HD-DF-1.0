; NEW BOW SAW (includes burgundians)
(defrule
	(current-age-time > 15) ;buffer
(or	(unit-type-count-total villager >= max-vill-pop)
(or	(unit-type-count-total villager-wood >= 20) ;buffer
	(and	(escrow-amount food > 250) ;excess resources
			(escrow-amount wood > 200))))
	(can-research-with-escrow ri-bow-saw)
=>
	(release-escrow food)
	(release-escrow wood)
	(research ri-bow-saw)
)

	;NEW HEAVY PLOW (includes burgundians)
(defrule
	;(current-age >= feudal-age) ;any-age
	(current-age-time > 15) ;buffer
(or	(unit-type-count-total villager-farmer >= 20) ;enough farmers present
(or	(building-type-count-total farm >= 20) ;many farms
(or	(and	(escrow-amount food > 250) ;excess resources
			(escrow-amount wood > 250))
	(unit-type-count-total villager >= max-vill-pop)))) ;backup
(or	(dropsite-min-distance wood <= 7) ;stable woodline
	(wood-amount >= 300))
	(can-research-with-escrow ri-heavy-plow)
=>
	(release-escrow food)
	(release-escrow wood)
	(research ri-heavy-plow))

