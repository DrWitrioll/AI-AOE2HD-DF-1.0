	;SLAVS
;DETINETS
(defrule
	(population > high-res-vil-pop)
(or	(unit-type-count-total villager-stone >= 3)
(or	(gold-amount >= 1050)
	(unit-type-count-total trade-cart >= min-trade-pop)))
	(can-research-with-escrow ri-detinets)
=>
	(release-escrow wood)
	(release-escrow gold)
	(research ri-detinets)
)
;DRUZHINA
(defrule
(or	(unit-type-count-total infantry-class >= 14)
(or	(up-research-status c: ri-halberdier >= research-pending)
	(up-research-status c: ri-champion >= research-pending)))
	(unit-type-count-total infantry-class >= 7)
	(can-research-with-escrow ri-druzhina)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-druzhina)
)
	;SPANISH
;INQUISITION
(defrule
(or	(unit-type-count-total trade-cart >= min-trade-pop)
(or	(unit-type-count-total trade-cog >= min-trade-pop)
	(gold-amount >= 1400)))
(or		(unit-type-count-total monastery-class >= 5)
		(population >= high-res-vil-pop))
	(unit-type-count-total monastery-class >= 1)
	(can-research-with-escrow ri-inquisition)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-inquisition)
)
;SUPREMACY
(defrule
	(unit-type-count-total villager >= high-res-vil-pop)
(or	(unit-type-count-total trade-cart >= min-trade-pop)
(or	(unit-type-count-total trade-cog >= min-trade-pop)
	(gold-amount >= 750)))
	(can-research-with-escrow ri-supremacy)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-supremacy)
)
	;TATARS
;SILK-ARMOR
(defrule
	(gold-amount >= 500) ;need some extra nummy nummy gold for the boys
(or	(unit-type-count-total scout-cavalry-line >= 7)
(or	(unit-type-count-total cavalry-archer-line >= 7)
(or	(unit-type-count-total steppe-lancer-line >= 7)
(or	(unit-type-count-total mercenary-kipchak >= 10)
(or	(unit-type-count-total genitour-line >= 9)
	(unit-type-count-total genitour-placeholder >= 9))))))
	(can-research-with-escrow ri-silk-armor)
=>
	(release-escrow wood)
	(release-escrow gold)
	(research ri-silk-armor)
)

;TIMURID-SIEGECRAFT
(defrule
(or	(and	(gold-amount >= 1200)
			(strategic-number sn-military-level >= 2)) ;must not be losing
	(unit-type-count-total trebuchet-set >= 3))
	(can-research-with-escrow ri-timurid-siegecraft)
=>
	(release-escrow wood)
	(release-escrow gold)
	(research ri-timurid-siegecraft)
)
	;TEUTONS
;IRONCLAD
(defrule
	(strategic-number sn-military-level >= 2) ;indicative of attacking likely with siege
(or	(unit-type-count-total siege-tower >= 2)
(or	(unit-type-count-total bombard-cannon-line >= 2)
(or	(unit-type-count-total trebuchet-set >= 2)
(or	(unit-type-count-total battering-ram-line >= 2)
	(unit-type-count-total scorpion-line >= 2)))))
	(can-research-with-escrow ri-ironclad)
=>
	(release-escrow wood)
	(release-escrow gold)
	(research ri-ironclad))

;CRENELLATIONS
(defrule
	(civ-selected teutonic)
	(building-type-count castle >= 2) ;good tech to get only food and stone
	(can-research-with-escrow my-unique-research) ;ri-crenellations
=>
	(release-escrow food)
	(release-escrow stone)
	(research my-unique-research)
)
	;TURKS
;SIPAHI
(defrule
(or	(unit-type-count-total cavalry-archer-line >= 6)
(or	(and	(or	(unit-type-count-total cavalry-archer-line >= 2)
			(goal CAV-ARCHER yes))
		(up-research-status c: ri-heavy-cavalry-archer >= research-pending))
(or	(unit-type-count-total genitour >= 6)
(or	(unit-type-count-total elite-genitour >= 6)
	(unit-type-count-total genitour-placeholder >= 6)))))
	(can-research-with-escrow ri-sipahi)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-sipahi)
)
;ARTILLERY
(defrule
	(civ-selected turkish)
(or	(building-type-count bombard-tower >= 4) ;don't prematurely research until they're built
(or	(unit-type-count-total bombard-cannon-line >= 3)
	(unit-type-count-total cannon-galleon-line >= 2))) ;dromon probably not included...
	(can-research-with-escrow my-unique-research) ;ri-artillery
=>
	(release-escrow food)
	(release-escrow gold)
	(research my-unique-research)
)
	;VIETNAMESE
;CHATRAS
(defrule
(or	(and	(strategic-number sn-military-level >= 2) ;get it if we are ahead
			(unit-type-count-total battle-elephant-line >= 4)) ;and have some elephants
	(up-research-status c: ri-elite-battle-elephant >= research-pending)) ;or we are researching elite unit
	(can-research-with-escrow ri-chatras)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-chatras))
;PAPER-MONEY
(defrule
	(goal WOOD-REMAINING yes) ;only get if there is still wood on the map ;pretty worthwhile upgrade so just get it fast
	(unit-type-count-total villager > min-vills) ;don't get if we have low number of villagers
(or	(unit-type-count-total villager-wood >= 10) ;average
	(unit-type-count-total villager-wood >= min-vills)) ;minimum number of wood cutters to consider
	(can-research-with-escrow ri-paper-money)
=>
	(release-escrow food)
	(release-escrow wood)
	(research ri-paper-money)
)
	;VIKINGS
;CHIEFTAINS
(defrule
(or	(not	(players-civ target-player aztec)) ;im too lazy to label every cavalry-class xD
(or	(not	(players-civ target-player mayan))
	(not	(players-civ target-player incan))))
	(unit-type-count-total infantry-class >= 6)
(or	(current-age >= imperial-age)
	(unit-type-count-total infantry-class >= 15))
	(can-research-with-escrow ri-chieftains)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-chieftains)
)
	;BOGSVEIGAR
(defrule
	(civ-selected viking)
(or	(and	(up-research-status c: ri-arbalest >= research-pending) ;this is only +1 attack, make it hard to get
			(unit-type-count-total archer-line >= 9))
	(and	(up-research-status c: ri-elite-longboat >= research-pending)
			(unit-type-count-total longboat-line >= 6)))
	(up-research-status c: ri-bracer >= research-pending)
	(up-research-status c: ri-chemistry >= research-pending)
	(can-research-with-escrow my-unique-research)
=>
	(release-escrow food)
	(release-escrow gold)
	(research my-unique-research) ;ri-bogsveigar
)
