	(not	(building-available town-center)))
(or	(building-type-count town-center >= 5)
(or	(goal is-town-under-attack yes)
(or	(goal ATTACK yes)
	(and	(goal SIEGE-FOR-CASTLE yes)
		(unit-type-count villager >= max-vill-pop)))))
	(can-research-with-escrow ri-first-crusade)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-first-crusade)
)
;hauberk (might use scutage still?)
(defrule
(or	(goal KNIGHT yes)
	(unit-type-count-total knight-line > 8))
	(can-research-with-escrow ri-scutage)
=>
	(release-escrow food)
	(release-escrow gold)
	(research ri-scutage)
)
