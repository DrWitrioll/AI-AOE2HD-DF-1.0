+; ============================================================================
+; DR FORTRESS V13 - DEFENSIVE / MILITARY / SIEGE DOCTRINE
+; ============================================================================
+
+(defconst df13-core 162)
+(defconst df13-pop-profile 163)        ;1=125, 2=150, 3=200+
+(defconst df13-defense-state 164)      ;0=safe, 1=confirmed pressure
+(defconst df13-counterattack 165)      ;0=off, 1=reform/counter window
+(defconst df13-threat-archer 166)
+(defconst df13-threat-cavalry 167)
+(defconst df13-threat-infantry 168)
+(defconst df13-threat-siege 169)
+(defconst df13-enemy-fortified 170)
+(defconst df13-recovery 171)
+(defconst df13-siege-ready 172)
+(defconst df13-fortress-stage 173)
+(defconst df13-observation-tier 174)
+(defconst df13-castle-opportunity 175)
+(defconst df13-assault-ready 176)
+(defconst df13-aftershock 177)
+(defconst df13-outpost 598)
+
+; ---------------------------------------------------------------------------
+; Initialization.  Deliberately does NOT touch civilian worker assignment,
+; resource percentages, hunting or age-up priorities.
+; ---------------------------------------------------------------------------
+(defrule
+    (goal df13-core 0)
+=>
+    (set-goal df13-core 1)
+    (set-goal df13-pop-profile 2)
+    (set-goal df13-defense-state 0)
+    (set-goal df13-counterattack 0)
+    (set-goal df13-threat-archer 0)
+    (set-goal df13-threat-cavalry 0)
+    (set-goal df13-threat-infantry 0)
+    (set-goal df13-threat-siege 0)
+    (set-goal df13-enemy-fortified 0)
+    (set-goal df13-recovery 0)
+    (set-goal df13-siege-ready 0)
+    (set-goal df13-fortress-stage 0)
+    (set-goal df13-observation-tier 0)
+    (set-goal df13-castle-opportunity 0)
+    (set-goal df13-assault-ready 0)
+)
+
+; Population profiles.
+(defrule
+    (population-cap <= 125)
+=>
+    (set-goal df13-pop-profile 1)
+)
+(defrule
+    (population-cap > 125)
+    (population-cap <= 150)
+=>
+    (set-goal df13-pop-profile 2)
+)
+(defrule
+    (population-cap > 150)
+=>
+    (set-goal df13-pop-profile 3)
+)
+
+; ---------------------------------------------------------------------------
+; Preserve Resonance formation behaviour globally.  These are the same family
+; of strategic numbers that make Resonance move soldiers as coherent groups.
+; ---------------------------------------------------------------------------
+(defrule
+    (true)
+=>
+    (set-strategic-number sn-group-form-distance 70)
+    (set-strategic-number sn-task-ungrouped-soldiers 0)
+    (set-strategic-number sn-group-leader-defense-distance 2)
+)
+
