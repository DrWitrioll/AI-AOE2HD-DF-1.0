44/45 are unused by ResonanceBot 5-1c.
+; ---------------------------------------------------------------------------
+(defrule
+    (goal df13-defense-state 0)
+    (town-under-attack)
+    (players-military-population any-enemy > 1)
+=>
+    (set-goal df13-defense-state 1)
+    (set-goal df13-counterattack 0)
+    (disable-timer 44)
+    (enable-timer 44 35)
+)
+
+(defrule
+    (goal df13-defense-state 1)
+    (timer-triggered 44)
+    (town-under-attack)
+=>
+    (disable-timer 44)
+    (enable-timer 44 35)
+)
+
+(defrule
+    (goal df13-defense-state 1)
+    (timer-triggered 44)
+    (not (town-under-attack))
+=>
+    (disable-timer 44)
+    (set-goal df13-defense-state 0)
+    (set-goal df13-counterattack 1)
+    (set-goal df13-aftershock 1)
+    (disable-timer 45)
+    (enable-timer 45 75)
+)
+
+(defrule
+    (goal df13-counterattack 1)
+    (timer-triggered 45)
+=>
+    (disable-timer 45)
+    (set-goal df13-counterattack 0)
+    (set-goal df13-aftershock 0)
+)
+
+; Threat typing.
+(defrule
+    (or (players-unit-type-count any-enemy archer-line >= 3)
+        (players-unit-type-count any-enemy cavalry-archer-line >= 3))
+=>
+    (set-goal df13-threat-archer 1)
+)
+(defrule
+    (or (players-unit-type-count any-enemy scout-cavalry-line >= 3)
+        (players-unit-type-count any-enemy knight-line >= 3))
+=>
+    (set-goal df13-threat-cavalry 1)
+)
+(defrule
+    (or (players-unit-type-count any-enemy militia-line >= 5)
+        (players-unit-type-count any-enemy spearman-line >= 5))
+=>
+    (set-goal df13-threat-infantry 1)
+)
+(defrule
+    (or (players-unit-type-count any-enemy battering-ram-line >= 1)
+        (or (players-unit-type-count any-enemy mangonel-line >= 1)
+            (players-unit-type-count any-enemy scorpion-line >= 2)))
+=>
+    (set-goal df13-threat-siege 1)
+)
+
+; Clear remembered composition after confirmed pressure is gone and the
+; relevant enemy mass has disappeared.
+(defrule
+    (goal df13-defense-state 0)
+    (players-unit-type-count any-enemy archer-line < 2)
+    (players-unit-type-count any-enemy cavalry-archer-line < 2)
+=>
+    (set-goal df13-threat-archer 0)
+)
+(defrule
+    (goal df13-defense-state 0)
+    (players-unit-type-count any-enemy scout-cavalry-line < 2)
+    (players-unit-type-count any-enemy knight-line < 2)
+=>
+    (set-goal df13-threat-cavalry 0)
+)
+(defrule
+    (goal df13-defense-state 0)
+    (players-unit-type-count any-enemy militia-line < 3)
+    (players-unit-type-count any-enemy spearman-line < 3)
+=>
+    (set-goal df13-threat-infantry 0)
+)
+(defrule
+    (goal df13-defense-state 0)
+    (players-unit-type-count any-enemy battering-ram-line < 1)
+    (players-unit-type-count any-enemy mangonel-line < 1)
+    (players-unit-type-count any-enemy scorpion-line < 1)
+=>
+    (set-goal df13-threat-siege 0)
+)
+
+; Fortification memory. Once the enemy shows a serious fixed defence, keep the
+; memory - siege remains strategically relevant for the rest of the game.
+(defrule
+    (or (players-building-type-count any-enemy castle >= 1)
+        (or (players-building-type-count any-enemy stone-wall-line >= 5)
+            (players-building-type-count any-enemy watch-tower-line >= 2)))
+=>
+    (set-goal df13-enemy-fortified 1)
+)
+
+; ---------------------------------------------------------------------------
+; Defensive formation state.  No global retreat on town-under-attack.
+; Villager garrison remains enabled and civilian militia is disabled.
+; ---------------------------------------------------------------------------
+(defrule
+    (goal df13-defense-state 1)
+=>
+    (set-strategic-number sn-number-attack-groups 0)
+    (set-strategic-number sn-percent-attack-soldiers 0)
+    (set-strategic-number sn-number-defend-groups 2)
+    (set-strategic-number sn-minimum-defend-group-size 5)
+    (set-strategic-number sn-maximum-defend-group-size 24)
+    (set-strategic-number sn-gather-defense-units 1)
+    (set-strategic-number sn-percent-enemy-sighted-response 