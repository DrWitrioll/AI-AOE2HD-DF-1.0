+    (wood-amount > 380)
+    (up-pending-objects c: stable < 1)
+    (can-build stable)
+=>
+    (build stable)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal makearchers 1)
+    (goal df13-pop-profile 1)
+    (building-type-count-total archery-range < 2)
+    (wood-amount > 260)
+    (up-pending-objects c: archery-range < 1)
+    (can-build archery-range)
+=>
+    (build archery-range)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal makearchers 1)
+    (goal df13-pop-profile 2)
+    (building-type-count-total archery