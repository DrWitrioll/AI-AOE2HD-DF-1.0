-range < 3)
+    (wood-amount > 320)
+    (up-pending-objects c: archery-range < 1)
+    (can-build archery-range)
+=>
+    (build archery-range)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal makearchers 1)
+    (goal df13-pop-profile 3)
+    (building-type-count-total archery-range < 4)
+    (wood-amount > 380)
+    (up-pending-objects c: archery-range < 1)
+    (can-build archery-range)
+=>
+    (build archery-range)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal makeinfantry 1)
+    (goal df13-pop-profile 1)
+    (building-type-count-total barracks < 2)
+    (wood-amount > 240)
+    (up-pending-objects c: barracks < 1)
+    (can-build barracks)
+=>
+    (build barracks)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal makeinfantry 1)
+    (goal df13-pop-profile 2)
+    (building-type-count-total barracks < 3)
+    (wood-amount > 300)
+    (up-pending-objects c: barracks < 1)
+    (can-build barracks)
+=>
+    (build barracks)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal makeinfantry 1)
+    (goal df13-pop-profile 3)
+    (building-type-count-total barracks < 4)
+    (wood-amount > 360)
+    (up-pending-objects c: barracks < 1)
+    (can-build barracks)
+=>
+    (build barracks)
+)
+
+; ---------------------------------------------------------------------------
+; Threat counters and cavalry reserve.
+; ---------------------------------------------------------------------------
+(defrule
+    (current-age == feudal-age)
+    (goal makecavalry 1)
+    (unit-type-count-total scout-cavalry-line < 3)
+    (food-amount > 120)
+    (can-train scout-cavalry-line)
+=>
+    (train scout-cavalry-line)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal makecavalry 1)
+    (unit-type-count-total knight-line < 8)
+    (food-amount > 220)
+    (gold-amount > 160)
+    (can-train knight-line)
+=>
+    (train knight-line)
+)
+(defrule
+    (current-age >= feudal-age)
+    (goal df13-threat-cavalry 1)
+    (unit-type-count-total spearman-line < 8)
+    (food-amount > 100)
+    (can-train spearman-line)
+=>
+    (train spearman-line)
+)
+(defrule
+    (current-age >= feudal-age)
+    (goal df13-threat-archer 1)
+    (unit-type-count-total skirmisher-line < 10)
+    (food-amount > 100)
+    (wood-amount > 100)
+    (can-train skirmisher-line)
+=>
+    (train skirmisher-line)
+)
+(defrule
+    (current-age >= feudal-age)
+    (goal df13-threat-infantry 1)
+    (unit-type-count-total archer-line < 10)
+    (wood-amount > 120)
+    (gold-amount > 80)
+    (can-train archer-line)
+=>
+    (train archer-line)
+)
+
+; ---------------------------------------------------------------------------
+; Siege doctrine and packages.
+; ---------------------------------------------------------------------------
+(defrule
+    (current-age >= castle-age)
+    (or (goal makesiege 1)
+        (or (goal df13-enemy-fortified 1) (goal df13-threat-siege 1)))
+    (building-type-count-total siege-workshop < 1)
+    (wood-amount > 260)
+    (up-pending-objects c: siege-workshop < 1)
+    (can-build siege-workshop)
+=>
+    (build siege-workshop)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df13-pop-profile 2)
+    (goal df13-enemy-fortified 1)
+    (building-type-count-total siege-workshop < 2)
+    (wood-amount > 420)
+    (up-pending-objects c: siege-workshop < 1)
+    (can-build siege-workshop)
+=>
+    (build siege-workshop)
+)
+(defrule
+    (current-age >= castle-age)
+    (goal df13-pop-profile 3)
+    (goal df13-enemy-fortified 1)
+    (building-type-count-total siege-workshop < 3)
+    (wood-amount > 500)
+    (up-pending-objects c: siege-workshop < 1)
+    (can-build siege-workshop)
+=>
+    (build siege-workshop)
+)
+
